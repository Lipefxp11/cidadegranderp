{
	/*new i = Info_Veiculo[vehicleid];
	if(i != -1)
	{
	    if(flood_lataria[vehicleid] == 1)
	    {
		    new panels, doors, lights, tires;
		    GetVehicleDamageStatus(vehicleid, panels, doors, lights, tires);
			decode_panels(panels, Veiculo[i][v_Painel][0],Veiculo[i][v_Painel][1],Veiculo[i][v_Painel][2],Veiculo[i][v_Painel][3],Veiculo[i][v_Painel][4],Veiculo[i][v_Painel][5],Veiculo[i][v_Painel][6]);
			decode_doors(doors, Veiculo[i][v_Porta][0], Veiculo[i][v_Porta][1], Veiculo[i][v_Porta][2], Veiculo[i][v_Porta][3]);
