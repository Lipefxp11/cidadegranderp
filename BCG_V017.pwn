stock chaves_veiculo(playerid, i, a)
{
	if(Veiculo[i][v_Trancado] == 0)
	{
		Veiculo[i][v_Trancado] = 1;
		GameTextForPlayer(playerid, "~r~TRANCADO", 1500, 3);
	}
	else
	{
	    Veiculo[i][v_Trancado] = 0;
		GameTextForPlayer(playerid, "~g~~h~ABERTO", 1500, 3);
	}
	new Float:pp[3];
	GetVehiclePos(a, pp[0],pp[1],pp[2]);
	Play_Som(1145, pp[0],pp[1],pp[2], 0, 0);
	SalvarInfo(i, 50);
	SetPlayerToFaceVehicle(playerid, a);
}

stock modelo_item(idd, tipo=0)
{
    new model;
    if(idd > -1 && idd < sizeof Itens)
    {
		model = Itens[idd][item_Modelo];
	    if(idd == 0) model = 3045;
	    else if(idd == 55) model = Acessorios_Info[tipo][acessorio_Modelo];
	    else if(idd == 56) model = tipo;
	    else if(idd == 57) model = tipo;
	    else if(idd == 88) model = tipo;
    }
	return model;
}

stock tem_outro(playerid, idd, slot)
{
	new c = id[playerid];
	if(c != -1)
	{
		for(new a; a<MAX_SLOTS; a++)
		{
		    if(a != slot)
		    {
		    	if(Inventario[playerid][a][inv_ID] == idd)
				{
				return 1;
			    }
		    }
		}
	}
	return 0;
}

stock combinar(playerid, c, comb, slot)
{
   	if(slot > -1)
	{
	    Inventario[playerid][comb][inv_Unidades] += Inventario[playerid][slot][inv_Unidades];
		Inventario[playerid][slot][inv_ID] = 0;
		Inventario[playerid][slot][inv_Tipo] = 0;
		Inventario[playerid][slot][inv_Unidades] = 0;
		salvar_inventario(c, comb);
		salvar_inventario(c, slot);
		abrir_inv_novo(playerid);
	}
}

stock separar_item(playerid, slot)
{
   	if(slot > -1)
	{
	    new c = id[playerid];
		if(c != -1)
		{
		    SetPVarInt(playerid, "slot", slot);
			new sss[300];
			format(sss, 300, "\n\
			\
			{00ffff}SEPARANDO ITEM\n\n\
			\
			{ffffff}Nome: {ffff00}%s\n\
			{ffffff}Unidades: {4169E1}%s\n\n\
			\
			{ffff00}[INFO]{a1a1a1} Digite quantas unidades deseja separar:\n", NomeItem(Inventario[playerid][slot][inv_ID], Inventario[playerid][slot][inv_Tipo]), ConvertMoney(Inventario[playerid][slot][inv_Unidades]));
			ShowPlayerDialog(playerid, DIALOG_SEPARAR, DIALOG_STYLE_INPUT, "{000000}_", sss, "Separar", "Cancelar");
		}
	}
}

stock abrir_menu_player(playerid)
{
	if(inv_novo_aberto[playerid] == 1) fechar_inv_novo(playerid);
	if(celular_aberto[playerid] != -1) celular(playerid, -2);
	new pode;
	new c = id[playerid];
	if(c != -1)
	{
		if(player_arena[playerid] == 0)
		{
			if(player_algemado[playerid] == 0 && player_amarrado[playerid] == 0)
			{
				if(player_rendido[playerid] == 0)
				{
					if(player_arrastado[playerid] == -1 && Barra[playerid][b_Acao] == 0)
					{
					    if(segurando_player[playerid] == -1 && academia_player[playerid] == -1)
						{
							if(Conta[playerid][c_Hospital] == 0 && Conta[playerid][c_CA_Tempo] == 0)
							{
							    if(Conta[playerid][c_Cadeia] == -1 && imobilizado[playerid] == 0)
								{
								    if(evento_player[playerid] == -1)
									{
									    pode = 1;
										abrir_inv_novo(playerid);
										SelectTextDraw(playerid, 0x00ffff89);
									}
								}
							}
						}
					}
				}
			}
		}
		if(pode == 0) ms(playerid, 0, "Voce nao pode fazer isso no momento !");
	}
}

stock desmanche_veiculo(playerid, v)
{
	if(Online(playerid))
	{
		if(GetVehicleModel(v) != 0)
		{
		    new i = Info_Veiculo[v];
		    if(i != -1)
		    {
		        SetPVarInt(playerid, "vee", v);
		        new cont;
		        SG[0] = EOS;
				zerar_lista(playerid, 1);
		        strcat(SG, "Componentes para remover\n");
		        new Float:vidac;
		      	GetVehicleHealth(v, vidac);
		        if(Veiculo[i][v_Bateria] > 0)
		        {
		            strcat(SG, "{ffffff}Bateria\n");
		            Lista[playerid][cont] = 5;
	            	Lista2[playerid][cont] = 0;
	            	cont ++;
		        }

		        if(vidac > 300.0)
		        {
		            strcat(SG, "{ffffff}Motor\n");
		            Lista[playerid][cont] = 0;
	            	Lista2[playerid][cont] = 0;
	            	cont ++;
		        }

		        if(!VeiculoMoto(v))
		        {
				for(new a=5; a<sizeof s_painel; a++)
				{
				    if(Veiculo[i][v_Painel][a] < 3)
					{
				        strcat(SG, "{ffffff}");
				        strcat(SG, s_painel[a]);
				        strcat(SG, "\n");
				        Lista[playerid][cont] = 1;
				    	Lista2[playerid][cont] = a;
				    	cont ++;
				    }
				}
				for(new a; a<sizeof s_porta; a++)
				{
				    if(Veiculo[i][v_Porta][a] < 4)
					{
				        strcat(SG, "{ffffff}");
				        strcat(SG, s_porta[a]);
				        strcat(SG, "\n");
				        Lista[playerid][cont] = 3;
				    	Lista2[playerid][cont] = a;
				    	cont ++;
				    }
				}
		        }
		        for(new a; a<sizeof s_farol; a++)
		        {

              		if(Veiculo[i][v_Farol][a] != 1)
		            {
		                strcat(SG, "{ffffff}");
		                strcat(SG, s_farol[a]);
		                strcat(SG, "\n");
		                Lista[playerid][cont] = 2;
		            	Lista2[playerid][cont] = a;
		            	cont ++;
              		}
		        }

		        ShowPlayerDialog(playerid, DIALOG_DESMANCHE, DIALOG_STYLE_TABLIST_HEADERS, NomeVeiculo(GetVehicleModel(v)), SG, "Concertar", "Fechar");
		    }
		}
	}
}



stock status_veiculo(playerid, v)
{
	if(Online(playerid) && v >= 0 && v < MAX_VEHICLES)
	{
		if(GetVehicleModel(v) != 0)
		{
		    new i = Info_Veiculo[v];
		    if(i != -1)
		    {
		        SetPVarInt(playerid, "vee", v);
		        new cont;
		        SG[0] = EOS;
				zerar_lista(playerid);
		        strcat(SG, "Componentes Danificados\tStatus\n");
		        new Float:vidac;
		      	GetVehicleHealth(v, vidac);
		        if(Veiculo[i][v_Bateria] < 100)
		        {
		            strcat(SG, "{ffffff}Bateria");
		            strcat(SG, "\t{a1a1a1}");
		            strcat(SG, ConvertMoney(Veiculo[i][v_Bateria]));
		            strcat(SG, "/100");
		          	strcat(SG, "\n");
		            Lista[playerid][cont] = 5;
	            	Lista2[playerid][cont] = 0;
	            	cont ++;
		        }

		        if(vidac < 990.0)
		        {
		            new vidacarro = floatround(vidac);
		            vidacarro = vidacarro/10;
		            strcat(SG, "{ffffff}Motor");
		            strcat(SG, "\t{a1a1a1}");
		            strcat(SG, ConvertMoney(vidacarro));
		            strcat(SG, "/100");
		          	strcat(SG, "\n");
		            Lista[playerid][cont] = 0;
	            	Lista2[playerid][cont] = 0;
	            	cont ++;
		        }

                if(!VeiculoMoto(v) && !VeiculoBicicleta(v))
		        {
				for(new a=5; a<sizeof s_painel; a++)
				{
				    if(Veiculo[i][v_Painel][a] != 0)
					{
				        if(Veiculo[i][v_Painel][a] >= 0 && Veiculo[i][v_Painel][a] < sizeof s_painel)
				        {
					        strcat(SG, "{ffffff}");
					        strcat(SG, s_painel[a]);
					        strcat(SG, "\t{a1a1a1}");
					        strcat(SG, s_status[Veiculo[i][v_Painel][a]]);
					        strcat(SG, "\n");
					        Lista[playerid][cont] = 1;
					    	Lista2[playerid][cont] = a;
					    	cont ++;
				    	}
				    	else Veiculo[i][v_Painel][a] = 0;
				    }
				}

				for(new a; a<sizeof s_porta; a++)
		        	{
				    if(Veiculo[i][v_Porta][a] != 0)
					{
				        if(Veiculo[i][v_Porta][a] >= 0 && Veiculo[i][v_Porta][a] < sizeof s_porta)
				        {
					        strcat(SG, "{ffffff}");
					        strcat(SG, s_porta[a]);
					        strcat(SG, "\t{a1a1a1}");
					        strcat(SG, s_status[Veiculo[i][v_Porta][a]]);
					        strcat(SG, "\n");
					        Lista[playerid][cont] = 3;
					    	Lista2[playerid][cont] = a;
					    	cont ++;
							}
							else Veiculo[i][v_Porta][a] = 0;
				    }
				}

		        }

		        for(new a; a<sizeof s_farol; a++)
		        {
		            if(Veiculo[i][v_Farol][a] != 0)
		            {
		                if(Veiculo[i][v_Farol][a] >= 0 && Veiculo[i][v_Farol][a] < sizeof s_farol)
		                {
				        strcat(SG, "{ffffff}");
				        strcat(SG, s_farol[a]);
				        strcat(SG, "\t{a1a1a1}");
				        strcat(SG, s_status[Veiculo[i][v_Farol][a]]);
				        strcat(SG, "\n");
				        Lista[playerid][cont] = 2;
				    	Lista2[playerid][cont] = a;
				    	cont ++;
		            	}
		            	else Veiculo[i][v_Farol][a] = 0;
		            }
		        }

		        for(new a; a<sizeof s_pneu; a++)
		        {
		            if(Veiculo[i][v_Pneu][a] != 0)
		            {
		                if(Veiculo[i][v_Pneu][a] < 2)
		                {
				        strcat(SG, "{ffffff}");
				        strcat(SG, s_pneu[a]);
				        strcat(SG, "\t{a1a1a1}");
				        strcat(SG, s_status[Veiculo[i][v_Pneu][a]]);
				        strcat(SG, "\n");
				        Lista[playerid][cont] = 4;
				    	Lista2[playerid][cont] = a;
				    	cont ++;
		            	}
		            	else Veiculo[i][v_Pneu][a] = 0;
		            }
		        }
		        ShowPlayerDialog(playerid, DIALOG_QUEBRADO, DIALOG_STYLE_TABLIST_HEADERS, NomeVeiculo(GetVehicleModel(v)), SG, "Concertar", "Fechar");
		    }
		}
	}
}

BCG:: voltar_veiculo(v)
{
	SetVehicleVirtualWorld(v, 0);
	return 1;
}

stock colocar_link(playerid)
{
	ShowPlayerDialog(playerid, DIALOG_LINK, DIALOG_STYLE_INPUT, "COLOCAR LINK PARA OUVIR", "\
	\n\
	\
	{a1a1a1}Nem todos os Links sao suportados, tenha isso em mente.\n\
	{ffff00}[INFO] {ffffff}Coloque o {00ffff}link {ffffff}da musica que deseja ouvir:\n\n", "Escolher", "Cancelar");
}

stock criar_maconha(Float:xx, Float:yy, Float:zz, dono)
{
	for(new a; a<MAX_MACONHA; a++)
	{
		if(Maconha[a][mac_Existe] == 0)
		{
		    Maconha[a][mac_Existe] = 1;
		    Maconha[a][mac_X] = xx;
		    Maconha[a][mac_Y] = yy;
		    Maconha[a][mac_Z] = zz-0.85;
		    Maconha[a][mac_Dono] = dono;
		    Maconha[a][mac_Progresso] = 0;
		    Maconha[a][mac_Status] = 0;
		    Maconha[a][mac_Vida] = 50;
		    Maconha[a][mac_Agua] = 100;
		    Maconha[a][mac_Fertilizante] = 0;
		    atualizar_maconha(a);
		    salvar_maconha(a);
		    return a;
		}
	}
	return -1;
}


BCG:: carregar_maconhas()
{
    new file[80];
	new cont;
    for(new a; a<MAX_MACONHA; a++)
	{
	    Maconha[a][mac_3D] = DynamicText3D:-1;
	    format(file, 80, "Maconhas/%d.txt", a);
	    if(DOF2_FileExists(file))
	    {
	        Maconha[a][mac_Existe] = 1;
	        Maconha[a][mac_Dono] = DOF2_GetInt(file, "mac_Dono");
		    Maconha[a][mac_Progresso] = DOF2_GetInt(file, "mac_Progresso");
		    Maconha[a][mac_Status] = DOF2_GetInt(file, "mac_Status");
		    Maconha[a][mac_Vida] = DOF2_GetInt(file, "mac_Vida");
		    Maconha[a][mac_Agua] = DOF2_GetInt(file, "mac_Agua");
		    Maconha[a][mac_X] = DOF2_GetFloat(file, "mac_X");
		    Maconha[a][mac_Y] = DOF2_GetFloat(file, "mac_Y");
		    Maconha[a][mac_Z] = DOF2_GetFloat(file, "mac_Z");
		    Maconha[a][mac_Fertilizante] = DOF2_GetInt(file, "mac_Fertilizante");
            atualizar_maconha(a);
            cont ++;
		}
	}
	printf("** %d Pe de maconhas do Servidor carregadas.", cont);
}

stock salvar_maconha(a)
{
	new file[80];
	format(file, 80, "Maconhas/%d.txt", a);
	if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
	if(Maconha[a][mac_Existe] == 1)
	{
	    DOF2_CreateFile(file);
	    DOF2_SetInt(file, "mac_Dono", Maconha[a][mac_Dono]);
	    DOF2_SetInt(file, "mac_Progresso", Maconha[a][mac_Progresso]);
	    DOF2_SetInt(file, "mac_Status", Maconha[a][mac_Status]);
	    DOF2_SetInt(file, "mac_Vida", Maconha[a][mac_Vida]);
	    DOF2_SetInt(file, "mac_Agua", Maconha[a][mac_Agua]);
	    DOF2_SetFloat(file, "mac_X", Maconha[a][mac_X]);
	    DOF2_SetFloat(file, "mac_Y", Maconha[a][mac_Y]);
	    DOF2_SetFloat(file, "mac_Z", Maconha[a][mac_Z]);
	    DOF2_SetInt(file, "mac_Fertilizante", Maconha[a][mac_Fertilizante]);
		DOF2_SaveFile();
	}
}


stock atualizar_maconha(a)
{
	Iter_Remove(Iter_Maconhas, a);
	if(IsValidDynamicObject(Maconha[a][mac_Obj])) DestroyDynamicObject_(Maconha[a][mac_Obj]);
	if(Maconha[a][mac_Existe] > 0)
	{
	    Iter_Add(Iter_Maconhas, a);
	    new i = Maconha[a][mac_Status];
	    Maconha[a][mac_Obj] = CreateDynamicObject(obj_maconha[i], Maconha[a][mac_X], Maconha[a][mac_Y], Maconha[a][mac_Z]+pos_maconha[i], 0,0,0, -1, -1, -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
	}
	texto_maconha(a);
}

stock texto_maconha(a)
{
    if(IsValidDynamic3DTextLabel(Maconha[a][mac_3D])) DestroyDynamic3DTextLabel(Maconha[a][mac_3D]);
	Maconha[a][mac_3D] = DynamicText3D:-1;
    if(Maconha[a][mac_Existe] > 0)
	{
	    new sss[150];
	    new i = Maconha[a][mac_Status];
	    format(sss, 150, "Pe de Maconha [%d]\n%s", a, status_maconha(a));
	    new cor = 0x00ff0099;
	    if(Maconha[a][mac_Fertilizante] > 0) cor = 0xffff0099;
	    Maconha[a][mac_3D] = CreateDynamic3DTextLabel(sss, cor, Maconha[a][mac_X], Maconha[a][mac_Y], Maconha[a][mac_Z]+pos_maconha[i], 2, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, -1, -1, -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0);
	}
}


stock status_maconha(a)
{
	new stri[50];
	if(Maconha[a][mac_Status] < 5)
	{
	    if(Maconha[a][mac_Vida] == 0)
	    {
	        format(stri, 50, "Morta\nAperte ALT para limpar");
	    }
	    else
	    {
			if(Maconha[a][mac_Agua] <= 100)
			{
				if(Maconha[a][mac_Vida] <= 100) format(stri, 50, "Bem Hidratada\nCrecendo Bem");
				if(Maconha[a][mac_Vida] <= 50) format(stri, 50,  "Bem Hidratada\nCrecimento Lento");
				if(Maconha[a][mac_Vida] <= 20) format(stri, 50,  "Bem Hidratada\nRecuperando");
			}
			if(Maconha[a][mac_Agua] <= 80)
			{
				if(Maconha[a][mac_Vida] <= 100) format(stri, 50, "Hidratada\nCrecendo");
				if(Maconha[a][mac_Vida] <= 50) format(stri, 50,  "Hidratada\nCrecimento Lento");
				if(Maconha[a][mac_Vida] <= 20) format(stri, 50,  "Hidratada\nRecuperando");
			}
			if(Maconha[a][mac_Agua] <= 40)
			{
				if(Maconha[a][mac_Vida] <= 100) format(stri, 50, "Seca\nCrecimento Lento");
				if(Maconha[a][mac_Vida] <= 50) format(stri, 50,  "Seca\nCrecimento Muito Lento");
				if(Maconha[a][mac_Vida] <= 20) format(stri, 50,  "Seca\nMorrendo");
			}
			if(Maconha[a][mac_Agua] <= 10)
			{
				if(Maconha[a][mac_Vida] <= 100) format(stri, 50, "Muito Seca\nCrecimento Parado");
				if(Maconha[a][mac_Vida] <= 50) format(stri, 50,  "Muito Seca\nMorrendo");
				if(Maconha[a][mac_Vida] <= 20) format(stri, 50,  "Muito Seca\nMorrendo Rapido");
			}
		}
	}
	else
	{
	    format(stri, 50, "Crecimento Total\nAperte ALT para colher");
	}
	return stri;
}

BCG:: maconhas()
{
	foreach(new a:Iter_Maconhas)
	{
		if(Maconha[a][mac_Existe] == 1)
		{
		    if(Maconha[a][mac_Status] < 5)
		    {
		        if(Maconha[a][mac_Agua] > 10)
		        {
		            if(Maconha[a][mac_Vida] == 100) Maconha[a][mac_Vida] --;
		            if(Maconha[a][mac_Vida] < 100)
		            {
		                if(Maconha[a][mac_Vida] > 50)
		                {
				        Maconha[a][mac_Agua] --;
				        Maconha[a][mac_Vida] ++;
				        if(Maconha[a][mac_Progresso] < 100)
				        {
				            Maconha[a][mac_Progresso] += 2;
				            if(Maconha[a][mac_Fertilizante] > 0)
				            {
				                Maconha[a][mac_Fertilizante] --;
				                Maconha[a][mac_Progresso] += 9;
				            }
				            if(Maconha[a][mac_Progresso] >= 100)
				            {
				                Maconha[a][mac_Progresso] = 0;
				            	Maconha[a][mac_Status] ++;
				            	atualizar_maconha(a);
				            	salvar_maconha(a);
				            }
				        }
		                }
		                else if(Maconha[a][mac_Vida] > 20)
		                {
		                    Maconha[a][mac_Agua] --;
				        Maconha[a][mac_Vida] ++;
				        if(Maconha[a][mac_Progresso] < 100)
				        {
				            Maconha[a][mac_Progresso] ++;
				            if(Maconha[a][mac_Fertilizante] > 0)
				            {
				                Maconha[a][mac_Fertilizante] --;
				                Maconha[a][mac_Progresso] += 9;
				            }
				            if(Maconha[a][mac_Progresso] >= 100)
				            {
				                Maconha[a][mac_Progresso] = 0;
				            	Maconha[a][mac_Status] ++;
				            	atualizar_maconha(a);
				            	salvar_maconha(a);
				            }
				        }
		                }
		                else
		                {
		                    Maconha[a][mac_Agua] --;
				        Maconha[a][mac_Vida] ++;
		                }
		            }
		        }
		        else
		        {
		            if(Maconha[a][mac_Vida] > 0)
		            {
		            	Maconha[a][mac_Vida] --;
				    if(Maconha[a][mac_Vida] == 0)
					{
                            Maconha[a][mac_Existe] = 2;
                            atualizar_maconha(a);
				    }
		            }
		        }
		    }

		    if(IsValidDynamic3DTextLabel(Maconha[a][mac_3D]))
		    {
		    	format(texto_mac, 150, "Pe de Maconha [%d]\n%s", a, status_maconha(a));
		    	new cor = 0x00ff0099;
	    		if(Maconha[a][mac_Fertilizante] > 0) cor = 0xffff0099;
		    	UpdateDynamic3DTextLabelText(Maconha[a][mac_3D], cor, texto_mac);
		    }
		}
	}
}

stock maconha_perto(playerid)
{
	foreach(new a:Iter_Maconhas)
	{
		if(Maconha[a][mac_Existe] > 0)
		{
		    if(GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld_(playerid) == 0)
		    {
			    if(IsPlayerInRangeOfPoint(playerid, 2, Maconha[a][mac_X], Maconha[a][mac_Y], Maconha[a][mac_Z]))
				{
					return a;
			    }
		    }
		}
	}
	return -1;
}

stock maconhas_player(playerid)
{
	new cont;
	foreach(new a:Iter_Maconhas)
	{
		if(Maconha[a][mac_Existe] == 1)
		{
		    if(Maconha[a][mac_Dono] == id[playerid])
		    {
			    cont++;
		    }
		}
	}
	return cont;
}

