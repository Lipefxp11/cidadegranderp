stock fechar_radio(playerid)
{
    KillTimer(timer_radio[playerid]);
    mostrando_radio[playerid] = 0;
    if(IsPlayerAttachedObjectSlotUsed(playerid, 9))RemovePlayerAttachedObject(playerid, 9);
	if(!IsPlayerInAnyVehicle(playerid)) ClearAnimations(playerid, 1);
    for(new a; a<sizeof T_Radio; a++) TextDrawHideForPlayer(playerid, T_Radio[a]);
    PlayerTextDrawHide(playerid, T_Radio_p[playerid][0]);
    CancelSelectTextDraw(playerid);
}

BCG:: mostrar_radio(playerid)
{
    KillTimer(timer_radio[playerid]);
	if(mostrando_radio[playerid] == 0)
	{
		for(new a; a<sizeof T_Radio; a++) TextDrawShowForPlayer(playerid, T_Radio[a]);
		if(!IsPlayerInAnyVehicle(playerid))
		{
		    if(ID_Dancando[playerid] == -1 && em_anim[playerid] == 0)
		    {
				ApplyAnimation(playerid, "CASINO", "CARDS_LOOP", 4.1, true, false, false, false, 0, 1);
			}
		}
		SetPlayerAttachedObject(playerid, 9, 19942, 5, 0.122000, 0.038999, -0.018999, -164.900283, -27.800001, -43.300010, 1.000000, 1.000000, 1.000000);
		SelectTextDraw(playerid, 0xffff0090);
	}
	new str_radio[50];
	mostrando_radio[playerid] = 1;
    if(radio_estacao_id[playerid] < 0 ) radio_estacao_id[playerid] = 0;
	format(str_radio, 50, "_~n~%d~n~_", radio_estacao_id[playerid]);
	if(radio_estacao_id[playerid] == GetPVarInt(playerid, "VOIP_ID"))
    {
    	TextDrawHideForPlayer(playerid, T_Radio[18]);
		TextDrawShowForPlayer(playerid, T_Radio[19]);
	}
	else
	{
	    TextDrawHideForPlayer(playerid, T_Radio[19]);
		TextDrawShowForPlayer(playerid, T_Radio[18]);
	}
	PlayerTextDrawSetString(playerid, T_Radio_p[playerid][0], str_radio);
	PlayerTextDrawShow(playerid, T_Radio_p[playerid][0]);
}

stock tem_arma(playerid)
{
	new arms[2];
	for(new i; i<13; i++)
	{
	    GetPlayerWeaponData(playerid, i, arms[0], arms[1]);
	    if(arms[0] != 0)
	    {
	        return 1;
		}
	}
	return 0;
}

stock Parar_Anim(playerid)
{
	new Float:pos[3];
	GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
	ClearAnimations(playerid);
    SetPlayerPos_(playerid, pos[0]+0.1, pos[1]+0.1, pos[2]+0.1);
}

stock Taser(playerid)
{
	if(Online(playerid))
	{
	    new c = id[playerid];
	    if(c != -1)
		{
		    if(Conta[playerid][c_Taser][0] == 1)
			{
				return 1;
		    }
		}
	}
	return 0;
}

stock taser_player(playerid)
{
	new c = id[playerid];
	if(c != -1)
	{
	    if(IsPlayerInAnyVehicle(playerid)) ms(playerid, 0, "Voce nao pode usar este comando em um veiculo !");
	    else
	    {
		    if(GetPVarInt(playerid, "flood_taser") > gettime()) ms(playerid, 0, "Voce nao pode usar o taser com muita frequecia !");
		    else
			{
				if(Conta[playerid][c_Taser][0] == 0)
				{
				Conta[playerid][c_Taser][0] = 1;
				new arms[13][2];
				for(new a; a<13; a++)
				{
				    if(a == 2) GetPlayerWeaponData(playerid, a, Conta[playerid][c_Taser][1], Conta[playerid][c_Taser][2]);
						else GetPlayerWeaponData(playerid, a, arms[a][0],arms[a][1]);
				}
				salvar_conta(c, 0, "c_Taser_0", sv_int(Conta[playerid][c_Taser][0]));
				salvar_conta(c, 0, "c_Taser_1", sv_int(Conta[playerid][c_Taser][1]));
				salvar_conta(c, 0, "c_Taser_2", sv_int(Conta[playerid][c_Taser][2]));
				salvar_conta(c, 0, "c_Taser_3", sv_int(Conta[playerid][c_Taser][3]));
				ResetPlayerWeapons_(playerid);
				for(new a; a<13; a++) if(a != 2) GivePlayerWeapon_(playerid, arms[a][0],arms[a][1]);
				GivePlayerWeapon_(playerid, 23, 999);
				format(string_prox, 300, "** Policial '%s' pegou seu Taser **", Nome(playerid));
					ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
			    }
			    else
				{
				Conta[playerid][c_Taser][0] = 0;
				new arms[13][2];
				for(new a; a<13; a++) GetPlayerWeaponData(playerid, a, arms[a][0],arms[a][1]);
	                ResetPlayerWeapons_(playerid);
				for(new a; a<13; a++) if(a != 2) GivePlayerWeapon_(playerid, arms[a][0], arms[a][1]);
				GivePlayerWeapon_(playerid, Conta[playerid][c_Taser][1], Conta[playerid][c_Taser][2]);
		            Conta[playerid][c_Taser][1] = 0;
		            Conta[playerid][c_Taser][2] = 0;
		            salvar_conta(c, 0, "c_Taser_0", sv_int(Conta[playerid][c_Taser][0]));
				salvar_conta(c, 0, "c_Taser_1", sv_int(Conta[playerid][c_Taser][1]));
				salvar_conta(c, 0, "c_Taser_2", sv_int(Conta[playerid][c_Taser][2]));
				salvar_conta(c, 0, "c_Taser_3", sv_int(Conta[playerid][c_Taser][3]));
				format(string_prox, 300, "** Policial '%s' guardou seu Taser **", Nome(playerid));
					ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
			    }
			    SetPVarInt(playerid, "flood_taser", gettime()+3);
		    }
	    }
	}
}

stock remover_taser_player(playerid)
{
	if(Taser(playerid))
	{
		Conta[playerid][c_Taser][0] = 0;
		Conta[playerid][c_Taser][1] = 0;
		Conta[playerid][c_Taser][2] = 0;
		if(Online(playerid)) ResetPlayerWeapons_(playerid);
		new c = id[playerid];
		if(c != -1)
		{
			salvar_conta(c, 0, "c_Taser_0", sv_int(0));
			salvar_conta(c, 0, "c_Taser_1", sv_int(0));
			salvar_conta(c, 0, "c_Taser_2", sv_int(0));
		}
		ms(playerid, 2, "[TASER] Seu taser foi removido pois voce nao faz mais parte da organizacao.");
	}
}

stock remover_taser_conta(conta_id)
{
	new file[100];
	format(file, 100, "Contas/%d.txt", conta_id);
	if(DOF2_FileExists(file))
	{
		DOF2_SetInt(file, "c_Taser_0", 0);
		DOF2_SetInt(file, "c_Taser_1", 0);
		DOF2_SetInt(file, "c_Taser_2", 0);
		DOF2_SaveFile();
	}
}

