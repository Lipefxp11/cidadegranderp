	// separar item //
	if(dialogid == DIALOG_SEPARAR)
	{
	    if(response)
	    {
	        new slot = GetPVarInt(playerid, "slot");
	        if(!IsNumeric(inputtext))
	        {
	            ms(playerid, 0, "Use Apenas numeros !");
	            separar_item(playerid, slot);
	            return 1;
	        }
	        new cc = strval(inputtext);
	        if(cc < 1)
	        {
	            ms(playerid, 0, "Use um valor maior que 0 !");
	            separar_item(playerid, slot);
	            return 1;
	        }
	        if(cc >= Inventario[playerid][slot][inv_Unidades])
	        {
	            MS(playerid, 0, "Este item nao tem unidades suficiente para separar, tente um valor menor !");
	            separar_item(playerid, slot);
	            return 1;
	        }
	        if(add_inv(c, Inventario[playerid][slot][inv_ID], cc, Inventario[playerid][slot][inv_Tipo], 0, 0, 1))
	        {
	            fechar_caixinha(playerid);
	            Inventario[playerid][slot][inv_Unidades] -= cc;
	            selecionando_inv_novo[playerid] = -1;
	            selecionando_inv_novo2[playerid] = -1;
	            abrir_inv_novo(playerid);
	            ms(playerid, 1, "Item separado com sucesso !");
	            salvar_inventario(c, slot);
			}
			else ms(playerid, 0, "Voce nao tem espaco no invetario para separar o item !");
	    }
	    return 1;
	}

	// dialog jbl //
	if(dialogid == DIALOG_JBL)
	{
	    if(c == -1) return 1;
	    new a = GetPVarInt(playerid, "jbl");
	    if(response)
	    {
	        // bluetooth //
	        if(listitem == 0)
	        {
                if(JBL[a][jbl_Blu] == -1)
                {
                    ms(playerid, 2, "Bluetooth ligado, pronto para conectar !");
                    JBL[a][jbl_Blu] = -2;
                    abrir_jbl(playerid, a);
                    texto_jbl(a);
                }
                else if(JBL[a][jbl_Blu] == -2)
                {
                    ms(playerid, 2, "Bluetooth Desligado !");
                    JBL[a][jbl_Blu] = -1;
                    abrir_jbl(playerid, a);
                    texto_jbl(a);
                }
                else
                {
                    ms(playerid, 2, "Bluetooth Desconectado do aparelho atual !");
                    desconectar_jbl(a);
                    abrir_jbl(playerid, a);
                }

	        }

	        // guardar //
	        if(listitem == 1)
	        {
                if(!add_inv(c, 78, 1))
                {
                    ms(playerid, 0, "Seu Inventario esta lotado !");
                	abrir_jbl(playerid, a);
                }
                else
                {
                    desconectar_jbl(a);
                    JBL[a][jbl_Existe] = 0;
                    atualizar_jbl(a);
                    format(string_prox, 300, "** '%s' guardou sua JBL **", Nome(playerid));
					ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
					ApplyAnimation(playerid,"BOMBER", "BOM_PLANT_CROUCH_OUT", 4.1, false, false, false, false, 0, 1);
                }
