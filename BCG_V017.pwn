}

stock logs_org2(playerid, i)
{
    if(Org[i][o_Existe] == 1)
	{
	    if(Online(playerid))
	    {
	        new file[80];
		    format(file, 80, "OrgsLog/Org_%d.txt", i);
	        ler_logs(file);
	        ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, Org[i][o_Nome], SG, "Ok", "Fechar");
