	{
		if(id[playerid] != -1) SetPlayerName(playerid, Conta[playerid][c_Nick]);
	}
}

stock mostrar_cidades(playerid, opc=-1)
{
    new sss[300];
    new Float:p[3];
	new Float:dist;
    GetPlayerPos(playerid, p[0], p[1], p[2]);
	SG[0] = EOS;
	SetPVarInt(playerid, "cidade", opc);
	if(opc == -1)
	{
		strcat(SG, "Zonas\tLocais\n");
		format(sss, 300, "{ffffff}Zona Leste\t{a1a1a1}%s\n", ConvertMoney(sizeof Local_LosSantos));
		strcat(SG, sss);
		format(sss, 300, "{ffffff}Zona Sul\t{a1a1a1}%s\n", ConvertMoney(sizeof Local_SanFierro));
		strcat(SG, sss);
		format(sss, 300, "{ffffff}Zona Oeste\t{a1a1a1}%s\n", ConvertMoney(sizeof Local_LasVenturas));
		strcat(SG, sss);
		format(sss, 300, "{ffffff}Caixas Eletronicos\t{a1a1a1}%d\n", caixas_eletronicos());
		strcat(SG, sss);
		ShowPlayerDialog(playerid, DIALOG_LOCAIS, DIALOG_STYLE_TABLIST_HEADERS, "Localizacoes", SG, "Continuar", "Fechar");
	}
	else
	{
	if(opc == 0)
    {
        strcat(SG, "Local\tDistancia\n");
		for(new i; i<sizeof Local_LosSantos; i++)
		{
			dist = GetPlayerDistanceFromPoint(playerid, Local_LosSantos[i][local_X],  Local_LosSantos[i][local_Y], Local_LosSantos[i][local_Z]);
		    format(sss, 300, "{ffffff}%s\t{a1a1a1}%.0f Metros\n", Local_LosSantos[i][local_Nome], dist);
            strcat(SG, sss);
		}
		ShowPlayerDialog(playerid, DIALOG_LOCAIS2, DIALOG_STYLE_TABLIST_HEADERS, "Zona Leste", SG, "Continuar", "Fechar");
	}

	if(opc == 1)
	{
        strcat(SG, "Local\tDistancia\n");
		for(new i; i<sizeof Local_SanFierro; i++)
		{
		    dist = GetPlayerDistanceFromPoint(playerid,  Local_SanFierro[i][local_X],  Local_SanFierro[i][local_Y], Local_SanFierro[i][local_Z]);
		    format(sss, 300, "{ffffff}%s\t{a1a1a1}%.0f Metros\n", Local_SanFierro[i][local_Nome], dist);
            strcat(SG, sss);
		}
		ShowPlayerDialog(playerid, DIALOG_LOCAIS2, DIALOG_STYLE_TABLIST_HEADERS, "Zona Sul", SG, "Continuar", "Fechar");
	}

	if(opc == 2)
	{
        strcat(SG, "Local\tDistancia\n");
		for(new i; i<sizeof Local_LasVenturas; i++)
		{
		   	dist = GetPlayerDistanceFromPoint(playerid,  Local_LasVenturas[i][local_X],  Local_LasVenturas[i][local_Y], Local_LasVenturas[i][local_Z]);
		    format(sss, 300, "{ffffff}%s\t{a1a1a1}%.0f Metros\n", Local_LasVenturas[i][local_Nome], dist);
            strcat(SG, sss);
		}
		ShowPlayerDialog(playerid, DIALOG_LOCAIS2, DIALOG_STYLE_TABLIST_HEADERS, "Zona Oeste", SG, "Continuar", "Fechar");
	}

	if(opc == 3)
	{
		new cep = -1;
		new Float:disf1 = 999999999.0;
		new Float:disf;
		foreach(new ii:Iter_CaixasEletronicos)
		{
	        	if(CaixaEletronico[ii][ce_Existe] == 1)
				{
				if(CaixaEletronico[ii][ce_Quebrado] == 0)
				{
				    GetDistance(disf, p[0],p[1],p[2],  CaixaEletronico[ii][ce_X],  CaixaEletronico[ii][ce_Y], CaixaEletronico[ii][ce_Z]);
						if(disf < disf1)
						{
						    disf1 = disf;
						    cep = ii;
						}
				}
			    }
		}
		SetPVarInt(playerid, "caixa_mais_proximo", cep);

		new cont;
		strcat(SG, "Local\tCidade\tDistancia\n");
		if(cep != -1)
		{
		    format(sss, 300, "{4169E1}CAIXA MAIS PROXIMO\t{ffffff}%s\t{a1a1a1}%.0f Metros\n", cidade(CaixaEletronico[cep][ce_Cidade]), disf1);
		strcat(SG, sss);
		}

		lista_caixas[playerid][0] = -1;
		foreach(new i:Iter_CaixasEletronicos)
			{
			    if(CaixaEletronico[i][ce_Existe] == 1)
				{
				if(CaixaEletronico[i][ce_Quebrado] == 0)
				{
					    GetDistance(dist, p[0],p[1],p[2],  CaixaEletronico[i][ce_X],  CaixaEletronico[i][ce_Y], CaixaEletronico[i][ce_Z]);
					    format(sss, 300, "{00ffff}Caixa Eletronico (%d)\t{ffffff}%s\t{a1a1a1}%.0f Metros\n", i, cidade(CaixaEletronico[i][ce_Cidade]), dist);
		                strcat(SG, sss);
	                }
	                if(CaixaEletronico[i][ce_Quebrado] == 1)
				{
					    GetDistance(dist, p[0],p[1],p[2],  CaixaEletronico[i][ce_X],  CaixaEletronico[i][ce_Y], CaixaEletronico[i][ce_Z]);
					    format(sss, 300, "{ff0000}Caixa Eletronico (%d)\t{ffffff}%s\t{a1a1a1}%.0f Metros\n", i, cidade(CaixaEletronico[i][ce_Cidade]), dist);
		                strcat(SG, sss);
	                }
	                lista_caixas[playerid][cont] = i;
	                cont++;
				}
			}
			ShowPlayerDialog(playerid, DIALOG_LOCAIS3, DIALOG_STYLE_TABLIST_HEADERS, "Caixas Eletronicos", SG, "Continuar", "Fechar");
	    }
	}
}

stock gmx(con=0)
{
	if(GMX == 0)
	{
		GMX = 1;
		foreach(new i:Player)
		{
		    if(Online(i))
		    {
		        if(con == 0) GameTextForPlayer(i, "~Y~GMX AGUARDE ...", 10000, 3);
	            Congelar(i);
	            SetPlayerArmedWeapon(i, 0);
			}
		}
		SetTimer("dar_gmx", 3000, false);
	}
}

