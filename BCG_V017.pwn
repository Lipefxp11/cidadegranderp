stock id_armas_org(arma)
{
	for(new i; i<sizeof armas_org; i++)
	{
	    if(armas_org[i][0] == arma)
	    {
	        return i;
	    }
	}
	return -1;
}

stock atualizar_teleporte(i)
{
	if(IsValidDynamic3DTextLabel(Teleporte[i][t_3D1])) DestroyDynamic3DTextLabel(Teleporte[i][t_3D1]);
	if(IsValidDynamic3DTextLabel(Teleporte[i][t_3D2])) DestroyDynamic3DTextLabel(Teleporte[i][t_3D2]);
	Teleporte[i][t_3D1] = DynamicText3D:-1;
	Teleporte[i][t_3D2] = DynamicText3D:-1;
	Iter_Remove(Iter_Teleportes, i);

	if(IsValidDynamicPickup(Teleporte[i][t_Pickup1])) DestroyDynamicPickup(Teleporte[i][t_Pickup1]);
	if(IsValidDynamicPickup(Teleporte[i][t_Pickup2])) DestroyDynamicPickup(Teleporte[i][t_Pickup2]);
	if(IsValidDynamicMapIcon(Teleporte[i][t_Mapa1])) DestroyDynamicMapIcon(Teleporte[i][t_Mapa1]);
	if(IsValidDynamicMapIcon(Teleporte[i][t_Mapa2])) DestroyDynamicMapIcon(Teleporte[i][t_Mapa2]);
	if(Teleporte[i][t_Existe] == 1)
	{
	    new sss[300];
	    Iter_Add(Iter_Teleportes, i);
		if(Teleporte[i][t_X1] != 0 && Teleporte[i][t_Y1] != 0 && Teleporte[i][t_Z1] != 0) if(Teleporte[i][t_MapaID1] != -1) Teleporte[i][t_Mapa1] = CreateDynamicMapIcon(Teleporte[i][t_X1], Teleporte[i][t_Y1], Teleporte[i][t_Z1], Teleporte[i][t_MapaID1], 0xffffffff, Teleporte[i][t_Mundo1], Teleporte[i][t_Interior1], -1, STREAMER_MAP_ICON_SD, MAPICON_LOCAL, -1, 0);
		if(Teleporte[i][t_X2] != 0 && Teleporte[i][t_Y2] != 0 && Teleporte[i][t_Z2] != 0) if(Teleporte[i][t_MapaID2] != -1) Teleporte[i][t_Mapa2] = CreateDynamicMapIcon(Teleporte[i][t_X2], Teleporte[i][t_Y2], Teleporte[i][t_Z2], Teleporte[i][t_MapaID2], 0xffffffff, Teleporte[i][t_Mundo2], Teleporte[i][t_Interior2], -1, STREAMER_MAP_ICON_SD, MAPICON_LOCAL, -1, 0);
		if(Teleporte[i][t_X1] != 0 && Teleporte[i][t_Y1] != 0 && Teleporte[i][t_Z1] != 0) Teleporte[i][t_Pickup1] = CreateDynamicPickup(19134, 1, Teleporte[i][t_X1], Teleporte[i][t_Y1], Teleporte[i][t_Z1], Teleporte[i][t_Mundo1], Teleporte[i][t_Interior1], -1, STREAMER_PICKUP_SD, -1, 0);
		if(Teleporte[i][t_X2] != 0 && Teleporte[i][t_Y2] != 0 && Teleporte[i][t_Z2] != 0) Teleporte[i][t_Pickup2] = CreateDynamicPickup(19134, 1, Teleporte[i][t_X2], Teleporte[i][t_Y2], Teleporte[i][t_Z2], Teleporte[i][t_Mundo2], Teleporte[i][t_Interior2], -1, STREAMER_PICKUP_SD, -1, 0);
		format(sss, 300, "%s\n%s\n%s", Teleporte[i][t_Texto1_1], Teleporte[i][t_Texto1_2], Teleporte[i][t_Texto1_3]);
        if(Teleporte[i][t_X1] != 0 && Teleporte[i][t_Y1] != 0 && Teleporte[i][t_Z1] != 0) Teleporte[i][t_3D1] = CreateDynamic3DTextLabel( sss, 0xffffff90, Teleporte[i][t_X1], Teleporte[i][t_Y1], Teleporte[i][t_Z1], 5, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, Teleporte[i][t_Mundo1], Teleporte[i][t_Interior1], -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
        format(sss, 300, "%s\n%s\n%s", Teleporte[i][t_Texto2_1], Teleporte[i][t_Texto2_2], Teleporte[i][t_Texto2_3]);
        if(Teleporte[i][t_X2] != 0 && Teleporte[i][t_Y2] != 0 && Teleporte[i][t_Z2] != 0) Teleporte[i][t_3D2] = CreateDynamic3DTextLabel( sss, 0xffffff90, Teleporte[i][t_X2], Teleporte[i][t_Y2], Teleporte[i][t_Z2], 5, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, Teleporte[i][t_Mundo2], Teleporte[i][t_Interior2], -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
	}
}

stock salvar_teleporte(i)
{
    new file[80];
    format(file, 80, "Teleportes/Teleporte_%d.txt", i);
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
    if(Teleporte[i][t_Existe] == 1)
    {
		DOF2_CreateFile(file);
		DOF2_SetInt(file, "t_MapaID1", Teleporte[i][t_MapaID1]);
	    DOF2_SetInt(file, "t_MapaID2", Teleporte[i][t_MapaID2]);
	    DOF2_SetInt(file, "t_Mundo1", Teleporte[i][t_Mundo1]);
	    DOF2_SetInt(file, "t_Mundo2", Teleporte[i][t_Mundo2]);
	    DOF2_SetInt(file, "t_Interior1", Teleporte[i][t_Interior1]);
	    DOF2_SetInt(file, "t_Interior2", Teleporte[i][t_Interior2]);
	    DOF2_SetFloat(file, "t_X1", Teleporte[i][t_X1]);
	    DOF2_SetFloat(file, "t_Y1", Teleporte[i][t_Y1]);
	    DOF2_SetFloat(file, "t_Z1", Teleporte[i][t_Z1]);
	    DOF2_SetFloat(file, "t_X2", Teleporte[i][t_X2]);
	    DOF2_SetFloat(file, "t_Y2", Teleporte[i][t_Y2]);
	    DOF2_SetFloat(file, "t_Z2", Teleporte[i][t_Z2]);
		DOF2_SetString(file, "t_Texto1_1", Teleporte[i][t_Texto1_1]);
		DOF2_SetString(file, "t_Texto1_2", Teleporte[i][t_Texto1_2]);
		DOF2_SetString(file, "t_Texto1_3", Teleporte[i][t_Texto1_3]);
		DOF2_SetString(file, "t_Texto2_1", Teleporte[i][t_Texto2_1]);
		DOF2_SetString(file, "t_Texto2_2", Teleporte[i][t_Texto2_2]);
		DOF2_SetString(file, "t_Texto2_3", Teleporte[i][t_Texto2_3]);
	    DOF2_SaveFile();
    }
}

BCG:: carregar_teleportes()
{
	new file[80];
	new cont;

	for(new i; i<MAX_TELEPORTES; i++)
	{
	    Teleporte[i][t_3D1] = DynamicText3D:-1;
	    Teleporte[i][t_3D2] = DynamicText3D:-1;
	    format(file, 80, "Teleportes/Teleporte_%d.txt", i);
	    if(DOF2_FileExists(file))
	    {
	        Teleporte[i][t_Existe] = 1;
	        Teleporte[i][t_MapaID1] = DOF2_GetInt(file, "t_MapaID1");
	        Teleporte[i][t_MapaID2] = DOF2_GetInt(file, "t_MapaID2");
	        Teleporte[i][t_Mundo1] = DOF2_GetInt(file, "t_Mundo1");
	        Teleporte[i][t_Mundo2] = DOF2_GetInt(file, "t_Mundo2");
	        Teleporte[i][t_Interior1] = DOF2_GetInt(file, "t_Interior1");
	        Teleporte[i][t_Interior2] = DOF2_GetInt(file, "t_Interior2");
	        Teleporte[i][t_X1] = DOF2_GetFloat(file, "t_X1");
	        Teleporte[i][t_Y1] = DOF2_GetFloat(file, "t_Y1");
	        Teleporte[i][t_Z1] = DOF2_GetFloat(file, "t_Z1");
	        Teleporte[i][t_X2] = DOF2_GetFloat(file, "t_X2");
	        Teleporte[i][t_Y2] = DOF2_GetFloat(file, "t_Y2");
	        Teleporte[i][t_Z2] = DOF2_GetFloat(file, "t_Z2");
			format( Teleporte[i][t_Texto1_1], 100, "%s", DOF2_GetString(file, "t_Texto1_1"));
			format( Teleporte[i][t_Texto1_2], 100, "%s", DOF2_GetString(file, "t_Texto1_2"));
			format( Teleporte[i][t_Texto1_3], 100, "%s", DOF2_GetString(file, "t_Texto1_3"));
			format( Teleporte[i][t_Texto2_1], 100, "%s", DOF2_GetString(file, "t_Texto2_1"));
			format( Teleporte[i][t_Texto2_2], 100, "%s", DOF2_GetString(file, "t_Texto2_2"));
			format( Teleporte[i][t_Texto2_3], 100, "%s", DOF2_GetString(file, "t_Texto2_3"));
			atualizar_teleporte(i);
			cont++;
	    }
	}
    printf("** %d Teleportes do Servidor carregados.", cont);
}

stock criar_teleporte(Float:xx, Float:yy, Float:zz, mund, inter)
{
	for(new i; i<MAX_TELEPORTES; i++)
	{
		if(Teleporte[i][t_Existe] == 0)
		{
            Teleporte[i][t_Existe] = 1;
	        Teleporte[i][t_MapaID1] = 0;
	        Teleporte[i][t_MapaID2] = -1;
	        Teleporte[i][t_Mundo1] = mund;
	        Teleporte[i][t_Mundo2] = 0;
	        Teleporte[i][t_Interior1] = inter;
	        Teleporte[i][t_Interior2] = 0;
	        Teleporte[i][t_X1] = xx;
	        Teleporte[i][t_Y1] = yy;
	        Teleporte[i][t_Z1] = zz;
	        Teleporte[i][t_X2] = 0;
	        Teleporte[i][t_Y2] = 0;
	        Teleporte[i][t_Z2] = 0;
			format( Teleporte[i][t_Texto1_1], 100, "{FFFF00}TELEPORTE");
			format( Teleporte[i][t_Texto1_2], 100, "{a1a1a1}Aperte {ffffff}F {a1a1a1}para");
			format( Teleporte[i][t_Texto1_3], 100, "{a1a1a1}entrar");
			format( Teleporte[i][t_Texto2_1], 100, "{FFFF00}TELEPORTE");
			format( Teleporte[i][t_Texto2_2], 100, "{a1a1a1}Aperte {ffffff}F {a1a1a1}para");
			format( Teleporte[i][t_Texto2_3], 100, "{a1a1a1}sair");
			atualizar_teleporte(i);
			salvar_teleporte(i);
			return i;
		}
	}
	return -1;
}


stock abrir_texto_teleporte(playerid, i, a, dd)
{
	SetPVarInt(playerid, "texto", dd);
	new sss[400];

	// entrada //
	if(a == 0)
	{
		if(dd == 1)
	    {
	        format(sss, 400, "{ffffff}\n\
			{ffffff}Texto 1 atual: [ %s {ffffff}]\n\n\
			{ffffff}Digite o novo texto da linha 1:\n",
			Teleporte[i][t_Texto1_1]);
	    }

	    if(dd == 2)
	    {
	        format(sss, 400, "{ffffff}\n\
			{ffffff}Texto 2 atual: [ %s {ffffff}]\n\n\
			{ffffff}Digite o novo texto da linha 2:\n",
			Teleporte[i][t_Texto1_2]);
	    }

	    if(dd == 3)
	    {
	        format(sss, 400, "{ffffff}\n\
			{ffffff}Texto 3 atual: [ %s {ffffff}]\n\n\
			{ffffff}Digite o novo texto da linha 3:\n",
			Teleporte[i][t_Texto1_3]);
	    }
	    ShowPlayerDialog(playerid, DIALOG_TELEPORTE5, DIALOG_STYLE_INPUT, "Setar Texto Entrada", sss, "Setar", "Cancelar");
	}

	// saida //
	if(a == 1)
	{
		if(dd == 1)
	    {
	        format(sss, 400, "{ffffff}\n\
			{ffffff}Texto 1 atual: [ %s {ffffff}]\n\n\
			{ffffff}Digite o novo texto da linha 1:\n",
			Teleporte[i][t_Texto2_1]);
	    }

	    if(dd == 2)
	    {
	        format(sss, 400, "{ffffff}\n\
			{ffffff}Texto 2 atual: [ %s {ffffff}]\n\n\
			{ffffff}Digite o novo texto da linha 2:\n",
			Teleporte[i][t_Texto2_2]);
	    }

	    if(dd == 3)
	    {
	        format(sss, 400, "{ffffff}\n\
			{ffffff}Texto 3 atual: [ %s {ffffff}]\n\n\
			{ffffff}Digite o novo texto da linha 3:\n",
			Teleporte[i][t_Texto2_3]);
	    }
	    ShowPlayerDialog(playerid, DIALOG_TELEPORTE5, DIALOG_STYLE_INPUT, "Setar Texto Saida", sss, "Setar", "Cancelar");
	}
}

