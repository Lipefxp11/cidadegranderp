	// UBER //
	if(con == C_UBER_ABRINDO)
	{
	    celular_aberto[playerid] = C_UBER_ABRINDO;
	    for(new b; b<sizeof T_Celular_Uber_Carregando; b++) TextDrawShowForPlayer(playerid, T_Celular_Uber_Carregando[b]);
	    timer_celular[playerid] = SetTimerEx("TimerCelular", 1250, false, "dd", playerid, C_UBER);
		return 1;
	}
	if(con == C_UBER)
	{
        celular_aberto[playerid] = C_UBER;
        for(new b; b<sizeof T_Celular_Uber_Opcoes; b++) TextDrawShowForPlayer(playerid, T_Celular_Uber_Opcoes[b]);
	    return 1;
	}
	if(con == C_UBER_CLIENTE)
	{
	    celular_aberto[playerid] = C_UBER_CLIENTE;

	    // chamar um uber //
	    if(Uber[playerid][uber_Status] == 0)
	    {
	        if(Uber[playerid][uber_Destino] != -1 && Uber[playerid][uber_Cidade] != -1)
	        {
	            // locais normais //
	        	if(GetPVarInt(playerid, "uber_gps") == 0)
	        	{
		            PlayerTextDrawSetString(playerid, T_Celular_Uber_Cliente_p[playerid][0], destino(Uber[playerid][uber_Destino], Uber[playerid][uber_Cidade]));
		            PlayerTextDrawSetString(playerid, T_Celular_Uber_Cliente_p[playerid][1], cidade(Uber[playerid][uber_Cidade]));
		            new Float:distt;
				    GetPlayerPos(playerid, Uber[playerid][uber_X], Uber[playerid][uber_Y], Uber[playerid][uber_Z]);
				    if(Uber[playerid][uber_Cidade] == 0)
					{
						GetDistance(distt, Uber[playerid][uber_X], Uber[playerid][uber_Y], Uber[playerid][uber_Z], Local_LosSantos[Uber[playerid][uber_Destino]][local_X], Local_LosSantos[Uber[playerid][uber_Destino]][local_Y], Local_LosSantos[Uber[playerid][uber_Destino]][local_Z]);
	                    Uber[playerid][uber_DX] = Local_LosSantos[Uber[playerid][uber_Destino]][local_X];
	                    Uber[playerid][uber_DY] = Local_LosSantos[Uber[playerid][uber_Destino]][local_Y];
	                    Uber[playerid][uber_DZ] = Local_LosSantos[Uber[playerid][uber_Destino]][local_Z];
					}
					if(Uber[playerid][uber_Cidade] == 1)
					{
						GetDistance(distt, Uber[playerid][uber_X], Uber[playerid][uber_Y], Uber[playerid][uber_Z], Local_SanFierro[Uber[playerid][uber_Destino]][local_X], Local_SanFierro[Uber[playerid][uber_Destino]][local_Y], Local_SanFierro[Uber[playerid][uber_Destino]][local_Z]);
	                    Uber[playerid][uber_DX] = Local_SanFierro[Uber[playerid][uber_Destino]][local_X];
	                    Uber[playerid][uber_DY] = Local_SanFierro[Uber[playerid][uber_Destino]][local_Y];
	                    Uber[playerid][uber_DZ] = Local_SanFierro[Uber[playerid][uber_Destino]][local_Z];
					}
					if(Uber[playerid][uber_Cidade] == 2)
					{
						GetDistance(distt, Uber[playerid][uber_X], Uber[playerid][uber_Y], Uber[playerid][uber_Z], Local_LasVenturas[Uber[playerid][uber_Destino]][local_X], Local_LasVenturas[Uber[playerid][uber_Destino]][local_Y], Local_LasVenturas[Uber[playerid][uber_Destino]][local_Z]);
	                    Uber[playerid][uber_DX] = Local_LasVenturas[Uber[playerid][uber_Destino]][local_X];
	                    Uber[playerid][uber_DY] = Local_LasVenturas[Uber[playerid][uber_Destino]][local_Y];
	                    Uber[playerid][uber_DZ] = Local_LasVenturas[Uber[playerid][uber_Destino]][local_Z];
					}
					Uber[playerid][uber_Distancia] = distt;
				    Uber[playerid][uber_Valor] = 250*(floatround(Uber[playerid][uber_Distancia])/500);
					if(Uber[playerid][uber_Valor] < 250) Uber[playerid][uber_Valor] = 250;
		            format(sss, 300, "%.0f Metros", Uber[playerid][uber_Distancia]);
		            PlayerTextDrawSetString(playerid, T_Celular_Uber_Cliente_p[playerid][2], sss);
		            format(sss, 300, "R$ %s", ConvertMoney(Uber[playerid][uber_Valor]));
		            PlayerTextDrawSetString(playerid, T_Celular_Uber_Cliente_p[playerid][3], sss);
		        }


		        // caixas eletronicos //
	        	if(GetPVarInt(playerid, "uber_gps") == 1)
	        	{
					new sssa[100];
					new idc = Uber[playerid][uber_Destino];
					format(sssa, 100, "Caixa eletronico (%d)", idc);
		            PlayerTextDrawSetString(playerid, T_Celular_Uber_Cliente_p[playerid][0], sssa);
		            PlayerTextDrawSetString(playerid, T_Celular_Uber_Cliente_p[playerid][1], cidade(Uber[playerid][uber_Cidade]));
		            new Float:distt;
				    GetPlayerPos(playerid, Uber[playerid][uber_X], Uber[playerid][uber_Y], Uber[playerid][uber_Z]);
                	GetDistance(distt, Uber[playerid][uber_X], Uber[playerid][uber_Y], Uber[playerid][uber_Z], CaixaEletronico[idc][ce_X], CaixaEletronico[idc][ce_Y], CaixaEletronico[idc][ce_Z]);
                	Uber[playerid][uber_DX] = CaixaEletronico[idc][ce_X];
	               	Uber[playerid][uber_DY] = CaixaEletronico[idc][ce_Y];
	               	Uber[playerid][uber_DZ] = CaixaEletronico[idc][ce_Z];
					Uber[playerid][uber_Distancia] = distt;
				    Uber[playerid][uber_Valor] = 250*(floatround(Uber[playerid][uber_Distancia])/500);
					if(Uber[playerid][uber_Valor] < 250) Uber[playerid][uber_Valor] = 250;
		            format(sss, 300, "%.0f Metros", Uber[playerid][uber_Distancia]);
		            PlayerTextDrawSetString(playerid, T_Celular_Uber_Cliente_p[playerid][2], sss);
		            format(sss, 300, "R$ %s", ConvertMoney(Uber[playerid][uber_Valor]));
		            PlayerTextDrawSetString(playerid, T_Celular_Uber_Cliente_p[playerid][3], sss);
		    	}

		    	// CASAS //
	        	if(GetPVarInt(playerid, "uber_gps") == 2)
	        	{

					new sssa[100];
					new idc = Uber[playerid][uber_Destino];
					format(sssa, 100, "Casa (%d)", idc);
		            PlayerTextDrawSetString(playerid, T_Celular_Uber_Cliente_p[playerid][0], sssa);
		            PlayerTextDrawSetString(playerid, T_Celular_Uber_Cliente_p[playerid][1], cidade(Uber[playerid][uber_Cidade]));
		            new Float:distt;
				    GetPlayerPos(playerid, Uber[playerid][uber_X], Uber[playerid][uber_Y], Uber[playerid][uber_Z]);
                	GetDistance(distt, Uber[playerid][uber_X], Uber[playerid][uber_Y], Uber[playerid][uber_Z], Casa[idc][casa_X1], Casa[idc][casa_Y1], Casa[idc][casa_Z1]);
                	Uber[playerid][uber_DX] = Casa[idc][casa_X1];
	               	Uber[playerid][uber_DY] = Casa[idc][casa_Y1];
	               	Uber[playerid][uber_DZ] = Casa[idc][casa_Z1];
					Uber[playerid][uber_Distancia] = distt;
				    Uber[playerid][uber_Valor] = 250*(floatround(Uber[playerid][uber_Distancia])/500);
					if(Uber[playerid][uber_Valor] < 250) Uber[playerid][uber_Valor] = 250;
		            format(sss, 300, "%.0f Metros", Uber[playerid][uber_Distancia]);
		            PlayerTextDrawSetString(playerid, T_Celular_Uber_Cliente_p[playerid][2], sss);
		            format(sss, 300, "R$ %s", ConvertMoney(Uber[playerid][uber_Valor]));
		            PlayerTextDrawSetString(playerid, T_Celular_Uber_Cliente_p[playerid][3], sss);
		    	}

		    }
		    else
		    {
		        PlayerTextDrawSetString(playerid, T_Celular_Uber_Cliente_p[playerid][0], "~r~~h~Desconhecido");
		        PlayerTextDrawSetString(playerid, T_Celular_Uber_Cliente_p[playerid][1], "~r~~h~Desconhecido");
		        PlayerTextDrawSetString(playerid, T_Celular_Uber_Cliente_p[playerid][2], "~r~~h~Desconhecido");
		        PlayerTextDrawSetString(playerid, T_Celular_Uber_Cliente_p[playerid][3], "R$ 0");
		    }

		    for(new b; b<((sizeof T_Celular_Uber_Cliente)-1); b++) TextDrawShowForPlayer(playerid, T_Celular_Uber_Cliente[b]);
		    PlayerTextDrawShow(playerid, T_Celular_Uber_Cliente_p[playerid][0]);
	        PlayerTextDrawShow(playerid, T_Celular_Uber_Cliente_p[playerid][1]);
	        PlayerTextDrawShow(playerid, T_Celular_Uber_Cliente_p[playerid][2]);
	        PlayerTextDrawShow(playerid, T_Celular_Uber_Cliente_p[playerid][3]);
        }

        // ja chamou um uber //
        if(Uber[playerid][uber_Status] == 1)
	    {
	        format(sss, 300, "aguarde: %s", ConvertMoney(Uber[playerid][uber_Tempo]));
	        PlayerTextDrawSetString(playerid, T_Celular_Uber_Cliente_p[playerid][4], sss);
	        for(new b; b<((sizeof T_Celular_Uber_Cliente)-3); b++) TextDrawShowForPlayer(playerid, T_Celular_Uber_Cliente[b]);
	        TextDrawShowForPlayer(playerid, T_Celular_Uber_Cliente[5]);
	        PlayerTextDrawShow(playerid, T_Celular_Uber_Cliente_p[playerid][0]);
	        PlayerTextDrawShow(playerid, T_Celular_Uber_Cliente_p[playerid][1]);
	        PlayerTextDrawShow(playerid, T_Celular_Uber_Cliente_p[playerid][2]);
	        PlayerTextDrawShow(playerid, T_Celular_Uber_Cliente_p[playerid][3]);
	        PlayerTextDrawShow(playerid, T_Celular_Uber_Cliente_p[playerid][4]);
	    }

	    // se o uber aceitar a viajem //
	    if(Uber[playerid][uber_Status] == 2)
	    {
	        PlayerTextDrawSetString(playerid, T_Celular_Uber_Cliente_p[playerid][4], "~b~~h~corrida aceita");
	        for(new b; b<((sizeof T_Celular_Uber_Cliente)-3); b++) TextDrawShowForPlayer(playerid, T_Celular_Uber_Cliente[b]);
	        PlayerTextDrawShow(playerid, T_Celular_Uber_Cliente_p[playerid][0]);
	        PlayerTextDrawShow(playerid, T_Celular_Uber_Cliente_p[playerid][1]);
	        PlayerTextDrawShow(playerid, T_Celular_Uber_Cliente_p[playerid][2]);
	        PlayerTextDrawShow(playerid, T_Celular_Uber_Cliente_p[playerid][3]);
	        PlayerTextDrawShow(playerid, T_Celular_Uber_Cliente_p[playerid][4]);
	        PlayerTextDrawShow(playerid, T_Celular_Uber_Cliente_p[playerid][5]);
	    }

	    // se o uber tiver na viajem //
	    if(Uber[playerid][uber_Status] == 3)
	    {
	        PlayerTextDrawSetString(playerid, T_Celular_Uber_Cliente_p[playerid][4], "~b~~h~em corrida");
	        for(new b; b<((sizeof T_Celular_Uber_Cliente)-3); b++) TextDrawShowForPlayer(playerid, T_Celular_Uber_Cliente[b]);
	        PlayerTextDrawShow(playerid, T_Celular_Uber_Cliente_p[playerid][0]);
	        PlayerTextDrawShow(playerid, T_Celular_Uber_Cliente_p[playerid][1]);
	        PlayerTextDrawShow(playerid, T_Celular_Uber_Cliente_p[playerid][2]);
	        PlayerTextDrawShow(playerid, T_Celular_Uber_Cliente_p[playerid][3]);
	        PlayerTextDrawShow(playerid, T_Celular_Uber_Cliente_p[playerid][4]);
	        PlayerTextDrawShow(playerid, T_Celular_Uber_Cliente_p[playerid][5]);
	    }

        return 1;
	}

	if(con == C_UBER_VIAGEM)
	{
	    celular_aberto[playerid] = C_UBER_VIAGEM;
	    new v = ViagemUber(playerid);
	    if(v != -1)
	    {
	        // local normal //
	        if(GetPVarInt(playerid, "uber_gps") == 0)
	        {
	            PlayerTextDrawSetString(playerid, T_Celular_Uber_Viagem_p[playerid][0], Nome(v));
	            PlayerTextDrawSetString(playerid, T_Celular_Uber_Viagem_p[playerid][1], destino(Uber[v][uber_Destino], Uber[v][uber_Cidade]));
				PlayerTextDrawSetString(playerid, T_Celular_Uber_Viagem_p[playerid][2], cidade(Uber[v][uber_Cidade]));
				format(sss, 300, "R$ %s", ConvertMoney(Uber[v][uber_Valor]));
				PlayerTextDrawSetString(playerid, T_Celular_Uber_Viagem_p[playerid][3], sss);
				format(sss, 300, "%.0f Metros", Uber[v][uber_Distancia]);
				PlayerTextDrawSetString(playerid, T_Celular_Uber_Viagem_p[playerid][4], sss);
	            for(new c; c<5; c++) PlayerTextDrawShow(playerid, T_Celular_Uber_Viagem_p[playerid][c]);
	            for(new b; b<sizeof T_Celular_Uber_Viagem; b++) TextDrawShowForPlayer(playerid, T_Celular_Uber_Viagem[b]);
            }


            //  caixa eletronico //
	        if(GetPVarInt(playerid, "uber_gps") == 1)
	        {
	            new idc = Uber[v][uber_Destino];
	            new sssa[100];
	            format(sssa, 100, "Caixa Eletronico (%d)", idc);
	            PlayerTextDrawSetString(playerid, T_Celular_Uber_Viagem_p[playerid][0], Nome(v));
	            PlayerTextDrawSetString(playerid, T_Celular_Uber_Viagem_p[playerid][1], sssa);
				PlayerTextDrawSetString(playerid, T_Celular_Uber_Viagem_p[playerid][2], cidade(Uber[v][uber_Cidade]));
				format(sss, 300, "R$ %s", ConvertMoney(Uber[v][uber_Valor]));
				PlayerTextDrawSetString(playerid, T_Celular_Uber_Viagem_p[playerid][3], sss);
				format(sss, 300, "%.0f Metros", Uber[v][uber_Distancia]);
				PlayerTextDrawSetString(playerid, T_Celular_Uber_Viagem_p[playerid][4], sss);
	            for(new c; c<5; c++) PlayerTextDrawShow(playerid, T_Celular_Uber_Viagem_p[playerid][c]);
	            for(new b; b<sizeof T_Celular_Uber_Viagem; b++) TextDrawShowForPlayer(playerid, T_Celular_Uber_Viagem[b]);
            }

            //  casa //
	        if(GetPVarInt(playerid, "uber_gps") == 2)
	        {
	            new idc = Uber[v][uber_Destino];
	            new sssa[100];
	            format(sssa, 100, "Casa (%d)", idc);
	            PlayerTextDrawSetString(playerid, T_Celular_Uber_Viagem_p[playerid][0], Nome(v));
	            PlayerTextDrawSetString(playerid, T_Celular_Uber_Viagem_p[playerid][1], sssa);
				PlayerTextDrawSetString(playerid, T_Celular_Uber_Viagem_p[playerid][2], cidade(Uber[v][uber_Cidade]));
				format(sss, 300, "R$ %s", ConvertMoney(Uber[v][uber_Valor]));
				PlayerTextDrawSetString(playerid, T_Celular_Uber_Viagem_p[playerid][3], sss);
				format(sss, 300, "%.0f Metros", Uber[v][uber_Distancia]);
				PlayerTextDrawSetString(playerid, T_Celular_Uber_Viagem_p[playerid][4], sss);
	            for(new c; c<5; c++) PlayerTextDrawShow(playerid, T_Celular_Uber_Viagem_p[playerid][c]);
	            for(new b; b<sizeof T_Celular_Uber_Viagem; b++) TextDrawShowForPlayer(playerid, T_Celular_Uber_Viagem[b]);
            }

	        return 1;
	    }
	    celular(playerid, C_UBER_MOTORISTA);
	    return 1;
	}

	if(con == C_UBER_MOTORISTA)
	{
	    celular_aberto[playerid] = C_UBER_MOTORISTA;
	    new v = ViagemUber(playerid);
	    if(v != -1) return celular(playerid, C_UBER_VIAGEM);
	    for(new b; b<sizeof T_Celular_Uber_Motorista; b++) TextDrawShowForPlayer(playerid, T_Celular_Uber_Motorista[b]);
		return 1;
	}


	// GPS //
	if(con == C_GPS_ABRINDO)
	{
	    celular_aberto[playerid] = C_GPS_ABRINDO;
	    for(new c; c<sizeof T_Celular_GPS_Carregando; c++) TextDrawShowForPlayer(playerid, T_Celular_GPS_Carregando[c]);
	    timer_celular[playerid] = SetTimerEx("TimerCelular", 1250, false, "dd", playerid, C_GPS);
		return 1;
	}
	if(con == C_GPS)
	{
        celular_aberto[playerid] = C_GPS;

        // se o gps estiver ligado //
        if(GPS[playerid][gps_Status] == 1)
        {
            if(GPS[playerid][gps_Destino] != -1 && GPS[playerid][gps_Cidade] != -1)
            {
                // local normal //
                if(GetPVarInt(playerid, "local_gps") == 0)
                {
	                PlayerTextDrawSetString(playerid, T_Celular_GPS_APK_p[playerid][0], destino(GPS[playerid][gps_Destino], GPS[playerid][gps_Cidade]));
		            PlayerTextDrawSetString(playerid, T_Celular_GPS_APK_p[playerid][1], cidade(GPS[playerid][gps_Cidade]));
		            PlayerTextDrawSetString(playerid, T_Celular_GPS_APK_p[playerid][3], "_");
	                PlayerTextDrawShow(playerid, T_Celular_GPS_APK_p[playerid][0]);
	            	PlayerTextDrawShow(playerid, T_Celular_GPS_APK_p[playerid][1]);
	            	PlayerTextDrawShow(playerid, T_Celular_GPS_APK_p[playerid][3]);
	                TextDrawShowForPlayer(playerid, T_Celular_GPS_APK[0]);
		            TextDrawShowForPlayer(playerid, T_Celular_GPS_APK[1]);
		            TextDrawShowForPlayer(playerid, T_Celular_GPS_APK[2]);
		            TextDrawShowForPlayer(playerid, T_Celular_GPS_APK[5]);
	            }


	            // caixa eletronico //
	            if(GetPVarInt(playerid, "local_gps") == 1)
                {
                    new sssa[100];
                    new idc = GPS[playerid][gps_Destino];
                    format(sssa, 100, "Caixa Eletronico (%d)", idc);
	                PlayerTextDrawSetString(playerid, T_Celular_GPS_APK_p[playerid][0], sssa);
		            PlayerTextDrawSetString(playerid, T_Celular_GPS_APK_p[playerid][1], cidade(GPS[playerid][gps_Cidade]));
		            PlayerTextDrawSetString(playerid, T_Celular_GPS_APK_p[playerid][3], "_");
	                PlayerTextDrawShow(playerid, T_Celular_GPS_APK_p[playerid][0]);
	            	PlayerTextDrawShow(playerid, T_Celular_GPS_APK_p[playerid][1]);
	            	PlayerTextDrawShow(playerid, T_Celular_GPS_APK_p[playerid][3]);
	                TextDrawShowForPlayer(playerid, T_Celular_GPS_APK[0]);
		            TextDrawShowForPlayer(playerid, T_Celular_GPS_APK[1]);
		            TextDrawShowForPlayer(playerid, T_Celular_GPS_APK[2]);
		            TextDrawShowForPlayer(playerid, T_Celular_GPS_APK[5]);
	            }

	            // casa //
	            if(GetPVarInt(playerid, "local_gps") == 2)
                {
                    new sssa[100];
                    new idc = GPS[playerid][gps_Destino];
                    format(sssa, 100, "Casa (%d)", idc);
	                PlayerTextDrawSetString(playerid, T_Celular_GPS_APK_p[playerid][0], sssa);
		            PlayerTextDrawSetString(playerid, T_Celular_GPS_APK_p[playerid][1], cidade(GPS[playerid][gps_Cidade]));
		            PlayerTextDrawSetString(playerid, T_Celular_GPS_APK_p[playerid][3], "_");
	                PlayerTextDrawShow(playerid, T_Celular_GPS_APK_p[playerid][0]);
	            	PlayerTextDrawShow(playerid, T_Celular_GPS_APK_p[playerid][1]);
	            	PlayerTextDrawShow(playerid, T_Celular_GPS_APK_p[playerid][3]);
	                TextDrawShowForPlayer(playerid, T_Celular_GPS_APK[0]);
		            TextDrawShowForPlayer(playerid, T_Celular_GPS_APK[1]);
		            TextDrawShowForPlayer(playerid, T_Celular_GPS_APK[2]);
		            TextDrawShowForPlayer(playerid, T_Celular_GPS_APK[5]);
	            }

			}
        }

        // se o gps estiver desligado //
        if(GPS[playerid][gps_Status] == 0)
        {
            if(GPS[playerid][gps_Destino] != -1 && GPS[playerid][gps_Cidade] != -1)
            {
                // local normal //
	            if(GetPVarInt(playerid, "local_gps") == 0)
                {
	                PlayerTextDrawSetString(playerid, T_Celular_GPS_APK_p[playerid][0], destino(GPS[playerid][gps_Destino], GPS[playerid][gps_Cidade]));
		            PlayerTextDrawSetString(playerid, T_Celular_GPS_APK_p[playerid][1], cidade(GPS[playerid][gps_Cidade]));
		            new Float:distt;
				    GetPlayerPos(playerid, GPS[playerid][gps_X], GPS[playerid][gps_Y], GPS[playerid][gps_Z]);
				    if(GPS[playerid][gps_Cidade] == 0)
					{
						GetDistance(distt, GPS[playerid][gps_X], GPS[playerid][gps_Y], GPS[playerid][gps_Z], Local_LosSantos[GPS[playerid][gps_Destino]][local_X], Local_LosSantos[GPS[playerid][gps_Destino]][local_Y], Local_LosSantos[GPS[playerid][gps_Destino]][local_Z]);
	                    GPS[playerid][gps_DX] = Local_LosSantos[GPS[playerid][gps_Destino]][local_X];
	                    GPS[playerid][gps_DY] = Local_LosSantos[GPS[playerid][gps_Destino]][local_Y];
	                    GPS[playerid][gps_DZ] = Local_LosSantos[GPS[playerid][gps_Destino]][local_Z];
					}
					if(GPS[playerid][gps_Cidade] == 1)
					{
						GetDistance(distt, GPS[playerid][gps_X], GPS[playerid][gps_Y], GPS[playerid][gps_Z], Local_SanFierro[GPS[playerid][gps_Destino]][local_X], Local_SanFierro[GPS[playerid][gps_Destino]][local_Y], Local_SanFierro[GPS[playerid][gps_Destino]][local_Z]);
	                    GPS[playerid][gps_DX] = Local_SanFierro[GPS[playerid][gps_Destino]][local_X];
	                    GPS[playerid][gps_DY] = Local_SanFierro[GPS[playerid][gps_Destino]][local_Y];
	                    GPS[playerid][gps_DZ] = Local_SanFierro[GPS[playerid][gps_Destino]][local_Z];
					}
					if(GPS[playerid][gps_Cidade] == 2)
					{
						GetDistance(distt, GPS[playerid][gps_X], GPS[playerid][gps_Y], GPS[playerid][gps_Z], Local_LasVenturas[GPS[playerid][gps_Destino]][local_X], Local_LasVenturas[GPS[playerid][gps_Destino]][local_Y], Local_LasVenturas[GPS[playerid][gps_Destino]][local_Z]);
	                    GPS[playerid][gps_DX] = Local_LasVenturas[GPS[playerid][gps_Destino]][local_X];
	                    GPS[playerid][gps_DY] = Local_LasVenturas[GPS[playerid][gps_Destino]][local_Y];
	                    GPS[playerid][gps_DZ] = Local_LasVenturas[GPS[playerid][gps_Destino]][local_Z];
					}
					GPS[playerid][gps_Distancia] = distt;
					format(sss, 300, "%.0f Metros", GPS[playerid][gps_Distancia]);
		            PlayerTextDrawSetString(playerid, T_Celular_GPS_APK_p[playerid][2], sss);
	            }


	            // caixa eletronico //
	            if(GetPVarInt(playerid, "local_gps") == 1)
                {
                    new idc = GPS[playerid][gps_Destino];
                    new sssa[100];
                    format(sssa, 100, "Caixa Eletronico (%d)", idc);
	                PlayerTextDrawSetString(playerid, T_Celular_GPS_APK_p[playerid][0], sssa);
		            PlayerTextDrawSetString(playerid, T_Celular_GPS_APK_p[playerid][1], cidade(GPS[playerid][gps_Cidade]));
		            new Float:distt;
				    GetPlayerPos(playerid, GPS[playerid][gps_X], GPS[playerid][gps_Y], GPS[playerid][gps_Z]);
				    GetDistance(distt, GPS[playerid][gps_X], GPS[playerid][gps_Y], GPS[playerid][gps_Z], CaixaEletronico[idc][ce_X], CaixaEletronico[idc][ce_Y], CaixaEletronico[idc][ce_Z]);
                    GPS[playerid][gps_DX] = CaixaEletronico[idc][ce_X];
                    GPS[playerid][gps_DY] = CaixaEletronico[idc][ce_Y];
                    GPS[playerid][gps_DZ] = CaixaEletronico[idc][ce_Z];
					GPS[playerid][gps_Distancia] = distt;
					format(sss, 300, "%.0f Metros", GPS[playerid][gps_Distancia]);
		            PlayerTextDrawSetString(playerid, T_Celular_GPS_APK_p[playerid][2], sss);
	            }

	            // casa //
	            if(GetPVarInt(playerid, "local_gps") == 2)
                {
                    new idc = GPS[playerid][gps_Destino];
                    new sssa[100];
                    format(sssa, 100, "Casa (%d)", idc);
	                PlayerTextDrawSetString(playerid, T_Celular_GPS_APK_p[playerid][0], sssa);
		            PlayerTextDrawSetString(playerid, T_Celular_GPS_APK_p[playerid][1], cidade(GPS[playerid][gps_Cidade]));
		            new Float:distt;
				    GetPlayerPos(playerid, GPS[playerid][gps_X], GPS[playerid][gps_Y], GPS[playerid][gps_Z]);
				    GetDistance(distt, GPS[playerid][gps_X], GPS[playerid][gps_Y], GPS[playerid][gps_Z], Casa[idc][casa_X1], Casa[idc][casa_Y1], Casa[idc][casa_Z1]);
                    GPS[playerid][gps_DX] = Casa[idc][casa_X1];
                    GPS[playerid][gps_DY] = Casa[idc][casa_Y1];
                    GPS[playerid][gps_DZ] = Casa[idc][casa_Z1];
					GPS[playerid][gps_Distancia] = distt;
					format(sss, 300, "%.0f Metros", GPS[playerid][gps_Distancia]);
		            PlayerTextDrawSetString(playerid, T_Celular_GPS_APK_p[playerid][2], sss);
	            }

            }
            else
            {
                PlayerTextDrawSetString(playerid, T_Celular_GPS_APK_p[playerid][0], "~r~~h~Desconhecido");
		        PlayerTextDrawSetString(playerid, T_Celular_GPS_APK_p[playerid][1], "~r~~h~Desconhecido");
		        PlayerTextDrawSetString(playerid, T_Celular_GPS_APK_p[playerid][2], "~r~~h~Desconhecido");
            }

            TextDrawShowForPlayer(playerid, T_Celular_GPS_APK[0]);
            TextDrawShowForPlayer(playerid, T_Celular_GPS_APK[1]);
            TextDrawShowForPlayer(playerid, T_Celular_GPS_APK[2]);
            TextDrawShowForPlayer(playerid, T_Celular_GPS_APK[3]);
            TextDrawShowForPlayer(playerid, T_Celular_GPS_APK[4]);
            PlayerTextDrawShow(playerid, T_Celular_GPS_APK_p[playerid][0]);
            PlayerTextDrawShow(playerid, T_Celular_GPS_APK_p[playerid][1]);
            PlayerTextDrawShow(playerid, T_Celular_GPS_APK_p[playerid][2]);
        }

	    return 1;
	}




	// ITAU //
	if(con == C_ITAU_ABRINDO)
	{
	    celular_aberto[playerid] = C_ITAU_ABRINDO;
	    for(new d; d<sizeof T_Celular_Itau_Carregando; d++) TextDrawShowForPlayer(playerid, T_Celular_Itau_Carregando[d]);
	    timer_celular[playerid] = SetTimerEx("TimerCelular", 1250, false, "dd", playerid, C_ITAU);
		return 1;
	}
	if(con == C_ITAU)
	{
	    new c = id[playerid];
	    if(c != -1)
	    {
	        if(Conta[playerid][c_Pix] <= 0)
	        {
		        format(str_aviso[playerid], 300, "Voce ainda nao tem uma conta !~n~~n~Va ate o Banco com CPF e RG para criar a sua.");
				SetPVarInt(playerid, "aviso", C_INICIO);
				celular(playerid, C_ERRO);
				return 1;
			}
			celular_aberto[playerid] = C_ITAU;
			new pix = Conta[playerid][c_Pix];
			new saldo = Conta[playerid][c_Banco];
			for(new d; d<sizeof T_Celular_Itau_APK; d++) TextDrawShowForPlayer(playerid, T_Celular_Itau_APK[d]);

			new strt[150];
			format(strt, 150, "R$ %s", ConvertMoney(saldo));
            PlayerTextDrawSetString(playerid, T_Celular_Itau_APK_p[playerid][0], strt);
			PlayerTextDrawShow(playerid, T_Celular_Itau_APK_p[playerid][0]);
			format(strt, 150, "%05d", pix);
			PlayerTextDrawSetString(playerid, T_Celular_Itau_APK_p[playerid][1], strt);
			PlayerTextDrawShow(playerid, T_Celular_Itau_APK_p[playerid][1]);
		}
	    return 1;
	}

	// blaze  //
	if(con == C_BLAZE_ABRINDO)
	{
	    celular_aberto[playerid] = C_BLAZE_ABRINDO;
	    for(new e; e<sizeof T_Celular_Blaze_Carregando; e++) TextDrawShowForPlayer(playerid, T_Celular_Blaze_Carregando[e]);
	    timer_celular[playerid] = SetTimerEx("TimerCelular", 1250, false, "dd", playerid, C_BLAZE);
		return 1;
	}
	if(con == C_BLAZE)
	{
	    celular_aberto[playerid] = C_BLAZE;
	    PlayerTextDrawShow(playerid, T_Celular_Blaze_APK_p[playerid][0]);
	    PlayerTextDrawShow(playerid, T_Celular_Blaze_APK_p[playerid][1]);
        for(new e; e<sizeof T_Celular_Blaze_APK; e++) TextDrawShowForPlayer(playerid, T_Celular_Blaze_APK[e]);
        format_aposta(playerid);
		return 1;
	}

	// WHATSAPP  //
	if(con == C_WP_ABRINDO)
	{
	    celular_aberto[playerid] = C_WP_ABRINDO;
	    for(new e; e<sizeof T_Celular_WP_Carregando; e++) TextDrawShowForPlayer(playerid, T_Celular_WP_Carregando[e]);
	    timer_celular[playerid] = SetTimerEx("TimerCelular", 1250, false, "dd", playerid, C_WP);
		return 1;
	}
	if(con == C_WP)
	{
	    abrir_whatsapp(playerid);
		return 1;
	}

	if(con == C_WP_APK)
	{
	    celular_aberto[playerid] = C_WP_APK;
		for(new a; a<sizeof T_Celular_WP_APK_Converssa; a++) TextDrawShowForPlayer(playerid, T_Celular_WP_APK_Converssa[a]);
		if(grupo_vip_abrir[playerid] == 1)
		{
			grupo_vip[playerid] = 1;
			grupo_vip_abrir[playerid] = 0;
		}
		mostrar_converssa(playerid);
		return 1;
	}

	// radio online //
	if(con == C_RADIO_ABRINDO)
	{
	    celular_aberto[playerid] = C_RADIO_ABRINDO;
	    for(new e; e<sizeof T_Celular_Radio_Carregando; e++) TextDrawShowForPlayer(playerid, T_Celular_Radio_Carregando[e]);
	    timer_celular[playerid] = SetTimerEx("TimerCelular", 1250, false, "dd", playerid, C_RADIO);
		return 1;
	}
	if(con == C_RADIO)
	{
        celular_aberto[playerid] = C_RADIO;
		PlayerTextDrawSetString(playerid, T_Celular_Radio_APK_p[playerid][0], NomeEstacao(Ouvindo_Radio[playerid]));
		PlayerTextDrawShow(playerid, T_Celular_Radio_APK_p[playerid][0]);
		if(Status_Radio[playerid] == 0)
		{
			PlayerTextDrawSetString(playerid, T_Celular_Radio_APK_p[playerid][1], "PLAY");
			TextDrawHideForPlayer(playerid, T_Celular_Radio_APK[5]);
			TextDrawShowForPlayer(playerid, T_Celular_Radio_APK[4]);
		}
		else
		{
			PlayerTextDrawSetString(playerid, T_Celular_Radio_APK_p[playerid][1], "STOP");
			TextDrawHideForPlayer(playerid, T_Celular_Radio_APK[4]);
			TextDrawShowForPlayer(playerid, T_Celular_Radio_APK[5]);
		}
        PlayerTextDrawShow(playerid, T_Celular_Radio_APK_p[playerid][1]);
        for(new e; e<4; e++) TextDrawShowForPlayer(playerid, T_Celular_Radio_APK[e]);
        TextDrawShowForPlayer(playerid, T_Celular_Radio_APK[6]);
	    return 1;
	}


	//// FECHAR CELULAR ////
    for(new aa; aa<sizeof T_Celular; aa++) TextDrawHideForPlayer(playerid, T_Celular[aa]);
	for(new zz; zz<2; zz++) PlayerTextDrawHide(playerid, T_Celular_p[playerid][zz]);
    celular_aberto[playerid] = -1;
    CancelSelectTextDraw(playerid);
	return 1;
}


stock fechar_celular(playerid, con=0)
{
    if(con == 1)
	{
		celular(playerid, -2);
		PlayerPlaySound(playerid,1002,0.0,0.0,0.0);
		if(IsPlayerAttachedObjectSlotUsed(playerid, 9))RemovePlayerAttachedObject(playerid, 9);
		if(!IsPlayerInAnyVehicle(playerid)){
            ClearAnimations(playerid);
        }
        else{
            ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.0, 0, 0, 0, 0, 0);
        }
		mostrar_hud(playerid);
        mostrar_logomarca(playerid);
	}
	else
	{
		if(celular_aberto[playerid] != -1)
		{
		    if(celular_aberto[playerid] == C_ERRO) celular(playerid, GetPVarInt(playerid, "aviso")), PlayerPlaySound(playerid,1139,0.0,0.0,0.0);
		    else if(celular_aberto[playerid] == C_INFO) celular(playerid, GetPVarInt(playerid, "aviso")), PlayerPlaySound(playerid,1137,0.0,0.0,0.0);
           	else if(celular_aberto[playerid] == C_OLX_ABRINDO) celular(playerid, C_INICIO);
		    else if(celular_aberto[playerid] == C_OLX) celular(playerid, C_INICIO);
		    else if(celular_aberto[playerid] == C_UBER_ABRINDO) celular(playerid, C_INICIO);
		    else if(celular_aberto[playerid] == C_GPS_ABRINDO) celular(playerid, C_INICIO);
		    else if(celular_aberto[playerid] == C_ITAU_ABRINDO) celular(playerid, C_INICIO);
		    else if(celular_aberto[playerid] == C_RADIO_ABRINDO) celular(playerid, C_INICIO);
		    else if(celular_aberto[playerid] == C_UBER) celular(playerid, C_INICIO);
		    else if(celular_aberto[playerid] == C_UBER_CLIENTE) celular(playerid, C_UBER);
		    else if(celular_aberto[playerid] == C_UBER_MOTORISTA) celular(playerid, C_UBER);
		    else if(celular_aberto[playerid] == C_UBER_VIAGEM) celular(playerid, C_UBER);
		    else if(celular_aberto[playerid] == C_GPS) celular(playerid, C_INICIO);
		    else if(celular_aberto[playerid] == C_ITAU) celular(playerid, C_INICIO);
		    else if(celular_aberto[playerid] == C_RADIO) celular(playerid, C_INICIO);
		    else if(celular_aberto[playerid] == C_BLAZE) celular(playerid, C_INICIO);
		    else if(celular_aberto[playerid] == C_BLU_APK) celular(playerid, C_INICIO);
		    else if(celular_aberto[playerid] == C_BLU_ABRINDO) celular(playerid, C_INICIO);
		    else if(celular_aberto[playerid] == C_DETRAN_ABRINDO) celular(playerid, C_INICIO);
		    else if(celular_aberto[playerid] == C_DETRAN) celular(playerid, C_INICIO);
		    else if(celular_aberto[playerid] == C_CAIXA_ABRINDO) celular(playerid, C_INICIO);
		    else if(celular_aberto[playerid] == C_CAIXA) celular(playerid, C_INICIO);
		    else if(celular_aberto[playerid] == C_BLAZE_ABRINDO) celular(playerid, C_INICIO);
		    else if(celular_aberto[playerid] == C_WP_ABRINDO) celular(playerid, C_INICIO);
		    else if(celular_aberto[playerid] == C_LISTA) dialog_celular(playerid, ID_DC[playerid], 0, 0);
		    else if(celular_aberto[playerid] == C_NUMERO) dialog_celular(playerid, ID_DC[playerid], 0, 0);
		    else if(celular_aberto[playerid] == C_WP_APK)
			{
				if(grupo_vip[playerid] == 0) converssas_whatsapp(playerid);
				else abrir_whatsapp(playerid);
			}
		    else
			{
				celular(playerid, -2);
			 	PlayerPlaySound(playerid,1002,0.0,0.0,0.0);
			 	if(IsPlayerAttachedObjectSlotUsed(playerid, 9))RemovePlayerAttachedObject(playerid, 9);
				if(!IsPlayerInAnyVehicle(playerid)) ClearAnimations(playerid, 1);
				mostrar_hud(playerid);
                mostrar_logomarca(playerid);
			}
	    }
	}
}

stock grupo_vip_wp(playerid)
{
    new c = id[playerid];
	if(c != -1)
	{
		new file[80];
		format(file, 80, "WP_Menssagens/GrupoVip.txt");
		if(DOF2_FileExists(file))
		{
		    new str2[80];
		    new str[600];
		    for(new ii; ii<MAX_LINHAS; ii++)
		    {
		        format(str2, 80, "cv_Linha_%d", ii);
		        format(str, 500, "%s", DOF2_GetString(file, str2));
			 	split_linha(str, strlen(str));
		        player_converssa[playerid][ii][cv_Existe] = strval(split[0]);
		        player_converssa[playerid][ii][cv_Conta] = strval(split[1]);
		        format(player_converssa[playerid][ii][cv_Hora], 20, split[2]);
		        format(player_converssa[playerid][ii][cv_Menssagem], 200, split[3]);
			}
        }
		else
		{
		    for(new ii=1; ii<MAX_LINHAS; ii++)
		    {
		        player_converssa[playerid][ii][cv_Existe] = 0;
		        player_converssa[playerid][ii][cv_Conta] = -1;
		        format(player_converssa[playerid][ii][cv_Hora], 20, "_");
		        format(player_converssa[playerid][ii][cv_Menssagem], 200, "_");
			}

            player_converssa[playerid][0][cv_Existe] = 1;
	        player_converssa[playerid][0][cv_Conta] = -1;
	        format(player_converssa[playerid][0][cv_Hora], 20, "%d:%d", HORA, MINUTO);
	        format(player_converssa[playerid][0][cv_Menssagem], 200, "~g~~h~Inicie uma nova converssa neste grupo, digite uma menssagem abaixo:");
		}

		grupo_vip_abrir[playerid] = 1;
		celular(playerid, C_WP_APK);
		return 1;
	}
	return 0;
}

stock cancelar_gps(playerid)
{
	GPS[playerid][gps_Status] = 0;
	GPS[playerid][gps_Cidade] = -1;
	GPS[playerid][gps_Destino] = -1;
	GPS[playerid][gps_Distancia] = 0.0;
	GPS[playerid][gps_X] = 0.0;
	GPS[playerid][gps_Y] = 0.0;
	GPS[playerid][gps_Z] = 0.0;
	GPS[playerid][gps_DX] = 0.0;
	GPS[playerid][gps_DY] = 0.0;
	GPS[playerid][gps_DZ] = 0.0;
}


stock cancelar_uber(playerid, con=0)
{
	if(con == 0)
	{
		new player = Uber[playerid][uber_Motorista];
		if(Uber[playerid][uber_Status] == 2)
		{
		    if(player != -1)
		    {
		        if(id[player] != -1)
		        {
		        	ms(player, 3, "O Cliente cancelou a corrida, Voce recebeu metade do valor !");
		        	DarGrana(player, Uber[playerid][uber_Valor]/2);
		        	if(celular_aberto[player] == C_UBER_MOTORISTA) celular(player, C_INICIO);
		        	Localizando_ID[player] = -1;
				    Localizando[player] = -1;
				    DisablePlayerCheckpoint(player);
				    if(IsValidDynamic3DTextLabel(Localizando_3D[player])) DestroyDynamic3DTextLabel(Localizando_3D[player]);
				    Localizando_3D[player] = DynamicText3D:-1;
		        }
		    }
		    DarGrana(playerid, -(Uber[playerid][uber_Valor]/2));
		    ms(playerid, 3, "A corrida foi cancelada, voce pagou metade do valor !");
		}

		if(Uber[playerid][uber_Status] == 3)
		{
		    if(player != -1)
		    {
		        if(id[player] != -1)
		        {
		        	ms(player, 3, "O Cliente cancelou a corrida, Voce recebeu metade do valor !");
		        	DarGrana(player, Uber[playerid][uber_Valor]/2);
		        	if(celular_aberto[player] == C_UBER_MOTORISTA) celular(player, C_INICIO);
		        	Localizando_ID[player] = -1;
				    Localizando[player] = -1;
				    DisablePlayerCheckpoint(player);
				    if(IsValidDynamic3DTextLabel(Localizando_3D[player])) DestroyDynamic3DTextLabel(Localizando_3D[player]);
				    Localizando_3D[player] = DynamicText3D:-1;
		        }
		    }
		    DarGrana(playerid, -(Uber[playerid][uber_Valor]/2));
		    ms(playerid, 3, "A corrida foi cancelada, voce pagou metade do valor !");
		}
	}

    Uber[playerid][uber_Tempo] = 0;
	Uber[playerid][uber_Status] = 0;
	Uber[playerid][uber_Cidade] = -1;
	Uber[playerid][uber_Destino] = -1;
	Uber[playerid][uber_Motorista] = -1;
	Uber[playerid][uber_Distancia] = 0.0;
	Uber[playerid][uber_Valor]  = 0;
	Uber[playerid][uber_X] = 0.0;
	Uber[playerid][uber_Y] = 0.0;
	Uber[playerid][uber_Z] = 0.0;
	Uber[playerid][uber_DX] = 0.0;
	Uber[playerid][uber_DY] = 0.0;
	Uber[playerid][uber_DZ] = 0.0;
	Uber[playerid][uber_Veiculo] = -1;
	Localizando_ID[playerid] = -1;
    Localizando[playerid] = -1;
    DisablePlayerCheckpoint(playerid);
    if(IsValidDynamic3DTextLabel(Localizando_3D[playerid])) DestroyDynamic3DTextLabel(Localizando_3D[playerid]);
    Localizando_3D[playerid] = DynamicText3D:-1;
}




BCG:: SpeedTimer()
{
    new vehicleid, maxSpeed, keys, keys2, keys3;
    new speeed;
    new v;
    new c;
    new Float:spp[3];
    foreach(new i:Player)
	{
	    if(IsPlayerConnected(i))
	    {
		    if(id[i] != -1)
		    {
			    if(IsPlayerInAnyVehicle(i))
				{
				if(GetPlayerVehicleSeat(i) == 0)
				{
					vehicleid = GetPlayerVehicleID(i);
					speeed = GetVehicleSpeed(vehicleid);
					if(flood_radar[i] == 0 && !PlayerCop(i))
					{
					    c = id[i];
						v = Info_Veiculo[vehicleid];
					    verificar_radar_player(i, c, speeed, vehicleid, v);
					}
					if(VMUpgrades[vehicleid] != 0)
					{
						maxSpeed = VMUpgrades[vehicleid];
						GetPlayerKeys(i, keys, keys2, keys3);
						if(speeed > maxSpeed) setVehicleSpeed(vehicleid, (maxSpeed-5));
						    if(keys == 8 && keys3 == 0)
							{
							    if(maxSpeed > 300)
								{
								    GetVehicleVelocity(vehicleid, spp[0], spp[1], spp[2]);
								    SetVehicleVelocity(vehicleid, spp[0]*1.03, spp[1]*1.03, spp[2]);
							    }
							}
						}
					}
				}
			}
		}
    }
}

stock verificar_radar_player(playerid, c, speed, veh, v)
{
    new strmot[100];
    if(ModoAdmin[playerid] == 0)
    {
	    foreach(new r:Iter_Radares)
	    {
	    	if(Radar[r][radar_Existe] == 1)
	        {
	            if(Radar[r][radar_Ativado] == 1)
	            {
	                if(IsPlayerInRangeOfPoint(playerid, 25, Radar[r][radar_X], Radar[r][radar_Y], Radar[r][radar_Z]))
					{
						if(speed >= Radar[r][radar_Velocidade] && !PlayerCop(playerid))
						{
						    flood_radar[playerid] = 15;
						    if(v != -1) format(strmot, 100, "Atingiu %d KM/H conduzindo um '%s' Placa: %s", speed, NomeVeiculo(GetVehicleModel(GetPlayerVehicleID(playerid))), PlacaVeiculo[v]);
						    else format(strmot, 100, "Atingiu %d KM/H conduzindo um '%s' sem placa", speed, NomeVeiculo(GetVehicleModel(GetPlayerVehicleID(playerid))));
							new multou = Multar(c, Radar[r][radar_Valor], -123, r, strmot, veh);
							if(multou == 0) ms(playerid, 0, "[MULTA] Voce atingiu o limite de Multas, procure uma loterica com urgencia para paga-las !");
							if(multou == 3) ms(playerid, 2, "Para pagar suas multas pessoais voce deve ir ate uma loterica mais proxima !"), MS(playerid, 2, "Voce foi Multado, procure uma Loterica !");
							if(multou == 2) ms(playerid, 0, "[MULTA] Este veiculo atingiu o limite de Multas, va ate o DETRAN com urgencia para paga-las !");
							if(multou == 1) ms(playerid, 2, "Para pagar suas multas de um veiculo procure o DETRAN no GPS do seu Celular !"), MS(playerid, 2, "O Veiculo foi Multado, procure o Detra !");
							new Float:po[3];
							GetPlayerPos(playerid, po[0], po[1], po[2]);
							Play_Som_Veiculo(1132, veh);
							break;
						}
					}
	            }
	        }
	    }
	}
}


stock setVehicleSpeed( vehicleid, speed_mph )
{
	if(speed_mph < 1) speed_mph = 1;
	new Float: v[3], cur_speed_mph;
	GetVehicleVelocity( vehicleid, v[0], v[1], v[2] );
	cur_speed_mph = floatround( 200.0 * floatsqroot( v[0]*v[0] + v[1]*v[1] + v[2]*v[2] ), floatround_floor );
	if ( cur_speed_mph <= 0 )
	{
		new Float: zAngle;
		GetVehicleZAngle( vehicleid, zAngle );
		new Float: newVelX = floatcos( (zAngle -= 270.0), degrees ) * speed_mph / 200.0;
		SetVehicleVelocity( vehicleid, newVelX, floattan(zAngle,degrees) * newVelX, 0.0 );
		return;
	}
	new Float: vMultiplier = float(speed_mph) / float(cur_speed_mph);
	SetVehicleVelocity( vehicleid, v[0] * vMultiplier, v[1] * vMultiplier, v[2] * vMultiplier );
}

stock GetVehicleSpeed(vehicleid)
{
    new Float:Pos[3];
    GetVehicleVelocity(vehicleid, Pos[0], Pos[1], Pos[2]);
    return floatround(floatsqroot(Pos[0] * Pos[0] + Pos[1] * Pos[1] + Pos[2] * Pos[2]) * 180.00);
}

stock mostrar_velocimetro(playerid)
{
	new c = id[playerid];
	if(c != -1)
	{
		if(Conta[playerid][c_Velo] == 0)
		{
			if(GetPVarInt(playerid, "tds_velo_exist") == 0) { Velo_CreateTDs(playerid); SetPVarInt(playerid, "tds_velo_exist", 1); }
			mostrando_velocimetro[playerid] = 1;
			LastSpeedRender[playerid] = 0.0;
			LastFuelRender[playerid] = 0.0;
			for(new i; i<29; i++) PlayerTextDrawShow(playerid, TextdrawVelocimetro[playerid][i]);
			for(new i; i<MAX_BOLINHAS; i++)
			{
			    if(TextdrawVelocimetroPont[playerid][i] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawShow(playerid, TextdrawVelocimetroPont[playerid][i]);
			    if(TextdrawGasolinhaPont[playerid][i] != PlayerText:INVALID_TEXT_DRAW) PlayerTextDrawShow(playerid, TextdrawGasolinhaPont[playerid][i]);
			}
		}
	}
}

stock esconder_velocimetro(playerid)
{
	mostrando_velocimetro[playerid] = 0;
	Velo_DestroyTDs(playerid);
	SetPVarInt(playerid, "tds_velo_exist", 0);
}

stock tanque_veiculo(playerid, veh)
{
    new Float:p[4];
    GetVehiclePos(veh, p[0], p[1], p[2]);
    GetVehicleZAngle(veh, p[3]);
    new Float:dist;
	GetDistance(dist, p[0], p[1], p[2], p[0]+(tanque[GetVehicleModel(veh)-400][tanX]), p[1]+(tanque[GetVehicleModel(veh)-400][tanY]), p[2]);
	new Float:ang = GetAngleToPoint(p[0],p[1], p[0]+(tanque[GetVehicleModel(veh)-400][tanX]), p[1]+(tanque[GetVehicleModel(veh)-400][tanY]));
	ang += p[3];
    if(ang > 360.0) ang -= 360.0;
    PegarFrente(p[0],p[1], ang, dist);
	if(IsPlayerInRangeOfPoint(playerid, 1, p[0],p[1], p[2]))
	{
		SetPlayerFacingAngle(playerid, GetPlayerAngleToPoint(playerid, p[0],p[1]));
		return 1;
	}
	else return 0;
}


stock GetAngleToPoint(Float:fPointX, Float:fPointY, Float:fDestX, Float:fDestY)
{
	new Float:an;
	an = -(90.0 - (atan2((fDestY - fPointY),(fDestX - fPointX))));
	new tent1;
	while(an < 0.0 && tent1 < 10)
	{
		an += 360.0;
		tent1 ++;
	}
	new tent2;
	while(an > 360.0 && tent2 < 10)
	{
		an -= 360.0;
        tent2 ++;
	}
	return floatround(an);
}

stock SetPlayerAngleToPoint(playerid, Float:xXx, Float:yYy)
{
	if(Online(playerid))
	{
		new Float:pf[3];
		GetPlayerPos(playerid, pf[0], pf[1], pf[2] );
		SetPlayerFacingAngle(playerid, GetAngleToPoint(pf[0], pf[1], xXx,yYy));
	}
}


BCG:: GetPlayerAngleToPoint(playerid, Float:X, Float:Y)
{
	new Float:paaX,Float:paaY,Float:paaZ,Float:ang;
	GetPlayerPos(playerid, paaX, paaY, paaZ);
	if( Y > paaY ) ang = (-acos((X - paaX) / floatsqroot((X - paaX)*(X - paaX) + (Y - paaY)*(Y - paaY))) - 90.0);
	else if( Y < paaY && X < paaX ) ang = (acos((X - paaX) / floatsqroot((X - paaX)*(X - paaX) + (Y - paaY)*(Y - paaY))) - 450.0);
	else if( Y < paaY ) ang = (acos((X - paaX) / floatsqroot((X - paaX)*(X - paaX) + (Y - paaY)*(Y - paaY))) - 90.0);
	if(X > paaX) ang = (floatabs(floatabs(ang) + 180.0));
	else ang = (floatabs(ang) - 180.0);
	return floatround(ang);
}

