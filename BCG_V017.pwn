		    			DOF2_SetInt(file, "c_Colete", Conta[player][c_Colete]);
		                DOF2_SaveFile();
	                }
	            }
	            else
	            {
		            if(tip == 0) DOF2_SetInt(file, salve, strval(valor));
		            if(tip == 1) DOF2_SetFloat(file, salve, floatstr(valor));
		            if(tip == 2) DOF2_SetString(file, salve, valor);
		            DOF2_SaveFile();
	            }
	        }
	    }
	    else
	    {
	        new player = ContaOnline(i);
	        if(Online(player))
	        {
