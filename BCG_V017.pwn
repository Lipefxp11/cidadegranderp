	    format(Lista_DC[playerid][1][cel_Nome], 100, "~w~Documento CPF");
	    format(Lista_DC[playerid][2][cel_Nome], 100, "~w~Habilitacao");
	    format(Lista_DC[playerid][3][cel_Nome], 100, "~w~Porte de Armas");
	    format(Lista_DC[playerid][4][cel_Nome], 100, "~w~Documentos Veiculos");
	    format(Lista_DC[playerid][5][cel_Nome], 100, "~w~Documentos Casas");
	    MAX_DC[playerid] = 6;
	    ID_DC[playerid] = DOCUMENTOS;
		Pagina_DC[playerid] = 0;
		celular(playerid, C_LISTA);
