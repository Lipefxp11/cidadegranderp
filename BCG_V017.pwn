    return 0;
}

stock motor_(i, opc) SetVehicleParamsEx_(i, opc, farol[i], 0, 0, capo[i], malas[i], 0);
stock farol_(i, opc) SetVehicleParamsEx_(i, motor[i], opc, 0, 0, capo[i], malas[i], 0);
stock capo_(i, opc) SetVehicleParamsEx_(i, motor[i], farol[i], 0, 0, opc, malas[i], 0);
stock malas_(i, opc) SetVehicleParamsEx_(i, motor[i], farol[i], 0, 0, capo[i], opc, 0);
stock SetVehicleParamsEx_(vehicleid, v1, v2, v3, v4, v5, v6, v7)
{
	if(GetVehicleModel(vehicleid) != 0)
	{
    	SetVehicleParamsEx(vehicleid, (v1==1)?true:false, (v2==1)?true:false, (v3==1)?true:false, (v4==1)?true:false, (v5==1)?true:false, (v6==1)?true:false, (v7==1)?true:false);
	    motor[vehicleid] = v1;
		farol[vehicleid] = v2;
		malas[vehicleid] = v6;
		capo[vehicleid]  = v5;
		new i = Info_Veiculo[vehicleid];
		if(i != -1)
		{
		    if(XenonVeiculo[i][0] == 1)
		    {
		        if(farol[vehicleid] == 1)
		        {
				new idd = XenonVeiculo[i][1];
				new mod = modelo_xenon[idd];
				if(IsValidDynamicObject(xenon_veiculo[vehicleid])) DestroyDynamicObject_(xenon_veiculo[vehicleid]);
			    	xenon_veiculo[vehicleid] = CreateDynamicObject(mod, 0, 0, 0, 0, 0, 0);
			    	AttachDynamicObjectToVehicle(xenon_veiculo[vehicleid], vehicleid, 0.0, 2.3, 0.0, 0, 0, 0);
				}
				else if(IsValidDynamicObject(xenon_veiculo[vehicleid])) DestroyDynamicObject_(xenon_veiculo[vehicleid]);
			}
			else if(IsValidDynamicObject(xenon_veiculo[vehicleid])) DestroyDynamicObject_(xenon_veiculo[vehicleid]);
		}
    }
}

public OnVehicleSpawn(vehicleid)
{
	// paramentros do veiculo //
    SetVehicleParamsEx_(vehicleid, 0, 0, 0, 0, 0, 0, 0);

	// algumas variaveis //
	Veiculo_RC[vehicleid] = -1;
	veiculo_desoculpado[vehicleid] = 1;
	veiculo_desoculpado_tempo[vehicleid] = 0;
	carro_de_teste[vehicleid] = -1;
	escada_veiculo[vehicleid] = -1;
	flood_lataria[vehicleid] = 0;
	if(ir_garagem[vehicleid] == 1)
	{
	    ir_garagem[vehicleid] = 0;
		SetTimerEx("carregar_tuning", 1500, false, "d", vehicleid);
	}
	else SetTimerEx("SpawnVeiculo", 1500, false, "d", vehicleid);
	return 1;
}

stock mostrar_menu(playerid, idm)
{
	new sss[300];
	menu_id[playerid] = idm;
	if(mostrando_menu[playerid] == 0)
	{
	    mostrando_menu[playerid] = 1;
	    escolhendo_menu[playerid] = 0;
	    pagina_menu[playerid] = 0;
	    for(new i; i<sizeof T_Menu; i++) TextDrawShowForPlayer(playerid, T_Menu[i]);
	    SelectTextDraw(playerid, 0x00ffffff);
	    MS(playerid, 0, "_", 1);
	}

	// pagina //
	new pags = paginas(7, max_menu[playerid]);
	format(sss, 300, "%d / %d", pagina_menu[playerid]+1, pags);
	PlayerTextDrawSetString(playerid, T_Menu_p[playerid][11], sss);
	PlayerTextDrawShow(playerid, T_Menu_p[playerid][11]);

	// nome menu //
	PlayerTextDrawSetString(playerid, T_Menu_p[playerid][0], nome_menu[playerid]);
	PlayerTextDrawShow(playerid, T_Menu_p[playerid][0]);

	// botao menu //
	format(sss, 300, "~n~%s~n~_", botao_menu[playerid]);
	PlayerTextDrawSetString(playerid, T_Menu_p[playerid][1], sss);
	PlayerTextDrawShow(playerid, T_Menu_p[playerid][1]);

    if(escolhendo_menu[playerid] >= max_menu[playerid]) escolhendo_menu[playerid] = max_menu[playerid]-1;
	for(new m; m<7; m++)
	{
	    new i = m+(pagina_menu[playerid]*7);
	    if(i < max_menu[playerid])
	    {
	        if(i == escolhendo_menu[playerid])
	        {
                PlayerTextDrawSetString(playerid, T_Menu_p[playerid][3], Menu[playerid][i][menu_Info]);
				PlayerTextDrawShow(playerid, T_Menu_p[playerid][3]);
				PlayerTextDrawSetPreviewModel(playerid, T_Menu_p[playerid][2], Menu[playerid][i][menu_Modelo]);
				PlayerTextDrawBoxColor(playerid, T_Menu_p[playerid][m+4], 0xFFD70050);
	            if(Menu[playerid][i][menu_Tipo] == 666666) PlayerTextDrawSetPreviewVehCol(playerid, T_Menu_p[playerid][2], Veiculo[Menu[playerid][i][menu_ID]][v_Cor1], Veiculo[Menu[playerid][i][menu_ID]][v_Cor2]);
	            else if(Menu[playerid][i][menu_Tipo] == 777777) PlayerTextDrawSetPreviewVehCol(playerid, T_Menu_p[playerid][2], Menu[playerid][i][menu_Valor], Menu[playerid][i][menu_Valor]);
	            else
				{
				    if(menu_id[playerid] == MENU_TUNING14 || menu_id[playerid] == MENU_TUNING15) PlayerTextDrawColor(playerid, T_Menu_p[playerid][2], Cores[i][coresCor1]);
	            	else PlayerTextDrawColor(playerid, T_Menu_p[playerid][2], -73);
				}
				PlayerTextDrawShow(playerid, T_Menu_p[playerid][2]);
	        }
	        else PlayerTextDrawBoxColor(playerid, T_Menu_p[playerid][m+4], -245);
	        format(sss, 300, "%s~n~_", Menu[playerid][i][menu_Nome]);
	        PlayerTextDrawSetString(playerid, T_Menu_p[playerid][m+4], sss);
	        PlayerTextDrawShow(playerid, T_Menu_p[playerid][m+4]);
	    }
	    else PlayerTextDrawHide(playerid, T_Menu_p[playerid][m+4]);
	}
}

stock fechar_menu(playerid, con=0)
{
	if(con == 0) CancelSelectTextDraw(playerid);
    mostrando_menu[playerid] = 0;
	for(new i; i<sizeof T_Menu; i++) TextDrawHideForPlayer(playerid, T_Menu[i]);
	for(new ii; ii<12; ii++) PlayerTextDrawHide(playerid, T_Menu_p[playerid][ii]);
	MS(playerid, 0, "_", 1);
	return 1;
}

BCG:: RespostaMenu(playerid, ID_menu, resposta, listitem)
{
    if(ID_menu == MENU_BAU_ITEM)
    {
        if(resposta == 1)
        {
            new conta = id[playerid];
            if(conta != -1)
            {
                if(max_menu[playerid] == 0) return 1;

                // bau da casa //
                new casa_bau = mostrando_bau[playerid];
                if(casa_bau != -1)
                {
                    new s = Menu[playerid][listitem][menu_Valor];
                    if(s != -1 && Bau[casa_bau][s][inv_ID] > 0)
                    {
                        for(new ii; ii<MAX_SLOTS; ii++)
                        {
                            if(Inventario[playerid][ii][inv_ID] == 0)
                            {
                                Inventario[playerid][ii][inv_ID] = Bau[casa_bau][s][inv_ID];
                                Inventario[playerid][ii][inv_Unidades] = Bau[casa_bau][s][inv_Unidades];
                                Inventario[playerid][ii][inv_Tipo] = Bau[casa_bau][s][inv_Tipo];
                                Inventario[playerid][ii][inv_Ativo] = Bau[casa_bau][s][inv_Ativo];
                                Inventario[playerid][ii][inv_Tempo] = Bau[casa_bau][s][inv_Tempo];
                                Bau[casa_bau][s][inv_ID] = 0;
                                Bau[casa_bau][s][inv_Unidades] = 0;
                                Bau[casa_bau][s][inv_Tipo] = 0;
                                Bau[casa_bau][s][inv_Ativo] = 0;
                                Bau[casa_bau][s][inv_Tempo] = 0;
                                GameTextForPlayer(playerid, "~g~~h~ITEM RECOLHIDO", 1000, 3);
                                salvar_inventario(conta, ii);
                                abrir_bau_casa(playerid, casa_bau);
                                return 1;
                            }
                        }
                    }
                }

                new bid = mostrando_bau2[playerid];
                if(bid != -1)
                {
                    new s = Menu[playerid][listitem][menu_Valor];
                    if(s != -1 && BauI_Itens[bid][s][inv_ID] > 0)
                    {
                        for(new ii; ii<MAX_SLOTS; ii++)
                        {
                            if(Inventario[playerid][ii][inv_ID] == 0)
                            {
                                Inventario[playerid][ii][inv_ID] = BauI_Itens[bid][s][inv_ID];
                                Inventario[playerid][ii][inv_Unidades] = BauI_Itens[bid][s][inv_Unidades];
                                Inventario[playerid][ii][inv_Tipo] = BauI_Itens[bid][s][inv_Tipo];
                                Inventario[playerid][ii][inv_Ativo] = BauI_Itens[bid][s][inv_Ativo];
                                Inventario[playerid][ii][inv_Tempo] = BauI_Itens[bid][s][inv_Tempo];
                                BauI_Itens[bid][s][inv_ID] = 0;
                                BauI_Itens[bid][s][inv_Unidades] = 0;
                                BauI_Itens[bid][s][inv_Tipo] = 0;
                                BauI_Itens[bid][s][inv_Ativo] = 0;
                                BauI_Itens[bid][s][inv_Tempo] = 0;
                                GameTextForPlayer(playerid, "~g~~h~ITEM RECOLHIDO", 1000, 3);
                                salvar_inventario(conta, ii);
                                salvar_bau_item(bid);
                                abrir_bau_item(playerid, bid);
                                return 1;
                            }
                        }
                    }
                }
            }
        }
        else
        {
            mostrando_bau2[playerid] = -1;
            fechar_menu(playerid);
        }
        return 1;
    }

    if(ID_menu == MENU_BAU_GUARDAR)
    {
        if(resposta == 1)
        {
            new conta = id[playerid];
            if(conta != -1)
            {
                if(max_menu[playerid] == 0) return 1;
                new bid = mostrando_bau2[playerid];
                if(bid >= 0 && bid < MAX_BAUS && BauI[bid][bau_Existe] == 1)
                {
                    new inv_slot = Menu[playerid][listitem][menu_Valor];
                    if(inv_slot >= 0 && inv_slot < MAX_SLOTS && Inventario[playerid][inv_slot][inv_ID] > 0)
                    {
                        for(new s; s<BauI[bid][bau_Slots]; s++)
                        {
                            if(BauI_Itens[bid][s][inv_ID] == 0)
                            {
                                BauI_Itens[bid][s][inv_ID] = Inventario[playerid][inv_slot][inv_ID];
                                BauI_Itens[bid][s][inv_Unidades] = Inventario[playerid][inv_slot][inv_Unidades];
                                BauI_Itens[bid][s][inv_Tipo] = Inventario[playerid][inv_slot][inv_Tipo];
                                BauI_Itens[bid][s][inv_Ativo] = Inventario[playerid][inv_slot][inv_Ativo];
                                BauI_Itens[bid][s][inv_Tempo] = Inventario[playerid][inv_slot][inv_Tempo];
                                Inventario[playerid][inv_slot][inv_ID] = 0;
                                Inventario[playerid][inv_slot][inv_Unidades] = 0;
                                Inventario[playerid][inv_slot][inv_Tipo] = 0;
                                Inventario[playerid][inv_slot][inv_Ativo] = 0;
                                Inventario[playerid][inv_slot][inv_Tempo] = 0;
                                GameTextForPlayer(playerid, "~g~~h~ITEM GUARDADO", 1000, 3);
                                salvar_inventario(conta, inv_slot);
                                salvar_bau_item(bid);
                                abrir_bau_item(playerid, bid);
                                return 1;
                            }
                        }
                        ms(playerid, 0, "Bau cheio! Sem slots disponiveis.");
                    }
                }
            }
        }
        else abrir_bau_item(playerid, mostrando_bau2[playerid]);
        return 1;
    }

	if(listitem == -1) return 1;
	if(ID_menu == MENU_LOJA_FENIX)
	{
	    if(resposta == 1)
	    {
	        if(listitem < 0) return 1;
	        new lista = Menu[playerid][listitem][menu_ID];
	        if(lista != -1)
	        {
		        if(items_lista(lista) == 0)
		        {
		            ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}_", "{a1a1a1}Esta lista da Loja ainda esta vazia !\n", "Ok", "Fechar");
		            return 1;
		        }
		        abrir_loja(playerid, lista);
	        }
	    }
	    else fechar_menu(playerid);
	    return 1;
	}

	// items da lista da loja //
	if(ID_menu == MENU_LOJA_FENIX_ITEM)
	{
	    if(resposta == 1)
	    {
            if(listitem < 0) return 1;
            new lista = Menu[playerid][listitem][menu_ID];
            if(lista != -1)
            {
            	realizar_compra2(playerid, lista);
            }
	    }
	    else abrir_loja(playerid);
		return 1;
	}

    // tunings cor 1 //
	if(ID_menu == MENU_TUNING14)
	{
	    if(resposta == 1)
	    {
	        new veh = GetPVarInt(playerid, "id_veiculo");
	        if(GetVehicleModel(veh) != 0)
			{
		    	new idv = Info_Veiculo[veh];
			    if(idv != -1)
				{
					ChangeVehicleColorEx(veh, Cores[listitem][coresID], Veiculo[idv][v_Cor2]);
					SalvarVeiculo(veh);
				}
				else ChangeVehicleColor(veh, Cores[listitem][coresID], Cores[listitem][coresID]);
		    }
        	return 1;
	    }
	    Mostrar_Tuning(playerid, GetPVarInt(playerid, "id_veiculo"));
	    return 1;
	}

	// tunings cor 2 //
	if(ID_menu == MENU_TUNING15)
	{
	    if(resposta == 1)
	    {
	        new veh = GetPVarInt(playerid, "id_veiculo");
	        if(GetVehicleModel(veh) != 0)
			{
		    	new idv = Info_Veiculo[veh];
			    if(idv != -1)
				{
					ChangeVehicleColorEx(veh, Veiculo[idv][v_Cor1], Cores[listitem][coresID]);
					SalvarVeiculo(veh);
				}
				else ChangeVehicleColor(veh, Cores[listitem][coresID], Cores[listitem][coresID]);
		    }
        	return 1;
	    }
	    Mostrar_Tuning(playerid, GetPVarInt(playerid, "id_veiculo"));
	    return 1;
	}

    // tunings grafits //
	if(ID_menu == MENU_TUNING16)
	{
	    if(resposta == 1)
	    {
	        new veh = GetPVarInt(playerid, "id_veiculo");
	        if(GetVehicleModel(veh) != 0)
			{
			    ChangeVehiclePaintjobEx(veh, listitem);
			    SalvarVeiculo(veh);
			}
			return 1;
	    }
	    Mostrar_Tuning(playerid, GetPVarInt(playerid, "id_veiculo"));
	    return 1;
	}


	// tunings componentes //
	if(ID_menu == MENU_TUNING17)
	{
	    if(resposta == 1)
	    {
	        new veh = GetPVarInt(playerid, "id_veiculo");
	        if(GetVehicleModel(veh) != 0)
			{
		        new componentid = Menu[playerid][listitem][menu_ID];
		        if(componentid != -1)
		        {
				AddVehicleComponentEx_x(veh, componentid);
		        	SalvarVeiculo(veh);
	        	}
        	}
        	return 1;
	    }
	    Mostrar_Tuning(playerid, GetPVarInt(playerid, "id_veiculo"));
	    return 1;
	}

    // neons tunings //
	if(ID_menu == MENU_TUNING18)
	{
	    if(resposta == 1)
	    {
	        new veh = GetPVarInt(playerid, "id_veiculo");
	        if(GetVehicleModel(veh) != 0)
	        {
		        if(listitem == sizeof nome_xenon)
		        {
		            add_neon(veh, -1);
		            SalvarVeiculo(veh);
		            return 1;
		        }
		        add_neon(veh, listitem);
	        	SalvarVeiculo(veh);
