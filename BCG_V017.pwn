    PlayerTextDrawBackgroundColor(playerid, TextdrawVelocimetro[playerid][26], 0x00000000);
    PlayerTextDrawBoxColor(playerid, TextdrawVelocimetro[playerid][26], 0x80808080);
    PlayerTextDrawSetProportional(playerid, TextdrawVelocimetro[playerid][26], 1);

    TextdrawVelocimetro[playerid][27] = CreatePlayerTextDraw(playerid, 385.900269, 408.200134, "F");
    PlayerTextDrawFont(playerid, TextdrawVelocimetro[playerid][27], 1);
    PlayerTextDrawLetterSize(playerid, TextdrawVelocimetro[playerid][27], 0.169999, 0.759999);
    PlayerTextDrawTextSize(playerid, TextdrawVelocimetro[playerid][27], 1280.000000, 1280.000000);
    PlayerTextDrawSetOutline(playerid, TextdrawVelocimetro[playerid][27], 0);
    PlayerTextDrawSetShadow(playerid, TextdrawVelocimetro[playerid][27], 1);
    PlayerTextDrawAlignment(playerid, TextdrawVelocimetro[playerid][27], 2);
    PlayerTextDrawUseBox(playerid, TextdrawVelocimetro[playerid][27], 0);
    PlayerTextDrawColor(playerid, TextdrawVelocimetro[playerid][27], 0xffffffff);
    PlayerTextDrawBackgroundColor(playerid, TextdrawVelocimetro[playerid][27], 0x00000000);
    PlayerTextDrawBoxColor(playerid, TextdrawVelocimetro[playerid][27], 0x80808080);
    PlayerTextDrawSetProportional(playerid, TextdrawVelocimetro[playerid][27], 1);

    TextdrawVelocimetro[playerid][28] = CreatePlayerTextDraw(playerid, 361.000000, 391.700165, "ld_pool:ball");
    PlayerTextDrawFont(playerid, TextdrawVelocimetro[playerid][28], 4);
    PlayerTextDrawLetterSize(playerid, TextdrawVelocimetro[playerid][28], 0.500000, 1.000000);
    PlayerTextDrawTextSize(playerid, TextdrawVelocimetro[playerid][28], 28.699999, 35.399979);
    PlayerTextDrawSetOutline(playerid, TextdrawVelocimetro[playerid][28], 0);
    PlayerTextDrawSetShadow(playerid, TextdrawVelocimetro[playerid][28], 2);
    PlayerTextDrawUseBox(playerid, TextdrawVelocimetro[playerid][28], 1);
    PlayerTextDrawColor(playerid, TextdrawVelocimetro[playerid][28], 0x0f0f0f64);
    PlayerTextDrawBackgroundColor(playerid, TextdrawVelocimetro[playerid][28], 0x000000ff);
    PlayerTextDrawBoxColor(playerid, TextdrawVelocimetro[playerid][28], 0x000000ff);
    PlayerTextDrawSetProportional(playerid, TextdrawVelocimetro[playerid][28], 1);

    // Create speed pointer and gas pointer dots in OnPlayerConnect (like working system)
    for(new i = 0; i < MAX_BOLINHAS; i++)
    {
        TextdrawVelocimetroPont[playerid][i] = CreatePlayerTextDraw(playerid, 343.0, 386.0, ".");
        PlayerTextDrawFont(playerid, TextdrawVelocimetroPont[playerid][i], 1);
        PlayerTextDrawLetterSize(playerid, TextdrawVelocimetroPont[playerid][i], 0.350000, 1.450001);
        PlayerTextDrawSetShadow(playerid, TextdrawVelocimetroPont[playerid][i], 0);
        PlayerTextDrawSetProportional(playerid, TextdrawVelocimetroPont[playerid][i], 1);
        PlayerTextDrawColor(playerid, TextdrawVelocimetroPont[playerid][i], 0xaa00ffff);
        PlayerTextDrawBackgroundColor(playerid, TextdrawVelocimetroPont[playerid][i], 0x00000000);

        TextdrawGasolinhaPont[playerid][i] = CreatePlayerTextDraw(playerid, 388.0, 401.0, ".");
        PlayerTextDrawFont(playerid, TextdrawGasolinhaPont[playerid][i], 1);
        PlayerTextDrawLetterSize(playerid, TextdrawGasolinhaPont[playerid][i], 0.350000, 1.450001);
        PlayerTextDrawSetShadow(playerid, TextdrawGasolinhaPont[playerid][i], 0);
        PlayerTextDrawSetProportional(playerid, TextdrawGasolinhaPont[playerid][i], 1);
        PlayerTextDrawColor(playerid, TextdrawGasolinhaPont[playerid][i], 0xaa00ffff);
        PlayerTextDrawBackgroundColor(playerid, TextdrawGasolinhaPont[playerid][i], 0x00000000);
    }

}

stock Velo_DestroyTDs(playerid)
{
    for(new i = 0; i < 29; i++)
    {
        PlayerTextDrawDestroy(playerid, TextdrawVelocimetro[playerid][i]);
    }
    for(new i = 0; i < MAX_BOLINHAS; i++)
    {
        if(TextdrawVelocimetroPont[playerid][i] != PlayerText:INVALID_TEXT_DRAW)
            PlayerTextDrawDestroy(playerid, TextdrawVelocimetroPont[playerid][i]);
        if(TextdrawGasolinhaPont[playerid][i] != PlayerText:INVALID_TEXT_DRAW)
            PlayerTextDrawDestroy(playerid, TextdrawGasolinhaPont[playerid][i]);
    }
}

BCG:: item_proximo(playerid)
{

	if(IsPlayerInAnyVehicle(playerid))
	{
	    if(mostrando_item[playerid] == 1)
	    {
	        mostrando_item[playerid] = 0;
	        //TextDrawHideForPlayer(playerid, T_Item_Perto[0]);
	    }
	}
	else
	{
		if(perto_item[playerid] != -1)
		{
		    new it = perto_item[playerid];
		    if(Item[it][item_Existe] == 0) perto_item[playerid] = -1;
		    else
		    {
		        if(!IsPlayerInRangeOfPoint(playerid, 2.0, Item[it][item_X],Item[it][item_Y],Item[it][item_Z]))perto_item[playerid] = -1;
		        else
				{
		            if(GetPlayerInterior(playerid) != Item[it][item_Interior]) perto_item[playerid] = -1;
		            else if(GetPlayerInterior(playerid) != Item[it][item_Interior]) perto_item[playerid] = -1;
		        }
		    }
		}

		if(perto_item[playerid] == -1)
		{
		    foreach(new it:Iter_Itens)
		    {
		        if(Item[it][item_Existe] == 1)
			 	{
				if(IsPlayerInRangeOfPoint(playerid, 3.0, Item[it][item_X],Item[it][item_Y],Item[it][item_Z]))
					{
				    if(GetPlayerInterior(playerid) == Item[it][item_Interior])
					{
				        if(GetPlayerVirtualWorld_(playerid) == Item[it][item_Mundo])
						{
		                        perto_item[playerid] = it;
							break;
					    }
				    }
				}
		        }
		    }
		}

		if(mostrando_item[playerid] == 0)
		{
		    if(perto_item[playerid] != -1)
		    {
		        mostrando_item[playerid] = 1;
		    	//TextDrawShowForPlayer(playerid, T_Item_Perto[0]);
		    }
		}
		else
		{
		    if(perto_item[playerid] == -1)
		    {
		        mostrando_item[playerid] = 0;
		        //TextDrawHideForPlayer(playerid, T_Item_Perto[0]);
		    }
		}
	}
}



stock mostrar_salarios(playerid)
{
	new cont;
	new sss[300];
	SG[0] = EOS;
	strcat(SG, "ID\tNome da Org\tSalario\n");
	zerar_lista(playerid);
	foreach(new i:Iter_Orgs)
	{
	    if(Org[i][o_Existe] == 1)
	    {
	        if(OrgGov(i))
	        {
	            format(sss, 300, "{EEE8AA}%d\t{%06x}%s\t{4169E1}R$ %s\n", i, CorOrg(i) >>> 8, NomeOrg(i), ConvertMoney(Org[i][o_Salario]));
				strcat(SG, sss);
	            Lista[playerid][cont] = i;
	            cont ++;
	        }
	    }
	}
	ShowPlayerDialog(playerid, DIALOG_SALARIOS, DIALOG_STYLE_TABLIST_HEADERS, "Salarios das Corporacoes", SG, "Setar", "Fechar");
}

stock pagamento_corps()
{
	new sss[150];
    foreach(new i:Iter_Orgs)
	{
        if(Org[i][o_Existe] == 1)
	    {
	        if(OrgGov(i))
	        {
				if(Org[i][o_Salario] > 0)
				{
				    if(cofre_publico >= Org[i][o_Salario])
					{
					format(sss, 150, "[PAGAMENTO] A corporacao recebeu R$ %s neste PayDay do Governo.", ConvertMoney(Org[i][o_Salario]));
						Org[i][o_Cofre] += Org[i][o_Salario];
						salvar_org(i);
					}
					else format(sss, 150, "[PAGAMENTO] Nao foi possivel receber opagamento do Governo neste PayDay.");
					mso(i, sss);
				}
			}
		}
	}
}

stock add_cp(num)
{
    cofre_publico += num;
    salvar_definicoes("Cofre", cofre_publico);
}

stock mostrar_cofre_publico(playerid)
{
	new sss[300];
	format(sss, 300, "\n\n{ffffff}Cofre Publico: {4169E1}R$ %s\n\n", ConvertMoney(cofre_publico));
	ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}.", sss, "Ok", "Fechar");
}


stock abrir_cancela(a)
{
	if(Pedagio[a][ped_Aberta] == 0)
	{
	    Pedagio[a][ped_Aberta] = 1;
		KillTimer(Pedagio[a][ped_Timer]);
		MoveDynamicObject(Pedagio[a][ped_Obj],  Pedagio[a][ped_X]+0.02, Pedagio[a][ped_Y]+0.02, Pedagio[a][ped_Z], 0.01, Pedagio[a][ped_RX], 0.0, Pedagio[a][ped_RZ]);
        Pedagio[a][ped_Timer] = SetTimerEx("fechar_cancela", 5000, false, "d", a);
        Play_Som(25800, Pedagio[a][ped_X], Pedagio[a][ped_Y], Pedagio[a][ped_Z], 0, 0);
	}
}

BCG:: fechar_cancela(a)
{
    if(Pedagio[a][ped_Aberta] == 1)
	{
	    Pedagio[a][ped_Aberta] = 2;
	    KillTimer(Pedagio[a][ped_Timer]);
	    MoveDynamicObject(Pedagio[a][ped_Obj],  Pedagio[a][ped_X], Pedagio[a][ped_Y], Pedagio[a][ped_Z], 0.01, Pedagio[a][ped_RX], Pedagio[a][ped_RY], Pedagio[a][ped_RZ]);
	    Pedagio[a][ped_Timer] = SetTimerEx("liberar_cancela", 2500, false, "d", a);
	    Play_Som(12201, Pedagio[a][ped_X], Pedagio[a][ped_Y], Pedagio[a][ped_Z], 0, 0);
	}
}

BCG:: liberar_cancela(a)
{
    if(Pedagio[a][ped_Aberta] == 2)
	{
	    Pedagio[a][ped_Aberta] = 0;
	    KillTimer(Pedagio[a][ped_Timer]);
	    Play_Som(25604, Pedagio[a][ped_X], Pedagio[a][ped_Y], Pedagio[a][ped_Z], 0, 0);
	}
}


stock criar_cancela(Float:xx, Float:yy, Float:zz, Float:rxx, Float:ryy, Float:rzz, Float:px, Float:py, Float:pz)
{
	for(new a; a<MAX_PEDAGIOS; a++)
	{
	    if(Pedagio[a][ped_Existe] == 0)
	    {
	        Pedagio[a][ped_Existe] = 1;
	        Pedagio[a][ped_Valor] = 500;
	        Pedagio[a][ped_X] = xx;
	        Pedagio[a][ped_Y] = yy;
	        Pedagio[a][ped_Z] = zz;
	        Pedagio[a][ped_RX] = rxx;
	        Pedagio[a][ped_RY] = ryy;
	        Pedagio[a][ped_RZ] = rzz;
	        Pedagio[a][ped_PX] = px;
	        Pedagio[a][ped_PY] = py;
	        Pedagio[a][ped_PZ] = pz;
	        atualizar_pedagio(a);
	        return a;
	    }
	}
	return -1;
}

stock atualizar_pedagio(a)
{
    if(IsValidDynamicObject(Pedagio[a][ped_Obj])) DestroyDynamicObject_(Pedagio[a][ped_Obj]);
    if(Pedagio[a][ped_Existe] == 1)
	{
	    Pedagio[a][ped_Aberta] = 0;
	    KillTimer(Pedagio[a][ped_Timer]);
	    Pedagio[a][ped_Obj] = CreateDynamicObject(968, Pedagio[a][ped_X], Pedagio[a][ped_Y], Pedagio[a][ped_Z], Pedagio[a][ped_RX], Pedagio[a][ped_RY], Pedagio[a][ped_RZ]);
	}
}

stock pagar_pedagio(playerid, a, con=0)
{
	if(Pedagio[a][ped_Aberta] == 0)
	{
	    if(PlayerCop(playerid))
	    {
	        abrir_cancela(a);
	        GameTextForPlayer(playerid, f("~r~PEDAGIO~n~~y~PASSE LIVRE", ConvertMoney(Pedagio[a][ped_Valor])), 3000, 3);
	    }
	    else
	    {
			if(GranaPlayer(playerid) >= Pedagio[a][ped_Valor])
			{
				DarGrana(playerid, -Pedagio[a][ped_Valor]);
				abrir_cancela(a);
				add_cp(Pedagio[a][ped_Valor]);
				GameTextForPlayer(playerid, f("~r~PEDAGIO~n~~g~R$ %s", ConvertMoney(Pedagio[a][ped_Valor])), 3000, 3);
			}
			else
			{
				MS(playerid, 0, f("Voce nao tem R$ %s para pagar o pedagio !", ConvertMoney(Pedagio[a][ped_Valor])));
				if(con == 1) mostrar_pedagio(playerid, a);
			}
		}
	}
	else
	{
		MS(playerid, 2, "Aguarde um momento e tente novamente !");
		if(con == 1) mostrar_pedagio(playerid, a);
	}
}

stock mostrar_pedagio(playerid, i)
{
	SetPVarInt(playerid, "ped", i);
	new sss[200];
	format(sss, 200, "\n{00ffff}Pagar Pedagio\n{ffffff}Valor: {4169E1}R$ %s\n", ConvertMoney(Pedagio[i][ped_Valor]));
	if(PlayerCop(playerid))
	{
		format(sss, 200, "\n{00ffff}Pagar Pedagio\n{ffffff}Passe Livre\n");
		ShowPlayerDialog(playerid, DIALOG_PEDAGIO, DIALOG_STYLE_MSGBOX, "{000000}.", sss, "Passar", "Cancelar");
	}
	else ShowPlayerDialog(playerid, DIALOG_PEDAGIO, DIALOG_STYLE_MSGBOX, "{000000}.", sss, "Pagar", "Cancelar");
}

stock GetPlayerSkin_(playerid)
{
	if(IsPlayerConnected(playerid))
	{
	    return GetPlayerSkin(playerid);
	}
	return 0;
}

stock fechar_inv_novo(playerid)
{
    EsconderFusionInv(playerid);
    for(new a; a<3; a++) TextDrawHideForPlayer(playerid, T_InvNovo[a]);
    combinando[playerid] = -1;
    guardando[playerid] = 0;
	guardando_bau[playerid] = 0;
    inv_novo_aberto[playerid] = 0;
    inv_modo[playerid] = INV_MODO_CHAO;
	CancelSelectTextDraw(playerid);
	if(IsPlayerAttachedObjectSlotUsed(playerid, 9))RemovePlayerAttachedObject(playerid, 9);
	if(!IsPlayerInAnyVehicle(playerid)){
        ClearAnimations(playerid, 1);
    }
	mostrar_hud(playerid);
	fechar_caixinha(playerid);
	fechar_armas_novo(playerid);
	fechar_atalhos_novo(playerid);
	fechar_meu_novo(playerid);
    mostrar_logomarca(playerid);
	MS(playerid, 0, "_", 1);
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER) mostrar_velocimetro(playerid);
    return 1;
}

stock abrir_inv_novo(playerid, con=0)
{
	new c = id[playerid];
	if(c != -1)
	{
	    // se tiver fechado //
		if(inv_novo_aberto[playerid] == 0)
		{
		    inv_novo_aberto[playerid] = 1;
		    combinando[playerid] = -1;
		    guardando[playerid] = 0;
			guardando_bau[playerid] = 0;
		    fusion_selecionado[playerid] = -1;
		    selecionando_inv_novo[playerid] = -1;
		    selecionando_inv_novo2[playerid] = -1;
		    if(con == 0 && inv_modo[playerid] == 0) inv_modo[playerid] = INV_MODO_CHAO;
		if(mostrando_velocimetro[playerid] == 1) esconder_velocimetro(playerid);
		MostrarFusionInv(playerid);
			SelectTextDraw(playerid, 0x00ffff60);
			if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER && GetPlayerState(playerid) != PLAYER_STATE_PASSENGER){
				ApplyAnimation(playerid, "COP_AMBIENT", "COPBROWSE_LOOP", 4.1, true, false, false, false, 0, 1);
				SetPlayerAttachedObject(playerid, 9, 19559, 5,  0.049000, 0.248000, 0.067000, 110.799987, 0.000000, 130.399993, 1.000000, 1.000000, 1.000000);
			}
			esconder_hud(playerid);
			esconder_logomarca(playerid);
			MS(playerid, 0, "_", 1);
			for(new d; d<3; d++) TextDrawHideForPlayer(playerid, T_InvNovo[d]);
			for(new d; d<9; d++) PlayerTextDrawHide(playerid, T_MS_p[playerid][d]);
			fechar_meu_novo(playerid);
			fechar_armas_novo(playerid);
			fechar_atalhos_novo(playerid);
			if(Conta[playerid][c_Caixas] > 0)
			{
				new mmaxx = Conta[playerid][c_Caixas];
				for(new a; a<mmaxx; a++)
				{
					if(add_inv(c, 89, 1, 0, 0, 0))
					{
						Conta[playerid][c_Caixas] --;
						salvar_conta(c, 0, "c_Caixas", sv_int(Conta[playerid][c_Caixas]));
					}
				}
			}
		}

		// carregar armas equipadas
		{
			new cont_armas, a1, a2;
			for(new i; i<13; i++) { ListaArmas[playerid][i] = -1; GetPlayerWeaponData(playerid, i, a1, a2); if(a1 != 0) { ListaArmas[playerid][cont_armas] = i; cont_armas++; } }
			SetPVarInt(playerid, "cont_armas", cont_armas);
			if(id_arma[playerid] >= cont_armas || id_arma[playerid] == -1) id_arma[playerid] = (cont_armas > 0) ? 0 : -1;
		}
		// renderizar items nos slots do Fusion
		new cont;
		for(new i; i<MAX_SLOTS; i++)
		{
			ListaInv[playerid][i] = -1;
			if(Inventario[playerid][i][inv_ID] > 0)
			{
				if(Inventario[playerid][i][inv_Ativo] == 1 && Inventario[playerid][i][inv_Tempo] != 0)
				{
					if(Inventario[playerid][i][inv_Tempo] <= gettime())
					{
						new sss[300];
						format(sss, 300, "O Item '%s' foi excluido do seu inventario, por vencimento !", NomeItem(Inventario[playerid][i][inv_ID], Inventario[playerid][i][inv_Tipo]));
						ms(playerid, 2, sss);
						limpar_slot(playerid, i);
						continue;
					}
				}
				ListaInv[playerid][cont] = i;
				cont++;
			}
		}

		// scanear items no chao
		new floorCont;
		for(new a; a<25; a++) floor_item_index[playerid][a] = -1;
		foreach(new it:Iter_Itens)
		{
		    if(Item[it][item_Existe] == 1 && floorCont < 25)
		    {
		        if(IsPlayerInRangeOfPoint(playerid, 5.0, Item[it][item_X], Item[it][item_Y], Item[it][item_Z])
		        && GetPlayerVirtualWorld_(playerid) == Item[it][item_Mundo]
		        && GetPlayerInterior(playerid) == Item[it][item_Interior])
		        {
		            floor_item_index[playerid][floorCont] = it;
		            floorCont++;
		        }
		    }
		}

		// label TD [50] do modo atual
		switch(inv_modo[playerid])
		{
		    case INV_MODO_CHAO: PlayerTextDrawSetString(playerid, FusionInvP[playerid][50], "Chao");
		    case INV_MODO_BAU: PlayerTextDrawSetString(playerid, FusionInvP[playerid][50], "Bau");
		    case INV_MODO_BAU_I: PlayerTextDrawSetString(playerid, FusionInvP[playerid][50], "Bau");
		    case INV_MODO_PM: PlayerTextDrawSetString(playerid, FusionInvP[playerid][50], "Porta-Malas");
		}

		// mostrar slots: 0-24 inventario (direto), 25-49 conteudo do modo
		// calcular limite de slots do destino (lado direito)
		new maxRight = 25; // chão: 25 slots
		if(inv_modo[playerid] == INV_MODO_BAU)
		{
		    new ba = inv_bau_alvo[playerid];
		    if(ba >= 0 && ba < MAX_CASAS) maxRight = MAX_BAU;
		}
		else if(inv_modo[playerid] == INV_MODO_BAU_I)
		{
		    new bid = inv_bau_i_alvo[playerid];
		    if(bid >= 0 && bid < MAX_BAUS) maxRight = BauI[bid][bau_Slots];
		}
		else if(inv_modo[playerid] == INV_MODO_PM)
		{
		    new v = inv_pm_alvo[playerid];
		    if(v >= 0 && v < MAX_VEICULOS) maxRight = slots_porta_malas(v);
		}
		if(maxRight > 25) maxRight = 25;

		for(new a; a<50; a++)
		{
			new slot = -1;
			if(a < 25) { if(Inventario[playerid][a][inv_ID] > 0) slot = a; }
			else
			{
			    // slot alem do limite do destino: esconde
			    if(a-25 >= maxRight)
			    {
			        PlayerTextDrawHide(playerid, FusionInvP[playerid][a]);
			        continue;
			    }
			    // slots 25-49: depende do modo
			    if(inv_modo[playerid] == INV_MODO_CHAO)
			    {
			        if(a-25 < floorCont) slot = -2; // chão
			    }
			    else if(inv_modo[playerid] == INV_MODO_BAU)
			    {
			        new ba = inv_bau_alvo[playerid];
			        if(ba >= 0 && ba < MAX_CASAS && a-25 < MAX_BAU)
			            if(Bau[ba][a-25][inv_ID] > 0) slot = -3;
			    }
			    else if(inv_modo[playerid] == INV_MODO_BAU_I)
			    {
			        new bid = inv_bau_i_alvo[playerid];
			        if(bid >= 0 && bid < MAX_BAUS && a-25 < MAX_BAU_SLOTS)
			            if(BauI_Itens[bid][a-25][inv_ID] > 0) slot = -4;
			    }
			    else if(inv_modo[playerid] == INV_MODO_PM)
			    {
			        new v = inv_pm_alvo[playerid];
			        if(v >= 0 && v < MAX_VEICULOS && a-25 < MAX_PORTA_MALAS)
			            if(PortaMalas[v][a-25][inv_ID] > 0) slot = -5;
			    }
			}
			if(slot == -2)
			{
			    // CHAOO: item no chão
			    new fid = floor_item_index[playerid][a-25];
			    if(fid != -1 && Item[fid][item_Existe] == 1)
			    {
			        new model = modelo_item(Item[fid][item_ID], Item[fid][item_Tipo]);
			        if(model > 0)
			        {
			            PlayerTextDrawSetPreviewModel(playerid, FusionInvP[playerid][a], model);
			            PlayerTextDrawSetPreviewRot(playerid, FusionInvP[playerid][a], Itens[Item[fid][item_ID]][item_PreX], Itens[Item[fid][item_ID]][item_PreY], Itens[Item[fid][item_ID]][item_PreZ], Itens[Item[fid][item_ID]][item_PreV]);
			        }
			        PlayerTextDrawColor(playerid, FusionInvP[playerid][a], 0xffffffff);
			        PlayerTextDrawBackgroundColor(playerid, FusionInvP[playerid][a], 0x00000080);
			        if(selecionando_inv_novo2[playerid] == a)
			            PlayerTextDrawBackgroundColor(playerid, FusionInvP[playerid][a], 0x00808080);
			    }
			    else
			    {
			        PlayerTextDrawSetPreviewModel(playerid, FusionInvP[playerid][a], 19300);
			        PlayerTextDrawColor(playerid, FusionInvP[playerid][a], 0xffffffff);
			        PlayerTextDrawBackgroundColor(playerid, FusionInvP[playerid][a], 0x00000080);
			    }
			}
			else if(slot == -3 || slot == -4 || slot == -5)
			{
			    // BAU / BAU_I / PM: item no armazenamento
			    new idd, tipo;
			    if(slot == -3) { idd = Bau[inv_bau_alvo[playerid]][a-25][inv_ID]; tipo = Bau[inv_bau_alvo[playerid]][a-25][inv_Tipo]; }
			    else if(slot == -4) { idd = BauI_Itens[inv_bau_i_alvo[playerid]][a-25][inv_ID]; tipo = BauI_Itens[inv_bau_i_alvo[playerid]][a-25][inv_Tipo]; }
			    else { idd = PortaMalas[inv_pm_alvo[playerid]][a-25][inv_ID]; tipo = PortaMalas[inv_pm_alvo[playerid]][a-25][inv_Tipo]; }
			    new model = modelo_item(idd, tipo);
			    if(model > 0)
			    {
			        PlayerTextDrawSetPreviewModel(playerid, FusionInvP[playerid][a], model);
			        PlayerTextDrawSetPreviewRot(playerid, FusionInvP[playerid][a], Itens[idd][item_PreX], Itens[idd][item_PreY], Itens[idd][item_PreZ], Itens[idd][item_PreV]);
			    }
			    PlayerTextDrawColor(playerid, FusionInvP[playerid][a], 0xffffffff);
			    PlayerTextDrawBackgroundColor(playerid, FusionInvP[playerid][a], 0x00000080);
			    if(fusion_selecionado[playerid] == (a-25)+1000)
			        PlayerTextDrawBackgroundColor(playerid, FusionInvP[playerid][a], 0x00808080);
			}
			else if(slot > -1)
			{
				new idd = Inventario[playerid][slot][inv_ID];
				new tipo = Inventario[playerid][slot][inv_Tipo];
				new model = modelo_item(idd, tipo);
				if(model > 0)
				{
					PlayerTextDrawSetPreviewModel(playerid, FusionInvP[playerid][a], model);
					PlayerTextDrawSetPreviewRot(playerid, FusionInvP[playerid][a], Itens[idd][item_PreX], Itens[idd][item_PreY], Itens[idd][item_PreZ], Itens[idd][item_PreV]);
				}
				PlayerTextDrawColor(playerid, FusionInvP[playerid][a], 0xffffffff);
				PlayerTextDrawBackgroundColor(playerid, FusionInvP[playerid][a], 0x00000080);
				if(fusion_selecionado[playerid] == slot)
					PlayerTextDrawBackgroundColor(playerid, FusionInvP[playerid][a], 0x00808080);
			}
			else
			{
				PlayerTextDrawSetPreviewModel(playerid, FusionInvP[playerid][a], 19300);
				PlayerTextDrawColor(playerid, FusionInvP[playerid][a], 0xffffffff);
				PlayerTextDrawBackgroundColor(playerid, FusionInvP[playerid][a], 0x00000080);
			}
			PlayerTextDrawShow(playerid, FusionInvP[playerid][a]);
		}

		// info panel e botoes
		if(fusion_selecionado[playerid] != -1)
		{
			new slot = fusion_selecionado[playerid];
			if(Inventario[playerid][slot][inv_ID] > 0)
			{
				new idd = Inventario[playerid][slot][inv_ID];
				new tipo = Inventario[playerid][slot][inv_Tipo];
				new unid = Inventario[playerid][slot][inv_Unidades];
				PlayerTextDrawSetString(playerid, FusionInvP[playerid][51], NomeItem(idd, tipo, Inventario[playerid][slot][inv_Ativo], Inventario[playerid][slot][inv_Tempo]));
				new peso[20];
				format(peso, 20, "%.1fkg", 0.0);
				PlayerTextDrawSetString(playerid, FusionInvP[playerid][52], peso);
				PlayerTextDrawSetString(playerid, FusionInvP[playerid][53], f("%dx", unid));
			}
		}
		else
		{
			PlayerTextDrawSetString(playerid, FusionInvP[playerid][51], "Nenhum");
			PlayerTextDrawSetString(playerid, FusionInvP[playerid][52], "0.0kg");
			PlayerTextDrawSetString(playerid, FusionInvP[playerid][53], "0x");
		}
		// quantidade
		new qtyStr[16];
		if(inv_qty[playerid] > 0) format(qtyStr, 16, "%d", inv_qty[playerid]);
		else format(qtyStr, 16, "Quantidade");
		PlayerTextDrawSetString(playerid, FusionInvP[playerid][54], qtyStr);
		// armas equipadas (usando id_arma selecionado)
		new armaSlot = -1, armaID, armaAmmo;
		if(id_arma[playerid] != -1)
		{
		    new ws = ListaArmas[playerid][id_arma[playerid]];
		    if(ws != -1) GetPlayerWeaponData(playerid, ws, armaID, armaAmmo);
		    if(armaID > 0) armaSlot = ws;
		}
		if(armaSlot == -1)
		{
		    for(new i=0; i<13; i++)
		    {
		        GetPlayerWeaponData(playerid, i, armaID, armaAmmo);
		        if(armaID > 0) { armaSlot = i; if(id_arma[playerid] == -1) { id_arma[playerid] = 0; ListaArmas[playerid][0] = i; } break; }
		    }
		}
		if(armaSlot != -1)
		{
		    new model = arma_id(armaID, 1);
		    if(model > 0)
		    {
		        PlayerTextDrawSetPreviewModel(playerid, FusionInvP[playerid][58], model);
		        PlayerTextDrawSetPreviewRot(playerid, FusionInvP[playerid][58], zoom_armas[armaSlot][0], zoom_armas[armaSlot][1], zoom_armas[armaSlot][2], zoom_armas[armaSlot][3]);
		    }
		    new name[32];
		    format(name, 32, "%s [%d]", nome_arma(armaID), armaAmmo);
		    PlayerTextDrawSetString(playerid, FusionInvP[playerid][59], name);
		}
		else
		{
		    PlayerTextDrawSetPreviewModel(playerid, FusionInvP[playerid][58], 19300);
		    PlayerTextDrawSetString(playerid, FusionInvP[playerid][59], "Nenhuma");
		}
		for(new a=50; a<62; a++) PlayerTextDrawShow(playerid, FusionInvP[playerid][a]);
	}
}

stock selecionou_novo(playerid, slot, b)
{
	new c = id[playerid];
	new retornar;
    if(c != -1)
	{
	    // verificar se venceu //
		if(Inventario[playerid][slot][inv_Ativo] == 1 && Inventario[playerid][slot][inv_Tempo] != 0)
        {
            if(Inventario[playerid][slot][inv_Tempo] <= gettime())
            {
                new sss[300];
                format(sss, 300, "O Item '%s' foi excluido do seu inventario, por vencimento !", NomeItem(Inventario[playerid][slot][inv_ID], Inventario[playerid][slot][inv_Tipo]));
				ms(playerid, 2, sss);
				limpar_slot(playerid, slot);
				abrir_inv_novo(playerid);
				retornar = 1;
			}
        }

		if(retornar == 0)
		{
		    new velho = selecionando_inv_novo[playerid];
		    new a = selecionando_inv_novo2[playerid];
			if(slot != velho)
			{
		        if(slot > -1)
		        {
		            PlayerTextDrawBackgroundColor(playerid, T_InvNovo_p[playerid][b], 0x00808080);
		            selecionando_inv_novo[playerid] = slot;
		            selecionando_inv_novo2[playerid] = b;
		            if(velho != -1)
		            {
	                    if(a != b)
	                    {
	                    	PlayerTextDrawBackgroundColor(playerid, T_InvNovo_p[playerid][a], 0x00000080);
						}
		            }
			    	mostrar_caixinha(playerid);
				}
			}
			else
			{
			    if(mostrando_caixinha[playerid] == 0)
				{
				mostrar_caixinha(playerid);
			    }
			}
		}
	}
}


stock fechar_caixinha(playerid)
{
	new c = id[playerid];
	if(c != -1)
	{
        if(mostrando_caixinha[playerid] == 1)
		{
		    for(new a; a<sizeof T_Caixinha; a++) TextDrawHideForPlayer(playerid, T_Caixinha[a]);
            for(new a; a<4; a++) PlayerTextDrawHide(playerid, T_Caixinha_p[playerid][a]);
            mostrando_caixinha[playerid] = 0;
            abrir_inv_novo(playerid);
		}
	}
}

stock mostrar_caixinha(playerid)
{
	new c = id[playerid];
	if(c != -1)
	{
	    if(selecionando_inv_novo[playerid] != -1)
	    {
	        new slot = selecionando_inv_novo[playerid];
	        new unid = Inventario[playerid][slot][inv_Unidades];
	        new idd = Inventario[playerid][slot][inv_ID];
	        new tipo = Inventario[playerid][slot][inv_Tipo];
		    new model = modelo_item(idd, tipo);
			mostrando_caixinha[playerid] = 1;
			PlayerTextDrawSetPreviewModel(playerid, T_Caixinha_p[playerid][0], model);
            PlayerTextDrawSetPreviewRot(playerid, T_Caixinha_p[playerid][0], Itens[idd][item_PreX], Itens[idd][item_PreY], Itens[idd][item_PreZ], Itens[idd][item_PreV]);
			PlayerTextDrawSetString(playerid, T_Caixinha_p[playerid][1], NomeItem(idd, tipo, Inventario[playerid][slot][inv_Ativo], Inventario[playerid][slot][inv_Tempo]));
			PlayerTextDrawSetString(playerid, T_Caixinha_p[playerid][2], ConvertMoney(unid));
			PlayerTextDrawSetString(playerid, T_Caixinha_p[playerid][3], Itens[idd][item_Info]);
			new b;
			for(new a; a<9; a++)
		    {
				b = a+5;
		        PlayerTextDrawHide(playerid, T_InvNovo_p[playerid][b]);
		        PlayerTextDrawHide(playerid, T_InvNovo_p[playerid][b+9]);
		        PlayerTextDrawHide(playerid, T_InvNovo_p[playerid][b+18]);
		    }
			for(new a; a<sizeof T_Caixinha; a++) TextDrawShowForPlayer(playerid, T_Caixinha[a]);
            for(new a; a<4; a++) PlayerTextDrawShow(playerid, T_Caixinha_p[playerid][a]);
		}
	}
}

