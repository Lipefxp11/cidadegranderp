		if(c != -1)
		{
		    if(mostrando_hud[playerid] == 1)
      		{
       		    SetPlayerProgressBarValue(playerid, PlayerProgressBar[playerid][1], float(Conta[playerid][c_Sede]));
      		    ShowPlayerProgressBar(playerid, PlayerProgressBar[playerid][1]);
		    }
		}
	}
}


stock atualizar_atributos(playerid)
{
    if(Online(playerid))
	{
	    new c = id[playerid];
		if(c != -1)
		{
		    if(mostrando_atributos[playerid] == 1)
		    {
	  		    new Float:unidade = 76.690574/100;
	  		    new Float:barra;
	  		    barra = Conta[playerid][c_Forca]*unidade;
	  		    PlayerTextDrawTextSize(playerid, T_HudPlayer[playerid][2], barra, 9.390008);
	  		    PlayerTextDrawShow(playerid, T_HudPlayer[playerid][2]);
	  		    barra = Conta[playerid][c_Resistencia]*unidade;
	  		    PlayerTextDrawTextSize(playerid, T_HudPlayer[playerid][3], barra, 9.390008);
	  		    PlayerTextDrawShow(playerid, T_HudPlayer[playerid][3]);
	  		    barra = Conta[playerid][c_Estamina]*unidade;
	  		    PlayerTextDrawTextSize(playerid, T_HudPlayer[playerid][4], barra, 9.390008);
	  		    PlayerTextDrawShow(playerid, T_HudPlayer[playerid][4]);
  		    }
		}
	}
}


stock SetarFome(playerid, fome)
{
	if(fome < 0) fome = 0;
	if(fome > 100) fome = 100;
    if(Online(playerid))
	{
	    new c = id[playerid];
		if(c != -1)
		{
            Conta[playerid][c_Fome] = fome;
			atualizar_fome(playerid);
		}
	}
}

stock SetarSede(playerid, fome)
{
	if(fome < 0) fome = 0;
	if(fome > 100) fome = 100;
    if(Online(playerid))
	{
	    new c = id[playerid];
		if(c != -1)
		{
            Conta[playerid][c_Sede] = fome;
			atualizar_sede(playerid);
		}
	}
}

BCG:: armas_costas(playerid)
{
	if(Online(playerid))
	{
		new o,p;
		new contt;
		if(IsPlayerAttachedObjectSlotUsed(playerid, 5)) RemovePlayerAttachedObject(playerid, 5);
		if(IsPlayerAttachedObjectSlotUsed(playerid, 6)) RemovePlayerAttachedObject(playerid, 6);
		if(IsPlayerAttachedObjectSlotUsed(playerid, 7)) RemovePlayerAttachedObject(playerid, 7);
		for(new i; i<13; i++)
		{
		    GetPlayerWeaponData(playerid, i, o, p);
	        for(new a; a<sizeof ArmasCostas; a++)
	        {
	            if(o == ArmasCostas[a][ac_ID] && o != GetPlayerWeapon(playerid))
	            {
	                if(contt < 3)
	                {
		                if(!IsPlayerAttachedObjectSlotUsed(playerid, 5)) SetPlayerAttachedObject(playerid, 5, ArmasCostas[a][ac_Modelo], ArmasCostas[a][ac_Local], ArmasCostas[a][ac_X], ArmasCostas[a][ac_Y], ArmasCostas[a][ac_Z], ArmasCostas[a][ac_RX], ArmasCostas[a][ac_RY], ArmasCostas[a][ac_RZ], ArmasCostas[a][ac_TX], ArmasCostas[a][ac_TY], ArmasCostas[a][ac_TZ]);
						else if(!IsPlayerAttachedObjectSlotUsed(playerid, 6)) SetPlayerAttachedObject(playerid, 6, ArmasCostas[a][ac_Modelo], ArmasCostas[a][ac_Local], ArmasCostas[a][ac_X], ArmasCostas[a][ac_Y], ArmasCostas[a][ac_Z], ArmasCostas[a][ac_RX], ArmasCostas[a][ac_RY], ArmasCostas[a][ac_RZ], ArmasCostas[a][ac_TX], ArmasCostas[a][ac_TY], ArmasCostas[a][ac_TZ]);
						else if(!IsPlayerAttachedObjectSlotUsed(playerid, 7)) SetPlayerAttachedObject(playerid, 7, ArmasCostas[a][ac_Modelo], ArmasCostas[a][ac_Local], ArmasCostas[a][ac_X], ArmasCostas[a][ac_Y], ArmasCostas[a][ac_Z], ArmasCostas[a][ac_RX], ArmasCostas[a][ac_RY], ArmasCostas[a][ac_RZ], ArmasCostas[a][ac_TX], ArmasCostas[a][ac_TY], ArmasCostas[a][ac_TZ]);
                        contt ++;
					}
				}
	        }
		}
	}
}

stock opcoes_editar_local(playerid, cidade, a)
{
	SetPVarInt(playerid, "a", a);
	SG[0] = EOS;
	new sss[200];
	format(sss, 200, "Editar Local - %s", cidade2(cidade));
	strcat(SG, "Opcao\tStatus\n");
	if(cidade == 0)
	{
	    // los santos //
	    strcat(SG, "{ffffff}Nome do Local\t{a1a1a1}"), strcat(SG, Local_LosSantos[a][local_Nome]), strcat(SG, "\n");
		strcat(SG, "{ffffff}Posicao no Mapa\t{a1a1a1}"), strcat(SG, "( Definir em sua Posicao Atual )"), strcat(SG, "\n");
		strcat(SG, "{ffffff}Interior\t{a1a1a1}"), strcat(SG, ConvertMoney(Local_LosSantos[a][local_Interior])), strcat(SG, "\n");
		strcat(SG, "{ffffff}Mundo\t{a1a1a1}"), strcat(SG, ConvertMoney(Local_LosSantos[a][local_Mundo])), strcat(SG, "\n");
	}

	if(cidade == 1)
	{
	    // san fierro //
	    strcat(SG, "{ffffff}Nome do Local\t{a1a1a1}"), strcat(SG, Local_SanFierro[a][local_Nome]), strcat(SG, "\n");
		strcat(SG, "{ffffff}Posicao no Mapa\t{a1a1a1}"), strcat(SG, "( Definir em sua Posicao Atual )"), strcat(SG, "\n");
		strcat(SG, "{ffffff}Interior\t{a1a1a1}"), strcat(SG, ConvertMoney(Local_SanFierro[a][local_Interior])), strcat(SG, "\n");
		strcat(SG, "{ffffff}Mundo\t{a1a1a1}"), strcat(SG, ConvertMoney(Local_SanFierro[a][local_Mundo])), strcat(SG, "\n");
	}

	if(cidade == 2)
	{
	    // las venturas //
	    strcat(SG, "{ffffff}Nome do Local\t{a1a1a1}"), strcat(SG, Local_LasVenturas[a][local_Nome]), strcat(SG, "\n");
		strcat(SG, "{ffffff}Posicao no Mapa\t{a1a1a1}"), strcat(SG, "( Definir em sua Posicao Atual )"), strcat(SG, "\n");
		strcat(SG, "{ffffff}Interior\t{a1a1a1}"), strcat(SG, ConvertMoney(Local_LasVenturas[a][local_Interior])), strcat(SG, "\n");
		strcat(SG, "{ffffff}Mundo\t{a1a1a1}"), strcat(SG, ConvertMoney(Local_LasVenturas[a][local_Mundo])), strcat(SG, "\n");
	}
	ShowPlayerDialog(playerid, DIALOG_EDITAR_LOCAL, DIALOG_STYLE_TABLIST_HEADERS, sss, SG, "Editar", "Voltar");
}

stock editar_opcao_cidade(playerid, cidadee, a, opcao, nome[])
{
	new sss[200];
	SetPVarInt(playerid, "cidade", cidadee);
	SetPVarInt(playerid, "a", a);
	SetPVarInt(playerid, "opcao", opcao);
	SetPVarString(playerid, "nome", nome);
	SG[0] = EOS;

	if(opcao == 0)
	{
	    // nome //
	    strcat(SG, "{ffffff}Cidade do Local: {ffff00}"), strcat(SG, cidade2(cidadee)), strcat(SG, "\n");
	    strcat(SG, "{ffffff}Nome do Local: {00ffff}"), strcat(SG, nome), strcat(SG, "\n\n");
        strcat(SG, "{4169E1}[INFO] {a1a1a1}Digite abaixo o novo Nome deste Local:\n");
		Input(playerid, DIALOG_VALOR_LOCAL, "Setar Nome", SG);
	}

	if(opcao == 1)
	{
	    // local no mapa //
		if(cidadee == 0) GetPlayerPos(playerid, Local_LosSantos[a][local_X], Local_LosSantos[a][local_Y], Local_LosSantos[a][local_Z]);
		if(cidadee == 1) GetPlayerPos(playerid, Local_SanFierro[a][local_X], Local_SanFierro[a][local_Y], Local_SanFierro[a][local_Z]);
		if(cidadee == 2) GetPlayerPos(playerid, Local_LasVenturas[a][local_X], Local_LasVenturas[a][local_Y], Local_LasVenturas[a][local_Z]);
		format(sss, 200, "Localizacao do local '%s' da cidade '%s' definida com sucesso !", nome, cidade2(cidadee));
        ms(playerid, 5, sss);
        salvar_definicoes("Locais", cidadee, a);
        opcoes_editar_local(playerid, cidadee, a);
	}

	if(opcao == 2)
	{
	    // Interior //
		strcat(SG, "{ffffff}Cidade do Local: {ffff00}"), strcat(SG, cidade2(cidadee)), strcat(SG, "\n");
	    strcat(SG, "{ffffff}Nome do Local: {00ffff}"), strcat(SG, nome), strcat(SG, "\n\n");
        if(cidadee == 0) strcat(SG, "{ffffff}Interior Atual: {4169E1}"), strcat(SG, ConvertMoney(Local_LosSantos[a][local_Interior])), strcat(SG, "\n\n");
        if(cidadee == 1) strcat(SG, "{ffffff}Interior Atual: {4169E1}"), strcat(SG, ConvertMoney(Local_SanFierro[a][local_Interior])), strcat(SG, "\n\n");
        if(cidadee == 2) strcat(SG, "{ffffff}Interior Atual: {4169E1}"), strcat(SG, ConvertMoney(Local_LasVenturas[a][local_Interior])), strcat(SG, "\n\n");
        strcat(SG, "{4169E1}[INFO] {a1a1a1}Digite abaixo o novo ID de interior deste Local:\n");
		Input(playerid, DIALOG_VALOR_LOCAL, "Setar Interior", SG);
	}

	if(opcao == 3)
	{
	    // Mundo //
	    strcat(SG, "{ffffff}Cidade do Local: {ffff00}"), strcat(SG, cidade2(cidadee)), strcat(SG, "\n");
	    strcat(SG, "{ffffff}Nome do Local: {00ffff}"), strcat(SG, nome), strcat(SG, "\n\n");
        if(cidadee == 0) strcat(SG, "{ffffff}Interior Atual: {4169E1}"), strcat(SG, ConvertMoney(Local_LosSantos[a][local_Interior])), strcat(SG, "\n\n");
        if(cidadee == 1) strcat(SG, "{ffffff}Interior Atual: {4169E1}"), strcat(SG, ConvertMoney(Local_SanFierro[a][local_Interior])), strcat(SG, "\n\n");
        if(cidadee == 2) strcat(SG, "{ffffff}Interior Atual: {4169E1}"), strcat(SG, ConvertMoney(Local_LasVenturas[a][local_Interior])), strcat(SG, "\n\n");
        strcat(SG, "{4169E1}[INFO] {a1a1a1}Digite abaixo o novo ID de Mundo deste Local:\n");
		Input(playerid, DIALOG_VALOR_LOCAL, "Setar Mundo", SG);
	}
}

stock lista_editar_locais(playerid, cidade=-1)
{
    SetPVarInt(playerid, "cidade", cidade);
    SG[0] = EOS;
    new sss[200];
	if(cidade == -1)
	{
	    // mostrar cidades //
		strcat(SG, "Cidades\tLocais\n");
	    format(sss, 200, " {ffffff}%s\t{a1a1a1}%d Locais\n", cidade2(0), sizeof Local_LosSantos), strcat(SG, sss);
		format(sss, 200, " {ffffff}%s\t{a1a1a1}%d Locais\n", cidade2(1), sizeof Local_SanFierro), strcat(SG, sss);
		format(sss, 200, " {ffffff}%s\t{a1a1a1}%d Locais\n", cidade2(2), sizeof Local_LasVenturas), strcat(SG, sss);
		ShowPlayerDialog(playerid, DIALOG_EDITAR_LOCAIS, DIALOG_STYLE_TABLIST_HEADERS, "Cidades", SG, "Continuar", "Fechar");
	}
	else
	{
	    // mostrar locais de uma cidade //
	    new Float:disaa;
		new Float:p[3];
		new str_dist[25];
	    GetPlayerPos(playerid, p[0],p[1],p[2]);
	    strcat(SG, "Local\tDistancia\n");
	    if(cidade == 0)
	    {
			// los santos //
			format(sss, 200, "Locais de - %s", cidade2(cidade));
			for(new a; a<sizeof Local_LosSantos; a++)
			{
			    GetDistance(disaa, p[0],p[1],p[2],  Local_LosSantos[a][local_X],  Local_LosSantos[a][local_Y], Local_LosSantos[a][local_Z]);
				format(str_dist, 25, "%.0f Metros", disaa);
				strcat(SG, "{ffffff}"), strcat(SG, Local_LosSantos[a][local_Nome]), strcat(SG, "\t{a1a1a1}"), strcat(SG, str_dist),  strcat(SG, "\n");
			}
	    }
	    if(cidade == 1)
	    {
			// san fierro //
			format(sss, 200, "Locais de - %s", cidade2(cidade));
			for(new a; a<sizeof Local_SanFierro; a++)
			{
			    GetDistance(disaa, p[0],p[1],p[2],  Local_SanFierro[a][local_X],  Local_SanFierro[a][local_Y], Local_SanFierro[a][local_Z]);
				format(str_dist, 25, "%.0f Metros", disaa);
				strcat(SG, "{ffffff}"), strcat(SG, Local_SanFierro[a][local_Nome]), strcat(SG, "\t{a1a1a1}"), strcat(SG, str_dist),  strcat(SG, "\n");
			}
	    }
	    if(cidade == 2)
	    {
			// las venturas //
			format(sss, 200, "Locais de - %s", cidade2(cidade));
			for(new a; a<sizeof Local_LasVenturas; a++)
			{
			    GetDistance(disaa, p[0],p[1],p[2],  Local_LasVenturas[a][local_X],  Local_LasVenturas[a][local_Y], Local_LasVenturas[a][local_Z]);
				format(str_dist, 25, "%.0f Metros", disaa);
				strcat(SG, "{ffffff}"), strcat(SG, Local_LasVenturas[a][local_Nome]), strcat(SG, "\t{a1a1a1}"), strcat(SG, str_dist),  strcat(SG, "\n");
			}
	    }
	    ShowPlayerDialog(playerid, DIALOG_EDITAR_LOCAIS, DIALOG_STYLE_TABLIST_HEADERS, sss, SG, "Continuar", "Voltar");
	}
}

stock salvar_definicoes(const texto[]="tudo", con=-1, con2=-1)
{
    new file[60];
	new str2[80];
	new str[500];


    // cofre publico //
	if(Comparar(texto, "Cofre") || Comparar(texto, "tudo"))
	{
	    format(file, 60, "Server/Cofre.txt");
	    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
     	DOF2_CreateFile(file);
        if(con == -1) DOF2_SetInt(file, "cofre_publico", 1000000);
        else DOF2_SetInt(file, "cofre_publico", con);
        if(con2 == -1) { } // keep defaults
        DOF2_SetInt(file, "gov_taxa", gov_taxa);
        DOF2_SetInt(file, "gov_preco_gasolina", gov_preco_gasolina);
        DOF2_SetInt(file, "gov_preco_alcool", gov_preco_alcool);
        DOF2_SetInt(file, "gov_preco_disel", gov_preco_disel);
        DOF2_SetInt(file, "gov_preco_gas", gov_preco_gas);
        DOF2_SetInt(file, "fac_estoque", fac_estoque);
        DOF2_SaveFile();
	}

	// salvar ant xiter //
	if(Comparar(texto, "Atc") || Comparar(texto, "tudo"))
	{
	    format(file, 60, "Server/Ant_Xiter.txt");
	    if(con == -1)
	    {
	        // salvar todos //
        	if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
        	DOF2_CreateFile(file);
            for(new a; a<sizeof ant_xiter_status; a++)
        	{
        	    format(str2, 80, "atc_%d", a);
        		format(str, 500, "%d|%d|%s|", ant_xiter_status[a][atc_Ligado], ant_xiter_status[a][atc_Kikar], ant_xiter_status[a][atc_Nome]);
                DOF2_SetString(file, str2, str);
			}
	    }
	    else
	    {
	        // salvar so um //
            new a = con;
            format(str2, 80, "atc_%d", a);
    		format(str, 500, "%d|%d|%s|", ant_xiter_status[a][atc_Ligado], ant_xiter_status[a][atc_Kikar], ant_xiter_status[a][atc_Nome]);
            DOF2_SetString(file, str2, str);
	    }
	    DOF2_SaveFile();
	}

	// pay day //
	if(Comparar(texto, "Loteria") || Comparar(texto, "tudo"))
	{
	    format(file, 60, "Server/Loteria.txt");
	    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
     	DOF2_CreateFile(file);
     	if(con == -1) DOF2_SetInt(file, "premio_loteria", premio_loteria);
     	else DOF2_SetInt(file, "premio_loteria", con);
	    DOF2_SaveFile();
	}

	// pay day //
	if(Comparar(texto, "PayDay") || Comparar(texto, "tudo"))
	{
	    format(file, 60, "Server/Pay_Day.txt");
	    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
     	DOF2_CreateFile(file);
     	if(con == -1) DOF2_SetInt(file, "payday_server", payday_server);
     	else DOF2_SetInt(file, "payday_server", con);
	    DOF2_SaveFile();
	}

	// salvar locais da cidade //
	if(Comparar(texto, "Locais") || Comparar(texto, "tudo"))
	{
	    // los santos //
	    if(con == -1 || con == 0)
	    {
            format(file, 60, "Server/Locais_LS.txt");
            if(con2 == -1)
            {
                // salvar todos //
            	if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
            	DOF2_CreateFile(file);
                for(new a; a<sizeof Local_LosSantos; a++)
                {
                    format(str2, 80, "Local_%d", a);
                    format(str, 500, "%f|%f|%f|%d|%d|%s|%d|", Local_LosSantos[a][local_X], Local_LosSantos[a][local_Y], Local_LosSantos[a][local_Z],
					Local_LosSantos[a][local_Interior], Local_LosSantos[a][local_Mundo], Local_LosSantos[a][local_Nome], a);
					DOF2_SetString(file, str2, str);
				}
			}
            else
            {
                // salvar so um //
                new a = con2;
                format(str2, 80, "Local_%d", a);
                format(str, 500, "%f|%f|%f|%d|%d|%s|%d|", Local_LosSantos[a][local_X], Local_LosSantos[a][local_Y], Local_LosSantos[a][local_Z],
				Local_LosSantos[a][local_Interior], Local_LosSantos[a][local_Mundo], Local_LosSantos[a][local_Nome], a);
				DOF2_SetString(file, str2, str);
            }
			DOF2_SaveFile();
	    }

	    // san fierro //
	    if(con == -1 || con == 1)
	    {
            format(file, 60, "Server/Locais_SF.txt");
            if(con2 == -1)
            {
                // salvar todos //
            	if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
            	DOF2_CreateFile(file);
                for(new a; a<sizeof Local_SanFierro; a++)
                {
                    format(str2, 80, "Local_%d", a);
                    format(str, 500, "%f|%f|%f|%d|%d|%s|%d|", Local_SanFierro[a][local_X], Local_SanFierro[a][local_Y], Local_SanFierro[a][local_Z],
					Local_SanFierro[a][local_Interior], Local_SanFierro[a][local_Mundo], Local_SanFierro[a][local_Nome], a);
					DOF2_SetString(file, str2, str);
				}
			}
            else
            {
                // salvar so um //
                new a = con2;
                format(str2, 80, "Local_%d", a);
                format(str, 500, "%f|%f|%f|%d|%d|%s|%d|", Local_SanFierro[a][local_X], Local_SanFierro[a][local_Y], Local_SanFierro[a][local_Z],
				Local_SanFierro[a][local_Interior], Local_SanFierro[a][local_Mundo], Local_SanFierro[a][local_Nome], a);
				DOF2_SetString(file, str2, str);
            }
			DOF2_SaveFile();
	    }

	    // las venturas //
	    if(con == -1 || con == 2)
	    {
            format(file, 60, "Server/Locais_LV.txt");
            if(con2 == -1)
            {
                // salvar todos //
            	if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
            	DOF2_CreateFile(file);
                for(new a; a<sizeof Local_LasVenturas; a++)
                {
                    format(str2, 80, "Local_%d", a);
                    format(str, 500, "%f|%f|%f|%d|%d|%s|%d|", Local_LasVenturas[a][local_X], Local_LasVenturas[a][local_Y], Local_LasVenturas[a][local_Z],
					Local_LasVenturas[a][local_Interior], Local_LasVenturas[a][local_Mundo], Local_LasVenturas[a][local_Nome], a);
					DOF2_SetString(file, str2, str);
				}
			}
            else
            {
                // salvar so um //
                new a = con2;
                format(str2, 80, "Local_%d", a);
                format(str, 500, "%f|%f|%f|%d|%d|%s|%d|", Local_LasVenturas[a][local_X], Local_LasVenturas[a][local_Y], Local_LasVenturas[a][local_Z],
				Local_LasVenturas[a][local_Interior], Local_LasVenturas[a][local_Mundo], Local_LasVenturas[a][local_Nome], a);
				DOF2_SetString(file, str2, str);
            }
			DOF2_SaveFile();
	    }
	}
}

BCG:: carregar_definicoes()
{
	new file[60];
	new str2[80];
	new str[600];

    // Cofre publico //
    format(file, 60, "Server/Cofre.txt");
    if(DOF2_FileExists(file))
    {
        cofre_publico = DOF2_GetInt(file, "cofre_publico");
        gov_taxa = DOF2_GetInt(file, "gov_taxa");
        gov_preco_gasolina = DOF2_GetInt(file, "gov_preco_gasolina");
        if(gov_preco_gasolina < 1) gov_preco_gasolina = 5;
        gov_preco_alcool = DOF2_GetInt(file, "gov_preco_alcool");
        if(gov_preco_alcool < 1) gov_preco_alcool = 3;
        gov_preco_disel = DOF2_GetInt(file, "gov_preco_disel");
        if(gov_preco_disel < 1) gov_preco_disel = 4;
        gov_preco_gas = DOF2_GetInt(file, "gov_preco_gas");
        if(gov_preco_gas < 1) gov_preco_gas = 3;
        fac_estoque = DOF2_GetInt(file, "fac_estoque");
    }
    else salvar_definicoes("Cofre", 1000000);

	// ant xiter //
	format(file, 60, "Server/Ant_Xiter.txt");
    if(DOF2_FileExists(file))
    {
        for(new a; a<sizeof ant_xiter_status; a++)
        {
            format(str2, 80, "atc_%d", a);
		    format(str, 500, "%s", DOF2_GetString(file, str2));
		    split_linha(str, strlen(str));
		    ant_xiter_status[a][atc_Ligado] = strval(split[0]);
		    ant_xiter_status[a][atc_Kikar] = strval(split[1]);
		    format(ant_xiter_status[a][atc_Nome], 100, split[2]);
		    ligar_ac();
        }
    }
    else salvar_definicoes("Atc");

    // payday //
	format(file, 60, "Server/Loteria.txt");
	if(DOF2_FileExists(file))
    {
        premio_loteria = DOF2_GetInt(file, "premio_loteria");
    }
    else salvar_definicoes("Loteria", 10000);

	// payday //
	format(file, 60, "Server/Pay_Day.txt");
	if(DOF2_FileExists(file))
    {
        payday_server = DOF2_GetInt(file, "payday_server");
    }
    else salvar_definicoes("PayDay", 5);

	// locais do rio de janeiro //
    format(file, 60, "Server/Locais_LS.txt");
    if(DOF2_FileExists(file))
    {
        for(new a; a<sizeof Local_LosSantos; a++)
        {
	    	format(str2, 80, "Local_%d", a);
		    format(str, 500, "%s", DOF2_GetString(file, str2));
		    split_linha(str, strlen(str));
		    Local_LosSantos[a][local_X] = floatstr(split[0]);
		    Local_LosSantos[a][local_Y] = floatstr(split[1]);
		    Local_LosSantos[a][local_Z] = floatstr(split[2]);
		    Local_LosSantos[a][local_Interior] = strval(split[3]);
		    Local_LosSantos[a][local_Mundo] = strval(split[4]);
		    format(Local_LosSantos[a][local_Nome], 100, split[5]);
	    }
	}
	else salvar_definicoes("Locais", 0);

	// locais de sao paulo //
    format(file, 60, "Server/Locais_SF.txt");
    if(DOF2_FileExists(file))
    {
        for(new a; a<sizeof Local_SanFierro; a++)
        {
	    	format(str2, 80, "Local_%d", a);
		    format(str, 500, "%s", DOF2_GetString(file, str2));
		    split_linha(str, strlen(str));
		    Local_SanFierro[a][local_X] = floatstr(split[0]);
		    Local_SanFierro[a][local_Y] = floatstr(split[1]);
		    Local_SanFierro[a][local_Z] = floatstr(split[2]);
		    Local_SanFierro[a][local_Interior] = strval(split[3]);
		    Local_SanFierro[a][local_Mundo] = strval(split[4]);
		    format(Local_SanFierro[a][local_Nome], 100, split[5]);
	    }
	}
	else salvar_definicoes("Locais", 1);

	// locais de minas gerais //
    format(file, 60, "Server/Locais_LV.txt");
    if(DOF2_FileExists(file))
    {
        for(new a; a<sizeof Local_LasVenturas; a++)
        {
	    	format(str2, 80, "Local_%d", a);
		    format(str, 500, "%s", DOF2_GetString(file, str2));
		    split_linha(str, strlen(str));
		    Local_LasVenturas[a][local_X] = floatstr(split[0]);
		    Local_LasVenturas[a][local_Y] = floatstr(split[1]);
		    Local_LasVenturas[a][local_Z] = floatstr(split[2]);
		    Local_LasVenturas[a][local_Interior] = strval(split[3]);
		    Local_LasVenturas[a][local_Mundo] = strval(split[4]);
		    format(Local_LasVenturas[a][local_Nome], 100, split[5]);
	    }
	}
	else salvar_definicoes("Locais", 2);
}



