		if(info < 0 || info >= MAX_VEICULOS) return ms(playerid, 0, "ID de info Invalido !");
		if(Veiculo[info][v_Existe] == 0) return ms(playerid, 0, "Esta Info nao existe !");
		if(Veiculo[info][v_Conce] != 0) return ms(playerid, 0, "Este veiculo nao teve um spawn definido, ele se encontra na garagem da concecionaria !");
		if(Veiculo[info][v_Garagem] == 0)
		{
		    new idv = Veiculo[info][v_ID];
		    format(sss, 150, "O veiculo ID: %d, Info: %d, foi respawnado com sucesso !", idv, info);
		    ms(playerid, 5, sss);
		    SetVehicleToRespawn(idv);
		}
		else
		{
		    Veiculo[info][v_Garagem] = 0;
		    spawn_veiculo(info);
		    format(sss, 150, "O veiculo ID: %d, Info: %d, foi respawnado com sucesso !", Veiculo[info][v_ID], info);
		    ms(playerid, 5, sss);
		}
