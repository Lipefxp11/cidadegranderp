stock setar_dono_gz(playerid, o)
{
	SG[0] = EOS;
	SetPVarInt(playerid, "idgzaa", o);
	strcat(SG, "Sem Dono\n");
	foreach(new a:Iter_Orgs)
	{
	    if(Org[a][o_Existe] == 1) if(TR[o][tr_Dono] == a) strcat(SG, "{00ffff}");
	    else strcat(SG, "{a1a1a1}");
	    strcat(SG, NomeOrg(a));
        strcat(SG, "\n");
	}
	ShowPlayerDialog(playerid, DIALOG_DONO_GZ, DIALOG_STYLE_LIST, TR[o][tr_Nome], SG, "Setar", "Cancelar");
}

stock setar_tipo_gz(playerid, o)
{
	SG[0] = EOS;
	SetPVarInt(playerid, "idgzaa", o);
	for(new a; a<sizeof tipo_gz; a++)
	{
	    if(TR[o][tr_Tipo] == a) strcat(SG, "{00ffff}");
	    else strcat(SG, "{a1a1a1}");
	    strcat(SG, tipo_gz[a]);
	    strcat(SG, "\n");
	}
	ShowPlayerDialog(playerid, DIALOG_TIPO_GZ, DIALOG_STYLE_LIST, TR[o][tr_Nome], SG, "Setar", "Cancelar");
}

stock esconder_gz_player(playerid)
{
	if(em_gz[playerid] != -1) em_gz[playerid] = -1;
	mostrando_gz[playerid] = 0;
	PlayerTextDrawHide(playerid, T_GZ_p[playerid][0]);
	PlayerTextDrawHide(playerid, T_GZ_p[playerid][1]);
	PlayerTextDrawHide(playerid, T_GZ_p[playerid][2]);

}

stock mostrar_gz_player(playerid, g)
{
	if(em_gz[playerid] != g) em_gz[playerid] = g;
	if(mostrando_gz[playerid] == 0)
	{
	    if(inv_novo_aberto[playerid] == 0 && celular_aberto[playerid] == -1 )
		{
		    mostrando_gz[playerid] = 1;
		    atualizar_gz_player(playerid, g);
		    PlayerTextDrawShow(playerid, T_GZ_p[playerid][0]);
			PlayerTextDrawShow(playerid, T_GZ_p[playerid][1]);
			PlayerTextDrawShow(playerid, T_GZ_p[playerid][2]);
		}
	}
}

stock atualizar_gz_player(playerid, g)
{
	if(em_gz[playerid] != g) em_gz[playerid] = g;
	if(inv_novo_aberto[playerid] != 0 || celular_aberto[playerid] != -1 || mostrando_radio[playerid] == 1)
	{
		if(mostrando_gz[playerid] == 1)
		{
			mostrando_gz[playerid] = 0;
		    PlayerTextDrawHide(playerid, T_GZ_p[playerid][0]);
			PlayerTextDrawHide(playerid, T_GZ_p[playerid][1]);
			PlayerTextDrawHide(playerid, T_GZ_p[playerid][2]);
		}
	}
	else
	{
		if(mostrando_gz[playerid] == 0) mostrar_gz_player(playerid, g);
		else
		{
			PlayerTextDrawSetString(playerid, T_GZ_p[playerid][0], f("%s_", TR[g][tr_Nome]));
			if(TR[g][tr_EmGuerra] == 1)
			{
			    SG[0] = EOS;
				strcat(SG, "~n~TERRITORIO~N~~n~~n~");
				new linha[100];
				foreach(new a:Iter_Orgs)
				{
				    if(Org[a][o_Existe] == 1)
					{
					if(TR[g][tr_OrgPontos][a] > 0 || OrgTerritorio(a, g))
					{
					    format(linha, 100, "~w~%s [~y~~h~%d~w~]~n~", NomeOrg(a), TR[g][tr_OrgPontos][a]);
					    strcat(SG, linha);
					}
				    }
				}
				strcat(SG, "~n~~p~~h~Tempo Restante: ~y~");
				strcat(SG, ConvertTime(TR[g][tr_TempoGuerra]));
			    strcat(SG, "~n~~n~");
			    PlayerTextDrawSetString(playerid, T_GZ_p[playerid][1], SG);
			    PlayerTextDrawColor(playerid, T_GZ_p[playerid][2], 0x00ffff99);
				PlayerTextDrawSetString(playerid, T_GZ_p[playerid][2], "EM GUERRA");
				PlayerTextDrawShow(playerid, T_GZ_p[playerid][2]);
			}
			else if(TR[g][tr_Dono] == -1)
			{
			    SG[0] = EOS;
				strcat(SG, "~n~DONO DO TERRITORIO~N~~n~~n~");
				if(TR[g][tr_Liberada] == 1) strcat(SG, "~g~~h~LIBERADA~n~~n~");
				else strcat(SG, "~r~BLOQUEADA~n~~n~");
				PlayerTextDrawSetString(playerid, T_GZ_p[playerid][1], SG);
				PlayerTextDrawColor(playerid, T_GZ_p[playerid][2], 0xffffff99);
				PlayerTextDrawSetString(playerid, T_GZ_p[playerid][2], "SEM DONO");
				PlayerTextDrawShow(playerid, T_GZ_p[playerid][2]);
			}
			else
			{
			    SG[0] = EOS;
				strcat(SG, "~n~DONO DO TERRITORIO~N~~n~~n~");
				if(TR[g][tr_Liberada] == 1) strcat(SG, "~g~~h~LIBERADA~n~~n~");
				else strcat(SG, "~r~BLOQUEADA~n~~n~");
			    PlayerTextDrawSetString(playerid, T_GZ_p[playerid][1], SG);
			    format(SG, 300, "%s_", NomeOrg(TR[g][tr_Dono]));
			    PlayerTextDrawColor(playerid, T_GZ_p[playerid][2], Colors[Org[TR[g][tr_Dono]][o_Cor]]-5);
			    PlayerTextDrawSetString(playerid, T_GZ_p[playerid][2], SG);
			    PlayerTextDrawShow(playerid, T_GZ_p[playerid][2]);
			}
		}
	}
}

stock OrgEmGuerra(o)
{
	if(o != -1)
	{
		for(new g; g<MAX_TERRITORIOS; g++)
		{
		    if(TR[g][tr_Existe] == 1)
		    {
	         	if(TR[g][tr_EmGuerra] == 1)
		        {
		            if(TR[g][tr_Dono] == o) return 1;
		            if(TR[g][tr_Dominando] == o) return 2;
		        }
		    }
		}
	}
	return 0;
}

stock ComecarGuerra(playerid, g)
{
	new pode = PodeDominar(playerid, g);
	if(pode == 1)
	{
		if(TR[g][tr_TempoUltimaGuerra] > 0) ms(playerid, 0, "Este territorio ainda nao se recuperou da ultima guerra, tente mais tarde !");
		else
		{
		    new org1 = OrgPlayer(playerid);
		    if(TR[g][tr_Dono] == org1) ms(playerid, 0, "Sua organizacao ja domina este territorio !");
		    else iniciar_guerra(g, org1);
		}
	}
	return 1;
}

stock PodeDominar(playerid, g)
{
	if(OrgPlayer(playerid) == -1) ms(playerid, 0, "Voce nao faz parte de uma Organizacao !");
	else if(TR[g][tr_Liberada] == 0) ms(playerid, 0, "Esta GZ nao foi liberada para dominio por um administrador !");
	else if(OrgPlayer(playerid) == TR[g][tr_Dono]) ms(playerid, 0, "Sua Organizacao ja esta no controle desse Territorio !");
	else if(OrgCop(OrgPlayer(playerid)) && OrgCop(TR[g][tr_Dono])) ms(playerid, 0, "Este Territorio ja esta Pacificado pela policia !");
	else
	{
		if(TR[g][tr_Existe] == 1)
		{
		    // faccao //
	     	if(TR[g][tr_Tipo] == 1)
		    {
	            if(PlayerFac(playerid) || PlayerCop(playerid, 0)) return 1;
				else ms(playerid, 0, "Sua organizacao nao pode dominar este tipo de Territorio !");
		    }

		    // mafia //
	     	if(TR[g][tr_Tipo] == 2)
		    {
	            if(PlayerMafia(playerid) || PlayerCop(playerid, 8)) return 1;
				else ms(playerid, 0, "Sua organizacao nao pode dominar este tipo de Territorio !");
		    }

		    // terrorista //
	     	if(TR[g][tr_Tipo] == 3)
		    {
	            if(PlayerTerrorista(playerid) || PlayerCop(playerid, 1)) return 1;
				else ms(playerid, 0, "Sua organizacao nao pode dominar este tipo de Territorio !");
		    }
		}
	}
	return 0;
}

stock iniciar_guerra(g, o)
{
	if(TR[g][tr_Existe] == 1)
	{
		new sss[300];
		new antigo_dono = TR[g][tr_Dono];
		if(antigo_dono == -1)
		{
			TR[g][tr_Dono] = o;
			TR[g][tr_EmGuerra] = 0;
			TR[g][tr_TempoGuerra] = 0;
			TR[g][tr_TempoUltimaGuerra] = 15*60;
			format(sss, 300, "[TERRITORIO] A organizacao '%s' dominou territorio '%s'.", NomeOrg(o), TR[g][tr_Nome]);
			mso(o, "Voces dominaram este territorio sem dono.");
			mstr(g, sss);
			salvar_gz(g);
			atualizar_gz(g);
		}
		else
		{
			if(TR[g][tr_EmGuerra] == 0)
			{
				TR[g][tr_EmGuerra] = 1;
				TR[g][tr_TempoGuerra] = 10*60;
				for(new or; or<MAX_ORGS; or++)
				{
					TR[g][tr_OrgPontos][or] = 0;
				}
			}
			format(sss, 300, "[TERRITORIO] A Org '%s' entrou na guerra pelo territorio '%s'.", NomeOrg(o), TR[g][tr_Nome]);
			mstr(g, sss);
			atualizar_gz(g);
		}
	}
}


stock finalizar_guerra(g)
{
	if(TR[g][tr_Existe] == 1)
	{
	    TR[g][tr_Liberada] = 0;
	    if(TR[g][tr_EmGuerra] == 1)
	    {
	        TR[g][tr_EmGuerra] = 0;
	        TR[g][tr_TempoGuerra] = 0;
	        TR[g][tr_TempoUltimaGuerra] = 15*60;

	        new sss[300];
	        new dono = -1, maior_pontos = -1, empate = 0;
	        for(new or; or<MAX_ORGS; or++)
	        {
	            if(TR[g][tr_OrgPontos][or] > maior_pontos)
	            {
	                maior_pontos = TR[g][tr_OrgPontos][or];
	                dono = or;
	                empate = 0;
	            }
	            else if(TR[g][tr_OrgPontos][or] == maior_pontos && maior_pontos > 0)
	            {
	                empate = 1;
	            }
	        }

	        if(empate == 1 || dono == -1)
	        {
	            TR[g][tr_Dono] = -1;
	            format(TR[g][tr_Data], 100, "%02d/%02d/%02d - %02d:%02d", 0,0,0,0,0);
	       		format(sss, 300, "[TERRITORIO] Ouve um empate, e o territorio '%s' ficou sem dono.", TR[g][tr_Nome]);
	        }
	        else
	        {
	            TR[g][tr_Dono] = dono;
                format(TR[g][tr_Data], 100, "%02d/%02d/%02d - %02d:%02d", DIA, MES, ANO, HORA, MINUTO);
	            format(sss, 300, "[TERRITORIO] A organizacao '%s' dominou o territorio '%s' com %d pontos.", NomeOrg(dono), TR[g][tr_Nome], maior_pontos);
			}
			mstr(g, sss);
			salvar_gz(g);
	       	atualizar_gz(g);
	    }
	}
}

stock OrgTerritorio(o, g)
{
	if(TR[g][tr_Tipo] == 1) if(OrgFac(o) || OrgCop(o, 0)) return 1;
	if(TR[g][tr_Tipo] == 2) if(OrgMafia(o) || OrgCop(o, 8)) return 1;
	if(TR[g][tr_Tipo] == 3) if(OrgTerrorista(o) || OrgCop(o, 1)) return 1;
	return 0;
}

stock mstr(g, const texto[])
{
	// faccao //
	if(TR[g][tr_Tipo] == 1)
	{
		foreach(new a:Player)
		{
		    if(Online(a))
		    {
		        if(id[a] != -1)
		        {
		            if(PlayerFac(a) || PlayerCop(a, 0))
		            {
		                ms(a, 0xB0C4DEff, texto);
		            }
		        }
		    }
		}
	}

	// mafia //
	if(TR[g][tr_Tipo] == 2)
	{
        foreach(new a:Player)
		{
		    if(Online(a))
		    {
		        if(id[a] != -1)
		        {
		            if(PlayerMafia(a) || PlayerCop(a, 8))
		            {
		                ms(a, 0xB0C4DEff, texto);
		            }
		        }
			}
		}
	}

	// terrorista //
	if(TR[g][tr_Tipo] == 3)
	{
        foreach(new a:Player)
		{
		    if(Online(a))
		    {
		        if(id[a] != -1)
		        {
		            if(PlayerTerrorista(a) || PlayerCop(a, 1))
		            {
		                ms(a, 0xB0C4DEff, texto);
		            }
		        }
			}
		}
	}
}

stock fechar_criar_conta_lobby(playerid)
{
    if(CriarConta[playerid][cc_Criando] == 1)
	{
	    CriarConta[playerid][cc_Criando] = 0;
	    // esconder textdraws //
	    for(new a; a<sizeof T_CC; a++) TextDrawHideForPlayer(playerid, T_CC[a]);
		for(new a; a<sizeof T_CC_Sexo; a++) TextDrawHideForPlayer(playerid, T_CC_Sexo[a]);
		for(new a; a<sizeof T_CC_Skin; a++) TextDrawHideForPlayer(playerid, T_CC_Skin[a]);
		for(new a; a<sizeof T_CC_Idade; a++) TextDrawHideForPlayer(playerid, T_CC_Idade[a]);
		for(new a; a<sizeof T_CC_Cidade; a++) TextDrawHideForPlayer(playerid, T_CC_Cidade[a]);
		for(new a; a<sizeof T_CC_Nick; a++) TextDrawHideForPlayer(playerid, T_CC_Nick[a]);
		for(new a; a<sizeof T_CC_Senha; a++) TextDrawHideForPlayer(playerid, T_CC_Senha[a]);
		PlayerTextDrawDestroy(playerid, T_CC_Nick_p[playerid][0]);
		PlayerTextDrawDestroy(playerid, T_CC_Senha_p[playerid][0]);
		PlayerTextDrawDestroy(playerid, T_CC_Skin_p[playerid][0]);
		PlayerTextDrawDestroy(playerid, T_CC_Idade_p[playerid][0]);
		PlayerTextDrawDestroy(playerid, T_CC_Cidade_p[playerid][0]);
		PlayerTextDrawDestroy(playerid, T_CC_Cidade_p[playerid][1]);
		PlayerTextDrawDestroy(playerid, T_CC_Cidade_p[playerid][2]);
		PlayerTextDrawDestroy(playerid, T_CC_p[playerid][0]);
	}
}

stock criar_conta_lobby(playerid)
{
    if(CriarConta[playerid][cc_Criando] == 0)
	{
	    logado[playerid] = 999;
	    CriarConta[playerid][cc_Criando] = 1;
	    CriarConta[playerid][cc_MostrarSenha] = 0;
	    CriarConta[playerid][cc_Skin] = 0;
	    CriarConta[playerid][cc_Sexo] = -1;
	    CriarConta[playerid][cc_Idade] = 18;
	    CriarConta[playerid][cc_Cidade] = -1;
	    format(CriarConta[playerid][cc_Nick], MAX_PLAYER_NAME, "nada");
	    format(CriarConta[playerid][cc_Senha], 15, "nada123");
	    CC_Etapa[playerid] = 0;
	    for(new z; z<sizeof Nome_Etapas; z++) CC_Etapas[playerid][z] = 0;
	}
	SetPlayerInterior(playerid, 3);
	SetPlayerVirtualWorld_(playerid, playerid+1);
	atualizar_criar_conta(playerid);
}

stock atualizar_criar_conta(playerid, con=0)
{
	if(CriarConta[playerid][cc_Criando] == 1)
	{
	    if(con == 1)
	    {
	        CC_Etapas[playerid][CC_Etapa[playerid]] = 1;
	        CC_Etapa[playerid] ++;
	    }

	    new strtt[300];
		for(new z; z<sizeof Nome_Etapas; z++)
		{
		    if(CC_Etapas[playerid][z] == 0) strcat(strtt, "_");
		    else strcat(strtt, "OK");
		    strcat(strtt, "~n~");
		}
		PlayerTextDrawSetString(playerid, T_CC_p[playerid][0], strtt);

		// esconder textdraws //
		for(new a; a<sizeof T_CC_Sexo; a++) TextDrawHideForPlayer(playerid, T_CC_Sexo[a]);
		for(new a; a<sizeof T_CC_Skin; a++) TextDrawHideForPlayer(playerid, T_CC_Skin[a]);
		for(new a; a<sizeof T_CC_Idade; a++) TextDrawHideForPlayer(playerid, T_CC_Idade[a]);
		for(new a; a<sizeof T_CC_Cidade; a++) TextDrawHideForPlayer(playerid, T_CC_Cidade[a]);
		for(new a; a<sizeof T_CC_Nick; a++) TextDrawHideForPlayer(playerid, T_CC_Nick[a]);
		for(new a; a<sizeof T_CC_Senha; a++) TextDrawHideForPlayer(playerid, T_CC_Senha[a]);
		PlayerTextDrawHide(playerid, T_CC_Nick_p[playerid][0]);
		PlayerTextDrawHide(playerid, T_CC_Senha_p[playerid][0]);
		PlayerTextDrawHide(playerid, T_CC_Skin_p[playerid][0]);
		PlayerTextDrawHide(playerid, T_CC_Idade_p[playerid][0]);
		PlayerTextDrawHide(playerid, T_CC_Cidade_p[playerid][0]);
		PlayerTextDrawHide(playerid, T_CC_Cidade_p[playerid][1]);
		PlayerTextDrawHide(playerid, T_CC_Cidade_p[playerid][2]);

		new Float:poscc[3];
        GetPlayerCameraPos(playerid, poscc[0], poscc[1], poscc[2]);

		// escolher sexo //
		if(CC_Etapa[playerid] == 0)
		{
            if(IsValidDynamicActor(actor_conta[playerid])) DestroyDynamicActor_(actor_conta[playerid]);
		    for(new a; a<sizeof T_CC_Sexo; a++) TextDrawShowForPlayer(playerid, T_CC_Sexo[a]);
		    CriarConta[playerid][cc_Skin] = 0;
		    if(CriarConta[playerid][cc_Sexo] != -1)
		    {
		    	actor_conta[playerid] = CreateDynamicActor(skins_contas[CriarConta[playerid][cc_Sexo]][CriarConta[playerid][cc_Skin]], 1038.8840,0.5544,1001.2845,85.3431, 1, 100.0, playerid+1, 3, -1, STREAMER_ACTOR_SD, -1, 0);
                ApplyDynamicActorAnimation(actor_conta[playerid], "PED","SEAT_idle", 25.0, 0, 0, 0, 1, 0);
		        Streamer_Update(playerid);
				if(CriarConta[playerid][cc_Sexo] == 0)
				{
				TextDrawHideForPlayer(playerid, T_CC_Sexo[1]);
				TextDrawHideForPlayer(playerid, T_CC_Sexo[6]);
				}
				else if(CriarConta[playerid][cc_Sexo] == 1)
				{
				    TextDrawHideForPlayer(playerid, T_CC_Sexo[2]);
				TextDrawHideForPlayer(playerid, T_CC_Sexo[5]);
				}
			}
			else
			{
			    TextDrawHideForPlayer(playerid, T_CC_Sexo[5]);
		        TextDrawHideForPlayer(playerid, T_CC_Sexo[6]);
		    }

			InterpolateCameraPos(playerid,  1036.9847, -0.5999, 1001.2845, 1036.9847, -0.5999, 1001.2845, 2000, CAMERA_MOVE );
			InterpolateCameraLookAt(playerid, 1038.8840,0.5544,1001.2845,  1038.8840,0.5544,1001.2845, 2000,  CAMERA_MOVE );
		}

		// escolher skin //
		if(CC_Etapa[playerid] == 1)
		{
		    if(IsValidDynamicActor(actor_conta[playerid])) DestroyDynamicActor_(actor_conta[playerid]);
		  	actor_conta[playerid] = CreateDynamicActor(skins_contas[CriarConta[playerid][cc_Sexo]][CriarConta[playerid][cc_Skin]], 1038.8840,0.5544,1001.2845,85.3431, 1, 100.0, playerid+1, 3, -1, STREAMER_ACTOR_SD, -1, 0);
			ApplyDynamicActorAnimation(actor_conta[playerid], "PED","SEAT_idle", 25.0, 0, 0, 0, 1, 0);
			Streamer_Update(playerid);
			if(con == 1)
			{
		        InterpolateCameraPos(playerid,  1036.9847, -0.5999, 1001.2845, 1036.9847, -0.5999, 1001.2845, 2000, CAMERA_MOVE );
				InterpolateCameraLookAt(playerid, 1038.8840,0.5544,1001.2845,  1038.8840,0.5544,1001.2845, 2000,  CAMERA_MOVE );
			}
			format(strtt, 100, "%d / %d", CriarConta[playerid][cc_Skin]+1, 5);
            PlayerTextDrawSetString(playerid, T_CC_Skin_p[playerid][0], strtt);
            for(new a; a<sizeof T_CC_Skin; a++) TextDrawShowForPlayer(playerid, T_CC_Skin[a]);
            PlayerTextDrawShow(playerid, T_CC_Skin_p[playerid][0]);
		}

		// escolher idade //
		if(CC_Etapa[playerid] == 2)
		{
		    if(con == 1)
			{
			    InterpolateCameraPos(playerid,  1036.9847, -0.5999, 1001.2845, 1036.9847, -0.5999, 1001.2845, 2000, CAMERA_MOVE );
				InterpolateCameraLookAt(playerid, 1038.8840,0.5544,1001.2845,  1038.8840,0.5544,1001.2845, 2000,  CAMERA_MOVE );
			}
			format(strtt, 100, "%d", CriarConta[playerid][cc_Idade]);
            PlayerTextDrawSetString(playerid, T_CC_Idade_p[playerid][0], strtt);
            for(new a; a<sizeof T_CC_Idade; a++) TextDrawShowForPlayer(playerid, T_CC_Idade[a]);
            PlayerTextDrawShow(playerid, T_CC_Idade_p[playerid][0]);
		}

		// escolher cidade //
		if(CC_Etapa[playerid] == 3)
		{
		    if(con == 1)
			{
			    InterpolateCameraPos(playerid,  1036.9847, -0.5999, 1001.2845, 1036.9847, -0.5999, 1001.2845, 2000, CAMERA_MOVE );
				InterpolateCameraLookAt(playerid, 1038.8840,0.5544,1001.2845,  1038.8840,0.5544,1001.2845, 2000,  CAMERA_MOVE );
			}
		    if(CriarConta[playerid][cc_Cidade] == 0) PlayerTextDrawBoxColor(playerid, T_CC_Cidade_p[playerid][0], 0x00ffff50);
		    else PlayerTextDrawBoxColor(playerid, T_CC_Cidade_p[playerid][0], 0x00000050);
		    if(CriarConta[playerid][cc_Cidade] == 1) PlayerTextDrawBoxColor(playerid, T_CC_Cidade_p[playerid][1], 0x00ffff50);
		    else PlayerTextDrawBoxColor(playerid, T_CC_Cidade_p[playerid][1], 0x00000050);
		    if(CriarConta[playerid][cc_Cidade] == 2) PlayerTextDrawBoxColor(playerid, T_CC_Cidade_p[playerid][2], 0x00ffff50);
		    else PlayerTextDrawBoxColor(playerid, T_CC_Cidade_p[playerid][2], 0x00000050);
		    for(new a; a<sizeof T_CC_Cidade; a++) TextDrawShowForPlayer(playerid, T_CC_Cidade[a]);
		    PlayerTextDrawShow(playerid, T_CC_Cidade_p[playerid][0]);
		    PlayerTextDrawShow(playerid, T_CC_Cidade_p[playerid][1]);
		    PlayerTextDrawShow(playerid, T_CC_Cidade_p[playerid][2]);
		}

		// escolher nick //
		if(CC_Etapa[playerid] == 4)
		{
		    if(Comparar(CriarConta[playerid][cc_Nick], "nada")) format(strtt, 300, "~R~~H~NAO INFORMADO !");
			else format(strtt, 300, "~w~%s_", CriarConta[playerid][cc_Nick]);
			for(new a; a<sizeof T_CC_Nick; a++) TextDrawShowForPlayer(playerid, T_CC_Nick[a]);
			PlayerTextDrawSetString(playerid, T_CC_Nick_p[playerid][0], strtt);
			PlayerTextDrawShow(playerid, T_CC_Nick_p[playerid][0]);
			InterpolateCameraPos(playerid,  1036.9847, -0.5999, 1001.2845, 1036.9847, -0.5999, 1001.2845, 2000, CAMERA_MOVE );
			InterpolateCameraLookAt(playerid, 1038.8840,0.5544,1001.2845,  1038.8840,0.5544,1001.2845, 2000,  CAMERA_MOVE );
		}

		// escolher senha //
		if(CC_Etapa[playerid] == 5)
		{
			if(Comparar(CriarConta[playerid][cc_Senha], "nada123")) format(strtt, 300, "~R~~H~NAO INFORMADO !");
			else
			{
			    if(CriarConta[playerid][cc_MostrarSenha] == 1) format(strtt, 300, "~w~%s_", CriarConta[playerid][cc_Senha]);
			    else
				{
				    strtt[0] = EOS;
					for(new a; a<strlen(CriarConta[playerid][cc_Senha]); a++) strcat(strtt, "#");
				}
			}
			for(new a; a<sizeof T_CC_Senha; a++) TextDrawShowForPlayer(playerid, T_CC_Senha[a]);
			PlayerTextDrawSetString(playerid, T_CC_Senha_p[playerid][0], strtt);
			PlayerTextDrawShow(playerid, T_CC_Senha_p[playerid][0]);
		}

	 	for(new a; a<sizeof T_CC; a++) TextDrawShowForPlayer(playerid, T_CC[a]);
		PlayerTextDrawShow(playerid, T_CC_p[playerid][0]);
	    SelectTextDraw(playerid, 0x00ffff90);
	}
}



stock terminar_conta(playerid)
{
    if(IsValidDynamicActor(actor_conta[playerid])) DestroyDynamicActor_(actor_conta[playerid]);
    if(!VerificarNick(CriarConta[playerid][cc_Nick]))
    {
        CC_Etapa[playerid] = 4;
        atualizar_criar_conta(playerid);
        ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}.", "\n{ff0000}[ERRO] {a1a1a1}Este nick nao responde aos requisitos !\n", "Ok", "Fechar");
        return 1;
    }

    

    new cc = criar_conta(CriarConta[playerid][cc_Nick], CriarConta[playerid][cc_Cidade], CriarConta[playerid][cc_Sexo], CriarConta[playerid][cc_Idade], CriarConta[playerid][cc_Skin], CriarConta[playerid][cc_Senha], -1);
	if(cc != -1)
	{
	    
	    // stop na musica //
	    if(carregou_texts[playerid] == 0) CriarTextDrawsPlayer(playerid);
	    for(new a; a<4; a++) TextDrawShowForPlayer(playerid, T_CarregandoConta[a]);
	    fechar_criar_conta_lobby(playerid);
		contas[playerid] = cc;
		setar_lobby(playerid);
	    format(sss_cc[playerid], 500, "\n\n\
		{ffffff}Conta ID: {00ffff}%d {ffffff}criada com sucesso.\n\n\
		{a1a1a1}Nick: {ffffff}%s\n\
		{a1a1a1}Senha: '{ffff00}%s{a1a1a1}'\n\n\
		{ffff00}[INFO] {a1a1a1}Guarde bem essas informacoes, elas serao\n\
		nescessarias na Hora de logar no servidor !\n\
		Recomendamos que tire uma PRINT da tela agora mesmo.\n\n", cc, NomeConta(cc), GetContaString(cc, "c_Senha"));
	    mostrar_info_conta_lobby[playerid] = 1;
	}
	else
	{
	    fechar_criar_conta_lobby(playerid);
	    mostrar_login(playerid);
		ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}.", "\n{ff0000}[ERRO] {a1a1a1}Numero maximo de Contas no servidor atingido !\n", "Ok", "Fechar");
	}
	return 1;
}

stock mostrar_ajuda_respawn(playerid)
