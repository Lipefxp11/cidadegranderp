	if(!strcmp(cmd, "/placa", true))
	{
		new sss[300];
		new Float:pos[3];
		foreach(new i:Vehicles)
		{
		    if(GetVehicleModel(i) != 0)
		    {
		        GetVehiclePos(i, pos[0], pos[1], pos[2]);
	            if(IsPlayerInRangeOfPoint(playerid, 4, pos[0], pos[1], pos[2]))
	            {
	                new vv = Info_Veiculo[i];
	                if(vv == -1)
	                {
	                    ms(playerid, 0, "Este veiculo nao possui informacoes !");
	                    return 1;
	                }

	                SG[0] = EOS;
	                format(sss, 300, "\n\n{ffffff}Info: {00ffff}%d\n", vv);
	                strcat(SG, sss);
	                format(sss, 300, "{ffffff}Placa: {a1a1a1}%s\n", PlacaVeiculo[vv]);
	                strcat(SG, sss);
	                if(Veiculo[vv][v_Dono] != -1) format(sss, sizeof(sss),  "{ffffff}Dono: {ffff00}%s\n\n\n", NomeConta(Veiculo[vv][v_Dono]));
	                else if(Veiculo[vv][v_Emprego] != -1) format(sss, sizeof(sss),  "{ffffff}Emprego: {ffff00}%s\n\n\n", Emprego[Veiculo[vv][v_Emprego]][e_Nome]);
	                else if(Veiculo[vv][v_Org] != -1) format(sss, sizeof(sss),  "{ffffff}Organizacao: {ffff00}%s\n\n\n", Org[Veiculo[vv][v_Org]][o_Nome]);
	                strcat(SG, sss);
	                ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Informacoes do Veiculo", SG, "Ok", "Fechar");
					return 1;
	            }
		    }
		}

		foreach(new v:Iter_Veiculos)
		{
		    if(Veiculo[v][v_Existe] == 1)
		    {
		        new veh = Veiculo[v][v_ID];
		        new ta;

		        if(Veiculo[v][v_Garagem] == 1 || GetVehicleModel(veh) == 0)
		        {
		            if(IsPlayerInRangeOfPoint(playerid, 3, Veiculo[v][v_X], Veiculo[v][v_Y], Veiculo[v][v_Z])) ta = 1;
		        }
		        else
		        {
		            GetVehiclePos(veh, pos[0], pos[1], pos[2]);
		            if(GetVehicleVirtualWorld(veh) == GetPlayerVirtualWorld_(playerid))
		        	{
		                if(IsPlayerInRangeOfPoint(playerid, 4, pos[0], pos[1], pos[2])) ta = 1;
		            }
		        }

		        if(ta == 1)
		        {
		    	    SG[0] = EOS;
		            format(sss, 300, "\n\n{ffffff}Info: {00ffff}%d\n", v);
		            strcat(SG, sss);
		            format(sss, 300, "{ffffff}Placa: {a1a1a1}%s\n", PlacaVeiculo[v]);
		            strcat(SG, sss);
		            if(Veiculo[v][v_Dono] != -1) format(sss, sizeof(sss),  "{ffffff}Dono: {ffff00}%s\n\n\n", NomeConta(Veiculo[v][v_Dono]));
		            else if(Veiculo[v][v_Emprego] != -1) format(sss, sizeof(sss),  "{ffffff}Emprego: {ffff00}%s\n\n\n", Emprego[Veiculo[v][v_Emprego]][e_Nome]);
		            else if(Veiculo[v][v_Org] != -1) format(sss, sizeof(sss),  "{ffffff}Organizacao: {ffff00}%s\n\n\n", Org[Veiculo[v][v_Org]][o_Nome]);
		            strcat(SG, sss);
		            ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Informacoes do Veiculo", SG, "Ok", "Fechar");
					return 1;
		        }
		    }
		}
		ms(playerid, 0, "Voce nao esta proximo a um veiculo !");
		return 1;
	}

    if(!strcmp(cmd, "/neon", true))
