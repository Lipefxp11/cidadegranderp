			format(sssa, 100, "~n~DESCONECTADO");
			TextDrawHideForPlayer(playerid, T_Celular_Blu_APK[4]);
		}
		else if(Blutuf_Tipo[playerid] == 0)
		{
			format(sssa, 100, "CONECTADO~N~~y~~H~VEICULO");
			TextDrawHideForPlayer(playerid, T_Celular_Blu_APK[3]);
		}
		else if(Blutuf_Tipo[playerid] == 1)
		{
			format(sssa, 100, "CONECTADO~N~~g~~H~JBL");
			TextDrawHideForPlayer(playerid, T_Celular_Blu_APK[3]);
		}

		PlayerTextDrawSetString(playerid, T_Celular_Blu_APK_p[playerid][0], sssa);
	    PlayerTextDrawShow(playerid, T_Celular_Blu_APK_p[playerid][0]);
	    return 1;
	}

    // caixa //
	if(con == C_CAIXA_ABRINDO)
	{
	    celular_aberto[playerid] = C_CAIXA_ABRINDO;
	    for(new b; b<sizeof T_Celular_CAIXA_Carregando; b++) TextDrawShowForPlayer(playerid, T_Celular_CAIXA_Carregando[b]);
	    timer_celular[playerid] = SetTimerEx("TimerCelular", 1250, false, "dd", playerid, C_CAIXA);
		return 1;
	}
	if(con == C_CAIXA)
	{
        celular_aberto[playerid] = C_CAIXA;
        for(new b; b<sizeof T_Celular_CAIXA_APK; b++) TextDrawShowForPlayer(playerid, T_Celular_CAIXA_APK[b]);
