		DOF2_SetFloat(file, "p_RY2", Portao[i][p_RY2]);
		DOF2_SetFloat(file, "p_RZ2", Portao[i][p_RZ2]);
		DOF2_SaveFile();
    }
}



stock CriarObjeto(model, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz, inte=0, mundo=0)
{
	new p = -1;
	for(new i; i<MAX_OBJETOS; i++)
	{
	    if(Objeto[i][o_Existe] == 0)
	    {
	        Objeto[i][o_Existe] = 1;
	        Objeto[i][o_Modelo] = model;
	        Objeto[i][o_X] = x;
	        Objeto[i][o_Y] = y;
	        Objeto[i][o_Z] = z;
	        Objeto[i][o_RX] = rx;
	        Objeto[i][o_RY] = ry;
	        Objeto[i][o_RZ] = rz;
	        Objeto[i][o_Mundo] = mundo;
	        Objeto[i][o_Interior] = inte;
	        atualizar_objeto(i);
	        p = i;
	        break;
	    }
	}
	return p;
}

stock atualizar_objeto(i)
{
	Iter_Remove(Iter_Objetos, i);
	if(IsValidDynamicObject(Objeto[i][o_Obj])) DestroyDynamicObject_(Objeto[i][o_Obj]);
	if(Objeto[i][o_Existe] == 1)
	{
	    Iter_Add(Iter_Objetos, i);
	    Objeto[i][o_Obj] = CreateDynamicObject(Objeto[i][o_Modelo], Objeto[i][o_X], Objeto[i][o_Y], Objeto[i][o_Z], Objeto[i][o_RX], Objeto[i][o_RY], Objeto[i][o_RZ], Objeto[i][o_Mundo], Objeto[i][o_Interior], -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
	    if(Objeto[i][o_MatModel] != 0)
	        SetDynamicObjectMaterial(Objeto[i][o_Obj], 0, Objeto[i][o_MatModel], Objeto[i][o_MatTxd], Objeto[i][o_MatTex], Objeto[i][o_MatColor]);
	}
}

stock destruir_objeto(i)
{
    new file[80];
    format(file, 80, "Objetos/Objeto_%d.txt", i);
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
	Objeto[i][o_Existe] = 0;
	atualizar_objeto(i);
}

stock salvar_objeto(i)
{
    new file[80];
    format(file, 80, "Objetos/Objeto_%d.txt", i);
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
    if(Objeto[i][o_Existe] == 1)
    {
        DOF2_CreateFile(file);
        DOF2_SetInt(file, "o_Modelo", Objeto[i][o_Modelo]);
		DOF2_SetFloat(file, "o_X", Objeto[i][o_X]);
		DOF2_SetFloat(file, "o_Y", Objeto[i][o_Y]);
		DOF2_SetFloat(file, "o_Z", Objeto[i][o_Z]);
		DOF2_SetFloat(file, "o_RX", Objeto[i][o_RX]);
		DOF2_SetFloat(file, "o_RY", Objeto[i][o_RY]);
		DOF2_SetFloat(file, "o_RZ", Objeto[i][o_RZ]);
		DOF2_SetInt(file, "o_Mundo", Objeto[i][o_Mundo]);
		DOF2_SetInt(file, "o_Interior", Objeto[i][o_Interior]);
		DOF2_SetInt(file, "o_MatModel", Objeto[i][o_MatModel]);
		DOF2_SetString(file, "o_MatTxd", Objeto[i][o_MatTxd]);
		DOF2_SetString(file, "o_MatTex", Objeto[i][o_MatTex]);
		DOF2_SetInt(file, "o_MatColor", Objeto[i][o_MatColor]);
		DOF2_SaveFile();
    }
}

BCG:: carregar_objetos()
{
    new file[80], cont;
    DOF2_CreateFile("Objetos/_init.txt");
    for(new i; i<MAX_OBJETOS; i++)
    {
        Objeto[i][o_Obj] = INVALID_OBJECT_ID;
        Objeto[i][o_MatModel] = 0;
		format(file, 80, "Objetos/Objeto_%d.txt", i);
	    if(DOF2_FileExists(file))
		{
		    Objeto[i][o_Existe] = 1;
		    Objeto[i][o_Modelo] = DOF2_GetInt(file, "o_Modelo");
		    Objeto[i][o_X] = DOF2_GetFloat(file, "o_X");
		    Objeto[i][o_Y] = DOF2_GetFloat(file, "o_Y");
		    Objeto[i][o_Z] = DOF2_GetFloat(file, "o_Z");
		    Objeto[i][o_RX] = DOF2_GetFloat(file, "o_RX");
		    Objeto[i][o_RY] = DOF2_GetFloat(file, "o_RY");
		    Objeto[i][o_RZ] = DOF2_GetFloat(file, "o_RZ");
		    Objeto[i][o_Mundo] = DOF2_GetInt(file, "o_Mundo");
		    Objeto[i][o_Interior] = DOF2_GetInt(file, "o_Interior");
		    Objeto[i][o_MatModel] = DOF2_GetInt(file, "o_MatModel");
		    format(Objeto[i][o_MatTxd], 32, "%s", DOF2_GetString(file, "o_MatTxd"));
		    format(Objeto[i][o_MatTex], 32, "%s", DOF2_GetString(file, "o_MatTex"));
		    Objeto[i][o_MatColor] = DOF2_GetInt(file, "o_MatColor");
			atualizar_objeto(i);
	        cont ++;
		}
	}
	printf("** %d Objetos carregados.", cont);
}

stock abrir_portao(playerid, i)
{
	if(Portao[i][p_Existe] == 1)
	{
		if(Portao[i][p_Org] == -1)
		{
		    if(Portao[i][p_Aberto] == 0)
		    {
		        Portao[i][p_Aberto] = 1;
		        texto_portao(i);
	         	MoveDynamicObject(Portao[i][p_Obj], Portao[i][p_X2], Portao[i][p_Y2], Portao[i][p_Z2], 2.0, Portao[i][p_RX2], Portao[i][p_RY2], Portao[i][p_RZ2]);
				SetTimerEx("fechar_portao", 5000, false, "d", i);
			}
			else if(Portao[i][p_Aberto] == 1)
			{
			    ms(playerid, 0, "Este portao ja esta aberto !");
			}
			else if(Portao[i][p_Aberto] == 2)
			{
			    ms(playerid, 0, "Este portao esta danificado !");
			}
		}
		else
		{
			if(Portao[i][p_Cargo] > Conta[playerid][c_Cargo]) ms(playerid, 0, f("Voce precisa ser '%s' para abrir este portao", nome_cargo(Portao[i][p_Cargo], Portao[i][p_Org])));
			else
			{
				if(Portao[i][p_Aberto] == 0)
				{
				Portao[i][p_Aberto] = 1;
				texto_portao(i);
		         	MoveDynamicObject(Portao[i][p_Obj], Portao[i][p_X2], Portao[i][p_Y2], Portao[i][p_Z2], 2.0, Portao[i][p_RX2], Portao[i][p_RY2], Portao[i][p_RZ2]);
					SetTimerEx("fechar_portao", 5000, false, "d", i);
				}
				else if(Portao[i][p_Aberto] == 1)
				{
				    ms(playerid, 0, "Este portao ja esta aberto !");
				}
				else if(Portao[i][p_Aberto] == 2)
				{
				    ms(playerid, 0, "Este portao esta danificado !");
				}	
			}		
		}
	}
}

BCG:: fechar_portao2(i)
{
    if(Portao[i][p_Existe] == 1)
	{
	    if(Portao[i][p_Aberto] == 1)
	    {
	        Portao[i][p_Aberto] = 0;
	        texto_portao(i);
	    }
	}
}

BCG:: fechar_portao(i)
{
	if(Portao[i][p_Existe] == 1)
	{
	    if(Portao[i][p_Aberto] == 1)
	    {
	    	MoveDynamicObject(Portao[i][p_Obj], Portao[i][p_X1], Portao[i][p_Y1], Portao[i][p_Z1], 2.0, Portao[i][p_RX1], Portao[i][p_RY1], Portao[i][p_RZ1]);
			SetTimerEx("fechar_portao2", 3000, false, "d", i);
		}
	}
}

stock verificar_portao(playerid, i)
{
	if(Portao[i][p_Existe] == 1)
	{
		if(ModoAdmin[playerid] == 1)
		{
			return 1;		
		}
		
		if(Portao[i][p_Emprego] != -1)
		{
			if(EmpregoPlayer(playerid) != Portao[i][p_Emprego])
			{
			    return 0;
			}
		}

		if(Portao[i][p_Org] != -1)
		{
			if(OrgPlayer(playerid) != Portao[i][p_Org])
			{
			    return 0;
			}
		}

		if(Portao[i][p_Dono] != -1)
		{
		    new c = id[playerid];
		    if(c == -1) return 0;
			if(c != Portao[i][p_Dono])
			{
			    return 0;
			}
		}

		return 1;
	}
	return 0;
}

stock mostrar_skins_ls(playerid)
{
 	max_menu[playerid] = sizeof(Skins_LS);
	menu_id[playerid] = MENU_SKINS_LS;
	escolhendo_menu[playerid] = 0;
	format(nome_menu[playerid], 100, "Menu de SKins LS");
	format(botao_menu[playerid], 100, "COMPRAR");
	for(new i; i<max_menu[playerid]; i++)
	{
	    if(i < MAX_MENU)
	    {
		    Menu[playerid][i][menu_ID] = 57;
		    Menu[playerid][i][menu_Unidades] = 1;
		    Menu[playerid][i][menu_Tipo] = Skins_LS[i];
		    Menu[playerid][i][menu_Valor] = 500;
		    format(Menu[playerid][i][menu_Nome], 200, "%d - Skin ID: %d", i, Skins_LS[i]);
		    format(Menu[playerid][i][menu_Info], 200, "~w~ Valor: ~g~R$ %s", ConvertMoney(Menu[playerid][i][menu_Valor]));
		    Menu[playerid][i][menu_Modelo] = Skins_LS[i];
	    }
	}
	mostrar_menu(playerid, menu_id[playerid]);
}

