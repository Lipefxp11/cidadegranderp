				new skin_id2 = strval(inputtext);
				if(skin_id2 < 0 || skin_id2 > 311) { ms(playerid, 0, "Skin invalida (0-311) !"); return 1; }
				for(new h; h<10; h++) Org[def_org][o_Skins][h] = skin_id2;
				salvar_org(def_org);
				ms(playerid, 1, "Skin definida para todos os cargos da organizacao !");
