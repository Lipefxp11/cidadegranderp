stock VR_TipoCNH(i)
{
    switch(i)
    {
        case 0: return 2; // Gas - Carro
        case 16: return 1; // iFood - Moto
        case 1: return 2; // Uber - Carro
        case 2: return 3; // Sedex - Caminhao
        case 4: return 2; // Lenhador - Carro/Caminhao
        case 5: return 3; // Minerador - Caminhao
        case 6: return 3; // Carro Forte - Caminhao
        case 7: return 2; // Entregador - Carro
        case 8: return 3; // Lixeiro - Caminhao
        case 10: return 3; // Caminhoneiro - Caminhao
        case 11: return 3; // Coletor - Caminhao
    }
    return 0;
}

stock bool:VR_PrecisaCNH(i) { return VR_TipoCNH(i) != 0; }

stock bool:VR_TemCNH(playerid, i)
{
    new tipo = VR_TipoCNH(i);
    if(tipo == 0) return true;
    new c = id[playerid]; if(c == -1) return false;
    // c_H[0]=Moto, c_H[1]=Carro, c_H[2]=Caminhao
    if(tipo == 1 && Conta[playerid][c_H][0] == 1) return true;
    if(tipo == 2 && Conta[playerid][c_H][1] == 1) return true;
    if(tipo == 3 && Conta[playerid][c_H][2] == 1) return true;
    return false;
}

stock mostrar_empregos(playerid)
{
	new c = id[playerid];
	new vai = 1;
	new filtro = GetPVarInt(playerid, "cnh_filtro");
	if(c != -1)
	{
	    if(ModoAdmin[playerid] == 0)
		{
		    if(Conta[playerid][c_Emprego2] > gettime())
	    	{
	    	    new ssss[200];
	    	    format(ssss, 200, "Voce so pode pegar um novo emprego em '%s' !", ConvertTime(Conta[playerid][c_Emprego2] - gettime()));
	    	    ms(playerid, 0, ssss);
	    	    vai = 0;
		    }
	    }
	}
	if(vai == 1)
	{
		SG[0] = EOS;
		new cont;
		new string[150];
		zerar_lista(playerid);
		strcat(SG, "ID\tEmprego\tNivel\tSalario\n");
		for(new i; i<MAX_EMPREGOS; i++)
		{
		    if(Emprego[i][e_Existe] != 1 || i == 3) continue;
		    // Filtrar por CNH
		    if(filtro == 0 && !VR_PrecisaCNH(i)) continue; // Precisa CNH
		    if(filtro == 1 && VR_PrecisaCNH(i)) continue; // Nao precisa CNH
		    format(string, 150, "{a1a1a1}%d\t{ffffff}%s\t{a1a1a1}%d\t{4169E1}R$ %s\n", i, Emprego[i][e_Nome], Emprego[i][e_Nivel], ConvertMoney(Emprego[i][e_Salario]));
		    strcat(SG, string);
		    Lista[playerid][cont] = i;
		    cont++;
		}
		format(string, 150, "{ffffff}Empregos Disponiveis [{a1a1a1}%d{ffffff}]", cont);
		ShowPlayerDialog(playerid, DIALOG_EMPREGOS, DIALOG_STYLE_TABLIST_HEADERS, string, SG, "Continuar", "Fechar");
	}
}


stock ConvertTime(number)
{
    new hours = 0, mins = 0, secs = 0, string[100];
    hours = floatround(number / 3600);
    mins = floatround((number / 60) - (hours * 60));
    secs = floatround(number - ((hours * 3600) + (mins * 60)));
    new days = 0;

    if(hours >= 24)
    {
        days = floatround((hours/24), floatround_floor);
        hours = hours % 24;
    }

    if(days > 0)
    {
        format(string, 100, "%d dias, %02d:%02d:%02d", days, hours, mins, secs);
    }
    else if(hours > 0)
    {
        format(string, 100, "%02d:%02d:%02d", hours, mins, secs);
    }
    else
    {
        format(string, 100, "%02d:%02d", mins, secs);
    }
    return string;
}

