	    {
	        SelectTextDraw(playerid, 0x00ffff90);
	        KillTimer(timer_spawn_player[playerid]);
	        timer_spawn_player[playerid] = SetTimerEx("PlayerSpawnAgora", 100, false, "d", playerid);
	    }
	    return 1;
	}

