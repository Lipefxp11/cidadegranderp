stock VeiculoComponente(veh, componente)
{
    new modelo_veiculo = GetVehicleModel(veh);
	if(modelo_veiculo < 400 || modelo_veiculo > 612) return 0;
	for(new i; i<MAX_VEHICLE_COMPONENTS; i++)
	{
	    if(gVehicleComponents[modelo_veiculo-400][i] == componente)
	    {
	        return 1;
	    }
	}
	return 0;
}

