	if(con == 1) ShowPlayerDialog(playerid, DIALOG_ESCREVER, DIALOG_STYLE_INPUT, "{000000}_", "\n{ff0000}Menssagem muito Curta !\n{a1a1a1}Digite sua Menssagem                                                                    .", "Enviar", "Cancelar");
	if(con == 2) ShowPlayerDialog(playerid, DIALOG_ESCREVER, DIALOG_STYLE_INPUT, "{000000}_", "\n{ff0000}Menssagem muito Grande, tente denovo !{a1a1a1}Digite sua Menssagem                                                                    .", "Enviar", "Cancelar");
    if(con == 3) ShowPlayerDialog(playerid, DIALOG_ESCREVER, DIALOG_STYLE_INPUT, "{000000}_", "\n{ff0000}Span ou Palavra muito grande indentificada !\nTente nao usar palavras muito grandes ou caracteres repetidos.\n{a1a1a1}Digite sua Menssagem                                                                    .", "Enviar", "Cancelar");

}


stock opcoes_contato(playerid, i)
{
    new c = id[playerid];
	if(c != -1)
	{
		SetPVarInt(playerid, "id_contato", i);
		format(Titulo_DC[playerid], 100, NomeConta(Contatos[playerid][i]));
		format(Lista_DC[playerid][0][cel_Nome], 50, "~w~Enviar Menssagem");
		format(Lista_DC[playerid][1][cel_Nome], 50, "~w~Ligar");
		format(Lista_DC[playerid][2][cel_Nome], 50, "~y~Enviar Localizacao");
		format(Lista_DC[playerid][3][cel_Nome], 50, "~w~Informacoes");
		format(Lista_DC[playerid][4][cel_Nome], 50, "~r~Apagar Contato");
	    ID_DC[playerid] = WHATSAPP_OPCOES_CONTATO;
		MAX_DC[playerid] = 5;
		Pagina_DC[playerid] = 0;
		Item_DC[playerid] = 0;
		celular(playerid, C_LISTA);
	}
}

stock adicionar_contato(playerid)
{
    new c = id[playerid];
	if(c != -1)
	{
		ID_DC[playerid] = WHATSAPP_ADICIONAR_CONTATO;
		format(Titulo_DC[playerid], 100, "~w~Digite o ~y~numero ~w~que deseja adicionar a sua lista de contatos:");
		Numero_MAX_DC[playerid] = 0;
		celular(playerid, C_NUMERO);
	}
}

stock adicionar_novo_contato(playerid, cc)
{
    new c = id[playerid];
	if(c != -1)
	{
	    new tem;
		if(tem_contato(playerid, cc))
		{
		    format(str_aviso[playerid], 300, "Voce ja tem este contato Salvo !");
			SetPVarInt(playerid, "aviso", C_LISTA);
			celular(playerid, C_ERRO);
		}
		else
		{
			for(new a; a<MAX_CONTATOS; a++)
			{
			    if(Contatos[playerid][a] == -1)
				{
				Contatos[playerid][a] = cc;
				contatos_whatsapp(playerid);
				format(str_aviso[playerid], 300, "Contato adicionado com sucesso !");
		    		SetPVarInt(playerid, "aviso", C_LISTA);
		    		celular(playerid, C_INFO);
				salvar_whatsapp(playerid, c);
				tem = 1;
				break;
			    }
			}
		}

		if(tem == 0)
		{
			format(str_aviso[playerid], 300, "Lista de contatos Lotada, nao foi possivel adicionar este numero !");
			SetPVarInt(playerid, "aviso", C_LISTA);
			celular(playerid, C_ERRO);
		}
	}
}

stock tem_contato(playerid, i)
{
    new c = id[playerid];
	if(c == -1) return 1;
	for(new a; a<MAX_CONTATOS; a++)
	{
	    if(Contatos[playerid][a] == i)
	    {
	        return 1;
	    }
	}
	return 0;
}

stock apagar_contato(playerid)
{
    new c = id[playerid];
	if(c != -1)
	{
		format(Titulo_DC[playerid], 100, "~y~APAGAR CONTATO ?");
		format(Lista_DC[playerid][0][cel_Nome], 50, "~G~Sim");
		format(Lista_DC[playerid][1][cel_Nome], 50, "~r~Cancelar");
	    ID_DC[playerid] = WHATSAPP_APAGAR_CONTATO;
		MAX_DC[playerid] = 2;
		Pagina_DC[playerid] = 0;
		Item_DC[playerid] = 0;
		celular(playerid, C_LISTA);
	}
}

stock tem_converssa(c, i)
{
	for(new a; a<MAX_WP; a++)
	{
	    if(WP[a][w_Existe] == 1)
	    {
	        if(WP[a][w_Conta][0] == i && WP[a][w_Conta][1] == c) return a;
            if(WP[a][w_Conta][1] == i && WP[a][w_Conta][0] == c) return a;
	    }
	}
	return -1;
}

stock ver_mens(playerid, i)
{
	if(player_converssa[playerid][i][cv_Existe] == 1)
	{
	    format(str_aviso[playerid], 300, "~g~~h~%s - ~y~~h~%s~n~~n~~w~%s.", NomeConta(player_converssa[playerid][i][cv_Conta]), player_converssa[playerid][i][cv_Hora], player_converssa[playerid][i][cv_Menssagem]);
		SetPVarInt(playerid, "aviso", C_WP_APK);
		celular(playerid, C_INFO);
	}
}

