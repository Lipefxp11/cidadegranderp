		return 1;
	}

	if(!strcmp(cmd, "/modeloportao", true))
	{
	    new i, c;
		if(sscanf(params, "dd", i, c)) return ms(playerid, 2, "Use: /modeloportao [ ID do PORTAO ] [ ID do Objeto ]");
		if(i < 0 || i >= MAX_PORTOES) return ms(playerid, 0, "ID de portao Invalido !");
		if(Portao[i][p_Existe] == 0) return ms(playerid, 0, "Este portao nao existe !");
		Portao[i][p_Modelo] = c;
		atualizar_portao(i);
		salvar_portao(i);
		new sss[300];
		format(sss, 300, "Voce definiu o objeto do portao portao %d para [%d].",  i, c);
		ms(playerid, 5, sss);
		return 1;
	}

	if(!strcmp(cmd, "/donoportao", true))
	{
	    new i, c;
		if(sscanf(params, "dd", i, c)) return ms(playerid, 2, "Use: /donoportao [ ID do PORTAO ] [ ID da Conta ]");
		if(i < 0 || i >= MAX_PORTOES) return ms(playerid, 0, "ID de portao Invalido !");
		if(Portao[i][p_Existe] == 0) return ms(playerid, 0, "Este portao nao existe !");

	    if(c == -1)
		{
		    new sss[300];
			format(sss, 300, "Voce retirou o dono do portao portao %d.",  i);
			ms(playerid, 5, sss);
		    Portao[i][p_Dono] = c;
		    texto_portao(i);
		    salvar_portao(i);
		    return 1;
		}

		if(c < 0 || c >= MAX_CONTAS) return ms(playerid, 0, "ID de Conta Invalido !");
		if(ContaInvalida(c)) return ms(playerid, 0, "Esta Conta nao existe !");
		Portao[i][p_Dono] = c;
		new sss[300];
		format(sss, 300, "Voce definiu '%s' conta %d, como dono do portao %d.", NomeConta(c), c, i);
		ms(playerid, 5, sss);
		texto_portao(i);
		salvar_portao(i);
		return 1;
	}

	if(!strcmp(cmd, "/infoportao", true))
	{
	    new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /infoportao [ ID do PORTAO ]");
		if(i < 0 || i >= MAX_PORTOES) return ms(playerid, 0, "ID de portao Invalido !");
		if(Portao[i][p_Existe] == 0) return ms(playerid, 0, "Este portao nao existe !");
		new sss[100];
