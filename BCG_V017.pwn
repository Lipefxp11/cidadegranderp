stock abrir_casa(playerid, i)
{
    new c = id[playerid];
	if(c != -1 && i != -1)
	{
		new Float:dist;
		new varia[30];
		new sss[150];
	    new Float:p[3];
	    GetPlayerPos(playerid, p[0], p[1], p[2]);
		SetPVarInt(playerid, "casa", i);
		SG[0] = EOS;
		if(Online(playerid))
		{
			if(Casa[i][casa_Existe] == 1)
			{
			    format(varia, 30, "{4169E1}R$ %s", ConvertMoney(Casa[i][casa_Valor]));
			    GetDistance(dist, p[0], p[1], p[2], Casa[i][casa_X1], Casa[i][casa_Y1], Casa[i][casa_Z1]);
		        if(Casa[i][casa_Dono] == c)
		        {
		            format(sss, 150, "{ffffff}Localizar\t{a1a1a1}%.0f Metros\n", dist), strcat(SG, sss);
					format(sss, 150, "{ffffff}Fechadura\t%s\n", (Casa[i][casa_Chave] == 0)? "{ffff00}ABERTA":"{ff0000}TRANCADA"), strcat(SG, sss);
					format(sss, 150, "{ffffff}Gerenciar Chaves\t{a1a1a1}\n"), strcat(SG, sss);
					format(sss, 150, "{ffffff}Vender Casa\t{a1a1a1}%s\n", (Casa[i][casa_Venda] == 0)? "Colocar pra Vender":"Tirar de Venda"), strcat(SG, sss);
					format(sss, 150, "{ffffff}Vender p/ Servidor\t{ff0000}R$ %s\n", ConvertMoney(Casa[i][casa_Valor]/2)), strcat(SG, sss);
					format(sss, 150, "{ffffff}Todos os Moveis\t{ff5088}%d\n", moveis_casa(i)), strcat(SG, sss);
                    format(sss, 150, "{ffffff}%s: %d", tipo_casa(i), i);
                    ShowPlayerDialog(playerid, DIALOG_CASAS_OPCOES, DIALOG_STYLE_TABLIST, sss, SG, "Ok", "Fechar");
				}
		    }
		}
	}
}


