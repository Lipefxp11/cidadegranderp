    new sss[150];
	format(sss, 150, "{ffffff}\n\
	{ffffff}Org Atual: {00ffff}%s\n\n\
	{ffffff}Digite o ID da Org:\n",
	NomeOrg(Cadeia[i][ca_Org]));
	ShowPlayerDialog(playerid, DIALOG_CADEIA4, DIALOG_STYLE_INPUT, "Setar Org", sss, "Setar", "Cancelar");
}


stock abrir_celas_cadeia(playerid, i)
{
    new sss[150];
	SG[0] = EOS;
	for(new a; a<5; a++)
	{
		if(Cadeia[i][ca_Cela_Existe][a] == 1) format(sss, 150, "{ffffff}Cela ID: %d\n", a);
		else format(sss, 150, "{a1a1a1}Nao Existe\n");
		strcat(SG, sss);
	}
    ShowPlayerDialog(playerid, DIALOG_CADEIA5, DIALOG_STYLE_LIST, "Celas da Cadeia", SG, "Continuar", "Voltar");
}

stock abrir_cela_cadeia(playerid, i, a)
{
	if(Cadeia[i][ca_Existe] == 1)
	{
	    if(Online(playerid))
	    {
	        SG[0] = EOS;
	        strcat(SG, "{ffffff}Local\n");
	        if(Cadeia[i][ca_Cela_Existe][a] == 1) strcat(SG, "{ff0000}Destruir\n");
	        else strcat(SG, "{4169E1}Criar\n");
	        strcat(SG, "{ffffff}Ir ate a cela\n");
	        new sss[100];
	        format(sss, 100, "{ffffff}Cadeia [%d] - Cela ID: %d", i, a);
	        ShowPlayerDialog(playerid, DIALOG_CADEIA6, DIALOG_STYLE_LIST, sss, SG, "Continuar", "Voltar");
	    }
	}
}

stock verificar_cadeia(playerid)
{
	new c = id[playerid];
	if(c != -1)
	{
	    new cs = Conta[playerid][c_CA_Tempo];
	    if(cs > 0)
	    {
	        if(mostrando_cadeia[playerid] == 1)
	        {
	            mostrando_cadeia[playerid] = 0;
	           	TextDrawHideForPlayer(playerid, T_Cadeia[0]);
				TextDrawHideForPlayer(playerid, T_Cadeia[1]);
                PlayerTextDrawHide(playerid, T_Cadeia_p[playerid][0]);
	        }
	    }
	    else
	    {
		    new sss[150];
		    new i = Conta[playerid][c_Cadeia];
		    if(i != -1)
		    {
		        new tempo = Conta[playerid][c_TempoCadeia];
		        new a = Conta[playerid][c_Cela];
		        if(tempo > 0)
		        {
		            format(sss, 150, "%s~n~~n~%s~n~", NomeOrg(Cadeia[i][ca_Org]), ConvertTime(tempo));
					PlayerTextDrawSetString(playerid, T_Cadeia_p[playerid][0], sss);
		            if(mostrando_cadeia[playerid] == 0)
		            {
		                mostrando_cadeia[playerid] = 1;
		                TextDrawShowForPlayer(playerid, T_Cadeia[0]);
						TextDrawShowForPlayer(playerid, T_Cadeia[1]);
		                PlayerTextDrawShow(playerid, T_Cadeia_p[playerid][0]);
		            }

		            // se tiver longe da cela //
		            if(!IsPlayerInRangeOfPoint(playerid, 5, Cadeia[i][ca_Cela_X][a], Cadeia[i][ca_Cela_Y][a], Cadeia[i][ca_Cela_Z][a]) ||
					GetPlayerInterior(playerid) != Cadeia[i][ca_Interior] || GetPlayerVirtualWorld_(playerid) != Cadeia[i][ca_Mundo])
		            {
		                SetPlayerPos_(playerid, Cadeia[i][ca_Cela_X][a]+0.1, Cadeia[i][ca_Cela_Y][a]+0.1, Cadeia[i][ca_Cela_Z][a]+0.1);
		                SetPlayerInterior(playerid, Cadeia[i][ca_Interior]);
		            	SetPlayerVirtualWorld_(playerid, Cadeia[i][ca_Mundo]);
		            }
		            Conta[playerid][c_TempoCadeia] --;
		            salvar_conta(c, 0, "c_TempoCadeia", sv_int(Conta[playerid][c_TempoCadeia]));
		        }
		        else
		        {
		            if(mostrando_cadeia[playerid] == 1)
		            {
		                mostrando_cadeia[playerid] = 0;
		                TextDrawHideForPlayer(playerid, T_Cadeia[0]);
						TextDrawHideForPlayer(playerid, T_Cadeia[1]);
		                PlayerTextDrawHide(playerid, T_Cadeia_p[playerid][0]);
		            }
		            ms(playerid, 1, "Voce cumpiu sua pena, e agora esta livre.");
		            SetPlayerInterior(playerid, Cadeia[i][ca_Interior2]);
		            SetPlayerVirtualWorld_(playerid, Cadeia[i][ca_Mundo2]);
		            SetPlayerPos_(playerid, Cadeia[i][ca_X2]+0.1, Cadeia[i][ca_Y2]+0.1, Cadeia[i][ca_Z2]+0.1 );
		            Conta[playerid][c_Cadeia] = -1;
		            Conta[playerid][c_Cela] = 0;
		            Conta[playerid][c_TempoCadeia] = 0;
		            Conta[playerid][c_Ajuste] = -1;
		            salvar_conta(c, -1, "c_Posicao2");
		            salvar_conta(c, -1, "c_Presidio");
		        }
		    }
		    else if(mostrando_cadeia[playerid] == 1)
	        {
	            mostrando_cadeia[playerid] = 0;
	            TextDrawHideForPlayer(playerid, T_Cadeia[0]);
				TextDrawHideForPlayer(playerid, T_Cadeia[1]);
	            PlayerTextDrawHide(playerid, T_Cadeia_p[playerid][0]);
	        }
        }
	}
	else if(mostrando_cadeia[playerid] == 1)
    {
        mostrando_cadeia[playerid] = 0;
        TextDrawHideForPlayer(playerid, T_Cadeia[0]);
		TextDrawHideForPlayer(playerid, T_Cadeia[1]);
        PlayerTextDrawHide(playerid, T_Cadeia_p[playerid][0]);
    }
}

stock cadeia_org(org)
{
	new lis[MAX_CADEIAS];
	new cont;
	if(org != -1) foreach(new a:Iter_Cadeias) if(Cadeia[a][ca_Existe] == 1) if(Cadeia[a][ca_Org] == org) return a;
	foreach(new aa:Iter_Cadeias)
	{
	    if(Cadeia[aa][ca_Existe] == 1)
	    {
	        lis[cont] = aa;
	        cont++;
	    }
	}
	new rand = random(cont);
	return lis[rand];
}

stock prender(playerid, i, con=0)
{
	new c = id[playerid];
	if(c != -1)
	{
		if(Conta[playerid][c_Procurado] > 0)
		{
		    new tempo = Conta[playerid][c_Procurado]*(5*60);
		    Conta[playerid][c_TempoCadeia] = tempo;
		    Conta[playerid][c_Ajuste] = -1;
		    Conta[playerid][c_FichaPolicial] = 1;
		    salvar_conta(c, 0, "c_FichaPolicial", sv_int(1));
		    if(con == 1)
		    {
		    	i = cadeia_org(-1);
		        new cca = GetPVarInt(playerid, "org");
		        if(cca != -1)
		        {
		            i = cadeia_org(cca);
		        }
		    }
		    Conta[playerid][c_Cadeia] = i;
		    new cont;
		    new celas[5];
		    for(new a; a<5; a++)
		    {
		        if(Cadeia[i][ca_Cela_Existe][a] == 1)
		        {
		            celas[cont] = a;
		            cont++;
		        }
		    }
		    new rand = random(cont);
		    new ce = celas[rand];
		    Conta[playerid][c_Cela] = ce;
		    SetPlayerPos_(playerid, Cadeia[i][ca_Cela_X][ce]+0.1, Cadeia[i][ca_Cela_Y][ce]+0.1, Cadeia[i][ca_Cela_Z][ce]+0.1);
            SetPlayerInterior(playerid, Cadeia[i][ca_Interior]);
        	SetPlayerVirtualWorld_(playerid, Cadeia[i][ca_Mundo]);
        	new sss[150];
        	format(sss, 150, "Voce foi preso por %s na cadeia '%s'.", ConvertTime(tempo), NomeOrg(Cadeia[i][ca_Org]));
        	ms(playerid, 2, sss);
        	GZ_EsconderGzPlayer(playerid, gz_policia);
        	player_algemado[playerid] = 0;
        	player_rendido[playerid] = 0;
        	player_arrastado[playerid] = -1;
	        SetPlayerSpecialAction(playerid, 0);
	        ResetPlayerWeapons_(playerid);
			for(new d; d<13; d++)
			{
			    Conta[playerid][c_Arma][d] = 0;
			    Conta[playerid][c_Municao][d] = 0;
			}
			SetarColete(playerid, 0);
			salvar_conta(c, -1, "c_Armas");
			salvar_conta(c, -1, "c_Posicao2");
	       	salvar_conta(c, -1, "c_Presidio");
			new o = Cadeia[i][ca_Org];
			if(o != -1)
			{
			    if(Org[o][o_Existe] == 1)
				{
				Org[o][o_Cofre] += Conta[playerid][c_Procurado]*500;
				format(sss, 150, "A organizacao recebeu R$ %s pela prisao de '%s'.", ConvertMoney(Conta[playerid][c_Procurado]*500),Nome(playerid));
				escrever_log(f("OrgsLog/Org_%d.txt", o), sss);
				salvar_org(o);
			    }
			}
			format(sss, 150, "[PRISAO] O suspeito '%s' foi preso por %s na cadeia '%s'.", Nome(playerid), ConvertTime(tempo), NomeOrg(Cadeia[i][ca_Org]));
			mscop(sss);
			SetarNivelProcurado(playerid, 0);
		}
	}
}


BCG:: salvar_armas(playerid, con)
{
	new c = id[playerid];
	if(c != -1)
	{
	    if(con == -1) salvar_conta(c, -1, "c_Armas");
		salvar_conta(c, playerid, "c_Armas");
	}
}


stock Preso(playerid)
{
    new c = id[playerid];
	if(c != -1)
	{
	    if(Conta[playerid][c_Cadeia] != -1)
	    {
	        if(Conta[playerid][c_TempoCadeia] > 0)
	        {
	            return 1;
	        }
	    }
	}
	return 0;
}

stock voz_de_prisao(playerid, i)
{
	if(Online(playerid) && Online(i))
	{
	    new cc = id[i];
	    if(cc != -1)
	    {
	        if(Conta[i][c_Procurado] > 0)
	        {
	            new sss[150];

	            format(string_prox, 300, "** O oficial '%s' deu voz de prisao para '%s' **", Nome(playerid), Nome(i));
				ProxDetector(30.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
	            format(sss, 150, "Voce deu Voz de prisao para '%s', caso ele sair do jogo em 2 minutos sera preso automaticamente.", Nome(i));
	            ms(playerid, 1, sss);
	            format(sss, 150, "[ATENCAO] O oficial '%s' lhe deu voz de prisao, se voce sair do jogo em 2 minutos sera preso automaticamente.", Nome(playerid));
	            ms(i, 5, sss);
	            SetPVarInt(i, "vdp", gettime() + (2*60));
	            SetPVarInt(i, "org", OrgPlayer(playerid));
	            GZ_MostrarGzPlayer(i, gz_policia);
				GZ_PiscarGzPlayer(i, gz_policia, 0x0000ff80);
	        }
	        else ms(playerid, 0, "Este jogador nao e procurado pela policia !");
	    }
	}
}

stock mostrar_su(playerid)
{
	new sss[150];
	SG[0] = EOS;
	strcat(SG, "Artigo\tMotivo\tNivel\n");
	for(new i; i<sizeof SU; i++)
	{
		format(sss, 150, "{ffffff}%s\t{ffff00}%s\t{a1a1a1}%s\n", SU[i][0], SU[i][1], SU[i][2]);
		strcat(SG, sss);
	}
	ShowPlayerDialog(playerid, DIALOG_SU, DIALOG_STYLE_TABLIST_HEADERS, "Lista de Aplicacao", SG, "Continuar", "Cancelar");
}

stock aplicar_su(playerid, i, a)
{
    if(Online(playerid))
	{
	    new niv = strval(SU[a][2]);
	    new sss[150];
	    new c = id[playerid];
        if(c != -1)
        {
	    	if(Online(i))
	    	{
                DarNivelProcurado(playerid, niv);
			    format(sss, 150, "[SUSPEITO] O oficial '%s' lhe aplicou um '%s'.", Nome(i), SU[a][1]);
			    ms(playerid, 5, sss);
			    format(sss, 150, "Voce recebeu +%d niveis de procurado, Nivel atual: [%d].", niv, Conta[playerid][c_Procurado]);
			    ms(playerid, 5, sss);
			    format(sss, 150, "Voce aplicou um '%s' em '%s' agora ele tem %d niveis de procurado.", SU[a][1], Nome(playerid), Conta[playerid][c_Procurado]);
			    ms(i, 5, sss);
			    format(sss, 150, "[PROCURADO] O oficial '%s' aplicou um '%s' em '%s'.", Nome(i), SU[a][1], Nome(playerid));
			    mscop(sss);
		    }
		    else
		    {
			    DarNivelProcurado(playerid, niv);
			    format(sss, 150, "[SUSPEITO] A cameras registraram voce cometendo um '%s'.", SU[a][1]);
			    ms(playerid, 5, sss);
			    format(sss, 150, "Voce recebeu +%d niveis de procurado, Nivel atual: [%d].", niv, Conta[playerid][c_Procurado]);
			    ms(playerid, 5, sss);
			    format(sss, 150, "[PROCURADO] As cameras acusaram '%s' de cometer um '%s'.",  Nome(playerid), SU[a][1]);
			    mscop(sss);
		    }
	    }
	    foreach(new d:Player) suspeito[playerid][d] = gettime()+(6*60);
	}
}


stock mscop(const menss[], cor=-1)
{
    foreach(new o:Player)
	{
		if(Online(o))
		{
		    if(PlayerCop(o) || PlayerMedico(o))
		    {
		        if(cor == -1) ms(o, 5, menss);
				else ms(o, cor, menss);
		    }
		}
	}
}

stock msmmec(const menss[], cor=-1)
{
    foreach(new o:Player)
    {
        if(Online(o))
        {
            if(PlayerMecanicoOrg(o))
            {
                if(cor == -1) ms(o, 5, menss);
                else ms(o, cor, menss);
            }
        }
    }
}


stock OrgMafia(i)
{
    if(i < 0 || i >= MAX_ORGS) return 0;
	if(Org[i][o_Existe] == 1)
	{
	    if(Org[i][o_Tipo] == 4) return 1;
	}
	return 0;
}

stock OrgTerrorista(i)
{
    if(i < 0 || i >= MAX_ORGS) return 0;
	if(Org[i][o_Existe] == 1)
	{
	    if(Org[i][o_Tipo] == 9) return 1;
	}
	return 0;
}

stock OrgFac(i)
{
    if(i < 0 || i >= MAX_ORGS) return 0;
	if(Org[i][o_Existe] == 1)
	{
	    if(Org[i][o_Tipo] == 5) return 1;
	}
	return 0;
}

stock OrgCop(i, con=-1)
{
	if(i < 0 || i >= MAX_ORGS) return 0;
	if(Org[i][o_Existe] == 1)
	{
	    if(con != -1)
	    {
	        if(Org[i][o_Tipo] == con) return 1;
	    }
	    else
	    {
		    for(new a; a<sizeof cops; a++)
		    {
		    	if(Org[i][o_Tipo] == cops[a]) return 1;
		    }
	    }
	}
	return 0;
}

stock OrgMecanico(i)
{
    if(i < 0 || i >= MAX_ORGS || Org[i][o_Existe] != 1) return 0;
    if(Org[i][o_Tipo] == 9) return 1;
    return 0;
}

stock PlayerMecanicoOrg(playerid)
{
    new i = OrgPlayer(playerid);
    if(i != -1 && Org[i][o_Existe] == 1 && Org[i][o_Tipo] == 9) return 1;
    return 0;
}

stock PlayerMafia(playerid)
{
	new i = OrgPlayer(playerid);
	if(i != -1)
	{
		if(Org[i][o_Existe] == 1)
		{
			if(Org[i][o_Tipo] == 4) return 1;
		}
	}
	return 0;
}

stock PlayerTerrorista(playerid)
{
	new i = OrgPlayer(playerid);
	if(i != -1)
	{
		if(Org[i][o_Existe] == 1)
		{
			if(Org[i][o_Tipo] == 9) return 1;
		}
	}
	return 0;
}

stock PlayerFac(playerid)
{
	new i = OrgPlayer(playerid);
	if(i != -1)
	{
		if(Org[i][o_Existe] == 1)
		{
			if(Org[i][o_Tipo] == 5) return 1;
		}
	}
	return 0;
}

stock PlayerDrift(playerid)
{
	new i = OrgPlayer(playerid);
	if(i != -1)
	{
		if(Org[i][o_Existe] == 1)
		{
			if(Org[i][o_Tipo] == 6) return 1;
		}
	}
	return 0;
}

stock PlayerMedico(playerid)
{
	new i = OrgPlayer(playerid);
	new i2 = EmpregoPlayer(playerid);
	if(i == 7) return 1;
	else if(i == 22) return 1;
	else if(i == 23) return 1;
	else if(i2 == 12) return 1;
	else return 0;
}


stock PlayerMecanico(playerid)
{
    return PlayerMecanicoOrg(playerid);
}

stock PlayerAdvogado(playerid)
{
	new i = EmpregoPlayer(playerid);
	if(i == 9) return 1;
	else return 0;
}


stock PlayerUber(playerid)
{
	new i = EmpregoPlayer(playerid);
	if(i == 1) return 1;
	else return 0;
}

stock BaterCartao(playerid)
{
    if(id[playerid] != -1)
    {
        if(PlayerCop(playerid))
        {
            if(servico[playerid] == 0)
			{
				servico[playerid] = 1;
				mst(0x00ffffff, f("Oficial '%s' agora esta em servico.", Nome(playerid)));
			}
            else
			{
				servico[playerid] = 0;
				mst(0x00ffffff, f("Oficial '%s' saiu do servico.", Nome(playerid)));
			}
        }
    }
}

stock EmServico(playerid)
{
	if(id[playerid] != -1) if(PlayerCop(playerid)) if(servico[playerid] == 1) return 1;
	return 0;
}

stock PlayerCop(playerid, con=-1)
{
	new i = OrgPlayer(playerid);
	if(i != -1)
	{
		if(Org[i][o_Existe] == 1)
		{
		    if(con != -1)
		    {
		        if(Org[i][o_Tipo] == con) return 1;
		    }
		    else
		    {
				for(new a; a<sizeof cops; a++)
				{
			    	if(Org[i][o_Tipo] == cops[a]) return 1;
			    }
		    }
		}
	}
	return 0;
}

stock cops_on()
{
	new cont;
	foreach(new a:Player)
	{
	    if(Online(a))
	    {
	        if(PlayerCop(a))
	        {
	            cont ++;
	        }
	    }
	}
	return cont;
}


stock abrir_limpar_ficha(playerid)
{
	if(Online(playerid))
	{
		ShowPlayerDialog(playerid, DIALOG_LIMPAR, DIALOG_STYLE_INPUT, "Limpar Ficha Criminal",
		"{ffffff}\n\
		Digite o {00ffff}ID {ffffff}da {a1a1a1}CONTA {ffffff}do player que\ndeseja limpar a ficha:\n",  "Continuar", "Cancelar");
	}
}



stock abrir_limpar_ficha_motivo(playerid, cc)
{
	new player = ContaOnline(cc);
	if(Online(player))
	{
	    SetPVarInt(playerid, "conta", cc);
		new sss[150];
		format(sss, 150, "\
		{ffffff}Conta: {00ffff}%d\n\
		{ffffff}Nome: {a1a1a1}%s\n\
		{ffffff}Procurado: {ffff00}%d\n\n\
		{4169E1}[INFO] {FFFFFF}Digite o motivo pelo qual quer limpar esta ficha criminal:\n", cc, Nome(player), Conta[player][c_Procurado]);
		ShowPlayerDialog(playerid,DIALOG_LIMPAR_MOTIVO, DIALOG_STYLE_INPUT, "Limpar Ficha Criminal", sss, "Limpar", "Voltar");
	}
	else
	{
	    SetPVarInt(playerid, "conta", cc);
		new sss[150];
		format(sss, 150, "\
		{ffffff}Conta: {00ffff}%d\n\
		{ffffff}Nome: {a1a1a1}%s\n\
		{ffffff}Procurado: {ffff00}%d\n\n\
		{4169E1}[INFO] {FFFFFF}Digite o motivo pelo qual quer limpar esta ficha criminal:\n", cc, NomeConta(cc), GetContaInt(cc, "c_Procurado"));
		ShowPlayerDialog(playerid,DIALOG_LIMPAR_MOTIVO, DIALOG_STYLE_INPUT, "Limpar Ficha Criminal", sss, "Limpar", "Voltar");
	}
}

stock mostrar_presos_na_cadeia(playerid)
{
	foreach(new i:Iter_Cadeias)
	{
	    if(Cadeia[i][ca_Existe] == 1)
	    {
            if(IsPlayerInRangeOfPoint(playerid, 100, Cadeia[i][ca_X], Cadeia[i][ca_Y], Cadeia[i][ca_Z]) && GetPlayerInterior(playerid) == Cadeia[i][ca_Interior1] && GetPlayerVirtualWorld_(playerid) == Cadeia[i][ca_Mundo1]  ||
			IsPlayerInRangeOfPoint(playerid, 100, Cadeia[i][ca_X2], Cadeia[i][ca_Y2], Cadeia[i][ca_Z2]) && GetPlayerInterior(playerid) == Cadeia[i][ca_Interior2] && GetPlayerVirtualWorld_(playerid) == Cadeia[i][ca_Mundo2]  )
            {
				mostrar_presos_cadeia(playerid, i);
        	    break;
            }
	    }
	}
}

stock mostrar_presos_cadeia(playerid, a)
{
    SetPVarInt(playerid, "cadeia", a);
    SG[0] = EOS;
    new cont;
	new sss[300];
    Lista2[playerid][0] = -1;
	strcat(SG, "Conta\tID\tNome\tTempo\n");
    foreach(new i:Player)
    {
        if(cont >= MAX_LISTA || cont > 50) break;
        if(Online(i))
        {
	        new c = id[i];
	        if(c != -1)
	        {
				if(Preso(i))
				{
				    if(Conta[i][c_Cadeia] == a)
					{
						if(Conta[i][c_Ajuste] == -1) format(sss, 300, "{00ffff}%d\t{ffff00}%d\t{ffffff}%s\t{a1a1a1}%s\n", c, i, Nome(i), ConvertTime(Conta[i][c_TempoCadeia]));
						else format(sss, 300, "{a1a1a1}%d\t%d\t%s\t%s\n", c, i, Nome(i), ConvertTime(Conta[i][c_TempoCadeia]));
						strcat(SG, sss);
						Lista2[playerid][cont] = i;
						cont++;
				    }
				}
			}
		}
    }
    if(cont == 0)  ms(playerid, 0, "Nao tem ninguem preso nessa Cadeia !");
	else ShowPlayerDialog(playerid, DIALOG_PRESOS_CADEIA, DIALOG_STYLE_TABLIST_HEADERS, NomeOrg(Cadeia[a][ca_Org]), SG, "Continuar", "Cancelar");
}

stock mostrar_procurados(playerid)
{
    if(Online(playerid))
	{
	    new sss[200];
		new cont;
	    SG[0] = EOS;
	    Lista2[playerid][0] = -1;
	    strcat(SG, "Conta\tID\tNome\tNiveis\n");
	    foreach(new i:Player)
	    {
	        if(cont >= MAX_LISTA || cont > 50) break;
            if(Online(i))
            {
                new c = id[i];
                if(c != -1)
                {
                    if(Conta[i][c_Procurado] > 0)
                    {
                        format(sss, 200, "{00ffff}%d\t{ffff00}%03d\t{ffffff}%s\t{a1a1a1}%d\n", c, i, Nome(i), Conta[i][c_Procurado]);
                        strcat(SG, sss);
                        Lista2[playerid][cont] = i;
                        cont++;
                    }
                }
            }
	    }
	    format(sss, 200, "{ffffff}Procurados [ {ffff00}%d{ffffff} ]", cont);
	    ShowPlayerDialog(playerid, DIALOG_PROCURADOS, DIALOG_STYLE_TABLIST_HEADERS, sss, SG, "Ok", "Cancelar");
	}
}

stock mostrar_presos(playerid)
{
	if(Online(playerid))
	{
		new sss[200];
		new cont;
	    SG[0] = EOS;
	    Lista2[playerid][0] = -1;
	    strcat(SG, "Conta         ID\tNome\tCadeia\tTempo\n");
	    foreach(new i:Player)
	    {
	        if(cont >= MAX_LISTA || cont > 50) break;
            if(Online(i))
            {
                new c = id[i];
                if(c != -1)
                {
					new cs = Conta[i][c_CA_Tempo];
					if(cs > 0)
					{
					    format(sss, 200, "{00ffff}%05d      {ffff00}%03d\t{ffffff}%s\t{a1a1a1}%s\t{ff0000}%s\n", c, i, Nome(i), "{FA8072}STAFF", ConvertTime(cs));
                        strcat(SG, sss);
                        cont ++;
					}
					else if(Preso(i))
                    {
                        new ca = Conta[i][c_Cadeia];
                        if(Conta[i][c_TempoCadeia] > 0)
                        {
                            if(Conta[i][c_Ajuste] == -1) format(sss, 200, "{00ffff}%05d      {ffff00}%03d\t{ffffff}%s\t{a1a1a1}%s\t{4169E1}%s\n", c, i, Nome(i), NomeOrg(Cadeia[ca][ca_Org]), ConvertTime(Conta[i][c_TempoCadeia]));
                            else format(sss, 200, "{00ffff}%05d      {ffff00}%03d\t{ffffff}%s\t{a1a1a1}%s\t{ff0000}%s\n", c, i, Nome(i), NomeOrg(Cadeia[ca][ca_Org]), ConvertTime(Conta[i][c_TempoCadeia]));
                            strcat(SG, sss);
                            cont ++;
                        }
                    }
                }
            }
	    }
	    format(sss, 200, "{ffffff}Presos [ {ffff00}%d{ffffff} ]", cont);
	    ShowPlayerDialog(playerid, DIALOG_PRESOS, DIALOG_STYLE_TABLIST_HEADERS, sss, SG, "Ok", "Cancelar");
	}
}


stock porcentagem_advogado(playerid)
{
	new e = EmpregoPlayer(playerid);
	new c = id[playerid];
	if(c != -1)
	{
	    if(e != -1)
	    {
	        new niv = Conta[playerid][c_NivelEmprego][e];
	        new nii = niv/5;
	        if(nii < 1) nii = 1;
	        return (nii*5);
	    }
	}
	return 5;
}

stock porcentagem_advogado_tempo(playerid, valor)
{
	new e = EmpregoPlayer(playerid);
	new c = id[playerid];
	if(c != -1)
	{
	    if(e != -1)
	    {
	        new niv = Conta[playerid][c_NivelEmprego][e];
	        new nii = niv/5;
	        if(nii < 1) nii = 1;
	        new Float:po = float(valor)/100;
	        new Float:nv = (100-(nii*5))*po;
	        valor = floatround(nv);
	        return valor;
	    }
	}
	return valor;
}

stock ajustar_preso(playerid, i, preco)
{
	if(Online(playerid) && Online(i))
	{
	    new sss[150];
	    new c = id[playerid];
	    new cc = id[i];
	    if(c != -1 && cc != -1)
	    {
	        if(Preso(playerid))
	        {
	            new temp = Conta[playerid][c_TempoCadeia];
	            new por = porcentagem_advogado(i);
	            new rest = porcentagem_advogado_tempo(i, temp);
  				Conta[playerid][c_TempoCadeia] = rest;
  				Conta[playerid][c_Ajuste] = cc;
				format(sss, 150, "Voce pagou R$ %s para '%s' pela reducao da sua pena.", ConvertMoney(preco), Nome(i));
				ms(playerid, 1, sss);
				format(sss, 150, "Sua pena foi reduzida em %d%% e agora restam: %s.", por, ConvertTime(Conta[playerid][c_TempoCadeia]));
				ms(playerid, 1, sss);
				salvar_conta(c, -1, "c_Presidio");

			    new e = EmpregoPlayer(i);
			    if(e != -1)
				{
				format(sss, 150, "'%s' lhe pagou R$ %s pela reducao de %d%% da pena dele.", Nome(playerid), ConvertMoney(preco), por);
				if(Conta[i][c_NivelEmprego][e] < 100)
					{
						format(sss, 150, "'%s' lhe pagou R$ %s pela reducao de %d%% da pena dele, sua Habilidade de advogado almentou.", Nome(playerid), ConvertMoney(preco), por);
				    	Conta[i][c_NivelEmprego][e] += 1;
					}
					ms(i, 1, sss);
				    salvar_conta(cc, -1, "c_NivelEmprego");
			    }

			    DarGrana(playerid, -preco);
			    DarGrana(i, preco);
	        }
	    }
	}
}

stock oferecer_ajuste(playerid, i)
{
	SetPVarInt(playerid, "preso", i);
	if(Online(playerid) && Online(i))
	{
	    new c = id[playerid];
	    new cc = id[i];
	    if(c != -1 && cc != -1)
	    {
	        if(Preso(i))
	        {
	            if(Conta[i][c_Ajuste] == -1)
	            {
				new sss[300];
					new ca = Conta[i][c_Cadeia];
					new temp = Conta[i][c_TempoCadeia];
					new por = porcentagem_advogado(playerid);
					new rest = porcentagem_advogado_tempo(playerid, temp);
					format(sss, 300, "\
					{ffffff}Conta: {00ffff}%d\n\
					{ffffff}Nome: {a1a1a1}%s\n\
					{ffffff}Tempo: {a1a1a1}%s\n\
					{ffffff}Cadeia: {ff0000}%s\n\n\
					\
					{ffffff}Ajuste: {ffff00}%s\n\
					{ffffff}Porcentagem: {00ffff}%d%%\n\n\
					\
					\
					{4169E1}[INFO] {ffffff}Digite o valor que deseja cobrar pelo ajuste:\n", cc, Nome(i), ConvertTime(Conta[i][c_TempoCadeia]), NomeOrg(Cadeia[ca][ca_Org]),
					ConvertTime(Conta[i][c_TempoCadeia]-rest), por );
	                ShowPlayerDialog(playerid, DIALOG_PENA, DIALOG_STYLE_INPUT, "Ajuste de Pena", sss, "Oferecer", "Cancelar");
                }
                else ms(playerid, 0, "Este preso ja recebeu um ajuste de Pena.");
	    	}
		}
	}
}

stock mostrar_ajuste(playerid, i, valor)
{
	if(GetPVarInt(playerid, "ajuste") > 0)
	{
		if(Online(playerid) && Online(i))
		{
		    new c = id[playerid];
		    new cc = id[i];
			if(c != -1 && cc != -1)
			{
			    new temp = Conta[i][c_TempoCadeia];
				new por = porcentagem_advogado(playerid);
				new rest = porcentagem_advogado_tempo(playerid, temp);
			    new sss[500];
			    new sss2[100];
			    format(sss, 500, "\
				\
				{00ffff}AJUSTE DE PENA\n\
				\n\
				{ffffff}Advogado: {a1a1a1}%s\n\
				{ffffff}Reducao: {ffff00}%s\n\
				{ffffff}Porcentagem: {00ffff}%d%%\n\
				\n\
				{ffffff}Valor: {4169E1}R$ %s\n\
				{ffff00}[INFO] {ffffff}Deseja aceitar o ajuste de pena ?\n",
				Nome(playerid), ConvertTime(Conta[i][c_TempoCadeia]-rest), por, ConvertMoney(valor));
				format(sss2, 100, "{ffffff}Ajuste de Pena [ {ffff00}%d {ffffff}]", GetPVarInt(playerid, "ajuste")-gettime());
	   			if(Conta[i][c_Ajuste] == -1) ShowPlayerDialog(i, DIALOG_PENA_ACEITAR, DIALOG_STYLE_MSGBOX, sss2, sss, "Aceitar", "Recusar");

				format(sss, 500, "\
				\
				{00ffff}AJUSTE DE PENA\n\
				\n\
				{ffffff}Preso: {a1a1a1}%s\n\
				{ffffff}Reducao: {ffff00}%s\n\
				{ffffff}Porcentagem: {00ffff}%d%%\n\
				\n\
				{ffffff}Valor: {4169E1}R$ %s\n\
				{a1a1a1}Aguarde por uma resposta ou cancele o ajuste.\n",
				Nome(i), ConvertTime(Conta[i][c_TempoCadeia]-rest), por, ConvertMoney(valor));
				format(sss2, 100, "{ffffff}Ajuste de Pena [ {ffff00}%d {ffffff}]", GetPVarInt(playerid, "ajuste")-gettime());
	   			ShowPlayerDialog(playerid, DIALOG_PENA_AGUARDAR, DIALOG_STYLE_MSGBOX, sss2, sss, "Aguardar", "Cancelar");
			}
		}
	}
}


stock acabou_tempo_ajuste(playerid, i)
{
	if(Online(playerid)) ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Ajuste de Pena", "\n{ff0000}[INFO] {A1A1A1}O tempo da oferta de ajuste acabou !", "Ok", "Fechar");
	if(Online(i)) ShowPlayerDialog(i, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Ajuste de Pena", "\n{ff0000}[INFO] {A1A1A1}O tempo da oferta de ajuste acabou !", "Ok", "Fechar");
}

stock desconectou_ajuste(playerid, i)
{
    if(Online(playerid)) ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Ajuste de Pena", "\n{ff0000}[INFO] {A1A1A1}O preso nao esta mais Online !", "Ok", "Fechar");
	if(Online(i)) ShowPlayerDialog(i, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Ajuste de Pena", "\n{ff0000}[INFO] {A1A1A1}O advogado nao esta mais Online !", "Ok", "Fechar");
}

stock salvar_concessionaria(i)
{
    new file[80];
	new linh[500];
	new linh2[80];
	format(file, 80, "Concessionarias/Conce_%d.txt", i);
	if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
	if(Conce[i][con_Existe] == 1)
	{
	    DOF2_CreateFile(file);
	    DOF2_SetString(file, "con_Nome", Conce[i][con_Nome]);
        DOF2_SetFloat(file, "con_X", Conce[i][con_X]);
        DOF2_SetFloat(file, "con_Y", Conce[i][con_Y]);
        DOF2_SetFloat(file, "con_Z", Conce[i][con_Z]);
        DOF2_SetFloat(file, "con_g_X", Conce[i][con_g_X]);
        DOF2_SetFloat(file, "con_g_Y", Conce[i][con_g_Y]);
        DOF2_SetFloat(file, "con_g_Z", Conce[i][con_g_Z]);
	    for(new a; a<MAX_VEICULOS_CONCE; a++)
		{
			format(linh2, 80, "con_Veiculo_%d", a);
			format(linh, 500, "%d|%d|%d|%f|%f|%f|%f|",
			Conce[i][con_v_Existe][a],Conce[i][con_v_Modelo][a],Conce[i][con_v_Valor][a],Conce[i][con_v_X][a],
		 	Conce[i][con_v_Y][a], Conce[i][con_v_Z][a], Conce[i][con_v_A][a] );
		    DOF2_SetString(file, linh2, linh);
			format(linh2, 80, "con_Veiculo_%d_Stock", a);
			DOF2_SetInt(file, linh2, Conce[i][con_v_Stock][a]);
			format(linh2, 80, "con_Veiculo_%d_Cor", a);
			DOF2_SetInt(file, linh2, Conce[i][con_v_Cor][a]);
		}
	    DOF2_SaveFile();
	}
}

BCG:: carregar_concessionarias()
{
	new cont;
	new file[80];
	new linh[600];
	new linh2[80];
	for(new i; i<MAX_CONCE; i++)
	{
	    for(new aa; aa<MAX_VEICULOS_CONCE; aa++)
		{
			Conce[i][con_v_3D][aa] = DynamicText3D:-1;
			Conce[i][con_v_Veiculo][aa] = 0;
		}
	    Conce[i][con_3D] = DynamicText3D:-1;
	    Conce[i][con_g_3D] = DynamicText3D:-1;
		format(file, 80, "Concessionarias/Conce_%d.txt", i);
	    if(DOF2_FileExists(file))
	    {
	        Conce[i][con_Existe] = 1;
	        format(Conce[i][con_Nome], 40, "%s", DOF2_GetString(file, "con_Nome"));
	        Conce[i][con_X] = DOF2_GetFloat(file, "con_X");
	        Conce[i][con_Y] = DOF2_GetFloat(file, "con_Y");
	        Conce[i][con_Z] = DOF2_GetFloat(file, "con_Z");
	        Conce[i][con_g_X] = DOF2_GetFloat(file, "con_g_X");
	        Conce[i][con_g_Y] = DOF2_GetFloat(file, "con_g_Y");
	        Conce[i][con_g_Z] = DOF2_GetFloat(file, "con_g_Z");

	        for(new a; a<MAX_VEICULOS_CONCE; a++)
	        {
	            format(linh2, 80, "con_Veiculo_%d", a);
	            format(linh, 500, "%s", DOF2_GetString(file, linh2));
	            split_linha(linh, strlen(linh));
	            Conce[i][con_v_Existe][a] = strval(split[0]);
	            Conce[i][con_v_Modelo][a] = strval(split[1]);
	            Conce[i][con_v_Valor][a] = strval(split[2]);
	            Conce[i][con_v_X][a] = floatstr(split[3]);
	            Conce[i][con_v_Y][a] = floatstr(split[4]);
	            Conce[i][con_v_Z][a] = floatstr(split[5]);
	            Conce[i][con_v_A][a] = floatstr(split[6]);
	            format(linh2, 80, "con_Veiculo_%d_Stock", a);
	            Conce[i][con_v_Stock][a] = DOF2_GetInt(file, linh2);
	            format(linh2, 80, "con_Veiculo_%d_Cor", a);
	            Conce[i][con_v_Cor][a] = DOF2_GetInt(file, linh2);
	        }
	      	atualizar_concessionaria(i);
			cont++;
	    }
	}
    printf("** %d Concessionarias do Servidor carregadas.", cont);
}

stock salvar_cupom(i)
{
	new file[80];
	format(file, 80, "Cupons/Cupom_%d.txt", i);
	if(Cupom[i][cup_Existe] == 1)
	{
		if(!DOF2_FileExists(file)) DOF2_CreateFile(file);
		DOF2_SetString(file, "cup_Codigo", Cupom[i][cup_Codigo]);
		DOF2_SetInt(file, "cup_MaxUses", Cupom[i][cup_MaxUses]);
		DOF2_SetInt(file, "cup_CurrentUses", Cupom[i][cup_CurrentUses]);
		for(new p; p<MAX_PREMIOS_CUPOM; p++)
		{
			new chave[30];
			format(chave, 30, "cup_Premio_%d", p);
			DOF2_SetInt(file, chave, Cupom[i][cup_PremioTipo][p]);
			format(chave, 30, "cup_PremioV_%d", p);
			DOF2_SetInt(file, chave, Cupom[i][cup_PremioValor][p]);
		}
		DOF2_SaveFile();
	}
	else if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
}

BCG:: carregar_cupons()
{
	new file[80], cont;
	DOF2_CreateFile("CuponsIP/_init.txt");
	for(new i; i<MAX_CUPONS; i++)
	{
		format(file, 80, "Cupons/Cupom_%d.txt", i);
		if(DOF2_FileExists(file))
		{
			Cupom[i][cup_Existe] = 1;
			format(Cupom[i][cup_Codigo], 30, "%s", DOF2_GetString(file, "cup_Codigo"));
			Cupom[i][cup_MaxUses] = DOF2_GetInt(file, "cup_MaxUses");
			Cupom[i][cup_CurrentUses] = DOF2_GetInt(file, "cup_CurrentUses");
			for(new p; p<MAX_PREMIOS_CUPOM; p++)
			{
				new chave[30];
				format(chave, 30, "cup_Premio_%d", p);
				Cupom[i][cup_PremioTipo][p] = DOF2_GetInt(file, chave);
				format(chave, 30, "cup_PremioV_%d", p);
				Cupom[i][cup_PremioValor][p] = DOF2_GetInt(file, chave);
			}
			cont++;
		}
	}
	printf("** %d Cupons do Servidor carregados.", cont);
}

stock atualizar_concessionaria(i, con=0)
{
	if(IsValidDynamicPickup(Conce[i][con_g_Pickup])) DestroyDynamicPickup(Conce[i][con_g_Pickup]);
	if(IsValidDynamic3DTextLabel(Conce[i][con_g_3D])) DestroyDynamic3DTextLabel(Conce[i][con_g_3D]);
	if(IsValidDynamicPickup(Conce[i][con_Pickup])) DestroyDynamicPickup(Conce[i][con_Pickup]);
	if(IsValidDynamic3DTextLabel(Conce[i][con_3D])) DestroyDynamic3DTextLabel(Conce[i][con_3D]);
	if(IsValidDynamicMapIcon(Conce[i][con_Mapa])) DestroyDynamicMapIcon(Conce[i][con_Mapa]);
	Conce[i][con_g_3D] = DynamicText3D:-1;
	Conce[i][con_3D] = DynamicText3D:-1;
	if(Conce[i][con_Existe] == 1)
	{
	    new sss[150];
	    format(sss, 150, "{ffff00}Concessionaria [%d]\n{00ffff}%s\n\n{a1a1a1}Aperte {FFFFFF}H {a1a1a1}para\n{a1a1a1}Ver a Lista", i, Conce[i][con_Nome]);
        Conce[i][con_3D] = CreateDynamic3DTextLabel( sss, 0xffffff99, Conce[i][con_X], Conce[i][con_Y], Conce[i][con_Z], 10, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0, -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
        Conce[i][con_Pickup] = CreateDynamicPickup(11746, 1, Conce[i][con_X], Conce[i][con_Y], Conce[i][con_Z], 0, 0, -1, STREAMER_PICKUP_SD, -1, 0);
	    Conce[i][con_Mapa] = CreateDynamicMapIcon(Conce[i][con_X], Conce[i][con_Y], Conce[i][con_Z], 56, 0xffffffff, 0, 0, -1, 200, MAPICON_LOCAL, -1,  0);
        format(sss, 150, "{ffff00}Garagem da Concessionaria [%d]\n{00ffff}%s\n\n{a1a1a1}Aperte {FFFFFF}H {a1a1a1}para\n{a1a1a1}Pegar seu veiculo", i, Conce[i][con_Nome]);
        Conce[i][con_g_3D] = CreateDynamic3DTextLabel( sss, 0xffffff99, Conce[i][con_g_X], Conce[i][con_g_Y], Conce[i][con_g_Z], 10, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0, -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
        Conce[i][con_g_Pickup] = CreateDynamicPickup(1272, 1, Conce[i][con_g_X], Conce[i][con_g_Y], Conce[i][con_g_Z], 0, 0, -1, STREAMER_PICKUP_SD, -1, 0);
	}
	if(con == 0) for(new a; a<MAX_VEICULOS_CONCE; a++) atualizar_veiculo_conce(i, a);
}


stock atualizar_veiculo_conce(i, a)
{
	new car = Conce[i][con_v_Veiculo][a];
	if(GetVehicleModel(car) != 0)
	{
	    Info_Veiculo[car] = -1;
        DestroyVehicle_(car);
        Conce[i][con_v_Veiculo][a] = 0;
	}
    if(IsValidDynamic3DTextLabel(Conce[i][con_v_3D][a])) DestroyDynamic3DTextLabel(Conce[i][con_v_3D][a]);
	Conce[i][con_v_3D][a] = DynamicText3D:-1;
    if(Conce[i][con_Existe] == 1)
	{
		if(Conce[i][con_v_Existe][a] == 1)
		{
		    new sss[250];
		    format(sss, 250, "{ffff00}%s\n{ffffff}Veiculo de Amostra\n{4169E1}R$ %s\n{ffffff}Estoque: {00ff00}%d", NomeVeiculo(Conce[i][con_v_Modelo][a]), ConvertMoney(Conce[i][con_v_Valor][a]), Conce[i][con_v_Stock][a]);
		    Conce[i][con_v_3D][a] = CreateDynamic3DTextLabel( sss, 0xffffff99, Conce[i][con_v_X][a], Conce[i][con_v_Y][a], Conce[i][con_v_Z][a], 10, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0, -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
            Conce[i][con_v_Veiculo][a] = 0;
            car = CreateVehicle_(Conce[i][con_v_Modelo][a], Conce[i][con_v_X][a], Conce[i][con_v_Y][a], Conce[i][con_v_Z][a], Conce[i][con_v_A][a], Conce[i][con_v_Cor][a], Conce[i][con_v_Cor][a], -1);
			if(car != INVALID_VEHICLE_ID)
			{
				Conce[i][con_v_Veiculo][a] = car;
				Info_Veiculo[car] = -1;
			}
		}
	}
}


stock destruir_conce(i)
{
    if(Conce[i][con_Existe] == 1)
	{
	    Conce[i][con_Existe] = 0;
        atualizar_concessionaria(i);
        salvar_concessionaria(i);
	}
}

stock criar_conce(Float:xx, Float:yy, Float:zz, const nome[])
{
	for(new i; i<MAX_CONCE; i++)
	{
	    if(Conce[i][con_Existe] == 0)
	    {
	        Conce[i][con_Existe] = 1;
	        format(Conce[i][con_Nome], 40, nome);
	        Conce[i][con_X] = xx;
	        Conce[i][con_Y] = yy;
	        Conce[i][con_Z] = zz;
	        Conce[i][con_g_X] = xx+2;
	        Conce[i][con_g_Y] = yy+2;
	        Conce[i][con_g_Z] = zz;
	        for(new a; a<MAX_VEICULOS_CONCE; a++)
	        {
	            Conce[i][con_v_Existe][a] = 0;
                Conce[i][con_v_Modelo][a] = 400;
                Conce[i][con_v_Valor][a] = 0;
                Conce[i][con_v_Stock][a] = 0;
	            Conce[i][con_v_X][a] = 0;
	            Conce[i][con_v_Y][a] = 0;
	            Conce[i][con_v_Z][a] = 0;
	            Conce[i][con_v_A][a] = 0;
	        }
	        atualizar_concessionaria(i);
	        salvar_concessionaria(i);
			return i;
	    }
	}
	return -1;
}

stock carros_conce(i)
{
	new cont;
	for(new a; a<MAX_VEICULOS_CONCE; a++)
	{
	    if(Conce[i][con_Existe] == 1)
	    {
	        if(Conce[i][con_v_Existe][a] == 1)
	        {
				cont++;
	        }
	    }
	}
	return cont;
}

stock modelo_veiculo_conce(playerid, i, a)
{
    if(Online(playerid))
	{
        SetPVarInt(playerid, "conce", i);
	    SetPVarInt(playerid, "carro", a);
	    if(Conce[i][con_Existe] == 1)
	    {
	        new sss[500];
	        format(sss, 500, "\
			{ffffff}ID concessionacia: {a1a1a1}%d\n\
			{ffffff}ID veiculo: {a1a1a1}%d\n\
			{ffffff}Modelo atual: {a1a1a1}%d\n\
			{ffffff}Nome: {a1a1a1}%s\n\
			{ffffff}Nome: {4169E1}R$ %s\n\n\
			{4169E1}[INFO] {ffffff}Digite o ID do modelo que deseja setar no veiculo:\n\n\
			", i, a, Conce[i][con_v_Modelo][a], NomeVeiculo(Conce[i][con_v_Modelo][a]), ConvertMoney(Conce[i][con_v_Valor][a]) );
	        ShowPlayerDialog(playerid, DIALOG_EDITAR_CONCE4, DIALOG_STYLE_INPUT, "Setar Modelo", sss, "Setar", "Voltar");
	    }
	}
}

