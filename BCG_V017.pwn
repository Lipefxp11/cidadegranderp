public OnPlayerRequestClass(playerid, classid)
{
    // Verificar as manutencoes do servidor
    VerificarManu(playerid);
    // variaveis
    logado[playerid] = 0;
    mostrartela[playerid] = 1;
    ArrastadoID[playerid] = -1;
    ArrastadoTT[playerid] = -1;
	AttArrastar[playerid] = -1;
    RecLig[playerid] = -1;
    EmLigacao[playerid] = -1;
    Colocado[playerid] = false;
    // funcoes
	SetPlayerColor(playerid, 0xffffffff);
	KillTimer(timer_player[playerid]);
	timer_player[playerid] = SetTimerEx("Timer_Player", 1000, true, "d", playerid);
	// BCG FIX: nao deixar o cliente em spectate/limbo antes do login.
	// O antigo loading + selecao de plataforma deixava alguns clientes Android
	// sem um player valido e causava "STAY WITHIN THE WORLD BOUNDRIES".
	CarregamentoEtapa[playerid] = 5;
	SetSpawnInfo(playerid, 0, 0, 1481.1044, -1771.4431, 18.7958, 0.0, 0, 0, 0, 0, 0, 0);
	SpawnPlayer(playerid);
	return 1;
}
stock VerificarManu(playerid)
{
    new gstring[550];
    if(ManuAberta == 1){
        format(gstring, sizeof(gstring), PASTA_ADMINS, Nome(playerid));
        if(!DOF2::FileExists(gstring)){
            ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{FF0000}Servidor em manutencao..", "Estamos em manutencao, aguarde as informacoes no discord\nagradecemos pela preferencia, e abriremos em breve!\n\nASS: {4169E1}Carlos_Kaka / Silva_","Ok","");
            SSM(playerid, -1, "{FF0000}Servidor em manutencao.. {FFFFFF}Estamos em manutencao, aguarde as informacoes no discord");
            Kick(playerid);
        }
    }
    return 1;
}
public OnPlayerConnect(playerid)
{
    SetPVarInt(playerid, "tds_inv_exist", 1);
    SetPVarInt(playerid, "tds_trade_exist", 1);
    SetPVarInt(playerid, "edit_bau", -1);
    DeletePVar(playerid, "fusion_ptd_criado");
    mostrando_bau2[playerid] = -1;
    GetPlayerName(playerid, player_nick_original[playerid], MAX_PLAYER_NAME);
    // ant_xiter_avisos //
	for(new a; a<20; a++) ant_xiter_avisos[playerid][a] = 0;
	// ant crash server //
	id[playerid] = -1;
	carregou_texts[playerid] = 0;
	new ipplayer[20];
	GetPlayerIp(playerid, ipplayer, 20);
	new strm[150];
	format(strm, 150, "%s[%d] - %s", NOME(playerid), playerid, ipplayer);
	escrever_log("Conectou.txt", strm, 1);
	apenas_kikar[playerid] = 0;
	if(DOF2_FileExists(f("IP_BLOCK/%s.txt", ipplayer)))
	{
	    SSM(playerid, 0xaa00ffff, "Voce foi Kikado por suspeita de Fast Connect !");
	    printf("IP BLOQUEADO E KIKADO: %s[%d] - %s", NOME(playerid), playerid, ipplayer);
	    apenas_kikar[playerid] = 1;
	    Kick(playerid);
	    DOF2_SaveFile();
	}
    if(flood_conect[playerid] > gettime())
    {
        flood_conect[playerid] = gettime()+3;
        format(strm, 150, "%s[%d] - %s", NOME(playerid), playerid, ipplayer);
        escrever_log("Kikado_Crash.txt", strm, 1);
        apenas_kikar[playerid] = 1;
		SSM(playerid, 0xaa00ffff, "Voce foi Kikado por suspeita de Fast Connect !");
        Kick(playerid);
        return 1;
    }
    else flood_conect[playerid] = gettime()+3;

	// inv novo //
	pagina_inv_novo[playerid] = 0;
	inv_novo_aberto[playerid] = 0;
	perto_item[playerid] = -1;
	mostrando_item[playerid] = 0;
	mostrando_caixinha[playerid] = 0;
	mostrando_armas[playerid] = 0;
	id_arma[playerid] = -1;
	mostrando_atalhos[playerid] = 0;
	mostrando_meu[playerid] = 0;

	// eventos //
	evento_player[playerid] = -1;
	timer_kitar[playerid] = 0;
	servico[playerid] = 0;
	remocao_arma[playerid] = 0;

	// timers //
	entrando_empresa[playerid] = -1;
	KillTimer(timer_radio[playerid]);

	// ligar server //
	PreloadAnims(playerid);
	SetPlayerColor(playerid, 0xffffffff);

	// pedagio //
	em_pedagio[playerid] = -1;

	// loop lento //
	id_loop_lento[playerid] = -1;
	KillTimer(timer_loop_lento[playerid]);

	// perto de coisas //
    perto_caixa[playerid] = -1;
    perto_camera[playerid] = -1;

	// territorios //
	em_gz[playerid] = -1;
	mostrando_gz[playerid] = 0;

	// carregar posicao //
	voltar_local[playerid] = 0;
	pode_carregar[playerid] = 1;

	// actor lobby criar conta //
	if(IsValidDynamicActor(actor_conta[playerid])) DestroyDynamicActor_(actor_conta[playerid]);
    mostrar_info_conta_lobby[playerid] = 0;
    logado_full[playerid] = 0;

	// trade //
	mostrando_trade[playerid] = 0;
	negociando[playerid] = -1;

	// msg ultimo login //
    foi_pro_mapa[playerid] = 0;

	// carregar mapas

	// meta emprego //
	tempo_meta[playerid] = 0;

	// vip e socio //
	mostrando_vip[playerid] = 0;

	// tela do caixa eletronico //
	mostrando_banco[playerid] = 0;

	// menssagem no quadrado //
	mostrando_mens[playerid] = 0;

	// menu veiculo //
	menu_vei_aberto[playerid] = 0;

	// tazer //
	imobilizado[playerid] = 0;

