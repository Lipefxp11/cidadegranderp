BCG:: deletar_items()
{
	foreach(new i:Iter_Itens)
	{
	    if(Item[i][item_Existe] == 1)
	    {
		    if(Item[i][item_Deletar] != -1)
		    {
			    if(Item[i][item_Deletar] > 0) Item[i][item_Deletar] -= 10;
			    else SetTimerEx("destruiritem", 1000, false, "d", i);
		    }
	    }
	}
}

stock atualizar_texto(ii)
{
	if(IsValidDynamicObject(Texto[ii][textoObj])) DestroyDynamicObject_(Texto[ii][textoObj]);
	if(Texto[ii][textoExiste] == 1)
	{
	    Texto[ii][textoObj] = CreateDynamicObject(11359, Texto[ii][textoX], Texto[ii][textoY], Texto[ii][textoZ], Texto[ii][textoRX], Texto[ii][textoRY], Texto[ii][textoRZ], Texto[ii][textoMundo], Texto[ii][textoInterior], -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
        SetDynamicObjectMaterialText(Texto[ii][textoObj], 0, Texto[ii][textoTexto], Texto[ii][textoTamanho], Texto[ii][textoFonte], 35, 1, Cores[Texto[ii][textoCor]][coresCor2], 0x00000000, Texto[ii][textoAlinhamento]);
	}
}

stock tamanhotexto(i)
{
	if(i > -1 && i < 14 ) return ((i+1)*10);
	else return 10;
}


BCG:: carregar_textos()
{
    new file[80];
    for(new i; i<MAX_TEXTOS; i++)
	{
	    format(file, 80, "Textos/Texto_%d.txt", i);
		if(DOF2_FileExists(file))
		{
		    Texto[i][textoExiste] = 1;
		    format(Texto[i][textoFonte], 20, "%s", DOF2_GetString(file, "textoFonte"));
		    format(Texto[i][textoTexto], 200, "%s", DOF2_GetString(file, "textoTexto"));
			Texto[i][textoX] = DOF2_GetFloat(file, "textoX");
			Texto[i][textoY] = DOF2_GetFloat(file, "textoY");
			Texto[i][textoZ] = DOF2_GetFloat(file, "textoZ");
			Texto[i][textoRX] = DOF2_GetFloat(file, "textoRX");
			Texto[i][textoRY] = DOF2_GetFloat(file, "textoRY");
			Texto[i][textoRZ] = DOF2_GetFloat(file, "textoRZ");
			Texto[i][textoCor] = DOF2_GetInt(file, "textoCor");
			Texto[i][textoTamanho] = DOF2_GetInt(file, "textoTamanho");
			Texto[i][textoMundo] = DOF2_GetInt(file, "textoMundo");
			Texto[i][textoInterior] = DOF2_GetInt(file, "textoInterior");
			Texto[i][textoAlinhamento] = DOF2_GetInt(file, "textoAlinhamento");
			atualizar_texto(i);
		}
		else
		{
		    Texto[i][textoExiste] = 0;
			Texto[i][textoX] = 0.0;
			Texto[i][textoY] = 0.0;
			Texto[i][textoZ] = 0.0;
			Texto[i][textoRX] = 0.0;
			Texto[i][textoRY] = 0.0;
			Texto[i][textoRZ] = 0.0;
			format(Texto[i][textoTexto], 200, "Nada");
			Texto[i][textoCor] = 0;
			Texto[i][textoTamanho] = 10;
			format(Texto[i][textoFonte], 20, "Ariel");
			Texto[i][textoMundo] = 0;
			Texto[i][textoInterior] = 0;
			Texto[i][textoAlinhamento] = 1;
		}
	}
}

stock salvar_texto(i)
{
    new file[80];
    format(file, 80, "Textos/Texto_%d.txt", i);
    if(Texto[i][textoExiste] == 1)
    {
        if(!DOF2_FileExists(file)) DOF2_CreateFile(file);
        DOF2_SetString(file, "textoFonte", Texto[i][textoFonte]);
	    DOF2_SetString(file, "textoTexto", Texto[i][textoTexto]);
		DOF2_SetFloat(file, "textoX", Texto[i][textoX]);
		DOF2_SetFloat(file, "textoY", Texto[i][textoY]);
		DOF2_SetFloat(file, "textoZ", Texto[i][textoZ]);
		DOF2_SetFloat(file, "textoRX", Texto[i][textoRX]);
		DOF2_SetFloat(file, "textoRY", Texto[i][textoRY]);
		DOF2_SetFloat(file, "textoRZ", Texto[i][textoRZ]);
		DOF2_SetInt(file, "textoCor", Texto[i][textoCor]);
		DOF2_SetInt(file, "textoTamanho", Texto[i][textoTamanho]);
		DOF2_SetInt(file, "textoMundo", Texto[i][textoMundo]);
		DOF2_SetInt(file, "textoInterior", Texto[i][textoInterior]);
		DOF2_SetInt(file, "textoAlinhamento", Texto[i][textoAlinhamento]);
        DOF2_SaveFile();
    }
    else if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
}

stock SetarNickPlayer(playerid)
