	if(!strcmp(cmd, "/consertarcaixa", true))
	{
	    if(!PlayerCop(playerid)) return ms(playerid, 0, "Voce nao e policial !");
	    if(!EmServico(playerid)) return ms(playerid, 0, "Voce nao esta em servico !");
	    foreach(new cc:Iter_CaixasEletronicos)
	    {
	        if(CaixaEletronico[cc][ce_Existe] == 1)
	        {
	            if(GetPlayerInterior(playerid) == CaixaEletronico[cc][ce_Interior] && GetPlayerVirtualWorld_(playerid) == CaixaEletronico[cc][ce_Mundo])
	            {
	                if(IsPlayerInRangeOfPoint(playerid, 2.0, CaixaEletronico[cc][ce_X], CaixaEletronico[cc][ce_Y], CaixaEletronico[cc][ce_Z]))
	                {
	                    if(CaixaEletronico[cc][ce_Quebrado] == 1)
	                    {
	                        if(eletricista_tipo[playerid] == -1)
	                        {
	                            player_concertar(playerid, 0, cc);
	                            return 1;
	                        }
	                        else return ms(playerid, 0, "Voce ja esta concertando algo !");
	                    }
	                    else return ms(playerid, 0, "Este caixa eletronico nao esta quebrado !");
	                }
	            }
	        }
	    }
	    ms(playerid, 0, "Nenhum caixa eletronico quebrado encontrado perto de voce !");
	    return 1;
	}

	if(!strcmp(cmd, "/ajudaportoes", true))
	{
		new sss[1000];
	    strcat(sss, "\n");
		strcat(sss, "\n");
		strcat(sss, "{ffffff}/criarportao {a1a1a1}para criar um novo portao.\n");
		strcat(sss, "{ffffff}/infoportao {a1a1a1}para ver informacoes de portao.\n");
		strcat(sss, "{ffffff}/modeloportao {a1a1a1}para setar o objeto do portao.\n");
		strcat(sss, "{ffffff}/portaofechado {a1a1a1}para editar a posicao do portao fechado.\n");
		strcat(sss, "{ffffff}/portaoaberto {a1a1a1}para editar a posicao do portao aberto.\n");
		strcat(sss, "{ffffff}/donoportao {a1a1a1}para setar o dono do portao aberto.\n");
		strcat(sss, "{ffffff}/empregoportao {a1a1a1}para setar o emprego do portao aberto.\n");
		strcat(sss, "{ffffff}/orgportao {a1a1a1}para setar a org de algum Portao.\n");
		strcat(sss, "{ffffff}/cargoportao {a1a1a1}para setar o Cargo do portao de uma Org.\n");
		strcat(sss, "{ffffff}/destruirportao {a1a1a1}para detruir um portao pelo id.\n");
		strcat(sss, "\n");
		strcat(sss, "\n");
