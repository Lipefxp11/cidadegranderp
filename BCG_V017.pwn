	if(!strcmp(cmd, "/ircaixaeletronico", true))
	{
	    new i;
	    new sss[300];
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /ircaixaeletronico [ ID do CAIXA ]");
		if(i < 0 || i >= MAX_CAIXAS_ELETRONICOS) return ms(playerid, 0, "ID de Caixa eletronico Invalido !");
		if(CaixaEletronico[i][ce_Existe] == 0) return ms(playerid, 0, "Este caixa eletronico nao existe !");
		SetPlayerPos_(playerid, CaixaEletronico[i][ce_X]+0.1, CaixaEletronico[i][ce_Y]+0.1, CaixaEletronico[i][ce_Z]+2);
		SetPlayerInterior(playerid, CaixaEletronico[i][ce_Interior]);
		SetPlayerVirtualWorld_(playerid, CaixaEletronico[i][ce_Mundo]);
		format(sss, 300, "Voce foi ate o caixa eletronico ID %d.", i);
		format(string_prox, 300, "** O admin '%s' foi ate o Caixa Eletronico ID: %d **", Nome(playerid), i);
		ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
		ms(playerid, 5, sss);
		return 1;
	}

	if(!strcmp(cmd, "/destruircaixaeletronico", true))
	{
	    new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /destruircaixaeletronico [ ID do CAIXA ]");
		if(i < 0 || i >= MAX_CAIXAS_ELETRONICOS) return ms(playerid, 0, "ID de Caixa eletronico Invalido !");
		if(CaixaEletronico[i][ce_Existe] == 0) return ms(playerid, 0, "Este caixa eletronico nao existe !");
		destruir_caixa_eletronico(i);
		new sss[300];
