		return 1;
	}

	if(!strcmp(cmd, "/nomeemprego", true))
	{
		new i, d[80];
		if(sscanf(params, "ds[80]", i, d)) return ms(playerid, 2, "Use: /tipoemprego [ ID emprego ] [ Nome ].");
		if(i < 0 || i >= MAX_EMPREGOS) return ms(playerid, 0, "Este emprego nao existe !");
		if(Emprego[i][e_Existe] == 0 ) return ms(playerid, 0, "Este emprego nao existe !");

		new sss[150];
	    format(sss, 150, "Voce setou para '%s' o Nome do emprego: %s [%d].", d, Emprego[i][e_Nome], i);
	    ms(playerid, 5, sss);
	    format(Emprego[i][e_Nome], 80, d);
	    salvar_emprego(i);
		return 1;
	}

	if(!strcmp(cmd, "/tipoemprego", true))
