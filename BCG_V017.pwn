stock texto_portao(i)
{
    if(IsValidDynamic3DTextLabel(Portao[i][p_3D])) DestroyDynamic3DTextLabel(Portao[i][p_3D]);
    Portao[i][p_3D] = DynamicText3D:-1;
    if(Portao[i][p_Existe] == 1)
	{
	    if(Portao[i][p_Aberto] == 0)
	    {
			new sss[300];
			if(Portao[i][p_Emprego] != -1) format(sss, 300, "Portao [%d]\nEmprego: %s\n\nAperte H para\nabrir", i, NomeEmprego(Portao[i][p_Emprego]));
			else if(Portao[i][p_Org] != -1) format(sss, 300, "Portao [%d]\nOrganizacao: %s\n\nAperte H para\nabrir", i, NomeOrg(Portao[i][p_Org]));
			else if(Portao[i][p_Dono] != -1) format(sss, 300, "Portao [%d]\nDono: %s\n\nAperte H para\nabrir", i, NomeConta(Portao[i][p_Dono]));
			else format(sss, 300, "Portao [%d]\n\nAperte H para\nabrir", i);
			Portao[i][p_3D] = CreateDynamic3DTextLabel(sss, 0xffffff99, Portao[i][p_X1], Portao[i][p_Y1], Portao[i][p_Z1], 7, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0,  Portao[i][p_Mundo], Portao[i][p_Interior], -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
		}
	}
}

stock atualizar_portao(i)
{
	Iter_Remove(Iter_Portoes, i);
	if(IsValidDynamicObject(Portao[i][p_Obj])) DestroyDynamicObject_(Portao[i][p_Obj]);
	if(Portao[i][p_Existe] == 1)
	{
	    Iter_Add(Iter_Portoes, i);
	    Portao[i][p_Obj] = CreateDynamicObject( Portao[i][p_Modelo], Portao[i][p_X1], Portao[i][p_Y1], Portao[i][p_Z1], Portao[i][p_RX1], Portao[i][p_RY1], Portao[i][p_RZ1], Portao[i][p_Mundo], Portao[i][p_Interior], -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
        if(Portao[i][p_Modelo] == 980)
		{
			SetDynamicObjectMaterial(Portao[i][p_Obj], 0, 19480, "signsurf", "sign", 0x00000000);
			SetDynamicObjectMaterial(Portao[i][p_Obj], 1, 19480, "signsurf", "sign", 0x00000000);
			SetDynamicObjectMaterial(Portao[i][p_Obj], 3, 19480, "signsurf", "sign", 0x00000000);
			SetDynamicObjectMaterial(Portao[i][p_Obj], 5, 19480, "signsurf", "sign", 0x00000000);
			SetDynamicObjectMaterial(Portao[i][p_Obj], 6, 19480, "signsurf", "sign", 0x00000000);
		}
		Portao[i][p_Aberto] = 0;
	}
	texto_portao(i);
}

stock NomeConta(i, con=-1)
{
	new name[MAX_PLAYER_NAME];
	format(name, MAX_PLAYER_NAME, "Ninguem");
	if(i == -123)
	{
	    format(name, MAX_PLAYER_NAME, "Radar ID: %d", con);
	    return name;
	}
	if(!ContaInvalida(i)) format(name, MAX_PLAYER_NAME, GetContaString(i, "c_Nick"));
	return name;
}

