stock MostrarFusionInv(playerid)
{
	if(GetPVarInt(playerid, "fusion_ptd_criado") == 0)
	{
		CriarFusionInvPlayer(playerid);
		SetPVarInt(playerid, "fusion_ptd_criado", 1);
	}
	for(new a; a<72; a++) TextDrawShowForPlayer(playerid, FusionInv[a]);
	for(new a; a<62; a++) PlayerTextDrawShow(playerid, FusionInvP[playerid][a]);
}

stock EsconderFusionInv(playerid)
{
	for(new a; a<72; a++) TextDrawHideForPlayer(playerid, FusionInv[a]);
	if(GetPVarInt(playerid, "fusion_ptd_criado") == 1)
	{
		for(new a; a<62; a++)
		{
			PlayerTextDrawDestroy(playerid, FusionInvP[playerid][a]);
			FusionInvP[playerid][a] = PlayerText:INVALID_TEXT_DRAW;
		}
		DeletePVar(playerid, "fusion_ptd_criado");
	}
}

// ===== FIM FusionInv.inc =====


