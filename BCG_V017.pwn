	if(!strcmp(cmd, "/destruirandar", true))
	{
		new i;
	    if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /destruirandar [ ID do elevador ] ( ira destruir o ultimo andar ).");
	    if(i < 0 || i >= MAX_ELEVADORES) return ms(playerid, 0, "ID de elevador invalido, tente de 0 a 19 !");
		if(Elevador[i][ele_Existe] == 0) return ms(playerid, 0, "Este elevador nao existe !");

		for(new a = 19; a>-1; a--)
		{
		    if(Elevador[i][ele_a_Existe][a] == 1)
		    {
		        Elevador[i][ele_a_Existe][a] = 0;
		        if(a == 0)
		        {
		            Elevador[i][ele_Existe] = 0;
		            KillTimer(Elevador[i][ele_Timer]);
					StopDynamicObject(Elevador[i][ele_Obj]);
					Elevador[i][ele_Andar] = 0;
		        	Elevador[i][ele_Status] = 0;
					atualizar_elevador(i);
					salvar_elevador(i);
					ms(playerid, 1, "Voce destruiu o unico andar do elevador e ele foi destruido !");
					return 1;
		        }
		        KillTimer(Elevador[i][ele_Timer]);
				StopDynamicObject(Elevador[i][ele_Obj]);
				Elevador[i][ele_Andar] = 0;
	        	Elevador[i][ele_Status] = 0;
				atualizar_elevador(i);
				salvar_elevador(i);
		        break;
		    }
		}
		KillTimer(Elevador[i][ele_Timer]);
		StopDynamicObject(Elevador[i][ele_Obj]);
		ms(playerid, 1, "Voce destruiu o ultimo andar do elevador !");
		return 1;
	}

	if(!strcmp(cmd, "/posicaoandar", true))
	{
		new i, a;
	    if(sscanf(params, "dd", i, a)) return ms(playerid, 2, "Use: /posicaoandar [ ID do elevador ] [ Andar ].");
	    if(i < 0 || i >= MAX_ELEVADORES) return ms(playerid, 0, "ID de elevador invalido, tente de 0 a 19 !");
		if(Elevador[i][ele_Existe] == 0) return ms(playerid, 0, "Este elevador nao existe !");
		if(a < 0 || a >= MAX_ANDARES) return ms(playerid, 0, "ID de andar invalido, tente de 0 a 19 !");
		if(Elevador[i][ele_a_Existe][a] == 0) return ms(playerid, 0, "Este Andar do elevador nao existe !");
		KillTimer(Elevador[i][ele_Timer]);
		StopDynamicObject(Elevador[i][ele_Obj]);
		Elevador[i][ele_Andar] = 0;
		Elevador[i][ele_Status] = 0;
		EditandoElevador[playerid] = i;
		andar_elevador[playerid] = a;
		EditDynamicObject2(playerid, Elevador[i][ele_Obj]);
		ms(playerid, 1, "Movimente o objeto usando o editor, e salve a posicao.");
		return 1;
	}

