		if(strlen(avi) > 198) return ms(playerid, 0, "Menssagem muito longa, tente novamente !");
		mst(-1, "{FF69B4}_________________ [ {FFFFFF}Aviso staff {FF69B4}] _________________");
	    format(sss, 300, "{FF69B4}%s {FFB6C1}[%s]: {FFFFFF}%s", Nome(playerid), Admin[AdminID(playerid)][adm_Funcao], avi);
	    mst(-1, sss);
		return 1;
