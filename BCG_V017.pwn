    	{
    	    if(ConesColocados[playerid] < 5)
    	    {
    			new Float:xxX,Float:yyY,Float:zzZ,Float:aaA;
    			GetPlayerPos(playerid, xxX, yyY, zzZ);
    			GetPlayerFacingAngle(playerid, aaA);
    			AdcCone(playerid, Float:xxX,Float:yyY,Float:zzZ,Float:aaA);
    		 	ConesColocados[playerid] += 1;
    		 	SSM(playerid, -1, "{BEBEBE}[SERVER] {FFFFFF}Cone {4169E1}Criado!");
