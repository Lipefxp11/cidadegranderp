		if(o < 0 || o >= MAX_CASAS) return ms(playerid, 0, "ID de Casa invalido !");
		if(Casa[o][casa_Existe] == 0) return ms(playerid, 0, "Esta Casa nao existe !");
		if(c < 0 || c >= MAX_CONTAS) return ms(playerid, 0, "ID de Conta invalido !");
		if(ContaInvalida(c)) return ms(playerid, 0, "Esta Conta nao existe !");
		Casa[o][casa_Dono] = c;
		atualizar_casa(o);
		salvar_casa(o);
		new sss[150];
		format(sss, 150, "Voce setou a conta '%s' [%d], como dono da Casa ID: %d.", NomeConta(c), c, o);
		ms(playerid, 5, sss);
		format(sss, 150, "'%s' lhe setou como dono da Casa ID: %d.", Nome(playerid), o);
		msc(c, 0xF08080ff, sss);
		return 1;
	}

