	if(!strcmp(cmd, "/criarcasa", true))
	{
		new valor, cash;
		if(sscanf(params, "dd", valor, cash)) return ms(playerid, 2, "Use: /criarcasa [ R$ Valor ] [ 0=Dinheiro / 1=Cash ]");
		if(GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld_(playerid) != 0) return ms(playerid, 0, "Voce nao pode criar uma casa em um interior !");
		if(valor < 1 || valor > 50000000) return ms(playerid, 0, "Use um valor entre 1 - 50.000.000 !");
		if(cash < 0 || cash > 1) return ms(playerid, 0, "Use 0 para dinheiro normal ou 1 para Cash VIP!");
		new Float:pos[3];
		GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
		new c = criar_casa(pos[0], pos[1], pos[2], 244.411987, 305.032989, 999.148437, 0, valor, 1, -1, cash);
		if(c == -1) return ms(playerid, 0, "Numero maximo de Casas do servidor atingido !");
		new sss[150];
		format(sss, 150, "Voce criou a Casa ID: %d, %s.", c, (cash == 1)?"Compravel com Cash":"Compravel com Dinheiro");
		ms(playerid, 5, sss);
		return 1;
	}

	if(!strcmp(cmd, "/destruircasa", true))
	{
	    new o;
		if(sscanf(params, "d", o)) return ms(playerid, 2, "Use: /destruircasa [ ID da Casa ]");
		if(o < 0 || o >= MAX_CASAS) return ms(playerid, 0, "ID de Casa invalido !");
		if(Casa[o][casa_Existe] == 0) return ms(playerid, 0, "Esta Casa nao existe !");
		destruir_casa(o);
