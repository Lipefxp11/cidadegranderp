	     				if(ID_menu == MENU_ELETRONICOS) format(sss, 150, "Voce comprou '%s %s' por R$ %s, confira seu inventario.", ConvertMoney(unidades), Menu_Eletronicos[listitem][mercado_Nome], ConvertMoney(valor));
