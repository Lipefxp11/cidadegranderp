		if(Org[s][o_Existe] == 0) return ms(playerid, 0, "Esta organizaco nao existe !");
		new i = criar_cadeia(pos[0], pos[1], pos[2], GetPlayerInterior(playerid), GetPlayerVirtualWorld_(playerid), s);
		if(i == -1) return ms(playerid, 0, "Numero maximo de cadeias atingido !");
