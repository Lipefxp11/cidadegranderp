	    {
	        if(Preso(i))
	        {
	            if(response)
	            {
	                if(GetPVarInt(playerid, "ajuste") > gettime())
	                {
	                    mostrar_ajuste(playerid, i, valor);
	                }
	            }
	            else
	            {
	                SetPVarInt(playerid, "ajuste", 0);
	                ShowPlayerDialog(i, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Ajuste de Pena", "\n{ff0000}[INFO] {A1A1A1}O advogado cancelou o ajuste !", "Ok", "Fechar");
					ms(playerid, 1, "Voce cancelou a oferta de ajuste !");
	            }
			}
			else ms(playerid, 0, "Este jogador nao esta mais Preso !");
	    }
	    else ms(playerid, 0, "O preso nao esta mais Online !");
	    return 1;
	}

	// aceitar ajuste //
	if(dialogid == DIALOG_PENA_ACEITAR)
	{
	    if(Preso(playerid))
	    {
	        new valor = GetPVarInt(playerid, "valor");
	        new i = GetPVarInt(playerid, "advogado");
	        if(Online(i))
	        {
		        if(response)
				{
					if(GranaPlayer(playerid) < valor)
					{
					    SetPVarInt(i, "ajuste", 0);
					    ms(playerid, 0, "Voce nao tem dinheiro em maos o suficiente !");
						ShowPlayerDialog(i, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Ajuste de Pena", "\n{ff0000}[INFO] {A1A1A1}O preso nao tem dinheiro o suficiente para aceitar o ajuste !", "Ok", "Fechar");
						return 1;
					}
					SetPVarInt(i, "ajuste", 0);
					ajustar_preso(playerid, i, valor);
					ShowPlayerDialog(i, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Ajuste de Pena", "\n{4169E1}[INFO] {A1A1A1}Ajuste de pena aceito !", "Ok", "Fechar");
		        	ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Ajuste de Pena", "\n{4169E1}[INFO] {A1A1A1}Ajuste de pena aceito !", "Ok", "Fechar");
					MetaEmprego(i);
				}
		        else
		        {
		            SetPVarInt(i, "ajuste", 0);
		            ms(playerid, 0, "Voce recusou a orferta de ajuste de pena !");
                    ShowPlayerDialog(i, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Ajuste de Pena", "\n{ff0000}[INFO] {A1A1A1}O preso recusou a oferta de ajuste !", "Ok", "Fechar");
		        }
	        }
	        else ms(playerid, 0, "O advogado nao esta mais Online !");
	    }
	    else ms(playerid, 0, "Voce nao esta mais preso !");
	    return 1;
	}

	// oferecer ajuste //
	if(dialogid == DIALOG_PENA)
	{
	    new i = GetPVarInt(playerid, "preso");
	    new a = GetPVarInt(playerid, "cadeia");
	    if(response)
	    {
   			if(strlen(inputtext) < 1)
			{
			    ms(playerid, 0, "Digite o valor corretamente !");
			    oferecer_ajuste(playerid, i);
			    return 1;
			}

			if(!IsNumeric(inputtext))
			{
			    ms(playerid, 0, "Digite apenas numeros !");
			    oferecer_ajuste(playerid, i);
			    return 1;
			}

			new cc = strval(inputtext);
			if(cc < 1 || cc > 50000)
			{
			    ms(playerid, 0, "Use um valor entre 1 e 50.000 !");
			    oferecer_ajuste(playerid, i);
			    return 1;
			}
			SetPVarInt(i, "advogado", playerid);
			SetPVarInt(playerid, "valor", cc);
			SetPVarInt(i, "valor", cc);
			SetPVarInt(playerid, "ajuste", gettime()+60);
			mostrar_ajuste(playerid, i, cc);
	    }
		else mostrar_presos_cadeia(playerid, a);
	    return 1;
	}

	// presos em certa cadeia //
	if(dialogid == DIALOG_PRESOS_CADEIA)
	{
	    if(response)
	    {
	        new a = GetPVarInt(playerid, "cadeia");
	        new i = Lista2[playerid][listitem];
	        if(i != -1)
	        {
	            if(Cadeia[a][ca_Existe] == 1)
	            {
	                if(Online(i))
	                {
	                    new cc = id[i];
	                    if(cc != -1)
	                    {
	                        if(Conta[i][c_Cadeia] == a)
	                        {
	                            if(Conta[i][c_TempoCadeia] > 0)
	                        	{
	                        	    if(Conta[i][c_Ajuste] == -1)
	                        	    {
										oferecer_ajuste(playerid, i);
									}
									else
									{
									    ms(playerid, 0, "Este jogador ja recebeu um ajuste de pena !");
									    mostrar_presos_cadeia(playerid, a);
									}
	                            }
	                            else ms(playerid, 0, "Este jogador nao esta mais preso !");
	                        }
	                        else ms(playerid, 0, "Este jogador nao esta mais preso !");
	                    }
	                }
	                else ms(playerid, 0, "Este preso nao esta mais Online !");
	            }
	        }
	    }
	    return 1;
	}


	// limpar ficha criminal //
	if(dialogid == DIALOG_LIMPAR)
	{
	    if(response)
	    {
	        if(strlen(inputtext) < 1)
	        {
	            ms(playerid, 0, "Digite o ID corretamente !");
	            abrir_limpar_ficha(playerid);
	            return 1;
	        }

	        if(!IsNumeric(inputtext))
	        {
	            ms(playerid, 0, "Digite apenas numeros !");
	            abrir_limpar_ficha(playerid);
	            return 1;
	        }
	        new cc = strval(inputtext);
	        if(cc < 0 || cc >= MAX_CONTAS)
	        {
         		ms(playerid, 0, "Digite um ID de CONTA valido !");
	            abrir_limpar_ficha(playerid);
	            return 1;
	        }

	        if(ContaInvalida(cc))
	        {
	            ms(playerid, 0, "Esta conta nao existe !");
	            abrir_limpar_ficha(playerid);
	            return 1;
	        }

			new player = ContaOnline(cc);
			if(Online(player))
			{
			    if(Conta[player][c_Procurado] == 0)
		        {
		            ms(playerid, 0, "Esta conta nao esta com niveis de procurado !");
		            abrir_limpar_ficha(playerid);
		            return 1;
		        }
			}
			else
			{
			    if(GetContaInt(cc, "c_Procurado") == 0)
				{
				ms(playerid, 0, "Esta conta nao esta com niveis de procurado !");
		            abrir_limpar_ficha(playerid);
		            return 1;
			    }
			}

	        abrir_limpar_ficha_motivo(playerid, cc);
	    }
	    return 1;
	}


	// limpar ficha criminal motivo //
	if(dialogid == DIALOG_LIMPAR_MOTIVO)
	{
	    if(response)
	    {
    		new cc = GetPVarInt(playerid, "conta");
	        if(strlen(inputtext) < 2)
	        {
	            ms(playerid, 0, "Motivo muito curto !");
	            abrir_limpar_ficha_motivo(playerid, cc);
	            return 1;
	        }
	        new pla = ContaOnline(cc);
	        if(Online(pla))
	        {
	            Conta[pla][c_Procurado] = 0;
             	SetPlayerWantedLevel(pla, 0);
	        }
	        salvar_conta(cc, 0, "c_Procurado", sv_int(0));

	        new sss[150];
	        format(sss, 150, "[FICHA] O oficial '%s' limpou a ficha de '%s' pelo motivo: %s.", Nome(playerid), NomeConta(cc), inputtext);
	        mscop(sss);
	        format(sss, 150, "[FICHA] O oficial '%s' limpou a sua ficha criminal.", Nome(playerid));
	        msc(cc, 5, sss);
	    }
	    else abrir_limpar_ficha(playerid);
	    return 1;
	}



	// lista do /su //
	if(dialogid == DIALOG_SU)
	{
	    if(response)
	    {
	        SetPVarInt(playerid, "su", listitem);
	        PlayersPerto(playerid, 30, 6);
	    }
	    return 1;
	}

    // editar cela da cadeia //
	if(dialogid == DIALOG_CADEIA6)
	{
	    new i = GetPVarInt(playerid, "id_cadeia");
	    new a = GetPVarInt(playerid, "id_cela");
	    if(response)
	    {
	        new sss[150];
	        // local //
	        if(listitem == 0)
	        {
	            if(Cadeia[i][ca_Cela_Existe][a] == 0)
	            {
	                ms(playerid, 0, "Esta cela da cadeia nao existe, crie ela primeiro !");
	                abrir_cela_cadeia(playerid, i, a);
	                return 1;
	            }
                GetPlayerPos(playerid, Cadeia[i][ca_Cela_X][a], Cadeia[i][ca_Cela_Y][a], Cadeia[i][ca_Cela_Z][a]);
                salvar_cadeia(i);
                format(sss, 150, "A posicao da cela [%d] da Cadeia ID: %d, foi salva no seu local atual !", a, i);
                ms(playerid, 1, sss);
                abrir_celas_cadeia(playerid, i);
	        }

	        // criar ou destruir //
	        if(listitem == 1)
	        {
				if(Cadeia[i][ca_Cela_Existe][a] == 0)
				{
				    Cadeia[i][ca_Cela_Existe][a] = 1;
				    GetPlayerPos(playerid, Cadeia[i][ca_Cela_X][a], Cadeia[i][ca_Cela_Y][a], Cadeia[i][ca_Cela_Z][a]);
				    ms(playerid, 1, "Voce criou esta cela da prisao.");
	                format(sss, 150, "A posicao da cela [%d] da Cadeia ID: %d, foi salva no seu local atual !", a, i);
	                ms(playerid, 1, sss);
	                abrir_celas_cadeia(playerid, i);
	                salvar_cadeia(i);
				}
				else
				{
				    Cadeia[i][ca_Cela_Existe][a] = 0;
				    Cadeia[i][ca_Cela_X][a] = 0;
				    Cadeia[i][ca_Cela_Y][a] = 0;
				    Cadeia[i][ca_Cela_Z][a] = 0;
	                format(sss, 150, "Voce destruiu a cela [%d] da Cadeia ID: %d.", a, i);
	                ms(playerid, 1, sss);
	                abrir_celas_cadeia(playerid, i);
	                salvar_cadeia(i);
				}
	        }

	        // ir ate a cela //
	        if(listitem == 2)
	        {
	            if(Cadeia[i][ca_Cela_Existe][a] == 0)
	            {
	                ms(playerid, 0, "Esta cela da cadeia nao existe, crie ela primeiro !");
	                abrir_cela_cadeia(playerid, i, a);
	                return 1;
	            }
                SetPlayerPos_(playerid, Cadeia[i][ca_Cela_X][a]+0.1, Cadeia[i][ca_Cela_Y][a]+0.1, Cadeia[i][ca_Cela_Z][a]+0.1);
				SetPlayerInterior(playerid, Cadeia[i][ca_Interior]);
				SetPlayerVirtualWorld_(playerid, Cadeia[i][ca_Mundo]);
				format(sss, 150, "Voce foi ate a cela [%d] da Cadeia ID: %d.", a, i);
    			ms(playerid, 1, sss);
    			abrir_celas_cadeia(playerid, i);
	        }

	    }
	    else abrir_celas_cadeia(playerid, i);
	    return 1;
