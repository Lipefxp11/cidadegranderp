}

forward CarregamentoTimer(playerid);
stock mostrar_tela_carregamento(playerid)
{
	TogglePlayerSpectating(playerid, true);
	SSM(playerid, 0x00000000, "");
	for(new i; i < 27; i++) TextDrawShowForPlayer(playerid, T_Carregamento[i]);
	PlayerTextDrawShow(playerid, CarregamentoP[playerid][0]);
	SetTimerEx("CarregamentoTimer", 4000, false, "i", playerid);
	PlayAudioStreamForPlayer(playerid, "https://stream.zeno.fm/htxgpam8ps8uv.mp3");
}
stock fechar_tela_carregamento(playerid)
{
	StopAudioStreamForPlayer(playerid);
	for(new i; i < 27; i++) TextDrawHideForPlayer(playerid, T_Carregamento[i]);
	PlayerTextDrawDestroy(playerid, CarregamentoP[playerid][0]);
	mostrar_plataforma_td(playerid);
}
public CarregamentoTimer(playerid)
{
	if(!IsPlayerConnected(playerid)) return;
	CarregamentoEtapa[playerid]++;
	if(CarregamentoEtapa[playerid] >= 5)
	{
		fechar_tela_carregamento(playerid);
		return;
	}
	new msg[64];
	switch(CarregamentoEtapa[playerid])
	{
		case 1: msg = "Carregando Cidade...";
		case 2: msg = "Carregando Veiculos...";
		case 3: msg = "Carregando Servidores...";
		case 4: msg = "Carregando Economia...";
	}
	PlayerTextDrawSetString(playerid, CarregamentoP[playerid][0], msg);
	SetTimerEx("CarregamentoTimer", 4000, false, "i", playerid);
}

public OnPlayerDisconnect(playerid, reason)
{
	if(Colocado[playerid] == true){
		new str[550];
		msc(playerid, 5, "Voce saiu do game no porta malas e foi preso.");
		format(str, sizeof(str), "{FFDC33}[CADEIA] O jogador %s[%d](%d) foi preso por ter deslogado no porta malas!", Nome(playerid), id[playerid], playerid);
		SendClientMessageToAll(-1, str);
        prender(playerid, 0, 1);
        GZ_EsconderGzPlayer(playerid, gz_policia);
        Colocado[playerid] = false;
	}
	if(player_algemado[playerid] == 1){
		new str[550];
		msc(playerid, 5, "Voce saiu do game algemado e foi preso.");
		format(str, sizeof(str), "{FFDC33}[CADEIA] O jogador %s[%d](%d) foi preso por ter deslogado algemado", Nome(playerid), id[playerid], playerid);
		SendClientMessageToAll(-1, str);
        prender(playerid, 0, 1);
        GZ_EsconderGzPlayer(playerid, gz_policia);
        player_algemado[playerid] = 0;
	}// player_algemado
    RecLig[playerid] = -1;
    EmLigacao[playerid] = -1;
	if(apenas_kikar[playerid] == 1) return 1;
	KillTimer(timer_uppp[playerid]);
	KillTimer(verificar_armas[playerid]);
	desconectar_blu(playerid);
	KillTimer(timer_radio[playerid]);
    CheckMarcado[playerid] = 0;
    if(JogadorCongelado[playerid] == 1){
        Controle(playerid, 1);
        JogadorCongelado[playerid] = 0;
        KillTimer(TimerFicarParado[playerid]);
    }
	// vendedor de roupas save //
	VR_Iniciar(playerid);
	if(IsValidActor(VR_Actor[playerid])) DestroyActor(VR_Actor[playerid]);
	if(IsValidDynamic3DTextLabel(VR_Label[playerid])) DestroyDynamic3DTextLabel(VR_Label[playerid]);
	if(IFOOD_Timer[playerid] != 0) KillTimer(IFOOD_Timer[playerid]);

	// actor player //
	if(IsValidDynamicActor(actor_player[playerid])) DestroyDynamicActor(actor_player[playerid]);
	if(IsValidDynamic3DTextLabel(actor_player_3D[playerid])) DestroyDynamic3DTextLabel(actor_player_3D[playerid]);
	actor_player_3D[playerid] = DynamicText3D:-1;
	actor_player[playerid] = -1;
	if(BikeAlugada[playerid] == 1)
    {
        BikeAlugada[playerid] = 0;
        DestroyVehicle(VeiculoCivil[playerid]);
    }
	// rc //
	if(RC[playerid] != -1)
    {
		if(GetVehicleModel(RC[playerid]) != 0)
		{
            DestroyVehicle_(RC[playerid]);
            RC[playerid] = -1;
		}
    }

    // removendo barreiras e cones
    if(ConesColocados[playerid] >= 1)
	{
		for(new i = 1; i < 11; i++)
		{
	 		DestroyObject(ConeOBJ[playerid][i]);
	 		ConesColocados[playerid] = 0;
	 	}
	}
    if(pRoadblock[playerid] != 0)
	{
		RemoveRoadblock(playerid);
	}

	/// tirar de veiculo ///
	if(IsPlayerInAnyVehicle(playerid))
	{
	    new veic = GetPlayerVehicleID(playerid);
	    if(GetVehicleModel(veic) != 0)
        {
            veiculo_desoculpado[veic] = 0;
            veiculo_desoculpado_tempo[veic] = 0;
        }
	}

	// mostrar online //
	if(VipPlayer(playerid) == 3) mostrar_online(playerid, 0);

	ArrastadoID[playerid] = -1;
	ArrastadoTT[playerid] = -1;
	AttArrastar[playerid] = -1;
	//////// timers /////////
    KillTimer(timer_spawn_player[playerid]);
	KillTimer(timer_congelado[playerid]);
	KillTimer(timer_morto[playerid]);
    KillTimer(timer_player[playerid]);
	KillTimer(timer_dano[playerid]);
	KillTimer(timer_celular[playerid]);
    SalvarArmas(playerid);
	// se kitar morto //
	new conta = id[playerid];
	if(conta != -1)
	{
		if(timer_kitar[playerid] > gettime())
		{
		    if(Conta[playerid][c_Morto] > 0)
		    {
			    new Float:ps[3];
			    // dropar colete //
			    if(Conta[playerid][c_Colete] > 0)
				{
				GetPlayerPos(playerid, ps[0], ps[1], ps[2]);
					ps[0] += RandomFloat2[random(sizeof RandomFloat2)];
					ps[1] += RandomFloat2[random(sizeof RandomFloat2)];
			    	criar_item(73, ps[0], ps[1], ps[2], 1, GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), Conta[playerid][c_Colete]);
			    }

			    // dropar grana //
			    new granS = GranaPlayer(playerid);
			    if(granS > 1000)
				{
				new porcentagem = (granS/100)*10;
			    	criar_item(49, ps[0], ps[1], ps[2], porcentagem, GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), 1);
					DarGrana(playerid, -porcentagem);
			    }

				ResetPlayerWeapons_(playerid);
				for(new i; i<13; i++)
				{
				    Conta[playerid][c_Arma][i] = 0;
				    Conta[playerid][c_Municao][i] = 0;
				}
				GetPlayerPos(playerid, ps[0], ps[1], ps[2]);
				SetarColete(playerid, 0);
				salvar_conta(conta, -1, "c_Armas");
				remocao_arma[playerid] = gettime()+5;
		    }
		}
	}

	// loop lento //
	fim_loop_lento(playerid, -1);

	// cinuca //
	if(player_cinuca[playerid] != -1) acabar_partida_cinuca(player_cinuca[playerid]);

    // sentado //
	em_anim[playerid] = 0;

    // revistando //
	revistando[playerid] = -1;

	// grana suja no chao //
	pegando_grana[playerid] = -1;

	// eletricista //
	eletricista_tipo[playerid] = -1;
	eletricista_ID[playerid] = -1;


	// cameras de seguranca //
	if(olhando_camera[playerid] != -1)
	{
	    sair_camera(playerid);
	}


    // atendimentos //
	if(atendimento_player[playerid] != -1 || atendimento_admin[playerid] != -1) comando(playerid, "/encerrar", "");
    for(new ii; ii<MAX_ATENDIMENTOS; ii++)
	{
	    if(Atendimento[ii][at_Existe] != 0)
     	{
	        if(Atendimento[ii][at_Player] == id[playerid])
	        {
				destruir_atendimento(ii);
				break;
			}
		}
	}

    // tutorial //
	player_tutorial[playerid] = -1;
	player_tutorial_tempo[playerid] = 0;

	// funcao pickup //
	funcao_usando[playerid] = -1;

	// advogado //
	if(GetPVarInt(playerid, "ajuste") >= gettime())
	{
	    SetPVarInt(playerid, "ajuste", 0);
	    new i = GetPVarInt(playerid, "preso");
	    desconectou_ajuste(playerid, i);
	}

	// academia //
	if(academia_player[playerid] != -1)
	{
		new a = academia_player[playerid];
	    Academia[a][aca_Player] = -1;
	    restaurar_aparelho(playerid, a);
	    texto_academia(a);
	}
    academia_player[playerid] = -1;
    fechar_academia(playerid);

    // emprego carro forte //
	zerar_cf(playerid);

	// sistema do hud do player //
	mostrando_hud[playerid] = 0;
	Arma_Player[playerid] = -1;

    // sistema de celular //
    cancelar_uber(playerid);
    cancelar_gps(playerid);
    parar_de_ouvir(playerid);

    // conta que o player ta //
    new c = id[playerid];

	// salvar player //
	if(logado[playerid] == 1)
	{
	    if(c != -1 && logado_full[playerid] == 1)
		{

		    // mostrar aos players proximos //
			if(tv_player[playerid] == -1)
			{
		    	if(reason == 0) format(sttr, 150, "** Jogador '%s' saiu do servidor por erro de conexao ou crash **", Nome(playerid));
			    if(reason == 1) format(sttr, 150, "** Jogador '%s' saiu do servidor por vontade propria **", Nome(playerid));
			    if(reason == 2) format(sttr, 150, "** Jogador '%s' saiu do servidor, kikado ou banido **", Nome(playerid));
				ProxDetector(30.0, playerid, sttr, 0xa1a1a1ff,0xa1a1a1ff,0xa1a1a1ff,0xa1a1a1ff,0xa1a1a1ff);
			}

            // morto //
		    if(GetPVarInt(playerid, "morto") != -1)
			{
			    new idd = GetPVarInt(playerid, "morto");
				if(Online(idd))
				{
				    if(id[idd] != -1)
					{
					new cc = id[idd];
					if(cc != -1)
					{
						    if(Conta[idd][c_Morto] > 0)
							{
						    	KillTimer(timer_morto[idd]);
						    	timer_morto[idd] = SetTimerEx("Morrendo", 1000, true, "d", idd);
						    }
					    }
				    }
				}
			}

		    // trade //
		    if(negociando[playerid] != -1)
		    {
		    	cancelar_trade(playerid);
		    }
		
			// player algemado //
			if(player_algemado[playerid] == 1)
		    {
				if(Conta[playerid][c_Procurado] > 0)
				{
				    msc(c, 5, "Voce saiu do jogo algemado e foi preso automaticamente !");
                    prender(playerid, 0, 1);
                    GZ_EsconderGzPlayer(playerid, gz_policia);
				}
		    }

			// voz de prisao //
		    if(GetPVarInt(playerid, "vdp") > gettime())
		    {
				if(Conta[playerid][c_Procurado] > 0)
				{
				    msc(c, 5, "Voce saiu do jogo com voz de prisao e foi preso automaticamente !");
                    prender(playerid, 0, 1);
                    GZ_EsconderGzPlayer(playerid, gz_policia);
				}
		    }

		    // salvar conta //
		    if(TestePlayer[playerid] == -1 && player_arena[playerid] == 0 && tv_player[playerid] == -1 && olhando_camera[playerid] == -1 && tunando[playerid] == 0)
			{
	            Conta[playerid][c_Interior] = GetPlayerInterior(playerid);
				Conta[playerid][c_Mundo] = GetPlayerVirtualWorld_(playerid);
				GetPlayerPos(playerid, Conta[playerid][c_X],Conta[playerid][c_Y],Conta[playerid][c_Z]);
				GetPlayerFacingAngle(playerid, Conta[playerid][c_A]);
				salvar_conta(c, -1, "c_Posicao");
				if(remocao_arma[playerid] < gettime()) salvar_conta(c, playerid, "c_Armas");
			}
			if(Conta[playerid][c_Pix] < 0) Conta[playerid][c_Pix] = 0;
			salvar_multas(c);
			salvar_conta(c, -1, "Desconectou");
	    }
	}


	/////// variaveis //////
	celular_aberto[playerid] = -1;
    logado[playerid] = 0;
	congelado[playerid] = 0;
	dbug_morreu[playerid] = 0;
	cidade_gas[playerid] = -1;
	entrega_gas[playerid] = -1;
	distancia_gas[playerid] = -1;
	anims_lastlib[playerid] = "\0";
	cidade_sedex[playerid] = -1;
	entrega_sedex[playerid] = -1;
	ID_Dancando[playerid] = -1;

	// teste de habilitacao //
	cancelar_teste(playerid, -1);

	// transferencia de veiculo //
	new negoc = GetPVarInt(playerid, "negociacao");
	if(vendendo_para[playerid] != -1)
	{
		if(negoc == 0) vendendo_veiculo(playerid, vendendo_para[playerid], 1000);
		if(negoc == 1) vendendo_casa(playerid, vendendo_para[playerid], 1000);
	}
	else
	{
		if(comprando_de[playerid] != -1)
		{
			if(negoc == 0) vendendo_veiculo(comprando_de[playerid], playerid, 2000);
			if(negoc == 1) vendendo_casa(comprando_de[playerid], playerid, 2000);
		}
	}

	// editando //
	EditandoAcessorioVeiculo[playerid] = -1;
    EditandoTexto[playerid] = -1;
    EditandoAcessorio[playerid] = -1;
    EditandoArvore[playerid] = -1;
    EditandoPedra[playerid] = -1;
    EditandoPortao[playerid] = -1;
    EditandoCaixaEletronico[playerid] = -1;
    EditandoObjeto[playerid] = -1;
    EditandoLixeiro[playerid] = -1;
    EditandoLanchonete[playerid] = -1;
    EditandoAcademia[playerid] = -1;
    EditandoMaquina[playerid] = -1;
    EditandoMovel[playerid] = -1;
    EditandoRadar[playerid] = -1;
    EditandoCamera[playerid] = -1;
    EditandoElevador[playerid] = -1;
    EditandoCinuca[playerid] = -1;
	for(new a; a<sizeof T_Telando_p[]; a++) PlayerTextDrawDestroy(playerid, T_Telando_p[playerid][a]);
	for(new a; a<sizeof T_InvNovo_p[]; a++) PlayerTextDrawDestroy(playerid, T_InvNovo_p[playerid][a]);
	for(new a; a<sizeof T_Caixinha_p[]; a++) PlayerTextDrawDestroy(playerid, T_Caixinha_p[playerid][a]);
	for(new a; a<sizeof T_Armas_p[]; a++) PlayerTextDrawDestroy(playerid, T_Armas_p[playerid][a]);
	for(new a; a<sizeof T_UltimaPos_p[]; a++) PlayerTextDrawDestroy(playerid, T_UltimaPos_p[playerid][a]);
	for(new a; a<sizeof T_Premio_p[]; a++) PlayerTextDrawDestroy(playerid, T_Premio_p[playerid][a]);
	for(new a; a<sizeof T_Fichas_p[]; a++) PlayerTextDrawDestroy(playerid, T_Fichas_p[playerid][a]);
	for(new a; a<sizeof T_CC_p[]; a++) PlayerTextDrawDestroy(playerid, T_CC_p[playerid][a]);
	for(new a; a<sizeof T_CC_Skin_p[]; a++) PlayerTextDrawDestroy(playerid, T_CC_Skin_p[playerid][a]);
	for(new a; a<sizeof T_CC_Idade_p[]; a++) PlayerTextDrawDestroy(playerid, T_CC_Idade_p[playerid][a]);
	for(new a; a<sizeof T_CC_Cidade_p[]; a++) PlayerTextDrawDestroy(playerid, T_CC_Cidade_p[playerid][a]);
	for(new a; a<sizeof T_CC_Nick_p[]; a++) PlayerTextDrawDestroy(playerid, T_CC_Nick_p[playerid][a]);
	for(new a; a<sizeof T_CC_Senha_p[]; a++) PlayerTextDrawDestroy(playerid, T_CC_Senha_p[playerid][a]);
	for(new a; a<sizeof T_Vip_p[]; a++) PlayerTextDrawDestroy(playerid, T_Vip_p[playerid][a]);
	for(new a; a<sizeof T_MS_p[]; a++) PlayerTextDrawDestroy(playerid, T_MS_p[playerid][a]);
	for(new a; a<sizeof CarregamentoP[]; a++) PlayerTextDrawDestroy(playerid, CarregamentoP[playerid][a]);
	for(new a; a<sizeof T_Taser_p[]; a++) PlayerTextDrawDestroy(playerid, T_Taser_p[playerid][a]);
	for(new a; a<sizeof T_LockPick_p[]; a++) PlayerTextDrawDestroy(playerid, T_LockPick_p[playerid][a]);
	for(new a; a<sizeof T_HudPlayer[]; a++) PlayerTextDrawDestroy(playerid, T_HudPlayer[playerid][a]);
	for(new a; a<sizeof T_Cadeia_Staff_p[]; a++) PlayerTextDrawDestroy(playerid, T_Cadeia_Staff_p[playerid][a]);
