	CreatePickup(1272, 1, IFOOD_X, IFOOD_Y, IFOOD_Z, 0);
	CreateDynamic3DTextLabel("iFood - Entregador\nUse /pegarlanches", 0xFF8800FF, IFOOD_X, IFOOD_Y, IFOOD_Z+1.0, 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0);
	CreatePickup(1239, 1, 2111.8855, -1932.2644, 17.0425, 0);
	CreateDynamic3DTextLabel("Deposito de Roupas\nUse /pegarestoque", 0xFFFFFFFF, 2111.8855, -1932.2644, 17.0425+1.0, 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0);
