stock abrir_armas_org(playerid, i)
{
    if(Org[i][o_Existe] == 1)
	{
        if(Online(playerid))
	    {
	        new sss1[150];
	        SG[0] = EOS;
	        strcat(SG, "Arma\tTipo\tQuantidades\tMunicao\n");
	        new display_idx;
	        for(new d; d<sizeof armas_org; d++)
	        {
	            if(is_arma_bloqueada(armas_org[d][0])) continue;
				new idmun = municao(armas_org[d][0]);
				if(idmun != -1)
				{
				    new corar[10], cormu[10];
				    if(Org[i][o_Armas][d] > 0) format(corar, 10, "00ff00");
				    else format(corar, 10, "ff0000");
				    if(Org[i][o_Municoes][idmun] > 0) format(cormu, 10, "00ff00");
				    else format(cormu, 10, "ff0000");
				    if(Org[i][o_Armas][d] > 0 && Org[i][o_Municoes][idmun] > 0)
					{
	                	format(sss1, 150, "{ffff00}%s\t{a1a1a1}%s\t{%s}%s\t{%s}%s\n",
						nome_arma(armas_org[d][0]), tipo_arma(armas_org[d][0]), corar, ConvertMoney(Org[i][o_Armas][d]), cormu, ConvertMoney(Org[i][o_Municoes][idmun]));
					}
					else
					{
						format(sss1, 150, "{ffffff}%s\t{a1a1a1}%s\t{%s}%s\t{%s}%s\n",
						nome_arma(armas_org[d][0]), tipo_arma(armas_org[d][0]), corar, ConvertMoney(Org[i][o_Armas][d]), cormu, ConvertMoney(Org[i][o_Municoes][idmun]));
					}
				}
                else
                {
                    new corar[10];
				    if(Org[i][o_Armas][d] > 0) format(corar, 10, "00ff00");
				    else format(corar, 10, "ff0000");
				    if(Org[i][o_Armas][d] > 0)
					{
                    	format(sss1, 150, "{ffff00}%s\t{a1a1a1}%s\t{%s}%s\t{a1a1a1}%s\n",
						nome_arma(armas_org[d][0]), tipo_arma(armas_org[d][0]), corar, ConvertMoney(Org[i][o_Armas][d]), "Nao usa");
					}
					else
					{
					    format(sss1, 150, "{ffffff}%s\t{a1a1a1}%s\t{%s}%s\t{a1a1a1}%s\n",
						nome_arma(armas_org[d][0]), tipo_arma(armas_org[d][0]), corar, ConvertMoney(Org[i][o_Armas][d]), "Nao usa");
					}
                }
				strcat(SG, sss1);
                Lista2[playerid][display_idx] = d;
                display_idx++;
	        }
	        ShowPlayerDialog(playerid, DIALOG_ORG14, DIALOG_STYLE_TABLIST_HEADERS, "Armas da Organizacao", SG, "Equipar", "Voltar");
	    }
	}
}

