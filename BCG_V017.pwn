						}
	                }
	            }
	            else ms(playerid, 0, "Nenhum veiculo esta posicionado no local de desmanche !");
	        }
	        else ms(playerid, 0, "Alguem ja esta desmanchando um veiculo no momento, aguarde e tente mais tarde !");
