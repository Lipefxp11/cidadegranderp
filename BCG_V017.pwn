		        new g = GetPVarInt(playerid, "gara");
		        if(g != -1)
		        {
				new v = Menu[playerid][listitem][menu_ID];
				if(v != -1)
				{
					Veiculo[v][v_Garagem] = 0;
					Veiculo[v][v_X] = Garagem[g][ga_X2];
					Veiculo[v][v_Y] = Garagem[g][ga_Y2];
					Veiculo[v][v_Z] = Garagem[g][ga_Z2];
					SalvarInfo(v);
						if(ModoAdmin[playerid] == 0)
						{
							if(Veiculo[v][v_Org] != -1) 
							{
								if(OrgPlayer(playerid) != Veiculo[v][v_Org]) return ms(playerid, 0, "Voce nao pertence a organizacao deste veiculo !");
		                    	if(Veiculo[v][v_Cargo] > Conta[playerid][c_Cargo]) return ms(playerid, 0, f("Voce precisa ser '%s' para pegar este veiculo !", nome_cargo(Veiculo[v][v_Cargo], Veiculo[v][v_Org])));
		                    }
						}
						if(flood_tirar_veiculo[v] > gettime()) return ms(playerid, 0, "AntFlood da garagem detectado, aguarde e tente novamente !");
						flood_tirar_veiculo[v] = gettime()+2;
						spawn_veiculo(v);
					MS(playerid, 1, "Voce pegou o veiculo da garagem.");
					SetPVarInt(playerid, "flood_garagem", gettime() + 2);
				    Localizar_Player(playerid, Veiculo[v][v_X], Veiculo[v][v_Y], Veiculo[v][v_Z], 564545, -1, "VEICULO", 1);
