stock opcao_item(playerid, idd)
{
	if(idd == 0) mostrar_Item_DCs(playerid);
	else
	{
	    new sss1[1000];
	    SetPVarInt(playerid, "iditem", idd);

	    if(idd == 69)
	    {
	        ShowPlayerDialog(playerid, DIALOG_ITENS2, DIALOG_STYLE_LIST, "Criar Caixa de Municao", "Municao de Pistola\nMunicao de Shotgun\nMunicao de Sub\nMunicao de Rifle\nMunicao de Sniper", "Criar", "Fechar");
		}
		else if(idd == 67)
	    {
	        sss1[0] = EOS;
	        for(new a; a<sizeof armas_org; a++)
	        {
	            strcat(sss1, "{ffffff}");
	            strcat(sss1, nome_arma(armas_org[a][0]));
	            strcat(sss1, "\n");
	        }
	        ShowPlayerDialog(playerid, DIALOG_ITENS2, DIALOG_STYLE_LIST, "Criar Caixa de Armas", sss1, "Criar", "Fechar");
		}
		else if(idd == 55)
	    {
	        mostrar_lista_acessorios(playerid);
		}
		else if(idd == 56)
	    {
            lista_veiculo_inv(playerid);
		}
		else if(idd == 57)
	    {
	        format(sss1, 200, "\n{00ffff}%s\n\n{4169E1}INFO: {ffffff}Digite o ID da Skin:\n{a1a1a1}Ao ser criada ela irar dropar proximo a voce.\n\n", NomeItem(idd));
	        ShowPlayerDialog(playerid, DIALOG_ITENS2, DIALOG_STYLE_INPUT, "Criar Skin", sss1, "Criar", "Fechar");
		}
		else
		{
			format(sss1, 200, "\n{00ffff}%s\n\n{4169E1}INFO: {ffffff}Digite as Unidades do Item:\n{a1a1a1}Ao ser criado ele irar dropar proximo a voce.\n\n", NomeItem(idd));
		    ShowPlayerDialog(playerid, DIALOG_ITENS2, DIALOG_STYLE_INPUT, "Criar Item", sss1, "Criar", "Fechar");
		}
	}
}

