	    Cadeia[i][ca_Existe] = 0;
		atualizar_cadeia(i);
		salvar_cadeia(i);
		new sss[150];
		format(sss, 150, "Voce destruiu a Cadeia ID: %d.", i);
		ms(playerid, 5, sss);
