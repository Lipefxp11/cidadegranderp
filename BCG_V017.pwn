stock PlayersPerto(playerid, range, opcao)
{
	new Float:pos[3];
	GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
	SetPVarInt(playerid, "p_opcao", opcao);
	SetPVarInt(playerid, "p_range", range);
	new cont;
	new sss[300];
	SG[0] = EOS;
	if(opcao == 5) strcat(SG, "Conta\tNome\tID\tProcurado\n");
	else strcat(SG, "Conta\tNome\tID\n");
	zerar_lista(playerid);
	foreach(new i:Player)
	{
	    if(cont >= MAX_LISTA || cont > 75) break;
		if(Online(i))
		{
		    if(i != playerid)
		    {
				if(id[i] != -1)
				{
				    if(ModoAdmin[i] == 1) continue;
	                if(opcao == 17) if(negociando[i] != -1) continue;
	                if(opcao == 15) if(!Amarrado(i)) continue;
	                if(opcao == 14) if(!Amarrado(i)) continue;
	                if(opcao == 13) if(Amarrado(i)) continue;
	                if(opcao == 10) if(!Algemado(i) || PlayerCop(i)) continue;
	                if(opcao == 9) if(Algemado(i) || PlayerCop(i)) continue;
	                if(opcao == 8 || opcao == 11 || opcao == 12) if(PlayerCop(i)) continue;

	                if(GetPlayerInterior(i) == GetPlayerInterior(playerid) && GetPlayerVirtualWorld_(i) == GetPlayerVirtualWorld_(playerid))
					{
				    	if(IsPlayerInRangeOfPoint(i, range, pos[0], pos[1], pos[2]))
				    	{
				        new c = id[i];
				        if(opcao == 5)
				        {
				            if(GetPVarInt(i, "vdp") < gettime())
				            {
					            format(sss, 300, "{00ffff}%d\t{ffffff}%s\t{ffff00}%d\t{a1a1a1}Nv: %d\n", c, Nome(i), i, Conta[i][c_Procurado]);
	                                Lista[playerid][cont] = i;
						        cont++;
						        strcat(SG, sss);
					        }
				        }
				        else
				        {
					        format(sss, 300, "{00ffff}%d\t{ffffff}%s\t{ffff00}%d\n", c, Nome(i), i);
					        Lista[playerid][cont] = i;
					        cont++;
					        strcat(SG, sss);
				        }
					}
				    }
				    else
					{
					if(player_arena[i] == 1)
					{
					    new ccc = id[i];
						if(ccc != -1)
						{
					       		if(GetPlayerInterior(playerid) == Conta[i][c_Interior] && GetPlayerVirtualWorld_(playerid) == Conta[i][c_Mundo])
					       	{
					            if(IsPlayerInRangeOfPoint(playerid, range, Conta[i][c_X], Conta[i][c_Y], Conta[i][c_Z]))
					            {
					                if(opcao == 5)
							        {
							            if(GetPVarInt(i, "vdp") < gettime())
							            {
								            format(sss, 300, "{00ffff}%d\t{ffffff}%s\t{ffff00}%d\t{a1a1a1}Nv: %d\n", ccc, Nome(i), i, Conta[i][c_Procurado]);
					                        Lista[playerid][cont] = i;
									        cont++;
									        strcat(SG, sss);
								        }
							        }
							        else
							        {
								        format(sss, 300, "{00ffff}%d\t{ffffff}%s\t{ffff00}%d\n", ccc, Nome(i), i);
								        Lista[playerid][cont] = i;
								        cont++;
								        strcat(SG, sss);
							        }
					            }
					       	}
						}
					}
				    }
				}
			}
		}
	}

	format(sss, 300, "{ffffff}Players por Perto {00ffff}[{ffffff}%d{00ffff}]", cont);
    ShowPlayerDialog(playerid, DIALOG_PLAYERS_PERTO, DIALOG_STYLE_TABLIST_HEADERS, sss, SG, "Continuar", "Fechar");
}


stock VeiculosPerto(playerid, range, opcao)
{
	new Float:pos[3];
	SetPVarInt(playerid, "v_opcao", opcao);
	SetPVarInt(playerid, "v_range", range);
	new cont;
	new sss[300];
	SG[0] = EOS;
	zerar_lista(playerid);
	strcat(SG, "Placa\tVeiculo\tDono\tID      tInfo\n");
	foreach(new i:Vehicles)
	{
	    if(cont >= MAX_LISTA || cont > 75) break;
		if(GetVehicleModel(i) != 0)
		{
		    if(Info_Veiculo[i] != -1)
			{
			    new v = Info_Veiculo[i];
			    GetVehiclePos(i, pos[0], pos[1], pos[2]);
			    if(IsPlayerInRangeOfPoint(playerid, range, pos[0], pos[1], pos[2]))
				{
		            if(GetVehicleVirtualWorld(i) == GetPlayerVirtualWorld_(playerid))
		            {
		                new donov[100];
		                if(Veiculo[v][v_Dono] != -1) format(donov, 100, NomeConta(Veiculo[v][v_Dono]));
		                else if(Veiculo[v][v_Emprego] != -1) format(donov, 100, Emprego[Veiculo[v][v_Emprego]][e_Nome]);
		                else if(Veiculo[v][v_Org] != -1) format(donov, 100, Org[Veiculo[v][v_Org]][o_Nome]);
		                else format(donov, 100, "Ninguem");
		                format(sss, 300, "{FFFFFF}%s\t{ffffff}%s\t{ffff00}%s\t{a1a1a1}%03d    {FFFFFF}%d\n", PlacaVeiculo[v], NomeVeiculo(Veiculo[v][v_Modelo]), donov,  i, v);
		                Lista[playerid][cont] = v;
		                cont++;
		                strcat(SG, sss);
					}
			    }
			}
		}
	}

	format(sss, 300, "{ffffff}Veiculos por Perto {00ffff}[{ffffff}%d{00ffff}]", cont);
    ShowPlayerDialog(playerid, DIALOG_VEICULOS_PERTO, DIALOG_STYLE_TABLIST_HEADERS, sss, SG, "Continuar", "Fechar");
}

stock Veiculos_Perto(playerid, v, opcao, resposta)
{
	new sss[300];

	// veiculos perto para concertar //
    if(opcao == 1)
	{
	    if(resposta == 1)
	    {
			if(v != -1)
			{
			    if(Veiculo[v][v_Existe] == 1)
				{
				new i = Veiculo[v][v_ID];
				if(i != -1)
				{
					SpawnVeiculo(i);
					format(sss, 300, "Voce spawnou o Veiculo: '%s' - Placa: '%s' - ID: %d - Info: %d.", NomeVeiculo(Veiculo[v][v_Modelo]), PlacaVeiculo[v], i, v);
				    ms(playerid, 4, sss);
		            }
	            }
            }
		}
	    else
	    {
	        // foi o comando /respawnveiculo nao fazer nada //
	    }
	}

	// outra opcao de veiculos //
    if(opcao == 2)
	{
	    if(resposta == 1)
	    {


	    }
	    else
	    {


	    }
	}

	return 1;
}

stock Players_Perto(playerid, i, opcao, resposta)
{

	new c = id[playerid];
	if(c != -1)
	{

		// players para mostrar documentos //
		if(opcao == 1)
		{
		    if(resposta == 1)
		    {
			    // mostrar rg //
			    if(GetPVarInt(playerid, "opcao_doc") == 0)
				{
					format(string_prox, 120, "? '%s' mostrou seu Documento de RG para '%s' ?",Nome(playerid), Nome(i));
					mostrar_rg(i, c);
				}

				// mostar cpf //
		    	if(GetPVarInt(playerid, "opcao_doc") == 1)
		    	{
					format(string_prox, 120, "? '%s' mostrou seu Documento de CPF para '%s' ?",Nome(playerid), Nome(i));
					mostrar_cpf(i, c);
				}

				// mostar cpf //
		    	if(GetPVarInt(playerid, "opcao_doc") == 2)
		    	{
					format(string_prox, 120, "? '%s' mostrou sua Habilitacao para '%s' ?",Nome(playerid), Nome(i));
					mostrar_habilitacao(i, c);
				}

				// mostar documento veiculo //
		    	if(GetPVarInt(playerid, "opcao_doc") == 3)
		    	{
		    	    new inf = GetPVarInt(playerid, "info2");
		    	    if(inf == -1)  carteira_player(playerid);
		    	    else
		    	    {
			    	    if(Veiculo[inf][v_Existe] == 0) carteira_player(playerid);
			    	    else
			    	    {
							format(string_prox, 120, "? '%s' mostrou o documento do veiculo '%s' para '%s' ?", Nome(playerid), NomeVeiculo(Veiculo[inf][v_Modelo]), Nome(i));
							mostrar_documento_veiculo(i, inf);
						}
					}
				}

				// mostar documento casa //
		    	if(GetPVarInt(playerid, "opcao_doc") == 4)
		    	{
		    	    new inf = GetPVarInt(playerid, "info2");
		    	    if(inf == -1)  carteira_player(playerid);
		    	    else
		    	    {
			    	    if(Casa[inf][casa_Existe] == 0) carteira_player(playerid);
			    	    else
			    	    {
					    	format(string_prox, 120, "** '%s' mostrou o documento da Casa '%d' para '%s' **", Nome(playerid), inf, Nome(i));
							mostrar_documento_casa(i, inf);
						}
					}
				}
		    	ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
	    	}
	    	else
	    	{
	    	    carteira_player(playerid);
	    	}
		}

		// comando de pagar um player perto  //
		if(opcao == 2)
		{
		    if(resposta == 1)
		    {
			    new valor = GetPVarInt(playerid, "valor");
			    if(GranaPlayer(playerid) < valor) ms(playerid, 0, "Voce nao tem esse valor em maos !");
				{
					DarGrana(i, valor);
					DarGrana(playerid, -valor);
					format(string_prox, 120, "** '%s' pagou R$ %s para '%s' **",Nome(playerid), ConvertMoney(valor), Nome(i));
					ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
				}
			}
			else ms(playerid, 0, "Voce cancelou o pagamento.");
		}

		// vender ou transferir veiculo //
		if(opcao == 3)
		{
		    if(resposta == 1)
		    {
		        if(vendendo_para[i] != -1 || comprando_de[i] != -1)
		        {
		            ms(playerid, 0, "Este jogador ja esta negociando no momento !");
		            transferencia_veiculo(playerid, GetPVarInt(playerid, "id_info2"));
		        }
				else
				{
					if(PodeComprarVeiculo(i, 1)) venda_veiculo(playerid, i, GetPVarInt(playerid, "id_info2"));
					else MS(playerid, 0, "Este jogador ja atinjiu o limite de Veiculos que ele pode ter !");
				}
		    }
		    else transferencia_veiculo(playerid, GetPVarInt(playerid, "id_info2"));
		}

		// mostrar nota de entrega  //
		if(opcao == 4)
		{
		    if(resposta == 1)
		    {
		        if(Online(i))
		        {
		        	mostrar_nota(playerid, i);
		        }
		    }
		    else comando(playerid, "/nota", "");
		}

	    // voz de prisao  //
		if(opcao == 5)
		{
		    if(resposta == 1)
		    {
		        if(Online(i))
		        {
		            if(GetPVarInt(playerid, "vdp") < gettime())
		            {
		                voz_de_prisao(playerid, i);
		            }
		            else ms(playerid, 0, "Este jogador ja recebeu voz de prisao recentemente, tente em 2 minutos !");
		        }
		    }
		}

		// aplicar /su no player  //
		if(opcao == 6)
		{
		    if(resposta == 1)
		    {
		        if(Online(i))
		        {
		            new a = GetPVarInt(playerid, "su");
	             	aplicar_su(i, playerid, a);
		        }
		    }
		    else mostrar_su(playerid);
		}

		// transferir casa  //
		if(opcao == 7)
		{
		    if(resposta == 1)
		    {
		        if(vendendo_para[i] != -1 || comprando_de[i] != -1)
		        {
		            ms(playerid, 0, "Este jogador ja esta negociando no momento !");
		            transferencia_casa(playerid, GetPVarInt(playerid, "id_info2"));
		        }
				else
				{
				    if(PodeComprarCasa(i, 1)) venda_casa(playerid, i, GetPVarInt(playerid, "id_info2"));
				    else MS(playerid, 0, "Este jogador ja atinjiu o limite de casas que pode ter !");
				}
		    }
		    else transferencia_casa(playerid, GetPVarInt(playerid, "id_info2"));
		}

		// abordar player  //
		if(opcao == 8)
		{
		    if(resposta == 1)
		    {
		    	abordar(playerid, i);
		    }
		}

		// algemar player  //
		if(opcao == 9)
		{
		    if(resposta == 1)
		    {
			    if(!Algemado(i))
				{
			    	algemar(playerid, i);
			    }
			    else ms(playerid, 0, "Este player ja esta algemado !");
		    }
		}

		// desalgemar player  //
		if(opcao == 10)
		{
		    if(resposta == 1)
		    {
			    if(Algemado(i))
				{
			    	desalgemar(playerid, i);
			    }
			    else ms(playerid, 0, "Este player nao esta algemado !");
		    }
		}

		// arrastar player  //
		if(opcao == 11)
		{
		    if(resposta == 1)
		    {
		        new ta;
			    new carro = GetPVarInt(playerid, "viatura");
			    if(GetVehicleModel(carro) != 0)
				{
				new sss[150];
				new Float:pos[3];
					GetVehiclePos(carro, pos[0], pos[1], pos[2]);
				    if(IsPlayerInRangeOfPoint(playerid, 4, pos[0], pos[1], pos[2]))
					{
					ta = 1;
					    if(!Arrastado(i))
						{
	        				if(IsPlayerInAnyVehicle(i)) ms(playerid, 0, "A pessoa nao pode estar em um veiculo !");
	        				else
	        				{
								new asento = asento_disponivel(carro);
							if(asento == 0) ms(playerid, 0, "Este veiculo ja esta com 2 pessoas nos bancos de tras !");
							else
							{
									player_arrastado[i] = carro;
									player_asento[i] = asento;
									PutPlayerInVehicle(i, carro, asento);
									format(sss, 150, "O policial '%s' lhe arrastou para a viatura.", Nome(playerid));
									ms(i, 2, sss);
									format(sss, 150, "Voce arrastou '%s' para a viatura.", Nome(i));
									ms(playerid, 2, sss);
									format(string_prox, 300, "** Policial '%s' arrastou '%s' para viatura **", Nome(playerid), Nome(i));
									ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
								}
							}
						}
					    else
						{
						player_arrastado[i] = -1;
						RemovePlayerFromVehicle(i);
						format(sss, 150, "O policial '%s' lhe retirou da viatura.", Nome(playerid));
							ms(i, 2, sss);
							format(sss, 150, "Voce retirou '%s' da viatura.", Nome(i));
							ms(playerid, 2, sss);
							format(string_prox, 300, "** Policial '%s' tirou '%s' da viatura **", Nome(playerid), Nome(i));
							ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
					    }
				    }
			    }
			    if(ta == 0) ms(playerid, 0, "Voce nao esta proximo a viaruta !");
		    }
		}

		// revistar player //
		if(opcao == 12)
		{
		    if(resposta == 1)
		    {
		        if(Conta[i][c_Nivel] < 3) return ms(playerid, 0, "Este jogador e level menor que 3, nao pode ser revistado!");
		    	revistar(playerid, i);
		    }
		}


		// amarrar player //
		if(opcao == 13)
		{
		    if(resposta == 1)
		    {
			    if(!Amarrado(i))
				{
			    	amarrar(playerid, i);
			    }
			    else ms(playerid, 0, "Este player ja esta amarrado !");
		    }
		}

		// desamarrar player //
		if(opcao == 14)
		{
		    if(resposta == 1)
		    {
			    if(Amarrado(i))
				{
			    	desamarrar(playerid, i);
			    }
			    else ms(playerid, 0, "Este player nao esta amarrado !");
		    }
		}

		// puxar player  //
		if(opcao == 15)
		{
		    if(resposta == 1)
		    {
		        new ta;
			    new carro = GetPVarInt(playerid, "viatura");
			    if(GetVehicleModel(carro) != 0)
				{
				new sss[150];
				new Float:pos[3];
					GetVehiclePos(carro, pos[0], pos[1], pos[2]);
				    if(IsPlayerInRangeOfPoint(playerid, 4, pos[0], pos[1], pos[2]))
					{
					ta = 1;
					    if(!Arrastado(i))
						{
	        				if(IsPlayerInAnyVehicle(i)) ms(playerid, 0, "A pessoa nao pode estar em um veiculo !");
	        				else
	        				{
							new asento = asento_disponivel(carro);
							if(asento == 0) ms(playerid, 0, "Este veiculo ja esta com 2 pessoas nos bancos de tras !");
							else
							{
									player_arrastado[i] = carro;
									player_asento[i] = asento;
									PutPlayerInVehicle(i, carro, asento);
									format(sss, 150, "O jogador '%s' puxou '%s' para o veiculo.", Nome(playerid), Nome(i));
									ms(i, 2, sss);
									format(sss, 150, "Voce puxou '%s' para o veiculo.", Nome(i));
									ms(playerid, 2, sss);
									format(string_prox, 300, "** Jogador '%s' puxou '%s' para o veiculo **", Nome(playerid), Nome(i));
									ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
								}
							}
						}
					    else
						{
						player_arrastado[i] = -1;
						RemovePlayerFromVehicle(i);
						format(sss, 150, "O Jogador '%s' lhe retirou do veiculo.", Nome(playerid));
							ms(i, 2, sss);
							format(sss, 150, "Voce retirou '%s' do veiculo.", Nome(i));
							ms(playerid, 2, sss);
							format(string_prox, 300, "** Jogador '%s' tirou '%s' do veiculo **", Nome(playerid), Nome(i));
							ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
					    }
				    }
			    }
			    if(ta == 0) ms(playerid, 0, "Voce nao esta proximo ao veiculo !");
		    }
		}

		// convidar cinuca //
		if(opcao == 16)
		{
            if(resposta == 1)
		    {
		        if(cinuca_convidou[i] != -1)
		        {
		            ms(playerid, 0, "Este jogador ja foi convidado recentemente !");
		            PlayersPerto(playerid, 10, 16);
		        }
		        else
		        {
		            cinuca_convidou[i] = playerid;
		            cinuca_tempo_convite[i] = 15;
		            format(string_prox, 120, "Voce foi convidado por '%s' para uma partida de sinuca.", Nome(playerid));
		            ms(i, 1, string_prox);
		            ms(i, 1, "Aperte Y proximo a sinuca para aceitar.");
		            format(string_prox, 120, "Voce convidou '%s' para uma partida de sinuca.", Nome(i));
		            ms(playerid, 1, string_prox);
		            ms(i, 1, "Aguarde 15 segundos por uma resposta.");
		            SetPVarInt(playerid, "flood_cin", gettime()+15);
		        }
			}
		}

		// negociar  //
		if(opcao == 17)
		{
			if(resposta == 1)
		    {
		    	convite_negociar(playerid, i);
		    }
		}

	}
	return 1;
}

stock asento_disponivel(carro)
{
	new asento1, asento2;
    foreach(new p:Player)
	{
	    if(GetPlayerVehicleID(p) == carro)
	    {
			new asento = GetPlayerVehicleSeat(p);
			if(asento == 3) asento1 = 1;
			if(asento == 4) asento2 = 1;
	    }
	}
	if(asento1 == 0) return 3;
	if(asento2 == 0) return 4;
	return 0;
}

stock PlayerCPF(playerid)
{
	new number;
	if(Online(playerid))
	{
		new c = id[playerid];
		if(c != -1)
		{
            number = Conta[playerid][c_CPF];
		}
	}
	return number;
}

stock PlayerRG(playerid)
{
	new number;
	if(Online(playerid))
	{
		new c = id[playerid];
		if(c != -1)
		{
            number = Conta[playerid][c_RG];
		}
	}
	return number;
}

stock iniciar_teste(playerid, tipo)
{
	new c = id[playerid];
	if(c != -1)
	{
	    Conta[playerid][c_Interior] = GetPlayerInterior(playerid);
		Conta[playerid][c_Mundo] = GetPlayerVirtualWorld_(playerid);
		GetPlayerPos(playerid, Conta[playerid][c_X],Conta[playerid][c_Y],Conta[playerid][c_Z]);
		GetPlayerFacingAngle(playerid, Conta[playerid][c_A]);

		new sss[150];
		format(sss, 150, "Voce nao tem R$ %s para iniciar o teste !", ConvertMoney(strval(Info_Teste[tipo][1])));

		// teste de moto //
		if(tipo == 0)
		{
			if(tem_habilitacao(playerid, tipo)) return ms(playerid, 0, "Voce ja possui habilitacao categoria A !");
			if(GranaPlayer(playerid) < strval(Info_Teste[tipo][1])) return ms(playerid, 0, sss);
	        if(!pode_teste(tipo)) return ms(playerid, 0, "Alguem ja esta fazendo o teste de moto no momento ! Aguarde.");
	        Conta[playerid][c_Interior] = GetPlayerInterior(playerid);
			Conta[playerid][c_Mundo] = GetPlayerVirtualWorld_(playerid);
			GetPlayerPos(playerid, Conta[playerid][c_X],Conta[playerid][c_Y],Conta[playerid][c_Z]);
			GetPlayerFacingAngle(playerid, Conta[playerid][c_A]);
	        salvar_conta(c, -1, "c_Posicao");
	        salvar_conta(c, playerid, "c_Armas");
			if(VeiculoTeste[playerid] != -1) DestruirVeiculo(VeiculoTeste[playerid], 1);
			VeiculoTeste[playerid] = CreateVehicle_(veiculos_teste[tipo], InicioTeste[tipo][0], InicioTeste[tipo][1], InicioTeste[tipo][2],InicioTeste[tipo][3], 1, 6, -1, 0);
			carro_de_teste[VeiculoTeste[playerid]] = tipo;
			TestePlayer[playerid] = tipo;
			TempoTeste[playerid] = 2*60;
			FaseTeste[playerid] = -1;
			CongeladoTeste[playerid] = -1;
			KillTimer(TimerTeste[playerid]);
	        SetPlayerVirtualWorld_(playerid, 8888);
	        SetPlayerInterior(playerid, 0);
	        SetPlayerPos_(playerid, -2025.9308,-136.9940,35.2907);
	        SetPlayerFacingAngle(playerid,180.2611);
	        SetCameraBehindPlayer(playerid);
	        TimerTeste[playerid] = SetTimerEx("teste_player", 1000, true, "d", playerid);
	        GZ_MostrarGzPlayer(playerid, GZ_PRETA);
	        SetVehicleVirtualWorld(VeiculoTeste[playerid], 8888);
	        DarGrana(playerid, -strval(Info_Teste[tipo][1]));
		}

		// teste de carro //
		if(tipo == 1)
		{
		    if(tem_habilitacao(playerid, tipo)) return ms(playerid, 0, "Voce ja possui habilitacao categoria B !");
		    if(!pode_teste(tipo)) return ms(playerid, 0, "Alguem ja esta fazendo o teste de carro no momento ! Aguarde.");
	        Conta[playerid][c_Interior] = GetPlayerInterior(playerid);
			Conta[playerid][c_Mundo] = GetPlayerVirtualWorld_(playerid);
			GetPlayerPos(playerid, Conta[playerid][c_X],Conta[playerid][c_Y],Conta[playerid][c_Z]);
			GetPlayerFacingAngle(playerid, Conta[playerid][c_A]);
	        salvar_conta(c, -1, "c_Posicao");
	        salvar_conta(c, playerid, "c_Armas");
			if(VeiculoTeste[playerid] != -1) DestruirVeiculo(VeiculoTeste[playerid]);
			VeiculoTeste[playerid] = CreateVehicle_(veiculos_teste[tipo], InicioTeste[tipo][0], InicioTeste[tipo][1], InicioTeste[tipo][2],InicioTeste[tipo][3], 1, 6, -1, 0);
			carro_de_teste[VeiculoTeste[playerid]] = tipo;
			TestePlayer[playerid] = tipo;
			TempoTeste[playerid] = 2*60;
			FaseTeste[playerid] = -1;
			CongeladoTeste[playerid] = -1;
			KillTimer(TimerTeste[playerid]);
	        SetPlayerVirtualWorld_(playerid, 9999);
	        SetPlayerInterior(playerid, 0);
	        SetPlayerPos_(playerid, -2027.1206,-122.5178,35.1894);
	        SetPlayerFacingAngle(playerid,183.9302);
	        SetCameraBehindPlayer(playerid);
	        TimerTeste[playerid] = SetTimerEx("teste_player", 1000, true, "d", playerid);
	        GZ_MostrarGzPlayer(playerid, GZ_PRETA);
	        SetVehicleVirtualWorld(VeiculoTeste[playerid], 9999);
	        DarGrana(playerid, -strval(Info_Teste[tipo][1]));
		}

		// teste de caminhao //
		if(tipo == 2)
		{
		    if(tem_habilitacao(playerid, tipo)) return ms(playerid, 0, "Voce ja possui habilitacao categoria C !");
	        if(!pode_teste(tipo)) return ms(playerid, 0, "Alguem ja esta fazendo o teste de caminhao no momento ! Aguarde.");
	        Conta[playerid][c_Interior] = GetPlayerInterior(playerid);
			Conta[playerid][c_Mundo] = GetPlayerVirtualWorld_(playerid);
			GetPlayerPos(playerid, Conta[playerid][c_X],Conta[playerid][c_Y],Conta[playerid][c_Z]);
			GetPlayerFacingAngle(playerid, Conta[playerid][c_A]);
	        salvar_conta(c, -1, "c_Posicao");
	        salvar_conta(c, playerid, "c_Armas");
			if(VeiculoTeste[playerid] != -1) DestruirVeiculo(VeiculoTeste[playerid]);
			VeiculoTeste[playerid] = CreateVehicle_(veiculos_teste[tipo], InicioTeste[tipo][0], InicioTeste[tipo][1], InicioTeste[tipo][2],InicioTeste[tipo][3], 6, 1, -1, 0);
			carro_de_teste[VeiculoTeste[playerid]] = tipo;
			TestePlayer[playerid] = tipo;
			TempoTeste[playerid] = 2*60;
			FaseTeste[playerid] = -1;
			CongeladoTeste[playerid] = -1;
			KillTimer(TimerTeste[playerid]);
	        SetPlayerVirtualWorld_(playerid, 7777);
	        SetPlayerInterior(playerid, 0);
	        SetPlayerPos_(playerid, -2028.5869,-124.8321,35.2183);
	        SetPlayerFacingAngle(playerid,180.7182);
	        SetCameraBehindPlayer(playerid);
	        TimerTeste[playerid] = SetTimerEx("teste_player", 1000, true, "d", playerid);
	        GZ_MostrarGzPlayer(playerid, GZ_PRETA);
	        SetVehicleVirtualWorld(VeiculoTeste[playerid], 7777);
	        DarGrana(playerid, -strval(Info_Teste[tipo][1]));
		}

		// teste de aviao //
		if(tipo == 3)
		{
	        if(tem_habilitacao(playerid, tipo)) return ms(playerid, 0, "Voce ja possui habilitacao categoria D !");
			if(GranaPlayer(playerid) < strval(Info_Teste[tipo][1])) return ms(playerid, 0, sss);
	        if(!pode_teste(tipo)) return ms(playerid, 0, "Alguem ja esta fazendo o teste de aviao no momento ! Aguarde.");
	        Conta[playerid][c_Interior] = GetPlayerInterior(playerid);
			Conta[playerid][c_Mundo] = GetPlayerVirtualWorld_(playerid);
			GetPlayerPos(playerid, Conta[playerid][c_X],Conta[playerid][c_Y],Conta[playerid][c_Z]);
			GetPlayerFacingAngle(playerid, Conta[playerid][c_A]);
	        salvar_conta(c, -1, "c_Posicao");
	        salvar_conta(c, playerid, "c_Armas");
			if(VeiculoTeste[playerid] != -1) DestruirVeiculo(VeiculoTeste[playerid]);
			VeiculoTeste[playerid] = CreateVehicle_(veiculos_teste[tipo], InicioTeste[tipo][0], InicioTeste[tipo][1], InicioTeste[tipo][2],InicioTeste[tipo][3], 1, 6, -1, 0);
			carro_de_teste[VeiculoTeste[playerid]] = tipo;
			TestePlayer[playerid] = tipo;
			TempoTeste[playerid] = 5*60;
			FaseTeste[playerid] = -1;
			CongeladoTeste[playerid] = -1;
			KillTimer(TimerTeste[playerid]);
	        SetPlayerVirtualWorld_(playerid, 5555);
	        SetPlayerInterior(playerid, 0);
	        SetPlayerPos_(playerid, -1432.3021,-72.2257,14.1484);
	        SetPlayerFacingAngle(playerid, 44.0751);
	        SetCameraBehindPlayer(playerid);
	        TimerTeste[playerid] = SetTimerEx("teste_player", 1000, true, "d", playerid);
	        GZ_MostrarGzPlayer(playerid, GZ_PRETA);
	        SetVehicleVirtualWorld(VeiculoTeste[playerid], 5555);
	        DarGrana(playerid, -strval(Info_Teste[tipo][1]));
		}

		// mostrar textdraws //
	    TextDrawShowForPlayer(playerid, T_Teste_Auto_Escola[0]);
	    TextDrawShowForPlayer(playerid, T_Teste_Auto_Escola[1]);
	    PlayerTextDrawShow(playerid, T_Teste_Auto_Escola_p[playerid][0]);
	    PlayerTextDrawShow(playerid, T_Teste_Auto_Escola_p[playerid][1]);
	    PlayerTextDrawShow(playerid, T_Teste_Auto_Escola_p[playerid][2]);
    }
	return 1;
}

BCG:: teste_player(playerid)
{
	if(Online(playerid))
	{
	    new c = id[playerid];
	    new tipo = TestePlayer[playerid];
		if(c != -1)
		{
			if(tipo != -1)
			{
			    if(TempoTeste[playerid] <= 0) cancelar_teste(playerid, 0);
			    else
				{

				    TempoTeste[playerid] --;
				    if(CongeladoTeste[playerid] > -1) CongeladoTeste[playerid] --;
				    if(!IsPlayerInAnyVehicle(playerid)) GameTextForPlayer(playerid, "~r~ENTRE NO VEICULO", 2000, 3);
					if(CongeladoTeste[playerid] > 0) GameTextForPlayer(playerid, "~y~AGUARDE", 2000, 3);

					new total_check;
					if(tipo == 0) total_check = sizeof PosTestesMoto;
					if(tipo == 1) total_check = sizeof PosTestesCarro;
					if(tipo == 2) total_check = sizeof PosTestesCaminhao;
					if(tipo == 3) total_check = sizeof PosTestesAviao;

					format(sttr, 300, "~w~CATEGORIA ~y~[ ~g~~h~%s ~y~]", Sigla[tipo]);
				    PlayerTextDrawSetString(playerid, T_Teste_Auto_Escola_p[playerid][0], sttr);
					format(sttr, 300, "~w~CHECKPOINT ~b~~h~~b~%d / %d", FaseTeste[playerid]+1, total_check);
				    PlayerTextDrawSetString(playerid, T_Teste_Auto_Escola_p[playerid][1], sttr);
					format(sttr, 300, "~w~TEMPO RESTANTE ~r~%s", ConvertTime(TempoTeste[playerid]));
				    PlayerTextDrawSetString(playerid, T_Teste_Auto_Escola_p[playerid][2], sttr);

				    // teste de moto //
					if(tipo == 0)
					{
	                    // descongelar depois do tempo e seguir //
					    if(CongeladoTeste[playerid] == 0)
						{
						    FaseTeste[playerid] ++;
					    	SetPlayerRaceCheckpoint(playerid, 0, PosTestesMoto[FaseTeste[playerid]][0],PosTestesMoto[FaseTeste[playerid]][1],PosTestesMoto[FaseTeste[playerid]][2], PosTestesMoto[FaseTeste[playerid]+1][0],PosTestesMoto[FaseTeste[playerid]+1][1],PosTestesMoto[FaseTeste[playerid]+1][2], 2);
							Descongelar(playerid);
							GameTextForPlayer(playerid, "~g~~h~CONTINUE", 2000, 3);
						}
					}

					// teste de carro //
					if(tipo == 1)
					{
	                    // descongelar depois do tempo e seguir //
					    if(CongeladoTeste[playerid] == 0)
						{
						    FaseTeste[playerid] ++;
					    	SetPlayerRaceCheckpoint(playerid, 0, PosTestesCarro[FaseTeste[playerid]][0],PosTestesCarro[FaseTeste[playerid]][1],PosTestesCarro[FaseTeste[playerid]][2], PosTestesCarro[FaseTeste[playerid]+1][0],PosTestesCarro[FaseTeste[playerid]+1][1],PosTestesCarro[FaseTeste[playerid]+1][2], 4);
							Descongelar(playerid);
							GameTextForPlayer(playerid, "~g~~h~CONTINUE", 2000, 3);
						}
					}

					// teste de caminhao //
					if(tipo == 2)
					{
	                    // descongelar depois do tempo e seguir //
					    if(CongeladoTeste[playerid] == 0)
						{
						    FaseTeste[playerid] ++;
					    	SetPlayerRaceCheckpoint(playerid, 0, PosTestesCaminhao[FaseTeste[playerid]][0],PosTestesCaminhao[FaseTeste[playerid]][1],PosTestesCaminhao[FaseTeste[playerid]][2], PosTestesCaminhao[FaseTeste[playerid]+1][0],PosTestesCaminhao[FaseTeste[playerid]+1][1],PosTestesCaminhao[FaseTeste[playerid]+1][2], 2);
							Descongelar(playerid);
							GameTextForPlayer(playerid, "~g~~h~CONTINUE", 2000, 3);
						}
					}
				}
			}
			else cancelar_teste(playerid, -1);
		}
		else cancelar_teste(playerid, -1);
	}
}

stock cancelar_teste(playerid, response)
{
	new sss[300];
    new c = id[playerid];
    new tipo = TestePlayer[playerid];
    KillTimer(TimerTeste[playerid]);
	if(VeiculoTeste[playerid] != -1) DestruirVeiculo(VeiculoTeste[playerid], 1);
	VeiculoTeste[playerid] = -1;
	TestePlayer[playerid] = -1;
	TempoTeste[playerid] = 0;
	FaseTeste[playerid] = 0;
	CongeladoTeste[playerid] = -1;
	GZ_EsconderGzPlayer(playerid, GZ_PRETA);

	// esconder textdraws //
    TextDrawHideForPlayer(playerid, T_Teste_Auto_Escola[0]);
    TextDrawHideForPlayer(playerid, T_Teste_Auto_Escola[1]);
    PlayerTextDrawHide(playerid, T_Teste_Auto_Escola_p[playerid][0]);
    PlayerTextDrawHide(playerid, T_Teste_Auto_Escola_p[playerid][1]);
    PlayerTextDrawHide(playerid, T_Teste_Auto_Escola_p[playerid][2]);

    if(c != -1)
	{
	    if(response == 1)
	    {
	        // setar habilitacao //
            if(!TemHabilitacao(playerid))
			{
				format(Conta[playerid][c_HD], 120, "%02d/%02d/%04d", DIA, MES, ANO);
				Conta[playerid][c_HP] = 0;
			}
            if(tipo != -1) Conta[playerid][c_H][tipo] = 1;
            Conta[playerid][c_HV] = gettime()+(30*UM_DIA);
            if(tipo != -1)format(sss, 300, "Teste da Categoria '%s' Concluido, Barabens !", Sigla[tipo]);
            ms(playerid, 4, sss);
            ms(playerid, 4, "Voce pode ver ou mostrar sua habilitacao usando a tecla N > Celular > Carteira a qualquer momento.");
            mostrar_habilitacao(playerid, c);
            salvar_conta(c, -1, "c_Habilitacao");
	    }

	    if(response == 0)
	    {
            ms(playerid, 0, "O teste acabou e voce foi reprovado !");
        }

	 	SetPlayerInterior(playerid, Conta[playerid][c_Interior]);
		SetPlayerVirtualWorld_(playerid, Conta[playerid][c_Mundo]);
		SetPlayerPos_(playerid, Conta[playerid][c_X]+0.1,Conta[playerid][c_Y]+0.1,Conta[playerid][c_Z]+0.1);
		SetPlayerFacingAngle(playerid, Conta[playerid][c_A]);
		Descongelar(playerid);
	}
}


stock pode_teste(tipo)
{
	if(tipo != -1)
	{
	    foreach(new i:Player)
	    {
	        if(Online(i))
	        {
	            if(TestePlayer[i] == tipo)
	            {
	                if(GetVehicleModel(VeiculoTeste[i]) != 0)
	                {
	                    return 0;
	                }
	            }
	        }
	    }
	}
	return 1;
}

stock TemVeiculo(playerid)
{
    new a = id[playerid];
    if(a == -1) return 0;
    foreach(new v:Iter_Veiculos)
    {
        if(Veiculo[v][v_Existe] == 1)
        {
            if(Veiculo[v][v_Dono] == a)
    		{
                return 1;
            }
        }
    }
    return 0;
}


stock TemCasa(playerid)
{
    new a = id[playerid];
    if(a == -1) return 0;
    foreach(new v:Iter_Casas)
    {
        if(Casa[v][casa_Existe] == 1)
        {
            if(Casa[v][casa_Dono] == a)
    		{
                return 1;
            }
        }
    }
    return 0;
}

stock mostrar_documento_veiculo(playerid, v)
{
	SG[0] = EOS;
	new string[300];

	if(v != -1)
	{
		if(Veiculo[v][v_Existe] == 1)
		{
		    new ipva[100];
		    if(Veiculo[v][v_IPVA] < 2) format(ipva, 100, "{ffff00}VENCE HOJE");
		    else format(ipva, 100, "{ffffff}%d DIAS", Veiculo[v][v_IPVA]);
            strcat(SG, "\n\n");
			strcat(SG, 			"{FFFFFF}                    REPUBLICA FEDERATIVA DO BRASIL\n");
    		strcat(SG, 			"{FFFFFF}                        MINISTERIO DAS CIDADES\n\n");
		    strcat(SG, 			"{7CCE5E}                               DETRAN ESTADUAL\n");
    		strcat(SG, 			"{7CCE5E} CERTIFICADO DE REGISTRO E LICENCIAMENTO DE VEICULO\n\n\n");
			format(string, sizeof(string),  "{AFAFAF}Placa: {FFFFFF}%s\t\t\t{AFAFAF}Chassi: {FFFFFF}%s\n\n", PlacaVeiculo[v], Veiculo[v][v_Chasi]);
    		strcat(SG, string);
			format(string, sizeof(string),  "{AFAFAF}Cor Predominante: {FFFFFF}%s\t\t{AFAFAF}Data FAB: {FFFFFF}%s\n\n", NomeCor(Veiculo[v][v_Cor1]), Veiculo[v][v_Data]);
    		strcat(SG, string);
			format(string, sizeof(string),  "{AFAFAF}Modelo: {FFFFFF}%s\t\t\t{AFAFAF}IPVA: %s\n\n", NomeVeiculo(Veiculo[v][v_Modelo]), ipva);
    		strcat(SG, string);
    		format(string, sizeof(string),  "{AFAFAF}Combustivel: {FFFFFF}%s\t\t{AFAFAF}Contas: {4169E1}R$ %s\n\n", Combustivel(Veiculo[v][v_TipoCombustivel]), ConvertMoney(Veiculo[v][v_Contas]));
    		strcat(SG, string);
            if(Veiculo[v][v_Dono] != -1) format(string, sizeof(string), "{AFAFAF}Dono: {FFFFFF}%s\n\n\n", NomeConta(Veiculo[v][v_Dono]));
            else if(Veiculo[v][v_Emprego] != -1) format(string, sizeof(string),  "{AFAFAF}Emprego: {FFFFFF}%s\n\n\n", Emprego[Veiculo[v][v_Emprego]][e_Nome]);
            else if(Veiculo[v][v_Org] != -1) format(string, sizeof(string),  "{AFAFAF}Organizacao: {FFFFFF}%s\n\n\n", Org[Veiculo[v][v_Emprego]][o_Nome]);
    		strcat(SG, string);
			ShowPlayerDialog(playerid, DIALOG_DOCUMENTO_VEICULO, DIALOG_STYLE_MSGBOX, "DETRAN ESTADUAL", SG, "Ok", "Informado");
			new strchasi[40];
			if(Veiculo[v][v_TemChasi] == 1) format(strchasi, 40, Veiculo[v][v_Chasi]);
			else format(strchasi, 40, "Desconhecido");
			format(string, sizeof(string), 	"Placa: [ %s ] - Chasi [ %s ].", PlacaVeiculo[v], strchasi);
			ms(playerid, 4, string);
		}
	}
}


stock mostrar_documento_casa(playerid, v)
{
	SG[0] = EOS;
	new string[300];

	if(v != -1)
	{
		if(Casa[v][casa_Existe] == 1)
		{
		    new ipva[100];
		    if(Casa[v][casa_Data] < 2) format(ipva, 100, "{ffff00}VENCE HOJE");
		    else format(ipva, 100, "{ffffff}%d DIAS", Casa[v][casa_Data]);

            strcat(SG, "\n\n");
			strcat(SG, 			"{FFFFFF}          REPUBLICA FEDERATIVA DO BRASIL\n");
    		strcat(SG, 			"{FFFFFF}                 MINISTERIO DAS CIDADES\n\n");
		    strcat(SG, 			"{7CCE5E}                   CARTORIO ESTADUAL\n");
    		strcat(SG, 			"{7CCE5E}  ESCRITURA DE PROPIEDADE PARTICULAR\n\n\n");
			format(string, sizeof(string),"\
			{AFAFAF}Propriedade: {FFFFFF}%s [%d]\n\
			{AFAFAF}Cidade: {FFFFFF}%s\n", tipo_casa(v), v, cidade(Casa[v][casa_Cidade]));
    		strcat(SG, string);
			format(string, sizeof(string),  "{AFAFAF}IPTU: %s\n\n", ipva);
    		strcat(SG, string);
			if(Casa[v][casa_Dono] != -1)
			{
				format(string, sizeof(string), "{AFAFAF}Dono: {FFFFFF}%s\n\n\n", NomeConta(Casa[v][casa_Dono]));
	            strcat(SG, string);
            }
			ShowPlayerDialog(playerid, DIALOG_DOCUMENTO_CASA, DIALOG_STYLE_MSGBOX, "GOVERNO DO ESTADO", SG, "Ok", "Informado");
			format(string, sizeof(string), 	"%s ID: [ %d ] - Cidade [ %s ].", tipo_casa(v), v,cidade(Casa[v][casa_Cidade]));
			ms(playerid, 4, string);
		}
	}
}


stock Combustivel(cor)
{
    new nameColor[15];
	switch(cor)
	{
	    case 0: format(nameColor, 15, "Gasolina");
	    case 1: format(nameColor, 15, "Alcool");
		case 2: format(nameColor, 15, "Oleo Disel");
		case 3: format(nameColor, 15, "Gas");
		default: format(nameColor, 15, "Nenhum");
	}
	return nameColor;
}

