	if(!strcmp(cmd, "/destruirportao", true))
	{
	    new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /destruirportao [ ID do PORTAO ]");
		if(i < 0 || i >= MAX_PORTOES) return ms(playerid, 0, "ID de portao Invalido !");
		if(Portao[i][p_Existe] == 0) return ms(playerid, 0, "Este portao nao existe !");
		new sss[300];
		format(sss, 300, "Voce destruiu o Portao ID %d.", i);
		ms(playerid, 5, sss);
		format(sss, 300, "O Admin '%s' destruiu o seu Portao ID %d.", Nome(playerid), i);
		if(Portao[i][p_Dono] != -1)
		{
		    new c = Portao[i][p_Dono];
		    new idd = ContaOnline(c);
		    if(Online(idd)) ms(idd, 0xF08080ff, sss);
		    else msc(c, 0xF08080ff, sss);
		}
		destruir_portao(i);
		return 1;
	}

	if(!strcmp(cmd, "/criarportao", true))
	{
		new model;
		new Float:pos[4];
		new c = id[playerid];
		if(c == -1) return 1;
		if(sscanf(params, "d", model)) return ms(playerid, 2, "Use: /criarportao [ ID do objeto ]");
		GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
		GetPlayerFacingAngle(playerid, pos[3]);
		PegarFrentePlayer(playerid, pos[0],pos[1], 3);
		new p = CriarPortao(pos[0], pos[1], pos[2], 0, 0, pos[3], model, -1, 0, GetPlayerInterior(playerid), GetPlayerVirtualWorld_(playerid));
		if(p == -1) return ms(playerid, 0, "Numero maximo de portoes no servidor atingido !");
		new sss[300];
		format(sss, 300, "Portao ID %d criado com sucesso !", p);
		ms(playerid, 5, sss);
		ms(playerid, 1, "Movimente o portao usando o editor de objeto e salve a posicao dele fechado.");
	    salvar_portao(p);
	    Streamer_Update(playerid);
		EditandoPortao[playerid] = p;
		SetPVarInt(playerid, "editando_portao", 0);
		EditDynamicObject2(playerid, Portao[p][p_Obj]);
		return 1;
	}

	if(!strcmp(cmd, "/criarobj", true))
	{
	    if(AdminPlayer(playerid) < 7) return ms(playerid, 0, "Apenas admin level 7+ !");
		new model, color;
		new Float:pos[4];
		if(sscanf(params, "dx", model, color)) color = 0;
		if(model == 0) return ms(playerid, 2, "Use: /criarobj [ ID do objeto ] [ Cor ARGB (opicional) ]\nEx: /criarobj 19375 0xFF00FFFF");
		GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
		GetPlayerFacingAngle(playerid, pos[3]);
		PegarFrentePlayer(playerid, pos[0], pos[1], 3);
		new p = CriarObjeto(model, pos[0], pos[1], pos[2], 0, 0, pos[3], GetPlayerInterior(playerid), GetPlayerVirtualWorld_(playerid));
		if(p == -1) return ms(playerid, 0, "Numero maximo de objetos no servidor atingido !");
		if(color != 0)
		{
			Objeto[p][o_MatModel] = 19381;
			format(Objeto[p][o_MatTxd], 32, "wall");
			format(Objeto[p][o_MatTex], 32, "wall_128");
			Objeto[p][o_MatColor] = color;
			SetDynamicObjectMaterial(Objeto[p][o_Obj], 0, Objeto[p][o_MatModel], Objeto[p][o_MatTxd], Objeto[p][o_MatTex], Objeto[p][o_MatColor]);
		}
		ms(playerid, 5, f("Objeto ID %d criado com sucesso !", p));
		ms(playerid, 1, "Movimente o objeto usando o editor e salve a posicao.");
		salvar_objeto(p);
		Streamer_Update(playerid);
		EditandoObjeto[playerid] = p;
		EditDynamicObject2(playerid, Objeto[p][o_Obj]);
		return 1;
	}

	if(!strcmp(cmd, "/moverobj", true))
	{
	    if(AdminPlayer(playerid) < 7) return ms(playerid, 0, "Apenas admin level 7+ !");
		new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /moverobj [ ID do Objeto ]");
		if(i < 0 || i >= MAX_OBJETOS) return ms(playerid, 0, "ID de objeto invalido !");
		if(Objeto[i][o_Existe] == 0) return ms(playerid, 0, "Este objeto nao existe !");
		Streamer_Update(playerid);
		EditandoObjeto[playerid] = i;
		EditDynamicObject2(playerid, Objeto[i][o_Obj]);
		ms(playerid, 1, "Movimente o objeto usando o editor e salve a posicao.");
		return 1;
	}

	if(!strcmp(cmd, "/objetos", true))
	{
	    if(AdminPlayer(playerid) < 7) return ms(playerid, 0, "Apenas admin level 7+ !");
		new cont;
		SG[0] = EOS;
		zerar_lista(playerid);
		new Float:distt, Float:pp[3];
		GetPlayerPos(playerid, pp[0], pp[1], pp[2]);
		strcat(SG, "ID\tModelo\tDistancia\n");
		foreach(new a:Iter_Objetos)
		{
		    if(cont >= MAX_LISTA) break;
		    GetDistance(distt, Objeto[a][o_X], Objeto[a][o_Y], Objeto[a][o_Z], pp[0], pp[1], pp[2]);
		    format(SG, sizeof SG, "%s%d\t%d\t%.0f Metros\n", SG, a, Objeto[a][o_Modelo], distt);
		    Lista[playerid][cont] = a;
		    cont++;
		}
		if(cont == 0) return ms(playerid, 0, "Nenhum objeto criado !");
		ShowPlayerDialog(playerid, DIALOG_OBJETOS, DIALOG_STYLE_TABLIST_HEADERS, "Objetos", SG, "Ir", "Fechar");
		return 1;
	}

	if(!strcmp(cmd, "/irobj", true))
	{
	    if(AdminPlayer(playerid) < 7) return ms(playerid, 0, "Apenas admin level 7+ !");
		new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /irobj [ ID do Objeto ]");
		if(i < 0 || i >= MAX_OBJETOS) return ms(playerid, 0, "ID de objeto invalido !");
		if(Objeto[i][o_Existe] == 0) return ms(playerid, 0, "Este objeto nao existe !");
		SetPlayerPos_(playerid, Objeto[i][o_X], Objeto[i][o_Y], Objeto[i][o_Z]+1);
		SetPlayerInterior(playerid, Objeto[i][o_Interior]);
		SetPlayerVirtualWorld_(playerid, Objeto[i][o_Mundo]);
		ms(playerid, 1, f("Teleportado para o Objeto ID %d.", i));
		return 1;
	}

	if(!strcmp(cmd, "/destruirobj", true))
	{
