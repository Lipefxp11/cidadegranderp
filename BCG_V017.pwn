stock salvar_fabricacao()
{
    new file[60];
    new str[500];
    new str2[80];

    // municoes //
    format(file, 60, "Fabricacoes/Coletes.txt");
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
    DOF2_CreateFile(file);
    format(str, 500, "%d|%d|%d|%d|%d|%d|%d|", coletes_org[0][0], coletes_org[0][1], coletes_org[0][2], coletes_org[0][3], coletes_org[0][4], coletes_org[0][5], coletes_org[0][6]);
    DOF2_SetString(file, "Colete_0", str );
    DOF2_SaveFile();

	// municoes //
	format(file, 60, "Fabricacoes/Municoes.txt");
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
    DOF2_CreateFile(file);
	for(new a; a < sizeof municoes_org; a++)
	{
	    format(str2, 80, "Municao_%d", a);
	    format(str, 500, "%d|%d|%d|%d|%d|%d|%d|", municoes_org[a][0], municoes_org[a][1], municoes_org[a][2], municoes_org[a][3], municoes_org[a][4], municoes_org[a][5], municoes_org[a][6]);
	    DOF2_SetString(file, str2, str);
	}
    DOF2_SaveFile();

    // armas //
	format(file, 60, "Fabricacoes/Armas.txt");
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
    DOF2_CreateFile(file);
	for(new a; a < sizeof armas_org; a++)
	{
	    format(str2, 80, "Arma_%d", a);
	    format(str, 500, "%d|%d|%d|%d|%d|%d|%d|", armas_org[a][0], armas_org[a][1], armas_org[a][2], armas_org[a][3], armas_org[a][4], armas_org[a][5], armas_org[a][6]);
	    DOF2_SetString(file, str2, str);
	}
    DOF2_SaveFile();
}

BCG:: carregar_fabricacoes()
{
    new file[60];
    new str[600];
    new str2[80];
	format(file, 60, "Fabricacoes/Coletes.txt");
	if(DOF2_FileExists(file))
	{
	    format(str2, 80, "Colete_0");
	    format(str, 500, "%s", DOF2_GetString(file, str2));
	    split_linha(str, strlen(str));
	    coletes_org[0][0] = strval(split[0]);
	    coletes_org[0][1] = strval(split[1]);
	    coletes_org[0][2] = strval(split[2]);
	    coletes_org[0][3] = strval(split[3]);
	    coletes_org[0][4] = strval(split[4]);
	    coletes_org[0][5] = strval(split[5]);
	    coletes_org[0][6] = strval(split[6]);
	}

	format(file, 60, "Fabricacoes/Municoes.txt");
	if(DOF2_FileExists(file))
	{
	    for(new a; a<sizeof municoes_org; a++)
	    {
	        format(str2, 80, "Municao_%d", a);
		    format(str, 500, "%s", DOF2_GetString(file, str2));
		    split_linha(str, strlen(str));
		    municoes_org[a][0] = strval(split[0]);
			municoes_org[a][1] = strval(split[1]);
		    municoes_org[a][2] = strval(split[2]);
		    municoes_org[a][3] = strval(split[3]);
		    municoes_org[a][4] = strval(split[4]);
		    municoes_org[a][5] = strval(split[5]);
		    municoes_org[a][6] = strval(split[6]);
		}
	}

	format(file, 60, "Fabricacoes/Armas.txt");
	if(DOF2_FileExists(file))
	{
	    for(new a; a<sizeof armas_org; a++)
	    {
	        format(str2, 80, "Arma_%d", a);
		    format(str, 500, "%s", DOF2_GetString(file, str2));
		    split_linha(str, strlen(str));
		    armas_org[a][0] = strval(split[0]);
			armas_org[a][1] = strval(split[1]);
		    armas_org[a][2] = strval(split[2]);
		    armas_org[a][3] = strval(split[3]);
		    armas_org[a][4] = strval(split[4]);
		    armas_org[a][5] = strval(split[5]);
		    armas_org[a][6] = strval(split[6]);
		}
	}

}


BCG:: carregar_info_veiculos()
{
	new file[60];
	for(new i; i<212; i++)
	{
	    format(file, 60, "Info_Veiculos/Veiculo_%d.txt", i);
	    if(DOF2_FileExists(file))
	    {
            format(info_veiculos[i][veh_Nome], 80, "%s", DOF2_GetString(file, "veh_Nome"));
            info_veiculos[i][veh_Combustivel] = DOF2_GetInt(file, "veh_Combustivel");
            info_veiculos[i][veh_Capacidade] = DOF2_GetInt(file, "veh_Capacidade");
            info_veiculos[i][veh_Velocidade] = DOF2_GetInt(file, "veh_Velocidade");
            info_veiculos[i][veh_PortaMalas] = DOF2_GetInt(file, "veh_PortaMalas");
            if(info_veiculos[i][veh_PortaMalas] == 0)
            {
                info_veiculos[i][veh_PortaMalas] = MAX_PORTA_MALAS;
            }
		}
	}
	print("** Informacoes dos veiculos carregadas.");
}

stock GetPlayerSpeed(playerid)
{
    new Float:ST[4];
    if(IsPlayerInAnyVehicle(playerid))
    GetVehicleVelocity(GetPlayerVehicleID(playerid),ST[0],ST[1],ST[2]);
    else GetPlayerVelocity(playerid,ST[0],ST[1],ST[2]);
    ST[3] = floatsqroot(floatpower(floatabs(ST[0]), 2.0) + floatpower(floatabs(ST[1]), 2.0) + floatpower(floatabs(ST[2]), 2.0)) * 190.0;
    return floatround(ST[3]);
}

stock menssagem_conta(c, cor, const mens[])
{
	if(c != -1)
	{
	    new file[80];
	    new sss1[40];
	    new sbt[300];
	    new sbt_tipo;
	    format(file, 80, "ChatOff/%d.txt", c);
	    if(DOF2_FileExists(file))
	    {
			for(new w; w<49; w++)
		    {
		        format(sss1, 40, "linha_%d", w+1);
		        format(sbt, 300, "%s", DOF2_GetString(file, sss1));
		        format(sss1, 40, "linha_%d", w);
		        DOF2_SetString(file, sss1, sbt);
		        format(sss1, 40, "linha_tipo_%d", w+1);
		        sbt_tipo = DOF2_GetInt(file, sss1);
		        format(sss1, 40, "linha_tipo_%d", w);
	            DOF2_SetInt(file, sss1, sbt_tipo);
		    }
			DOF2_SetString(file, "linha_49", mens);
			DOF2_SetInt(file, "linha_tipo_49", cor);
	        DOF2_SaveFile();
	    }
	    else
	    {
	        DOF2_CreateFile(file);
	        for(new w; w<49; w++)
		    {
		        format(sss1, 40, "linha_%d", w);
		        DOF2_SetString(file, sss1, " ");
		        format(sss1, 40, "linha_tipo_%d", w);
		        DOF2_SetInt(file, sss1, -1);
		    }
		    DOF2_SetString(file, "linha_49", mens);
			DOF2_SetInt(file, "linha_tipo_49", cor);
	        DOF2_SaveFile();
	    }
	}
}

stock menssagem_player(playerid, cor, const mensss[])
{
	if(Online(playerid))
	{
	    new mens[500];
		if(cor == 0)
		{
			format(mens, 500, "{FF4500}[!] {FF8C00}%s", mensss);
			SSM(playerid, -1, mens);
		}
        else if(cor == 1)
		{
			format(mens, 500, "{228B22}[!] {32CD32}%s", mensss);
			SSM(playerid, -1, mens);
		}
        else if(cor == 2)
		{
			format(mens, 500, "{4169E1}[!] {1E90FF}%s", mensss);
			SSM(playerid, -1, mens);
		}
		else if(cor == 3)
		{
			format(mens, 500, "{ADFF2F}%s", mensss);
			SSM(playerid, -1, mens);
		}
		else if(cor == 4)
		{
			format(mens, 500, "{DDA0DD}%s", mensss);
			SSM(playerid, -1, mens);
		}
		else if(cor == 5)
		{
			format(mens, 500, "{F0E68C}%s", mensss);
			SSM(playerid, -1, mens);
		}
        else
		{
			format(mens, 500, "%s", mensss);
			SSM(playerid, cor, mens);
        }
	}
}

stock abrir_celular(playerid)
{
	new c = id[playerid];
	if(c != -1)
	{
		if(player_arena[playerid] == 0)
		{
			if(player_algemado[playerid] == 0 && player_amarrado[playerid] == 0)
			{
				if(player_rendido[playerid] == 0)
				{
					if(player_arrastado[playerid] == -1)
					{
					    if(segurando_player[playerid] == -1)
						{
							if(Conta[playerid][c_Hospital] == 0)
							{
								if(GetPVarInt(playerid, "vdp") < gettime())
								{
									celular(playerid);
								}
							}
						}
					}
				}
			}
		}
	}
}

stock mostrar_loterica(playerid, con=0)
{
	new c = id[playerid];
	if(c != -1)
	{
		new linha[500];
		new ipva[100];
		SG[0] = EOS;

		// menu principal //
	    if(con == 0)
		{
		    strcat(SG, "{ffffff}Pagar Casa {a1a1a1} IPTU\n");
	        strcat(SG, "{ffffff}Pagar Veiculo {a1a1a1} IPVA\n");
	        strcat(SG, "{ffffff}Fazer Aposta  {a1a1a1}R$ ");
	        strcat(SG, ConvertMoney(premio_loteria));
	        strcat(SG, "\n");
	        strcat(SG, "{ffffff}Pagar Multas\n");
	        ShowPlayerDialog(playerid, DIALOG_LOTERICA, DIALOG_STYLE_LIST, "Loterica Caixa", SG, "Continuar", "Fechar");
		}

	    // contas dos veiculos //
	    if(con == 1)
	    {
			new cont;
			strcat(SG, "Info\tModelo\tIPVA\tVencimento\n");
            zerar_lista(playerid);
			foreach(new i:Iter_Veiculos)
			{
			    if(Veiculo[i][v_Existe] == 1)
				{
				if(Veiculo[i][v_Dono] == c)
				{
					    if(Veiculo[i][v_IPVA] < 2) format(ipva, 100, "{ffff00}VENCE HOJE");
					    else format(ipva, 100, "{ffffff}%d DIAS", Veiculo[i][v_IPVA]);
				    format(linha, 150, "{a1a1a1}%d\t{ffffff}%s\t{4169E1}R$ %s\t%s\n", i, NomeVeiculo(Veiculo[i][v_Modelo]), ConvertMoney(Veiculo[i][v_Contas]), ipva);
				    strcat(SG, linha);
				    Lista[playerid][cont] = i;
				    cont ++;
				}
			    }
			}
			format(linha, 150, "{ffffff}Veiculos {ffff00}[ {a1a1a1}%d {ffff00}]", cont);
			if(cont == 0) ms(playerid, 0, "Voce nao tem um veiculo Pessoal !"), mostrar_loterica(playerid);
			else ShowPlayerDialog(playerid, DIALOG_LOTERICA2, DIALOG_STYLE_TABLIST_HEADERS, linha, SG, "Pagar", "Voltar");
	    }

	    // fazer aposta //
	    if(con == 2)
	    {
	        if(Conta[playerid][c_Loteria] != 0)
	        {
	            format(linha, 150, "Voce ja possui um bilhete para o proximo sorteio ! Numero: %05d.", Conta[playerid][c_Loteria]);
	            ms(playerid, 2, linha);
	            mostrar_loterica(playerid);
	        }
	        else
	        {
	        	new sorteio[50];
		        if(HORA == 23) format(sorteio, 50, "00:00");
		        else format(sorteio, 50, "%02d:00", HORA+1);
		        format(SG, 500, "\n\n{ffffff}Deseja comprar um bilhete por {4169E1}R$ %s {ffffff}?\n\n\
				{ffffff}Premio Acumulado: {4169E1}R$ %s\n\
				{ffffff}Sorteio: {a1a1a1}%s\n\n\n", ConvertMoney(BILHETE), ConvertMoney(premio_loteria), sorteio);
	            ShowPlayerDialog(playerid, DIALOG_LOTERICA3, DIALOG_STYLE_MSGBOX, "Loteria da Sorte", SG, "Pagar", "Voltar");
			}
		}

	    // contas das casas //
	    if(con == 3)
	    {
	        new cont;
			strcat(SG, "ID\tTipo\tIPTU\tVencimento\n");
			zerar_lista(playerid);
            foreach(new i:Iter_Casas)
			{
			    if(cont >= MAX_LISTA) break;
			    if(Casa[i][casa_Existe] == 1)
				{
				if(Casa[i][casa_Dono] == c)
				{
					    if(Casa[i][casa_Data] < 2) format(ipva, 100, "{ffff00}VENCE HOJE");
					    else format(ipva, 100, "{ffffff}%d DIAS", Casa[i][casa_Data]);
				    format(linha, 150, "{a1a1a1}%d\t{ffffff}%s\t{4169E1}R$ %s\t%s\n", i, tipo_casa(i), ConvertMoney(Casa[i][casa_Contas]), ipva);
				    strcat(SG, linha);
				    Lista[playerid][cont] = i;
				    cont ++;
				}
			    }
	        }

	        format(linha, 150, "{ffffff}Casas {ffff00}[ {a1a1a1}%d {ffff00}]", cont);
			if(cont == 0) ms(playerid, 0, "Voce nao tem uma Casa ou Apartamento !"), mostrar_loterica(playerid);
			else ShowPlayerDialog(playerid, DIALOG_LOTERICA4, DIALOG_STYLE_TABLIST_HEADERS, linha, SG, "Pagar", "Voltar");
	    }


	    // multas //
	    if(con == 4)
	    {
	    	new cont;
			strcat(SG, "Data\tMotivo\tAplicou\tValor\n");
            for(new i; i<MAX_MULTAS; i++)
			{
			    if(cont >= MAX_LISTA) break;
			    zerar_lista(playerid);
			    if(Multas[playerid][i][mu_Existe] == 1)
				{
		            format(linha, 500, "{a1a1a1}%s\t{ffffff}%s\t{ffff00}%s\t{4169E1}R$ %s\n", Multas[playerid][i][mu_Data], Multas[playerid][i][mu_Motivo], NomeConta(Multas[playerid][i][mu_Conta], Multas[playerid][i][mu_Radar]), ConvertMoney(Multas[playerid][i][mu_Valor]));
		            strcat(SG, linha);
		            Lista[playerid][cont] = i;
		            cont ++;
			    }
	        }

	        format(linha, 150, "{ffffff}Multas {ffff00}[ {a1a1a1}%d {ffff00}]", cont);
			ShowPlayerDialog(playerid, DIALOG_LOTERICA5, DIALOG_STYLE_TABLIST_HEADERS, linha, SG, "Pagar", "Voltar");
	    }
	}
}

stock mostrar_estacoes(playerid)
{
	if(ID_DC[playerid] != ESTACOES_RADIO_ONLINE) Item_DC[playerid] = 0;
    format(Titulo_DC[playerid], 100, "ESTACOES ONLINE");
    format(Lista_DC[playerid][0][cel_Nome], 100, "~p~~h~COLOCAR LINK");
    for(new i; i<sizeof Estacoes; i++) format(Lista_DC[playerid][i+1][cel_Nome], 100, Estacoes[i][0]);
    MAX_DC[playerid] = sizeof Estacoes + 1;
    ID_DC[playerid] = ESTACOES_RADIO_ONLINE;
	Pagina_DC[playerid] = 0;
	Item_DC[playerid] = 0;
	celular(playerid, C_LISTA);
}

stock play_stop_radio(playerid, link_player[]="indalido")
{
	if(Status_Radio[playerid] == 0)
	{
	    // conectado em veiculo //
	    if(Blutuf_Tipo[playerid] == 0)
	    {
			new i = Blutuf_ID[playerid];
		 	Blutuf_Veiculo_Link[i] = -1;
		 	atualizar_ouvinte(0, i, -1);
	    }

	    // conectado em JBL //
	    else if(Blutuf_Tipo[playerid] == 1)
	    {
            new i = Blutuf_ID[playerid];
            JBL[i][jbl_Link] = -1;
            atualizar_ouvinte(1, i, -1);
            texto_jbl(i);
	    }
	    else StopAudioStreamForPlayer(playerid);
	}
	else
	{
	    // conectado em veiculo //
	    if(Blutuf_Tipo[playerid] == 0)
	    {
			new i = Blutuf_ID[playerid];
			if(Ouvindo_Radio[playerid] > -1)
	        {
				Blutuf_Veiculo_Link[i] = Ouvindo_Radio[playerid];
				atualizar_ouvinte(0, i, Ouvindo_Radio[playerid]);
			}
			else
			{
			    Blutuf_Veiculo_Link[i] = -555;
			    format(Blutuf_Veiculo_Linkp[i], 150, link_player);
			    atualizar_ouvinte(0, i, -555, link_player);
			}
	    }
	    // conectado em JBL //
	    else if(Blutuf_Tipo[playerid] == 1)
	    {
	        new i = Blutuf_ID[playerid];
	        if(Ouvindo_Radio[playerid] > -1)
	        {
	            JBL[i][jbl_Link] = Ouvindo_Radio[playerid];
	            atualizar_ouvinte(1, i, Ouvindo_Radio[playerid]);
            }
            else
            {
                JBL[i][jbl_Link] = -555;
                format(JBL[i][jbl_LinkPlayer], 150, link_player);
                atualizar_ouvinte(1, i, -555, link_player);
            }
            texto_jbl(i);
	    }
	    else if(Ouvindo_Radio[playerid] != -1)
		{
		    if(Ouvindo_Radio[playerid] > -1)
	        {
				PlayAudioStreamForPlayer(playerid, Estacoes[Ouvindo_Radio[playerid]][1]);
			}
			else
			{
			    PlayAudioStreamForPlayer(playerid, link_player);
			}
		}
	}
}

stock parar_de_ouvir(playerid)
{
	// resetar as variaveis //
    Ouvindo_Radio[playerid] = -1;
    Status_Radio[playerid] = 0;
    play_stop_radio(playerid);

    // desligar blutuf do veiculo //
    if(Blutuf_Tipo[playerid] == 0)
    {
        new i = Blutuf_Tipo[playerid];
        Blutuf_Veiculo_Link[i] = 0;
        Blutuf_Veiculo[i] = -1;
        Blutuf_Tipo[playerid] = -1;
        Blutuf_ID[playerid] = -1;
    }

    // desligar blutuf da jbl //
    if(Blutuf_Tipo[playerid] == 1)
    {
        Blutuf_Tipo[playerid] = -1;
        Blutuf_Tipo[playerid] = -1;
    }

    if(celular_aberto[playerid] == C_RADIO) celular(playerid, C_RADIO);
}


stock NomeEstacao(i)
{
	new nomeest[100];
	if(i == -555) format(nomeest, 100, "Link Perssonalizado");
	else if(i == -1) format(nomeest, 100, "Nenhuma");
	else format(nomeest, 100, Estacoes[i][0]);
	return nomeest;
}

stock mostrar_banco(playerid)
{
    new c = id[playerid];
	if(c != -1)
	{
	  	new srdp[100];
	  	format(srdp, 100, "R$ %s", ConvertMoney(Conta[playerid][c_Banco]));
	    if(mostrando_banco[playerid] == 0)
	    {
	        mostrando_banco[playerid] = 1;
	        for(new a; a<sizeof T_CaixaEletronico; a++) TextDrawShowForPlayer(playerid, T_CaixaEletronico[a]);
			PlayerTextDrawShow(playerid, T_CaixaEletronico_p[playerid][0]);
            SelectTextDraw(playerid, 0xffff00ff);
	    }
	    PlayerTextDrawSetString(playerid, T_CaixaEletronico_p[playerid][0], srdp);
	}
}


stock fechar_banco(playerid)
{
    if(mostrando_banco[playerid] == 1)
	{
	    mostrando_banco[playerid] = 0;
	    for(new a; a<sizeof T_CaixaEletronico; a++) TextDrawHideForPlayer(playerid, T_CaixaEletronico[a]);
		PlayerTextDrawHide(playerid, T_CaixaEletronico_p[playerid][0]);
		CancelSelectTextDraw(playerid);
	}
}

stock AbrirBanco(playerid, con)
{
	new c = id[playerid];
	if(c != -1)
	{

		new ce = GetPVarInt(playerid, "ce");

		// inicio //
		if(con == 0)
		{
			mostrar_banco(playerid);
		}

		// saldo na tela //
		if(con == 1)
		{
			new sss[300];
			format(sss, 300,
			"\n{ffffff}Ola {ffff00}%s{ffffff}, seu\n\
			saldo atual e de:\n\n\
			{4169E1}R$ %s\n\n\
			{00ffff}[Info] {ffffff}Voce tambem pode usar este valor para\n\
			fazer pagamentos via PIX diretamente do\n\
			aplicativo do banco em seu Celular.\n", Nome(playerid),ConvertMoney(Conta[playerid][c_Banco]));
			ShowPlayerDialog(playerid, DIALOG_BANCO7, DIALOG_STYLE_MSGBOX, "{00ffff}BANCO ITAU", sss, "Ok", "Voltar");
		}

		// transferencia //
		if(con == 2)
		{
		    if(opcao_transferir[playerid] == 0)
		    {
			    new sss[] = "\n{ffffff}Para efetuar uma transferencia bancaria, digite abaixo\no {ffff00}ID {ffffff}da {ffff00}Conta {ffffff}do player que irar receber o valor:\n\n";
			    ShowPlayerDialog(playerid, DIALOG_BANCO8, DIALOG_STYLE_INPUT, "{00ffff}TRANSFERENCIA", sss, "Continuar", "Voltar");
		    }
		    else
		    {
		        new str1[300];
		        new cc = GetPVarInt(playerid, "id_transferencia");
		        format(str1, 300,"\
				{ffffff}ID da Conta: {ffff00}%d\n\
				{ffffff}Nick: {00ffff}%s\n\n\
				{ffffff}Digite o {4169E1}R$ Valor {ffffff}que deseja transfer:\n", cc, NomeConta(cc));
		        ShowPlayerDialog(playerid, DIALOG_BANCO8, DIALOG_STYLE_INPUT, "{00ffff}TRANSFERENCIA", str1, "Transferir", "Voltar");
		    }
		}


		// deposito //
		if(con == 3)
		{
		    if(ce != -1)
		    {
		        if(GetPVarInt(playerid, "flood_deposito") > gettime()) MS(playerid, 0, "Voce nao pode fazer depositos com tanta frequencia, tente em alguns minutos !");
		        else if(CaixaEletronico[ce][ce_Dinheiro] >= 100000)  MS(playerid, 0, "Este Caixa eletronico ja tem muito dinheiro, tente outro ou va ate o Banco !");
                else
				{
					new sss[] = "\n{ffffff}Digite a quantia que deseja\ndepositar em sua conta bancaria:\n";
					ShowPlayerDialog(playerid, DIALOG_BANCO10, DIALOG_STYLE_INPUT, "{00ffff}DEPOSITO", sss, "Depositar", "Voltar");
				}
			}
			else
			{
			    if(GetPVarInt(playerid, "flood_deposito") > gettime()) MS(playerid, 0, "Voce nao pode fazer depositos com tanta frequencia, tente em alguns minutos !");
			    else
				{
					new sss[] = "\n{ffffff}Digite a quantia que deseja\ndepositar em sua conta bancaria:\n";
					ShowPlayerDialog(playerid, DIALOG_BANCO10, DIALOG_STYLE_INPUT, "{00ffff}DEPOSITO", sss, "Depositar", "Voltar");
				}
			}
		}

		// saque //
		if(con == 4)
		{
		    new sss[] = "\n{ffffff}Digite a quantia que deseja\nsacar de sua conta bancaria:\n";
			ShowPlayerDialog(playerid, DIALOG_BANCO12, DIALOG_STYLE_INPUT, "{00ffff}SAQUE", sss, "Sacar", "Voltar");
		}
	}
}

stock Banco(playerid, con)
{
	new c = id[playerid];
	if(c != -1)
	{
	    if(con == 1)
	    {
			if(Conta[playerid][c_Pix] <= 0)
			{
			    // inicio da criacao //
			    if(PlayerRG(playerid) == 0) ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}_", "\n{ffffff}Voce precisa tirar seu RG para criar sua conta Bancaria !\n", "Ok", "Fechar");
			    else if(PlayerCPF(playerid) == 0) ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}_", "\n{ffffff}Voce precisa tirar seu CPF para criar sua conta Bancaria !\n", "Ok", "Fechar");
			    else ShowPlayerDialog(playerid, DIALOG_BANCO1, DIALOG_STYLE_MSGBOX, "{000000}_", m_banco[0], "Criar", "Cancelar");
			}
		}
		else
		{
		    // finalizar //
		    new novopix;
		    new filee[80];
			for(new d; d<15; d++)
			{
			    novopix = 100000 + random(99999);
		    	format(filee, 80, "PIX/%d.txt", novopix);
			    if(!DOF2_FileExists(filee))
		    	{
				    Conta[playerid][c_Pix] = novopix;
					salvar_conta(c, 0, "c_Pix", sv_int(Conta[playerid][c_Pix]));
					ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}_", m_banco[1], "Continuar", "Cancelar");
					MS(playerid, 1, "Conta Bancaria criada com Sucesso, voce ja pode usar o Banco e os caixas eletronicos !");
	                DOF2_CreateFile(filee);
	                new sss[200];
	                DOF2_SetInt(filee, "ID_Conta", id[playerid]);
	                format(sss, 200, "%02d/%02d/%02d - %02d:%02d", DIA, MES, ANO, HORA, MINUTO);
					DOF2_SetString(filee, "Data_Criada", sss);
				DOF2_SaveFile();
				return 1;
				}
			}
			return 2;
		}
	}
	return 0;
}

