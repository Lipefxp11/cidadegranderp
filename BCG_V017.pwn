		strcat(SG, "{ffffff}/modeloveiculo {a1a1a1}Para mudar o Modelo de um Veiculo.\n");
		strcat(SG, "{ffffff}/copiarveiculo {a1a1a1}Para Copiar um veiculo que existe.\n");
