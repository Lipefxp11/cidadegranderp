	}

	// olx //
	if(con == C_OLX_ABRINDO)
	{
	    celular_aberto[playerid] = C_OLX_ABRINDO;
	    for(new b; b<sizeof T_Celular_OLX_Carregando; b++) TextDrawShowForPlayer(playerid, T_Celular_OLX_Carregando[b]);
	    timer_celular[playerid] = SetTimerEx("TimerCelular", 1250, false, "dd", playerid, C_OLX);
