// Compatibilidade local do antigo Editar.inc.
// Mantem somente as rotinas realmente usadas pela GM e evita conflito de prototipo.
new editando[MAX_PLAYERS];

stock EditDynamicObject2(playerid, objectid)
{
    editando[playerid] = 1;
    return EditDynamicObject(playerid, objectid);
}

stock EditAttachedObject2(playerid, index, modelid, boneid)
{
    #pragma unused modelid
    #pragma unused boneid
    editando[playerid] = 1;
    return EditAttachedObject(playerid, index);
}

stock editar_SetPlayerAttachedObject(playerid, index, modelid, boneid,
    Float:offsetX, Float:offsetY, Float:offsetZ,
    Float:rotX, Float:rotY, Float:rotZ,
    Float:scaleX, Float:scaleY, Float:scaleZ)
{
    return SetPlayerAttachedObject(playerid, index, modelid, boneid,
        offsetX, offsetY, offsetZ, rotX, rotY, rotZ, scaleX, scaleY, scaleZ);
}


// BCG SA-MP 0.3.7 compatibility: Nex-AC removed.
// Keeps the old admin configuration calls harmless until a compatible anticheat is installed.
stock EnableAntiCheat(type, enabled)
{
    #pragma unused type
    #pragma unused enabled
    return 1;
}

