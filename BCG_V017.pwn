	if(!strcmp(cmd, "/portaofechado", true))
	{
	    new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /portaofechado [ ID do PORTAO ]");
		if(i < 0 || i >= MAX_PORTOES) return ms(playerid, 0, "ID de portao Invalido !");
