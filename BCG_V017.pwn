stock ContaBanida(i)
{
    if(!ContaInvalida(i))
	{
		if(GetContaInt(i, "c_Ban_Tempo") > 0)
		{
		    return 1;
		}
	}
	return 0;
}

stock abrir_trocar_senha(playerid, c, con)
{
    SetPVarInt(playerid, "cc", c);
    SetPVarInt(playerid, "opcao", con);

	// colocar senha atual //
	if(con == 0)
	{
	    ShowPlayerDialog(playerid, DIALOG_TROCAR_SENHA, DIALOG_STYLE_INPUT, "SENHA ATUAL", "{ffffff}ETAPA [1]\n\n{ffff00}[INFO] {a1a1a1}Para trocar a senha de sua conta\nprimeiro digite a senha atual:\n\n", "Continuar", "Cancelar");
	}

	// digitar nova senha //
	if(con == 1)
	{
		ShowPlayerDialog(playerid, DIALOG_TROCAR_SENHA, DIALOG_STYLE_INPUT, "NOVA SENHA", "{ffffff}ETAPA [2]\n\n{ffff00}[INFO] {a1a1a1}Digite a nova senha que deseja usar:\n\n", "Continuar", "Cancelar");
	}

	// confirmar senha //
	if(con == 2)
	{
		ShowPlayerDialog(playerid, DIALOG_TROCAR_SENHA, DIALOG_STYLE_INPUT, "CONFIRMAR NOVA SENHA", "{ffffff}ETAPA [3]\n\n{ffff00}[INFO] {a1a1a1}Digite novamente a nova senha que deseja usar\npara concluir a troca de senha da sua conta:\n\n", "Continuar", "Cancelar");
	}

	return 1;
}

stock abrir_apagar_conta(playerid)
{
	new c = GetPVarInt(playerid, "cc");
	new sss[500];
	format(sss, 500, "\n\
	Conta: %d\n\
	Nick: %s\n\n\
	{ffff00}[INFO] {ffffff}Deseja realmente apagar esta conta ?\n\n", c, NomeConta(c));
	ShowPlayerDialog(playerid, DIALOG_APAGAR_CONTA, DIALOG_STYLE_MSGBOX, "APAGAR CONTA", sss, "Apagar", "Cancelar");
	return 1;
}

stock spawn_lobby(playerid)
{
    if(mostrando_trade[playerid] == 1) cancelar_trade(playerid);
    if(mostrando_vip[playerid] == 1) fechar_vip(playerid);
    if(mostrando_banco[playerid] == 1) fechar_banco(playerid);
    if(mostrando_menu[playerid] == 1) fechar_menu(playerid);
    if(celular_aberto[playerid] != -1) fechar_celular(playerid, 1);
	if(mostrando_radio[playerid] == 1) fechar_radio(playerid);
    if(menu_vei_aberto[playerid] == 1) fechar_menu_vei(playerid);
	if(player_cinuca[playerid] != -1) acabar_partida_cinuca(player_cinuca[playerid]);
    cancelar_uber(playerid);
    new c = id[playerid];
    if(c != -1)
    {
        // salvar conta //
	    if(TestePlayer[playerid] == -1 && player_arena[playerid] == 0 && tv_player[playerid] == -1 && olhando_camera[playerid] == -1 && tunando[playerid] == 0)
		{
            Conta[playerid][c_Interior] = GetPlayerInterior(playerid);
			Conta[playerid][c_Mundo] = GetPlayerVirtualWorld_(playerid);
			GetPlayerPos(playerid, Conta[playerid][c_X],Conta[playerid][c_Y],Conta[playerid][c_Z]);
			GetPlayerFacingAngle(playerid, Conta[playerid][c_A]);
			salvar_conta(c, -1, "c_Posicao");
			if(remocao_arma[playerid] < gettime()) salvar_conta(c, playerid, "c_Armas");
		}
		if(Conta[playerid][c_Pix] < 0) Conta[playerid][c_Pix] = 0;
		salvar_multas(c);
		salvar_conta(c, -1, "Desconectou");
	    id[playerid] = -1;
	    SetarNickPlayer(playerid);
	    PlayerSpawn(playerid);
	    SetPlayerScore(playerid, 0);
	    player_conta[c] = -1;
    }
    return 1;
}

stock apagar_conta(c)
{
    new file[80];

    // MANDAR O PLAYER PRO LOBBY //
    new playerid = ContaOnline(c);
	if(Online(playerid))
	{
	    spawn_lobby(playerid);
	}

	// deslogar dono da conta //
	foreach(new i:Player)
	{
	    if(IsPlayerConnected(i))
	    {
		    if(id[i] == -1)
		    {
			    if(contas[i] == c)
				{
				logado[i] = 0;
				esconder_contas(i);
				PlayerSpawn(i);
		        }
		    }
	    }
	}

	// DESTRUIR VEICULOS DA CONTA //
	foreach(new v:Iter_Veiculos)
	{
	    if(Veiculo[v][v_Existe] == 1)
	    {
	        if(Veiculo[v][v_Dono] == c)
	    	{
	            DestruirInfo(v);
	            SalvarInfo(v);
	        }
	    }
	}

	// APAGAR NICK //
	format(file, 80, "Nicks/%s.txt", NomeConta(c));
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);

	// APAGAR ACESSORIOS //
	format(file, 80, "Acessorios/%d.txt", c);
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
	if(Online(playerid))
	{
    	for(new w; w<MAX_ACESSORIOS; w++)
		{
			Acessorios[playerid][w][ac_Existe] = 0;
		}
	}

	new pixx = GetContaInt(c, "c_Pix");
	if(pixx != 0)
	{
		format(file, 80, "PIX/%d.txt", pixx);
		if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
	}

    // apagar admin se ele for //
    for(new ad; ad<MAX_ADMINS; ad++)
    {
        if(Admin[ad][adm_Existe] == 1)
        {
            if(Admin[ad][adm_Conta] == c)
            {
                Admin[ad][adm_Existe] = 0;
                salvar_admin(ad);
            }
        }
    }

    // limpar casas //
    foreach(new ca:Iter_Casas)
    {
        if(Casa[ca][casa_Existe] == 1)
        {
            if(Casa[ca][casa_Dono] == c)
            {
                Casa[ca][casa_Dono] = -1;
				atualizar_casa(ca);
				salvar_casa(ca);
            }
        }
    }

    // APAGAR chat //
	format(file, 80, "ChatOff/%d.txt", c);
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);


	// limpar vaga org //
	foreach(new o:Iter_Orgs)
	{
	    if(Org[o][o_Existe] == 1)
	    {
		    for(new a; a<30; a++)
		    {
		        if(Org[o][o_Membros][a] == c)
		        {
		            Org[o][o_Membros][a] = -1;
		            Org[o][o_Cargos][a] = 0;
		            salvar_org(o);
		        }
		    }
	    }
    }

    // apagar deposito //
    format(file, 80, "Deposito/%d.txt", c);
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);

    // apagar gr e cpf //
    format(file, 80, "CPF/%d.txt", GetContaInt(c, "c_CPF"));
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
    format(file, 80, "RG/%d.txt", GetContaInt(c, "c_RG"));
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);

    // apagar chip //
    format(file, 80, "Chips/%d.txt", GetContaInt(c, "c_Chip"));
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);

	// apagar inventario //
	if(Online(playerid))
	{
	    for(new ii; ii<MAX_SLOTS; ii++)
	    {
	        Inventario[playerid][ii][inv_ID] = 0;
	        Inventario[playerid][ii][inv_Tipo] = 0;
	        Inventario[playerid][ii][inv_Unidades] = 0;
	    }
    }
    format(file, 80, "Inventarios/%d.txt", c);
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);

    // apagar multas //
    if(Online(playerid))
    {
	    for(new i; i<MAX_MULTAS; i++)
	    {
	        Multas[playerid][i][mu_Existe] = 0;
	        Multas[playerid][i][mu_Valor] = 0;
	        format(Multas[playerid][i][mu_Motivo], 100, "_");
	        format(Multas[playerid][i][mu_Data], 50,  "_");
	        Multas[playerid][i][mu_Conta] =-1;
	        Multas[playerid][i][mu_Radar] =-1;
		}
	}
    format(file, 80, "Multas/%d.txt", c);
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);

    // apagar portoes //
    foreach(new po:Iter_Portoes)
    {
        if(Portao[po][p_Existe] == 1)
        {
            if(Portao[po][p_Dono] == c)
            {
                destruir_portao(po);
                salvar_portao(po);
            }
        }
    }

	// deposito //
	format(file, 80, "Deposito/%d.txt", c);
	if(DOF2_FileExists(file)) DOF2_RemoveFile(file);

	// whatsapp //
	for(new a; a<MAX_WP; a++)
	{
	    if(WP[a][w_Existe] == 1)
	    {
	        if(WP[a][w_Conta][0] == c ||  WP[a][w_Conta][1] == c)
	        {
	            WP[a][w_Existe] = 0;
	            salvar_wp(a);
	            format(file, 80, "WP_Menssagens/%d.txt", a);
				if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
	        }
	    }
	}


    format(file, 80, "Contas/%d.txt", c);
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
    conta_existe[c] = 0;
    Iter_Remove(Iter_Contas, c);
	return 1;
}

stock desalgemar(playerid, i)
{
    if(Online(playerid))
	{
	    if(Online(i))
	    {
	        if(GetPlayerSpeed(i) > 2) return ms(playerid, 0, "A pessoa deve estar parada para ser desalgemada !");
	        if(IsPlayerInAnyVehicle(i)) return ms(playerid, 0, "A pessoa nao pode estar em um veiculo !");
	        new sss[150];
	        player_algemado[i] = 0;
	        SetPlayerSpecialAction(i, 0);
	        format(sss, 150, "Voce desalgemou '%s'.", Nome(i));
        	ms(playerid, 1, sss);
        	format(sss, 150, "O policial '%s' retirou suas algemas.", Nome(playerid));
        	ms(i, 1, sss);
        	if(JogadorCongelado[i] == 1){
		        Controle(i, 1);
		        JogadorCongelado[i] = 0;
		        KillTimer(TimerFicarParado[i]);
		    }
        	format(string_prox, 300, "** Policial '%s' tirou as algemas '%s' **", Nome(playerid), Nome(i));
			ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
	    }
	}
	return 1;
}

stock desamarrar(playerid, i)
{
    if(Online(playerid))
	{
	    if(Online(i))
	    {
	        if(GetPlayerSpeed(i) > 2) return ms(playerid, 0, "A pessoa deve estar parada para ser desamarrada !");
	        if(IsPlayerInAnyVehicle(i)) return ms(playerid, 0, "A pessoa nao pode estar em um veiculo !");
	        new sss[150];
	        player_amarrado[i] = 0;
	        SetPlayerSpecialAction(i, 0);
	        format(sss, 150, "Voce desamarrou '%s'.", Nome(i));
        	ms(playerid, 1, sss);
        	format(sss, 150, "O jogador '%s' retirou a corda de suas maos.", Nome(playerid));
        	ms(i, 1, sss);
        	format(string_prox, 300, "** '%s' desamarrou '%s' **", Nome(playerid), Nome(i));
			ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);

			new c = id[playerid];
			if(c != -1)
			{
				if(!add_inv(c, 81, 1))
				{
				    new Float:pos[3];
					GetPlayerPos(i, pos[0], pos[1], pos[2]);
					criar_item(81, pos[0], pos[1], pos[2], 1, GetPlayerVirtualWorld_(i), GetPlayerInterior(i), 1);
				}
			}
	    }
	}
	return 1;
}

stock algemar(playerid, i)
{
    if(Online(playerid))
	{
	    if(Online(i))
	    {
	        new cc = id[i];
            if(cc != -1)
            {
	            if(player_arena[i] == 1)
		        {
		            if(IsValidDynamicActor(actor_player[i])) DestroyDynamicActor(actor_player[i]);
				    if(IsValidDynamic3DTextLabel(actor_player_3D[i])) DestroyDynamic3DTextLabel(actor_player_3D[i]);
					actor_player_3D[i] = DynamicText3D:-1;
					actor_player[i] = -1;
				    atualizar_conta(cc);
				    player_arena[i] = 0;
				    PlayerSpawn(i);
		        }
	        }

	        if(GetPlayerSpeed(i) > 2) return ms(playerid, 0, "A pessoa deve estar parada para ser algemada !");
	        if(IsPlayerInAnyVehicle(i)) return ms(playerid, 0, "A pessoa nao pode estar em um veiculo !");

	        new sss[150];
	        player_rendido[i] = 0;
	        player_algemado[i] = 1;
	        player_rendido[i] = 0;
	        SetPlayerSpecialAction(i, SPECIAL_ACTION_CUFFED);
	        format(sss, 150, "Voce algemou '%s'.", Nome(i));
        	ms(playerid, 1, sss);
        	format(sss, 150, "Voce foi algemado pelo policial '%s'.", Nome(playerid));
        	ms(i, 1, sss);
        	JogadorCongelado[i] = 1;
            Controle(i, 0);
            TimerFicarParado[i] = SetTimerEx("JogadorParado", 500, true, "d", i);
        	format(string_prox, 300, "** Policial '%s' algemou '%s' **", Nome(playerid), Nome(i));
			ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
	    }
	}
	return 1;
}

stock amarrar(playerid, i)
{
    if(Online(playerid))
	{
	    if(Online(i))
	    {
	        new c = id[playerid];
	        if(c == -1) return 1;
			new slot = tem_item(playerid, 81);
	        if(slot == -1) return ms(playerid, 0, "Voce nao tem uma Corda em seu Inventario !");

	        new cc = id[i];
            if(cc != -1)
            {
	            if(player_arena[i] == 1)
		        {
		            if(IsValidDynamicActor(actor_player[i])) DestroyDynamicActor(actor_player[i]);
				    if(IsValidDynamic3DTextLabel(actor_player_3D[i])) DestroyDynamic3DTextLabel(actor_player_3D[i]);
					actor_player_3D[i] = DynamicText3D:-1;
					actor_player[i] = -1;
				    atualizar_conta(cc);
				    player_arena[i] = 0;
				    PlayerSpawn(i);
		        }
	        }

	        if(GetPlayerSpeed(i) > 2) return ms(playerid, 0, "A pessoa deve estar parada para ser amarrada !");
	        if(IsPlayerInAnyVehicle(i)) return ms(playerid, 0, "A pessoa nao pode estar em um veiculo !");

	        new sss[150];
	        player_rendido[i] = 0;
	        player_amarrado[i] = 1;
	        player_rendido[i] = 0;
	        SetPlayerSpecialAction(i, SPECIAL_ACTION_CUFFED);
	        format(sss, 150, "Voce amarrou '%s'.", Nome(i));
        	ms(playerid, 1, sss);
        	format(sss, 150, "Voce foi amarrado pelo jogador '%s'.", Nome(playerid));
        	ms(i, 1, sss);
        	format(string_prox, 300, "** '%s' amarrou '%s' **", Nome(playerid), Nome(i));
			ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
			diminuir_inv(c, slot);
	    }
	}
	return 1;
}


stock abordar(playerid, i)
{
	if(Online(playerid))
	{
	    if(Online(i))
	    {
	        new cc = id[i];
            if(cc != -1)
            {
		        if(player_arena[i] == 1)
		        {
		            if(IsValidDynamicActor(actor_player[i])) DestroyDynamicActor(actor_player[i]);
				    if(IsValidDynamic3DTextLabel(actor_player_3D[i])) DestroyDynamic3DTextLabel(actor_player_3D[i]);
					actor_player_3D[i] = DynamicText3D:-1;
					actor_player[i] = -1;
				    atualizar_conta(cc);
				    player_arena[i] = 0;
				    PlayerSpawn(i);
		        }

		        new sss[500];
		        format(sss, 500, "\
				{00ffff}ABORDAGEM POLICIAL\n\n\
				\
				{ffffff}O policial '{ffff00}%s{ffffff}' esta lhe anunciando uma\n\
				abordagem, responda antes de 15 segundos.\n\n\
				\
				{ffff00}[INFO] {a1a1a1}Se voce recusar a abordagem sera sujeito a\n\
				uma punicao por Desobediencia a Ordem Policial.\n\n", Nome(playerid));
	            policial_abordado[i] = playerid;
	            sendo_abordado[i] = 1;
	            ShowPlayerDialog(i, DIALOG_ABORDAGEM, DIALOG_STYLE_MSGBOX, "{000000}_", sss, "Aceitar", "Recusar");
	            tempo_abordado[i] = gettime()+15;

	            format(sss, 150, "Voce esta abordando '%s', aguarde 15 segundos por uma resposta.", Nome(i));
	            ms(playerid, 1, sss);
	        }
		}
	}
	return 1;
}

stock resposta_abordagem(playerid, res=-1)
{
	if(Online(playerid))
	{
	    if(sendo_abordado[playerid] == 1)
	    {
	        new sss[150];
		    new player = policial_abordado[playerid];
		    if(Online(player))
		    {
		        // recusou //
				if(res == 0)
				{
				    format(sss, 150, "O jogador '%s' recusou a Abordagem !", Nome(playerid));
				    ms(player, 5, sss);
				    format(sss, 150, "Voce recusou a Abordagem do policial '%s' !", Nome(player));
				    ms(playerid, 5, sss);
				    aplicar_su(playerid, player, 0);
				    sendo_abordado[playerid] = 0;
				    return 1;
				}

				// aceitou //
                if(res == 1)
				{
				    format(sss, 150, "O jogador '%s' aceitou a Abordagem !", Nome(playerid));
				    ms(player, 5, sss);
				    format(sss, 150, "Voce aceitou a Abordagem do policial '%s' !", Nome(player));
				    ms(playerid, 5, sss);
				    render(playerid);
				    sendo_abordado[playerid] = 0;
				    return 1;
				}

				// tempo acabou //
                if(res == 2)
				{
				    format(sss, 150, "O jogador '%s' aceitou a Abordagem !", Nome(playerid));
				    ms(player, 5, sss);
				    format(sss, 150, "Voce aceitou a Abordagem do policial '%s' !", Nome(player));
				    ms(playerid, 5, sss);
				    aplicar_su(playerid, player, 0);
				    ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}_", "{00ffff}ABORDAGEM POLICIAL\n\n{ff0000}[INFO] {a1a1a1}O tempo para aceitar acabou, voce foi penalizado !", "Ok", "Fechar");
				    sendo_abordado[playerid] = 0;
				    return 1;
				}
		    }
		    else ms(playerid, 0, "O policial nao estava mais Online !");
		}
	}
	return 1;
}

stock render(playerid)
{
	if(player_algemado[playerid] == 1) return 1;
	if(player_amarrado[playerid] == 1) return 1;

	if(player_rendido[playerid] == 0)
	{
	    ID_Dancando[playerid] = -1;
        ClearAnimations(playerid, 1);
	    player_rendido[playerid] = 1;
		SetPlayerSpecialAction(playerid, 10);
		format(string_prox, 300, "** '%s' se rendeu **", Nome(playerid));
		ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
		ms(playerid, 5, "Voce se rendeu, para cancelar use /render.");
	}
	else
	{
	    player_rendido[playerid] = 0;
	    SetPlayerSpecialAction(playerid, 0);
	    ClearAnimations(playerid, 1);
	    ms(playerid, 5, "Voce abaixou as maos, e nao esta mais rendido.");
	}
	return 1;
}



stock verificar_nivel(playerid)
{
	new c = id[playerid];
	if(c != -1)
	{
	    new niv = Conta[playerid][c_Nivel];
	    new xp = Conta[playerid][c_XP];
	    new precisa = niv*12;
	    if(xp >= precisa)
	    {
	        new sss[150];
	        Conta[playerid][c_Nivel] +=1;
	        Conta[playerid][c_XP] -= precisa;
	        format(sss, 150, "[XP] Voce atingiu o Nivel: %d !", Conta[playerid][c_Nivel]);
	        ms(playerid, 2, sss);
	        SetPlayerScore(playerid, Conta[playerid][c_Nivel]);
	        salvar_conta(c, 0, "c_Nivel", sv_int(Conta[playerid][c_Nivel]));
	        salvar_conta(c, 0, "c_XP", sv_int(Conta[playerid][c_XP]));
	    }
	}
	return 1;
}

stock dar_payday(playerid)
{
	new c = id[playerid];
	if(c != -1)
	{
		new sss[150];
		format(sss, 150, "-----------------[  PayDay - %02d:%02d  ]--------- ------- ----- ---- --- - -   -      -", HORA, MINUTO), ms(playerid, 5, sss);
		ms(playerid, 5,  " ");
		new e = Conta[playerid][c_Emprego];
		new recebeu;
		new vip = VipPlayer(playerid);
		if(e != -1)
		{
		    if(Conta[playerid][c_MetaEmprego][e] < max_meta_emprego[e] && VipPlayer(playerid) < 3)
		    {
		        format(sss, 150, "Emprego: %s.", NomeEmprego(e)), ms(playerid, 5, sss);
		        format(sss, 150, "Voce nao cumpriu a /meta, e nao recebeu seu salario !"), ms(playerid, 5, sss);
		        if(vip == 1)
				{
					flood_xp[playerid] = 500;
			 		Conta[playerid][c_XP] += 5;
			 		ms(playerid, 5, "Voce ganhou 5 de XP pelo VIP ou SOCIO atual.");
			 	}
			 	if(vip == 1)
				{
					flood_xp[playerid] = 500;
			 		Conta[playerid][c_XP] += 10;
			 		ms(playerid, 5, "Voce ganhou 10 de XP pelo VIP ou SOCIO atual.");
			 	}
			 	if(vip == 1)
				{
					flood_xp[playerid] = 500;
			 		Conta[playerid][c_XP] += 20;
			 		ms(playerid, 5, "Voce ganhou 20 de XP pelo VIP ou SOCIO atual.");
			 	}

		    }
		    else
		    {
			    recebeu = Emprego[e][e_Salario];
				format(sss, 150, "Emprego: %s.", NomeEmprego(e)), ms(playerid, 5, sss);
				format(sss, 150, "Salario: R$ %s.", ConvertMoney(Emprego[e][e_Salario])), ms(playerid, 5, sss);
				new mult;
				if(vip == 1)
				{
				    // vip comum
	                mult = (recebeu/3);
	                flood_xp[playerid] = 500;
				Conta[playerid][c_XP] += 5;
	                format(sss, 150, "%s: +R$ %s ( 1/3 do pagamento ) e mais 5 de XP.", NomeVip(vip), ConvertMoney(mult)), ms(playerid, 5, sss);
				}
				else if(vip == 2)
				{
				    // vip gold
	                mult += (recebeu/2);
	                flood_xp[playerid] = 500;
				Conta[playerid][c_XP] += 10;
	                format(sss, 150, "%s: +R$ %s ( meio pagamento ) e mais 10 de XP.", NomeVip(vip), ConvertMoney(mult)), ms(playerid, 5, sss);
				}
				else if(vip == 3)
				{
				    // socio
	                mult += (recebeu/1);
	                flood_xp[playerid] = 500;
				Conta[playerid][c_XP] += 20;
	                format(sss, 150, "%s: +R$ %s ( outro pagamento ) e mais 20 de XP.", NomeVip(vip), ConvertMoney(mult)), ms(playerid, 5, sss);
				}
				recebeu += mult;
			}
		}
		else
		{
		    recebeu = AUXILIO;
		   	ms(playerid, 5, "Voce esta desempregado !");
			format(sss, 150, "Auxilio Governo: R$ %s.", ConvertMoney(AUXILIO)), ms(playerid, 5, sss);
			new mult;
			if(vip == 1)
			{
			    // vip comum
                mult = (recebeu/3);
                flood_xp[playerid] = 500;
			 	Conta[playerid][c_XP] += 5;
                format(sss, 150, "%s: +R$ %s ( 1/3 do pagamento ) e mais 5 de XP.", NomeVip(vip), ConvertMoney(mult)), ms(playerid, 5, sss);
			}
			else if(vip == 2)
			{
			    // vip gold
                mult += (recebeu/2);
                flood_xp[playerid] = 500;
			 	Conta[playerid][c_XP] += 10;
                format(sss, 150, "%s: +R$ %s ( meio pagamento ) e mais 10 de XP.", NomeVip(vip), ConvertMoney(mult)), ms(playerid, 5, sss);
			}
			else if(vip == 3)
			{
			    // socio
                mult += (recebeu/1);
                flood_xp[playerid] = 500;
			 	Conta[playerid][c_XP] += 20;
                format(sss, 150, "%s: +R$ %s ( outro pagamento ) e mais 20 de XP.", NomeVip(vip), ConvertMoney(mult)), ms(playerid, 5, sss);
			}
			recebeu += mult;
		}
		if(EmServico(playerid))
		{
		    recebeu += 10000;
		    ms(playerid, 5, "Bonus Policial: +R$ 10.000.");
		}
		ms(playerid, 5,  " ");
        format(sss, 150, "Saldo no Banco: R$ %s.", ConvertMoney(Conta[playerid][c_Banco])), ms(playerid, 5, sss);
	    DarBanco(playerid, recebeu);
		format(sss, 150, "[BANCO] Novo saldo Bancario: R$ %s.", ConvertMoney(Conta[playerid][c_Banco])), ms(playerid, 5, sss);
	    ms(playerid, 5,  "------------------------------------------------- ------- ----- ---- --- - -   -      -");
		for(new a; a<MAX_EMPREGOS; a++) Conta[playerid][c_MetaEmprego][a] = 0;
		Conta[playerid][c_MetaHora] = 0;
		salvar_conta(c, 0, "c_MetaHora", sv_int(0));
		salvar_conta(c, -1, "Metas_Empregos");
    }
	return 1;
}

