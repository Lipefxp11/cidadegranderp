	        ShowPlayerDialog(playerid, DIALOG_EDITAR_CONCE3, DIALOG_STYLE_LIST, sss2, sss, "Continuar", "Voltar");
	    }
	}
}

stock abrir_veiculos_conce(playerid, i)
{
    if(Online(playerid))
	{
	    SetPVarInt(playerid, "conce", i);
	    if(Conce[i][con_Existe] == 1)
	    {
	        new cont = carros_conce(i);
			SG[0] = EOS;
			new sss[150];
			strcat(SG, "Modelo\tNome\tValor\n");
			for(new a; a<MAX_VEICULOS_CONCE; a++)
			{
			    if(Conce[i][con_v_Existe][a] == 1) format(sss, 150, "{ffffff}%d\t{ffff00}%s\t{4169E1}R$ %s\n", Conce[i][con_v_Modelo][a], NomeVeiculo(Conce[i][con_v_Modelo][a]), ConvertMoney(Conce[i][con_v_Valor][a]));
				else format(sss, 150, "{a1a1a1}Nenhum\tNenum\tNada\n");
				strcat(SG, sss);
			}
			format(sss, 150, "{ffffff}Veiculos [ {00ffff}%d {ffffff}]", cont);
			ShowPlayerDialog(playerid, DIALOG_EDITAR_CONCE2, DIALOG_STYLE_TABLIST_HEADERS, sss, SG, "Editar", "Voltar");
		}
	}
}

stock abrir_conce(playerid, i)
{
	if(Online(playerid))
	{
	    SetPVarInt(playerid, "conce", i);
	    if(Conce[i][con_Existe] == 1)
	    {
			new cars = carros_conce(i);
	        new sss[300];
	        new sss2[100];
	        format(sss2, 100, "{ffffff}Concessionaria: {ffff00}%s {ffffff}[ {00ffff}%d {ffffff}]", Conce[i][con_Nome], i);
			format(sss, 300, "\
			{ffffff}Posicao de comprar\n\
			{ffffff}local da garagem\n\
			{ffffff}Ir ate o Local\n\
			{ffffff}Veiculos [ {ffff00}%d {ffffff}]\n", cars);
			ShowPlayerDialog(playerid, DIALOG_EDITAR_CONCE, DIALOG_STYLE_LIST, sss2, sss, "Continuar", "Cancelar");
	    }
	}
}

stock abrir_concessionaria(playerid, i)
{
	if(Online(playerid))
	{
	    new cont;
	    SetPVarInt(playerid, "conce", i);
		menu_id[playerid] = VEICULOS_CONCE;
		format(nome_menu[playerid], 100, "Veiculos Disponiveis");
		format(botao_menu[playerid], 100, "COMPRAR");
		for(new a; a<MAX_VEICULOS_CONCE; a++)
		{
		    if(Conce[i][con_v_Existe][a] == 1)
		    {
			    Menu[playerid][cont][menu_ID] = a;
			    Menu[playerid][cont][menu_Unidades] = 1;
			    Menu[playerid][cont][menu_Tipo] = 1;
			    Menu[playerid][cont][menu_Valor] = Conce[i][con_v_Valor][a];
			    if(Conce[i][con_v_Stock][a] > 0) format(Menu[playerid][cont][menu_Nome], 200, "%d - %s", a, NomeVeiculo(Conce[i][con_v_Modelo][a]));
			    else format(Menu[playerid][cont][menu_Nome], 200, "%d - %s ~r~[ESGOTADO]", a, NomeVeiculo(Conce[i][con_v_Modelo][a]));
			    format(Menu[playerid][cont][menu_Info], 200, "%s~n~~g~R$ %s~n~~w~Estoque: ~y~%d", NomeVeiculo(Conce[i][con_v_Modelo][a]), ConvertMoney(Conce[i][con_v_Valor][a]), Conce[i][con_v_Stock][a]);
			    Menu[playerid][cont][menu_Modelo] = Conce[i][con_v_Modelo][a];
			    cont ++;
		    }
		}
		if(cont == 0) ms(playerid, 0, "Nenhum Veiculo disponivel para comprar no momento !");
		else
		{
			max_menu[playerid] = cont;
			escolhendo_menu[playerid] = 0;
			mostrar_menu(playerid, menu_id[playerid]);
		}
	}
}

stock finalizar_compra_conce(playerid, i, a, cor)
{
	new c = id[playerid];
	if(c != -1)
	{
	    if(Online(playerid))
		{
		    if(Conce[i][con_Existe] == 1)
		    {
		        if(Conce[i][con_v_Existe][a] == 1)
		        {
		            if(Conce[i][con_v_Stock][a] < 1) { ms(playerid, 0, "Este veiculo esta sem estoque no momento !"); return; }
		            new sss[150];
					new idv = CriarVeiculo(0, 0, Conce[i][con_v_Modelo][a], 0, 0, 0, 0, 1, 1, c);
		            if(idv == -1)  ms(playerid, 0, "Numero maximo de Veiculos do servidor criados !");
					else
					{
					    fechar_menu(playerid);
						Veiculo[idv][v_Conce] = 1;
						Veiculo[idv][v_ConceID] = i;
						Veiculo[idv][v_Garagem] = 1;
						Veiculo[idv][v_Cor1] = cor;
						Veiculo[idv][v_Cor2] = cor;
						Veiculo[idv][v_Compra] = Conce[i][con_v_Valor][a];
						SalvarInfo(idv);
						Conce[i][con_v_Stock][a] --;
						salvar_concessionaria(i);
						atualizar_veiculo_conce(i, a);
						ms(playerid, 2, "Seu veiculo esta na garagem da concessionaria, siga ate a marca vermelha do seu mapa !");
						format(sss, 150, "Voce comprou um '%s' por R$ %s, use /veiculos, para ter acesso a ele.", NomeVeiculo(Conce[i][con_v_Modelo][a]), ConvertMoney(Conce[i][con_v_Valor][a]));
	                    ms(playerid, 2, sss);
	                    MS(playerid, 1, "Veiculo Comprado com Sucesso !");
	                    Localizar_Player(playerid, Conce[i][con_g_X], Conce[i][con_g_Y], Conce[i][con_g_Z], 63, -1, "GARAGEM");
	                    DarGrana(playerid, -Conce[i][con_v_Valor][a]);
					}
		        }
			}
		}
	}
}

stock abrir_garagem_concessionaria(playerid, i)
{
    new c = id[playerid];
	if(c != -1)
	{
	    if(Online(playerid))
		{
		    SetPVarInt(playerid, "conce", i);
		    if(Conce[i][con_Existe] == 1)
		    {
	            new sss[300];
	            new cont;
		        SG[0] = EOS;
		        Lista2[playerid][0] = -1;
		        strcat(SG, "Info\tNome\tConcessionaria\n");
	            foreach(new v:Iter_Veiculos)
	            {
	                if(Veiculo[v][v_Existe] == 1)
	                {
	                    if(Veiculo[v][v_Dono] == c)
	                    {
	                        if(Veiculo[v][v_Conce] != 0)
	                        {
	                            if(Veiculo[v][v_Garagem] == 1)
	                        	{
	                                if(Veiculo[v][v_ConceID] == i)
	                                {
	                                    format(sss, 300, "{00ffff}%d\t{ffffff}%s\t{a1a1a1}%s\n", v, NomeVeiculo(Veiculo[v][v_Modelo]), Conce[i][con_Nome] );
										strcat(SG, sss);
										Lista2[playerid][cont] = v;
										cont ++;
									}
								}
	                        }
	                    }
	                }
		        }
		        format(sss, 300, "{ffffff}Seus veiculos nesta garagem [ {ffff00}%d {ffffff}]", cont);
		        ShowPlayerDialog(playerid, DIALOG_CONCE3, DIALOG_STYLE_TABLIST_HEADERS, sss, SG, "Pegar", "Cancelar");
			}
		}
	}
}


BCG:: carregar_maquinas()
{
	new file[80];
	new cont;
	new lin[600];
	new lin2[80];

	for(new i; i<MAX_MAQUINAS; i++)
	{
	    Maquina[i][m_3D] = DynamicText3D:-1;
	    format(file, 80, "Maquinas/Maquina_%d.txt", i);
	    if(DOF2_FileExists(file))
	    {
	        Maquina[i][m_Existe] = 1;
            Maquina[i][m_Org] = DOF2_GetInt(file, "m_Org");
            Maquina[i][m_GZ] = DOF2_GetInt(file, "m_GZ");
            Maquina[i][m_Categoria] = DOF2_GetInt(file, "m_Categoria");
	        Maquina[i][m_X] = DOF2_GetFloat(file, "m_X");
	        Maquina[i][m_Y] = DOF2_GetFloat(file, "m_Y");
	        Maquina[i][m_Z] = DOF2_GetFloat(file, "m_Z");
	        Maquina[i][m_RX] = DOF2_GetFloat(file, "m_RX");
	        Maquina[i][m_RY] = DOF2_GetFloat(file, "m_RY");
	        Maquina[i][m_RZ] = DOF2_GetFloat(file, "m_RZ");

	        Maquina[i][m_Materiais][0] = DOF2_GetInt(file, "m_Materiais_0");
	        Maquina[i][m_Materiais][1] = DOF2_GetInt(file, "m_Materiais_1");
	        Maquina[i][m_Materiais][2] = DOF2_GetInt(file, "m_Materiais_2");
	        Maquina[i][m_Materiais][3] = DOF2_GetInt(file, "m_Materiais_3");

			for(new a; a<10; a++)
			{
				format(lin2, 80, "m_Fabricando_%d", a);
			    format(lin, 500, "%s", DOF2_GetString(file, lin2));
			    split_linha(lin, strlen(lin));
			    Maquina[i][m_Status][a] = strval(split[0]);
			    Maquina[i][m_Unidades][a] = strval(split[1]);
			    Maquina[i][m_ID][a] = strval(split[2]);
			    Maquina[i][m_Tempo][a] = strval(split[3]);
			    Maquina[i][m_Tipo][a] = strval(split[4]);
			    if(Maquina[i][m_ID][a] >= sizeof armas_org)
				{
				Maquina[i][m_Status][a] = 0;
	                Maquina[i][m_Unidades][a] = 0;
	                Maquina[i][m_Tipo][a] = 0;
	                Maquina[i][m_ID][a] = 0;
	                Maquina[i][m_Tempo][a] = 0;
			    }
			    if(Maquina[i][m_Tempo][a] > MEIA_HORA) Maquina[i][m_Tempo][a] = MEIA_HORA;
			}

			atualizar_maquina(i);
			cont++;
	    }
	}

	printf("** %d Maquinas de fabricar armas carregadas.", cont);
}

stock salvar_maquina(i)
{
	new file[80];
	format(file, 80, "Maquinas/Maquina_%d.txt", i);
	new lin[500];
	new lin2[80];
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
    if(Maquina[i][m_Existe] == 1)
    {
		DOF2_CreateFile(file);
        DOF2_SetInt(file, "m_Org", Maquina[i][m_Org]);
        DOF2_SetInt(file, "m_GZ", Maquina[i][m_GZ]);
        DOF2_SetInt(file, "m_Categoria", Maquina[i][m_Categoria]);
        DOF2_SetFloat(file, "m_X", Maquina[i][m_X]);
        DOF2_SetFloat(file, "m_Y", Maquina[i][m_Y]);
        DOF2_SetFloat(file, "m_Z", Maquina[i][m_Z]);
        DOF2_SetFloat(file, "m_RX", Maquina[i][m_RX]);
        DOF2_SetFloat(file, "m_RY", Maquina[i][m_RY]);
        DOF2_SetFloat(file, "m_RZ", Maquina[i][m_RZ]);
       	DOF2_SetInt(file, "m_Materiais_0", Maquina[i][m_Materiais][0]);
        DOF2_SetInt(file, "m_Materiais_1", Maquina[i][m_Materiais][1]);
        DOF2_SetInt(file, "m_Materiais_2", Maquina[i][m_Materiais][2]);
        DOF2_SetInt(file, "m_Materiais_3", Maquina[i][m_Materiais][3]);
		for(new a; a<10; a++)
		{
            format(lin2, 80, "m_Fabricando_%d", a);
            format(lin, 500, "%d|%d|%d|%d|%d|", Maquina[i][m_Status][a], Maquina[i][m_Unidades][a], Maquina[i][m_ID][a], Maquina[i][m_Tempo][a], Maquina[i][m_Tipo][a]);
		    DOF2_SetString(file, lin2, lin);
		}
        DOF2_SaveFile();
    }
}


stock atualizar_maquina(i)
{
	Iter_Remove(Iter_Maquinas, i);
	if(IsValidDynamicObject(Maquina[i][m_Obj])) DestroyDynamicObject_(Maquina[i][m_Obj]);
	if(IsValidDynamic3DTextLabel(Maquina[i][m_3D])) DestroyDynamic3DTextLabel(Maquina[i][m_3D]);
	Maquina[i][m_3D] = DynamicText3D:-1;
	if(Maquina[i][m_Existe] == 1)
	{
	    Iter_Add(Iter_Maquinas, i);
        new sss[300];
        if(Maquina[i][m_GZ] != -1) format(sss, 300, "{00ffff}Maquina de Equipamentos [%d]\n{ffff00}GZ: %s\n{a1a1a1}Categoria: {ffff00}%s\n\n{a1a1a1}Aperte {ffffff}H {a1a1a1}para\nusar a maquina", i, TR[Maquina[i][m_GZ]][tr_Nome], nome_categorias[Maquina[i][m_Categoria]]);
        else format(sss, 300, "{00ffff}Maquina de Equipamentos [%d]\n{ffff00}%s\n{a1a1a1}Categoria: {ffff00}%s\n\n{a1a1a1}Aperte {ffffff}H {a1a1a1}para\nusar a maquina", i, NomeOrg(Maquina[i][m_Org]), nome_categorias[Maquina[i][m_Categoria]]);
	    Maquina[i][m_3D] = CreateDynamic3DTextLabel( sss, 0xffffff90, Maquina[i][m_X], Maquina[i][m_Y], Maquina[i][m_Z], 10, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0, -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
	    Maquina[i][m_Obj] = CreateDynamicObject(943, Maquina[i][m_X], Maquina[i][m_Y], Maquina[i][m_Z], Maquina[i][m_RX], Maquina[i][m_RY], Maquina[i][m_RZ], 0, 0, -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
	}
	salvar_maquina(i);
}


stock nome_fabricacao(ccc, idd=0)
{
	new strs[40];
	format(strs, 40, "Vazio");
	if(ccc == 1) format(strs, 40, "%s", nome_arma(armas_org[idd][0]));
	if(ccc == 2) format(strs, 40, "%s", nome_municao(municoes_org[idd][0]));
	if(ccc == 3) format(strs, 40, "Colete");
	return strs;
}

stock criar_maquina(Float:xx, Float:yy, Float:zz, org, _gz=-1)
{
	for(new i; i<MAX_MAQUINAS; i++)
	{
		if(Maquina[i][m_Existe] == 0)
		{
		    Maquina[i][m_Existe] = 1;
		    Maquina[i][m_Org] = org;
		    Maquina[i][m_GZ] = _gz;
		    Maquina[i][m_Categoria] = 0;
		    Maquina[i][m_X] = xx;
		    Maquina[i][m_Y] = yy;
		    Maquina[i][m_Z] = zz;
		    Maquina[i][m_RX] = 0;
		    Maquina[i][m_RY] = 0;
		    Maquina[i][m_RZ] = 0;
		    for(new a; a<10; a++)
		    {
		        Maquina[i][m_Status][a] = 0;
		        Maquina[i][m_Tipo][a] = 0;
		        Maquina[i][m_Unidades][a] = 0;
		        Maquina[i][m_Tempo][a] = 0;
		    }
		    atualizar_maquina(i);
		    salvar_maquina(i);
		    return i;
		}
	}
	return -1;
}


stock maquina(playerid, i)
{
    SetPVarInt(playerid, "maquina",  i);
    new sss[600];
	format(sss, 600, "\
	{ffffff}%s\t{ffff00}%s\n\
	{ffffff}%s\t{ffff00}%s\n\
	{ffffff}%s\t{ffff00}%s\n\
	{ffffff}%s\t{ffff00}%s\n\
	{00ffff}Fabricacao\t{000000}_n",
	materiais[0], ConvertMoney(Maquina[i][m_Materiais][0]), materiais[1], ConvertMoney(Maquina[i][m_Materiais][1]), materiais[2], ConvertMoney(Maquina[i][m_Materiais][2]), materiais[3], ConvertMoney(Maquina[i][m_Materiais][3]));
    ShowPlayerDialog(playerid, DIALOG_MAQUINA, DIALOG_STYLE_TABLIST, "Maquina de Equipamentos", sss, "Continuar", "Fechar");
}

stock abrir_maquina(playerid, i)
{
	SetPVarInt(playerid, "maquina",  i);
	if(Maquina[i][m_Existe] == 1)
	{
	    new sss[150];
	    SG[0] = EOS;
	    strcat(SG, "Fabricando\tUnidades\tTempo restante\n");
	    for(new a; a<10; a++)
	    {
	        if(Maquina[i][m_Status][a] == 0) format(sss, 150, "{a1a1a1}%s\t{a1a1a1}%d\t{a1a1a1}%s\n", nome_fabricacao(Maquina[i][m_Tipo][a], Maquina[i][m_ID][a]), Maquina[i][m_Unidades][a], ConvertTime(Maquina[i][m_Tempo][a]));
	        else
	        {
	            if(Maquina[i][m_Status][a] == 1) format(sss, 150, "{ffff00}%s\t{ffffff}%d\t{00ffff}%s\n", nome_fabricacao(Maquina[i][m_Tipo][a], Maquina[i][m_ID][a]), Maquina[i][m_Unidades][a], ConvertTime(Maquina[i][m_Tempo][a]));
	            else format(sss, 150, "{4169E1}%s\t{ffffff}%d\t{a1a1a1}%s\n", nome_fabricacao(Maquina[i][m_Tipo][a], Maquina[i][m_ID][a]), Maquina[i][m_Unidades][a], ConvertTime(Maquina[i][m_Tempo][a]));
	        }
	        strcat(SG, sss);
	    }
	    ShowPlayerDialog(playerid, DIALOG_MAQUINA1, DIALOG_STYLE_TABLIST_HEADERS, "Fabricacao", SG, "Continuar", "Fechar");
	}
}

stock abrir_maquina_slot(playerid, i, a)
{
    SetPVarInt(playerid, "slot", a);
    if(Maquina[i][m_Existe] == 1)
	{
	    SG[0] = EOS;
	    if(Maquina[i][m_Status][a] == 0)
	    {
	        abrir_maquina_fabricar(playerid, i, a);
	    }
	    else if(Maquina[i][m_Status][a] == 1)
	    {
	        abrir_maquina_opcoes(playerid, i, a);
	    }
	    else
	    {
	        abrir_maquina_pegar(playerid, i, a);
	    }
	}
}

stock abrir_maquina_fabricar(playerid, i, a)
{
    if(Maquina[i][m_Existe] == 1)
	{
		if(Maquina[i][m_Status][a] == 0)
		{
		    new cat = Maquina[i][m_Categoria];
		    // weapon categories: show weapon list directly
		    if(cat >= CATEGORIA_PISTOLAS && cat <= CATEGORIA_GRANADAS)
		    {
		        mostrar_armas_maquina(playerid);
		    }
		    else if(cat == CATEGORIA_MUNICOES)
		    {
		        mostrar_municoes_maquina(playerid);
		    }
		    else if(cat == CATEGORIA_COLETE)
		    {
		        new sss[150];
		        // check if enough materials for colete //
		        for(new aa; aa<4; aa++)
		        {
					if(Maquina[i][m_Materiais][aa] < coletes_org[0][aa+1])
					{
					    format(sss, 150, "A maquina nao tem %s de %s para fabricar um Colete.", ConvertMoney(coletes_org[0][aa+1]), materiais[aa]);
						ms(playerid, 0, sss);
						abrir_maquina(playerid, i);
						return;
					}
		        }
		        for(new aaa; aaa<4; aaa++) if(coletes_org[0][aaa+1] > 0) Maquina[i][m_Materiais][aaa] -= coletes_org[0][aaa+1];
                Maquina[i][m_Status][a] = 1;
                Maquina[i][m_Tipo][a] = 3;
                Maquina[i][m_Tempo][a] = coletes_org[0][5];
                Maquina[i][m_ID][a] = 0;
                Maquina[i][m_Unidades][a] = 1;
				salvar_maquina(i);
                format(sss, 150, "Voce colocou 1 Colete para ser fabricado.");
				ms(playerid, 1, sss);
				abrir_maquina(playerid, i);
		    }
		    else // CATEGORIA_TODAS
		    {
		        ShowPlayerDialog(playerid, DIALOG_MAQUINA2, DIALOG_STYLE_LIST, "Fabricar", "Armas\nMunicoes\nColetes", "Continuar", "Voltar");
		    }
		}
		else
		{
		    ms(playerid, 0, "Parece que este slot ja esta em uso, tente novamente !");
		    abrir_maquina(playerid, i);
		}
	}
}

stock abrir_maquina_opcoes(playerid, i, a)
{
    if(Maquina[i][m_Existe] == 1)
	{
		if(Maquina[i][m_Status][a] == 1)
		{
            ShowPlayerDialog(playerid, DIALOG_MAQUINA3, DIALOG_STYLE_LIST, "Fabricacao Opcoes", "{ffffff}aumentar Fabricacao\n{ff0000}Cancelar Fabricacao", "Continuar", "Voltar");
		}
		else
		{
		    if(Maquina[i][m_Status][a] == 2) ms(playerid, 0, "Parece que a fabricacao ja esta pronta, tente novamente !");
		    if(Maquina[i][m_Status][a] == 0) ms(playerid, 0, "Parece que este slot ja esta vazio, tente novamente !");
		    abrir_maquina(playerid, i);
		}
	}
}

stock abrir_maquina_pegar(playerid, i, a)
{
    if(Maquina[i][m_Existe] == 1)
	{
		if(Maquina[i][m_Status][a] == 2)
		{
		    if(GetPlayerSpecialAction(playerid) == 2) ms(playerid, 0, "Voce nao pode fazer isso enquanto estiver em um JetPack !");
		    else
			{
				new sss[150];
	            SetPlayerToFacePos(playerid, Maquina[i][m_X], Maquina[i][m_Y]);
				format(sss, 150, "Voce pegou 1 %s da Maquina.", nome_fabricacao(Maquina[i][m_Tipo][a], Maquina[i][m_ID][a]));
	            ms(playerid, 1, sss);
				// weapon - add to inventory //
				if(Maquina[i][m_Tipo][a] == 1)
				{
				    new wid = armas_org[Maquina[i][m_ID][a]][0];
				    new item_id;
					for(new z = 1; z < sizeof Itens; z++)
					{
					if(Itens[z][item_Tipo] == wid) { item_id = z; break; }
				    }
				    if(item_id > 0) add_inv(id[playerid], item_id, 1);
				    else ms(playerid, 0, "Erro ao adicionar arma ao inventario.");
				}
				// municoes - add to inventory //
				if(Maquina[i][m_Tipo][a] == 2)
				{
				    new mid = 44 + municoes_org[Maquina[i][m_ID][a]][0];
				    add_inv(id[playerid], mid, municoes_org[Maquina[i][m_ID][a]][6]);
				}
				// colete - add to inventory //
				if(Maquina[i][m_Tipo][a] == 3) add_inv(id[playerid], 73, 1);
				ApplyAnimation(playerid, "BD_FIRE", "WASH_UP", 4.1, false, false, false, false, 0, 1);
				Maquina[i][m_Unidades][a]--;
				if(Maquina[i][m_Unidades][a] == 0)
				{
				    Maquina[i][m_Status][a] = 0;
				    Maquina[i][m_Unidades][a] = 0;
				    Maquina[i][m_Tipo][a] = 0;
				    Maquina[i][m_ID][a] = 0;
				    Maquina[i][m_Tempo][a] = 0;
				}
				salvar_maquina(i);
			}
			}
			else
		{
		    ms(playerid, 0, "Parece que este slot ja esta vazio, tente novamente !");
		    abrir_maquina(playerid, i);
		}
	}
}

stock abrir_materiais_maquina(playerid, i, a)
{
	new sss1[100];
	SetPVarInt(playerid, "material", a);
	format(sss1, 100, "{ffffff}%s [ {00ffff}%s {ffffff}]", materiais[a], ConvertMoney(Maquina[i][m_Materiais][a]));
	ShowPlayerDialog(playerid, DIALOG_MAQUINA4, DIALOG_STYLE_LIST, sss1, "Colocar\nPegar", "Continuar", "Voltar");
}


stock opcao_materiais_maquina(playerid, i, a, opc)
{
	new sss1[100];
	new sss[500];
	SetPVarInt(playerid, "opc", opc);
    new seg = segurando_player[playerid];

	// colocar //
	if(opc == 0)
	{
	    // madeira //
	    if(a == 0)
	    {
	        if(seg != 2)
	        {
		        ms(playerid, 0, "Voce precisa estar com as Madeira em maos para colocar na maquina !");
		        abrir_materiais_maquina(playerid, i, a);
	        }
	        else
	        {
	            Maquina[i][m_Materiais][a] += segurando_unidades[playerid];
				salvar_maquina(i);
				format(sss, 150, "Voce colocou %s de %s na maquina !", ConvertMoney(segurando_unidades[playerid]), materiais[a]);
				ms(playerid, 1, sss);
				jogar(playerid);
				maquina(playerid, i);
			}
	    }

	    // pedra //
	    if(a == 1)
	    {
	        if(seg != 3)
	        {
		        ms(playerid, 0, "Voce precisa estar com as Pedras em maos para colocar na maquina !");
		        abrir_materiais_maquina(playerid, i, a);
	        }
	        else
	        {
		        Maquina[i][m_Materiais][a] += segurando_unidades[playerid];
				salvar_maquina(i);
				format(sss, 150, "Voce colocou %s de %s na maquina !", ConvertMoney(segurando_unidades[playerid]), materiais[a]);
				ms(playerid, 1, sss);
				jogar(playerid);
				maquina(playerid, i);
	        }
	    }

	    // pedra //
	    if(a == 2)
	    {
	        if(seg != 9)
	        {
		        ms(playerid, 0, "Voce precisa estar com os Metais em maos para colocar na maquina !");
		        abrir_materiais_maquina(playerid, i, a);
	        }
	        else
	        {
		        Maquina[i][m_Materiais][a] += segurando_unidades[playerid];
				salvar_maquina(i);
				format(sss, 150, "Voce colocou %s de %s na maquina !", ConvertMoney(segurando_unidades[playerid]), materiais[a]);
				ms(playerid, 1, sss);
				jogar(playerid);
				maquina(playerid, i);
	        }
	    }

	    // polvora //
	    if(a == 3)
	    {
	        if(seg != 10)
	        {
		        ms(playerid, 0, "Voce precisa estar com as Polvoras em maos para colocar na maquina !");
		        abrir_materiais_maquina(playerid, i, a);
	        }
	        else
	        {
		        Maquina[i][m_Materiais][a] += segurando_unidades[playerid];
				salvar_maquina(i);
				format(sss, 150, "Voce colocou %s de %s na maquina !", ConvertMoney(segurando_unidades[playerid]), materiais[a]);
				ms(playerid, 1, sss);
				jogar(playerid);
				maquina(playerid, i);
	        }
	    }
	}
	else
	{
		format(sss1, 100, "{ffffff}%s %s", opcao_materiais[opc], materiais[a]);
		format(sss, 500, "\
		{ffffff}%s na Maquina: {00ffff}%s\n\n\
		{ffff00}[INFO] {ffffff}Digite a quantia que deseja %s de {00ffff}%s{ffffff}:\n", materiais[a], ConvertMoney(Maquina[i][m_Materiais][a]), opcao_materiais[opc], materiais[a]);
		ShowPlayerDialog(playerid, DIALOG_MAQUINA5, DIALOG_STYLE_INPUT, sss1, sss, opcao_materiais[opc], "Voltar");
	}
}


stock mostrar_armas_maquina(playerid)
{
	new i = GetPVarInt(playerid, "maquina");
	new cat = Maquina[i][m_Categoria];
	new sss[300];
	new idx;
	SG[0] = EOS;
    strcat(SG, "Arma\tMadeira\tPedra\tMetal\tPolvora\n");
	for(new a; a<sizeof armas_org; a++)
	{
	    if(cat != CATEGORIA_TODAS && armas_categoria[a] != cat) continue;
	    if(is_arma_bloqueada(armas_org[a][0])) continue;
	    armas_item_map[playerid][idx] = a;
		format(sss, 300, "{ffff00}%s\t{%s}%s\t{%s}%s\t{%s}%s       {%s}%s\n", nome_arma(armas_org[a][0]),
		(armas_org[a][1] > 0 ? "ffffff":"a1a1a1"), ConvertMoney(armas_org[a][1]),
		(armas_org[a][2] > 0 ? "ffffff":"a1a1a1"), ConvertMoney(armas_org[a][2]),
		(armas_org[a][3] > 0 ? "ffffff":"a1a1a1"), ConvertMoney(armas_org[a][3]),
		(armas_org[a][4] > 0 ? "ffffff":"a1a1a1"), ConvertMoney(armas_org[a][4]));
	    strcat(SG, sss);
	    idx++;
	}
	ShowPlayerDialog(playerid, DIALOG_MAQUINA6, DIALOG_STYLE_TABLIST_HEADERS, "Fabricar Armas", SG, "Fabricar", "Voltar");
}

