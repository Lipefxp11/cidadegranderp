			for(new a; a<9; a++) PlayerTextDrawShow(playerid, T_MS_p[playerid][a]);
		}
	}
	else
	{
	    mostrando_mens[playerid] = 1;
		tipo_atu[playerid] = tipo;
		format(mens_atu[playerid], 300, straki);
		if(tipo == 0) PlayerTextDrawSetString(playerid, T_MS_p[playerid][1], "LD_CHAT:thumbdn");
		if(tipo == 1) PlayerTextDrawSetString(playerid, T_MS_p[playerid][1], "LD_CHAT:thumbup");
		if(tipo == 2) PlayerTextDrawSetString(playerid, T_MS_p[playerid][1], "LD_CHAT:goodcha");
	    PlayerTextDrawSetString(playerid, T_MS_p[playerid][5], straki);
	    KillTimer(timer_mens[playerid]);
	    for(new a; a<9; a++) PlayerTextDrawShow(playerid, T_MS_p[playerid][a]);
	    timer_mens[playerid] = SetTimerEx("FMS", 7000, false, "d", playerid);
    }
    return 1;
}

stock abrir_loja(playerid, d=-1)
{
	new c = id[playerid];
	if(c != -1)
	{
	    if(d == -1)
	    {
		    menu_id[playerid] = MENU_LOJA_FENIX;
			pagina_menu[playerid] = 0;
			escolhendo_menu[playerid] = 0;
			format(nome_menu[playerid], 100, "LOJA ~b~~h~SERVIDOR");
			format(botao_menu[playerid], 100, "CONTINUAR");
			new cont;
		    for(new i; i<MAX_LOJA; i++)
			{
			    if(Loja[i][loja_Existe] == 1)
				{
				if(Loja[i][loja_Lista] == -1)
			    	{
					    Menu[playerid][cont][menu_ID] = i;
					    format(Menu[playerid][cont][menu_Nome], 200, "%s", Loja[i][loja_Nome]);
					    format(Menu[playerid][cont][menu_Info], 200, Loja[i][loja_Info]);
					    Menu[playerid][cont][menu_Modelo] = 3045;
					    if(Loja[i][loja_ID] > 0 && Loja[i][loja_ID] < sizeof Itens) Menu[playerid][cont][menu_Modelo] = modelo_item(Loja[i][loja_ID], Loja[i][loja_Tipo]);
						cont ++;
					}
				}
			}
			max_menu[playerid] = cont;
			if(cont > 0) mostrar_menu(playerid, menu_id[playerid]);
			else ms(playerid, 0, "Nenhum item foi encontrado na loja, Tente Novamente mais tarde !");
		}
		else
		{
		    menu_id[playerid] = MENU_LOJA_FENIX_ITEM;
		    pagina_menu[playerid] = 0;
		    escolhendo_menu[playerid] = 0;
		    format(nome_menu[playerid], 100, Loja[d][loja_Nome]);
		    format(botao_menu[playerid], 100, "COMPRAR");
		    new cont;
		    new tempoaki[30];
		    for(new i; i<MAX_LOJA; i++)
			{
			    if(Loja[i][loja_Existe] == 1)
				{
				if(Loja[i][loja_Lista] == d)
			    	{
			    	    format(tempoaki, 30, "~y~Tempo: ~w~%d Dia(s)~n~", Loja[i][loja_Tempo]);
					    Menu[playerid][cont][menu_ID] = i;
					    format(Menu[playerid][cont][menu_Nome], 200, "%s", Loja[i][loja_Nome]);
					    format(Menu[playerid][cont][menu_Info], 200, "~g~~h~R$ ~w~%s~n~%s%s Unidade(s)", ConvertMoney(Loja[i][loja_Valor]), Loja[i][loja_Tempo]>0?tempoaki:"", ConvertMoney(Loja[i][loja_Unidades]));
					    Menu[playerid][cont][menu_Modelo] = 3045;
					    if(Loja[i][loja_ID] > 0 && Loja[i][loja_ID] < sizeof Itens) Menu[playerid][cont][menu_Modelo] = modelo_item(Loja[i][loja_ID], Loja[i][loja_Tipo]);
						cont ++;
					}
				}
			}
			max_menu[playerid] = cont;
			mostrar_menu(playerid, menu_id[playerid]);
		}
	}
}

stock editar_loja(playerid)
{
	SG[0] = EOS;
	new sss[300];
	new cont;
	zerar_lista(playerid);
	strcat(SG, "{000000}-\t{ffff00}CRIAR LISTA\n");
	for(new a; a<MAX_LOJA; a++)
	{
	    if(Loja[a][loja_Existe] == 1)
	    {
			if(Loja[a][loja_Lista] == -1)
			{
			    format(sss, 300, "{ffffff}%d\t{00ffff}%s\n", cont+1, Loja[a][loja_Nome]);
			    strcat(SG, sss);
			    Lista[playerid][cont] = a;
			    cont ++;
			}
    	}
	}
	format(sss, 200, "{ffffff}Listas [{a1a1a1}%d{ffffff}] {0000CD}Loja Servidor", cont);
	ShowPlayerDialog(playerid, DIALOG_EDITAR_LOJA, DIALOG_STYLE_TABLIST, sss, SG, "Continuar", "Fechar");
}

stock editar_loja_lista_opcoes(playerid, b)
{
    SetPVarInt(playerid, "lista", b);
    SG[0] = EOS;
    strcat(SG, "{ffffff}Editar Nome\n");
    strcat(SG, "{ffffff}Editar Items\n");
    strcat(SG, "{ff0000}Deletar Lista\n");
	ShowPlayerDialog(playerid, DIALOG_EDITAR_LOJA_OPCOES, DIALOG_STYLE_LIST, Loja[b][loja_Nome], SG, "Continuar", "Fechar");
}

stock editar_loja_item_opcoes(playerid, b)
{
    SetPVarInt(playerid, "item", b);
    SG[0] = EOS;
    strcat(SG, "{ffffff}Editar Nome\n");
    strcat(SG, "{ffffff}Editar Info\n");
    strcat(SG, "{ffffff}Setar Valor\n");
    strcat(SG, "{ffffff}ID de um Item\n");
    strcat(SG, "{ffffff}Setar Unidades\n");
    strcat(SG, "{ffffff}Setar Tipo\n");
    strcat(SG, "{ffffff}Setar Tempo\n");
    strcat(SG, "{ff0000}Deletar Item\n");
	ShowPlayerDialog(playerid, DIALOG_EDITAR_LOJA_ITEM_OPCOES, DIALOG_STYLE_LIST, Loja[b][loja_Nome], SG, "Continuar", "Fechar");
}

stock editar_loja_lista(playerid, b)
{
	SetPVarInt(playerid, "lista", b);
	SG[0] = EOS;
	new sss[300];
	new cont;
	zerar_lista(playerid);
	strcat(SG, "{000000}-\t{ffff00}CRIAR ITEM\n");
    for(new a; a<MAX_LOJA; a++)
	{
	    if(Loja[a][loja_Existe] == 1)
	    {
			if(Loja[a][loja_Lista] == b)
			{
			    format(sss, 300, "{ffffff}%d\t{00ffff}%s\n", cont+1, Loja[a][loja_Nome]);
			    strcat(SG, sss);
			    Lista[playerid][cont] = a;
			    cont ++;
			}
    	}
	}
	format(sss, 200, "{ffffff}Items [{a1a1a1}%d{ffffff}] {ffff00}%s", cont, Loja[b][loja_Nome]);
	ShowPlayerDialog(playerid, DIALOG_EDITAR_LOJA_ITENS, DIALOG_STYLE_TABLIST, sss, SG, "Continuar", "Fechar");
}

stock editar_item_da_loja(playerid, a, opc)
{
    new sss[1000];
    SetPVarInt(playerid, "opc", opc);
    if(opc == 0) strcat(sss, "\n{ffff00}[INFO] {ffffff}Digite o novo nome deste Item da Lista:\n");
    if(opc == 1) strcat(sss, "\n{ffff00}[INFO] {ffffff}Digite as informacoes deste Item da Lista:\n");
    if(opc == 2) strcat(sss, "\n{ffff00}[INFO] {ffffff}Digite o Valor deste Item da Lista:\n");
    if(opc == 3) strcat(sss, "\n{ffff00}[INFO] {ffffff}Digite o ID do Item da Lista:\n{a1a1a1}Use 0 para nao ser um item de inventario.\nUse 1000 para Criar um VIP ou SOCIO.");
    if(opc == 4) strcat(sss, "\n{ffff00}[INFO] {ffffff}Digite as Unidades deste Item da Lista:\n");
    if(opc == 5) strcat(sss, "\n{ffff00}[INFO] {ffffff}Digite o Tipo deste Item da Lista:\n{a1a1a1}Use isso para veiculos ou acessorios, caso contrario deixe 0.\nCaso seja um VIP ou SOCIO, Digite qual sera.");
    if(opc == 6) strcat(sss, "\n{ffff00}[INFO] {ffffff}Digite o Tempo em Dias para este item:\n{a1a1a1}Use 0 para um item permanente.\n");
    Input(playerid, DIALOG_EDITAR_ITEM_LOJA, Loja[a][loja_Nome], sss);
}

stock mudar_nome_loja_lista(playerid, a)
{
	new sss[1000];
	strcat(sss, "\n{ffff00}[INFO] {ffffff}Digite o novo nome desta Lista:\n");
    Input(playerid, DIALOG_NOME_LOJA_LISTA, Loja[a][loja_Nome], sss);
}

stock deletar_lista_loja_opc(playerid, a)
{
	ShowPlayerDialog(playerid, DIALOG_EXCLUIR_LISTA_LOJA, DIALOG_STYLE_MSGBOX, Loja[a][loja_Nome],
	"\n{ffff00}[INFO] {a1a1a1}Deseja realmente excluir esta Lista da Loja ?\nTodos os items dessa lista tambem serao excluidos.\n", "Excluir", "Cancelar");
}

stock deletar_item_loja_opc(playerid, a)
{
	ShowPlayerDialog(playerid, DIALOG_EXCLUIR_ITEM_LOJA, DIALOG_STYLE_MSGBOX, Loja[a][loja_Nome],
	"\n{ffff00}[INFO] {a1a1a1}Deseja realmente excluir este Item da Lista ?\n{a1a1a1}A lista nao sera afetada, apenas esse item sera excluido.\n", "Excluir", "Cancelar");
}

stock deletar_lista_loja(a)
{
	Loja[a][loja_Existe] = 0;
	if(Loja[a][loja_Lista] == -1)
	{
		for(new i; i<MAX_LOJA; i++)
		{
            if(Loja[i][loja_Existe] == 1)
            {
                if(Loja[i][loja_Lista] == a)
                {
                    Loja[i][loja_Existe] = 0;
                }
            }
		}
	}
	salvar_loja();
}

BCG:: carregar_loja()
{
    new file[80];
	for(new i; i<MAX_LOJA; i++)
	{
        format(file, 80, "Loja/loja_%d.txt", i);
       	if(DOF2_FileExists(file))
        {
            Loja[i][loja_Existe] = 1;
            Loja[i][loja_Lista] = DOF2_GetInt(file, "loja_Lista");
            Loja[i][loja_Valor] = DOF2_GetInt(file, "loja_Valor");
            Loja[i][loja_ID] = DOF2_GetInt(file, "loja_ID");
            Loja[i][loja_Unidades] = DOF2_GetInt(file, "loja_Unidades");
            Loja[i][loja_Tipo] = DOF2_GetInt(file, "loja_Tipo");
            Loja[i][loja_Tempo] = DOF2_GetInt(file, "loja_Tempo");
            format(Loja[i][loja_Nome], 100, "%s", DOF2_GetString(file, "loja_Nome"));
            format(Loja[i][loja_Info], 200, "%s", DOF2_GetString(file, "loja_Info"));
        }
        else
		{
			Loja[i][loja_Existe] = 0;
            Loja[i][loja_Lista] = -1;
            Loja[i][loja_Valor] = 0;
            Loja[i][loja_ID] = 0;
            Loja[i][loja_Unidades] = 0;
            Loja[i][loja_Tipo] = 0;
            Loja[i][loja_Tempo] = 0;
            format(Loja[i][loja_Nome], 100, "Nenhum");
            format(Loja[i][loja_Info], 200, "Nada");
        }
	}
}

stock salvar_loja(i=-1)
{
	new file[80];
	if(i != -1)
	{
	    format(file, 80, "Loja/loja_%d.txt", i);
	    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
	    if(Loja[i][loja_Existe] == 1)
	    {
	        DOF2_CreateFile(file);
	        DOF2_SetInt(file, "loja_Lista",  Loja[i][loja_Lista]);
	        DOF2_SetInt(file, "loja_Valor",  Loja[i][loja_Valor]);
	        DOF2_SetInt(file, "loja_ID",  Loja[i][loja_ID]);
	        DOF2_SetInt(file, "loja_Unidades",  Loja[i][loja_Unidades]);
	        DOF2_SetInt(file, "loja_Tipo",  Loja[i][loja_Tipo]);
			DOF2_SetInt(file, "loja_Tempo",  Loja[i][loja_Tempo]);
	        DOF2_SetString(file, "loja_Nome", Loja[i][loja_Nome]);
	        DOF2_SetString(file, "loja_Info", Loja[i][loja_Info]);
	        DOF2_SaveFile();
	    }
	}
	else
	{
	    for(new a; a<MAX_LOJA; a++)
	    {
	        format(file, 80, "Loja/loja_%d.txt", a);
		    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
		    if(Loja[a][loja_Existe] == 1)
		    {
			    DOF2_CreateFile(file);
		        DOF2_SetInt(file, "loja_Lista",  Loja[a][loja_Lista]);
		        DOF2_SetInt(file, "loja_Valor",  Loja[a][loja_Valor]);
		        DOF2_SetInt(file, "loja_ID",  Loja[a][loja_ID]);
		        DOF2_SetInt(file, "loja_Unidades",  Loja[a][loja_Unidades]);
		        DOF2_SetInt(file, "loja_Tipo",  Loja[a][loja_Tipo]);
				DOF2_SetInt(file, "loja_Tempo",  Loja[a][loja_Tempo]);
		        DOF2_SetString(file, "loja_Nome", Loja[a][loja_Nome]);
		        DOF2_SetString(file, "loja_Info", Loja[a][loja_Info]);
		        DOF2_SaveFile();
		    }
	    }
	}
}

stock criar_lista_loja()
{
	new cont;
	for(new a; a<MAX_LOJA; a++)
	{
	    if(Loja[a][loja_Existe] == 1)
	    {
	        if(Loja[a][loja_Lista] == -1)
	        {
	            cont ++;
	            if(cont >= MAX_LOJA_LISTA) return -1;
	        }
	    }
	}
	for(new i; i<MAX_LOJA; i++)
	{
	    if(Loja[i][loja_Existe] == 0)
	    {
	        Loja[i][loja_Existe] = 1;
	        Loja[i][loja_Lista] = -1;
	        format(Loja[i][loja_Nome], 100, "Nova Lista - %d", i);
	        format(Loja[i][loja_Info], 200, "Nenhuma Informacao no momento.");
	        Loja[i][loja_Valor] = 0;
	        Loja[i][loja_ID] = 0;
	        Loja[i][loja_Unidades] = 0;
	        Loja[i][loja_Tipo] = 0;
	        Loja[i][loja_Tempo] = 0;
	        salvar_loja(i);
	        return i;
	    }
	}
	return -1;
}

stock criar_item_loja(b)
{
    new cont;
    for(new a; a<MAX_LOJA; a++)
	{
	    if(Loja[a][loja_Existe] == 1)
	    {
	        if(Loja[a][loja_Lista] == b)
	        {
	            cont ++;
	            if(cont >= MAX_LOJA_ITENS) return -1;
	        }
	    }
	}
	for(new i; i<MAX_LOJA; i++)
	{
	    if(Loja[i][loja_Existe] == 0)
	    {
	        Loja[i][loja_Existe] = 1;
	        Loja[i][loja_Lista] = b;
	        format(Loja[i][loja_Nome], 100, "Novo Item - %d", i);
	        format(Loja[i][loja_Info], 200, "Nenhuma Informacao no momento.");
	        Loja[i][loja_Valor] = 0;
	        Loja[i][loja_ID] = 0;
	        Loja[i][loja_Unidades] = 0;
	        Loja[i][loja_Tipo] = 0;
	        Loja[i][loja_Tempo] = 0;
            salvar_loja(i);
            return i;
	    }
	}
	return -1;
}

stock items_lista(lista)
{
	if(Loja[lista][loja_Lista] == -1)
	{
	    new cont;
	    for(new a; a<MAX_LOJA; a++)
	    {
	        if(Loja[a][loja_Existe] == 1)
	        {
	            if(Loja[a][loja_Lista] == lista)
				{
				    cont ++;
				}
	        }
	    }
	    return cont;
	}
	return 0;
}

stock VipPlayer(playerid)
{
    new c = id[playerid];
	if(c != -1)
	{
		return Conta[playerid][c_Vip];
	}
	return 0;
}

stock VipConta(c)
{
 	if(!ContaInvalida(c))
	{
    	return GetContaInt(c, "c_Vip");
    }
    return 0;
}

stock LimparVipConta(c)
{
	if(!ContaInvalida(c))
	{
	    salvar_conta(c, 0, "c_Vip", sv_int(0));
	    salvar_conta(c, 0, "c_VipTempo", sv_int(0));
	}
}


stock LimparVip(playerid)
{
    new c = id[playerid];
	if(c != -1)
	{
	    Conta[playerid][c_Vip] = 0;
		Conta[playerid][c_VipTempo] = 0;
	    salvar_conta(c, 0, "c_Vip", sv_int(Conta[playerid][c_Vip]));
	    salvar_conta(c, 0, "c_VipTempo", sv_int(Conta[playerid][c_VipTempo]));
	}
}

stock DarVip(playerid, vip, dias)
{
	new c = id[playerid];
	if(c != -1)
	{
     	if(VipPlayer(playerid) == vip) Conta[playerid][c_VipTempo] += UM_DIA*dias;
	    else
	    {
		    Conta[playerid][c_Vip] = vip;
		    Conta[playerid][c_VipTempo] =gettime()+(UM_DIA*dias);
	    }
	    salvar_conta(c, 0, "c_Vip", sv_int(Conta[playerid][c_Vip]));
	    salvar_conta(c, 0, "c_VipTempo", sv_int(Conta[playerid][c_VipTempo]));
	}
}

stock DarVipConta(c, vip, dias)
{
	if(!ContaInvalida(c))
	{
	    new tempo;
     	if(GetContaInt(c, "c_Vip") == vip)
		{
		    tempo = GetContaInt(c, "c_VipTempo");
			tempo += UM_DIA*dias;
		}
	    else
	    {
		    tempo = gettime()+(UM_DIA*dias);
	    }
	    salvar_conta(c, 0, "c_Vip", sv_int(vip));
	    salvar_conta(c, 0, "c_VipTempo", sv_int(tempo));
	}
}

stock mostrar_vip(playerid)
{
    new c = id[playerid];
	if(c != -1)
	{
	    new vip = VipPlayer(playerid);
	    if(vip <= 0)
	    {
			MS(playerid, 0, "Voce nao e um VIP - SOCIO de nosso servidor, use /loja para se tornar um.");
	    }
	    else
	    {
	        if(mostrando_vip[playerid] == 0)
	        {
		        new sss[150];
		        fechar_menu(playerid, 1);
		        new tempo = Conta[playerid][c_VipTempo];
		        mostrando_vip[playerid] = 1;
		        format(sss, 150, "%s~n~%s~n~", NomeVip(vip), Validade(tempo));
		        for(new a; a<sizeof T_Vip; a++) TextDrawShowForPlayer(playerid, T_Vip[a]);
		        PlayerTextDrawSetString(playerid, T_Vip_p[playerid][0], sss);
		        PlayerTextDrawShow(playerid, T_Vip_p[playerid][0]);
		        SelectTextDraw(playerid, 0x00ffffff);
		        MS(playerid, 0, "_", 1);
			}
	    }
	}
}

stock NomeVip(v)
{
	v -=1;
	new nome[40];
	format(nome, 40, "Nenhum");
	if(v > -1 && v < sizeof nome_vip)
	{
		format(nome, 40, nome_vip[v]);
	}
	return nome;
}

stock fechar_vip(playerid)
{
    if(mostrando_vip[playerid] == 1)
	{
	    mostrando_vip[playerid] = 0;
		for(new a; a<sizeof T_Vip; a++) TextDrawHideForPlayer(playerid, T_Vip[a]);
	    PlayerTextDrawHide(playerid, T_Vip_p[playerid][0]);
	    CancelSelectTextDraw(playerid);
	    MS(playerid, 0, "_", 1);
	}
}

stock PodeComprarVeiculo(playerid, con=0)
{
    new c = id[playerid];
	if(c != -1)
	{
	    new veics = veiculos_conta(c);
	    new vip = VipPlayer(playerid);
	    new pode = 1;
	    if(vip == 0 && veics >= 5) pode = 0;
	    if(vip == 1 && veics >= 10) pode = 0;
		if(vip == 2 && veics >= 15) pode = 0;
		if(vip == 3 && veics >= 20) pode = 0;
		if(con == 0 && pode == 0) ms(playerid, 0, "Voce atingiu o limite de Veiculos que sua Conta pode ter !");
		return pode;
	}
	return 0;
}

stock PodeComprarCasa(playerid, con=0)
{
    new c = id[playerid];
	if(c != -1)
	{
	    new casas = casas_conta(c);
	    new vip = VipPlayer(playerid);
	    new pode = 1;
	    if(vip == 0 && casas >= 1) pode = 0;
	    if(vip == 1 && casas >= 2) pode = 0;
		if(vip == 2 && casas >= 3) pode = 0;
		if(vip == 4 && casas >= 4) pode = 0;
		if(pode == 0)
		{
		    if(con == 0) ms(playerid, 0, "Voce atingiu o limite de Casas que sua Conta pode ter !");
		    return 0;
		}
		else return 1;
	}
	return 0;
}

stock PodeColocarPortao(playerid)
{
	new c = id[playerid];
	if(c != -1)
	{
	    new por = cont_portoes(playerid);
	    new vip = VipPlayer(playerid);
	    new pode = 1;
	    if(vip == 0 && por >= 1) pode = 0;
	    if(vip == 1 && por >= 3) pode = 0;
		if(vip == 2 && por >= 5) pode = 0;
		if(vip == 4 && por >= 7) pode = 0;
		if(pode == 0)
		{
		    ms(playerid, 0, "Voce atingiu o limite de Portoes no mapa que sua Conta pode ter !");
		    return 0;
		}
		else return 1;
	}
	return 0;
}

stock PodeColocarAcessorios(playerid)
{
    new c = id[playerid];
	if(c != -1)
	{
		new aces = cont_acessorios(playerid);
		new vip = VipPlayer(playerid);
		new pode = 1;
		if(vip == 0 && aces >= 1) pode = 0;
		if(vip == 1 && aces >= 2) pode = 0;
		if(vip == 2 && aces >= 3) pode = 0;
		if(vip == 4 && aces >= 5) pode = 0;
		if(pode == 0)
		{
		    ms(playerid, 0, "Voce atingiu o limite de Acessorios que sua Conta pode usar !");
		    return 0;
		}
		else return 1;
	}
	return 0;
}

stock realizar_compra2(playerid, a)
{
    new c = id[playerid];
	if(c != -1)
	{
	    if(Loja[a][loja_Existe] == 1)
	    {
	        new idd = Loja[a][loja_ID];
	        new tipo = Loja[a][loja_Tipo];
	        new unidades = Loja[a][loja_Unidades];
	        new cash = Loja[a][loja_Valor];
	        new dias = Loja[a][loja_Tempo];
			if(cash > CashPlayer(playerid))
			{
			    MS(playerid, 0, "Voce nao tem Cash suficiente para realizar esta compra !");
			}
			else if(idd == 9998 && fac_estoque < 1)
			{
			    MS(playerid, 0, "No momento nao ha estoque disponivel para este item !");
			}
			else
			{
			    new sss[300];
			    SetPVarInt(playerid, "aaaaaa", a);
			    SG[0] = EOS;
				strcat(SG, "{ffff00}FINALIZAR COMPRA\n\n");
				if(idd == 1000)
				{
				    format(sss, 300, "{ffffff}Produto: {00ffff}%s\n", NomeVip(tipo));
					strcat(SG, sss);
				}
				else
				{
				    format(sss, 300, "{ffffff}Produto: {00ffff}%s\n", Loja[a][loja_Nome]);
					strcat(SG, sss);
				}
				if(idd > 0 && idd < sizeof Itens)
				{
					format(sss, 300, "{ffffff}Unidades: {00ffff}%s\n", ConvertMoney(unidades));
					strcat(SG, sss);
				}
				if(dias > 0)
				{
					format(sss, 300, "{ffffff}Tempo: {00ffff}%d Dia(s)\n", dias);
					strcat(SG, sss);
				}
				format(sss, 300, "{ffffff}Cash: {ffff00} R$ %s\n", ConvertMoney(cash));
				strcat(SG, sss);
			    strcat(SG, "\n\n");
			    strcat(SG, "{4169E1}[INFO] {a1a1a1}Deseja comfirmar a compra do produto a cima ?\n");
			    ShowPlayerDialog(playerid, DIALOG_CONFIRMAR_LOJA, DIALOG_STYLE_MSGBOX, "{000000}.", SG, "Comprar", "Cancelar");
			}
	    }
	}
}

stock realizar_compra(playerid, a)
{
	new c = id[playerid];
	if(c != -1)
	{
	    if(Loja[a][loja_Existe] == 1)
	    {
	        new idd = Loja[a][loja_ID];
	        new tipo = Loja[a][loja_Tipo];
	        new unidades = Loja[a][loja_Unidades];
	        new cash = Loja[a][loja_Valor];
	        new dias = Loja[a][loja_Tempo];
	        new sss[300];

	        if(cash > CashPlayer(playerid))
			{
			    MS(playerid, 0, "Voce nao tem Cash suficiente para realizar esta compra !");
			}
			else if(idd == 9998)
			{
			    if(fac_estoque < 1) { MS(playerid, 0, "Estoque de faccao esgotado !"); return; }
			    if(OrgPlayer(playerid) != -1) { MS(playerid, 0, "Voce ja pertence a uma organizacao !"); return; }
			    SetPVarInt(playerid, "fac_cash", cash);
			    ShowPlayerDialog(playerid, DIALOG_CRIAR_FACCAO, DIALOG_STYLE_INPUT, "{ffff00}Criar Faccao", "{ffffff}Digite o nome da sua faccao:", "Continuar", "Cancelar");
			    return;
			}
			else
			{
			    new strs[300];
			    new strdias[50];
			    if(dias == 1) format(strdias, 100, "[%d Dia]", dias);
                else format(strdias, 100, "[%d Dias]", dias);

		        // se for um Item de Inventario //
				if(idd > 0 && idd < sizeof Itens)
				{
				    new i = inv_vazio(playerid);
				    if(i != -1)
					{
                        if(add_inv(c, idd, unidades, tipo, 0, dias*UM_DIA))
                        {
                            DarCash(playerid, -cash);
                            MS(playerid, 1, "Compra realizada com sucesso ! Confira seu Inventario.");
                            format(strs, 300, "{ffff00}[LOJA] {00ffff}%s {ffffff}comprou '%s' %s por {ffff00}R$ %s {ffffff}de Cash.", Nome(playerid), Loja[a][loja_Nome], (dias == 0)?"":strdias, ConvertMoney(cash)), mst(0xffffffff, strs);
                        }
				    }
				    else MS(playerid, 0, "Seu Inventario esta lotado !");
				}

				// se for vip ou socio //
				if(idd == 1000)
				{
				    if(tipo > 0 && tipo <= sizeof nome_vip)
					{
						if(tipo < VipPlayer(playerid))
						{
						    MS(playerid, 0, "Voce ja possueum VIP ou SOCIO superior ao da Compra !");
						}
						else if(tipo == VipPlayer(playerid))
						{
						    DarCash(playerid, -cash);
							DarVip(playerid, tipo, dias);
							format(sss, 300, "Voce comprou +%d Dias de '%s', use /vip para mais informacoes !", dias, NomeVip(tipo));
							MS(playerid, 1, sss);
							format(strs, 300, "{ffff00}[LOJA] {00ffff}%s {ffffff}comprou '%s' %s por {ffff00}R$ %s {ffffff}de Cash.", Nome(playerid), Loja[a][loja_Nome], (dias == 0)?"":strdias, ConvertMoney(cash)), mst(0xffffffff, strs);
						}
						else
						{
						    if(VipPlayer(playerid) == 0)
							{
							DarCash(playerid, -cash);
								DarVip(playerid, tipo, dias);
								format(sss, 300, "Voce comprou %d Dias de '%s', use /vip para mais informacoes !", dias, NomeVip(tipo));
								MS(playerid, 1, sss);
								format(strs, 300, "{ffff00}[LOJA] {00ffff}%s {ffffff}comprou '%s' %s por {ffff00}R$ %s {ffffff}de Cash.", Nome(playerid), Loja[a][loja_Nome], (dias == 0)?"":strdias, ConvertMoney(cash)), mst(0xffffffff, strs);
						    }
						    else
							{
							new tempo = 1;
							new vipp = VipPlayer(playerid);
							tempo = tempo*vipp;
					        format(sss, 300, "Voce comprou %d Dias de '%s', e ganhou %d dias pelo vip que ja possuia !",  dias, NomeVip(tipo), tempo);
								dias += tempo;
					        DarCash(playerid, -cash);
								DarVip(playerid, tipo, dias);
								MS(playerid, 1, sss);
								format(strs, 300, "{ffff00}[LOJA] {00ffff}%s {ffffff}comprou '%s' %s por {ffff00}R$ %s {ffffff}de Cash.", Nome(playerid), Loja[a][loja_Nome], (dias == 0)?"":strdias, ConvertMoney(cash)), mst(0xffffffff, strs);
						    }
						}
				    }
				}

				// acoes dentro do jogo //
				if(Loja[a][loja_ID] == 0)
				{
				    new comprou;
				    if(tipo > 0)
					{
					// concerto de veiculo //
				     	if(tipo == 1)
				    	{
							if(IsPlayerInAnyVehicle(playerid))
							{
							    new veh = GetPlayerVehicleID(playerid);
							    new info = Info_Veiculo[veh];
							    if(info != -1)
								{
								Veiculo[info][v_Vida] = 1000.0;
									SetVehicleHealth(veh, Veiculo[info][v_Vida]);
									RepairVehicle(veh);
							    }
							    else
								{
								SetVehicleHealth(veh, 1000.0);
									RepairVehicle(veh);
							    }
							    comprou = 1;
							}
							else MS(playerid, 0, "Voce nao esta entro de um veiculo !");
					}

					// limpar fome e sede //
				     	if(tipo == 2)
				    	{
                            SetarFome(playerid, 100);
                            SetarSede(playerid, 100);
                            comprou = 1;
					}

					// encher vida //
				     	if(tipo == 3)
				    	{
                            SetarVida(playerid, 100);
                            comprou = 1;
					}

					// encher colete //
				     	if(tipo == 4)
				    	{
                            SetarColete(playerid, 100);
                            comprou = 1;
					}

					// maximo de forca //
				     	if(tipo == 5)
				    	{
                            SetarForca(playerid, 100);
                            comprou = 1;
					}

					// maximo de resistencia //
				     	if(tipo == 6)
				    	{
                            SetarResistencia(playerid, 100);
                            comprou = 1;
					}

						if(comprou == 1)
						{
						format(sss, 300, "Voce comprou '%s' por R$ %s Cash !", Loja[a][loja_Nome], ConvertMoney(cash));
		                    DarCash(playerid, -cash);
							MS(playerid, 1, sss);
							format(strs, 300, "{ffff00}[LOJA] {00ffff}%s {ffffff}comprou '%s' %s por {ffff00}R$ %s {ffffff}de Cash.", Nome(playerid), Loja[a][loja_Nome], (dias == 0)?"":strdias, ConvertMoney(cash)), mst(0xffffffff, strs);
						}
				    }
				}
			}
	    }
	}
}

stock MetaEmprego(playerid, con=1)
{
	new c = id[playerid];
	if(c != -1)
	{
	    new e = Conta[playerid][c_Emprego];
	    if(e != -1)
	    {
	        if(Conta[playerid][c_MetaEmprego][e] < max_meta_emprego[e])
	        {
	            Conta[playerid][c_MetaHora] = gettime();
	        	Conta[playerid][c_MetaEmprego][e] += con;
	        	salvar_conta(c, -1, "Metas_Empregos");
	        	if(Conta[playerid][c_MetaEmprego][e] >= max_meta_emprego[e]) ms(playerid, 2, "Voce cumpriu a meta de seu emprego para este payday, e ira receber seu salario !");
	        }
	    }
	}
}

stock mostrar_meta(playerid)
{
    new c = id[playerid];
	if(c != -1)
	{
	    new e = Conta[playerid][c_Emprego];
	    if(e != -1)
	    {
	        SG[0] = EOS;
	        strcat(SG, "{ffffff}Emprego: {ffff00}");
	        strcat(SG, NomeEmprego(e));
	        strcat(SG, "\n\n");
	        strcat(SG, InfoMetaEmprego[e]);
	        strcat(SG, "\n");
	        new sss[300];
	        if(Conta[playerid][c_MetaEmprego][e] < max_meta_emprego[e]) format(sss, 300, "{ffff00}Progresso atual - %d/%d\n", Conta[playerid][c_MetaEmprego][e], max_meta_emprego[e]);
	        else format(sss, 300, "{4169E1}Concluido !!!\n");
	        strcat(SG, sss);
	        ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}.", SG, "Ok", "Fechar");
	    }
	    else ms(playerid, 0, "Voce nao tem um emprego !");
	}
}


stock fechar_trade(playerid)
{
    if(mostrando_trade[playerid] == 1)
    {
        mostrando_trade[playerid] = 0;
        for(new a; a<sizeof T_Trade; a++) TextDrawHideForPlayer(playerid, T_Trade[a]);
    	for(new a; a<24; a++) PlayerTextDrawDestroy(playerid, T_Trade_p[playerid][a]);
        CancelSelectTextDraw(playerid);
        SetPVarInt(playerid, "tds_trade_exist", 0);
    }
}

stock mostrar_trade(playerid, con=-1)
{
	if(GetPVarInt(playerid, "tds_trade_exist") == 0) { criar_tds_trade(playerid); SetPVarInt(playerid, "tds_trade_exist", 1); }
	new c = id[playerid];
	if(c != -1)
	{
		new pla = negociando[playerid];
		if(Online(pla))
		{
		    new sss[300];
		    new unidades[150];
		    if(mostrando_trade[playerid] == 0)
		    {

		        if(inv_novo_aberto[playerid] == 1) fechar_inv_novo(playerid);
			    if(mostrando_trade[playerid] == 1) cancelar_trade(playerid);
			    if(mostrando_vip[playerid] == 1) fechar_vip(playerid);
			    if(mostrando_banco[playerid] == 1) fechar_banco(playerid);
			    if(mostrando_menu[playerid] == 1) RespostaMenu(playerid, menu_id[playerid], 0, escolhendo_menu[playerid]);
			    if(celular_aberto[playerid] != -1) fechar_celular(playerid);
				if(mostrando_radio[playerid] == 1) fechar_radio(playerid);
				if(imobilizado[playerid] == 1) SelectTextDraw(playerid, 0xffff00ff);
			    if(id[playerid] == -1) SelectTextDraw(playerid, 0xffff00ff);
			    if(logado[playerid] == 0) SelectTextDraw(playerid, 0xffff00ff);
			    if(menu_vei_aberto[playerid] == 1) fechar_menu_vei(playerid);
			    if(dando_tacada[playerid] == 1) SelectTextDraw(playerid, 0xffff00ff);


		        mostrando_trade[playerid] = 1;
		        trade_aceitou[playerid] = 0;
		        pagina_trade[playerid] = 0;
		        trade_slot[playerid] = -1;
		        trade_grana[playerid] = 0;
		        trade_cash[playerid] = 0;
		        trade_tempo[playerid] = 0;
		        for(new a; a<sizeof T_Trade; a++) TextDrawShowForPlayer(playerid, T_Trade[a]);
		        format(sss, 300, "Negociando com: ~y~%s", Nome(pla));
		        PlayerTextDrawSetString(playerid, T_Trade_p[playerid][0], sss);
		    	PlayerTextDrawShow(playerid, T_Trade_p[playerid][0]);
		        SelectTextDraw(playerid, 0xffffff70);
		    }

		    // mostrar inventario //
		    if(con == -1 || con == 1)
		    {
			    new cont;
				for(new i; i<MAX_SLOTS; i++)
				{
				ListaInv[playerid][i] = -1;
				if(Inventario[playerid][i][inv_ID] > 0)
				{
		                if(Inventario[playerid][i][inv_Ativo] == 1 && Inventario[playerid][i][inv_Tempo] != 0)
		                {
		                    if(Inventario[playerid][i][inv_Tempo] <= gettime())
		                    {
		                        format(sss, 300, "O Item '%s' foi excluido do seu inventario, por vencimento !", NomeItem(Inventario[playerid][i][inv_ID], Inventario[playerid][i][inv_Tipo]));
								ms(playerid, 2, sss);
								limpar_slot(playerid, i);
  								continue;
							}
		                }
		                if(i == trade_slot[playerid]) continue;
	                	ListaInv[playerid][cont] = i;
	                	cont ++;
				}
			    }

			    // atualizar pagina //
			    new pags = paginas(3, cont);
				for(new d; d<15; d++)
				{
				if(pagina_trade[playerid]+1 > pags)
			    	{
				    pagina_trade[playerid] --;
				}
			    }

			    // mostrar qual pagina ta //
			    format(unidades, 150, "SEU INVENTARIO ~Y~%d / %d~n~~n~~n~~n~~n~", pagina_trade[playerid]+1, pags);
			    PlayerTextDrawSetString(playerid, T_Trade_p[playerid][1], unidades);
			    PlayerTextDrawShow(playerid, T_Trade_p[playerid][1]);
			    if(pagina_trade[playerid] > 0) TextDrawShowForPlayer(playerid, T_Trade[4]);
			    else TextDrawHideForPlayer(playerid, T_Trade[4]);
				if(pags > pagina_trade[playerid]+1) TextDrawShowForPlayer(playerid, T_Trade[5]);
	            else TextDrawHideForPlayer(playerid, T_Trade[5]);

	            // mostrar os items //
				for(new a; a<3; a++)
				{
				new i = a+(pagina_trade[playerid]*3);
				new slot = ListaInv[playerid][i];
				new idd;
				new tipo;
				new unid;
				if(slot > -1)
				{
				    idd = Inventario[playerid][slot][inv_ID];
					tipo = Inventario[playerid][slot][inv_Tipo];
					unid = Inventario[playerid][slot][inv_Unidades];
				}
				else
				{
				    idd = 0;
					tipo = 0;
					unid = 0;
				}

				new model = modelo_item(idd, tipo);
				format(unidades, 20, ConvertMoney(unid));
				if(ListaInv[playerid][i] != -1 && idd != 0)
				{
				    PlayerTextDrawColor(playerid, T_Trade_p[playerid][a+4], 0xffffffff);
				    PlayerTextDrawColor(playerid, T_Trade_p[playerid][a+13], -103);
				    PlayerTextDrawColor(playerid, T_Trade_p[playerid][a+16], -30298);
				    PlayerTextDrawSetPreviewModel(playerid, T_Trade_p[playerid][a+4], model);
				    PlayerTextDrawSetPreviewRot(playerid, T_Trade_p[playerid][a+4], Itens[idd][item_PreX], Itens[idd][item_PreY], Itens[idd][item_PreZ], Itens[idd][item_PreV]);
						PlayerTextDrawSetString(playerid, T_Trade_p[playerid][a+13], NomeItem(idd, tipo, Inventario[playerid][slot][inv_Ativo], Inventario[playerid][slot][inv_Tempo]));
						PlayerTextDrawSetString(playerid, T_Trade_p[playerid][a+16], unidades);
					}
				else
				{
				    PlayerTextDrawSetPreviewModel(playerid, T_Trade_p[playerid][a+4], modelo_item(idd));
				    PlayerTextDrawColor(playerid, T_Trade_p[playerid][a+4], 0x00000035);
				    PlayerTextDrawSetString(playerid, T_Trade_p[playerid][a+13], "VAZIO");
				    PlayerTextDrawColor(playerid, T_Trade_p[playerid][a+13], 0xffffff25);
				    PlayerTextDrawColor(playerid, T_Trade_p[playerid][a+16], 0x00000000);
				}
				PlayerTextDrawShow(playerid, T_Trade_p[playerid][a+4]);
				PlayerTextDrawShow(playerid, T_Trade_p[playerid][a+13]);
				PlayerTextDrawShow(playerid, T_Trade_p[playerid][a+16]);
			    }

		    }

		    // status da troca //
		    if(con == -1 || con == 2)
		    {
		        if(trade_aceitou[playerid] == 0)
				{
					PlayerTextDrawBoxColor(playerid, T_Trade_p[playerid][2], 167);
					TextDrawShowForPlayer(playerid, T_Trade[2]);
					TextDrawHideForPlayer(playerid, T_Trade[3]);
				}
	            else
				{
					PlayerTextDrawBoxColor(playerid, T_Trade_p[playerid][2], 0x00ff0015);
					TextDrawShowForPlayer(playerid, T_Trade[3]);
					TextDrawHideForPlayer(playerid, T_Trade[2]);
				}
             	if(trade_aceitou[pla] == 0) PlayerTextDrawBoxColor(playerid, T_Trade_p[playerid][3], 167);
	            else PlayerTextDrawBoxColor(playerid, T_Trade_p[playerid][3], 0x00ff0015);
	            PlayerTextDrawShow(playerid, T_Trade_p[playerid][2]);
	            PlayerTextDrawShow(playerid, T_Trade_p[playerid][3]);
		    }

		    // items e grana na troca //
		    if(con == -1 || con == 3)
		    {

		        format(sss, 300, "R$: %s", ConvertMoney(trade_grana[playerid]));
		        PlayerTextDrawSetString(playerid, T_Trade_p[playerid][9], sss);
		        format(sss, 300, "R$: %s", ConvertMoney(trade_grana[pla]));
		        PlayerTextDrawSetString(playerid, T_Trade_p[playerid][10], sss);
		        format(sss, 300, "Cash: %s", ConvertMoney(trade_cash[playerid]));
		        PlayerTextDrawSetString(playerid, T_Trade_p[playerid][11], sss);
		        format(sss, 300, "Cash: %s", ConvertMoney(trade_cash[pla]));
		        PlayerTextDrawSetString(playerid, T_Trade_p[playerid][12], sss);
		        PlayerTextDrawShow(playerid, T_Trade_p[playerid][9]);
		        PlayerTextDrawShow(playerid, T_Trade_p[playerid][10]);
		        PlayerTextDrawShow(playerid, T_Trade_p[playerid][11]);
		        PlayerTextDrawShow(playerid, T_Trade_p[playerid][12]);

		        new slot;
		        new idd;
		        new tipo;
		        new unid;
		        new model;

		        slot = trade_slot[playerid];
		        if(slot > -1)
		        {
		            idd = Inventario[playerid][slot][inv_ID];
		        	tipo = Inventario[playerid][slot][inv_Tipo];
		        	unid = Inventario[playerid][slot][inv_Unidades];
		        }
		        else
		        {
		            idd = 0;
		        	tipo = 0;
		        	unid = 0;
		        }

		        model = modelo_item(idd, tipo);
		        format(unidades, 20, ConvertMoney(unid));
		        if(idd != 0)
		        {
		            PlayerTextDrawColor(playerid, T_Trade_p[playerid][7], 0xffffffff);
		            PlayerTextDrawColor(playerid, T_Trade_p[playerid][19], -103);
		            PlayerTextDrawColor(playerid, T_Trade_p[playerid][20], -30298);
		            PlayerTextDrawSetPreviewModel(playerid, T_Trade_p[playerid][7], model);
		            PlayerTextDrawSetPreviewRot(playerid, T_Trade_p[playerid][7], Itens[idd][item_PreX], Itens[idd][item_PreY], Itens[idd][item_PreZ], Itens[idd][item_PreV]);
					PlayerTextDrawSetString(playerid, T_Trade_p[playerid][19], NomeItem(idd, tipo, Inventario[playerid][slot][inv_Ativo], Inventario[playerid][slot][inv_Tempo]));
					PlayerTextDrawSetString(playerid, T_Trade_p[playerid][20], unidades);
				}
		        else
		        {
		            PlayerTextDrawSetPreviewModel(playerid, T_Trade_p[playerid][7], modelo_item(idd));
		            PlayerTextDrawColor(playerid, T_Trade_p[playerid][7], 0x00000035);
		            PlayerTextDrawSetString(playerid, T_Trade_p[playerid][19], "VAZIO");
		            PlayerTextDrawColor(playerid, T_Trade_p[playerid][19], 0xffffff25);
		            PlayerTextDrawColor(playerid, T_Trade_p[playerid][20], 0x00000000);
		        }
		        PlayerTextDrawShow(playerid, T_Trade_p[playerid][7]);
		        PlayerTextDrawShow(playerid, T_Trade_p[playerid][19]);
		        PlayerTextDrawShow(playerid, T_Trade_p[playerid][20]);


				slot = trade_slot[pla];
		        if(slot > -1)
		        {
		            idd = Inventario[pla][slot][inv_ID];
		        	tipo = Inventario[pla][slot][inv_Tipo];
		        	unid = Inventario[pla][slot][inv_Unidades];
		        }
		        else
		        {
		            idd = 0;
		        	tipo = 0;
		        	unid = 0;
		        }

		        model = modelo_item(idd, tipo);
		        format(unidades, 20, ConvertMoney(unid));
		        if(idd != 0)
		        {
		            PlayerTextDrawColor(playerid, T_Trade_p[playerid][8], 0xffffffff);
		            PlayerTextDrawColor(playerid, T_Trade_p[playerid][21], -103);
		            PlayerTextDrawColor(playerid, T_Trade_p[playerid][22], -30298);
		            PlayerTextDrawSetPreviewModel(playerid, T_Trade_p[playerid][8], model);
		            PlayerTextDrawSetPreviewRot(playerid, T_Trade_p[playerid][8], Itens[idd][item_PreX], Itens[idd][item_PreY], Itens[idd][item_PreZ], Itens[idd][item_PreV]);
					PlayerTextDrawSetString(playerid, T_Trade_p[playerid][21], NomeItem(idd, tipo, Inventario[pla][slot][inv_Ativo], Inventario[pla][slot][inv_Tempo]));
					PlayerTextDrawSetString(playerid, T_Trade_p[playerid][22], unidades);
				}
		        else
		        {
		            PlayerTextDrawSetPreviewModel(playerid, T_Trade_p[playerid][8], modelo_item(idd));
		            PlayerTextDrawColor(playerid, T_Trade_p[playerid][8], 0x00000035);
		            PlayerTextDrawSetString(playerid, T_Trade_p[playerid][21], "VAZIO");
		            PlayerTextDrawColor(playerid, T_Trade_p[playerid][21], 0xffffff25);
		            PlayerTextDrawColor(playerid, T_Trade_p[playerid][22], 0x00000000);
		        }
		        PlayerTextDrawShow(playerid, T_Trade_p[playerid][8]);
		        PlayerTextDrawShow(playerid, T_Trade_p[playerid][21]);
		        PlayerTextDrawShow(playerid, T_Trade_p[playerid][22]);
		    }

		    if(trade_aceitou[playerid] == 1 && trade_aceitou[pla] == 1)
		    {
		        if(trade_tempo[playerid] == 0) trade_tempo[playerid] = 10;
		        format(sss, 300, "~Y~FINALIZANDO~N~~W~%d", trade_tempo[playerid]);
                PlayerTextDrawSetString(playerid, T_Trade_p[playerid][23], sss);
                PlayerTextDrawShow(playerid, T_Trade_p[playerid][23]);
		    }
		    else
			{
			    trade_tempo[playerid] = 0;
			    trade_tempo[pla] = 0;
				PlayerTextDrawHide(playerid, T_Trade_p[playerid][23]);
			}
		}
		else
		{
		    cancelar_trade(playerid);
		}
	}
}

stock cancelar_trade(playerid, com=0)
{
	// fechou a negociacao //
	new pla = negociando[playerid];
	new sss[300];
	fechar_trade(playerid);
	format(sss, 300, "Voce desistiu da negociacao com '%s' !", Nome(pla));
	if(com == 0) ms(playerid, 0, sss);
	if(Online(pla))
	{
	    fechar_trade(pla);
	    format(sss, 300, "O jogador '%s' desistiu da negociacao !", Nome(playerid));
	    if(com == 0) ms(pla, 0, sss);
	    negociando[pla] = -1;
	}
	negociando[playerid] = -1;
}

stock convite_negociar(playerid, pla)
{
	new ta = 1;
	if(!Online(pla)) ms(playerid, 0, "Este jogador nao esta mais Online, tente novamente.");
	else
	{
		if(GetPlayerInterior(playerid) == GetPlayerInterior(pla))
		{
		    if(GetPlayerVirtualWorld_(playerid) == GetPlayerVirtualWorld_(pla))
		    {
		        new Float:p[3];
		        GetPlayerPos(pla, p[0], p[1], p[2]);
		        if(IsPlayerInRangeOfPoint(playerid, 10, p[0], p[1], p[2]))
		        {
					if(negociando[pla] != -1) ms(playerid, 0, "Este jogador ja esta negociando no momento !");
					else
					{

					    if(inv_novo_aberto[playerid] == 1) ms(playerid, 0, "Voce nao pode negociar com seu inventario aberto !");
					    else if(inv_novo_aberto[pla] == 1)ms(playerid, 0, "Este jogador esta com o inventario aberto !");
					    else
						{
	                        negociando[playerid] = pla;
						    negociando[pla] = playerid;
						    trade_aceitou[playerid] = 0;
						trade_slot[playerid] = -1;
						trade_grana[playerid] = 0;
						trade_cash[playerid] = 0;
						trade_tempo[playerid] = 0;
						trade_aceitou[pla] = 0;
						trade_slot[pla] = -1;
						trade_grana[pla] = 0;
						trade_cash[pla] = 0;
						trade_tempo[pla] = 0;
							mostrar_trade(playerid);
							mostrar_trade(pla);
						}
					}
		        }
		        else ta = 0;
		    }
		    else ta = 0;
		}
		else ta = 0;
		if(ta == 0) ms(playerid, 0, "Este jogador nao esta mais proximo de voce, tente novamente.");
	}
}

stock voltar_trade(playerid, pla)
{
    trade_aceitou[playerid] = 0;
    trade_aceitou[pla] = 0;
	mostrar_trade(playerid, 2);
	mostrar_trade(pla, 2);
}

stock finalizar_trade(playerid, pla)
{
	new c = id[playerid];
	if(c != -1)
	{
	    if(Online(pla))
	    {
	        if(GetPVarInt(playerid, "flood_trade") < gettime() && GetPVarInt(pla, "flood_trade") < gettime())
	        {
	            SetPVarInt(playerid, "flood_trade", gettime()+9);
				SetPVarInt(pla, "flood_trade", gettime()+9);

		        new slot1 = trade_slot[playerid];
		        new slot2 = trade_slot[pla];
		        new s1 = inv_vazio(playerid);
				new s2 = inv_vazio(pla);

				if(slot2 != -1 && s1 == -1)
				{
				    ms(playerid, 0, "O seu Inventario esta cheio, a negociacao falhou !");
				    ms(pla, 0, "O Inventario do jogador esta cheio, a negociacao falhou !");
				    voltar_trade(playerid, pla);
				}
				else if(slot1 != -1 && s2 == -1)
				{
				    ms(pla, 0, "O seu Inventario esta cheio, a negociacao falhou !");
				    ms(playerid, 0, "O Inventario do jogador esta cheio, a negociacao falhou !");
				    voltar_trade(playerid, pla);
				}
				else if(trade_grana[playerid] > GranaPlayer(playerid))
				{
				    ms(pla, 0, "O jogador nao tem a quantia em dinheiro que ofereceu !");
				    ms(playerid, 0, "Voce nao tem a quantia em dinheiro que ofereceu !");
				    voltar_trade(playerid, pla);
				}
				else if(trade_grana[pla] > GranaPlayer(pla))
				{
				    ms(playerid, 0, "O jogador nao tem a quantia em dinheiro que ofereceu !");
				    ms(pla, 0, "Voce nao tem a quantia em dinheiro que ofereceu !");
				    voltar_trade(playerid, pla);
				}
				else if(trade_cash[pla] > CashPlayer(pla))
				{
				    ms(playerid, 0, "O jogador nao tem a quantia em Cash que ofereceu !");
				    ms(pla, 0, "Voce nao tem a quantia em Cash que ofereceu !");
				    voltar_trade(playerid, pla);
				}
				else if(trade_cash[playerid] > CashPlayer(playerid))
				{
				    ms(pla, 0, "O jogador nao tem a quantia em dinheiro que ofereceu !");
				    ms(playerid, 0, "Voce nao tem a quantia em dinheiro que ofereceu !");
				    voltar_trade(playerid, pla);
				}
				else
				{
				    if(slot2 != -1)
					{
						Inventario[playerid][s1][inv_ID] = Inventario[pla][slot2][inv_ID];
						Inventario[playerid][s1][inv_Unidades] = Inventario[pla][slot2][inv_Unidades];
						Inventario[playerid][s1][inv_Tipo] = Inventario[pla][slot2][inv_Tipo];
						Inventario[playerid][s1][inv_Ativo] = Inventario[pla][slot2][inv_Ativo];
						Inventario[playerid][s1][inv_Tempo] = Inventario[pla][slot2][inv_Tempo];
						Inventario[pla][slot2][inv_ID] = 0;
						Inventario[pla][slot2][inv_Unidades] = 0;
						Inventario[pla][slot2][inv_Tipo] = 0;
						Inventario[pla][slot2][inv_Ativo] = 0;
						Inventario[pla][slot2][inv_Tempo] = 0;
					}

					if(slot1 != -1)
					{
						Inventario[pla][s2][inv_ID] = Inventario[playerid][slot1][inv_ID];
						Inventario[pla][s2][inv_Unidades] = Inventario[playerid][slot1][inv_Unidades];
						Inventario[pla][s2][inv_Tipo] = Inventario[playerid][slot1][inv_Tipo];
						Inventario[pla][s2][inv_Ativo] = Inventario[playerid][slot1][inv_Ativo];
						Inventario[pla][s2][inv_Tempo] = Inventario[playerid][slot1][inv_Tempo];
						Inventario[playerid][slot1][inv_ID] = 0;
						Inventario[playerid][slot1][inv_Unidades] = 0;
						Inventario[playerid][slot1][inv_Tipo] = 0;
						Inventario[playerid][slot1][inv_Ativo] = 0;
						Inventario[playerid][slot1][inv_Tempo] = 0;
					}

					if(trade_cash[pla] > 0)
					{
					    DarCash(playerid, trade_cash[pla]);
					    DarCash(pla, -trade_cash[pla]);
					}

					if(trade_cash[playerid] > 0)
					{
					    DarCash(pla, trade_cash[playerid]);
					    DarCash(playerid, -trade_cash[playerid]);
					}

					if(trade_grana[pla] > 0)
					{
					    DarGrana(playerid, trade_grana[pla]);
					    DarGrana(pla, -trade_grana[pla]);
					}

					if(trade_grana[playerid] > 0)
					{
					    DarGrana(pla, trade_grana[playerid]);
					    DarGrana(playerid, -trade_grana[playerid]);
					}

					ms(playerid, 2, "A negociacao foi finalizaca com sucesso !");
					ms(pla, 2, "A negociacao foi finalizaca com sucesso !");
					negociando[playerid] = -1;
					fechar_trade(playerid);
					negociando[pla] = -1;
					fechar_trade(pla);
					salvar_inventario(c);
					salvar_inventario(id[pla]);
				}
			}
	    }
	}

	return 1;
}

stock mostrar_cores(playerid, con=-1)
{
	if(Online(playerid))
	{
	    if(con != -1) opcao_cor[playerid] = con;
		SG[0] = EOS;
		new sss1[300];
		new limite;
		new pags = paginas(50, sizeof(Colors));
		for(new i = pagina_dialog4[playerid]*50; i<sizeof(Colors); i++)
		{
		    limite ++;
			format(sss1, 300, "{%06x}================================================================\n", Colors[i] >>> 8);
	        strcat(SG, sss1);
	        if(limite == 50)
			{
			    strcat(SG, "{4169E1}>>>> AVANCAR >>>>\n");
			    strcat(SG, "{ffff00}<<<<  VOLTAR <<<<\n");
	            break;
			}
		}
		if(limite < 50)
		{
		    strcat(SG, "{4169E1}>>>> AVANCAR >>>>\n");
		    strcat(SG, "{ffff00}<<<<  VOLTAR <<<<\n");
		}
	    format(sss1, 300, "{ffffff}Lista de Cores  {a1a1a1}Pagina {00ffff}%d{a1a1a1}/{ffff00}%d",  pagina_dialog4[playerid]+1, pags);
	    ShowPlayerDialog(playerid, DIALOG_CORES, DIALOG_STYLE_LIST, sss1, SG, "Continuar", "Fechar");
	}
}

stock resposta_cor(playerid, cor)
{
    new idopcao = opcao_cor[playerid];
	if(Online(playerid))
	{
	    // cor org //
	    if(idopcao == 0)
	    {
	        new o = GetPVarInt(playerid, "org_cor");
	        if(Org[o][o_Existe] == 1)
	        {
	            if(cor == 0)
	            {
	                ms(playerid, 0, "Essa cor nao pode ser setada em uma Org ! Tente outra.");
	                mostrar_cores(playerid);
	            }
	            else
	            {
		            Org[o][o_Cor] = cor;
		            salvar_org(o);
		            new sss[300];
					format(sss, 300, "Voce mudou a Cor da Organizacao '%s'[%d], para ID:%d.", Org[o][o_Nome], o, cor);
					ms(playerid, 5, sss);
				}
	        }
	    }

	    // cor veiculo //
	    if(idopcao == 1)
	    {
	        new corv = GetPVarInt(playerid, "cor");
	        new veh = GetPVarInt(playerid, "veh");
	        if(GetVehicleModel(veh) != 0)
	        {
		        new v = Info_Veiculo[veh];
		        if(v != -1)
		        {
				if(corv == 0) Veiculo[v][v_Cor1] = cor, ms(playerid, 1, "Cor Primaria do veiculo alterada com sucesso !");
				if(corv == 1) Veiculo[v][v_Cor2] = cor, ms(playerid, 1, "Cor Secundaria do veiculo alterada com sucesso !");
				ChangeVehicleColorEx(veh, Veiculo[v][v_Cor1], Veiculo[v][v_Cor2]);
					SalvarVeiculo(veh);
					SetarCorVeiculo(playerid, veh, v);
				}
			}
		}
	}
}

stock SetarCorVeiculo(playerid, i, v)
{
    new sss[1000];
	SetPVarInt(playerid, "veh", i);
	format(sss, 1000, "{%06x}Cor Primaria\n{%06x}Cor Secundaria\n", Colors[Veiculo[v][v_Cor1]] >>> 8, Colors[Veiculo[v][v_Cor2]] >>> 8 );
	ShowPlayerDialog(playerid, DIALOG_CORES_VEICULO, DIALOG_STYLE_LIST, "Cores do Veiculo", sss, "Escolher", "Fechar");
}

stock consulta_placa(playerid)
{
	if(Online(playerid))
	{
	    Input(playerid, DIALOG_PLACA, "Consultar Placa", "\n{00ffff}[INFO] {ffffff}Digite corretamente a placa do veiculo:\n{a1a1a1}Exemplo: NCT-1234\n");
	}
}

stock mostrar_multas_veiculo(playerid, a)
{
	if(Veiculo[a][v_Existe] == 1)
	{
    	new cont;
    	SetPVarInt(playerid, "info", a);
    	SG[0] = EOS;
    	new linha[500];
		zerar_lista(playerid);
		strcat(SG, "Data\tMotivo\tAplicou\tValor\n");
        for(new i; i<MAX_MULTAS; i++)
		{
		    if(Veiculo_Multa[a][i][mu_Existe] == 1)
		    {
	            format(linha, 500, "{a1a1a1}%s\t{ffffff}%s\t{ffff00}%s\t{4169E1}R$ %s\n", Veiculo_Multa[a][i][mu_Data], Veiculo_Multa[a][i][mu_Motivo], NomeConta(Veiculo_Multa[a][i][mu_Conta], Veiculo_Multa[a][i][mu_Radar]), ConvertMoney(Veiculo_Multa[a][i][mu_Valor]));
	            strcat(SG, linha);
	            Lista[playerid][cont] = i;
	            cont ++;
		    }
        }

        format(linha, 150, "{ffffff}Multas do Veiculo {00ffff}%s {ffff00}[ {a1a1a1}%d {ffff00}]", PlacaVeiculo[a], cont);
		ShowPlayerDialog(playerid, DIALOG_MULTAS_VEICULO, DIALOG_STYLE_TABLIST_HEADERS, linha, SG, "Pagar", "Voltar");
	}
}

stock EmTerritorio(playerid, a)
{
    if(Online(playerid))
	{
	    if(id[playerid] != -1)
	    {
	        if(TR[a][tr_Existe] == 1)
            {
                if(GZ_PlayerInGz(playerid, TR[a][tr_GZ]))
                {
                    return 1;
                }
            }
	    }
	}
    return 0;
}

stock PegarTerritorio(playerid)
{
    if(Online(playerid))
	{
	    if(id[playerid] != -1)
	    {
	        for(new a; a<MAX_TERRITORIOS; a++)
	        {
	            if(TR[a][tr_Existe] == 1)
	            {
	                if(TR[a][tr_Tipo] != 0)
	                {
	                    if(GZ_PlayerInGz(playerid, TR[a][tr_GZ]))
	                    {
	                        return a;
	                    }
	                }
	            }
	        }
	    }
	}
	return -1;
}

stock AreaNeutra(playerid)
{
	if(Online(playerid))
	{
	    if(id[playerid] != -1)
	    {
	        for(new a; a<MAX_TERRITORIOS; a++)
	        {
	            if(TR[a][tr_Existe] == 1)
	            {
	                if(TR[a][tr_Tipo] == 0)
	                {
	                    if(GZ_PlayerInGz(playerid, TR[a][tr_GZ]))
	                    {
	                        return 1;
	                    }
	                }
	            }
	        }
	    }
	}
	return 0;
}


