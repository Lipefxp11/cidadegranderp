stock mostrar_info_veiculos(playerid)
{
    SG[0] = EOS;
	new sss1[400];
	new limite;
	new pags = paginas(30, 212);
    strcat(SG, "Modelo   Nome\tVelocidade\tCombustivel\tLitros        Porta Malas\n");
	for(new i = pagina_dialog3[playerid]*30; i<212; i++)
	{
	    limite ++;
		format(sss1, 400, "{a1a1a1}%03d      {00ffff}%s\t{ffffff}%d\t{ffff00}%s\t{ffffff}%d                        %d\n", i+400, NomeVeiculo(i+400), info_veiculos[i][veh_Velocidade], Combustivel(info_veiculos[i][veh_Combustivel]), info_veiculos[i][veh_Capacidade], info_veiculos[i][veh_PortaMalas]);
        strcat(SG, sss1);
        if(limite == 30)
		{
		    strcat(SG, "{4169E1}>>>> AVANCAR >>>>\t{000000}_\n");
		    strcat(SG, "{ffff00}<<<<  VOLTAR <<<<\t{000000}_\n");
            break;
		}
	}
	if(limite < 30)
	{
	    strcat(SG, "{4169E1}>>>> AVANCAR >>>>\t{000000}_\n");
	    strcat(SG, "{ffff00}<<<<  VOLTAR <<<<\t{000000}_\n");
	}
    format(sss1, 400, "{ffffff}Lista de Veiculos  {a1a1a1}Pagina {00ffff}%d{a1a1a1}/{ffff00}%d",  pagina_dialog3[playerid]+1, pags);
    ShowPlayerDialog(playerid, DIALOG_INFO_VEICULOS, DIALOG_STYLE_TABLIST_HEADERS, sss1, SG, "Editar", "Fechar");
}

