stock paginas(linhas, size)
{
	if( size < linhas ) return 1;
    new cont = size;
	new pags;
    new sobra;
    new div;
    pags = cont/linhas;
    div = pags*linhas;
    sobra = cont - (div);
    if(sobra > 0) pags ++;
	return pags;
}


stock IsNumeric2(const string[])
{
	for(new i = 0, j = strlen(string); i < j; i++)
	{
		if (string[i] > '9' && string[i] != '-' || string[i] < '0' && string[i] != '-' ) return 0;
		if(strlen(string) == 0) return 0;
	}
	return 1;
}

stock IsNumeric(const string[])
{
	for (new i = 0, j = strlen(string); i < j; i++)
	{
		if (string[i] > '9' || string[i] < '0') return 0;
		if(strlen(string) == 0) return 0;
	}
	return 1;
}


stock criar_item(idd, Float:pos1, Float:pos2, Float:pos3, Unids, mund, inter, tipo=-555, delet=-1, ativo=0, tempo=0)
{
	if(idd <= 0) return -1;
    for(new a; a<MAX_ITENS; a++)
	{
	    if(Item[a][item_Existe] == 0)
	    {
	        Iter_Add(Iter_Itens, a);
	        pos3 -= 0.9;
	        Item[a][item_Existe] = 1;
	        Item[a][item_Deletar] = delet;
	        Item[a][item_Ativo] = ativo;
	        Item[a][item_Tempo] = tempo;
		    Item[a][item_ID] = idd;
		    Item[a][item_X] = pos1;
		    Item[a][item_Y] = pos2;
		    Item[a][item_Z] = pos3;
		    Item[a][item_Unidades] = Unids;
		    if(tipo == -555) Item[a][item_Tipo] = Itens[idd][item_Tipo];
		    else Item[a][item_Tipo] = tipo;
		 	Item[a][item_Mundo] = mund;
			Item[a][item_Interior] = inter;
	        if(IsValidDynamicObject(Item[a][item_Obj])) DestroyDynamicObject_(Item[a][item_Obj]);
	        if(idd == 55) Item[a][item_Obj] = CreateDynamicObject(Acessorios_Info[tipo][acessorio_Modelo], pos1, pos2, pos3+Itens[idd][item_DropDZ], Itens[idd][item_DropX], Itens[idd][item_DropY], random(360), mund, inter);
			else Item[a][item_Obj] = CreateDynamicObject(Itens[idd][item_Modelo], pos1, pos2, pos3+Itens[idd][item_DropDZ], Itens[idd][item_DropX], Itens[idd][item_DropY], random(360), mund, inter);
			//SetDynamicObjectMaterial(Item[a][item_Obj], 0, Itens[id][item_Modelo], "none", "none", Itens[id][item_Cor2]);
			Item[a][item_3D] = CreateDynamic3DTextLabel(f("%s\n%s Unidade%s", NomeItem(idd, tipo), ConvertMoney(Unids), Unids<=1?"":"(s)"), 0xffffff99, pos1, pos2, pos3+Itens[idd][item_DropDZ], 3, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0,  mund, inter, -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
	        return a;
        }
	}
	return -1;
}

