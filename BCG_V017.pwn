	// dialog texto pickup //
	if(dialogid == DIALOG_TEXTO_PICKUP2)
	{
		if(response)
		{
		    new linha = GetPVarInt(playerid, "linha");
		    new i = GetPVarInt(playerid, "id_texto");
		    if(strlen(inputtext) < 3)
		    {
		        ms(playerid, 0, "Use um texto com no minimo 3 caracters !");
		        ShowPlayerDialog(playerid, DIALOG_TEXTO_PICKUP2, DIALOG_STYLE_INPUT, "Aterar Texto", "\n{4169E1}[INFO] {ffffff}Digite a baixo o novo Texto:\n\n", "Confirmar", "Cancelar");
		        return 1;
		    }

		    if(linha == 0) format(Pickup[i][pick_Texto1], 150, inputtext);
		    if(linha == 1) format(Pickup[i][pick_Texto2], 150, inputtext);
		    if(linha == 2) format(Pickup[i][pick_Texto3], 150, inputtext);
		    if(linha == 3) format(Pickup[i][pick_Texto4], 150, inputtext);
		    if(linha == 4) format(Pickup[i][pick_Texto5], 150, inputtext);

		    atualizar_pickup(i);
		    salvar_pickup(i);
		    ms(playerid, 4, "Voce alterou o texto desse Pickup !");
		}
		return 1;
	}

