stock VR_MostrarConv(playerid)
{
    new b = VR_Etapa[playerid];
    if(b >= sizeof VR_Conv) { VR_Limpar(playerid); return; }
    new str[800];
    format(str, 800, "{FFFF00}%s{FFFFFF}\n\n{00FF00}1.{FFFFFF} %s\n{00FF00}2.{FFFFFF} %s\n{00FF00}3.{FFFFFF} %s\n{00FF00}4.{FFFFFF} %s\n{00FF00}5.{FFFFFF} %s", VR_Conv[b][cv_NpcMsg], VR_Conv[b][cv_Resp1], VR_Conv[b][cv_Resp2], VR_Conv[b][cv_Resp3], VR_Conv[b][cv_Resp4], VR_Conv[b][cv_Resp5]);
    ShowPlayerDialog(playerid, 15001, DIALOG_STYLE_INPUT, "{FFFF00}Vendedor de Roupas - Negociacao", str, "Escolher", "Sair");
}

stock VR_MostrarRespostas(playerid) { VR_MostrarConv(playerid); }

stock VR_EsconderConv(playerid) { TogglePlayerControllable(playerid, 1); }

stock VR_Iniciar(playerid)
{
    new dep[80]; format(dep, 80, "Contas/%d.txt", id[playerid]);
    if(!DOF2_FileExists(dep)) DOF2_CreateFile(dep);
    DOF2_SetInt(dep, "VR_Vendas", VR_Vendas[playerid]);
    DOF2_SetInt(dep, "VR_Ganhos", VR_Ganhos[playerid]);
    DOF2_SaveFile();
}

stock VR_Carregar(playerid)
{
    new dep[80]; format(dep, 80, "Contas/%d.txt", id[playerid]);
    if(DOF2_FileExists(dep)) { VR_Vendas[playerid] = DOF2_GetInt(dep, "VR_Vendas"); VR_Ganhos[playerid] = DOF2_GetInt(dep, "VR_Ganhos"); }
}

stock bool:VR_VerificarEmprego(playerid) { new e = EmpregoPlayer(playerid); if(e == VR_EMPREGO_ID) return true; return false; }

stock VR_ProximaCasa(playerid)
{
    new total, list[MAX_CASAS_VR];
    for(new i; i<MAX_CASAS_VR; i++) { if(gettime() >= VR_Cooldown[playerid][i]) { list[total] = i; total++; } }
    if(total == 0) { ms(playerid, 0, "Todas as casas em cooldown! Aguarde."); return; }
    new esc = list[random(total)];
    VR_CasaAtual[playerid] = esc;
    VR_Checkpoint[playerid] = 1;
    SetPlayerCheckpoint(playerid, VR_Casas[esc][0], VR_Casas[esc][1], VR_Casas[esc][2], 3.0);
    ms(playerid, 0, "Casa marcada! Chegando la use /baternaporta");
}

stock VR_ChegouCheckpoint(playerid)
{
    if(VR_Checkpoint[playerid] != 1) return 0;
    VR_Checkpoint[playerid] = 0;
    DisablePlayerCheckpoint(playerid);
    ms(playerid, 1, "Chegou na casa! Use /baternaporta para chamar o morador.");
    return 1;
}

stock VR_ProcessarResposta(playerid, escolha)
{
    new b = VR_Etapa[playerid];
    if(b >= sizeof VR_Conv) { VR_Limpar(playerid); return; }
    new prob = (escolha == 0) ? VR_Conv[b][cv_P1] : (escolha == 1) ? VR_Conv[b][cv_P2] : (escolha == 2) ? VR_Conv[b][cv_P3] : (escolha == 3) ? VR_Conv[b][cv_P4] : VR_Conv[b][cv_P5];
    new _vr_msg[128];
    if(escolha == 0) format(_vr_msg, 128, VR_Conv[b][cv_R1]);
    else if(escolha == 1) format(_vr_msg, 128, VR_Conv[b][cv_R2]);
    else if(escolha == 2) format(_vr_msg, 128, VR_Conv[b][cv_R3]);
    else if(escolha == 3) format(_vr_msg, 128, VR_Conv[b][cv_R4]);
    else format(_vr_msg, 128, VR_Conv[b][cv_R5]);
    if(random(100) < prob)
    {
        ms(playerid, 0xFFFFFFFF, _vr_msg);
        if(random(100) < 15 + VR_Etapa[playerid] * 5)
        {
            VR_Vendas[playerid]++; VR_Estoque[playerid]--;
            new bonus = random(100) < 50 ? PRECO_GORJETA_VR : 0;
            DarGrana(playerid, PRECO_VENDA_VR + bonus);
            VR_Ganhos[playerid] += PRECO_VENDA_VR + bonus;
            ms(playerid, 0, f("VENDA! +$%d", PRECO_VENDA_VR + bonus));
            VR_Cooldown[playerid][VR_CasaAtual[playerid]] = gettime() + 3600;
            VR_Limpar(playerid);
            if(VR_Estoque[playerid] <= 0) { ms(playerid, 0, "Estoque vazio! Va ao deposito."); VR_EmServico[playerid] = 0; }
            else VR_ProximaCasa(playerid);
        }
        else
        {
            VR_Etapa[playerid] = random(sizeof VR_Conv);
            VR_MostrarConv(playerid);
        }
    }
    else
    {
        ms(playerid, 0, "Cliente nao interessado...");
        VR_Cooldown[playerid][VR_CasaAtual[playerid]] = gettime() + 3600;
        VR_Limpar(playerid);
        if(VR_Estoque[playerid] > 0) VR_ProximaCasa(playerid);
        else { ms(playerid, 0, "Estoque vazio! Va ao deposito."); VR_EmServico[playerid] = 0; }
    }
}

stock VR_Limpar(playerid)
{
    VR_EsconderConv(playerid);
    VR_NpcAtivo[playerid] = 0;
    VR_Etapa[playerid] = 0;
    VR_Resposta[playerid] = -1;
    if(IsValidActor(VR_Actor[playerid])) DestroyActor(VR_Actor[playerid]);
    VR_Actor[playerid] = INVALID_ACTOR_ID;
    if(IsValidDynamic3DTextLabel(VR_Label[playerid])) DestroyDynamic3DTextLabel(VR_Label[playerid]);
    VR_Label[playerid] = Text3D:INVALID_3DTEXT_ID;
}

