	{
	    new sss[300];
	    new i = GetPVarInt(playerid, "conce");
	    new a = GetPVarInt(playerid, "carro");
	    if(response)
	    {
	        if(Conce[i][con_Existe] == 1)
	        {
	            // criar ou destruir //
				if(listitem == 0)
				{
					if(Conce[i][con_v_Existe][a] == 1)
					{
					    Conce[i][con_v_Existe][a] = 0;
					    atualizar_veiculo_conce(i, a);
					}
					else
					{
					    format(sss, 300, "Voce criou o veiculo [%d] da concessionaria: %d", a, i);
					    Conce[i][con_v_Existe][a] = 1;
					    Conce[i][con_v_Modelo][a] = 400;
					    Conce[i][con_v_Valor][a] = 1000;
					    GetPlayerPos(playerid, Conce[i][con_v_X][a], Conce[i][con_v_Y][a], Conce[i][con_v_Z][a]);
					    GetPlayerFacingAngle(playerid, Conce[i][con_v_A][a]);
					    atualizar_veiculo_conce(i, a);
					    abrir_veiculo_conce(playerid, i, a);
					    ms(playerid, 1, sss);
					}
					salvar_concessionaria(i);
				}

				// posicao //
				if(listitem == 1)
				{
                    if(Conce[i][con_v_Existe][a] == 1)
					{
					    format(sss, 300, "Voce salvou a posicao do veiculo [%d] da concessionaria: %d", a, i);
					    GetPlayerPos(playerid, Conce[i][con_v_X][a], Conce[i][con_v_Y][a], Conce[i][con_v_Z][a]);
					    GetPlayerFacingAngle(playerid, Conce[i][con_v_A][a]);
					    atualizar_veiculo_conce(i, a);
					    PutPlayerInVehicle(playerid, Conce[i][con_v_Veiculo][a], 0);
					    ms(playerid, 1, sss);
					    abrir_veiculo_conce(playerid, i, a);
					}
					else
					{
					    abrir_veiculo_conce(playerid, i, a);
					    ms(playerid, 0, "Este veiculo nao foi criado ainda !");
					}
					salvar_concessionaria(i);
				}

				// modelo //
				if(listitem == 2)
				{
				    if(Conce[i][con_v_Existe][a] == 1)
					{
						modelo_veiculo_conce(playerid, i, a);
					}
					else
					{
					    abrir_veiculo_conce(playerid, i, a);
					    ms(playerid, 0, "Este veiculo nao foi criado ainda !");
					}
				}

				// valor //
				if(listitem == 3)
				{
				    if(Conce[i][con_v_Existe][a] == 1)
					{
                    	valor_veiculo_conce(playerid, i, a);
                    }
                    else
                    {
                        abrir_veiculo_conce(playerid, i, a);
					    ms(playerid, 0, "Este veiculo nao foi criado ainda !");
                    }
