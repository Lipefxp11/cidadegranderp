	return 1;
}

stock recolherinv(playerid, idd)
{
	new c = id[playerid];
	if(c != -1)
	{
		if(idd > -1 && idd < MAX_ITENS)
		{
		    if(Item[idd][item_Existe] == 1)
			{
				if(Item[idd][item_ID] != 0)
				{

					new Float:pos[3];
					pos[0] = Item[idd][item_X];
					pos[1] = Item[idd][item_Y];
					pos[2] = Item[idd][item_Z];
					SetPlayerToFacePos(playerid, pos[0], pos[1]);

		            // algo de segurar
		            new segu = 0;
		            for(new a; a<sizeof itens_segurando; a++ )
		            {
		                if(Item[idd][item_ID] == itens_segurando[a][seg_ID])
		                {
		                    if(Itens[Item[idd][item_ID]][item_Modelo] == itens_segurando[a][seg_Modelo])
		                    {
		                        segu = 1;
		                        if(segurando_player[playerid] != -1) ms(playerid, 0, "Voce ja esta com algo nas maos, largue primeiro para fazer isso !");
							    else
								{
									segurar(playerid, a, Item[idd][item_Unidades], Item[idd][item_Tipo], Item[idd][item_Ativo], Item[idd][item_Tempo]);
									destruiritem(idd);
		                        }
		                        ClearAnimations(playerid);
		                    }
		                }
		            }

					if(segu == 0)
					{
					    new slo = inv_vazio(playerid);
					    if(slo != -1)
						{
						    if(Item[idd][item_ID] == 49 && Item[idd][item_Tipo] == -1)
					     	{
	                            // dinheiro de roubo //
		                        if(Novato(playerid))
								{
									ClearAnimations(playerid);
									MS(playerid, 0, "Voce nao pode recolher este item, pois voce ainda e novato !");
								}
								else
								{
				                if(!alguem_pegando(idd))
				                {
										pegando_grana[playerid] = idd;
					                Acao(playerid, 12, 100, "PEGANDO DINHEIRO", 1, "BOMBER", "BOM_PLANT_LOOP", true);
				                }
				                else ClearAnimations(playerid);
		                        }
						    }
						    else
							{
							new enovato;
							if(Novato(playerid))
							{
							    if(Item[idd][item_ID] >= 1 && Item[idd][item_ID] <= 48) enovato = 1;
							    if(Item[idd][item_ID] == 75 || Item[idd][item_ID] == 76) enovato = 1;
							}
								if(enovato == 1)
								{
									ClearAnimations(playerid);
									MS(playerid, 0, "Voce nao pode recolher este item, pois voce ainda e novato !");
								}
								else
								{
									add_inv(c, Item[idd][item_ID], Item[idd][item_Unidades], Item[idd][item_Tipo], Item[idd][item_Ativo], Item[idd][item_Tempo]);
	                                destruiritem(idd);
								}
						    }
					    }
					    else ms(playerid, 0, "Seu Inventario esta Cheio !");
					}
				}
			}
		}
	}
}


BCG:: destruiritem(idd)
{
	if(Item[idd][item_Existe] == 1)
	{
		if(IsValidDynamicObject(Item[idd][item_Obj])) DestroyDynamicObject_(Item[idd][item_Obj]);
		if(IsValidDynamic3DTextLabel(Item[idd][item_3D])) DestroyDynamic3DTextLabel(Item[idd][item_3D]);
		Item[idd][item_3D] = DynamicText3D:-1;
		Item[idd][item_Existe] = 0;
		Item[idd][item_ID] = 0;
		Item[idd][item_Unidades] = 0;
		Item[idd][item_Tipo] = 0;
		Item[idd][item_X] = 0;
		Item[idd][item_Y] = 0;
		Item[idd][item_Z] = 0;
		Item[idd][item_Mundo] = 0;
		Item[idd][item_Interior] = 0;
		Iter_Remove(Iter_Itens, idd);
	}
}

stock DestruirVeiculo(i, con=0)
{
	if(GetVehicleModel(i) != 0)
	{
		new idv = Info_Veiculo[i];
		if(idv != -1)
		{
			DestruirInfo(idv);
			Info_Veiculo[i] = -1;
			carro_de_teste[i] = -1;
		    veiculo_acessorios(i);
			DestroyVehicle_(i);
			return 1;
		}
		if(con == 1)
		{
		    DestroyVehicle_(i);
		    veiculo_acessorios(i);
		    carro_de_teste[i] = -1;
		}
	}
	return 0;
}

stock DestruirInfo(idv)
{
	if(idv != -1)
	{
	    new file[80];
	    format(file, 80, "Veiculos/Veiculo_%d.txt", idv);
		if(DOF2_FileExists(file)) DOF2_RemoveFile(file);

		Iter_Remove(Iter_Veiculos, idv);
	    Veiculo[idv][v_Existe] = 0;
		Veiculo[idv][v_ID] = -1;
		Veiculo[idv][v_Dono] = -1;
		Veiculo[idv][v_Modelo] = 0;
		Veiculo[idv][v_Gasolina] = 0;
		Veiculo[idv][v_Bateria] = 0;
		Veiculo[idv][v_Lataria] = 0;
		Veiculo[idv][v_Trancado] = 0;
		Veiculo[idv][v_Cor1] = 0;
		Veiculo[idv][v_Cor2] = 0;
		Veiculo[idv][v_Org] = -1;
		Veiculo[idv][v_Cargo] = 0;
		Veiculo[idv][v_Compra] = 0;
