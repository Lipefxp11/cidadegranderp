stock MS(playerid, tipo, const mensa[], atu=0)
{
	new straki[300];
	format(straki, 300, "%s_", mensa);
	for(new a; a<9; a++) PlayerTextDrawDestroy(playerid, T_MS_p[playerid][a]);
	new maisx = 70;
	new maisy = 180;
	if(inv_novo_aberto[playerid] != 0) maisx = 430, maisy = -20;
	if(logado[playerid] == 0 || mostrando_vip[playerid] == 1) maisx = 330, maisy = 35;

    T_MS_p[playerid][0] = CreatePlayerTextDraw(playerid, 28.096633+maisx+10, 112.999931+maisy, "box");
	PlayerTextDrawLetterSize(playerid, T_MS_p[playerid][0], 0.000000, 3.674963);
	PlayerTextDrawTextSize(playerid, T_MS_p[playerid][0], 202.000000+maisx, 0.000000);
	PlayerTextDrawAlignment(playerid, T_MS_p[playerid][0], 1);
	PlayerTextDrawColor(playerid, T_MS_p[playerid][0], -1);
	PlayerTextDrawUseBox(playerid, T_MS_p[playerid][0], true);
	PlayerTextDrawBoxColor(playerid, T_MS_p[playerid][0], 252645255);
	PlayerTextDrawSetShadow(playerid, T_MS_p[playerid][0], 0);
	PlayerTextDrawFont(playerid, T_MS_p[playerid][0], 1);
	PlayerTextDrawSetProportional(playerid, T_MS_p[playerid][0], true);

	T_MS_p[playerid][1] = CreatePlayerTextDraw(playerid, 29.802368+maisx+10, 114.166664+maisy, "LD_CHAT:thumbup");
	PlayerTextDrawTextSize(playerid, T_MS_p[playerid][1], 30.000000, 30.000000);
	PlayerTextDrawAlignment(playerid, T_MS_p[playerid][1], 1);
	PlayerTextDrawColor(playerid, T_MS_p[playerid][1], -1560281117);
	PlayerTextDrawSetShadow(playerid, T_MS_p[playerid][1], 0);
	PlayerTextDrawBackgroundColor(playerid, T_MS_p[playerid][1], 255);
	PlayerTextDrawFont(playerid, T_MS_p[playerid][1], 4);
	PlayerTextDrawSetProportional(playerid, T_MS_p[playerid][1], false);

	T_MS_p[playerid][2] = CreatePlayerTextDraw(playerid, 24.691276+maisx+10, 110.783386+maisy, "LD_CHAT:dpad_lr");
	PlayerTextDrawTextSize(playerid, T_MS_p[playerid][2], 39.000000, 37.489917);
	PlayerTextDrawAlignment(playerid, T_MS_p[playerid][2], 1);
	PlayerTextDrawColor(playerid, T_MS_p[playerid][2], -20);
	PlayerTextDrawSetShadow(playerid, T_MS_p[playerid][2], 0);
	PlayerTextDrawBackgroundColor(playerid, T_MS_p[playerid][2], 255);
