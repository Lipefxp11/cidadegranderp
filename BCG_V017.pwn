    if(con == 3) ShowPlayerDialog(playerid, DIALOG_ESCREVER_GRUPO_VIP, DIALOG_STYLE_INPUT, "{000000}_", "\n{ff0000}Span ou Palavra muito grande indentificada !\nTente nao usar palavras muito grandes ou caracteres repetidos.\n{a1a1a1}Digite sua Menssagem                                                                    .", "Enviar", "Cancelar");
