	        format(sss1, 40, "ac_Local_%d", w);
	        Acessorios[playerid][w][ac_Local] = DOF2_GetInt(file, sss1);
	        format(sss1, 40, "ac_X_%d", w);
      		Acessorios[playerid][w][ac_X] = DOF2_GetFloat(file, sss1);
      		format(sss1, 40, "ac_Y_%d", w);
      		Acessorios[playerid][w][ac_Y] = DOF2_GetFloat(file, sss1);
      		format(sss1, 40, "ac_Z_%d", w);
      		Acessorios[playerid][w][ac_Z] = DOF2_GetFloat(file, sss1);
      		format(sss1, 40, "ac_RX_%d", w);
      		Acessorios[playerid][w][ac_RX] = DOF2_GetFloat(file, sss1);
      		format(sss1, 40, "ac_RY_%d", w);
      		Acessorios[playerid][w][ac_RY] = DOF2_GetFloat(file, sss1);
      		format(sss1, 40, "ac_RZ_%d", w);
      		Acessorios[playerid][w][ac_RZ] = DOF2_GetFloat(file, sss1);
      		format(sss1, 40, "ac_TX_%d", w);
