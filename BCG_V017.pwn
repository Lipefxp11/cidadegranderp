    if(!strcmp(cmd, "/lixo", true))
	{
        new Float:X, Float:Y, Float:Z;
        if(PlayerMafia(playerid) || PlayerFac(playerid))
        {
            if(UsouBrg[playerid] == 0)
            {
    	        UsouBrg[playerid] = 1;
    	        if (pRoadblock[playerid] != 0) return SSM(playerid, -1, "{FF0000}[SERVER]: Voce so pode criar 1 barreira por vez, /rlixo - para remover sua barreira");
    			new Float:A;
    			GetPlayerPos(playerid, X, Y, Z);
    			GetPlayerFacingAngle(playerid, A);
    			pRoadblock[playerid] = CreateDynamicObject(1358, X, Y, Z, 0.0, 0.0, A+180, 300.0);
    			SetPlayerPos(playerid, X, Y, Z+4);
    			GameTextForPlayer(playerid, "~w~Barreira ~P~Criada", 5000, 3);
    			SSM(playerid, -1, "{00FFFF}[LIXO]: Barreira Implantada... Use /rlixo Para Remove-la!");
    		}
    		else
    		{
    		    SSM(playerid, -1, "{FF0000}[SERVER]: Voce so pode usar Brg Uma Vez");
    		}
        }
        else
        {
            SSM(playerid, -1, "{FF0000}[SERVER]: Voce nao pode usar este comando.");
        }
        return 1;
    }
    if(!strcmp(cmd, "/rlixo", true))
	{
        if(PlayerMafia(playerid) || PlayerFac(playerid))
        {
            if(UsouBrg[playerid] == 1)
            {
    	        if (pRoadblock[playerid] != 0)
    			{
    				RemoveRoadblock(playerid);
    				SSM(playerid, -1, "{FF0000}[LIXO]: Voce retirou sua barreira de lixo.");
    			}
    			else
    			{
    				SSM(playerid, -1, "{FF0000}[SERVER]: Voce nao criou uma barreira!");
    			}
    			UsouBrg[playerid] = 0;
    		}
    		else
    		{
    		    SSM(playerid, -1, "{FF0000}[SERVER]: Voce nao criou Brg");
    		}
        }
        else
        {
            SSM(playerid, -1, "{FF0000}[SERVER]: Voce nao pode usar este comando.");
        }
        return 1;
    }
