	return name;
}

stock CriarPortao(Float:xx, Float:yy, Float:zz, Float:rxx, Float:ryy, Float:rzz, model, dono, tempo=0, inte=0, mundo=0)
{
	new p = -1;
	for(new i; i<MAX_PORTOES; i++)
	{
	    if(Portao[i][p_Existe] == 0)
	    {
	        Portao[i][p_Existe] = 1;
	        Portao[i][p_Modelo] = model;
	        Portao[i][p_Dono] = dono;
	        Portao[i][p_Tempo] = tempo;
	        Portao[i][p_Emprego] = -1;
	        Portao[i][p_Mundo] = mundo;
	        Portao[i][p_Interior] = inte;
	        Portao[i][p_Org] = -1;
			Portao[i][p_Cargo] = 0;
	        Portao[i][p_X1] = xx;
	        Portao[i][p_Y1] = yy;
	        Portao[i][p_Z1] = zz;
	        Portao[i][p_RX1] = rxx;
	        Portao[i][p_RY1] = ryy;
	        Portao[i][p_RZ1] = rzz;
	        Portao[i][p_X2] = xx;
	        Portao[i][p_Y2] = yy;
	        Portao[i][p_Z2] = zz-3;
	        Portao[i][p_RX2] = rxx;
	        Portao[i][p_RY2] = ryy;
	        Portao[i][p_RZ2] = rzz;
			atualizar_portao(i);
	        p = i;
	        break;
	    }
	}
	return p;
}

BCG:: carregar_portoes()
{
    new file[80];
    new cont;
    for(new i; i<MAX_PORTOES; i++)
