stock fechar_painel_orgs(playerid)
{
	for(new i; i<33; i++) TextDrawHideForPlayer(playerid, PainelOrgs[i]);
	PlayerTextDrawDestroy(playerid, PainelOrgsP[playerid][0]);
	CancelSelectTextDraw(playerid);
	PainelOrgsAberto[playerid] = false;
}


