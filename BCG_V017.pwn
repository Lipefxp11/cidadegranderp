{

	return 1;
}

public OnPlayerPickUpDynamicPickup(playerid, pickupid)
{
    if(logado[playerid] == 0) return 1;
	foreach(new i:Iter_Cadeias)
	{
	    if(Cadeia[i][ca_Existe] == 1)
	    {
	        if(pickupid == Cadeia[i][ca_Pickup])
	        {
	            if(IsPlayerInRangeOfPoint(playerid, 1.5, Cadeia[i][ca_X], Cadeia[i][ca_Y], Cadeia[i][ca_Z]))
	            {
	                if(GetPlayerInterior(playerid) == Cadeia[i][ca_Interior1])
	                {
	                    if(GetPlayerVirtualWorld_(playerid) == Cadeia[i][ca_Mundo1])
	                	{
	                	    if(!Arrastado(playerid))
	                	    {
								prender(playerid, i);
		                	    return 1;
	                	    }
	                	}
	                }
	            }
	        }
	    }
	}

	foreach(new i:Iter_Empresas)
	{
	    if(Empresa[i][em_Existe] == 1)
	    {
	        if(Empresa[i][em_Tipo] == 1)
	    	{
		        if(pickupid == Empresa[i][em_Pickup3])
		        {
	                if(GetPlayerInterior(playerid) == 0)
	                {
                        if(GetPlayerVirtualWorld_(playerid) == 0)
                		{
                            entrando_empresa[playerid] = i;
                		    return 1;
                		}
	                }
		        }
		        else if(pickupid == Empresa[i][em_Pickup2])
		        {
	                if(GetPlayerInterior(playerid) == 0)
	                {
                        if(GetPlayerVirtualWorld_(playerid) == 0)
                		{
                		    if(entrando_empresa[playerid] == i)
                		    {
                		        entrando_empresa[playerid] = -1;
                		        new sss[150];
                                if(Empresa[i][em_Dono] != id[playerid] && Empresa[i][em_Entrada] != 0 && Empresa[i][em_Dono] != -1)
							{
					            if(GranaPlayer(playerid) >= Empresa[i][em_Entrada])
					            {
					                format(sss, 150, "Voce pagou R$ %s pra entrar neste Local, Bem Vindo.", ConvertMoney(Empresa[i][em_Entrada]));
										MS(playerid, 1, sss);
										Empresa[i][em_Cofre] += Empresa[i][em_Entrada];
										add_cp(Empresa[i][em_Entrada]);
										salvar_empresa(i);
										DarGrana(playerid, -Empresa[i][em_Entrada]);
					            }
					            else
					            {
					                format(sss, 150, "Voce nao tem R$ %s pra entrar neste Local.", ConvertMoney(Empresa[i][em_Entrada]));
										MS(playerid, 0, sss);
										Congelar(playerid);
                                        KillTimer(timer_descon[playerid]);
										timer_descon[playerid] = SetTimerEx("Descongelar", 1500, false, "d", playerid);
										SetPlayerPos(playerid, Empresa[i][em_X1], Empresa[i][em_Y1], Empresa[i][em_Z1]);
									}
						    }
						    else MS(playerid, 1, "Entrada Gratuita, Bem Vindo.");
						    return 1;
					    }
                		}
		            }
		        }
	        }
	    }
	}

	return 1;
}

public OnPlayerGiveDamageDynamicActor(playerid, actorid, Float:amount, weaponid, bodypart)
{
    if(logado[playerid] == 0) return 1;
	if(GetPVarInt(playerid, "flood_actor") <= gettime())
	{
		foreach(new i:Player)
		{
			if(Online(i))
			{
			    if(olhando_camera[i] != -1)
				{
				    if(actorid == actor_player[i])
					{
					    new c = id[i];
					    if(c != -1)
						{
						if(IsValidDynamicActor(actor_player[i])) DestroyDynamicActor(actor_player[i]);
						    if(IsValidDynamic3DTextLabel(actor_player_3D[i])) DestroyDynamic3DTextLabel(actor_player_3D[i]);
							actor_player_3D[i] = DynamicText3D:-1;
							actor_player[i] = -1;
						    atualizar_conta(c);
							olhando_camera[i] = -1;
							olhando_camera_id[i] = -1;
							TogglePlayerSpectating(i, false);
							PlayerSpawn(i);
							carregar_mapa(playerid);
						    ms(i, 5, "Voce foi atingido enquanto estava no sistema de cameras.");
						    combate_player(playerid, i, weaponid);
						    break;
					    }
					}
				}

				if(player_arena[i] == 1)
				{
					if(actorid == actor_player[i])
					{
					    new c = id[i];
					    if(c != -1)
						{
						    if(IsValidDynamicActor(actor_player[i])) DestroyDynamicActor(actor_player[i]);
						    if(IsValidDynamic3DTextLabel(actor_player_3D[i])) DestroyDynamic3DTextLabel(actor_player_3D[i]);
							actor_player_3D[i] = DynamicText3D:-1;
							actor_player[i] = -1;
						    atualizar_conta(c);
						    player_arena[i] = 0;
						    PlayerSpawn(i);
						    ms(i, 5, "Voce foi atingido enquanto jogava em seu celular ! O jogo foi fechado.");
						    combate_player(playerid, i, weaponid);
						    break;
					    }
					}
				}
			}
		}
		SetPVarInt(playerid, "flood_actor", gettime()+1);
	}
	return 1;
}

public OnPlayerGiveDamage(playerid, damagedid, Float:amount, weaponid, bodypart)
{
    if(logado[playerid] == 0) return 1;
	new dano = floatround(amount);
	if(Online(damagedid))
	{
		new conta = id[damagedid];
		new conta2 = id[playerid];
		if(conta2 != -1)
		{
		    SetarVida(damagedid, Conta[damagedid][c_Vida]);
			SetarColete(damagedid, Conta[damagedid][c_Colete]);
			if(Conta[damagedid][c_Morto] > 0 || Conta[damagedid][c_Cadeia] != -1 || imobilizado[damagedid]) return 1;
		}
		if(conta != -1)
		{
		    if(Conta[playerid][c_Morto] > 0 || Conta[playerid][c_Cadeia] != -1 || imobilizado[playerid]) return 1;
		}

		// incendio - molotov - moto serra //
		if(weaponid == 18 || weaponid == 37 || weaponid == 9 )
		{
			if(GetPVarInt(damagedid, "flood_arma_apelona") > gettime()) return 1;
			SetPVarInt(damagedid, "flood_arma_apelona", gettime()+1);
		}

	    if(Online(playerid))
		{
		    if(ModoAdmin[playerid] == 0)
		    {
		        if(ModoAdmin[damagedid] == 0)
		        {
                    if(bodypart == 9) // cabeca
            	    {
            			if(weaponid == 33 || weaponid == 34)
            			{
            				PlayerPlaySound(playerid, 17802,0.0,0.0,0.0);
            				PlayerPlaySound(damagedid, 17802,0.0,0.0,0.0);
                            SetarVida(damagedid, 5);
				        OnPlayerDeath2(damagedid, playerid, weaponid);
            				GameTextForPlayer(playerid, "~w~HeadShot", 3000, 4);
            				GameTextForPlayer(damagedid, "~b~HeadShot", 3000, 4);
            			}
                        else
                        {
                            PlayerPlaySound(playerid, 17802,0.0,0.0,0.0);
            				PlayerPlaySound(damagedid, 17802,0.0,0.0,0.0);
                            SetarVida(damagedid, 5);
				        OnPlayerDeath2(damagedid, playerid, weaponid);
                            GameTextForPlayer(playerid, "~r~+100 de dano", 3000, 1);
            				GameTextForPlayer(damagedid, "~b~HeadShot ~n~ ~w~-100 de dano", 3000, 4);
                        }
            		}
				if(AreaNeutra(playerid) || AreaNeutra(damagedid))
					{
					    if(weaponid == 23 && Taser(playerid))
	                    {
	                        format(string_prox, 300, "? '%s' imobilizou '%s' com um taser ?", Nome(playerid), Nome(damagedid));
							ProxDetector(30.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
	                        imobilizar(damagedid);
	                    	return 1;
	                    }
						else BloquearDano(playerid);
					    return 1;
					}

					if(Novato(playerid))
				{
				    BloquearDanoNovato(playerid, 0);
					    return 1;
				}

				if(Novato(damagedid))
				{
				    if(weaponid == 23 && Taser(playerid))
	                    {
	                        format(string_prox, 300, "** '%s' imobilizou '%s' com um taser **", Nome(playerid), Nome(damagedid));
							ProxDetector(30.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
	                        imobilizar(damagedid);
	                    	return 1;
	                    }
				    else BloquearDanoNovato(playerid, 1);
					    return 1;
				}

				if(weaponid == 23 && Taser(playerid))
                    {
                        if(!IsPlayerInAnyVehicle(damagedid))
                        {
                            if(!IsPlayerInAnyVehicle(playerid))
                            {
                                if(Conta[playerid][c_Taser][3] < gettime())
                                {
                                    new c = id[playerid];
                                    Conta[playerid][c_Taser][3] = gettime()+180;
                                    salvar_conta(c, 0, "c_Taser_3", sv_int(Conta[playerid][c_Taser][3]));
				                format(string_prox, 300, "** '%s' imobilizou '%s' com um taser **", Nome(playerid), Nome(damagedid));
									ProxDetector(30.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
				                imobilizar(damagedid);
				            	return 1;
		                    	}
		                    	else
		                    	{
		                    	    ms(playerid, 0, f("Seu taser nao esta carregado, aguarde mais %s.", ConvertTime(Conta[playerid][c_Taser][3]-gettime())));
		                    	    ClearAnimations(playerid);
		                    	}
	                    	}
	                    	else ms(playerid, 0, "Seu Taser nao funciona enquanto estiver em um veiculo, saia para usa-lo !");
                    	}
                    	else ms(playerid, 0, "O Taser nao funciona em pessoas dentro de veiculos !");
                    }

		            combate_player(playerid, damagedid, weaponid);
		            Dano(playerid, damagedid, dano, weaponid);
				}
		    }
		}
	}
	return 1;
}
