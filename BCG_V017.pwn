	if(!strcmp(cmd, "/tv", true))
	{
	    new idd;
	    new c = id[playerid];
	    if(c == -1) return 1;
	    if(sscanf(params, "u", idd))
		{
			if(tv_player[playerid] == -1) ms(playerid, 2, "Use: /tv [ ID/Nick ]");
			else
			{
			    ms(playerid, 5, "Voce saiu do modo TV.");
			    tv_player[playerid] = -1;
			    atualizar_conta(c);
		        TogglePlayerSpectating(playerid, false);
		        PlayerSpawn(playerid);
		        carregar_mapa(playerid);
		        TextDrawHideForPlayer(playerid, T_Telando[0]);
				PlayerTextDrawHide(playerid, T_Telando_p[playerid][0]);
				PlayerTextDrawHide(playerid, T_Telando_p[playerid][1]);
				PlayerTextDrawHide(playerid, T_Telando_p[playerid][2]);
			}
			return 1;
		}
	    if(!Online(idd)) return ms(playerid, 0, "Este jogador nao esta Online.");
	    if(idd == playerid) return ms(playerid, 0, "Voce nao pode telar a si mesmo !");
	    if(id[idd] == -1) return ms(playerid, 0, "Este jogador nao esta em uma Conta !");
	    if(AdminPlayer(idd) > AdminPlayer(playerid)) return ms(playerid, 0, "Voce nao pode dar /tv nesse admin !");
	    if(tv_player[idd] != -1) return ms(playerid, 0, "Este jogador esta de /tv em alguem !");
	    if(tunando[idd] != 0 ) return ms(playerid, 0, "Este jogador esta tunando um veiculo !");
	    if(Telar(playerid, idd)) ms(playerid, 1, "Para sair do modo TV use /tv novamente.");
		return 1;
	}

	if(!strcmp(cmd, "/clima", true))
	{
		climas_servidor(playerid);
		return 1;
	}

	if(!strcmp(cmd, "/travarhora", true))
	{
		new idd;
		if(sscanf(params, "d", idd))
		{
			ms(playerid, 0, "Use: /travarhora [ 0 - 23 ].");
			ms(playerid, 2, "Use -1 para desativar, e sincronizar com o servidor.");
		}
		else
		{
			if(idd >= 0 && idd < 24)
			{
			    new sss[200];
			    format(sss, 200, "Seu relogio foi travado em %02d:00 !", idd);
			    travar_hora[playerid] = idd;
			    SetPlayerTime(playerid, travar_hora[playerid], 0);
			    ms(playerid, 1, sss);
			}
			else if(idd == -1)
			{
	            travar_hora[playerid] = idd;
	            SetPlayerTime(playerid, hora_certa, munito_certo);
	            ms(playerid, 1, "Seu relogio foi incronizado com a Hora do Servidor !");
			}
			else
			{
				ms(playerid, 0, "Use: /travarhora [ 0 - 23 ].");
				ms(playerid, 2, "Use -1 para desativar, e sincronizar com o servidor.");
			}
	    }
		return 1;
	}


	if(!strcmp(cmd, "/ir", true))
	{
		new sss[300], idd;
		if(sscanf(params, "u", idd)) return ms(playerid, 0, "Use: /ir [ ID/Nick ]");
		if(!Online(idd)) return ms(playerid, 0, "Este jogador nao est? Online.");
		if(id[idd] == -1) return ms(playerid, 0, "Este jogador nao esta em uma Conta !");
	    if(tv_player[idd] != -1) return ms(playerid, 0, "Este jogador esta de /tv em alguem !");
	    if(tunando[idd] != 0 ) return ms(playerid, 0, "Este jogador esta tunando um veiculo !");
	    if(olhando_camera[idd] != -1) return ms(playerid, 0, "Este jogador esta no sistema de cameras !");
	    if(AdminPlayer(idd) > AdminPlayer(playerid)) return ms(playerid, 0, "Voce nao pode ir ate nesse admin !");
		format(string_prox, 300, "** O Admin '%s' Foi ate '%s' **", Nome(playerid), Nome(idd));
		ProxDetector(20.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
		LevarPlayer(playerid, idd);
		format(sss, 300, "O Admin %s Foi ate voce.",Nome(playerid));
		ms(idd, 5, sss);
		return 1;
	}

    if(!strcmp(cmd, "/atenderl", true))
	{
        if(EmLigacao[playerid] != -1)return ms(playerid, 0, "Voce ja esta em uma ligacao");
        if(RecLig[playerid] == -1)return ms(playerid, 0, "Voce nao tem ligacoes pendentes.");

        // conexao
        SetPVarInt(RecLig[playerid], "VOIP_Conectar", 1);
		SetPVarInt(RecLig[playerid], "VOIP_ConectarID", playerid+10);
        EmLigacao[RecLig[playerid]] = 1;

        SetTimerEx("CarregandoLig", 1000, false, "d", playerid);

        ms(RecLig[playerid], -1, "{4169E1}[INFO LIG]: {FFFFFF}A ligacao foi atendida, use: /desligarl para desligar!");
        ms(playerid, -1, "{4169E1}[INFO LIG]: {FFFFFF}A ligacao foi atendida, use: /desligarl para desligar!");
        ms(playerid, 1, "{4169E1}[LIG ATENDIDA]: {FFFFFF}Ligacao atendida.");
        return 1;
    }
    if(!strcmp(cmd, "/desligarl", true))
	{
        if(EmLigacao[playerid] != 1)return ms(playerid, 0, "Voce nao esta em uma ligacao");
        if(RecLig[playerid] == -1)return ms(playerid, 0, "Voce nao tem ligacoes pendentes.");
    	if(GetPVarInt(playerid, "VOIP_Desconectar") == 0){
    		SetPVarInt(playerid, "VOIP_Desconectar", 1);
    	}
    	if(GetPVarInt(RecLig[playerid], "VOIP_Desconectar") == 0){
    		SetPVarInt(RecLig[playerid], "VOIP_Desconectar", 1);
    	}
        // funcao de msg
        ms(RecLig[playerid], -1, "{4169E1}[INFO LIG]: {BEBEBE}A ligacao foi desligada!");
        ms(playerid, 1, "{4169E1}[LIG ATENDIDA]: {BEBEBE}Ligacao desligada.");
        // p1
        RecLig[RecLig[playerid]] = -1;
        EmLigacao[RecLig[playerid]] = -1;
        // p2
        RecLig[playerid] = -1;
        EmLigacao[playerid] = -1;
        return 1;
    }

	if(!strcmp(cmd, "/pegarp", true))
	{
		new string[1200], Float:X123, Float:Y123, Float:Z123;
		if(OrgPlayer(playerid) != -1)
		{
			if(ArrastadoID[playerid] != -1)return SSM(playerid, -1, "{FF0000}[SERVER]: Voce ja esta arrastando Alguem, Use (/soltarp)!");
			{
				for(new i = 0; i < MAX_PLAYERS; i++){
				 	GetPlayerPos(i, X123, Y123, Z123);
					if(IsPlayerInRangeOfPoint(playerid, 5.0, X123, Y123, Z123)){
                        if(i != playerid){
    						format(string, sizeof(string), "* O ID: [%d] esta carregando o ID:[%d].", playerid, i);
    						ProxDetector(20.0, playerid, string, -1,-1,-1,-1,-1);
    						SSM(playerid, -1, "{FF0000}[SERVER]: Voce esta carregando um jogador, use /soltarp para largar-lo.");
                            format(string, sizeof(string), "{00FFFF}[CARREGAR] Voce esta carregando o jogador %s[%d]", Nome(i), i);
                            SSM(playerid, -1, string);
    						GameTextForPlayer(i, "~r~Carregado!", 2000, 3);
    						ApplyAnimation(i, "DEALER", "DEALER_IDLE", 4.0, 0, 1, 1, 1, -1);
    						ApplyAnimation(i, "DEALER", "DEALER_IDLE", 4.0, 0, 1, 1, 1, -1);
    						ArrastadoID[playerid] = i;
    						AttArrastar[playerid] = SetTimerEx("AttArrastar2", 200, true, "i", playerid);
                            JogadorCongelado[i] = 1;
                            Controle(i, 0);
                            TimerFicarParado[i] = SetTimerEx("JogadorParado", 500, true, "d", i);
                            return 1;
                        }
					}
				}
			}
	    }
		else
		{
		    SSM(playerid, -1, "{FF0000}[SERVER]: Voce nao faz parte de uma organizacao!");
		}
		return 1;
	}
	if(!strcmp(cmd, "/soltarp", true))
	{
		new Float:X123, Float:Y123, Float:Z123, string[450];
		if(OrgPlayer(playerid) != -1){
            if(ArrastadoID[playerid] == -1)return SSM(playerid, 0xFFFF00FF, "{FF0000}[SERVER]: Voce nao esta segurando ninguem.");
			GetPlayerPos(ArrastadoID[playerid], X123, Y123, Z123);
			if(IsPlayerInRangeOfPoint(playerid, 5.0, X123, Y123, Z123)){
			   	format(string, sizeof(string), "* O ID: [%d] Largou o Jogador ID:[%d].", playerid, ArrastadoID[playerid]);
				ProxDetector(20.0, playerid, string, -1,-1,-1,-1,-1);
			    SSM(playerid, 0xFFFF00FF, "Voce Largou o Player!");
				GameTextForPlayer(ArrastadoID[playerid], "~w~Largado!", 2000, 0);
			    ClearAnimations(ArrastadoID[playerid]);
                SetTimerEx("DCANIM", 500, false, "i", ArrastadoID[playerid]);
				KillTimer(AttArrastar[playerid]);
                if(JogadorCongelado[ArrastadoID[playerid]] == 1){
                    Controle(ArrastadoID[playerid], 1);
                    JogadorCongelado[ArrastadoID[playerid]] = 0;
                    KillTimer(TimerFicarParado[ArrastadoID[playerid]]);
                }
                ArrastadoTT[ArrastadoID[playerid]] = -1;
				ArrastadoID[playerid] = -1;
			}
		}
		else
		{
		    SSM(playerid, -1, "{FF0000}[SERVER]: Voce nao faz parte de uma organizacao");
		}
		return 1;
	}

	if(!strcmp(cmd, "/trazer", true))
	{
		new sss[300], idd;
		if(sscanf(params, "u", idd)) return ms(playerid, 0, "Use: /trazer [ ID/Nick ]");
		if(!Online(idd)) return ms(playerid, 0, "Este jogador nao esta Online.");
	    if(id[idd] == -1) return ms(playerid, 0, "Este jogador nao esta em uma Conta !");
		if(tv_player[idd] != -1) return ms(playerid, 0, "Este jogador esta de /tv em alguem !");
		if(tunando[idd] != 0 ) return ms(playerid, 0, "Este jogador esta tunando um veiculo !");
		if(olhando_camera[idd] != -1) return ms(playerid, 0, "Este jogador esta no sistema de cameras !");
		if(AdminPlayer(idd) > AdminPlayer(playerid)) return ms(playerid, 0, "Voce nao podetrazer esse admin !");
		format(string_prox, 300, "** O Admin '%s' trouxe '%s' ate ele **",Nome(playerid), Nome(idd));
		ProxDetector(20.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
		LevarPlayer(idd, playerid);
		format(sss, 300, "O Admin %s lhe levou ate ele.",Nome(playerid));
		ms(idd, 0xF08080ff, sss);
		return 1;
	}

	if(!strcmp(cmd, "/setaradmin", true))
	{
	    new c = id[playerid];
		if(c != -1)
		{
			new level, idd, funcao[75];
			new sss[150];
			if(sscanf(params, "uds[75]", idd, level, funcao)) return ms(playerid, 2, "Use: /setaradmin [ ID da Conta ] [ level ] [ funcao ].");
			new meun = AdminConta(c);
		    new meun2 = AdminConta(idd);
			if(meun < meun2) return ms(playerid, 0, "Voce nao pode editar esta vaga admin !");
			new maxa = meun-1;
			if(level < 1 || level > maxa) return ms(playerid, 0, f("Use um level entre 1 e %d !", maxa));
			if(!AdminConta(idd)) return ms(playerid, 0, "Esta conta nao e um admin, use /daradmin para poder fazer isso !");
		    for(new i; i<MAX_ADMINS; i++)
			{
				if(Admin[i][adm_Existe] == 1)
				{
					if(Admin[i][adm_Conta] == idd)
					{
						Admin[i][adm_Level] = level;
						format(Admin[i][adm_Funcao], 40, funcao);
						Admin[i][adm_Responssavel] = id[playerid];
						new player = ContaOnline(idd);
						if(Online(player))
		        		{
							format(sss, 150, "O admin '%s' lhe setou o nivel %d de administrador, funcao: %s.", Nome(playerid), level, funcao);
							ms(player, 0xF08080ff, sss);
						}
						format(sss, 150, "Voce setou '%s' como nivel %d de administrador: %s.", NomeConta(idd), level, funcao);
						ms(playerid, 5, sss);
						salvar_admin(i);
						return 1;
					}
				}
			}
		}
		return 1;
	}

	if(!strcmp(cmd, "/removeradmin", true))
	{
	    new c = id[playerid];
		if(c != -1)
		{
		    new admin;
		    if(sscanf(params, "d", admin)) return ms(playerid, 2, "Use: /removeradmin [ ID da Conta ].");
			if(ContaInvalida(admin)) return ms(playerid, 0, "Esta conta nao existe !");
		    new meun = AdminConta(c);
		    new meun2 = AdminConta(admin);
			new str1[150];
			if(meun <= meun2) return ms(playerid, 0, "Voce nao pode limpar uma vaga admin superior a sua !");
			if(destruir_admin(admin))
			{
				format(str1, 150, "Voce removeu '%s' da lista de Administradores.", NomeConta(admin));
				ms(playerid, 5, str1);
				new player = ContaOnline(admin);
				if(Online(player))
				{
				    format(str1, 150, "O admin '%s' lhe removeu da lista de administradores.", Nome(playerid));
		        	ms(player, 0xF08080ff, str1);
				}
			}
			else
			{
		        ms(playerid, 0, "Administrador nao encontrado no Banco de Dados.");
			}
		}
		return 1;
	}

	if(!strcmp(cmd, "/daradmin", true))
	{
		new c = id[playerid];
		if(c != -1)
		{
		    new meun = AdminConta(c);
		    new maxa;
		    if(meun < 6) maxa = 1;
		    else maxa = meun;
			new level, idd, funcao[75];
			new sss[150];
			if(sscanf(params, "dds[75]", idd, level, funcao)) return ms(playerid, 2, "Use: /daradmin [ ID da Conta ] [ level ] [ funcao ].");
			if(ContaInvalida(idd)) return ms(playerid, 0, "Esta conta nao existe !");
			if(level < 1 || level > maxa) return ms(playerid, 0, f("Use um level entre 1 e %d !", maxa));
			if(AdminConta(idd) > 0) return ms(playerid, 0, "Esta conta ja e admin, use /setaradmin para alteral o level ou funcao !");
			if(criar_admin(idd, id[playerid], level, funcao))
		    {
		        new player = ContaOnline(idd);
				if(Online(player))
				{
		        	format(sss, 150, "O admin '%s' lhe deu nivel %d de administrador: %s.", Nome(playerid), level, funcao);
		        	ms(player, 0xF08080ff, sss);
		        }

		        format(sss, 150, "Voce deu admin level %d '%s' para a conta: [ %d '%s' ] .", level, funcao, idd, NomeConta(idd));
		        ms(playerid, 5, sss);
		    }
		    else ms(playerid, 0, "A lista de admins esta cheia.");
	    }
		return 1;
	}

	if(!strcmp(cmd, "/ajudatextos", true))
	{
		new sss[1000];
	    strcat(sss, "\n");
		strcat(sss, "\n");
		strcat(sss, "{ffffff}/idtexto {a1a1a1}para ver o id de um texto.\n");
		strcat(sss, "{ffffff}/copiartexto {a1a1a1}para duplicar um texto na sia posicao atual.\n");
		strcat(sss, "{ffffff}/criartexto {a1a1a1}para um texto.\n");
		strcat(sss, "{ffffff}/movertexto {a1a1a1}para mover um texto.\n");
		strcat(sss, "{ffffff}/setartexto {a1a1a1}para setar a string de um texto.\n");
		strcat(sss, "{ffffff}/tamanhotexto {a1a1a1}para setar o tamanho de um texto.\n");
		strcat(sss, "{ffffff}/alinhamentotexto	{a1a1a1}para setar o alinhamento de um texto.\n");
		strcat(sss, "{ffffff}/cortexto	{a1a1a1}para setar o alinhamento de um texto.\n");
		strcat(sss, "{ffffff}/destruirtexto	{a1a1a1}para setar o alinhamento de um texto.\n");
		strcat(sss, "\n");
		strcat(sss, "\n");
		ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Comandos para editar Textos", sss, "Ok", "Fechar");
		return 1;
	}

	if(!strcmp(cmd, "/idtexto", true))
	{
		new str1[150];
		new ta;
		for(new i; i<MAX_TEXTOS; i++)
		{
		    if(Texto[i][textoExiste] == 1)
		    {
			    if(IsPlayerInRangeOfPoint(playerid, 8, Texto[i][textoX],Texto[i][textoY],Texto[i][textoZ]))
				{
				format(str1, 150, "Esse ? o texto ID %d, '%s'.", i, Texto[i][textoTexto]);
				ms(playerid, 5, str1);
				ta ++;
				}
			}
		}
		if(ta == 0) ms(playerid, 0, "Voc? n?o esta proximo a um texto");
		return 1;
	}


	if(!strcmp(cmd, "/copiartexto", true))
	{
		new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /copiartexto [ ID ]");
		if( i < 0 || i >= MAX_TEXTOS) return ms(playerid, 0, "ID de texto Invalido");
	    if(Texto[i][textoExiste] == 0) return ms(playerid, 0, "Este texto n?o existe");

		new Float:p[4];
		new sss[250];
		GetPlayerPos(playerid, p[0], p[1], p[2]);
		GetPlayerFacingAngle(playerid, p[3]);
		PegarFrentePlayer(playerid, p[0], p[1], 2);
		for(new ii; ii<MAX_TEXTOS; ii++)
		{
			if(Texto[ii][textoExiste] == 0)
			{
		        Texto[ii][textoExiste] = 1;
		        format(Texto[ii][textoTexto], 200, Texto[i][textoTexto]);
		        Texto[ii][textoX] = p[0];
		        Texto[ii][textoY] = p[1];
		        Texto[ii][textoZ] = p[2];
		        Texto[ii][textoRX] = 0.0;
		        Texto[ii][textoRY] = 0.0;
		        Texto[ii][textoRZ] = p[3];
		        Texto[ii][textoCor] = Texto[i][textoCor];
		        Texto[ii][textoTamanho] = Texto[i][textoTamanho];
		        format(Texto[ii][textoFonte], 20, Texto[i][textoFonte]);
		        Texto[ii][textoAlinhamento] = Texto[i][textoAlinhamento];
		        Texto[ii][textoCor] = Texto[i][textoCor];
		        Texto[ii][textoMundo] = GetPlayerVirtualWorld_(playerid);
		        Texto[ii][textoInterior] = GetPlayerInterior(playerid);
		        atualizar_texto(ii);
		        Streamer_Update(playerid);
		        format(sss, 150, "Voc? criou o texto ID %d, para mais comandos use /ajudatextos", ii);
				ms(playerid, 5, sss);
				EditandoTexto[playerid] = ii;
				EditDynamicObject2(playerid, Texto[ii][textoObj]);
				salvar_texto(ii);
		        return 1;
			}
		}
		ms(playerid, 0, "Todos os Textos do servidor ja foram criados");
		return 1;
	}


