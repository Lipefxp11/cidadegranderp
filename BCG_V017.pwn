public HudNewTimer(playerid)
{
    if(!IsPlayerConnected(playerid)) return;
    PlayerTextDrawShow(playerid, HudInfoBox[playerid]);
    PlayerTextDrawShow(playerid, HudInfoIDF[playerid]);
    PlayerTextDrawShow(playerid, HudInfoNIVEL[playerid]);
    PlayerTextDrawShow(playerid, HudInfoXP[playerid]);
}
static assalto_stage[MAX_BOOTS];
public assalto_caixa_timer(actorid, playerid)
{
    if(Actor[actorid][a_RouboStatus] != 1) return;
    assalto_stage[actorid]++;
    new total = assalto_stage[actorid] * 200;
    new bonus = random(100);
    if(bonus < 30) total += 100;
    if(bonus < 10) total += 200;
    Actor[actorid][a_RouboMoney] += total;
    new Float:x = Actor[actorid][a_X], Float:y = Actor[actorid][a_Y], Float:z = Actor[actorid][a_Z];
    criar_item(49, x + 0.5, y + 0.5, z, total, Actor[actorid][a_Mundo], Actor[actorid][a_Interior], -1, 300);
    ApplyDynamicActorAnimation(Actor[actorid][a_Actor], "SHOP", "SHP_Serve_Loop", 4.1, 1, 0, 0, 0, 0);
    if(assalto_stage[actorid] < 5) SetTimerEx("assalto_caixa_timer", 3000, false, "dd", actorid, playerid);
    else
    {
        Actor[actorid][a_RouboStatus] = 2;
        assalto_stage[actorid] = 0;
        ApplyDynamicActorAnimation(Actor[actorid][a_Actor], "SHOP", "SHP_Rob_HandsUp", 4.1, 1, 0, 0, 0, 0);
        foreach(new pi:Player) if(Online(pi) && IsPlayerInRangeOfPoint(pi, 40.0, Actor[actorid][a_X], Actor[actorid][a_Y], Actor[actorid][a_Z])) StopAudioStreamForPlayer(pi);
        SetTimerEx("caixa_voltar_normal", 180000, false, "d", actorid);
        ms(playerid, 1, f("Assalto concluido! Voce roubou R$ %s. O dinheiro some em 5 minutos.", ConvertMoney(Actor[actorid][a_RouboMoney])));
    }
}
public verificar_assalto()
{
    foreach(new p:Player) if(Online(p))
    {
        if(GetPVarInt(p, "verificando_assalto") > gettime()) continue;
        SetPVarInt(p, "verificando_assalto", gettime() + 1);
        new dyn_actorid = GetPlayerTargetDynamicActor(p);
        if(dyn_actorid == INVALID_ACTOR_ID) continue;
        new actorid = -1;
        for(new a; a<MAX_BOOTS; a++) if(Actor[a][a_Existe] == 1 && Actor[a][a_Actor] == dyn_actorid) { actorid = a; break; }
        if(actorid == -1) continue;
        if(PlayerCop(p)) continue;
        if(Actor[actorid][a_Caixa] != 1 || Actor[actorid][a_RouboStatus] != 0 || Actor[actorid][a_RouboTimer] >= gettime()) continue;
        if(Conta[p][c_Nivel] < 3) { ms(p, 0, "Voce precisa de level 3 para roubar caixas !"); continue; }
        new cops_serv = 0;
        foreach(new a:Player) if(Online(a) && EmServico(a)) cops_serv++;
        if(cops_serv < 3) { ms(p, 0, "É necessario ter pelo menos 3 policiais em serviço."); continue; }
        if(GetPlayerWeapon(p) < 1) continue;
        Actor[actorid][a_RouboStatus] = 1;
        Actor[actorid][a_RouboPlayer] = p;
        Actor[actorid][a_RouboMoney] = 0;
        ApplyDynamicActorAnimation(Actor[actorid][a_Actor], "SHOP", "SHP_Serve_Loop", 4.1, 1, 0, 0, 0, 0);
        foreach(new pi:Player) if(Online(pi) && IsPlayerInRangeOfPoint(pi, 40.0, Actor[actorid][a_X], Actor[actorid][a_Y], Actor[actorid][a_Z]))
        {
            PlayAudioStreamForPlayer(pi, "http://som.brasilplaygames.com.br/som/AlarmeFusion.mp3");
            SetPVarInt(pi, "alarme_caixa", actorid);
        }
        foreach(new pi:Player) if(Online(pi))
        {
            new o = OrgPlayer(pi);
            if(o != -1 && OrgCop(o))
            {
                SetPVarInt(pi, "assalto_actor", actorid);
                ms(pi, 4, f("[POLICIA] Assalto ao caixa ID %d em andamento! Use /irassalto para ir ao local.", actorid));
            }
        }
        SetTimerEx("assalto_caixa_timer", 3000, false, "dd", actorid, p);
        break;
    }
}
public caixa_voltar_normal(actorid)
{
    Actor[actorid][a_RouboStatus] = 0;
    Actor[actorid][a_RouboTimer] = gettime() + 600;
    Actor[actorid][a_RouboPlayer] = -1;
    ClearDynamicActorAnimations(Actor[actorid][a_Actor]);
    if(Actor[actorid][a_Animacao] == 1)
        ApplyDynamicActorAnimation(Actor[actorid][a_Actor], Actor[actorid][a_Anim1], Actor[actorid][a_Anim2], 4.1, 1, 0, 0, 0, 0);
    foreach(new pi:Player) if(Online(pi))
    {
        new o = OrgPlayer(pi);
        if(o != -1 && OrgCop(o)) SetPVarInt(pi, "assalto_actor", -1);
    }
}
public sincronizar_cash_discord()
{
    new file[80];
    format(file, 80, "cash_sync.txt");
    if(!fexist(file)) return;
    new linha[128];
    new File:arq = fopen(file, io_read);
    while(fread(arq, linha, sizeof linha))
    {
        new sep = strfind(linha, "|");
        if(sep == -1) continue;
        new conta_str[16], valor_str[16];
        strmid(conta_str, linha, 0, sep);
        strmid(valor_str, linha, sep + 1, strlen(linha));
        new conta_id = strval(conta_str);
        new valor = strval(valor_str);
        foreach(new p:Player)
        {
            if(Online(p) && id[p] == conta_id)
            {
                if(Conta[p][c_Cash] != valor)
                {
                    Conta[p][c_Cash] = valor;
                    new cc = id[p];
                    if(cc != -1) salvar_conta(cc, 0, "c_Cash", sv_int(valor));
                    new str_cash[128];
                    format(str_cash, 128, "[DISCORD] Seu cash foi atualizado para R$ %s.", ConvertMoney(valor));
                    ms(p, 3, str_cash);
                }
                break;
            }
        }
    }
    fclose(arq);
    fremove(file);

    format(file, 80, "boost_sync.txt");
    if(fexist(file))
    {
        arq = fopen(file, io_read);
        while(fread(arq, linha, sizeof linha))
        {
            new conta_id = strval(linha);
            if(conta_id <= 0) continue;
            new encontrou;
            foreach(new p:Player)
            {
                if(Online(p) && id[p] == conta_id)
                {
                    DarGrana(p, 10000);
                    Conta[p][c_Cash] += 5;
                    new cc = id[p];
                    if(cc != -1) salvar_conta(cc, 0, "c_Cash", sv_int(Conta[p][c_Cash]));
                    ms(p, 3, "[BOOST] Voce recebeu R$10.000 e 5 Cash por impulsionar o servidor no Discord!");
                    encontrou = 1;
                    break;
                }
            }
            if(!encontrou)
            {
                new arq_conta[100];
                format(arq_conta, 100, "Contas/%d.txt", conta_id);
                if(DOF2_FileExists(arq_conta))
                {
                    new cash_atual = DOF2_GetInt(arq_conta, "c_Cash");
                    new grana_atual = DOF2_GetInt(arq_conta, "c_Grana");
                    DOF2_SetInt(arq_conta, "c_Cash", cash_atual + 5);
                    DOF2_SetInt(arq_conta, "c_Grana", grana_atual + 10000);
                    DOF2_SaveFile();
                    printf("[BOOST] Conta %d recebeu boost offline: R$10.000 + 5 Cash", conta_id);
                }
            }
        }
        fclose(arq);
        fremove(file);
    }
}

forward sincronizar_org_lider_discord();
public sincronizar_org_lider_discord()
{
    new file[80];
    format(file, 80, "org_exec_dof2.txt");
    if(!DOF2_FileExists(file)) return;
    new tipo[32], org_str[8], conta_str[8];
    format(tipo, 32, "%s", DOF2_GetString(file, "Tipo"));
    format(org_str, 8, "%s", DOF2_GetString(file, "Org"));
    format(conta_str, 8, "%s", DOF2_GetString(file, "Conta"));
    DOF2_RemoveFile(file);
    new org_id = strval(org_str);
    new conta_id = strval(conta_str);
    if(org_id < 0 || org_id >= MAX_ORGS || Org[org_id][o_Existe] == 0) return;
    if(ContaInvalida(conta_id)) return;
    if(!strcmp(tipo, "setar"))
    {
        new player = ContaOnline(conta_id);
        for(new a; a<30; a++) if(Org[org_id][o_Membros][a] == conta_id && Org[org_id][o_Cargos][a] >= 6) return;
        Org[org_id][o_Membros][0] = conta_id;
        Org[org_id][o_Cargos][0] = 6;
        salvar_org(org_id);
        if(Online(player))
        {
            Conta[player][c_Org] = org_id;
            Conta[player][c_Cargo] = 6;
            Conta[player][c_Local] = 1;
            Conta[player][c_LocalID] = org_id;
            salvar_conta(conta_id, 0, "c_Org", sv_int(org_id));
            salvar_conta(conta_id, 0, "c_Cargo", sv_int(6));
            salvar_conta(conta_id, 0, "c_Local", sv_int(1));
            salvar_conta(conta_id, 0, "c_LocalID", sv_int(org_id));
            SetarSpawn(player);
            PlayerSpawn(player);
            ms(player, 3, "[DISCORD] Voce foi setado como lider!");
        }
        else
        {
            salvar_conta(conta_id, 0, "c_Org", sv_int(org_id));
            salvar_conta(conta_id, 0, "c_Cargo", sv_int(6));
            salvar_conta(conta_id, 0, "c_Local", sv_int(1));
            salvar_conta(conta_id, 0, "c_LocalID", sv_int(org_id));
        }
    }
    else if(!strcmp(tipo, "destruir"))
    {
        new player = ContaOnline(conta_id);
        for(new a; a<30; a++) if(Org[org_id][o_Membros][a] != -1 && Org[org_id][o_Cargos][a] >= 6) { Org[org_id][o_Membros][a] = -1; Org[org_id][o_Cargos][a] = 0; }
        salvar_org(org_id);
        if(Online(player))
        {
            Conta[player][c_Org] = -1;
            Conta[player][c_Cargo] = 0;
            Conta[player][c_Local] = 0;
            Conta[player][c_LocalID] = -1;
            salvar_conta(conta_id, 0, "c_Org", sv_int(-1));
            salvar_conta(conta_id, 0, "c_Cargo", sv_int(0));
            salvar_conta(conta_id, 0, "c_Local", sv_int(0));
            salvar_conta(conta_id, 0, "c_LocalID", sv_int(-1));
            SetPlayerSkin(player, 26);
            Conta[player][c_Skin] = 26;
            salvar_conta(conta_id, 0, "c_Skin", sv_int(26));
            SetarSpawn(player);
            PlayerSpawn(player);
            ms(player, 3, "[DISCORD] Voce foi removido do cargo de lider!");
        }
        else
        {
            salvar_conta(conta_id, 0, "c_Org", sv_int(-1));
            salvar_conta(conta_id, 0, "c_Cargo", sv_int(0));
            salvar_conta(conta_id, 0, "c_Local", sv_int(0));
            salvar_conta(conta_id, 0, "c_LocalID", sv_int(-1));
        }
    }
}
