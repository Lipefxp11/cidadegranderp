		salvar_portao(i);
		return 1;
	}
	
	if(!strcmp(cmd, "/portaocargo", true))
	{
		if(Conta[playerid][c_Cargo] < 5) return ms(playerid, 0, "Apenas o Lider e Sub Liders podem alterar o carto do portao !");
		foreach(new i:Iter_Portoes)
        {
            if(Portao[i][p_Existe] == 1)
            {
                if(IsPlayerInRangeOfPoint(playerid, 7, Portao[i][p_X1], Portao[i][p_Y1], Portao[i][p_Z1]))
                {
                    if(GetPlayerInterior(playerid) == Portao[i][p_Interior])
                    {
                        if(GetPlayerVirtualWorld_(playerid) == Portao[i][p_Mundo])
                        {
                            if(Portao[i][p_Org] == OrgPlayer(playerid))
                            {
            					mostrar_cargos_portao(playerid, i);
            					return 1;
            				}
							else ms(playerid, 0, "Este portao nao e da sua Org !");
							return 1;
            			}
            		}
            	}
            }
        }
		ms(playerid, 0, "Voce nao esta proximo a um Portao !");
		return 1;
	}
	
