stock comecar_tirar_porte(playerid)
{
	new c = id[playerid];
	if(c != -1)
	{
	    if(TemPorte(playerid)) ms(playerid, 0, "Voce ja possue seu Porte de Armas !");
	    {
	        new sss[300];
	        format(sss, 300, "Voce nao possue R$ %s em maos para tirar o seu porte de armas !", ConvertMoney(VALOR_PORTE));
	        if(GranaPlayer(playerid) < VALOR_PORTE) ms(playerid, 0, sss);
	        else
	        {
	            Conta[playerid][c_Porte] = 1;
	            format(Conta[playerid][c_PorteData], 100, "[ %02d/%02d/%02d ]", DIA, MES, ANO);
	            salvar_conta(c, 0, "c_Porte", sv_int(1));
	            salvar_conta(c, 2, "c_PorteData", Conta[playerid][c_PorteData]);
	            DarGrana(playerid, -VALOR_PORTE);
	            format(sss, 300, "Voce tirou seu porte de armas por R$ %s, e pode se equipar com armas de fogo !", ConvertMoney(VALOR_PORTE));
				ms(playerid, 1, sss);
				ms(playerid, 2, "Voce pode ver ou mostrar seu Porte de Armas pelo /menu ou N > Celular > Carteira.");
				MS(playerid, 1, "Porte de armas adquirido com sucesso !");
			}
		}
	}
}

stock continuar_contas_banidas(playerid)
{
    iniciar_loop_lento(playerid, LL_CONTAS_BANIDAS, 0, MAX_CONTAS, "~w~Procurando contas banidas ...");
}

stock continuar_lista_contas(playerid)
{
	new come = lista_contas_player[playerid];
	new ssfd[100];
	format(ssfd, 100, "~w~Carregando lista de contas de %d ate %d ...", come, come+1000);
	if(come >= 0) iniciar_loop_lento(playerid, LL_LISTA_CONTAS, come, come+1000, ssfd);
	else
	{
	    if(come == -3) continuar_contas_banidas(playerid);
	    if(come == -2) continuar_contas_offline(playerid, lista_contas_dias[playerid]);
	    if(come == -1) continuar_contas_nick(playerid, lista_contas_pesquisa[playerid]);
	}
}

stock continuar_contas_offline(playerid, const nickk[])
{
	format(nick_pesquisar[playerid], MAX_PLAYER_NAME, nickk);
	new ssfd[100];
	format(ssfd, 100, "~w~Procurando contas offline a %d dias ...", strval(nickk));
    iniciar_loop_lento(playerid, LL_CONTAS_OFF, 0, MAX_CONTAS, ssfd);
}

stock continuar_contas_nick(playerid, const nickk[])
{
    format(nick_pesquisar[playerid], MAX_PLAYER_NAME, nickk);
    new ssfd[100];
	format(ssfd, 100, "~w~Pesquisando Contas com '%s' no Nick ...", nickk);
   	iniciar_loop_lento(playerid, LL_PESQUISAR_NICK, 0, MAX_CONTAS, ssfd);
}

stock continuar_meu_id(playerid, const nickk[])
{
    format(nick_pesquisar[playerid], MAX_PLAYER_NAME, nickk);
	iniciar_loop_lento(playerid, LL_NICK_CONTA, 0, MAX_CONTAS, "~w~Procurando conta~n~com este Nick ...");
}

stock iniciar_loop_lento(playerid, idl, minl, maxl, const msgl[]="Carregando ...")
{
	if(playerid != -1)
	{
		KillTimer(timer_loop_lento[playerid]);
		cont_player[playerid] = 0;
		id_loop_lento[playerid] = idl;
		max_loop_lento[playerid] = maxl;
		min_loop_lento[playerid] = minl;
		listitem_loop_lento[playerid] = minl;
		format(msg_loop_lento[playerid], 100, msgl);
		PlayerTextDrawShow(playerid, T_Loop_Lento_p[playerid][0]);
	    timer_loop_lento[playerid] = SetTimerEx("repetir_loop_lento", 5, true, "d", playerid);
    }
    else
    {
      	KillTimer(timer_loop_lento_server);
      	max_loop_lento_server = maxl;
		min_loop_lento_server = minl;
		listitem_loop_lento_server = min_loop_lento_server;
		id_loop_lento_server = idl;
		timer_loop_lento_server = SetTimerEx("repetir_loop_lento", 5, true, "d", playerid);
	}
}

stock fim_loop_lento(playerid, response=0)
{
	if(playerid != -1)
	{
	    KillTimer(timer_loop_lento[playerid]);
	    PlayerTextDrawHide(playerid, T_Loop_Lento_p[playerid][0]);
	    new i = listitem_loop_lento[playerid];
	    new idl = id_loop_lento[playerid];
	    id_loop_lento[playerid] = -1;
	    if(response == -1) return 1;


		// verificar se uma conta com o nick pesquisado //
		if(idl == LL_NICK_CONTA)
		{
		    new sss[300];
		    if(response)
		    {
		        format(sss, 300, "\n\
				{ffff00}CONTA ENCONTRATA !\n\n\
				\
				{ffffff}ID: {00ffff}%d\n\
				{ffffff}Nick: {a1a1a1}%s\n\n\
				\
				{ffff00}[INFO] {a1a1a1}Use este {ffffff}ID {a1a1a1}e {ffffff}senha {a1a1a1}corretamente para\n\
				logar em sua conta em nosso servidor.\n", i, NomeConta(i));
				ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}_", sss, "Ok", "Fechar");
	            return 1;
		    }
		    else
		    {
		        format(sss, 300, "\n\
				{ff0000}NENHUM RESULTADO !\n\n\
				\
				{ffffff}Pesquisa: {a1a1a1}%s\n\n\
				\
				{ffff00}[INFO] {a1a1a1}Nao encontramos nenhuma conta registrada com esse\n\
				Nick, verifique o sua pesquisa e tente novamente.\n", nick_pesquisar[playerid]);
				ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}_", sss, "Ok", "Fechar");
		    }
		    return 1;
		}

		// contas offline //
		if(idl == LL_CONTAS_OFF)
		{
		    new dias = strval(nick_pesquisar[playerid]);
		    lista_contas_player[playerid] = -2;
		    lista_contas_dias[playerid] = dias;
			menu_id[playerid] = MENU_CONTAS;
			escolhendo_menu[playerid] = 0;
			format(nome_menu[playerid], 100, "Contas a '%d' dias offline", dias);
			format(botao_menu[playerid], 100, "OPCOES");
			max_menu[playerid] = cont_player[playerid];
			mostrar_menu(playerid, menu_id[playerid]);
			return 1;
		}

		// contas do servidor //
		if(idl == LL_LISTA_CONTAS)
		{
	        menu_id[playerid] = MENU_CONTAS;
			format(nome_menu[playerid], 100, "Contas de %d ate %d", lista_contas_player[playerid], lista_contas_player[playerid]+1000);
			format(botao_menu[playerid], 100, "OPCOES");
			max_menu[playerid] = cont_player[playerid];
			mostrar_menu(playerid, menu_id[playerid]);
			return 1;
		}

		// contas pesquisa nick //
		if(idl == LL_PESQUISAR_NICK)
		{
	        lista_contas_player[playerid] = -1;
		    format(lista_contas_pesquisa[playerid], MAX_PLAYER_NAME, nick_pesquisar[playerid]);
			menu_id[playerid] = MENU_CONTAS;
			format(nome_menu[playerid], 100, "Pesquisa por: '%s'", nick_pesquisar[playerid]);
			format(botao_menu[playerid], 100, "OPCOES");
			max_menu[playerid] = cont_player[playerid];
			mostrar_menu(playerid, menu_id[playerid]);
			return 1;
		}

		// contas pesquisa nick //
		if(idl == LL_CONTAS_BANIDAS)
		{
	        lista_contas_player[playerid] = -3;
			menu_id[playerid] = MENU_CONTAS;
			format(nome_menu[playerid], 100, "Contas Banidas");
			format(botao_menu[playerid], 100, "OPCOES");
			max_menu[playerid] = cont_player[playerid];
			mostrar_menu(playerid, menu_id[playerid]);
			return 1;
		}
	}
	else
	{
	    KillTimer(timer_loop_lento_server);
	    new i = listitem_loop_lento_server;
	    new idl = id_loop_lento_server;
	    id_loop_lento_server = -1;
	    if(response == -1) return 1;

        // carregar veiculos //
		if(idl == LL_CARREGAR_VEICULOS)
		{
		    if(i == -1) printf("ok %d", i);
		    printf("** Veiculos do servidor carregados !");
		    iniciar_loop_lento(-1, LL_CARREGAR_CASAS, 0, MAX_CASAS);
		    return 1;
		}

		// carregar casas //
		if(idl == LL_CARREGAR_CASAS)
		{
		    if(i == -1) printf("ok %d", i);
		    printf("** Casas do servidor carregadas !");
		    return 1;
		}

	}
	return 1;
}

BCG:: repetir_loop_lento(playerid)
{

	if(playerid != -1)
	{
		new i = listitem_loop_lento[playerid];
		new idl = id_loop_lento[playerid];
		if(i < max_loop_lento[playerid])
		{
			new strtx[120];
			new total = max_loop_lento[playerid]-min_loop_lento[playerid];
			new unidade = total/100;
			new porcento = (i-min_loop_lento[playerid])/unidade;
			format(strtx, 120, "%s~n~~w~%d%%", msg_loop_lento[playerid], porcento);
			PlayerTextDrawSetString(playerid, T_Loop_Lento_p[playerid][0], strtx);


			// contas banidas //
			if(idl == LL_CONTAS_BANIDAS)
			{
			    if(!ContaInvalida(i))
				{
				if(ContaBanida(i))
		        	{
					    if(cont_player[playerid] < MAX_MENU)
						{
						    Menu[playerid][cont_player[playerid]][menu_ID] = i;
						    Menu[playerid][cont_player[playerid]][menu_Unidades] = 0;
						    Menu[playerid][cont_player[playerid]][menu_Tipo] = 0;
						    Menu[playerid][cont_player[playerid]][menu_Valor] = 0;
						    Menu[playerid][cont_player[playerid]][menu_Modelo] = GetContaInt(i, "c_Skin");
						    format(Menu[playerid][cont_player[playerid]][menu_Nome], 200, "%d - %s", i, NomeConta(i));
						    if(AdminConta(i) > 0)
							{
								format(Menu[playerid][cont_player[playerid]][menu_Info], 200, "\
								~w~Nick: ~b~~h~%s~n~\
								~w~Senha: ~y~%s~n~\
								~w~Nivel: ~r~~h~%d", NomeConta(i), "--------", GetContaInt(i, "c_Nivel"));
						    }
						    else
							{
							format(Menu[playerid][cont_player[playerid]][menu_Info], 200, "\
								~w~Nick: ~b~~h~%s~n~\
								~w~Senha: ~y~%s~n~\
								~w~Nivel: ~r~~h~%d", NomeConta(i), GetContaString(i, "c_Senha"), GetContaInt(i, "c_Nivel"));
						    }
						    cont_player[playerid] ++;
					    }
				    }
			    }
			}

			// contas pesquisa nick //
			if(idl == LL_PESQUISAR_NICK)
			{
			    if(!ContaInvalida(i))
				{
				if(strfind(NomeConta(i), nick_pesquisar[playerid], true) != -1)
		        	{
					    if(cont_player[playerid] < MAX_MENU)
						{
						    Menu[playerid][cont_player[playerid]][menu_ID] = i;
						    Menu[playerid][cont_player[playerid]][menu_Unidades] = 0;
						    Menu[playerid][cont_player[playerid]][menu_Tipo] = 0;
						    Menu[playerid][cont_player[playerid]][menu_Valor] = 0;
						    Menu[playerid][cont_player[playerid]][menu_Modelo] = GetContaInt(i, "c_Skin");
						    format(Menu[playerid][cont_player[playerid]][menu_Nome], 200, "%d - %s", i, NomeConta(i));
						    if(AdminConta(i) > 0)
							{
								format(Menu[playerid][cont_player[playerid]][menu_Info], 200, "\
								~w~Nick: ~b~~h~%s~n~\
								~w~Senha: ~y~%s~n~\
								~w~Nivel: ~r~~h~%d", NomeConta(i), "--------", GetContaInt(i, "c_Nivel"));
						    }
						    else
							{
							format(Menu[playerid][cont_player[playerid]][menu_Info], 200, "\
								~w~Nick: ~b~~h~%s~n~\
								~w~Senha: ~y~%s~n~\
								~w~Nivel: ~r~~h~%d", NomeConta(i), GetContaString(i, "c_Senha"), GetContaInt(i, "c_Nivel"));
						    }
						    cont_player[playerid] ++;
					    }
				    }
			    }
			}

	        // contas do server  //
			if(idl == LL_LISTA_CONTAS)
			{
			    if(!ContaInvalida(i))
				{
				    if(cont_player[playerid] < MAX_MENU)
					{
					    Menu[playerid][cont_player[playerid]][menu_ID] = i;
					    Menu[playerid][cont_player[playerid]][menu_Unidades] = 0;
					    Menu[playerid][cont_player[playerid]][menu_Tipo] = 0;
					    Menu[playerid][cont_player[playerid]][menu_Valor] = 0;
					    Menu[playerid][cont_player[playerid]][menu_Modelo] = GetContaInt(i, "c_Skin");
					    format(Menu[playerid][cont_player[playerid]][menu_Nome], 200, "%d - %s", i, NomeConta(i));
					    if(AdminConta(i) > 0)
						{
							format(Menu[playerid][cont_player[playerid]][menu_Info], 200, "\
							~w~Nick: ~b~~h~%s~n~\
							~w~Senha: ~y~%s~n~\
							~w~Nivel: ~r~~h~%d", NomeConta(i), "--------", GetContaInt(i, "c_Nivel"));
					    }
					    else
						{
						format(Menu[playerid][cont_player[playerid]][menu_Info], 200, "\
							~w~Nick: ~b~~h~%s~n~\
							~w~Senha: ~y~%s~n~\
							~w~Nivel: ~r~~h~%d", NomeConta(i), GetContaString(i, "c_Senha"), GetContaInt(i, "c_Nivel"));
					    }
					    cont_player[playerid] ++;
				    }
			    }
			}

			// contas offline //
			if(idl == LL_CONTAS_OFF)
			{
				new dias = strval(nick_pesquisar[playerid]);
			    if(!ContaInvalida(i))
				{
				if(getdate() - GetContaInt(i, "c_UltimoLogin") >= dias)
				{
					    if(cont_player[playerid] < MAX_MENU)
						{
						    Menu[playerid][cont_player[playerid]][menu_ID] = i;
						    Menu[playerid][cont_player[playerid]][menu_Unidades] = 0;
						    Menu[playerid][cont_player[playerid]][menu_Tipo] = 0;
						    Menu[playerid][cont_player[playerid]][menu_Valor] = 0;
						    Menu[playerid][cont_player[playerid]][menu_Modelo] = GetContaInt(i, "c_Skin");
						    format(Menu[playerid][cont_player[playerid]][menu_Nome], 200, "%d - %s", i, NomeConta(i));
						    if(AdminConta(i) > 0)
							{
								format(Menu[playerid][cont_player[playerid]][menu_Info], 200, "\
								~w~Nick: ~b~~h~%s~n~\
								~w~Senha: ~y~%s~n~\
								~w~Nivel: ~r~~h~%d", NomeConta(i), "--------", GetContaInt(i, "c_Nivel"));
						    }
						    else
							{
							format(Menu[playerid][cont_player[playerid]][menu_Info], 200, "\
								~w~Nick: ~b~~h~%s~n~\
								~w~Senha: ~y~%s~n~\
								~w~Nivel: ~r~~h~%d", NomeConta(i), GetContaString(i, "c_Senha"), GetContaInt(i, "c_Nivel"));
						    }
						    cont_player[playerid] ++;
					    }
				    }
			    }
			}

	        // verificar conta com nick pesquisado //
			if(idl == LL_NICK_CONTA)
			{
			    if(!ContaInvalida(i))
				{
				if(Comparar(nick_pesquisar[playerid], NomeConta(i)))
				{
				    fim_loop_lento(playerid, 1);
				    return 1;
				}
			    }
			}

	        listitem_loop_lento[playerid] ++;
	        return 1;
		}
		fim_loop_lento(playerid);
	}
	else
	{
	    new i = listitem_loop_lento_server;
		new idl = id_loop_lento_server;
		if(i < max_loop_lento_server)
		{

			// carregar casas //
			if(idl == LL_CARREGAR_CASAS)
			{
				new file[80];
				new lin[600];
				new fil[80];
			    Casa[i][casa_3D1] = DynamicText3D:-1;
			    Casa[i][casa_3D2] = DynamicText3D:-1;
				Casa[i][casa_3D3] = DynamicText3D:-1;
			    format(file, 80, "Casas/Casa_%d.txt", i);
			    if(DOF2_FileExists(file))
				{
				Casa[i][casa_Existe] = 1;
				Casa[i][casa_X1] = DOF2_GetFloat(file, "casa_X1");
				Casa[i][casa_Y1] = DOF2_GetFloat(file, "casa_Y1");
				Casa[i][casa_Z1] = DOF2_GetFloat(file, "casa_Z1");
				Casa[i][casa_X2] = DOF2_GetFloat(file, "casa_X2");
				Casa[i][casa_Y2] = DOF2_GetFloat(file, "casa_Y2");
				Casa[i][casa_Z2] = DOF2_GetFloat(file, "casa_Z2");
					Casa[i][casa_X3] = DOF2_GetFloat(file, "casa_X3");
				Casa[i][casa_Y3] = DOF2_GetFloat(file, "casa_Y3");
				Casa[i][casa_Z3] = DOF2_GetFloat(file, "casa_Z3");
				Casa[i][casa_Tipo] = DOF2_GetInt(file, "casa_Tipo");
				Casa[i][casa_Chave] = DOF2_GetInt(file, "casa_Chave");
				Casa[i][casa_Venda] = DOF2_GetInt(file, "casa_Venda");
				Casa[i][casa_Valor] = DOF2_GetInt(file, "casa_Valor");
				Casa[i][casa_Interior] = DOF2_GetInt(file, "casa_Interior");
				Casa[i][casa_Mundo] = DOF2_GetInt(file, "casa_Mundo");
				Casa[i][casa_Dono] = DOF2_GetInt(file, "casa_Dono");
				Casa[i][casa_Contas] = DOF2_GetInt(file, "casa_Contas");
				Casa[i][casa_Data] = DOF2_GetInt(file, "casa_Data");
			Casa[i][casa_Cidade] = DOF2_GetInt(file, "casa_Cidade");
				Casa[i][casa_Cash] = DOF2_GetInt(file, "casa_Cash");
				Casa[i][casa_Keys][0] = DOF2_GetInt(file, "casa_Key1");
				Casa[i][casa_Keys][1] = DOF2_GetInt(file, "casa_Key2");
				Casa[i][casa_Keys][2] = DOF2_GetInt(file, "casa_Key3");
				Casa[i][casa_Garagem] = DOF2_GetInt(file, "casa_Garagem");
				if(Casa[i][casa_Garagem] == 1)
				{
				    Casa[i][casa_GarX] = DOF2_GetFloat(file, "casa_GarX");
				    Casa[i][casa_GarY] = DOF2_GetFloat(file, "casa_GarY");
				    Casa[i][casa_GarZ] = DOF2_GetFloat(file, "casa_GarZ");
				    Casa[i][casa_GarMundo] = DOF2_GetInt(file, "casa_GarMundo");
				    Casa[i][casa_GarInterior] = DOF2_GetInt(file, "casa_GarInterior");
				    Casa[i][casa_GarV] = DOF2_GetInt(file, "casa_GarV");
				}
				Compras[i][com_Existe] = DOF2_GetInt(file, "com_Existe");
				Compras[i][com_Tempo] = DOF2_GetInt(file, "com_Tempo");

				for(new aa; aa<MAX_COMPRAS; aa++)
					{
					    if(Compras[i][com_Existe] == 1)
						{
					    	format(fil, 80, "com_Movel_%d", aa);
							Compras[i][com_Movel][aa] = DOF2_GetInt(file, fil);
						}
						else
						{
						    Compras[i][com_Movel][aa] = -1;
						}
				}

				for(new a; a<MAX_MOVEIS; a++)
				{
				    Casa[i][casa_m_3D][a] = DynamicText3D:-1;
				    format(fil, 80, "casa_Movel_%d", a);
				    format(lin, 500, "%s", DOF2_GetString(file, fil));
				    split_linha(lin, strlen(lin));
				    Casa[i][casa_m_Existe][a] = strval(split[0]);
				    Casa[i][casa_m_Status][a] = strval(split[1]);
		                Casa[i][casa_m_ID][a] = strval(split[2]);
		                Casa[i][casa_m_X][a] = floatstr(split[3]);
		                Casa[i][casa_m_Y][a] = floatstr(split[4]);
		                Casa[i][casa_m_Z][a] = floatstr(split[5]);
		                Casa[i][casa_m_RX][a] = floatstr(split[6]);
		                Casa[i][casa_m_RY][a] = floatstr(split[7]);
		                Casa[i][casa_m_RZ][a] = floatstr(split[8]);
		                atualizar_movel(i, a);
				}
				atualizar_casa(i);
					carregar_bau(i);
			    }
			}

		    // carregar veiculos //
			if(idl == LL_CARREGAR_VEICULOS)
			{
			    new file[80];
				new str2[80];
				new str[600];

				// carregando as informacoes //
				format(file, 80, "Veiculos/Veiculo_%d.txt", i);
				if(DOF2_FileExists(file))
				{
				    Veiculo[i][v_Existe] = 1;
				    Iter_Add(Iter_Veiculos, i);
				    Veiculo[i][v_Garagem] = 1;
				    Veiculo[i][v_Org] = DOF2_GetInt(file, "v_Org");
				    NeonVeiculo[i][0] = DOF2_GetInt(file, "NeonVeiculo_1");
				    NeonVeiculo[i][1] = DOF2_GetInt(file, "NeonVeiculo_2");
				    XenonVeiculo[i][0] = DOF2_GetInt(file, "XenonVeiculo_1");
				    XenonVeiculo[i][1] = DOF2_GetInt(file, "XenonVeiculo_2");
				    Veiculo[i][v_Emplacar] = DOF2_GetInt(file, "v_Emplacar");
				    Veiculo[i][v_Conce] = DOF2_GetInt(file, "v_Conce");
				    if(Veiculo[i][v_Conce] == 2) Veiculo[i][v_Conce] = 1;
			    	Veiculo[i][v_ConceID] = DOF2_GetInt(file, "v_ConceID");
					Veiculo[i][v_IPVA] = DOF2_GetInt(file, "v_IPVA");
					Veiculo[i][v_Contas] = DOF2_GetInt(file, "v_Contas");
					Veiculo[i][v_Dono] = DOF2_GetInt(file, "v_Dono");
					Veiculo[i][v_Modelo] = DOF2_GetInt(file, "v_Modelo");
					Veiculo[i][v_Gasolina] = DOF2_GetInt(file, "v_Gasolina");
					Veiculo[i][v_Bateria] = DOF2_GetInt(file, "v_Bateria");
					Veiculo[i][v_Lataria] = DOF2_GetFloat(file, "v_Lataria");
					Veiculo[i][v_Trancado] = DOF2_GetInt(file, "v_Trancado");
					Veiculo[i][v_Cor1] = DOF2_GetInt(file, "v_Cor1");
					Veiculo[i][v_Cor2] = DOF2_GetInt(file, "v_Cor2");
					Veiculo[i][v_Cargo] = DOF2_GetInt(file, "v_Cargo");
					Veiculo[i][v_Garagem_ID] = DOF2_GetInt(file, "v_Garagem_ID");
					Veiculo[i][v_Emprego] = DOF2_GetInt(file, "v_Emprego");
					Veiculo[i][v_Compra] = DOF2_GetInt(file, "v_Compra");
					Veiculo[i][v_Keys][0] = DOF2_GetInt(file, "v_Key1");
					Veiculo[i][v_Keys][1] = DOF2_GetInt(file, "v_Key2");
					Veiculo[i][v_Keys][2] = DOF2_GetInt(file, "v_Key3");
					format(Veiculo[i][v_History], 300, "%s", DOF2_GetString(file, "v_History"));
					Veiculo[i][v_X] = DOF2_GetFloat(file, "v_X");
					Veiculo[i][v_Y] = DOF2_GetFloat(file, "v_Y");
					Veiculo[i][v_Z] = DOF2_GetFloat(file, "v_Z");
					Veiculo[i][v_A] = DOF2_GetFloat(file, "v_A");
					Veiculo[i][v_Vida] = DOF2_GetFloat(file, "v_Vida");
					Veiculo[i][v_TemChasi] = DOF2_GetInt(file, "v_TemChasi");
					format(Veiculo[i][v_Chasi], 50, "%s", DOF2_GetString(file, "v_Chasi"));
					format(Veiculo[i][v_Data], 100, "%s", DOF2_GetString(file, "v_Data"));

		            // pecas //
		            format(str, 500, "%s", DOF2_GetString(file, "v_Pecas"));
		            split_linha(str, strlen(str));
		            Veiculo[i][v_Pneu][0] = strval(split[0]);
					Veiculo[i][v_Pneu][1] = strval(split[1]);
					Veiculo[i][v_Pneu][2] = strval(split[2]);
					Veiculo[i][v_Pneu][3] = strval(split[3]);
					Veiculo[i][v_Farol][0] = strval(split[4]);
					Veiculo[i][v_Farol][1] = strval(split[5]);
					Veiculo[i][v_Farol][2] = strval(split[6]);
					Veiculo[i][v_Porta][0] = strval(split[7]);
					Veiculo[i][v_Porta][1] = strval(split[8]);
					Veiculo[i][v_Porta][2] = strval(split[9]);
					Veiculo[i][v_Porta][3] = strval(split[10]);
					Veiculo[i][v_Painel][0] = strval(split[11]);
					Veiculo[i][v_Painel][1] = strval(split[12]);
					Veiculo[i][v_Painel][2] = strval(split[13]);
					Veiculo[i][v_Painel][3] = strval(split[14]);
					Veiculo[i][v_Painel][4] = strval(split[15]);
					Veiculo[i][v_Painel][5] = strval(split[16]);
					Veiculo[i][v_Painel][6] = strval(split[17]);

					// porta malas //
					for(new po; po<MAX_PORTA_MALAS; po++)
					{
					format(str2, 80, "v_Malas_%d", po);
					format(str, 500, "%s", DOF2_GetString(file, str2));
					split_linha(str, strlen(str));
					PortaMalas[i][po][inv_ID] = strval(split[0]);
					PortaMalas[i][po][inv_Unidades] = strval(split[1]);
					PortaMalas[i][po][inv_Tipo] = strval(split[2]);
					PortaMalas[i][po][inv_Ativo] = strval(split[3]);
					PortaMalas[i][po][inv_Tempo] = strval(split[4]);
					if(PortaMalas[i][po][inv_ID] == 67)
					{
				        new ida = id_armas_org(PortaMalas[i][po][inv_Tipo]);
				        if(ida == -1) PortaMalas[i][po][inv_ID] = 0, PortaMalas[i][po][inv_Unidades] = 0, PortaMalas[i][po][inv_Tipo] = 0, PortaMalas[i][po][inv_Ativo] = 0, PortaMalas[i][po][inv_Tempo] = 0;
					}
				    }

					// tunings //
				format(str, 500, "%s", DOF2_GetString(file, "v_Tunings"));
				split_linha(str, strlen(str), -1);
					for(new a; a<18; a++) TuningVeiculo[i][a] = strval(split[a]);

				    // multas //
				    new arqui[60];
					for(new a; a<MAX_MULTAS; a++)
					{
					format(arqui, 60, "v_Multa_%d", a);
					format(str, 500, "%s", DOF2_GetString(file, arqui));
				    	split_linha(str, strlen(str));
					Veiculo_Multa[i][a][mu_Existe] = strval(split[0]);
					if(Veiculo_Multa[i][a][mu_Existe] == 1)
						{
		                    Veiculo_Multa[i][a][mu_Valor] = strval(split[1]);
							Veiculo_Multa[i][a][mu_Conta] = strval(split[2]);
							Veiculo_Multa[i][a][mu_Radar] = strval(split[3]);
							format(Veiculo_Multa[i][a][mu_Motivo], 100, split[4]);
							format(Veiculo_Multa[i][a][mu_Data], 50, split[5]);
					    }
					    else
						{
		                    Veiculo_Multa[i][a][mu_Valor] = 0;
							Veiculo_Multa[i][a][mu_Conta] = -1;
							Veiculo_Multa[i][a][mu_Radar] = -1;
							format(Veiculo_Multa[i][a][mu_Motivo], 100, "Nenhum");
							format(Veiculo_Multa[i][a][mu_Data], 50, "Nada");
					    }
				    }

		            format(PlacaVeiculo[i], 20, "%s", DOF2_GetString(file, "v_Placa"));
					if(Veiculo[i][v_Emplacar] == 1) format(PlacaVeiculo[i], 20, "SEM PLACA");
					else if(strlen(PlacaVeiculo[i]) < 3) gerar_placa(PlacaVeiculo[i], 20);
					if(Veiculo[i][v_Dono] == -1 && Veiculo[i][v_Emprego] == -1 && Veiculo[i][v_Org] == -1)
					{
					    Veiculo[i][v_Trancado] = 0;
					    SalvarInfo(i, 50);
					}

					texto_garagem(i);
				}
			}

		    listitem_loop_lento_server ++;
	        return 1;
		}
	    fim_loop_lento(playerid);
	}
	return 1;
}

stock trocar_fichas(playerid)
{
	if(logado[playerid] == 1)
	{
		if(id[playerid] == -1)
		{
			new c = contas[playerid];
			if(c != -1)
			{
			    new fichas =  GetContaInt(c, "c_Fichas");
			    if(fichas < 35) ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}_",
				"{ff0000}[ERRO] {a1a1a1}Fichas insuficientes, e preciso 65 fichas\n\
				para trocar em uma Caixa Misteriosa !", "Ok", "Fechar");
			    else
				{
					ShowPlayerDialog(playerid, DIALOG_TROCAR_FICHAS, DIALOG_STYLE_MSGBOX, "{000000}_", "\n\
					{00ffff}[INFO] {a1a1a1}Deseja trocar 65 Fichas \n\
					por uma Caixa misteriosa ?\n", "Trocar", "Cancelar");
				}
			}
		}
	}
}

stock contas_fake(playerid, dias, nivel, horas)
{
	new sss[300];
	new cont;
	new tempo = horas*UMA_HORA;
	for(new i; i<MAX_CONTAS; i++)
	{
	    if(!ContaInvalida(i))
	    {
	        if(ContaOnline(i) == -1)
	        {
		        if(getdate() - GetContaInt(i, "c_UltimoLogin") >= dias)
		        {
		            if(GetContaInt(i, "c_TempoJogado") < tempo)
		            {
		                if(GetContaInt(i, "c_Nivel") < nivel)
		                {
		                    apagar_conta(i);
		                    cont++;
		                }
					}
		        }
	        }
		}
	}
	format(sss, 300, "Total de %d Contas Inativas foram apagadas !", cont);
	ms(playerid, 1, sss);
}

stock youtuber(c)
{
    new pla = ContaOnline(c);
	if(Online(pla))
	{
        if(Conta[pla][c_TagYT] == 1)
        {
            return 1;
        }
	}
	else
	{
	    if(GetContaInt(c, "c_TagYT") == 1)
	    {
	        return 1;
	    }
	}
	return 0;
}

stock mostrar_titulos(playerid)
{
	new c = id[playerid];
	if(c != -1)
	{
	    SG[0] = EOS;
		if(Conta[playerid][c_Tag] == 0) strcat(SG, "{ffff00}Nenhum\n");
		else strcat(SG, "{a1a1a1}Nenhum\n");
		if(Conta[playerid][c_Tag] == 1) strcat(SG, "{ffff00}YouTuber\n");
		else strcat(SG, "{a1a1a1}YouTuber\n");
		if(Conta[playerid][c_Tag] == 2) strcat(SG, "{ffff00}Emprego\n");
		else strcat(SG, "{a1a1a1}Emprego\n");
		if(Conta[playerid][c_Tag] == 3) strcat(SG, "{ffff00}Organizacao\n");
		else strcat(SG, "{a1a1a1}Organizacao\n");
		ShowPlayerDialog(playerid, DIALOG_TITULOS, DIALOG_STYLE_LIST, "Escolher Titulo", SG, "Escolher", "Fechar");
	}
}


stock mostrar_mudar_local(playerid)
{
    new c = id[playerid];
	if(c != -1)
	{
    	SG[0] = EOS;
        if(Conta[playerid][c_Local] == 0) strcat(SG, "{ffff00}Spawn Civil\n");
		else strcat(SG, "{a1a1a1}Spawn Civil\n");
		if(Conta[playerid][c_Local] == 1) strcat(SG, "{ffff00}Organizacao\n");
		else strcat(SG, "{a1a1a1}Organizacao\n");
		if(Conta[playerid][c_Local] == 2) strcat(SG, "{ffff00}Casa\n");
		else strcat(SG, "{a1a1a1}Casa\n");
        ShowPlayerDialog(playerid, DIALOG_LOCAL, DIALOG_STYLE_LIST, "Escolher Local de Spawn", SG, "Escolher", "Fechar");
	}
}

stock TemChaveCasa(playerid, i)
{
	new c = id[playerid];
	if(c == -1) return 0;
	for(new k; k<3; k++) if(Casa[i][casa_Keys][k] == c) return 1;
	return 0;
}

stock spawn_casa(playerid)
{
    new c = id[playerid];
	if(c != -1)
	{
	    new Float:dist;
        new Float:p[3];
        GetPlayerPos(playerid, p[0], p[1], p[2]);
        new cont;
        new sss[400];
        SG[0] = EOS;
        strcat(SG, "ID\tTipo\tDistancia\tCidade\n");
        zerar_lista(playerid);
        foreach(new i:Iter_Casas)
        {
            if(Casa[i][casa_Existe] == 1)
            {
                if(Casa[i][casa_Dono] == c)
                {
					GetDistance(dist, p[0], p[1], p[2], Casa[i][casa_X1], Casa[i][casa_Y1], Casa[i][casa_Z1]);
                    format(sss, 400, "{a1a1a1}%d\t{00ffff}%s\t{ffffff}%.0f Metros\t{ffff00}%s\n", i, tipo_casa(i), dist, cidade2(cidade_casa(i)));
                    strcat(SG, sss);
                    Lista[playerid][cont] = i;
                    cont ++;
                }
            }
        }
        format(sss, 300, "{ffffff}Suas Casas [ {ffff00}%d {ffffff}]", cont);
        ShowPlayerDialog(playerid, DIALOG_LOCAL2, DIALOG_STYLE_TABLIST_HEADERS, sss, SG, "Continuar", "Fechar");
	}
	return 1;
}

stock SetPlayerPos_(playerid, Float:ax, Float:ay, Float:az, Float:ag=0.0101)
{
	if(IsPlayerConnected(playerid))
	{
	    SetPlayerPos(playerid, ax, ay, az);
	    if(ag != 0.0101)
	    {
	        SetPlayerFacingAngle(playerid, ag);
	    }
	}
}

stock ultima_pos(playerid)
{
    new c = id[playerid];
	if(c != -1)
	{
    	// colocar no ultimo local //
		SetPlayerInterior(playerid, Conta[playerid][c_Interior]);
		SetPlayerVirtualWorld_(playerid, Conta[playerid][c_Mundo]);
		SetPlayerPos_(playerid, Conta[playerid][c_X]+0.1,Conta[playerid][c_Y]+0.1,Conta[playerid][c_Z]+0.1);
		SetPlayerFacingAngle(playerid, Conta[playerid][c_A]);
		Conta[playerid][c_UltimaPos] = gettime()+(60*120);
		salvar_conta(c, 0, "c_UltimaPos", sv_int(Conta[playerid][c_UltimaPos]));
		ms(playerid, 1, "Voce carregou sua ultima posicao !");
		if(PlayerCop(playerid)){
            if(servico[playerid] == 0){
            	servico[playerid] = 1;
            	SetPlayerArmour(playerid, 100.0);
            }
        }
		// dar armas salvas na conta //
	    ResetPlayerWeapons_(playerid);
	    KillTimer(timer_dar_armas[playerid]);
	    Arma_Player[playerid] = 0;
	    for(new w; w<13; w++)
	    {
	        if(Conta[playerid][c_Arma][w] != 0)
	        {
	            GivePlayerWeapon_(playerid, Conta[playerid][c_Arma][w], Conta[playerid][c_Municao][w]);
	        }
	    }
	    // setar vida e colete salvo //
	    SetarVida(playerid, Conta[playerid][c_Vida]);
	    SetarColete(playerid, Conta[playerid][c_Colete]);
		pode_carregar[playerid] = 1;
		fechar_pos(playerid);
	}
}

BCG:: perguntar_pos(playerid)
{
    new c = id[playerid];
	if(c != -1)
	{
    	voltar_local[playerid] = 1;
    	if(Conta[playerid][c_Morto] == 0)
    	{
    	    if(Conta[playerid][c_TempoCadeia] == 0)
    	    {
    	        if(Conta[playerid][c_CA_Tempo] == 0)
	    	  	{
					for(new a; a<sizeof T_UltimaPos; a++) TextDrawShowForPlayer(playerid, T_UltimaPos[a]);
				    PlayerTextDrawShow(playerid, T_UltimaPos_p[playerid][0]);
					SelectTextDraw(playerid, 0x00ffff70);
				}
			}
		}
	}
}

stock fechar_pos(playerid)
{
    voltar_local[playerid] = 0;
    for(new a; a<sizeof T_UltimaPos; a++) TextDrawHideForPlayer(playerid, T_UltimaPos[a]);
    PlayerTextDrawHide(playerid, T_UltimaPos_p[playerid][0]);
    CancelSelectTextDraw(playerid);
    pode_carregar[playerid] = 0;
    // dar armas salvas na conta //
	ResetPlayerWeapons_(playerid);
	KillTimer(timer_dar_armas[playerid]);
	Arma_Player[playerid] = 0;
	for(new w; w<13; w++)
	{
	    if(Conta[playerid][c_Arma][w] != 0)
	    {
	        GivePlayerWeapon_(playerid, Conta[playerid][c_Arma][w], Conta[playerid][c_Municao][w]);
	    }
	}
}

stock carregar_mapa(playerid)
{
    // Forca o streamer a reconstruir os objetos visiveis do jogador.
    OnPlayerInteriorChange(playerid, GetPlayerInterior(playerid), GetPlayerInterior(playerid));
    Streamer_Update(playerid);
    foi_pro_mapa[playerid] = 1;
}

BCG:: carregar_empresas()
{
	new file[80];
	new cont;
	for(new i; i<MAX_EMPRESAS; i++)
	{
	    Empresa[i][em_3D1] = DynamicText3D:-1;
		Empresa[i][em_3D2] = DynamicText3D:-1;
	    format(file, 80, "Empresas/Empresa_%d.txt", i);
	    if(DOF2_FileExists(file))
		{
		    Empresa[i][em_Existe] = 1;
		    format(Empresa[i][em_Nome], 100, "%s", DOF2_GetString(file, "em_Nome"));
		    Empresa[i][em_Tipo] = DOF2_GetInt(file, "em_Tipo");
		    Empresa[i][em_MapaID] = DOF2_GetInt(file, "em_MapaID");
		    Empresa[i][em_Dono] = DOF2_GetInt(file, "em_Dono");
		    Empresa[i][em_Interior] = DOF2_GetInt(file, "em_Interior");
		    Empresa[i][em_Entrada] = DOF2_GetInt(file, "em_Entrada");
		    Empresa[i][em_Produtos] = DOF2_GetInt(file, "em_Produtos");
		    Empresa[i][em_ValorProdutos] = DOF2_GetInt(file, "em_ValorProdutos");
		    if(Empresa[i][em_ValorProdutos] < 250) Empresa[i][em_ValorProdutos] = 250;
		    Empresa[i][em_Cofre] = DOF2_GetInt(file, "em_Cofre");
		    Empresa[i][em_Valor] = DOF2_GetInt(file, "em_Valor");
		    Empresa[i][em_X] = DOF2_GetFloat(file, "em_X");
		    Empresa[i][em_Y] = DOF2_GetFloat(file, "em_Y");
		    Empresa[i][em_Z] = DOF2_GetFloat(file, "em_Z");
		    Empresa[i][em_X2] = DOF2_GetFloat(file, "em_X2");
		    Empresa[i][em_Y2] = DOF2_GetFloat(file, "em_Y2");
		    Empresa[i][em_Z2] = DOF2_GetFloat(file, "em_Z2");
		    Empresa[i][em_X1] = DOF2_GetFloat(file, "em_X1");
		    Empresa[i][em_Y1] = DOF2_GetFloat(file, "em_Y1");
		    Empresa[i][em_Z1] = DOF2_GetFloat(file, "em_Z1");
		    Empresa[i][em_X3] = DOF2_GetFloat(file, "em_X3");
		    Empresa[i][em_Y3] = DOF2_GetFloat(file, "em_Y3");
		    Empresa[i][em_Z3] = DOF2_GetFloat(file, "em_Z3");
		    Cofre[i][cofre_Tempo] = DOF2_GetInt(file, "cofre_Tempo");
		    Cofre[i][cofre_Tempo2] = DOF2_GetInt(file, "cofre_Tempo2");
		    if(Cofre[i][cofre_Tempo] > gettime()) Cofre[i][cofre_Status] = 1;
		    else Cofre[i][cofre_Status] = 0;
		    if(Cofre[i][cofre_Tempo2] > gettime()) Cofre[i][cofre_Status2] = 1;
		    else Cofre[i][cofre_Status2] = 0;
		    atualizar_empresa(i);
		    atualizar_cofre(i);
		    cont ++;
		}
	}
	printf("** %d Empresas do Servidor carregadas.", cont);
}

stock salvar_empresa(i)
{
	new file[80];
    format(file, 80, "Empresas/Empresa_%d.txt", i);
    if(Empresa[i][em_Existe] == 1)
    {
	    if(!DOF2_FileExists(file)) DOF2_CreateFile(file);
	    DOF2_SetString(file, "em_Nome", Empresa[i][em_Nome]);
	    DOF2_SetInt(file, "em_MapaID", Empresa[i][em_MapaID]);
	    DOF2_SetInt(file, "em_Tipo", Empresa[i][em_Tipo]);
	    DOF2_SetInt(file, "em_Dono", Empresa[i][em_Dono]);
	    DOF2_SetInt(file, "em_Interior",  Empresa[i][em_Interior]);
	    DOF2_SetInt(file, "em_Entrada", Empresa[i][em_Entrada]);
	    DOF2_SetInt(file, "em_Cofre", Empresa[i][em_Cofre]);
	    DOF2_SetInt(file, "em_Valor", Empresa[i][em_Valor]);
	    DOF2_SetInt(file, "em_Produtos", Empresa[i][em_Produtos]);
	    DOF2_SetInt(file, "em_ValorProdutos", Empresa[i][em_ValorProdutos]);
	    DOF2_SetFloat(file, "em_X", Empresa[i][em_X]);
	    DOF2_SetFloat(file, "em_Y", Empresa[i][em_Y]);
	    DOF2_SetFloat(file, "em_Z", Empresa[i][em_Z]);
	    DOF2_SetFloat(file, "em_X2", Empresa[i][em_X2]);
	    DOF2_SetFloat(file, "em_Y2", Empresa[i][em_Y2]);
	    DOF2_SetFloat(file, "em_Z2", Empresa[i][em_Z2]);
	    DOF2_SetFloat(file, "em_X3", Empresa[i][em_X3]);
	    DOF2_SetFloat(file, "em_Y3", Empresa[i][em_Y3]);
	    DOF2_SetFloat(file, "em_Z3", Empresa[i][em_Z3]);
	    DOF2_SetFloat(file, "em_X1", Empresa[i][em_X1]);
	    DOF2_SetFloat(file, "em_Y1", Empresa[i][em_Y1]);
	    DOF2_SetFloat(file, "em_Z1", Empresa[i][em_Z1]);
	    DOF2_SetInt(file, "cofre_Tempo", Cofre[i][cofre_Tempo]);
	    DOF2_SetInt(file, "cofre_Tempo2", Cofre[i][cofre_Tempo2]);
	    DOF2_SaveFile();
	}
	else DOF2_RemoveFile(file);
}

stock atualizar_empresa(i)
{
	if(IsValidDynamic3DTextLabel(Empresa[i][em_3D1])) DestroyDynamic3DTextLabel(Empresa[i][em_3D1]);
	if(IsValidDynamic3DTextLabel(Empresa[i][em_3D2])) DestroyDynamic3DTextLabel(Empresa[i][em_3D2]);
	Empresa[i][em_3D1] = DynamicText3D:-1;
	Empresa[i][em_3D2] = DynamicText3D:-1;
	Iter_Remove(Iter_Empresas, i);

	if(IsValidDynamicPickup(Empresa[i][em_Pickup1])) DestroyDynamicPickup(Empresa[i][em_Pickup1]);
	if(IsValidDynamicPickup(Empresa[i][em_Pickup2])) DestroyDynamicPickup(Empresa[i][em_Pickup2]);
	if(IsValidDynamicPickup(Empresa[i][em_Pickup3])) DestroyDynamicPickup(Empresa[i][em_Pickup3]);
	if(IsValidDynamicPickup(Empresa[i][em_Pickup4])) DestroyDynamicPickup(Empresa[i][em_Pickup4]);
	if(IsValidDynamicMapIcon(Empresa[i][em_Mapa])) DestroyDynamicMapIcon(Empresa[i][em_Mapa]);
	if(Empresa[i][em_Existe] == 1)
	{
	    new sss[1000];
	    Iter_Add(Iter_Empresas, i);
	    if(Empresa[i][em_Dono] != -1)
	    {
	    	if(Empresa[i][em_Tipo] == 0)
			{
			    Empresa[i][em_3D2] = CreateDynamic3DTextLabel( "{ffff00}SAIR\n{a1a1a1}Aperte {ffffff}F {a1a1a1}para\nsair", 0xffffff90, Empresa[i][em_X2], Empresa[i][em_Y2], Empresa[i][em_Z2], 5, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, i, Empresa[i][em_Interior], -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
				Empresa[i][em_Pickup2] = CreateDynamicPickup(19134, 1, Empresa[i][em_X2], Empresa[i][em_Y2], Empresa[i][em_Z2], i, Empresa[i][em_Interior], -1, STREAMER_PICKUP_SD, -1, 0);
				Empresa[i][em_Pickup1] = CreateDynamicPickup(19524, 1, Empresa[i][em_X], Empresa[i][em_Y], Empresa[i][em_Z], -1, -1, -1, STREAMER_PICKUP_SD, -1, 0);
		    }

			format(sss, 1000, "\
			\
			{00ffff}%s [%d]\n\
			{E6E6FA}Dono: {ffffff}%s\n\
			{E6E6FA}Entrada: {4169E1}R$ %s\n\
			{E6E6FA}Produtos: {ffffff}%d/{ffff00}500\n\
			{E6E6FA}Valor Produtos: {00ffff}R$ %s\n\
			{E6E6FA}Cofre: {4169E1}R$ %s\n",
			Empresa[i][em_Nome], i, NomeConta(Empresa[i][em_Dono]), ConvertMoney(Empresa[i][em_Entrada]), Empresa[i][em_Produtos], ConvertMoney(Empresa[i][em_ValorProdutos]), ConvertMoney(Empresa[i][em_Cofre]) );
		}
		else
		{
		    if(Empresa[i][em_Tipo] == 0)
			{
			    Empresa[i][em_3D2] = CreateDynamic3DTextLabel( "{ffff00}SAIR\n{a1a1a1}Aperte {ffffff}F {a1a1a1}para\nsair", 0xffffff90, Empresa[i][em_X2], Empresa[i][em_Y2], Empresa[i][em_Z2], 5, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, i, Empresa[i][em_Interior], -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
				Empresa[i][em_Pickup2] = CreateDynamicPickup(19134, 1, Empresa[i][em_X2], Empresa[i][em_Y2], Empresa[i][em_Z2], i, Empresa[i][em_Interior], -1, STREAMER_PICKUP_SD, -1, 0);
				Empresa[i][em_Pickup1] = CreateDynamicPickup(1239, 1, Empresa[i][em_X], Empresa[i][em_Y], Empresa[i][em_Z], -1, -1, -1, STREAMER_PICKUP_SD, -1, 0);
		    }

			format(sss, 1000, "\
			\
			{00ffff}%s [%d]\n\
			{E6E6FA}Esta empresa esta a Venda !\n\
			{E6E6FA}Valor: {4169E1}R$ %s\n\
			\n\
			{a1a1a1}Aperte {ffffff}F {a1a1a1}para\n\
			Comprar", Empresa[i][em_Nome], i, ConvertMoney(Empresa[i][em_Valor]));
		}
		if(Empresa[i][em_MapaID] != -1) Empresa[i][em_Mapa] = CreateDynamicMapIcon(Empresa[i][em_X], Empresa[i][em_Y], Empresa[i][em_Z], Empresa[i][em_MapaID], 0xffffffff, -1, -1, -1, STREAMER_MAP_ICON_SD, MAPICON_LOCAL, -1, 0);
		Empresa[i][em_3D1] = CreateDynamic3DTextLabel( sss, 0xffffff90, Empresa[i][em_X], Empresa[i][em_Y], Empresa[i][em_Z], 5, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, -1, -1, -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );

        if(Empresa[i][em_Tipo] == 1)
		{
			Empresa[i][em_Pickup1] = CreateDynamicPickup(19523, 1, Empresa[i][em_X], Empresa[i][em_Y], Empresa[i][em_Z], -1, -1, -1, STREAMER_PICKUP_SD, -1, 0);
            Empresa[i][em_Pickup2] = CreateDynamicPickup(19300, 1, Empresa[i][em_X2], Empresa[i][em_Y2], Empresa[i][em_Z2], -1, -1, -1, STREAMER_PICKUP_SD, -1, 0);
			Empresa[i][em_Pickup3] = CreateDynamicPickup(19300, 1, Empresa[i][em_X1], Empresa[i][em_Y1], Empresa[i][em_Z1], -1, -1, -1, STREAMER_PICKUP_SD, -1, 0);
			Empresa[i][em_Pickup4] = CreateDynamicPickup(19133, 1, Empresa[i][em_X3], Empresa[i][em_Y3], Empresa[i][em_Z3], -1, -1, -1, STREAMER_PICKUP_SD, -1, 0);
            Empresa[i][em_3D2] = CreateDynamic3DTextLabel( "{ffff00}COFRE\n{a1a1a1}Aperte {ffffff}F {a1a1a1}para\nentrar", 0xffffff90, Empresa[i][em_X3], Empresa[i][em_Y3], Empresa[i][em_Z3], 5, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, -1, -1, -1, 5, -1, 0 );
		}
	}
}

