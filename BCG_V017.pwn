										SetPVarInt(i, "salvando", playerid);
										SetPlayerToFacePos(playerid, p[0], p[1]);
										new tempo = 200;
										Acao(playerid, 20, tempo, "APLICANDO TRATAMENTO", 1, "BD_FIRE", "WASH_UP", true);
										return 1;
