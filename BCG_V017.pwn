stock lista_de_acessorios(playerid, con)
{

	new c = id[playerid];
	if(c != -1)
	{

	 	// bones //
		if(con == 0)
		{
	        new cont;
			menu_id[playerid] = MENU_BONES;
			escolhendo_menu[playerid] = 0;
			format(nome_menu[playerid], 100, "Menu de Bones");
			format(botao_menu[playerid], 100, "COMPRAR");
			for(new i; i<sizeof(Acessorios_Info); i++)
			{
			    if(cont < MAX_MENU)
				{
				if(Acessorios_Info[i][acessorio_Tipo] == TOYS_TYPE_BONE)
				{
					    Menu[playerid][cont][menu_ID] = 55;
					    Menu[playerid][cont][menu_Unidades] = 1;
					    Menu[playerid][cont][menu_Tipo] = i;
					    format(Menu[playerid][cont][menu_Nome], 200, "%d - %s", cont, Acessorios_Info[i][acessorio_Nome]);
					    format(Menu[playerid][cont][menu_Info], 200, "~w~%s~n~~g~R$ %s", Acessorios_Info[i][acessorio_Nome], ConvertMoney(Acessorios_Info[i][acessorio_Valor]));
					    Menu[playerid][cont][menu_Valor] = Acessorios_Info[i][acessorio_Valor];
					    Menu[playerid][cont][menu_Modelo] = Acessorios_Info[i][acessorio_Modelo];
					    cont ++;
				    }
			    }
			}
			max_menu[playerid] = cont;
			mostrar_menu(playerid, menu_id[playerid]);
		}

		// oculos //
		if(con == 1)
		{
	        new cont;
			menu_id[playerid] = MENU_OCULOS;
			escolhendo_menu[playerid] = 0;
			format(nome_menu[playerid], 100, "Menu de Oculos");
			format(botao_menu[playerid], 100, "COMPRAR");
			for(new i; i<sizeof(Acessorios_Info); i++)
			{
			    if(cont < MAX_MENU)
				{
				if(Acessorios_Info[i][acessorio_Tipo] == TOYS_TYPE_GLASSES)
				{
					    Menu[playerid][cont][menu_ID] = 55;
					    Menu[playerid][cont][menu_Unidades] = 1;
					    Menu[playerid][cont][menu_Tipo] = i;
					    format(Menu[playerid][cont][menu_Nome], 200, "%d - %s", cont, Acessorios_Info[i][acessorio_Nome]);
					    format(Menu[playerid][cont][menu_Info], 200, "~w~%s~n~~g~R$ %s", Acessorios_Info[i][acessorio_Nome], ConvertMoney(Acessorios_Info[i][acessorio_Valor]));
					    Menu[playerid][cont][menu_Valor] = Acessorios_Info[i][acessorio_Valor];
					    Menu[playerid][cont][menu_Modelo] = Acessorios_Info[i][acessorio_Modelo];
					    cont ++;
				    }
			    }
			}
			max_menu[playerid] = cont;
			mostrar_menu(playerid, menu_id[playerid]);
		}

	    // relogios //
		if(con == 2)
		{
	        new cont;
			menu_id[playerid] = MENU_RELOGIOS;
			escolhendo_menu[playerid] = 0;
			format(nome_menu[playerid], 100, "Menu de Relogios");
			format(botao_menu[playerid], 100, "COMPRAR");
			for(new i; i<sizeof(Acessorios_Info); i++)
			{
			    if(cont < MAX_MENU)
				{
				if(Acessorios_Info[i][acessorio_Tipo] == TOYS_TYPE_RELOGIO)
				{
					    Menu[playerid][cont][menu_ID] = 55;
					    Menu[playerid][cont][menu_Unidades] = 1;
					    Menu[playerid][cont][menu_Tipo] = i;
					    format(Menu[playerid][cont][menu_Nome], 200, "%d - %s", cont, Acessorios_Info[i][acessorio_Nome]);
					    format(Menu[playerid][cont][menu_Info], 200, "~w~%s~n~~g~R$ %s", Acessorios_Info[i][acessorio_Nome], ConvertMoney(Acessorios_Info[i][acessorio_Valor]));
					    Menu[playerid][cont][menu_Valor] = Acessorios_Info[i][acessorio_Valor];
					    Menu[playerid][cont][menu_Modelo] = Acessorios_Info[i][acessorio_Modelo];
					    cont ++;
				    }
			    }
			}
			max_menu[playerid] = cont;
			mostrar_menu(playerid, menu_id[playerid]);
		}

		// chapeus //
		if(con == 3)
		{
	        new cont;
			menu_id[playerid] = MENU_CHAPEUS;
			escolhendo_menu[playerid] = 0;
			format(nome_menu[playerid], 100, "Menu de Relogios");
			format(botao_menu[playerid], 100, "COMPRAR");
			for(new i; i<sizeof(Acessorios_Info); i++)
			{
			    if(cont < MAX_MENU)
				{
				if(Acessorios_Info[i][acessorio_Tipo] == TOYS_TYPE_CHAPEU)
				{
					    Menu[playerid][cont][menu_ID] = 55;
					    Menu[playerid][cont][menu_Unidades] = 1;
					    Menu[playerid][cont][menu_Tipo] = i;
					    format(Menu[playerid][cont][menu_Nome], 200, "%d - %s", cont, Acessorios_Info[i][acessorio_Nome]);
					    format(Menu[playerid][cont][menu_Info], 200, "~w~%s~n~~g~R$ %s", Acessorios_Info[i][acessorio_Nome], ConvertMoney(Acessorios_Info[i][acessorio_Valor]));
					    Menu[playerid][cont][menu_Valor] = Acessorios_Info[i][acessorio_Valor];
					    Menu[playerid][cont][menu_Modelo] = Acessorios_Info[i][acessorio_Modelo];
					    cont ++;
				    }
			    }
			}
			max_menu[playerid] = cont;
			mostrar_menu(playerid, menu_id[playerid]);
		}

		// bandanas //
		if(con == 4)
		{
	        new cont;
			menu_id[playerid] = MENU_BANDANAS;
			escolhendo_menu[playerid] = 0;
			format(nome_menu[playerid], 100, "Menu de bandanas");
			format(botao_menu[playerid], 100, "COMPRAR");
			for(new i; i<sizeof(Acessorios_Info); i++)
			{
			    if(cont < MAX_MENU)
				{
				if(Acessorios_Info[i][acessorio_Tipo] == TOYS_TYPE_BANDANA)
				{
					    Menu[playerid][cont][menu_ID] = 55;
					    Menu[playerid][cont][menu_Unidades] = 1;
					    Menu[playerid][cont][menu_Tipo] = i;
					    format(Menu[playerid][cont][menu_Nome], 200, "%d - %s", cont, Acessorios_Info[i][acessorio_Nome]);
					    format(Menu[playerid][cont][menu_Info], 200, "~w~%s~n~~g~R$ %s", Acessorios_Info[i][acessorio_Nome], ConvertMoney(Acessorios_Info[i][acessorio_Valor]));
					    Menu[playerid][cont][menu_Valor] = Acessorios_Info[i][acessorio_Valor];
					    Menu[playerid][cont][menu_Modelo] = Acessorios_Info[i][acessorio_Modelo];
					    cont ++;
				    }
			    }
			}
			max_menu[playerid] = cont;
			mostrar_menu(playerid, menu_id[playerid]);
		}
	}
}

stock mostrar_dialog_acessorios(playerid)
{
	ShowPlayerDialog(playerid, DIALOG_COMPRAR_ACESSORIOS, DIALOG_STYLE_LIST, "Listas de Acessorios", "{ffffff}\
	Bones\n\
	Oculos\n\
	Relogios\n\
	Chapeus\n\
	Bandanas\n", "Abrir", "Cancelar");
}

BCG:: carregar_caixas_eletronicos()
{
	new cont;
	new file[80];
	for(new i; i<MAX_CAIXAS_ELETRONICOS; i++)
	{
	    CaixaEletronico[i][ce_3D] = DynamicText3D:-1;
	    format(file, 80, "CaixasEletronicos/ce_%d.txt", i);
	    if(DOF2_FileExists(file))
	    {
			CaixaEletronico[i][ce_Existe] = 1;
			CaixaEletronico[i][ce_Dinheiro] = DOF2_GetInt(file, "ce_Dinheiro");
			CaixaEletronico[i][cec_X] = DOF2_GetFloat(file, "cec_X");
			CaixaEletronico[i][cec_Y] = DOF2_GetFloat(file, "cec_Y");
			CaixaEletronico[i][cec_Z] = DOF2_GetFloat(file, "cec_Z");
			CaixaEletronico[i][cec_RX] = DOF2_GetFloat(file, "cec_RX");
			CaixaEletronico[i][cec_RY] = DOF2_GetFloat(file, "cec_RY");
			CaixaEletronico[i][cec_RZ] = DOF2_GetFloat(file, "cec_RZ");
			CaixaEletronico[i][ce_X] = DOF2_GetFloat(file, "ce_X");
			CaixaEletronico[i][ce_Y] = DOF2_GetFloat(file, "ce_Y");
			CaixaEletronico[i][ce_Z] = DOF2_GetFloat(file, "ce_Z");
			CaixaEletronico[i][ce_RX] = DOF2_GetFloat(file, "ce_RX");
			CaixaEletronico[i][ce_RY] = DOF2_GetFloat(file, "ce_RY");
			CaixaEletronico[i][ce_RZ] = DOF2_GetFloat(file, "ce_RZ");
			CaixaEletronico[i][ce_Roubo] = DOF2_GetInt(file, "ce_Roubo");
			CaixaEletronico[i][ce_Mundo] = DOF2_GetInt(file, "ce_Mundo");
			CaixaEletronico[i][ce_Interior] = DOF2_GetInt(file, "ce_Interior");
			CaixaEletronico[i][ce_Quebrado] = DOF2_GetInt(file, "ce_Quebrado");
			CaixaEletronico[i][cec_Quebrado] = DOF2_GetInt(file, "cec_Quebrado");
			CaixaEletronico[i][cec_Vida] = DOF2_GetInt(file, "cec_Vida");
			/*CaixaEletronico[i][ce_TempoFogo] = DOF2_GetInt(file, "ce_TempoFogo");
			CaixaEletronico[i][cec_TempoFogo] = DOF2_GetInt(file, "cec_TempoFogo");*/
			CaixaEletronico[i][ce_Cidade] = DOF2_GetInt(file, "ce_Cidade");
			if(CaixaEletronico[i][ce_Dinheiro] > 100000) CaixaEletronico[i][ce_Dinheiro] = 100000;
			KillTimer(CaixaEletronico[i][ce_Timer]);
			cont ++;
			atualizar_caixa_eletronico(i);
		}
	}
    printf("** %d Caixas Eletronicos carregados.", cont);
}

stock salvar_caixa_eletronico(i)
{
	new file[80];
    format(file, 80, "CaixasEletronicos/ce_%d.txt", i);
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
    if(CaixaEletronico[i][ce_Existe] == 1)
    {
		DOF2_CreateFile(file);
		DOF2_SetInt(file, "ce_Dinheiro", CaixaEletronico[i][ce_Dinheiro]);
		DOF2_SetInt(file, "ce_Cidade", CaixaEletronico[i][ce_Cidade]);
		DOF2_SetFloat(file, "ce_X", CaixaEletronico[i][ce_X]);
	    DOF2_SetFloat(file, "ce_Y",	CaixaEletronico[i][ce_Y]);
		DOF2_SetFloat(file, "ce_Z", CaixaEletronico[i][ce_Z]);
		DOF2_SetFloat(file, "ce_RX", CaixaEletronico[i][ce_RX]);
		DOF2_SetFloat(file, "ce_RY", CaixaEletronico[i][ce_RY] );
		DOF2_SetFloat(file, "ce_RZ",CaixaEletronico[i][ce_RZ] );
		DOF2_SetFloat(file, "cec_X", CaixaEletronico[i][cec_X]);
	    DOF2_SetFloat(file, "cec_Y", CaixaEletronico[i][cec_Y]);
		DOF2_SetFloat(file, "cec_Z", CaixaEletronico[i][cec_Z]);
		DOF2_SetFloat(file, "cec_RX", CaixaEletronico[i][cec_RX]);
		DOF2_SetFloat(file, "cec_RY", CaixaEletronico[i][cec_RY] );
		DOF2_SetFloat(file, "cec_RZ", CaixaEletronico[i][cec_RZ] );
		DOF2_SetInt(file, "ce_Roubo", CaixaEletronico[i][ce_Roubo]);
		DOF2_SetInt(file, "ce_Mundo", CaixaEletronico[i][ce_Mundo]);
		DOF2_SetInt(file, "ce_Interior", CaixaEletronico[i][ce_Interior]);
		DOF2_SetInt(file, "ce_Quebrado",CaixaEletronico[i][ce_Quebrado]);
		DOF2_SetInt(file, "cec_Quebrado",CaixaEletronico[i][cec_Quebrado]);
		DOF2_SetInt(file, "cec_Vida",CaixaEletronico[i][cec_Vida]);
		/*DOF2_SetInt(file, "ce_TempoFogo",CaixaEletronico[i][ce_TempoFogo]);
		DOF2_SetInt(file, "cec_TempoFogo",CaixaEletronico[i][cec_TempoFogo]);*/
		DOF2_SaveFile();
	}
}

stock texto_caixa_eletronico(i)
{
    if(IsValidDynamic3DTextLabel(CaixaEletronico[i][ce_3D])) DestroyDynamic3DTextLabel(CaixaEletronico[i][ce_3D]);
    CaixaEletronico[i][ce_3D] = DynamicText3D:-1;
	if(CaixaEletronico[i][ce_Existe] == 1)
	{
    	new sss[300];
    	if(!caixa_com_explosivo(i))
    	{
	        if(CaixaEletronico[i][ce_Quebrado] == 0) format(sss, 300, "{00ffff}Caixa Eletronico [%d]\n{ffffff}Dinheiro: {4169E1}R$ %s\n\n{a1a1a1}Aperte {ffffff}F {a1a1a1}para\nusar", i, ConvertMoney(CaixaEletronico[i][ce_Dinheiro]) );
			else format(sss, 300, "{00ffff}Caixa Eletronico [%d]\n\n{ff0000}QUEBRADO", i );
			CaixaEletronico[i][ce_3D] = CreateDynamic3DTextLabel(sss, 0xffffff99, CaixaEletronico[i][ce_X], CaixaEletronico[i][ce_Y], CaixaEletronico[i][ce_Z]+1, 15, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0,  CaixaEletronico[i][ce_Mundo], CaixaEletronico[i][ce_Interior], -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
		}
	}
}

stock atualizar_caixa_eletronico(i, con=0)
{
	Iter_Remove(Iter_CaixasEletronicos, i);
    if(CaixaEletronico[i][ce_Existe] == 1) Iter_Add(Iter_CaixasEletronicos, i);
    if(con == 2)
	{
	    if(IsValidDynamicObject(CaixaEletronico[i][ce_Obj])) DestroyDynamicObject_(CaixaEletronico[i][ce_Obj]);
	    //if(IsValidDynamicObject(CaixaEletronico[i][ce_Fogo])) DestroyDynamicObject_(CaixaEletronico[i][ce_Fogo]);
	    if(CaixaEletronico[i][ce_Quebrado] == 0)
		{
		    CaixaEletronico[i][ce_Obj] = CreateDynamicObject(19526, CaixaEletronico[i][ce_X], CaixaEletronico[i][ce_Y], CaixaEletronico[i][ce_Z], CaixaEletronico[i][ce_RX], CaixaEletronico[i][ce_RY], CaixaEletronico[i][ce_RZ], CaixaEletronico[i][ce_Mundo], CaixaEletronico[i][ce_Interior], -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
			SetDynamicObjectMaterial(CaixaEletronico[i][ce_Obj], 0, 19267, "mapmarkers", "samporange", 0x00000000);
			SetDynamicObjectMaterial(CaixaEletronico[i][ce_Obj], 5, 19775, "matcopstuff", "fbi_id_card", 0x00000000);
			SetDynamicObjectMaterialText(CaixaEletronico[i][ce_Obj], 3, "Itau", 130, "Segoe UI", 199, 1, 0xFFEBFC03, 0xFF0352FC, 1);
		}
		else
		{
			CaixaEletronico[i][ce_Obj] = CreateDynamicObject( 2943, CaixaEletronico[i][ce_X], CaixaEletronico[i][ce_Y], CaixaEletronico[i][ce_Z]+0.56, CaixaEletronico[i][ce_RX], CaixaEletronico[i][ce_RY], CaixaEletronico[i][ce_RZ], CaixaEletronico[i][ce_Mundo], CaixaEletronico[i][ce_Interior], -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
        	//if(CaixaEletronico[i][ce_TempoFogo] > 0) CaixaEletronico[i][ce_Fogo] = CreateDynamicObject( 18688, CaixaEletronico[i][ce_X], CaixaEletronico[i][ce_Y], CaixaEletronico[i][ce_Z]-1, 0, 0, 0, CaixaEletronico[i][ce_Mundo], CaixaEletronico[i][ce_Interior], -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
        }
		texto_caixa_eletronico(i);
	}
	else if(con == 1)
	{
	    if(IsValidDynamicObject(CaixaEletronico[i][cec_Obj2])) DestroyDynamicObject_(CaixaEletronico[i][cec_Obj2]);
		CaixaEletronico[i][cec_Obj2] = CreateDynamicObject( 18703, CaixaEletronico[i][cec_X], CaixaEletronico[i][cec_Y], CaixaEletronico[i][cec_Z]-1.15, 0, 0, 0, CaixaEletronico[i][ce_Mundo], CaixaEletronico[i][ce_Interior], -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
	}
	else
	{
		if(IsValidDynamicObject(CaixaEletronico[i][cec_Obj2])) DestroyDynamicObject_(CaixaEletronico[i][cec_Obj2]);
		if(IsValidDynamicObject(CaixaEletronico[i][cec_Obj])) DestroyDynamicObject_(CaixaEletronico[i][cec_Obj]);
		if(IsValidDynamicObject(CaixaEletronico[i][ce_Obj])) DestroyDynamicObject_(CaixaEletronico[i][ce_Obj]);
		//if(IsValidDynamicObject(CaixaEletronico[i][ce_Fogo])) DestroyDynamicObject_(CaixaEletronico[i][ce_Fogo]);
		if(CaixaEletronico[i][ce_Existe] == 1)
		{
	        new Float:distt;
		    GetDistance(distt, CaixaEletronico[i][ce_X], CaixaEletronico[i][ce_Y], CaixaEletronico[i][ce_Z],  CaixaEletronico[i][cec_X], CaixaEletronico[i][cec_Y], CaixaEletronico[i][cec_Z]);
		    if(distt > 50)
		    {
		        CaixaEletronico[i][cec_X] = CaixaEletronico[i][ce_X];
		        CaixaEletronico[i][cec_Y] = CaixaEletronico[i][ce_Y];
		        CaixaEletronico[i][cec_Z] = CaixaEletronico[i][ce_Z]+2.5;
		        salvar_caixa_eletronico(i);
		    }
		    if(CaixaEletronico[i][ce_Quebrado] == 0)
			{
			    CaixaEletronico[i][ce_Obj] = CreateDynamicObject(19526, CaixaEletronico[i][ce_X], CaixaEletronico[i][ce_Y], CaixaEletronico[i][ce_Z], CaixaEletronico[i][ce_RX], CaixaEletronico[i][ce_RY], CaixaEletronico[i][ce_RZ], CaixaEletronico[i][ce_Mundo], CaixaEletronico[i][ce_Interior], -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
				SetDynamicObjectMaterial(CaixaEletronico[i][ce_Obj], 0, 19267, "mapmarkers", "samporange", 0x00000000);
				SetDynamicObjectMaterial(CaixaEletronico[i][ce_Obj], 5, 19775, "matcopstuff", "fbi_id_card", 0x00000000);
				SetDynamicObjectMaterialText(CaixaEletronico[i][ce_Obj], 3, "Itau", 130, "Segoe UI", 199, 1, 0xFFEBFC03, 0xFF0352FC, 1);
			}
			else
			{
				//if(CaixaEletronico[i][ce_TempoFogo] > 0) CaixaEletronico[i][ce_Fogo] = CreateDynamicObject( 18688, CaixaEletronico[i][ce_X], CaixaEletronico[i][ce_Y], CaixaEletronico[i][ce_Z]-1, 0, 0, 0, CaixaEletronico[i][ce_Mundo], CaixaEletronico[i][ce_Interior], -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
				CaixaEletronico[i][ce_Obj] = CreateDynamicObject( 2943, CaixaEletronico[i][ce_X], CaixaEletronico[i][ce_Y], CaixaEletronico[i][ce_Z]+0.56, CaixaEletronico[i][ce_RX], CaixaEletronico[i][ce_RY], CaixaEletronico[i][ce_RZ], CaixaEletronico[i][ce_Mundo], CaixaEletronico[i][ce_Interior], -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
	        }
			CaixaEletronico[i][cec_Obj] = CreateDynamicObject( 1616, CaixaEletronico[i][cec_X], CaixaEletronico[i][cec_Y], CaixaEletronico[i][cec_Z], CaixaEletronico[i][cec_RX], CaixaEletronico[i][cec_RY], CaixaEletronico[i][cec_RZ], CaixaEletronico[i][ce_Mundo], CaixaEletronico[i][ce_Interior], -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
			if(CaixaEletronico[i][cec_Quebrado] == 0)
			{
				foreach(new a:Player)
				{
				    if(Online(a))
					{
					if(olhando_camera[a] == 1)
					{
					    if(olhando_camera_id[a] == i)
						{
		             			ver_camera(a, i);
					    }
					}
				    }
				}
			}
			else
			{
			    CaixaEletronico[i][cec_Obj2] = CreateDynamicObject( 18703, CaixaEletronico[i][cec_X], CaixaEletronico[i][cec_Y], CaixaEletronico[i][cec_Z]-1.15, 0, 0, 0, CaixaEletronico[i][ce_Mundo], CaixaEletronico[i][ce_Interior], -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
			    foreach(new a:Player)
				{
				    if(Online(a))
					{
					if(olhando_camera[a] == 1)
					{
					    if(olhando_camera_id[a] == i)
						{
		             			sair_camera(a);
					    }
					}
				    }
				}
			}
		}
		else
		{
		    foreach(new aa:Player)
			{
			    if(Online(aa))
				{
				if(olhando_camera[aa] == 1)
				{
				    if(olhando_camera_id[aa] == i)
					{
	             			sair_camera(aa);
				    }
				}
			    }
			}
		}
		texto_caixa_eletronico(i);
	}
}

stock destruir_caixa_eletronico(i)
{
    if(CaixaEletronico[i][ce_Existe] == 1)
    {
        CaixaEletronico[i][ce_Existe] = 0;
        salvar_caixa_eletronico(i);
        atualizar_caixa_eletronico(i);
    }
}

stock CriarCaixaEletronico( Float:xxx, Float:yyy, Float:zzz, inte, mun, din)
{
	for(new i; i<MAX_CAIXAS_ELETRONICOS; i++)
	{
		if(CaixaEletronico[i][ce_Existe] == 0)
		{
		    CaixaEletronico[i][ce_Existe] = 1;
		    CaixaEletronico[i][ce_Dinheiro] = din;
		    CaixaEletronico[i][ce_Mundo] = mun;
		    CaixaEletronico[i][ce_Interior] = inte;
		    CaixaEletronico[i][ce_Quebrado] = 0;
		    CaixaEletronico[i][cec_Quebrado] = 0;
		    CaixaEletronico[i][cec_Vida] = 100;
		   //CaixaEletronico[i][ce_TempoFogo] = 0;
		    //CaixaEletronico[i][cec_TempoFogo] = 0;
		    CaixaEletronico[i][ce_Roubo] = 0;
		    CaixaEletronico[i][ce_X] = xxx;
		    CaixaEletronico[i][ce_Y] = yyy;
		    CaixaEletronico[i][ce_Z] = zzz;
		    CaixaEletronico[i][cec_X] = xxx;
		    CaixaEletronico[i][cec_Y] = yyy;
		    CaixaEletronico[i][cec_Z] = zzz+2.5;
		    CaixaEletronico[i][ce_RX] = 0;
		    CaixaEletronico[i][ce_RY] = 0;
		    CaixaEletronico[i][ce_RZ] = 0;
		    CaixaEletronico[i][cec_RX] = 0;
		    CaixaEletronico[i][cec_RY] = 0;
		    CaixaEletronico[i][cec_RZ] = 0;
		    KillTimer(CaixaEletronico[i][ce_Timer]);
		    atualizar_caixa_eletronico(i);
		    salvar_caixa_eletronico(i);
		    return i;
		}
	}
	return -1;
}


stock zerar_cf(playerid)
{
    CF_Etapa[playerid] = 0;
    CF_Progresso[playerid] = 0;
    CF_Distancia[playerid] = 0;
    CF_Cidade[playerid] = -1;
}

stock iniciar_carro_forte(playerid)
{
	if(GetPVarInt(playerid, "flood_cf") > gettime())  ms(playerid, 0, "Voce so pode iniciar o trabalho a cada 3 minutos !");
	else
	{
		SetPVarInt(playerid, "flood_cf", gettime() + 180);
	    zerar_cf(playerid);
		CF_Cidade[playerid] = random(3);
		new c = CF_Cidade[playerid];
		new sss[300];
		format(sss, 300, "Diriga o carro forte ate o banco de %s.", cidade(CF_Cidade[playerid]));
		ms(playerid, 2, sss);
		Localizar_Player(playerid, bancos[c][0][0],bancos[c][0][1],bancos[c][0][2], 50, -1, "BANCO ITAU");
	}
}

stock pegar_malote(playerid)
{
	if(EmpregoPlayer(playerid) == 6)
	{
	    if(GetPVarInt(playerid, "flood_malote") > gettime())  ms(playerid, 0, "Voce so pode pegar 1 malote a cada 15 segundos, aguarde.");
	    else
		{
			if(segurando_player[playerid] == -1)
		    {
		        segurar(playerid, 4, 1);
	 			SetPVarInt(playerid, "flood_malote", gettime()+15);
	 			ms(playerid, 1, "Voce pegou um malote, leve ate a traseira do veiculo e aperte H para guardalo.");
		    }
	    }
	}
	else ms(playerid, 0, "Voce nao pertence a este emprego !");
}


stock procurar_caixa_eletronico(playerid)
{
	new cont;
	new caixas[MAX_CAIXAS_ELETRONICOS];
	foreach(new i:Iter_CaixasEletronicos)
	{
	    if(CaixaEletronico[i][ce_Existe] == 1)
	    {
	        if(CaixaEletronico[i][ce_Quebrado] == 0)
	    	{
	    		if(CaixaEletronico[i][ce_Mundo] == 0 && CaixaEletronico[i][ce_Interior] == 0)
	    		{
	    			if(CaixaEletronico[i][ce_Cidade] == CF_Cidade[playerid])
		    		{
			    	    caixas[cont] = i;
			    	    cont ++;
		    	    }
	    	    }
	        }
	    }
	}

	if(cont == 0)
	{
	    ms(playerid, 0, "Nenhum caixa eletronico foi encontrado, volte para a HQ do emprego !");
	    zerar_cf(playerid);
	}
	else
	{
		new rand = random(cont);
		Localizar_Player(playerid, CaixaEletronico[caixas[rand]][ce_X],CaixaEletronico[caixas[rand]][ce_Y], CaixaEletronico[caixas[rand]][ce_Z], 52, -1, "CAIXA ELETRONICO");
		ms(playerid, 2, "Siga ate o local de entrega e deixe um malote no caixa eletronico.");
		SetPVarInt(playerid, "id_caixa_e", caixas[rand]);
		CF_Etapa[playerid] = 3;
	}
}

stock cidade_casa(i)
{
    new cid = random(3);
	if(i != -1) cid = pegar_cidade(-1, Casa[i][casa_X1], Casa[i][casa_Y1], Casa[i][casa_Z1]);
	return cid;
}

stock cidade_empresa(i)
{
    new cid = random(3);
	if(i != -1) cid = pegar_cidade(-1, Empresa[i][em_X], Empresa[i][em_Y], Empresa[i][em_Z]);
	return cid;
}

stock pegar_cidade(playerid, Float:xx=0.0, Float:yy=0.0, Float:zz=0.0)
{
	new cid = random(3);
	if(IsPlayerConnected(playerid))
	{
	    if(IsPlayerInAnyVehicle(playerid))
	    {
	        GetVehiclePos(GetPlayerVehicleID(playerid), xx, yy, zz);
	        new Float:dis;
		    GetDistance(dis, xx, yy, zz, 1595.6250,-1383.3032,28.5859);
		    if(dis < 2000.0) return 0;
		    GetDistance(dis, xx, yy, zz, -1894.0000,930.5249,35.0156);
		    if(dis < 2000.0) return 1;
		    GetDistance(dis, xx, yy, zz, 1235.6665,1906.5494,6.8378);
		    if(dis < 2000.0) return 2;
	    }
	    else
	    {
		    if(IsPlayerInRangeOfPoint(playerid, 2000.0, 1595.6250,-1383.3032,28.5859)) return 0;
			else if(IsPlayerInRangeOfPoint(playerid, 2000.0, -1894.0000,930.5249,35.0156)) return 1;
			else if(IsPlayerInRangeOfPoint(playerid, 2000.0, 1235.6665,1906.5494,6.8378)) return 2;
			else return cid;
		}
	}
	else
	{
	    new Float:dis;
	    GetDistance(dis, xx, yy, zz, 1595.6250,-1383.3032,28.5859);
	    if(dis < 2000.0) return 0;
	    GetDistance(dis, xx, yy, zz, -1894.0000,930.5249,35.0156);
	    if(dis < 2000.0) return 1;
	    GetDistance(dis, xx, yy, zz, 1235.6665,1906.5494,6.8378);
	    if(dis < 2000.0) return 2;
	}
	return cid;
}

stock caixas_eletronicos()
{
	new cont;
	foreach(new i:Iter_CaixasEletronicos)
	{
	    if(CaixaEletronico[i][ce_Existe] == 1) cont ++;
	}
	return cont;
}

stock mostrar_nota(playerid, player)
{
	new i = NotaPlayer(playerid);
	if(i != -1)
	{
		new sss[1500];
		format(sss, 1500, "\n\
		{00ffff}ENTREGA DE MERCADORIAS\n\
		\n\
		{ffffff}Motorista: {a1a1a1}%s\n\
		{ffffff}Mercadoria: {ffff00}%s\n\
		{ffffff}Quantidade: {4169E1}%d\n\
		\n\
		{ffffff}Cidade: {00ffff}%s\n\
		{ffffff}Destino: {a1a1a1}%s\n\
		\n\
		{ffffff}[ COMPROVANTE FISCAL ]\n",
		Nome(playerid), entregas[i][ec_Mercadoria], entregas[i][ec_Quantidade], cidade(entregas[i][ec_Cidade]), entregas[i][ec_Destino]);
		ShowPlayerDialog(player, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}_", sss, "Ok", "Informado");
	}
}

stock nota(playerid)
{
    ShowPlayerDialog(playerid, DIALOG_NOTA, DIALOG_STYLE_LIST, "Nota Fiscal", "Ver\nMostrar\nRasgar", "Continuar", "Fechar");
}

stock unidades_mercadoria(mm)
{
	new unis = 0;
	if(mm == 1) unis = 2;
	if(mm == 2) unis = 1;
	if(mm == 3) unis = 4;
	if(mm == 4) unis = 3;
	return unis;
}

stock nome_mercadoria(mm)
{
	new nam[40];
	format(nam, 40, "Nenhuma");
	if(mm == 1) format(nam, 40, "Entrega da Sedex");
	if(mm == 2) format(nam, 40, "Barrils de Oleo");
	if(mm == 3) format(nam, 40, "Botijoes de Gas");
	if(mm == 4) format(nam, 40, "Pecas de Veiculo");
	return nam;
}

stock iniciar_entrega(playerid, e)
{

	new sss[300];
	ms(playerid, 1, "Voce ja pode fazer a entrega da mercadoria !");
	new Float:distf, Float:pos[3];
	GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
	GetDistance(distf, pos[0], pos[1], pos[2], entregas[e][ec_X], entregas[e][ec_Y], entregas[e][ec_Z]);
	SetPVarInt(playerid, "distancia_entrega", floatround(distf));
	GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
	format(sss, 300, "Destino: %s localizado em %s, Distancia: %.0f Metros", entregas[e][ec_Destino], cidade(entregas[e][ec_Cidade]), distf );
	ms(playerid, 2, sss);
	Localizar_Player(playerid, entregas[e][ec_X], entregas[e][ec_Y], entregas[e][ec_Z], 60, e, entregas[e][ec_Destino]);
}

stock finalizar_entrega(playerid, car, i, e)
{
	new distf = GetPVarInt(playerid, "distancia_entrega");
	emp_veiculo[i] = 0;
	emp_m_veiculo[i] = 0;
	DarGrana(playerid, VALOR_ENTREGA);
	DarGrana(playerid, distf/3);
	veiculo_acessorios(car);
	new sss[300];
	ms(playerid, 1, "Entrega Concluida !");
	format(sss, 300, "Mercadoria: %s - Local: %s (%s) - Quantidade: %d", entregas[e][ec_Mercadoria], entregas[e][ec_Destino], cidade(entregas[e][ec_Cidade]), entregas[e][ec_Quantidade]);
	ms(playerid, 1, sss);
	format(sss, 300, "Voce recebeu R$ %s pela entrega, mais R$ %s pela distancia percorrida.", ConvertMoney(VALOR_ENTREGA), ConvertMoney(distf/2));
	ms(playerid, 1, sss);
	resetar_nota_player(playerid);
	MetaEmprego(playerid);
}

stock NotaPlayer(playerid)
{
	new c = id[playerid];
	if(c != -1)
	{
		if(Conta[playerid][c_Emprego] == 7)
		{
		    return Conta[playerid][c_Nota];
		}
	}
	return -1;
}

stock setar_nota_player(playerid, n)
{
	new c = id[playerid];
	if(c != -1)
	{
		if(Conta[playerid][c_Emprego] == 7)
		{
		    Conta[playerid][c_Nota] = n;
		    salvar_conta(c, 0, "c_Nota", sv_int(Conta[playerid][c_Nota]));
		}
	}
}

stock resetar_nota_player(playerid)
{
	new c = id[playerid];
	if(c != -1)
	{
		if(Conta[playerid][c_Emprego] == 7)
		{
		    Conta[playerid][c_Nota] = -1;
		    salvar_conta(c, 0, "c_Nota", sv_int(Conta[playerid][c_Nota]));
		}
	}
}

stock texto_lixeiro(i)
{
	if(IsValidDynamic3DTextLabel(Lixeiro[i][li_3D])) DestroyDynamic3DTextLabel(Lixeiro[i][li_3D]);
	Lixeiro[i][li_3D] = DynamicText3D:-1;
	if(Lixeiro[i][li_Existe] == 1)
	{
	    new sss[150];
	    format(sss, 150, "{ffff00}Lixeiro ID: %d\n{ffffff}Lixos: {00ffff}%d\n\n{a1a1a1}Aperte {ffffff}H {a1a1a1}para\nrecolher os lixos", i, Lixeiro[i][li_Lixos]);
    	Lixeiro[i][li_3D] = CreateDynamic3DTextLabel(sss, 0xffffff99, Lixeiro[i][li_X], Lixeiro[i][li_Y], Lixeiro[i][li_Z], 7, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0,  0, 0, -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
	}
}

stock RespawnLixos()
{
	foreach(new i:Iter_Lixeiros)
	{
	    if(Lixeiro[i][li_Existe] == 1)
		{
		    Lixeiro[i][li_Lixos] = 20;
		    salvar_lixeiro(i);
		    texto_lixeiro(i);
		}
	}
}

stock destruir_lixeiro(i)
{
    if(Lixeiro[i][li_Existe] == 1)
	{
	    Lixeiro[i][li_Existe] = 0;
	    atualizar_lixeiro(i);
	    salvar_lixeiro(i);
	}
}

stock atualizar_lixeiro(i)
{
	Iter_Remove(Iter_Lixeiros, i);
	if(IsValidDynamicObject(Lixeiro[i][li_Obj])) DestroyDynamicObject_(Lixeiro[i][li_Obj]);
	if(Lixeiro[i][li_Existe] == 1)
	{
	    Iter_Add(Iter_Lixeiros, i);
	    Lixeiro[i][li_Obj] = CreateDynamicObject( 1331, Lixeiro[i][li_X], Lixeiro[i][li_Y], Lixeiro[i][li_Z], Lixeiro[i][li_RX], Lixeiro[i][li_RY], Lixeiro[i][li_RZ], 0, 0, -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
	}
	texto_lixeiro(i);
}

stock salvar_lixeiro(i)
{
	new file[80];
    format(file, 80, "Lixeiros/Lixeiro_%d.txt", i);
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
    if(Lixeiro[i][li_Existe] == 1)
    {
        DOF2_CreateFile(file);
		DOF2_SetInt(file, "li_Cidade", Lixeiro[i][li_Cidade]);
		DOF2_SetInt(file, "li_Lixos", Lixeiro[i][li_Lixos]);
		DOF2_SetFloat(file, "li_X", Lixeiro[i][li_X]);
		DOF2_SetFloat(file, "li_Y", Lixeiro[i][li_Y]);
		DOF2_SetFloat(file, "li_Z", Lixeiro[i][li_Z]);
	    DOF2_SetFloat(file, "li_RX", Lixeiro[i][li_RX]);
	    DOF2_SetFloat(file, "li_RY", Lixeiro[i][li_RY]);
	    DOF2_SetFloat(file, "li_RZ", Lixeiro[i][li_RZ]);
		DOF2_SaveFile();
    }
}

BCG:: carregar_lixeiros()
{
	new cont;
	new file[80];
	for(new i; i<MAX_LIXEIROS; i++)
	{
	    Lixeiro[i][li_3D] = DynamicText3D:-1;
		format(file, 80, "Lixeiros/Lixeiro_%d.txt", i);
		if(DOF2_FileExists(file))
		{
		    Lixeiro[i][li_Existe] = 1;
		    Lixeiro[i][li_Cidade] = DOF2_GetInt(file, "li_Cidade");
		    Lixeiro[i][li_Lixos] = DOF2_GetInt(file, "li_Lixos");
		    Lixeiro[i][li_X] = DOF2_GetFloat(file, "li_X");
		    Lixeiro[i][li_Y] = DOF2_GetFloat(file, "li_Y");
		    Lixeiro[i][li_Z] = DOF2_GetFloat(file, "li_Z");
		    Lixeiro[i][li_RX] = DOF2_GetFloat(file, "li_RX");
		    Lixeiro[i][li_RY] = DOF2_GetFloat(file, "li_RY");
		    Lixeiro[i][li_RZ] = DOF2_GetFloat(file, "li_RZ");
		    atualizar_lixeiro(i);
		    cont ++;
		}
	}
	printf("** %d Lixeiros carregados.", cont);
}

stock criar_lixeiro(Float:xx, Float:yy, Float:zz, Float:rxx, Float:ryy, Float:rzz, lixos)
{
	for(new i; i<MAX_LIXEIROS; i++)
	{
	    if(Lixeiro[i][li_Existe] == 0)
	    {
	        Lixeiro[i][li_Existe] = 1;
		    Lixeiro[i][li_Cidade] = pegar_cidade(-1, xx, yy, zz);
		    Lixeiro[i][li_Lixos] = lixos;
		    Lixeiro[i][li_X] = xx;
		    Lixeiro[i][li_Y] = yy;
		    Lixeiro[i][li_Z] = zz;
		    Lixeiro[i][li_RX] = rxx;
		    Lixeiro[i][li_RY] = ryy;
		    Lixeiro[i][li_RZ] = rzz;
	        atualizar_lixeiro(i);
	        salvar_lixeiro(i);
	        return i;
		}
	}
	return -1;
}

stock descarregar_lixo(playerid, i)
{
	if(Online(playerid))
	{
	    MetaEmprego(playerid, lixo_veiculo[i]);
		new total = VALOR_LIXO*lixo_veiculo[i];
		DarGrana(playerid, total);
		new sss[150];
		format(sss, 150, "Voce recebeu R$ %s por coletar %d Lixos.", ConvertMoney(total), lixo_veiculo[i]);
		ms(playerid, 1, sss);
		lixo_veiculo[i] = 0;
		veiculo_acessorios(i);
	}
}

stock pegar_lixo(playerid, i)
{

	if(Lixeiro[i][li_Existe] == 1)
	{
		Lixeiro[i][li_Lixos] --;
		segurar(playerid, 5, 1);
		texto_lixeiro(i);
		ms(playerid, 1, "Voce pegou uma Sacola de Lixo do Lixeiro, aperte H atras do caminhao.");
		ApplyAnimation(playerid, "BD_FIRE", "WASH_UP", 4.1, false, false, false, false, 0, 1);
		SetPlayerToFacePos(playerid, Lixeiro[i][li_X], Lixeiro[i][li_Y]);
	    salvar_lixeiro(i);
	}
}

stock marcar_lixo(playerid, l)
{

	if(lixo_veiculo[l] >= 100)
	{
	    if(pegar_cidade(playerid) == 0) Localizar_Player(playerid, 2090.875488, -2013.935302, 13.546875, 59, -1, "DESCARREGAR LIXO");
	    if(pegar_cidade(playerid) == 1) Localizar_Player(playerid, 888.8919,1897.0768,10.8203, 59, -1, "DESCARREGAR LIXO");
	    if(pegar_cidade(playerid) == 2) Localizar_Player(playerid, -2129.0720,209.9054,35.2785, 59, -1, "DESCARREGAR LIXO");
	    ms(playerid, 2, "Este caminhao esta lotado de Lixo, leve-o pala a HQ do emprego para descarregar.");
	}
	else
	{

		new lis[MAX_LIXEIROS];
		new cont;
		foreach(new i:Iter_Lixeiros)
		{
		    if(Lixeiro[i][li_Existe] == 1)
		    {
		        if(Lixeiro[i][li_Lixos] > 0)
		        {
		            if(pegar_cidade(playerid) == Lixeiro[i][li_Cidade])
		            {
		            	lis[cont] = i;
		            	cont++;
		            }
		        }
		    }
		}

		if(cont == 0) ms(playerid, 0, "Nao ha lixos para ser coletado na cidade no momento, tente mais tarde !");
		else
		{
		    new ii = random(cont);
		    new iii = lis[ii];
	        Localizar_Player(playerid, Lixeiro[iii][li_X], Lixeiro[iii][li_Y], Lixeiro[iii][li_Z], 61, -1, "LIXEIRO");
	        ms(playerid, 1, "Um Lixeiro foi marcado em seu GPS, va ate o local para pegar os Lixos.");
		}
	}
}

BCG:: carregar_academias()
{
    new cont;
	new file[80];
	for(new i; i<MAX_ACADEMIA; i++)
	{
	    Academia[i][aca_3D] = DynamicText3D:-1;
	    Academia[i][aca_Player] = -1;
	    format(file, 80, "Academia/Aparelho_%d.txt", i);
	    if(DOF2_FileExists(file))
	    {
	        Academia[i][aca_Existe] = 1;
	        Academia[i][aca_Interior] = DOF2_GetInt(file, "aca_Interior");
	        Academia[i][aca_Mundo] = DOF2_GetInt(file, "aca_Mundo");
	        Academia[i][aca_Tipo] = DOF2_GetInt(file, "aca_Tipo");
	        Academia[i][aca_X] = DOF2_GetFloat(file, "aca_X");
	        Academia[i][aca_Y] = DOF2_GetFloat(file, "aca_Y");
	        Academia[i][aca_Z] = DOF2_GetFloat(file, "aca_Z");
	        Academia[i][aca_RX] = DOF2_GetFloat(file, "aca_RX");
	        Academia[i][aca_RY] = DOF2_GetFloat(file, "aca_RY");
	        Academia[i][aca_RZ] = DOF2_GetFloat(file, "aca_RZ");
	        atualizar_academia(i);
	    }
	}
	printf("** %d aparelhos de academia carregados.", cont);
}

stock destruir_academia(i)
{
    Academia[i][aca_Existe] = 0;
    atualizar_academia(i);
    salvar_academia(i);
}

stock salvar_academia(i)
{
    new file[80];
	format(file, 80, "Academia/Aparelho_%d.txt", i);
	if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
	if(Academia[i][aca_Existe] == 1)
	{
	    DOF2_CreateFile(file);
        DOF2_SetInt(file, "aca_Tipo", Academia[i][aca_Tipo]);
        DOF2_SetFloat(file, "aca_X", Academia[i][aca_X]);
        DOF2_SetFloat(file, "aca_Y", Academia[i][aca_Y]);
        DOF2_SetFloat(file, "aca_Z", Academia[i][aca_Z]);
        DOF2_SetFloat(file, "aca_RX", Academia[i][aca_RX]);
        DOF2_SetFloat(file, "aca_RY", Academia[i][aca_RY]);
        DOF2_SetFloat(file, "aca_RZ", Academia[i][aca_RZ]);
        DOF2_SetInt(file, "aca_Interior", Academia[i][aca_Interior]);
        DOF2_SetInt(file, "aca_Mundo", Academia[i][aca_Mundo]);
	    DOF2_SaveFile();
	}
}

stock atualizar_academia(i)
{
	Iter_Remove(Iter_Academias, i);
    if(IsValidDynamicObject(Academia[i][aca_Obj][0])) DestroyDynamicObject_(Academia[i][aca_Obj][0]);
    if(IsValidDynamicObject(Academia[i][aca_Obj][1])) DestroyDynamicObject_(Academia[i][aca_Obj][1]);
    if(IsValidDynamicObject(Academia[i][aca_Obj][2])) DestroyDynamicObject_(Academia[i][aca_Obj][2]);
	if(Academia[i][aca_Existe] == 1)
	{
	    // aparelhos com apenas 1 objeto //
 		Academia[i][aca_Obj][0] = CreateDynamicObject(academia_obj[Academia[i][aca_Tipo]], Academia[i][aca_X], Academia[i][aca_Y], Academia[i][aca_Z],   Academia[i][aca_RX], Academia[i][aca_RY], Academia[i][aca_RZ], Academia[i][aca_Mundo], Academia[i][aca_Interior]);
        Iter_Add(Iter_Academias, i);

        // alteres //
		if(Academia[i][aca_Tipo] == 2)
		{
			new Float:pos[4];
			pos[0] = Academia[i][aca_X], pos[1] = Academia[i][aca_Y], pos[2] = Academia[i][aca_Z], pos[3] = Academia[i][aca_RZ];
			pos[3] += 90.0;
			if(pos[3] > 360.0) pos[3] -= 360.0;
			PegarFrente(pos[0], pos[1], pos[3], 0.5);
			PegarFrente(pos[0], pos[1], pos[3]+90, 0.2);
		    Academia[i][aca_Obj][1] = CreateDynamicObject(3072, pos[0],  pos[1],  pos[2]+0.3,  0, 90,  pos[3], Academia[i][aca_Mundo], Academia[i][aca_Interior]);
		    PegarFrente(pos[0], pos[1], pos[3]+90, -(0.2*2));
		    Academia[i][aca_Obj][2] = CreateDynamicObject(3072, pos[0],  pos[1],  pos[2]+0.3,  0, 90,  pos[3], Academia[i][aca_Mundo], Academia[i][aca_Interior]);
		}


		// supino //
		if(Academia[i][aca_Tipo] == 3)
		{
			new Float:pos[4];
			pos[0] = Academia[i][aca_X], pos[1] = Academia[i][aca_Y], pos[2] = Academia[i][aca_Z], pos[3] = Academia[i][aca_RZ];
			PegarFrente(pos[0], pos[1], pos[3], 0.5);
			PegarFrente(pos[0], pos[1], pos[3]+90, 0.45);
			Academia[i][aca_Obj][1] = CreateDynamicObject(2913, pos[0],  pos[1],  pos[2]+0.9,  90, 90,  pos[3], Academia[i][aca_Mundo], Academia[i][aca_Interior]);
		}

		if(Academia[i][aca_Player] != -1)
		{
		    new playerid = Academia[i][aca_Player];
			ClearAnimations(playerid, 1);
			academia_player[playerid] = -1;
		}
		Academia[i][aca_Player] = -1;
	}
    texto_academia(i);
}

stock texto_academia(i)
{
    if(IsValidDynamic3DTextLabel(Academia[i][aca_3D])) DestroyDynamic3DTextLabel(Academia[i][aca_3D]);
    Academia[i][aca_3D] = DynamicText3D:-1;
    if(Academia[i][aca_Existe] == 1)
	{
	    if(Academia[i][aca_Player] == -1)
	    {
		    new sss[150];
			format(sss, 150, "{ffff00}%s [%d]\n{a1a1a1}Aperte {ffffff}H{a1a1a1} para\nusar o aparelho", academia_nome[Academia[i][aca_Tipo]], i );
	        Academia[i][aca_3D] = CreateDynamic3DTextLabel( sss, 0xffffff99, Academia[i][aca_X], Academia[i][aca_Y], Academia[i][aca_Z]+0.7, 5, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0,  Academia[i][aca_Mundo], Academia[i][aca_Interior], -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
		}
	}
}

stock criar_academia(Float:xx, Float:yy, Float:zz, Float:aa, tipo, interi=0, mundo=0)
{
	for(new i; i<MAX_ACADEMIA; i++)
	{
	    if(Academia[i][aca_Existe] == 0)
	    {
	        Academia[i][aca_Existe] = 1;
	        Academia[i][aca_Tipo] = tipo;
	        Academia[i][aca_X] = xx;
	        Academia[i][aca_Y] = yy;
	        Academia[i][aca_Z] = zz;
	        Academia[i][aca_Interior] = interi;
	        Academia[i][aca_Mundo] = mundo;
	        Academia[i][aca_RX] = 0;
	        Academia[i][aca_RY] = 0;
	        Academia[i][aca_RZ] = aa;
	        Academia[i][aca_Player] = -1;
	        atualizar_academia(i);
	        salvar_academia(i);
	        return i;
		}
	}
	return -1;
}


BCG:: carregar_lanchonetes()
{
	new cont;
	new file[80];
	for(new i; i<MAX_LANCHONETES; i++)
	{
	    Lanche[i][la_3D] = DynamicText3D:-1;
	    format(file, 80, "Lanchonetes/Lanchonete_%d.txt", i);
	    if(DOF2_FileExists(file))
	    {
	        Lanche[i][la_Existe] = 1;
	        Lanche[i][la_ActorSkin] = DOF2_GetInt(file, "la_ActorSkin");
	        Lanche[i][la_X] = DOF2_GetFloat(file, "la_X");
	        Lanche[i][la_Y] = DOF2_GetFloat(file, "la_Y");
	        Lanche[i][la_Z] = DOF2_GetFloat(file, "la_Z");
	        Lanche[i][la_RX] = DOF2_GetFloat(file, "la_RX");
	        Lanche[i][la_RY] = DOF2_GetFloat(file, "la_RY");
	        Lanche[i][la_RZ] = DOF2_GetFloat(file, "la_RZ");
			atualizar_lanchonete(i);
	        cont ++;
	    }
	}
    printf("** %d Lanchonetes carregadas.", cont);
}

stock destruir_lanchonete(i)
{
    Lanche[i][la_Existe] = 0;
    atualizar_lanchonete(i);
    salvar_lanchonete(i);
}

stock salvar_lanchonete(i)
{
    new file[80];
	format(file, 80, "Lanchonetes/Lanchonete_%d.txt", i);
	if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
	if(Lanche[i][la_Existe] == 1)
	{
	    DOF2_CreateFile(file);
 		DOF2_SetInt(file, "la_ActorSkin", Lanche[i][la_ActorSkin]);
        DOF2_SetFloat(file, "la_X", Lanche[i][la_X]);
        DOF2_SetFloat(file, "la_Y", Lanche[i][la_Y]);
        DOF2_SetFloat(file, "la_Z", Lanche[i][la_Z]);
        DOF2_SetFloat(file, "la_RX", Lanche[i][la_RX]);
        DOF2_SetFloat(file, "la_RY", Lanche[i][la_RY]);
        DOF2_SetFloat(file, "la_RZ", Lanche[i][la_RZ]);
	    DOF2_SaveFile();
	}
}

stock atualizar_lanchonete(i)
{
	Iter_Remove(Iter_Lanchonetes, i);
    if(IsValidDynamicMapIcon(Lanche[i][la_Mapa])) DestroyDynamicMapIcon_(Lanche[i][la_Mapa]);
	if(IsValidDynamicActor(Lanche[i][la_Actor])) DestroyDynamicActor(Lanche[i][la_Actor]);
	if(IsValidDynamicObject(Lanche[i][la_Obj])) DestroyDynamicObject_(Lanche[i][la_Obj]);
    if(IsValidDynamic3DTextLabel(Lanche[i][la_3D])) DestroyDynamic3DTextLabel(Lanche[i][la_3D]);
	if(IsValidDynamicPickup(Lanche[i][la_Pickup])) DestroyDynamicPickup_(Lanche[i][la_Pickup]);
	Lanche[i][la_3D] = DynamicText3D:-1;
	if(Lanche[i][la_Existe] == 1)
	{
	    Iter_Add(Iter_Lanchonetes, i);
	    new Float:pos[3];
	    new sss[150];
		format(sss, 150, "{ffff00}Lanchonete [%d]\n{a1a1a1}Aperte {ffffff}H{a1a1a1} para\nver o menu", i);
	    Lanche[i][la_Obj] = CreateDynamicObject(1342, Lanche[i][la_X], Lanche[i][la_Y], Lanche[i][la_Z],   Lanche[i][la_RX], Lanche[i][la_RY], Lanche[i][la_RZ], 0, 0);
		pos[0] = Lanche[i][la_X], pos[1] = Lanche[i][la_Y], pos[2] = Lanche[i][la_Z], PegarFrente(pos[0], pos[1], Lanche[i][la_RZ]-90, 1.5);
    	Lanche[i][la_Mapa] = CreateDynamicMapIcon(pos[0], pos[1], pos[2]-0.5, 10, 0xffffffff, 0, 0, -1, 200, MAPICON_LOCAL, -1,  0);
		Lanche[i][la_Pickup] = CreateDynamicPickup(2703, 1, pos[0], pos[1], pos[2]-0.5, 0, 0, -1, STREAMER_PICKUP_SD, -1, 0);
	    Lanche[i][la_3D] = CreateDynamic3DTextLabel( sss, 0xffffff99, pos[0], pos[1], pos[2]-0.5, 5, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1,  0, 0, -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
        pos[0] = Lanche[i][la_X], pos[1] = Lanche[i][la_Y], pos[2] = Lanche[i][la_Z], PegarFrente(pos[0], pos[1], Lanche[i][la_RZ]-90, -1.5);
        Lanche[i][la_Actor] = CreateDynamicActor(Lanche[i][la_ActorSkin], pos[0], pos[1], pos[2]-0.5, Lanche[i][la_RZ]-90, 1, 99999, 0, 0, -1, STREAMER_ACTOR_SD, -1, 0);
		ApplyDynamicActorAnimation(Lanche[i][la_Actor], "COP_AMBIENT", "COPLOOK_LOOP", 4.1, 1, 0, 0, 0, 0);
		SetDynamicActorFacingAngle(Lanche[i][la_Actor], GetAngleToPoint(pos[0], pos[1], Lanche[i][la_X], Lanche[i][la_Y]));
	}
}

stock criar_lanchonete(Float:xx, Float:yy, Float:zz, Float:aa, skin)
{
	for(new i; i<MAX_LANCHONETES; i++)
	{
	    if(Lanche[i][la_Existe] == 0)
	    {
	        Lanche[i][la_Existe] = 1;
	        Lanche[i][la_ActorSkin] = skin;
	        Lanche[i][la_X] = xx;
	        Lanche[i][la_Y] = yy;
	        Lanche[i][la_Z] = zz;
	        Lanche[i][la_RX] = 0;
	        Lanche[i][la_RY] = 0;
	        Lanche[i][la_RZ] = aa;
	        atualizar_lanchonete(i);
	        salvar_lanchonete(i);
	        return i;
		}
	}
	return -1;
}

stock abrir_lanchonete(playerid, l)
{
	if(Lanche[l][la_Existe] == 1)
	{
		if(Online(playerid))
		{
			menu_id[playerid] = MENU_LANCHES;
			escolhendo_menu[playerid] = 0;
			format(nome_menu[playerid], 100, "Menu de Lanches");
			format(botao_menu[playerid], 100, "COMPRAR");
			for(new i; i<sizeof(lanches); i++)
			{
			    if(i < MAX_MENU)
				{
				    Menu[playerid][i][menu_ID] = i;
				    Menu[playerid][i][menu_Unidades] = lanches[i][lan_Unidades];
				    Menu[playerid][i][menu_Tipo] = lanches[i][lan_Tipo];
				    format(Menu[playerid][i][menu_Nome], 200, "%d - %s", i+1, nome_lanche(i));
				    format(Menu[playerid][i][menu_Info], 200, "~y~%s~n~~n~~w~%s~n~~g~R$ %s~n~~b~~h~Unidades: ~w~%d", tipo_lanche(i), nome_lanche(i), ConvertMoney(lanches[i][lan_Valor]), lanches[i][lan_Unidades]);
				    Menu[playerid][i][menu_Valor] = lanches[i][lan_Valor];
				    Menu[playerid][i][menu_Modelo] = Itens[lanches[i][lan_ID]][item_Modelo];
			    }
			}
			max_menu[playerid] = sizeof(lanches);
			mostrar_menu(playerid, menu_id[playerid]);
		}
	}
}

stock comprar_lanche(playerid, i)
{
	SetPVarInt(playerid, "id_lanche", i);
	new sss1[150];
	format(sss1, 150, "{00ffff}%s {4169E1}R$ %s", nome_lanche(i), ConvertMoney(lanches[i][lan_Valor]));
	if(lanches[i][lan_Tipo] == -999) ShowPlayerDialog(playerid, DIALOG_COMPRAR_LANCHE, DIALOG_STYLE_LIST, sss1, "Comer aqui\nLevar lanche", "Pagar", "Cancelar");
	if(lanches[i][lan_Tipo] == -888) ShowPlayerDialog(playerid, DIALOG_COMPRAR_LANCHE, DIALOG_STYLE_LIST, sss1, "Beber aqui\nLevar bebida", "Pagar", "Cancelar");
}

stock inv_vazio(playerid)
{
	new c = id[playerid];
	if(c != -1)
	{
	    for(new i; i<MAX_SLOTS; i++)
	    {
		    if(Inventario[playerid][i][inv_ID] == 0)
		    {
				return i;
			}
		}
	}
	return -1;
}

stock limpar_slot(playerid, i)
{
	new c = id[playerid];
	if(c != -1)
	{
	    Inventario[playerid][i][inv_ID] = 0;
	    Inventario[playerid][i][inv_Unidades] = 0;
		Inventario[playerid][i][inv_Tipo] = 0;
		Inventario[playerid][i][inv_Ativo] = 0;
		Inventario[playerid][i][inv_Tempo] = 0;
		salvar_inventario(c, i);
	}
}

stock diminuir_lanche(idd)
{
	new valor = 21;
	if(idd == 62) valor = 18; // hamburger
	if(idd == 63) valor = 19; // fatia de pizza
	if(idd == 64) valor = 18; // batata frita
	return valor;
}


stock nome_lanche(i)
{
	new namee[40];
	format(namee, 40, Itens[lanches[i][lan_ID]][item_Nome]);
	return namee;
}

stock tipo_lanche(i)
{
	new namee[40];
	if(lanches[i][lan_Tipo] == -999) format(namee, 40, "Comida");
	if(lanches[i][lan_Tipo] == -888) format(namee, 40, "Bebida");
	return namee;
}

stock diminuir_estamina(playerid)
{
    new valor = 10;
    new c = id[playerid];
    if(c != -1)
    {
        new valn = Conta[playerid][c_Resistencia]/10;
        valor -= valn;
        if(valor <= 1) valor = 2;
    }
	return valor;
}

stock dar_estamina(playerid, valor)
{
    new c = id[playerid];
    if(c != -1)
    {
        Conta[playerid][c_Estamina] += valor;
        if(Conta[playerid][c_Estamina] < 0) Conta[playerid][c_Estamina] = 0;
        if(Conta[playerid][c_Estamina] > 100) Conta[playerid][c_Estamina] = 100;
        SetPlayerStamina(playerid, Conta[playerid][c_Estamina]);
    }
    atualizar_atributos(playerid);
}

stock abrir_aparelho(playerid, a)
{
	if(Academia[a][aca_Existe] == 1)
	{
		new sss[300];
		strcat(sss, "\n");
		strcat(sss, "{4169E1}[INFO] {A1A1A1}");
		strcat(sss, academia_info[Academia[a][aca_Tipo]]);
		strcat(sss, "\n");
		SetPVarInt(playerid, "id_aparelho", a);
		ShowPlayerDialog(playerid, DIALOG_ACADEMIA, DIALOG_STYLE_MSGBOX, academia_nome[Academia[a][aca_Tipo]], sss, "Usar", "Fechar");
	}
}

stock almentar_exercicio(playerid, i)
{
	if(Online(playerid))
	{
	    new c = id[playerid];
	    if(c != -1)
	    {
	        // bicicleta e esteira //
	        if(i == 0 || i == 1)
	        {
	            if(Conta[playerid][c_Resistencia] < 100)
	            {
	                SetarResistencia(playerid, Conta[playerid][c_Resistencia]+1);
	            }
	            else ms(playerid, 1, "Sua Resistencia atingiu o limite maximo !");
	        }

	        // costas e peito //
	        if(i == 2 || i == 3)
	        {
	            if(Conta[playerid][c_Forca] < 100)
	            {
	                SetarForca(playerid, Conta[playerid][c_Forca]+1);
	            }
	            else ms(playerid, 1, "Sua Forca atingiu o limite maximo !");
	        }
	    }
	}
}

stock atualizar_academia_player(playerid, tipo)
{
    if(Online(playerid))
	{
	    new c = id[playerid];
	    if(c != -1)
	    {
		    if(mostrando_academia[playerid] == 1)
		    {
		        if(academia_player[playerid] != -1)
		        {
				new Float:comeco = 512.079345;
				new Float:fim = 625.000000;
				new Float:barra = fim-comeco;
				new Float: unidade = barra/100;
				new sss[150];
				format(sss, 150, "%s~n~~n~%d~n~_", academia_nome[tipo], Conta[playerid][c_Estamina]);
				PlayerTextDrawSetString(playerid, T_Academia_p[playerid][0], sss);
				PlayerTextDrawTextSize(playerid, T_Academia_p[playerid][1], comeco+(exercicio[playerid][tipo]*unidade), 3.0);
				PlayerTextDrawShow(playerid, T_Academia_p[playerid][0]);
				PlayerTextDrawShow(playerid, T_Academia_p[playerid][1]);
		        }
		    }
	    }
	}
}

stock mostrar_academia(playerid)
{
	if(Online(playerid))
	{
		mostrando_academia[playerid] = 1;
		TextDrawShowForPlayer(playerid, T_Academia[0]);
		TextDrawShowForPlayer(playerid, T_Academia[1]);
		TextDrawShowForPlayer(playerid, T_Academia[2]);
		if(academia_player[playerid] != -1)
		{
			atualizar_academia_player(playerid,
			Academia[academia_player[playerid]][aca_Tipo]);
		}
	}
}

stock colocar_no_aparelho(playerid, i, tipo)
{
    // esteira //
	if(tipo == 0)
	{
	    if(exercicio[playerid][tipo] > 75) ApplyAnimation(playerid, "GYMNASIUM", "GYM_TREAD_SPRINT", 4.1, true, false, false, false, 0, 1);
	    else ApplyAnimation(playerid, "GYMNASIUM", "GYM_TREAD_JOG", 4.1, true, false, false, false, 0, 1);
	}

	// bicicleta //
	if(tipo == 1)
	{
	    if(exercicio[playerid][tipo] < 30) ApplyAnimation(playerid, "GYMNASIUM", "GYM_BIKE_SLOW", 4.1, true, false, false, false, 0, 1);
	    else ApplyAnimation(playerid, "GYMNASIUM", "GYM_BIKE_FASTER", 4.1, true, false, false, false, 0, 1);
	}

	// alteres //
	if(tipo == 2)
	{

	    if(IsValidDynamicObject(Academia[i][aca_Obj][1])) DestroyDynamicObject_(Academia[i][aca_Obj][1]);
        if(IsValidDynamicObject(Academia[i][aca_Obj][2])) DestroyDynamicObject_(Academia[i][aca_Obj][2]);
        if(!IsPlayerAttachedObjectSlotUsed(playerid, 9)) SetPlayerAttachedObject(playerid, 9, 3072, 6, 0.000000, 0.000000, 0, 0.000000, 0.000000, 0.000000, 1.000000, 1.000000, 1.000000);
		if(!IsPlayerAttachedObjectSlotUsed(playerid, 8)) SetPlayerAttachedObject(playerid, 8, 3072, 5, 0.000000, 0.000000, 0, 15, 0.000000, 0.000000, 1.000000, 1.000000, 1.000000);
		if(exercicio_player[playerid] == 0)
        {
            ApplyAnimation(playerid, "FREEWEIGHTS", "GYM_FREE_A", 4.1, false, false, false, true, 0, 1);
			iniciar_exercicio[playerid] = 2;
			exercicio_player[playerid] = 1;
        }
        else if(exercicio_player[playerid] == 1)
        {
            ApplyAnimation(playerid, "FREEWEIGHTS", "GYM_FREE_DOWN", 4.1, false, false, false, true, 0, 1);
			iniciar_exercicio[playerid] = 1;
			exercicio_player[playerid] = 0;
        }
	}

	// SUPINO //
	if(tipo == 3)
	{
		if(!IsPlayerAttachedObjectSlotUsed(playerid, 9)) SetPlayerAttachedObject(playerid, 9, 2913, 6, 0.000000, 0.000000, -0.109999, 0.000000, 0.000000, 0.000000, 1.000000, 1.000000, 1.000000);
	    if(IsValidDynamicObject(Academia[i][aca_Obj][1])) DestroyDynamicObject_(Academia[i][aca_Obj][1]);
	    if(exercicio_player[playerid] == 1)
	    {
			ApplyAnimation(playerid, "BENCHPRESS", "GYM_BP_UP_A", 4.1, false, false, false, true, 0, 1);
			iniciar_exercicio[playerid] = 3;
			exercicio_player[playerid] = 0;
		}
		else if(exercicio_player[playerid] == 0)
	    {
			ApplyAnimation(playerid, "BENCHPRESS", "GYM_BP_DOWN", 4.1, false, false, false, true, 0, 1);
			iniciar_exercicio[playerid] = 3;
			exercicio_player[playerid] = 1;
		}
	}
}

stock fechar_academia(playerid)
{
	mostrando_academia[playerid] = 0;
	TextDrawHideForPlayer(playerid, T_Academia[0]);
	TextDrawHideForPlayer(playerid, T_Academia[1]);
	TextDrawHideForPlayer(playerid, T_Academia[2]);
	PlayerTextDrawHide(playerid, T_Academia_p[playerid][0]);
	PlayerTextDrawHide(playerid, T_Academia_p[playerid][1]);
	academia_player[playerid] = -1;
}

stock usar_aparelho(playerid, i)
{
	if(Online(playerid))
	{
		if(Academia[i][aca_Existe] == 1)
	    {
	        new tipo = Academia[i][aca_Tipo];
	        Academia[i][aca_Player] = playerid;
	        texto_academia(i);
	        academia_player[playerid] = i;
	        iniciar_exercicio[playerid] = 2;
	        new Float:pos[4];
	        pos[0] = Academia[i][aca_X], pos[1] = Academia[i][aca_Y], pos[2] = Academia[i][aca_Z], pos[3] = Academia[i][aca_RZ];

	        // esteira //
			if(tipo == 0)
			{
			    PegarFrente(pos[0], pos[1], pos[3], -1.5);
			    pos[2] += 0.3;
				SetPlayerPos_(playerid, pos[0], pos[1], pos[2]);
				SetPlayerFacingAngle(playerid, Academia[i][aca_RZ]);
                ApplyAnimation(playerid, "GYMNASIUM", "GYM_TREAD_GETON", 4.1, false, false, false, true, 0, 1);
			}

			// bicicleta //
			if(tipo == 1)
			{
			    PegarFrente(pos[0], pos[1], pos[3], 0.5);
			    pos[3] += 90.0;
				if(pos[3] > 360.0) pos[3] -= 360.0;
				pos[2] += 0.3;
				PegarFrente(pos[0], pos[1], pos[3], -0.4);
				SetPlayerPos_(playerid, pos[0], pos[1], pos[2]);
				SetPlayerFacingAngle(playerid, Academia[i][aca_RZ]+180);
                ApplyAnimation(playerid, "GYMNASIUM", "GYM_BIKE_GETON", 4.1, false, false, false, true, 0, 1);
			}

			// alteres //
			if(tipo == 2)
			{
			    PegarFrente(pos[0], pos[1], pos[3]+90, -0.5);
				SetPlayerPos_(playerid, pos[0], pos[1], pos[2]+1);
			    SetPlayerFacingAngle(playerid, Academia[i][aca_RZ]+90);
			    iniciar_exercicio[playerid] = 2;
			    ApplyAnimation(playerid, "FREEWEIGHTS", "GYM_FREE_PICKUP", 4.1, false, false, false, true, 0, 1);
			    Academia[i][aca_Disponivel] = 1;
			}

			// supino //
			if(tipo == 3)
			{
			    PegarFrente(pos[0], pos[1], pos[3], -1);
			    pos[2] += 0.3;
				SetPlayerPos_(playerid, pos[0], pos[1], pos[2]);
				SetPlayerFacingAngle(playerid, Academia[i][aca_RZ]);
                ApplyAnimation(playerid, "BENCHPRESS", "GYM_BP_GETON", 4.1, false, false, false, true, 0, 1);
                iniciar_exercicio[playerid] = 5;
                exercicio_player[playerid] = 0;
                Academia[i][aca_Disponivel] = 1;
			}



	        ms(playerid, 1, "Voce esta usando o aparelho, aperte F ou ENTER para sair e parar de treinar.");
	    }
	}
}

stock sair_academia(playerid, i)
{
    if(Academia[i][aca_Existe] == 1)
    {
        Academia[i][aca_Player] = -1;
        texto_academia(i);
        if(Online(playerid))
        {

            // esteira //
            if(Academia[i][aca_Tipo] == 0)
            {
                ApplyAnimation(playerid, "GYMNASIUM", "GYM_TREAD_GETOFF", 4.1, false, false, false, false, 0, 1);
            }

            // bicicleta //
            else if(Academia[i][aca_Tipo] == 1)
            {
                ApplyAnimation(playerid, "GYMNASIUM", "GYM_BIKE_GETOFF", 4.1, false, false, false, false, 0, 1);
            }

            // alteres //
            else if(Academia[i][aca_Tipo] == 2)
            {
                ApplyAnimation(playerid, "FREEWEIGHTS", "GYM_FREE_PUTDOWN", 4.1, false, false, false, false, 0, 1);//GYM_FREE_LOOP
                SetTimerEx("restaurar_aparelho", 1000, false, "dd", playerid, i);
            }

            // supino //
            else if(Academia[i][aca_Tipo] == 3)
            {
                ApplyAnimation(playerid, "BENCHPRESS", "GYM_BP_GETOFF", 4.1, false, false, false, false, 0, 1);
                SetTimerEx("restaurar_aparelho", 3000, false, "dd", playerid, i);
            }

			if(Academia[i][aca_Tipo] == 0 && Academia[i][aca_Tipo] == 1) Academia[i][aca_Disponivel] = 0;
            SetPVarInt(playerid, "flood_academia", gettime()+5);
	    }
	}
}


BCG:: restaurar_aparelho(playerid, i)
{
	if(Academia[i][aca_Existe] == 1)
	{
	    new Float:pos[4];
	    if(Academia[i][aca_Tipo] == 2)
	    {
			pos[0] = Academia[i][aca_X], pos[1] = Academia[i][aca_Y], pos[2] = Academia[i][aca_Z], pos[3] = Academia[i][aca_RZ];
			pos[3] += 90.0;
			if(pos[3] > 360.0) pos[3] -= 360.0;
			PegarFrente(pos[0], pos[1], pos[3], 0.5);
			PegarFrente(pos[0], pos[1], pos[3]+90, 0.2);
		    Academia[i][aca_Obj][1] = CreateDynamicObject(3072, pos[0],  pos[1],  pos[2]+0.3,  0, 90,  pos[3], Academia[i][aca_Mundo], Academia[i][aca_Interior]);
		    PegarFrente(pos[0], pos[1], pos[3]+90, -(0.2*2));
		    Academia[i][aca_Obj][2] = CreateDynamicObject(3072, pos[0],  pos[1],  pos[2]+0.3,  0, 90,  pos[3], Academia[i][aca_Mundo], Academia[i][aca_Interior]);
	    }

	    if(Academia[i][aca_Tipo] == 3)
	    {
			if(IsValidDynamicObject(Academia[i][aca_Obj][1])) DestroyDynamicObject_(Academia[i][aca_Obj][1]);
			pos[0] = Academia[i][aca_X], pos[1] = Academia[i][aca_Y], pos[2] = Academia[i][aca_Z], pos[3] = Academia[i][aca_RZ];
			PegarFrente(pos[0], pos[1], pos[3], 0.5);
			PegarFrente(pos[0], pos[1], pos[3]+90, 0.45);
		    Academia[i][aca_Obj][1] = CreateDynamicObject(2913, pos[0],  pos[1],  pos[2]+0.9,  90, 90,  pos[3], Academia[i][aca_Mundo], Academia[i][aca_Interior]);
	    }
	    Academia[i][aca_Disponivel] = 0;
	}
	if(IsPlayerAttachedObjectSlotUsed(playerid, 9)) RemovePlayerAttachedObject(playerid, 9);
	if(IsPlayerAttachedObjectSlotUsed(playerid, 8)) RemovePlayerAttachedObject(playerid, 8);
}

stock salvar_org(i)
{
    new file[80];
    new strf[25];
    new sss[30];
    new string[300];
    format(file, 80, "Orgs/Org_%d.txt", i);
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
    if(Org[i][o_Existe] == 1)
    {
	    DOF2_CreateFile(file);
	    DOF2_SetInt(file, "o_Cor", Org[i][o_Cor]);
	    DOF2_SetString(file, "o_Nome", Org[i][o_Nome]);
	    DOF2_SetString(file, "o_Tag", Org[i][o_Tag]);
	    DOF2_SetInt(file, "o_Tipo", Org[i][o_Tipo]);
		DOF2_SetInt(file, "o_Cofre", Org[i][o_Cofre]);
		DOF2_SetInt(file, "o_Coletes", Org[i][o_Coletes]);
		DOF2_SetInt(file, "o_MapaID", Org[i][o_MapaID]);
		DOF2_SetFloat(file, "o_X", Org[i][o_X]);
		DOF2_SetFloat(file, "o_Y", Org[i][o_Y]);
		DOF2_SetFloat(file, "o_Z", Org[i][o_Z]);
		DOF2_SetFloat(file, "o_LX", Org[i][o_LX]);
		DOF2_SetFloat(file, "o_LY", Org[i][o_LY]);
		DOF2_SetFloat(file, "o_LZ", Org[i][o_LZ]);
		DOF2_SetInt(file, "o_Data", Org[i][o_Data]);
		DOF2_SetInt(file, "o_Dia", Org[i][o_Dia]);
		DOF2_SetInt(file, "o_Mes", Org[i][o_Mes]);
		DOF2_SetInt(file, "o_Ano", Org[i][o_Ano]);
		DOF2_SetInt(file, "o_Salario", Org[i][o_Salario]);

	    // membros //
	    for(new a; a<30; a++)
	    {
	        format(sss, 30, "Membro_%d", a);
	        format(string, 30, "%d|%d|", Org[i][o_Membros][a], Org[i][o_Cargos][a]);
	        DOF2_SetString(file, sss, string);
	    }

	    // armas //
	    format(string, sizeof string, "");
	    for(new d; d<20; d++)
	    {
	        valstr(strf, Org[i][o_Armas][d]);
	        strcat(string, strf);
	        strcat(string, "|");
	    }
	    DOF2_SetString(file, "o_Armas", string);

	    // municoes //
	    format(string, sizeof string, "");
	    for(new g; g<5; g++)
	    {
	        valstr(strf, Org[i][o_Municoes][g]);
	        strcat(string, strf);
	        strcat(string, "|");
	    }
	    DOF2_SetString(file, "o_Municoes", string);

	    // skins //
	    format(string, sizeof string, "");
	    for(new h; h<10; h++)
	    {
	        valstr(strf, Org[i][o_Skins][h]);
	        strcat(string, strf);
	        strcat(string, "|");
	    }
	    DOF2_SetString(file, "o_Skins", string);
		DOF2_SaveFile();
	}
}

BCG:: carregar_gzs()
{
    new file[80];
	for(new a; a<MAX_TERRITORIOS; a++)
	{
	    format(file, 80, "Territorios/tr_%d.txt", a);
	    if(DOF2_FileExists(file))
	    {
	        TR[a][tr_Existe] = 1;
	        TR[a][tr_Tipo] = DOF2_GetInt(file, "tr_Tipo");
	        format(TR[a][tr_Nome], 100,  "%s", DOF2_GetString(file, "tr_Nome"));
	        format(TR[a][tr_Data], 100,  "%s", DOF2_GetString(file, "tr_Data"));
	        TR[a][tr_Formato] = DOF2_GetInt(file, "tr_Formato");
	        TR[a][tr_Dono] = DOF2_GetInt(file, "tr_Dono");
	        TR[a][tr_X] = DOF2_GetFloat(file, "tr_X");
	        TR[a][tr_Y] = DOF2_GetFloat(file, "tr_Y");
	        TR[a][tr_Z] = DOF2_GetFloat(file, "tr_Z");
	        TR[a][tr_LX] = DOF2_GetFloat(file, "tr_LX");
	        TR[a][tr_LY] = DOF2_GetFloat(file, "tr_LY");
	        TR[a][tr_LZ] = DOF2_GetFloat(file, "tr_LZ");
	        TR[a][tr_Interior] = DOF2_GetInt(file, "tr_Interior");
			TR[a][tr_Mundo] = DOF2_GetInt(file, "tr_Mundo");
            TR[a][tr_Largura] = DOF2_GetInt(file, "tr_Largura");
            TR[a][tr_Altura] = DOF2_GetInt(file, "tr_Altura");
            TR[a][tr_Liberada] = DOF2_GetInt(file, "tr_Liberada");
	    }
	    atualizar_gz(a);
	}
}

stock CriarGZ(Float:xx, Float:yy, Float:zz, aa, ll, formato, tipo, const nome[])
{
	for(new a; a<MAX_TERRITORIOS; a++)
	{
	    if(TR[a][tr_Existe] == 0)
	    {
	        TR[a][tr_Existe] = 1;
	        format(TR[a][tr_Nome], 100, nome);
	        format(TR[a][tr_Data], 100, "00/00/00 - 00:00");
	        TR[a][tr_Tipo] = tipo;
	        TR[a][tr_Formato] = formato;
	        TR[a][tr_Dono] = -1;
	        TR[a][tr_Liberada] = 0;
	        TR[a][tr_X] = xx;
	        TR[a][tr_Y] = yy;
	        TR[a][tr_Z] = zz;
	        TR[a][tr_Interior] = 0;
	        TR[a][tr_Mundo] = 0;
	        TR[a][tr_Largura] = ll;
	        TR[a][tr_Altura] = aa;
			atualizar_gz(a);
			salvar_gz(a);
			return a;
	    }
	}
	return -1;
}

stock destruir_gz(a)
{
	if(a >= 0 && a < MAX_TERRITORIOS)
	{
		if(TR[a][tr_Existe] == 1)
		{
		    GZ_EsconderGzTodos(TR[a][tr_GZ]);
            TR[a][tr_Existe] = 0;
            atualizar_gz(a);
            salvar_gz(a);
		}
	}
}

stock salvar_gz(a)
{
    new file[80];
    format(file, 80, "Territorios/tr_%d.txt", a);
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
	if(TR[a][tr_Existe] == 1)
	{
	    DOF2_CreateFile(file);
        DOF2_SetInt(file, "tr_Tipo", TR[a][tr_Tipo]);
        DOF2_SetString(file, "tr_Nome", TR[a][tr_Nome]);
        DOF2_SetString(file, "tr_Data", TR[a][tr_Data]);
        DOF2_SetInt(file, "tr_Formato", TR[a][tr_Formato]);
        DOF2_SetInt(file, "tr_Dono", TR[a][tr_Dono]);
        DOF2_SetFloat(file, "tr_X", TR[a][tr_X]);
        DOF2_SetFloat(file, "tr_Y", TR[a][tr_Y]);
        DOF2_SetFloat(file, "tr_Z", TR[a][tr_Z]);
        DOF2_SetFloat(file, "tr_LX", TR[a][tr_LX]);
        DOF2_SetFloat(file, "tr_LY", TR[a][tr_LY]);
        DOF2_SetFloat(file, "tr_LZ", TR[a][tr_LZ]);
        DOF2_SetInt(file, "tr_Interior", TR[a][tr_Interior]);
		DOF2_SetInt(file, "tr_Mundo", TR[a][tr_Mundo]);
        DOF2_SetInt(file, "tr_Largura", TR[a][tr_Largura]);
        DOF2_SetInt(file, "tr_Altura", TR[a][tr_Altura]);
        DOF2_SetInt(file, "tr_Liberada", TR[a][tr_Liberada]);
	    DOF2_SaveFile();
	}
}

stock cor_gz(a)
{
	new cor = 0xffffffff-40;
	if(TR[a][tr_Existe] == 1)
	{
	    // area neutra //
	    if(TR[a][tr_Tipo] == 0)
	    {
	        cor = 0x00ffffff-40;
	    }
	    else
	    {
	        // dominacao //
	        if(TR[a][tr_Dono] != -1)
	        {
	        	cor = Colors[Org[TR[a][tr_Dono]][o_Cor]]-40;
	        }
	    }
	}
	return cor;
}

stock mostrar_territorios(playerid, con=-1)
{
	if(con == -1)
	{
		for(new a; a<MAX_TERRITORIOS; a++)
		{
		    if(TR[a][tr_Existe] == 1)
		    {
		        if(GetPlayerInterior(playerid) == TR[a][tr_Interior] && GetPlayerVirtualWorld_(playerid) == TR[a][tr_Mundo])
		        {
		            GZ_MostrarGzPlayer(playerid, TR[a][tr_GZ]);
		            if(TR[a][tr_EmGuerra] == 1 && TR[a][tr_Dominando] != -1) GZ_PiscarGzPlayer(playerid, TR[a][tr_GZ], Colors[Org[TR[a][tr_Dominando]][o_Cor]]-40);
		        }
		        else GZ_EsconderGzPlayer(playerid, TR[a][tr_GZ]);
		    }
		}
	}
	else
	{
	    new a = con;
	    if(TR[a][tr_Existe] == 1)
	    {
	        if(GetPlayerInterior(playerid) == TR[a][tr_Interior] && GetPlayerVirtualWorld_(playerid) == TR[a][tr_Mundo])
	        {
	            GZ_MostrarGzPlayer(playerid, TR[a][tr_GZ]);
	            if(TR[a][tr_EmGuerra] == 1 && TR[a][tr_Dominando] != -1) GZ_PiscarGzPlayer(playerid, TR[a][tr_GZ], Colors[Org[TR[a][tr_Dominando]][o_Cor]]-40);
	        }
	        else GZ_EsconderGzPlayer(playerid, TR[a][tr_GZ]);
	    }
	}
}


stock atualizar_gz(a)
{
	if(TR[a][tr_GZ] != 0) GZ_DestruirGz(TR[a][tr_GZ]), TR[a][tr_GZ] = 0;
	if(TR[a][tr_Existe] == 1)
	{
	    TR[a][tr_GZ] = GZ_CriarGz(TR[a][tr_X], TR[a][tr_Y], TR[a][tr_Altura], TR[a][tr_Largura], TR[a][tr_Formato], cor_gz(a));
		foreach(new i:Player)
		{
		    if(Online(i))
		    {
		        if(id[i] != -1)
		        {
		            mostrar_territorios(i, a);
		        }
		    }
		}
	}
}


stock ler_logs(const file[])
{
    new sss[80];
    if(!DOF2_FileExists(file))
	{
	    DOF2_CreateFile(file);
	    for(new a; a<30; a++)
	    {
	        format(sss, 50, "Linha_%d", a);
	        DOF2_SetString(file, sss, "{ffffff}");
	    }
	    DOF2_SaveFile();
	}
    SG[0] = EOS;
    for(new a; a<30; a++)
	{
	    format(sss, 80, "Linha_%d", a);
	    strcat(SG, DOF2_GetString(file, sss)), strcat(SG, "\n");
    }
}

BCG:: carregar_baus()
{
    new file[80], linh[500], linh2[80];
    new cont;
    for(new i; i<MAX_BAUS; i++)
    {
        format(file, 80, "Baus/Bau_%d.txt", i);
        if(DOF2_FileExists(file))
        {
            BauI[i][bau_Existe] = DOF2_GetInt(file, "bau_Existe");
            BauI[i][bau_Dono] = DOF2_GetInt(file, "bau_Dono");
            format(BauI[i][bau_Senha], 20, "%s", DOF2_GetString(file, "bau_Senha"));
            BauI[i][bau_Slots] = DOF2_GetInt(file, "bau_Slots");
            if(BauI[i][bau_Slots] < 1) BauI[i][bau_Slots] = 10;
            BauI[i][bau_X] = DOF2_GetFloat(file, "bau_X");
            BauI[i][bau_Y] = DOF2_GetFloat(file, "bau_Y");
            BauI[i][bau_Z] = DOF2_GetFloat(file, "bau_Z");
            BauI[i][bau_Mundo] = DOF2_GetInt(file, "bau_Mundo");
            BauI[i][bau_Interior] = DOF2_GetInt(file, "bau_Interior");
            for(new s; s<BauI[i][bau_Slots]; s++)
            {
                format(linh2, 80, "bau_Item_%d", s);
                format(linh, 500, "%s", DOF2_GetString(file, linh2));
                split_linha(linh, strlen(linh));
                BauI_Itens[i][s][inv_ID] = strval(split[0]);
                BauI_Itens[i][s][inv_Unidades] = strval(split[1]);
                BauI_Itens[i][s][inv_Tipo] = strval(split[2]);
                BauI_Itens[i][s][inv_Ativo] = strval(split[3]);
                BauI_Itens[i][s][inv_Tempo] = strval(split[4]);
            }
            Iter_Add(Iter_Baus, i);
            atualizar_bau_item(i);
            cont++;
        }
    }
    printf("** %d Baus de itens carregados.", cont);
}

BCG:: carregar_orgs()
{
	new file[80];
	new cont;
	new string[400];
	new sss[50];
	for(new i; i<MAX_ORGS; i++)
	{
	    Org[i][o_3D] = DynamicText3D:-1;
		format(file, 80, "Orgs/Org_%d.txt", i);
		if(DOF2_FileExists(file))
		{
			Org[i][o_Existe] = 1;
			Org[i][o_Cor] = DOF2_GetInt(file, "o_Cor");
			if(Org[i][o_Cor] == 0) Org[i][o_Cor] = 1;
			format(Org[i][o_Nome], 60, "%s", DOF2_GetString(file, "o_Nome"));
			format(Org[i][o_Tag], 10, "%s", DOF2_GetString(file, "o_Tag"));
			Org[i][o_Tipo] = DOF2_GetInt(file, "o_Tipo");
			Org[i][o_Cofre] = DOF2_GetInt(file, "o_Cofre");
			Org[i][o_Coletes] = DOF2_GetInt(file, "o_Coletes");
			Org[i][o_MapaID] = DOF2_GetInt(file, "o_MapaID");
            Org[i][o_X] = DOF2_GetFloat(file, "o_X");
            Org[i][o_Y] = DOF2_GetFloat(file, "o_Y");
            Org[i][o_Z] = DOF2_GetFloat(file, "o_Z");
            Org[i][o_LX] = DOF2_GetFloat(file, "o_LX");
            Org[i][o_LY] = DOF2_GetFloat(file, "o_LY");
            Org[i][o_LZ] = DOF2_GetFloat(file, "o_LZ");
            Org[i][o_Data] = DOF2_GetInt(file, "o_Data");
            Org[i][o_Dia] = DOF2_GetInt(file, "o_Dia");
            Org[i][o_Mes] = DOF2_GetInt(file, "o_Mes");
            Org[i][o_Ano] = DOF2_GetInt(file, "o_Ano");
            Org[i][o_Salario] = DOF2_GetInt(file, "o_Salario");

			// membros //
			for(new a; a<30; a++)
			{
			    format(sss, 50, "Membro_%d", a);
				format(string, 30, "%s", DOF2_GetString(file, sss));
				split_linha(string, strlen(string), -1);
				Org[i][o_Membros][a] = strval(split[0]);
				Org[i][o_Cargos][a] = strval(split[1]);
				if(Org[i][o_Cargos][a] > 6) Org[i][o_Cargos][a] = 0;
				if(Org[i][o_Cargos][a] < 0) Org[i][o_Cargos][a] = 0;
				if(Org[i][o_Membros][a] != -1) if(Org[i][o_Cargos][a] == 0) Org[i][o_Cargos][a] = 1;
			}

			// armas //
			format(string, 300, "%s", DOF2_GetString(file, "o_Armas"));
   			split_linha(string, strlen(string));
   			for(new d; d<20; d++) Org[i][o_Armas][d] = strval(split[d]);

   			// municoes //
   			format(string, 300, "%s", DOF2_GetString(file, "o_Municoes"));
   			split_linha(string, strlen(string));
   			for(new g; g<5; g++) Org[i][o_Municoes][g] = strval(split[g]);

   			// skins //
   			format(string, 300, "%s", DOF2_GetString(file, "o_Skins"));
   			split_linha(string, strlen(string), -1);
   			for(new h; h<10; h++) Org[i][o_Skins][h] = strval(split[h]);

            atualizar_org(i);
            cont ++;
		}
	}
    printf("** %d Organizacoes do Servidor carregadas.", cont);
}

stock split_linha(const str[], MAX, con=0)
{
	new tama;
	new linha[250];
    new cont;
    for(new i; i<250; i++) format(split[i], 10, "%d", con);

    if(MAX > 0)
    {
	    for(new i; i<MAX; i++)
		{
		    if(cont < sizeof split)
		    {
				if(str[i] == EOS) break;
			    if(str[i] == '|')
				{
				    format(split[cont], tama+1, linha);
					cont ++;
					tama = 0;
					linha[0] = EOS;
				}
			    else
				{
					strcat(linha, str[i]);
					tama ++;
				}
			}
		}
		if(tama > 0 && cont < sizeof split) format(split[cont], tama+1, linha);
	}
}


stock destruir_org(i)
{
    if(Org[i][o_Existe] == 1)
	{
	    foreach(new a:Iter_Veiculos)
	    {
	        if(Veiculo[a][v_Existe] == 1)
	        {
             	if(Veiculo[a][v_Org] == i)
	            {
	            	if(Veiculo[a][v_Garagem] == 0)
					{
	    				new idv = Veiculo[a][v_ID];
	                    DestruirVeiculo(idv);
					}
					else
					{
					    DestruirInfo(i);
	            		SalvarInfo(i);
					}
	            }
	        }
	    }

	    foreach(new a:Iter_Portoes)
	    {
	        if(Portao[a][p_Existe] == 1)
	        {
	        	if(Portao[a][p_Org] == i)
	            {
		            destruir_portao(i);
				}
			}
	    }

        Org[i][o_Existe] = 0;
		new sss[150];
		new player;
		format(sss, 150, "A organizacao '%s', foi destruida", Org[i][o_Nome]);
        for(new a; a<30; a++)
		{
		    if(Org[i][o_Membros][a] != -1)
		    {
		        new idd = Org[i][o_Membros][a];
		        msc(idd, 2, sss);

                player = ContaOnline(idd);
                if(Online(player))
				{
				    Conta[player][c_Org] = -1;
		        	Conta[player][c_Cargo] = 0;
		        	salvar_conta(idd, 0, "c_Org", sv_int(Conta[player][c_Org]));
		        	salvar_conta(idd, 0, "c_Cargo", sv_int(Conta[player][c_Cargo]));
				}
				else
				{
				    salvar_conta(idd, 0, "c_Org", sv_int(-1));
				    salvar_conta(idd, 0, "c_Cargo", sv_int(0));
				}
		    }
			Org[i][o_Membros][a] = -1;
			Org[i][o_Cargos][a] = 0;
		}
		atualizar_org(i);
		salvar_org(i);
	}
}

stock criar_org(Float:xx, Float:yy, Float:zz, const nome[], const tag[])
{
	for(new i; i<MAX_ORGS; i++)
	{
		if(Org[i][o_Existe] == 0)
		{
		    Org[i][o_Existe] = 1;

		    // membros //
		    for(new a; a<30; a++)
			{
				Org[i][o_Membros][a] = -1;
				Org[i][o_Cargos][a] = 0;
			}

			// ARMAS //
			for(new d; d<20; d++) Org[i][o_Armas][d] = 0;

			// municoes //
			for(new g; g<5; g++) Org[i][o_Municoes][g] = 0;

			// municoes //
			for(new h; h<10; h++) Org[i][o_Skins][h] = -1;

		    Org[i][o_Tipo] = 5;
		    Org[i][o_Cor] = 1;
			Org[i][o_Cofre] = 0;
			Org[i][o_Coletes] = 0;
			Org[i][o_MapaID] = 23;
			Org[i][o_Data] = getdate();
			getdate(Org[i][o_Ano], Org[i][o_Mes], Org[i][o_Dia]);
			Org[i][o_X] = xx;
			Org[i][o_Y] = yy;
			Org[i][o_Z] = zz;
			Org[i][o_LX] = 0.0;
			Org[i][o_LY] = 0.0;
			Org[i][o_LZ] = 0.0;
		    format(Org[i][o_Nome], 60, nome);
		    format(Org[i][o_Tag], 10, tag);
		    salvar_org(i);
		    atualizar_org(i);
		    return  i;
		}
	}
	return -1;
}

stock atualizar_org(i)
{
    if(IsValidDynamicMapIcon(Org[i][o_Mapa])) DestroyDynamicMapIcon_(Org[i][o_Mapa]);
	if(IsValidDynamicPickup(Org[i][o_Pickup])) DestroyDynamicPickup_(Org[i][o_Pickup]);
    if(IsValidDynamic3DTextLabel(Org[i][o_3D])) DestroyDynamic3DTextLabel(Org[i][o_3D]);
    Org[i][o_3D] = DynamicText3D:-1;
    Iter_Remove(Iter_Orgs, i);
    if(Org[i][o_Existe] == 1)
    {
        Iter_Add(Iter_Orgs, i);
        if(Org[i][o_Tipo] != 5)
        {
            new sss[300];
            format(sss, 300, "{00ffff}Org ID: %d\n'%s'\n\n{a1a1a1}Aperte {ffffff}F {a1a1a1}para\nabrir o Menu", i, Org[i][o_Nome] );
            if( Org[i][o_MapaID] != -1 ) Org[i][o_Mapa] = CreateDynamicMapIcon(Org[i][o_X], Org[i][o_Y], Org[i][o_Z], Org[i][o_MapaID], 0xffffffff, 0, 0, -1, 200, MAPICON_LOCAL, -1,  0);
            Org[i][o_Pickup] = CreateDynamicPickup(1314, 1, Org[i][o_X], Org[i][o_Y], Org[i][o_Z], 0, 0, -1, STREAMER_PICKUP_SD, -1, 0);
            Org[i][o_3D] = CreateDynamic3DTextLabel( sss, 0xffffff99, Org[i][o_X], Org[i][o_Y], Org[i][o_Z], 7, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0,  0, 0, -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
        }
    }
}

stock membros(i)
{
	new cont;
	if(Org[i][o_Existe] == 1)
	{
  		for(new a; a<30; a++)
		{
		    if(Org[i][o_Membros][a] != -1) cont ++;
		}
	}
	return cont;
}

stock veiculos_org(i)
{
	new cont;
	if(Org[i][o_Existe] == 1)
	{
  		foreach(new a:Iter_Veiculos)
		{
		    if(Veiculo[a][v_Existe] == 1)
			{
				if(Veiculo[a][v_Org] == i) cont ++;
			}
		}
	}
	return cont;
}

stock orgs()
{
	new cont;
	foreach(new i:Iter_Orgs)
	{
	    if(Org[i][o_Existe] == 1) cont ++;
	}
	return cont;
}

stock abrir_org(playerid, i)
{
	if(Org[i][o_Existe] == 1)
	{
	    if(Online(playerid))
	    {
			new c = id[playerid];
			if(c != -1)
			{
			    ClearAnimations(playerid, 1);
			    SetPVarInt(playerid, "id_org", i);
			    SG[0] = EOS;
				new sss[100];
				strcat(SG, "{ffffff}Informacoes\n");
				strcat(SG, "{ffffff}Logs\n");
				format(sss, 100, "{ffffff}Membros [ {00ffff}%d {ffffff}]\n", membros(i));
				strcat(SG, sss);
				format(sss, 100, "{ffffff}Veiculos [ {00ffff}%d {ffffff}]\n", veiculos_org(i));
				strcat(SG, sss);
				format(sss, 100, "{ffffff}Cofre [ {4169E1}R$ %s {ffffff}]\n", ConvertMoney(Org[i][o_Cofre]));
				strcat(SG, sss);
			    strcat(SG, "{ffffff}Convidar\n");
			    strcat(SG, "{ffff00}Armas\n");
			    strcat(SG, "{ffff00}Colete\n");
			    strcat(SG, "{ffffff}Lista de Skins\n");
			    ShowPlayerDialog(playerid, DIALOG_ORG, DIALOG_STYLE_LIST, Org[i][o_Nome], SG, "Continuar", "Fechar");
			}
		}
	}
}

stock escrever_log(const filelog[], const str[], con=-1)
{
	new file[80];
	new lin[30];
	new lin2[30];
	new strlog[300];
	if(con == -1) format(strlog, 300, "{ffffff}[ %02d/%02d/%02d - %02d:%02d ] - %s", DIA, MES, ANO, HORA, MINUTO, str );
	else
	{
        gettime(HORA, MINUTO, SEGUNDO);
		getdate(ANO, MES, DIA);
		format(strlog, 300, "{ffffff}[ %02d/%02d/%02d - %02d:%02d:%02d ] - %s", DIA, MES, ANO, HORA, MINUTO, SEGUNDO, str );
	}
	format(file, 80, "%s", filelog);
	if(!DOF2_FileExists(file))
	{
	    DOF2_CreateFile(file);
	    for(new a=29; a>-1; a--)
		{
		    format(lin2, 30, "Linha_%d", a);
		    DOF2_SetString(file, lin2, "{ffffff}");
		    if(a == 0) DOF2_SetString(file, lin2, strlog);
		}
	}
	else
	{
	    for(new a=29; a>-1; a--)
		{
		    format(lin, 30, "Linha_%d", a-1);
			format(lin2, 30, "Linha_%d", a);
		    if(a > 0) DOF2_SetString(file, lin2, DOF2_GetString(file, lin));
		    else DOF2_SetString(file, lin2, strlog);
		}
	}
	DOF2_SaveFile();
}

