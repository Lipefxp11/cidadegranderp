stock finalizar_corrida(playerid, player, grana, vv, con=0)
{
    new sss[600];
	// locais normais //
	if(GetPVarInt(playerid, "uber_gps") == 0)
	{
		format(sss, 600,
		"{00FFFF}VIAGEM CONCLUIDA !\n\n\
		{FFFFFF}Cliente: {ffff00}%s\n\
		{FFFFFF}Motorista: {00ffff}%s\n\
		{FFFFFF}Placa: {a1a1a1}%s\n\
		{FFFFFF}Destino: {a1a1a1}%s\n\
		{FFFFFF}Cidade: {a1a1a1}%s\n\
		{FFFFFF}Distancia: {a1a1a1}%.0f Metros\n\
		{FFFFFF}Valor: {4169E1}R$ %s\n",  Nome(playerid), Nome(player), PlacaVeiculo[vv], destino(Uber[playerid][uber_Destino], Uber[playerid][uber_Cidade]), cidade(Uber[playerid][uber_Cidade]), Uber[playerid][uber_Distancia], ConvertMoney(grana));
	}

	// caixas eletronicos
	if(GetPVarInt(playerid, "uber_gps") == 1)
	{
	    format(sss, 600,
		"{00FFFF}VIAGEM CONCLUIDA !\n\n\
		{FFFFFF}Cliente: {ffff00}%s\n\
		{FFFFFF}Motorista: {00ffff}%s\n\
		{FFFFFF}Placa: {a1a1a1}%s\n\
		{FFFFFF}Destino: {a1a1a1}Caixa Eletronico [%d]\n\
		{FFFFFF}Cidade: {a1a1a1}%s\n\
		{FFFFFF}Distancia: {a1a1a1}%.0f Metros\n\
		{FFFFFF}Valor: {4169E1}R$ %s\n",  Nome(playerid), Nome(player), PlacaVeiculo[vv], Uber[playerid][uber_Destino], cidade(Uber[playerid][uber_Cidade]), Uber[playerid][uber_Distancia], ConvertMoney(grana));
	}

	// casas
	if(GetPVarInt(playerid, "uber_gps") == 2)
	{
	    format(sss, 600,
		"{00FFFF}VIAGEM CONCLUIDA !\n\n\
		{FFFFFF}Cliente: {ffff00}%s\n\
		{FFFFFF}Motorista: {00ffff}%s\n\
		{FFFFFF}Placa: {a1a1a1}%s\n\
		{FFFFFF}Destino: {a1a1a1}Casa [%d]\n\
		{FFFFFF}Cidade: {a1a1a1}%s\n\
		{FFFFFF}Distancia: {a1a1a1}%.0f Metros\n\
		{FFFFFF}Valor: {4169E1}R$ %s\n",  Nome(playerid), Nome(player), PlacaVeiculo[vv], Uber[playerid][uber_Destino], cidade(Uber[playerid][uber_Cidade]), Uber[playerid][uber_Distancia], ConvertMoney(grana));
	}

	if(Online(player))
	{
	    if(id[player] != -1)
	    {
	        ms(player, 3, "O motorista chegou ate o destino da sua viagem !");
	        if(GranaPlayer(playerid) >= grana)
			{
				DarGrana(player, grana);
				DarGrana(playerid, -grana);
			}
			else ms(playerid, 0, "A corrida nao foi paga, o passageiro nao tem dinheiro suficiente !!!");
			ShowPlayerDialog(player, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}_", sss, "Ok", "Fechar");
	    }

	    Localizando_ID[player] = -1;
	    Localizando[player] = -1;
	    DisablePlayerCheckpoint(player);
	    if(IsValidDynamic3DTextLabel(Localizando_3D[player])) DestroyDynamic3DTextLabel(Localizando_3D[player]);
	    Localizando_3D[player] = DynamicText3D:-1;
	}

	ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}_", sss, "Ok", "Fechar");
	if(con == 0) ms(playerid, 3, "Voce chegou ate o destino da viagem !");
	else ms(playerid, 3, "Corrida cancelada e finalizada pelo cliente !");
	if(celular_aberto[player] == C_UBER_CLIENTE) celular(player, C_UBER);
	if(celular_aberto[playerid] == C_UBER_MOTORISTA || celular_aberto[playerid] == C_UBER_VIAGEM) celular(playerid, C_UBER);

	Localizando_ID[playerid] = -1;
    Localizando[playerid] = -1;
    DisablePlayerCheckpoint(playerid);
    if(IsValidDynamic3DTextLabel(Localizando_3D[playerid])) DestroyDynamic3DTextLabel(Localizando_3D[playerid]);
    Localizando_3D[playerid] = DynamicText3D:-1;
	return 1;
}

stock destruir_dinamite(i)
{
    Explosivo[i][explosivo_Existe] = 0;
    atualizar_explosivo(i);
	return 1;
}

stock criar_explosivo(playerid, slot)
{
	new conta = id[playerid];
	if(conta == -1) return 1;
	if(Online(playerid))
	{
		new cont_policia;
		foreach(new p:Player) if(EmServico(p)) cont_policia++;
		if(cont_policia < 3) return ms(playerid, 0, "Precisa de pelo menos 3 policiais online e em servico para usar C4 !");
	    for(new i; i<MAX_EXPLOSIVOS; i++)
	    {
            if(Explosivo[i][explosivo_Existe] == 0)
            {
		        Explosivo[i][explosivo_Existe] = 1;
                Explosivo[i][explosivo_Mundo] = GetPlayerVirtualWorld_(playerid);
                Explosivo[i][explosivo_Interior] = GetPlayerInterior(playerid);
                GetPlayerPos(playerid, Explosivo[i][explosivo_X], Explosivo[i][explosivo_Y], Explosivo[i][explosivo_Z]);
                PegarFrentePlayer(playerid, Explosivo[i][explosivo_X], Explosivo[i][explosivo_Y], 1);
				GetPlayerFacingAngle(playerid, Explosivo[i][explosivo_RZ]);
             	Explosivo[i][explosivo_Z] -= 0.8;
                Explosivo[i][explosivo_Tipo] = player_c4[playerid];
                Explosivo[i][explosivo_ID] = player_c4_id[playerid];
                Explosivo[i][explosivo_Dono] = conta;
                Explosivo[i][explosivo_Tempo] = 30;
				atualizar_explosivo(i);
				Conta[playerid][c_C4] = payday_server;
				diminuir_inv(conta, slot);
		        format(string_prox, 300, "** '%s' plantou um Explosivo C4 **", Nome(playerid));
				ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
				ms(playerid, 1, "Voce plantou um explosivo, ele ira detonar em 30 segundos, se afaste do local !");
				aplicar_su(playerid, -1, 18);

				// caixa eletronico //
				if(Explosivo[i][explosivo_Tipo] == 0)
				{
					format(string_prox, 300, "[CAIXINHA] O Caixa Eletronico [%d] esta sendo assaltado em %s neste exato momento !", Explosivo[i][explosivo_ID], cidade2(pegar_cidade(playerid)));
			    	mscop(string_prox);
		        }

		        // carro forte //
				if(Explosivo[i][explosivo_Tipo] == 1)
				{
					format(string_prox, 300, "[SEGURANCA] Um carro forte esta sendo assaltado em %s neste exato momento !", cidade2(pegar_cidade(playerid)));
			    	mscop(string_prox);
		        }

		        // porta de cofre //
				if(Explosivo[i][explosivo_Tipo] == 3)
				{
					format(string_prox, 300, "[COFRE] A Empresa '%s' [%d] esta sendo assaltado em %s agora mesmo !", Empresa[Explosivo[i][explosivo_ID]][em_Nome], Explosivo[i][explosivo_ID], cidade2(pegar_cidade(-1, Empresa[Explosivo[i][explosivo_ID]][em_X], Empresa[Explosivo[i][explosivo_ID]][em_Y], Empresa[Explosivo[i][explosivo_ID]][em_Z])));
			    	mscop(string_prox);
		        }

		        // cofre DE EMPRESA //
				if(Explosivo[i][explosivo_Tipo] == 2)
				{
					format(string_prox, 300, "[COFRE] O Cofre da empresa '%s' [%d] em %s ira explodir !", Empresa[Explosivo[i][explosivo_ID]][em_Nome], Explosivo[i][explosivo_ID], cidade2(pegar_cidade(-1, Empresa[Explosivo[i][explosivo_ID]][em_X], Empresa[Explosivo[i][explosivo_ID]][em_Y], Empresa[Explosivo[i][explosivo_ID]][em_Z])));
			    	mscop(string_prox);
		        }

				return 1;
			}
	    }
		ms(playerid, 0, "Numero Maximo de Explosivos no servidor atingido !");
	}
	return 1;
}

stock atualizar_explosivo(i)
{
	if(IsValidDynamicObject(Explosivo[i][explosivo_Obj])) DestroyDynamicObject_(Explosivo[i][explosivo_Obj]);
	if(IsValidDynamic3DTextLabel(Explosivo[i][explosivo_3D])) DestroyDynamic3DTextLabel(Explosivo[i][explosivo_3D]);
    Explosivo[i][explosivo_3D] = DynamicText3D:-1;
	if(Explosivo[i][explosivo_Existe] == 1)
	{
	    if(Explosivo[i][explosivo_Tipo] == 0)
	    {
	        new c = Explosivo[i][explosivo_ID];
	        if(CaixaEletronico[c][ce_Existe] == 1)
	        {
	            Explosivo[i][explosivo_X] = CaixaEletronico[c][ce_X];
  				Explosivo[i][explosivo_Y] = CaixaEletronico[c][ce_Y];
	    		Explosivo[i][explosivo_Z] = CaixaEletronico[c][ce_Z];
	    		Explosivo[i][explosivo_RZ] = CaixaEletronico[c][ce_RZ];
	    		Explosivo[i][explosivo_Mundo] = CaixaEletronico[c][ce_Mundo];
	    		Explosivo[i][explosivo_Interior] = CaixaEletronico[c][ce_Interior];
			    PegarFrente(Explosivo[i][explosivo_X], Explosivo[i][explosivo_Y], Explosivo[i][explosivo_RZ], -0.3144);
			    Explosivo[i][explosivo_Z] += 0.1840;
			    texto_caixa_eletronico(c);
	        }
	    }

	    if(Explosivo[i][explosivo_Tipo] == 1)
	    {
	        new v = Explosivo[i][explosivo_ID];
	        if(GetVehicleModel(v) != 0)
	        {
	            new d = Info_Veiculo[v];
	            if(d != -1)
	            {
	                GetVehiclePos(v, Explosivo[i][explosivo_X], Explosivo[i][explosivo_Y], Explosivo[i][explosivo_Z]);
	                GetVehicleZAngle(v, Explosivo[i][explosivo_RZ]);
	                Explosivo[i][explosivo_Obj] = CreateDynamicObject(1654,  0, 0, 0, 0, 0, 0, 0, 0);
	                AttachDynamicObjectToVehicle(Explosivo[i][explosivo_Obj], v, 0,-2.9962,-0.0029, 0,0,0);
		    		Explosivo[i][explosivo_Mundo] = 0;
		    		Explosivo[i][explosivo_Interior] = 0;
				    PegarFrente(Explosivo[i][explosivo_X], Explosivo[i][explosivo_Y], Explosivo[i][explosivo_RZ], -2.9962);
				    Explosivo[i][explosivo_Z] += -0.0029;
				    Explosivo[i][explosivo_3D] = CreateDynamic3DTextLabel( "...", 0xffffff99, Explosivo[i][explosivo_X], Explosivo[i][explosivo_Y], Explosivo[i][explosivo_Z], 50, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0,  Explosivo[i][explosivo_Mundo], Explosivo[i][explosivo_Interior], -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
			    }
	        }
	        return 1;
	    }

	    Explosivo[i][explosivo_Obj] = CreateDynamicObject(1654,  Explosivo[i][explosivo_X], Explosivo[i][explosivo_Y], Explosivo[i][explosivo_Z], 0, 0, Explosivo[i][explosivo_RZ], Explosivo[i][explosivo_Mundo], Explosivo[i][explosivo_Interior]);
	    Explosivo[i][explosivo_3D] = CreateDynamic3DTextLabel( "...", 0xffffff99, Explosivo[i][explosivo_X], Explosivo[i][explosivo_Y], Explosivo[i][explosivo_Z], 50, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0,  Explosivo[i][explosivo_Mundo], Explosivo[i][explosivo_Interior], -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
		texto_explosivo(i);
	}
	return 1;
}

stock texto_explosivo(i)
{
	new sss[300];
	if(Explosivo[i][explosivo_Existe] == 1)
	{
	    new c = Explosivo[i][explosivo_Dono];
	    format(sss, 300, "{ff0000}EXPLOSIVO C4\n{ffffff}Dono: {a1a1a1}%s\n{ffffff}Explosao: {ffff00}%s", NomeConta(c), ConvertTime(Explosivo[i][explosivo_Tempo]));
	    if(IsValidDynamic3DTextLabel(Explosivo[i][explosivo_3D]))
		{
			UpdateDynamic3DTextLabelText(Explosivo[i][explosivo_3D], 0xffffff90, sss);
		}
	}
	return 1;
}

stock angulo_aleatorio(angu, anga)
{
	new al = random(anga);
	new ale = random(2);
	if(ale == 0) al = al*(-1);
	angu += al;
	new angulo = angu;
	if(angulo > 360) angulo -= 360;
	if(angulo < 0) angulo += 360;
	return angulo;
}


stock explodir_dinamite(i)
{
	new sss[150];
	new range = 15;

	if(Explosivo[i][explosivo_Tipo] == 1) range = 7;
	format(sss, 150, "Voce sofreu danos do Explosivo - C4 de '%s'.", NomeConta(Explosivo[i][explosivo_Dono]));
	criar_explosao(Explosivo[i][explosivo_X], Explosivo[i][explosivo_Y], Explosivo[i][explosivo_Z], range, 0, Explosivo[i][explosivo_Interior], Explosivo[i][explosivo_Mundo]);
    Explosivo[i][explosivo_Existe] = 0;
    new player = ContaOnline(Explosivo[i][explosivo_Dono]);
    foreach(new a:Player)
	{
	    if(Online(a))
	    {
	        if(ModoAdmin[a] != 1)
	        {
		        if(id[a] != -1)
		        {
		            if(IsPlayerInRangeOfPoint(a, range, Explosivo[i][explosivo_X], Explosivo[i][explosivo_Y], Explosivo[i][explosivo_Z]))
		            {
		                if(GetPlayerInterior(a) == Explosivo[i][explosivo_Interior])
		                {
		                    if(GetPlayerVirtualWorld_(a) == Explosivo[i][explosivo_Mundo])
		                	{
		                	    if(!Novato(a))
		                	    {
		                            Dano(player, a, 85, 9999);
		                            if(id[a] == Explosivo[i][explosivo_Dono]) ms(a, 4, "Voce acabou sofrendo dano de seu Explosivo - C4.");
		                            else ms(a, 4, sss);
	                            }
							}
						}
					}

				}
			}
		}
	}

	// carro forte //
	if(Explosivo[i][explosivo_Tipo] == 1)
	{
	    new v = Explosivo[i][explosivo_ID];
	    if(GetVehicleModel(v) != 0)
	    {
		new d = Info_Veiculo[v];
	        if(d != -1)
	        {
	            if(malotes_veiculo[d] > 0)
	            {
	                new grana_base = malotes_veiculo[d] * 5000;
	                new total_drop = grana_base * 30 / 100;
	                if(total_drop < 15) total_drop = 15;
	                if(total_drop > grana_base) total_drop = grana_base;
	                malotes_veiculo[d] = 0;
	                veiculo_acessorios(v);
	                new grana = total_drop / 15;
	                new Float:pos[4];
	                GetVehicleZAngle(v, pos[3]);
	                pos[3] += 180.0;
	                if(pos[3] > 360.0) pos[3] -= 360.0;
	                for(new a; a<15; a++)
	                {
	                    GetVehiclePos(v, pos[0], pos[1], pos[2]);
			    PegarFrente(pos[0], pos[1], angulo_aleatorio(floatround(pos[3]), 30), (5.5+( RandomFloat2[random(sizeof RandomFloat2)]*3 )));
			    criar_item(49, pos[0], pos[1], (pos[2]-1.0252)+0.9, grana, 0, 0, -1, 5*(60));
			}
	            }
	        }
	    }
	}

	// caixa eletronico //
	if(Explosivo[i][explosivo_Tipo] == 0)
	{
		new ca = Explosivo[i][explosivo_ID];
		if(CaixaEletronico[ca][ce_Existe] == 1)
		{
			if(CaixaEletronico[ca][ce_Quebrado] == 0)
			{
			    CaixaEletronico[ca][ce_Quebrado] = 1;
			    new total_drop = CaixaEletronico[ca][ce_Dinheiro] * 30 / 100;
			    if(total_drop < 15) total_drop = 15;
			    if(total_drop > CaixaEletronico[ca][ce_Dinheiro]) total_drop = CaixaEletronico[ca][ce_Dinheiro];
			    CaixaEletronico[ca][ce_Dinheiro] -= total_drop;
			    new grana_caixa = total_drop / 15;
			    new Float:pos[3];
			    for(new a; a<15; a++)
			    {
			        pos[0] = CaixaEletronico[ca][ce_X];
				pos[1] = CaixaEletronico[ca][ce_Y];
				pos[2] = CaixaEletronico[ca][ce_Z];
				PegarFrente(pos[0], pos[1], angulo_aleatorio(floatround(CaixaEletronico[ca][ce_RZ]), 30), -(1.5+(  RandomFloat2[random(sizeof RandomFloat2)]*2  )) );
			        criar_item(49, pos[0], pos[1], CaixaEletronico[ca][ce_Z]+0.9, grana_caixa, CaixaEletronico[ca][ce_Mundo], CaixaEletronico[ca][ce_Interior], -1, 5*(60));
				}
				atualizar_caixa_eletronico(ca, 2);
				salvar_caixa_eletronico(ca);
			}
			else return 1;
		}
	}

	// cofre //
	if(Explosivo[i][explosivo_Tipo] == 2)
	{
		new ca = Explosivo[i][explosivo_ID];
		if(Empresa[ca][em_Existe] == 1)
		{
			if(Cofre[ca][cofre_Status] == 0)
			{
			    Cofre[ca][cofre_Status] = 1;
			    new total_drop = Empresa[ca][em_Cofre] * 30 / 100;
			    if(total_drop < 15) total_drop = 15;
			    if(total_drop > Empresa[ca][em_Cofre]) total_drop = Empresa[ca][em_Cofre];
			    Empresa[ca][em_Cofre] -= total_drop;
			    new grana_caixa = total_drop / 15;
			    new Float:pos[3];
			    for(new a; a<15; a++)
			    {
			        pos[0] = pos_cofre[0];
				pos[1] = pos_cofre[1];
				pos[2] = pos_cofre[2];
				PegarFrente(pos[0], pos[1], angulo_aleatorio(0, 30), -(1.5+(  RandomFloat2[random(sizeof RandomFloat2)]*2)) );
			        criar_item(49, pos[0], pos[1], pos[2]+0.55, grana_caixa, ca, 1, -1, 5*(60));
				}
				Cofre[ca][cofre_Tempo] = gettime()+(2*(60*60));
				atualizar_cofre(ca, 1);
				salvar_empresa(ca);
			}
			else return 1;
		}
	}

	// porta cofre //
	if(Explosivo[i][explosivo_Tipo] == 3)
	{
		new ca = Explosivo[i][explosivo_ID];
		if(Empresa[ca][em_Existe] == 1)
		{
			if(Cofre[ca][cofre_Status2] == 0)
			{
			    Cofre[ca][cofre_Status2] = 1;
			    Cofre[ca][cofre_Tempo2] = gettime()+(2*(60*60));
				atualizar_cofre(ca, 2);
				salvar_empresa(ca);
			}
			else return 1;
		}
	}

	return 1;
}

stock Input(playerid, IDI, titulo[], texto[], tipo=0)
{
	new estilo;
	if(tipo == 0) estilo = 1;
	else estilo = 3;
	DI_ID[playerid] = IDI;
	DI_Tipo[playerid] = tipo;
	format(DI_Titulo[playerid], 150, titulo);
	format(DI_Texto[playerid], 500, texto);
	ShowPlayerDialog(playerid, DIALOG_INPUT, estilo, titulo, texto, "Continuar", "Fechar");
}

stock Return_Input(playerid)
{
    Input(playerid, DI_ID[playerid], DI_Titulo[playerid], DI_Texto[playerid], DI_Tipo[playerid]);
	return 1;
}

stock DI_Resposta(playerid, response, const inputtext[])
{
	new dialogid = DI_ID[playerid];
	//IsNumeric2


	// salarios //
	if(dialogid == DIALOG_SALARIOS2)
    {
        new i = GetPVarInt(playerid, "org");
        if(response)
		{
            if(strlen(inputtext) < 1)
	        {
	            MS(playerid, 0, "Digite algum valor !");
	            Return_Input(playerid);
	            return 1;
	        }
	        if(!IsNumeric(inputtext))
	        {
	            MS(playerid, 0, "Use apenas numeros !");
	            Return_Input(playerid);
	            return 1;
	        }
	        new numero = strval(inputtext);
	        new org_editando = GetPVarInt(playerid, "org");
	        if(OrgPlayer(playerid) == org_editando) { MS(playerid, 0, "Voce nao pode definir salario para sua propria corporacao !"); mostrar_salarios(playerid); return 1; }
	        if(numero < 500 || numero > 20000)
	        {
	            MS(playerid, 0, "Use um valor entre R$ 500 e R$ 20.000 !");
	            Return_Input(playerid);
	            return 1;
	        }

	        Org[org_editando][o_Salario] = numero;
	        salvar_org(i);
	        mostrar_salarios(playerid);
		    ms(playerid, 1, f("Voce definiu o pagamento da Org '%s' para: R$ %s.", NomeOrg(i), ConvertMoney(numero)));
		    MS(playerid, 1, "Pagamento definido com sucesso !");
		}
        else mostrar_salarios(playerid);
        return 1;
    }

	// sacar do cofre da empresa //
	if(dialogid == DIALOG_SACAR_EMPRESA)
    {
        new a = GetPVarInt(playerid, "empresa");
        if(response)
		{
		    if(strlen(inputtext) < 1)
	        {
	            MS(playerid, 0, "Digite algum valor !");
	            Return_Input(playerid);
	            return 1;
	        }
	        if(!IsNumeric(inputtext))
	        {
	            MS(playerid, 0, "Use apenas numeros !");
	            Return_Input(playerid);
	            return 1;
	        }
	        new numero = strval(inputtext);
	        if(numero < 1 || numero > 1000000)
	        {
	            MS(playerid, 0, "Use um valor entre 1 e 1.000.000 !");
	            Return_Input(playerid);
	            return 1;
	        }
	        if(numero > Empresa[a][em_Cofre])
	        {
	            MS(playerid, 0, f("O cofre da empresa nao tem R$ %s para voce retirar !", ConvertMoney(numero)));
	            Return_Input(playerid);
	            return 1;
	        }

	        MS(playerid, 1, f("Voce retirou R$ %s do cofre da empresa.", ConvertMoney(numero)));
	        Empresa[a][em_Cofre] -= numero;
	        DarGrana(playerid, numero);
	        salvar_empresa(a);
	        texto_empresa(a);
	        abrir_empresa(playerid, a);
		}
		else abrir_empresa(playerid, a);
        return 1;
    }

	// colocar grana na empresa //
    if(dialogid == DIALOG_DEPOSITAR_EMPRESA)
    {
        new a = GetPVarInt(playerid, "empresa");
        if(response)
		{
		    if(strlen(inputtext) < 1)
	        {
	            MS(playerid, 0, "Digite algum valor !");
	            Return_Input(playerid);
	            return 1;
	        }
	        if(!IsNumeric(inputtext))
	        {
	            MS(playerid, 0, "Use apenas numeros !");
	            Return_Input(playerid);
	            return 1;
	        }
	        new numero = strval(inputtext);
	        if(numero < 1 || numero > 1000000)
	        {
	            MS(playerid, 0, "Use um valor entre 1 e 1.000.000 !");
	            Return_Input(playerid);
	            return 1;
	        }
	        if(numero > GranaPlayer(playerid))
	        {
	            MS(playerid, 0, f("Voce nao tem R$ %s em maos para colocar no cofre !", ConvertMoney(numero)));
	            Return_Input(playerid);
	            return 1;
	        }

	        MS(playerid, 1, f("Voce colocou R$ %s no cofre da empresa.", ConvertMoney(numero)));
	        Empresa[a][em_Cofre] += numero;
	        DarGrana(playerid, -numero);
	        salvar_empresa(a);
	        texto_empresa(a);
	        abrir_empresa(playerid, a);
		}
		else abrir_empresa(playerid, a);
        return 1;
    }

	// pagar por produtos //
    if(dialogid == DIALOG_PAGAR_PORDS)
    {
        new a = GetPVarInt(playerid, "empresa");
        if(response)
		{
		    if(strlen(inputtext) < 1)
	        {
	            MS(playerid, 0, "Digite algum valor !");
	            Return_Input(playerid);
	            return 1;
	        }
	        if(!IsNumeric(inputtext))
	        {
	            MS(playerid, 0, "Use apenas numeros !");
	            Return_Input(playerid);
	            return 1;
	        }
	        new numero = strval(inputtext);
	        if(numero < VALOR_PRODUTO || numero > VALOR_PRODUTO*2)
	        {
	            MS(playerid, 0, f("Use um valor entre %d e %d !", VALOR_PRODUTO, VALOR_PRODUTO*2));
	            Return_Input(playerid);
	            return 1;
	        }

	        MS(playerid, 1, f("Voce alterou o valor a pagar por cada produto para R$ %s.", ConvertMoney(numero)));
	        Empresa[a][em_ValorProdutos] = numero;
	        salvar_empresa(a);
	        texto_empresa(a);
	        abrir_empresa(playerid, a);
		}
		else abrir_empresa(playerid, a);
        return 1;
    }

	// entrada empresa //
    if(dialogid == DIALOG_ENTRADA_EMPRESA)
    {
        new a = GetPVarInt(playerid, "empresa");
        if(response)
		{
            if(strlen(inputtext) < 1)
	        {
	            MS(playerid, 0, "Digite algum valor !");
	            Return_Input(playerid);
	            return 1;
	        }
	        if(!IsNumeric(inputtext))
	        {
	            MS(playerid, 0, "Use apenas numeros !");
	            Return_Input(playerid);
	            return 1;
	        }
	        new numero = strval(inputtext);
	        if(numero < 0 || numero > 350)
	        {
	            MS(playerid, 0, "Use um valor entre 0 e 350 !");
	            Return_Input(playerid);
	            return 1;
	        }

	        MS(playerid, 1, f("Voce alterou o valor da entrada na empresa para R$ %s.", ConvertMoney(numero)));
	        Empresa[a][em_Entrada] = numero;
	        salvar_empresa(a);
	        texto_empresa(a);
	        abrir_empresa(playerid, a);
        }
        else abrir_empresa(playerid, a);
        return 1;
    }

	// vender prods caminhao //
    if(dialogid == DIALOG_CONTINUAR_PRODS)
    {
        if(response)
        {
            new car = GetPVarInt(playerid, "car");
	    	new v = GetPVarInt(playerid, "v");
	    	new a = GetPVarInt(playerid, "a");
	    	new precisa = 500-Empresa[a][em_Produtos];
	    	new pagando = Empresa[a][em_ValorProdutos];
            if(strlen(inputtext) < 1)
	        {
	            MS(playerid, 0, "Valor invalido, tente de novo !");
	            Return_Input(playerid);
	            return 1;
	        }
	        if(!IsNumeric(inputtext))
	        {
	            MS(playerid, 0, "Use apenas Numeros !");
	            Return_Input(playerid);
	            return 1;
	        }
	        new numero = strval(inputtext);
            if(numero <= 0)
	        {
	            MS(playerid, 0, "Digite um valor maior que 0 !");
		      	Return_Input(playerid);
				return 1;
	        }
	        if(numero > produtos_veiculo[v])
	        {
	         	MS(playerid, 0, "Nao tem tantos produtos no caminhao, tente um numero menor !");
		      	Return_Input(playerid);
				return 1;

	        }
	        if(numero > precisa)
	        {
	         	MS(playerid, 0, "A empresa nao precisa de tantos produtos !");
		      	Return_Input(playerid);
				return 1;
	        }
	        new tot = precisa*pagando;
	        if(tot > Empresa[a][em_Cofre])
	        {
	            MS(playerid, 0, "A empresa nao possue o valor da compra no cofre !");
		      	Return_Input(playerid);
				return 1;
	        }
            vender_produtos(playerid, v, car, a, numero);
        }
        return 1;
    }

    // comprar prods caminhao //
    if(dialogid == DIALOG_COMPRAR_PRODS)
    {
        if(response)
        {
            new cap = GetPVarInt(playerid, "cap");
            if(strlen(inputtext) < 1)
	        {
	            MS(playerid, 0, "Valor invalido, tente de novo !");
	            Return_Input(playerid);
	            return 1;
	        }
	        if(!IsNumeric(inputtext))
	        {
	            MS(playerid, 0, "Use apenas Numeros !");
	            Return_Input(playerid);
	            return 1;
	        }
	        new numero = strval(inputtext);
            if(numero <= 0)
	        {
	            MS(playerid, 0, "Digite um valor maior que 0 !");
		      	Return_Input(playerid);
				return 1;
	        }

	        if(numero > cap)
	        {
	    		MS(playerid, 0, "Nao cabem tantos produtos no Caminhao, tente um numero menor !");
		      	Return_Input(playerid);
				return 1;
	        }
	        continuar_comprar_prods(playerid, numero);
		}
		return 1;
	}

	// COLOCAR CASA A VENDA VALOR //
    if(dialogid == DIALOG_CASAS_VENDER)
    {
        new i = GetPVarInt(playerid, "casa");
        if(response)
        {
            // setar mundo //
            if(strlen(inputtext) < 1)
	        {
	            MS(playerid, 0, "Valor invalido, tente denovo !");
	            Return_Input(playerid);
	            return 1;
	        }
	        if(!IsNumeric(inputtext))
	        {
	            MS(playerid, 0, "Use apenas Numeros !");
	            Return_Input(playerid);
	            return 1;
	        }
	        new numero = strval(inputtext);
            if(numero <= 0)
	        {
	            MS(playerid, 0, "Digite um valor maior que 0 !");
		      	Return_Input(playerid);
				return 1;
	        }

	        if(numero > 5000000)
	        {
	    		MS(playerid, 0, "O valor deve ser no maximo 5.000.000 !");
		      	Return_Input(playerid);
				return 1;
	        }

	        Casa[i][casa_Valor] = numero;
	        Casa[i][casa_Venda] = 1;
	        atualizar_casa(i);
		    salvar_casa(i);
		    abrir_casa(playerid, i);
		    MS(playerid, 1, "Valor escolhido com sucesso, Voce pode anunciar na OLX sem pagar nada.");
		    return 1;
	    }
	    abrir_casa(playerid, i);
        return 1;
    }

	// editar locais //
	if(dialogid == DIALOG_VALOR_LOCAL)
	{
	    new cidadee = GetPVarInt(playerid, "cidade");
	    new a = GetPVarInt(playerid, "a");
	    new opcao = GetPVarInt(playerid, "opcao");
	    new nome[100];
		GetPVarString(playerid, "nome", nome, 100);
	    if(response)
	    {
	        if(opcao == 0)
	        {
	            // alterar nome //
		        if(strlen(inputtext) < 3)
		        {
		            MS(playerid, 0, "Nome muito Curto, tente um Nome mais longo !");
		            Return_Input(playerid);
		            return 1;
		        }
		        new sss[300];
		        if(cidadee == 0) format(Local_LosSantos[a][local_Nome], 100, inputtext);
		        if(cidadee == 1) format(Local_SanFierro[a][local_Nome], 100, inputtext);
		        if(cidadee == 2) format(Local_LasVenturas[a][local_Nome], 100, inputtext);
		        format(sss, 300, "Novo nome do local da cidade '%s' alterado para '%s'.", cidade2(cidadee), inputtext);
		        ms(playerid, 5, sss);
		        salvar_definicoes("Locais", cidadee, a);
			}
			if(opcao == 2)
	        {
	            // setar interior //
                if(strlen(inputtext) < 1)
		        {
		            MS(playerid, 0, "ID de Interior Invalido, tente usar um valor de 0 a 50 !");
		            Return_Input(playerid);
		            return 1;
		        }
		        if(!IsNumeric(inputtext))
		        {
		            MS(playerid, 0, "ID de Interior Invalido, tente usar um valor de 0 a 50 !");
		            Return_Input(playerid);
		            return 1;
		        }
		        new numero = strval(inputtext);
		        if(numero < 0 || numero > 50)
		        {
		            MS(playerid, 0, "ID de Interior Invalido, tente usar um valor de 0 a 50 !");
		            Return_Input(playerid);
		            return 1;
		        }
		        new sss[300];
		        if(cidadee == 0) Local_LosSantos[a][local_Interior] = numero;
		        if(cidadee == 1) Local_SanFierro[a][local_Interior] = numero;
		        if(cidadee == 2) Local_LasVenturas[a][local_Interior] = numero;
		        format(sss, 300, "Novo ID de Interior do local '%s' alterado para '[%d]'.", nome, numero);
		        ms(playerid, 5, sss);
		        salvar_definicoes("Locais", cidadee, a);
	        }
            if(opcao == 3)
	        {
	            // setar mundo //
                if(strlen(inputtext) < 1)
		        {
		            MS(playerid, 0, "ID de Interior Invalido, tente usar um valor de 0 a 50 !");
		            Return_Input(playerid);
		            return 1;
		        }
		        if(!IsNumeric(inputtext))
		        {
		            MS(playerid, 0, "ID de Interior Invalido, tente usar um valor de 0 a 50 !");
		            Return_Input(playerid);
		            return 1;
		        }
		        new numero = strval(inputtext);
		        if(numero < 0 || numero > 50)
		        {
		            MS(playerid, 0, "ID de Interior Invalido, tente usar um valor de 0 a 50 !");
		            Return_Input(playerid);
		            return 1;
		        }
		        new sss[300];
		        if(cidadee == 0) Local_LosSantos[a][local_Mundo] = numero;
		        if(cidadee == 1) Local_SanFierro[a][local_Mundo] = numero;
		        if(cidadee == 2) Local_LasVenturas[a][local_Mundo] = numero;
		        format(sss, 300, "Novo ID de Mundo do local '%s' alterado para '[%d]'.", nome, numero);
		        ms(playerid, 5, sss);
		        salvar_definicoes("Locais", cidadee, a);
	        }
	    }
	    opcoes_editar_local(playerid, cidadee, a);
	    return 1;
	}

	// detran placa //
	if(dialogid == DIALOG_PLACA)
	{
	    if(response)
	    {
	        if(strlen(inputtext) < 3)
	        {
	            MS(playerid, 0, "Nenhum veiculo encontado !");
	            Return_Input(playerid);
	            return 1;
	        }
	        foreach(new a:Iter_Veiculos)
	        {
	            if(Veiculo[a][v_Existe] == 1)
	            {
					if(Veiculo[a][v_Emplacar] == 0)
	            	{
						if(Comparar(inputtext, PlacaVeiculo[a]))
						{
						    mostrar_multas_veiculo(playerid, a);
						    return 1;
						}
					}
	            }
	        }
	        MS(playerid, 0, "Nenhum veiculo encontado !");
         	Return_Input(playerid);
	    }
	    return 1;
	}

	// grana do trade //
	if(dialogid == DIALOG_GRANA_TRADE)
	{
	    if(response)
	    {
			if(mostrando_trade[playerid] == 1)
			{
			    new pla = negociando[playerid];
		       	if(Online(pla))
	            {
	                if(strlen(inputtext) < 1)
				{
				    ms(playerid, 0, "Use apenas numeros !");
				    Return_Input(playerid);
				    return 1;
				}
				if(!IsNumeric(inputtext))
				{
				    ms(playerid, 0, "Use apenas numeros !");
				    Return_Input(playerid);
				    return 1;
		        	}
		        	new numero = strval(inputtext);
					if(numero > GranaPlayer(playerid))
					{
					    ms(playerid, 0, "Voce nao tem todo esse valor em maos !");
				    Return_Input(playerid);
				    return 1;
					}
					trade_grana[playerid] = numero;
					if(trade_aceitou[pla] == 1)
	                {
	                    trade_aceitou[pla] = 0;
	                    mostrar_trade(playerid, 2);
						mostrar_trade(pla, 2);
	                }
	                mostrar_trade(playerid, 3);
	            	mostrar_trade(pla, 3);
	            }
			}
		}
	    return 1;
	}

	// cash do trade //
	if(dialogid == DIALOG_CASH_TRADE)
	{
	    if(response)
	    {
			if(mostrando_trade[playerid] == 1)
			{
			    new pla = negociando[playerid];
		       	if(Online(pla))
	            {
	                if(strlen(inputtext) < 1)
				{
				    ms(playerid, 0, "Use apenas numeros !");
				    Return_Input(playerid);
				    return 1;
				}
				if(!IsNumeric(inputtext))
				{
				    ms(playerid, 0, "Use apenas numeros !");
				    Return_Input(playerid);
				    return 1;
		        	}
		        	new numero = strval(inputtext);
					if(numero > CashPlayer(playerid))
					{
					    ms(playerid, 0, "Voce nao tem todo esse valor em Cash !");
				    Return_Input(playerid);
				    return 1;
					}
					trade_cash[playerid] = numero;
					if(trade_aceitou[pla] == 1)
	                {
	                    trade_aceitou[pla] = 0;
	                    mostrar_trade(playerid, 2);
						mostrar_trade(pla, 2);
	                }
	                mostrar_trade(playerid, 3);
	            	mostrar_trade(pla, 3);
	            }
			}
		}
	    return 1;
	}

	// editar item loja //
	if(dialogid == DIALOG_EDITAR_ITEM_LOJA)
	{
	    new a = GetPVarInt(playerid, "item");
	    new opc = GetPVarInt(playerid, "opc");
	    if(response)
	    {
	        // nome //
        	if(opc == 0)
        	{
                if(strlen(inputtext) < 3)
	        	{
		            ms(playerid, 0, "Nome Muito curto, tete novamente !");
		            Return_Input(playerid);
		            return 1;
		        }

		        format(Loja[a][loja_Nome], 100, inputtext);
		        ms(playerid, 1, "Nome do Item da Lista alterado com sucesso !");
		        editar_loja_item_opcoes(playerid, a);
		        salvar_loja(a);
		        return 1;
        	}

        	// info //
        	if(opc == 1)
        	{
                if(strlen(inputtext) < 3)
	        	{
		            ms(playerid, 0, "Informacoes Muito curta, tete novamente !");
		            Return_Input(playerid);
		            return 1;
		        }

		        format(Loja[a][loja_Info], 200, inputtext);
		        ms(playerid, 1, "Informacoes do item do Item da Lista alterado com sucesso !");
		        editar_loja_item_opcoes(playerid, a);
		        salvar_loja(a);
		        return 1;
        	}


	        if(strlen(inputtext) < 1)
	        {
	            ms(playerid, 0, "Use apenas numeros !");
	            Return_Input(playerid);
	            return 1;
	        }
	        if(!IsNumeric(inputtext))
	        {
	            ms(playerid, 0, "Use apenas numeros !");
	            Return_Input(playerid);
	            return 1;
        	}
        	new numero = strval(inputtext);

        	// valor //
        	if(opc == 2)
        	{
				if(numero <= 0)
				{
				    ms(playerid, 0, "Use um valor maior que 0 !");
	            	Return_Input(playerid);
	            	return 1;
				}
				Loja[a][loja_Valor] = numero;
		        ms(playerid, 1, "Valor do item do Item da Lista alterado com sucesso !");
		        editar_loja_item_opcoes(playerid, a);
		        salvar_loja(a);
        	}

        	// id //
        	if(opc == 3)
        	{
                if(numero < 0 || (numero > sizeof Itens && numero != 1000 && numero != 9998))
				{
				    ms(playerid, 0, "ID de Item de inventario invalido ! Use /listaitems.");
				    ms(playerid, 0, "Para criar um VIP ou SOCIO use 1000. Para Faccao use 9998.");
	            	Return_Input(playerid);
	            	return 1;
				}
				Loja[a][loja_ID] = numero;
		        if(numero != 1000) ms(playerid, 1, "ID do item do Item da Lista alterado com sucesso !");
		        else ms(playerid, 1, "VIP ou SOCIO criado, defina o TIPO do beneficio e o TEMPO em dias !");
		        editar_loja_item_opcoes(playerid, a);
		        salvar_loja(a);
        	}

        	// unidades //
        	if(opc == 4)
        	{
                if(numero <= 0)
				{
				    ms(playerid, 0, "Use um valor maior que 0 !");
	            	Return_Input(playerid);
	            	return 1;
				}
				Loja[a][loja_Unidades] = numero;
		        ms(playerid, 1, "Unidades do item do Item da Lista alterado com sucesso !");
		        editar_loja_item_opcoes(playerid, a);
		        salvar_loja(a);
        	}

        	// tipo //
        	if(opc == 5)
        	{
                if(numero < 0)
				{
				    ms(playerid, 0, "Use um valor maior ou igual a 0 !");
	            	Return_Input(playerid);
	            	return 1;
				}
				Loja[a][loja_Tipo] = numero;
		        ms(playerid, 1, "Tipo do item do Item da Lista alterado com sucesso !");
		        editar_loja_item_opcoes(playerid, a);
		        salvar_loja(a);
        	}

        	// tempo //
        	if(opc == 6)
        	{
                if(numero < 0)
				{
				    ms(playerid, 0, "Use 0 para o item ser permanente ou determine quantos dias ele tera.");
	            	Return_Input(playerid);
	            	return 1;
				}
				Loja[a][loja_Tempo] = numero;
		        ms(playerid, 1, "Tempo em dias do item do Item da Lista alterado com sucesso !");
		        editar_loja_item_opcoes(playerid, a);
		        salvar_loja(a);
        	}

	    }
	    else editar_loja_item_opcoes(playerid, a);
	    return 1;
	}

	// nome da lista da loja //
	if(dialogid == DIALOG_NOME_LOJA_LISTA)
	{
	    new a = GetPVarInt(playerid, "lista");
	    if(response)
	    {
	        if(strlen(inputtext) < 3) return ms(playerid, 0, "Nome muito curto, Use um nome maior !");
	        format(Loja[a][loja_Nome], 100, inputtext);
	        ms(playerid, 1, "Nome da Lista alterado com sucesso !");
	        editar_loja_lista_opcoes(playerid, a);
	        salvar_loja(a);
	    }
		else editar_loja_lista_opcoes(playerid, a);
	    return 1;
	}

	// item permantente ou temporario //
	if(dialogid == DIALOG_ITEM_PERMANENTE)
	{
	    if(response)
	    {
	        if(!IsNumeric(inputtext))
	        {
	            ms(playerid, 0, "Use apenas numeros !");
	            Return_Input(playerid);
	            return 1;
        	}
        	new numero = strval(inputtext);
		    if(numero < 0)
		    {
		    	ms(playerid, 0, "Use um valor maior ou igual a 0 !");
	            Return_Input(playerid);
	            return 1;
		    }
		    item_perma(playerid, numero);
	    }
	    return 1;
	}

	// veiculo permantente ou temporario //
	if(dialogid == DIALOG_VEICULO_PERMANENTE)
	{
	    if(response)
	    {
	        if(!IsNumeric(inputtext))
	        {
	            ms(playerid, 0, "Use apenas numeros !");
	            Return_Input(playerid);
	            return 1;
        	}
        	new numero = strval(inputtext);
		    if(numero < 0)
		    {
		    	ms(playerid, 0, "Use um valor maior ou igual a 0 !");
	            Return_Input(playerid);
	            return 1;
		    }
		    rc_perma(playerid, numero);
	    }
	    return 1;
	}

	// acessorio permantente ou temporario //
	if(dialogid == DIALOG_AC_PERMANENTE)
	{
	    if(response)
	    {
	        if(!IsNumeric(inputtext))
	        {
	            ms(playerid, 0, "Use apenas numeros !");
	            Return_Input(playerid);
	            return 1;
        	}
        	new numero = strval(inputtext);
		    if(numero < 0)
		    {
		    	ms(playerid, 0, "Use um valor maior ou igual a 0 !");
	            Return_Input(playerid);
	            return 1;
		    }
		    e_perma(playerid, numero);
	    }
	    return 1;
	}

	// colocar valor org //
	if(dialogid == DIALOG_ORG20)
	{
		new i = GetPVarInt(playerid, "id_org");
		new c = id[playerid];
		if(c == -1) return 1;
		if(response)
		{
		    new sss[150];
		    if(!IsNumeric(inputtext))
	        {
	            ms(playerid, 0, "Use apenas numeros !");
	            Return_Input(playerid);
	            return 1;
        	}
		    new numero = strval(inputtext);
		    if(numero <= 0)
		    {
		    	ms(playerid, 0, "Use um valor maior que 0 !");
	            Return_Input(playerid);
	            return 1;
		    }
		    if(numero > GranaPlayer(playerid))
		    {
		    	MS(playerid, 0, "Voce nao possue este valor em maos !");
	            Return_Input(playerid);
	            return 1;
		    }

		    Org[i][o_Cofre] += numero;
		    DarGrana(playerid, -numero);
		    salvar_org(i);
		    format(sss, 150, "Voce colocou R$ %s no cofre da org.", ConvertMoney(numero));
			escrever_log(f("OrgsLog/Org_%d.txt", i), f("'%s' Colocou R$ %s de Grana no Cofre.", Nome(playerid), ConvertMoney(numero)));
			ms(playerid, 1, sss);
			mostrar_cofre_org(playerid, i);
	    }
	    else mostrar_cofre_org(playerid, i);
	}

	// tirar valor org //
	if(dialogid == DIALOG_ORG19)
	{
		new i = GetPVarInt(playerid, "id_org");
		new c = id[playerid];
		if(c == -1) return 1;
		if(Conta[playerid][c_Cargo] < 5 && !Scripter(playerid)) return ms(playerid, 0, "Apenas Lider e SubLider podem retirar dinheiro do cofre !");
		if(response)
		{
		    new sss[150];
		    if(!IsNumeric(inputtext))
	        {
	            ms(playerid, 0, "Use apenas numeros !");
	            Return_Input(playerid);
	            return 1;
        	}
		    new numero = strval(inputtext);
		    if(numero <= 0)
		    {
		    	ms(playerid, 0, "Use um valor maior que 0 !");
	            Return_Input(playerid);
	            return 1;
		    }
		    if(numero > Org[i][o_Cofre])
		    {
		    	ms(playerid, 0, "A org nao possue esse valor no cofre !");
	            Return_Input(playerid);
	            return 1;
		    }

		    Org[i][o_Cofre] -= numero;
		    DarGrana(playerid, numero);
		    salvar_org(i);
		    format(sss, 150, "Voce retirou R$ %s do cofre da org.", ConvertMoney(numero));
			ms(playerid, 1, sss);
			escrever_log(f("OrgsLog/Org_%d.txt", i), f("'%s' Retirou R$ %s de Grana do Cofre.", Nome(playerid), ConvertMoney(numero)));
			mostrar_cofre_org(playerid, i);
	    }
	    else mostrar_cofre_org(playerid, i);
	}

    // setar quantidade para colete //
	if(dialogid == DIALOG_FABRICACAO6)
	{
	    if(response)
	    {
	        if(!IsNumeric(inputtext))
	        {
	            ms(playerid, 0, "Use apenas numeros !");
	            Return_Input(playerid);
	            return 1;
        	}
        	new numero = strval(inputtext);
			new material = GetPVarInt(playerid, "material");
		    if(material < 4)
		    {
                coletes_org[0][material+1] = numero;
                fabricacao(playerid, 0);
		    }
		    else
		    {
				coletes_org[0][6] = numero;
				fabricacao(playerid, 0);
		    }
		    salvar_fabricacao();
	    }
	    else fabricacao(playerid, 0);
	    return 1;
	}

	// setar quantidade para municao //
	if(dialogid == DIALOG_FABRICACAO7)
	{
	    if(response)
	    {
	        new mun = GetPVarInt(playerid, "municao");
	        if(!IsNumeric(inputtext))
	        {
	            ms(playerid, 0, "Use apenas numeros !");
	            Return_Input(playerid);
	            return 1;
        	}
        	new numero = strval(inputtext);
			new material = GetPVarInt(playerid, "material");
		    if(material < 4)
		    {
                municoes_org[mun][material+1] = numero;
                fabricacao(playerid, 1);
		    }
		    else
		    {
				municoes_org[mun][6] = numero;
				fabricacao(playerid, 1);
		    }
		    salvar_fabricacao();
	    }
	    else fabricacao(playerid, 1);
	    return 1;
	}

	if(dialogid == DIALOG_FABRICACAO8)
	{
	    if(response)
	    {
	        new arma = GetPVarInt(playerid, "arma");
	        if(!IsNumeric(inputtext))
	        {
	            ms(playerid, 0, "Use apenas numeros !");
	            Return_Input(playerid);
	            return 1;
        	}
        	new numero = strval(inputtext);
			new material = GetPVarInt(playerid, "material");
		    if(material < 4)
		    {
                armas_org[arma][material+1] = numero;
                fabricacao(playerid, 2);
		    }
		    else
		    {
				armas_org[arma][6] = numero;
				fabricacao(playerid, 2);
		    }
		    salvar_fabricacao();
	    }
	    else fabricacao(playerid, 2);
	    return 1;
	}

	// dialog logar colocar senha //
	if(dialogid == DIALOG_SENHA)
	{
	    if(response)
	    {
	        new conta = GetPVarInt(playerid, "conta");
	        new senha[40];
	        format(senha, 40, GetContaString(conta, "c_Senha"));
	        if(strlen(inputtext) < 4 || strlen(inputtext) > 12)
			{
				ShowPlayerDialog(playerid, DIALOG_ERROU_SENHA, DIALOG_STYLE_MSGBOX, "SENHA INCORRETA", "\n\n{FF0000}[ERRO] {A1A1A1}Sua senha esta incorreta !\n\n", "Ok", "Fechar");
				return 1;
			}
			if(!Comparar(inputtext, senha))
			{
				ShowPlayerDialog(playerid, DIALOG_ERROU_SENHA, DIALOG_STYLE_MSGBOX, "SENHA INCORRETA", "\n\n{FF0000}[ERRO] {A1A1A1}Sua senha esta incorreta !\n\n", "Ok", "Fechar");
				return 1;
			}
			if(!Banido(playerid, conta))
			{
		        // stop na musica //
		        if(carregou_texts[playerid] == 0) CriarTextDrawsPlayer(playerid);
		        for(new a; a<4; a++) TextDrawShowForPlayer(playerid, T_CarregandoConta[a]);
				contas[playerid] = conta;
				setar_lobby(playerid);
			}
			else
			{
			    new ipplayer[20];
			    GetPlayerIp(playerid, ipplayer, 20);
			    salvar_conta(conta, 2, "c_IP", ipplayer);
			}
	    }
	    else Login(playerid);
	    return 1;
	}

	// dialog logar pra entrar //
	if(dialogid == DIALOG_LOGIN)
	{
	    if(response)
	    {
	        new conta = strval(inputtext);
			if(strlen(inputtext) < 1)
			{
				ShowPlayerDialog(playerid, DIALOG_ERROU_LOGIN, DIALOG_STYLE_MSGBOX, "ERRO NO LOGIN", "\n\n{FF0000}[ERRO] {A1A1A1}Use o ID de sua conta corretamente !\n\n", "Ok", "Voltar");
				return 1;
			}
			if(!IsNumeric(inputtext))
			{
				ShowPlayerDialog(playerid, DIALOG_ERROU_LOGIN, DIALOG_STYLE_MSGBOX, "ERRO NO LOGIN", "\n\n{FF0000}[ERRO] {A1A1A1}Por favor, use apenas numeeros !\n\n", "Ok", "Voltar");
				return 1;
			}
			if(!ContaValida(conta))
			{
				ShowPlayerDialog(playerid, DIALOG_ERROU_LOGIN, DIALOG_STYLE_MSGBOX, "ERRO NO LOGIN", "\n\n{FF0000}[ERRO] {A1A1A1}Esta conta nao existe em nosso servidor !\n\n", "Ok", "Voltar");
				return 1;
			}
			SetPVarInt(playerid, "conta", conta);
			Senha(playerid);
		}
	    else{
	    	mostrar_login(playerid);
	    }
	}

	return 1;
}

stock sair_tuning(playerid)
{
    // BCG: saida segura do tuning. Nao respawna o player e nao chama callbacks manualmente.
    funcao_usando[playerid] = -1;
    editando[playerid] = 0;
    tunando[playerid] = 0;
    DeletePVar(playerid, "tunando");
    CancelSelectTextDraw(playerid);
    ms(playerid, 1, "Voce saiu do modo de Tuning.");
    return 1;
}

stock comecar_tunagem(playerid, veh)
{
    // BCG: tuning simplificado. Evita Spectate/PlayerSpawn e os loops antigos.
    if(!IsPlayerConnected(playerid)) return 0;
    if(veh <= 0 || GetVehicleModel(veh) == 0) return ms(playerid, 0, "Veiculo invalido para tuning."), 0;
    if(Info_Veiculo[veh] == -1) return ms(playerid, 0, "Este veiculo nao pode ser tunado."), 0;

    SetPVarInt(playerid, "tunando", veh);
    tunando[playerid] = 1;
    Mostrar_Tuning(playerid, veh);
    return 1;
}

stock menu_tuning(playerid)
{
    new veh = GetPVarInt(playerid, "tunando");
    if(tunando[playerid] != 1 || veh <= 0 || GetVehicleModel(veh) == 0)
    {
        tunando[playerid] = 0;
        DeletePVar(playerid, "tunando");
        return ms(playerid, 0, "Nenhum veiculo esta aberto no tuning."), 0;
    }
    if(Info_Veiculo[veh] == -1)
    {
        tunando[playerid] = 0;
        DeletePVar(playerid, "tunando");
        return ms(playerid, 0, "Este veiculo nao pode ser tunado."), 0;
    }

    Mostrar_Tuning(playerid, veh);
    return 1;
}

stock msg_noob(playerid, const avi[])
{
	new sss[300];// {20B2AA}>(/n)[{FF0000}Player{20B2AA}]%s[%d] diz: %s
	//format(sss, 300, "{2E8B57}[Chat Noob] {3CB371}%s {00ffff}%d {ffff00}%d: {3CB371}%s", Nome(playerid), id[playerid], playerid, avi);
	format(sss, 300, "{20B2AA}>(/n)[{FF0000}Player{20B2AA}]%s[%d](%d) diz: %s", Nome(playerid), id[playerid], playerid, avi);
	foreach(new a:Player)
	{
	    if(Online(a))
	    {
	        new c = id[a];
	        if(c != -1)
	        {
	            if(Conta[a][c_Noob] == 0)
	            {
	                ms(a, 4, sss);
	            }
	        }
	    }
	}
	SetPVarInt(playerid, "flood_noob", gettime()+30);
	return 1;
}

stock msg_rnoob(playerid, p, const avi[])
{
	new sss[300];
	format(sss, 300, "{2E8B57}[Chat Noob] {3CB371}%s {ffff00}@%s {3CB371}%s", Nome(playerid), Nome(p), avi);
	foreach(new a:Player)
	{
	    if(Online(a))
	    {
	        new c = id[a];
	        if(c != -1)
	        {
	            if(Conta[a][c_Noob] == 0)
	            {
	                ms(a, 4, sss);
	            }
	        }
	    }
	}
	SetPVarInt(playerid, "flood_noob", gettime()+30);
	return 1;
}

stock ban_noob(playerid, cc, temp, const mot[])
{
    new sss[300];
    new player = ContaOnline(cc);
    if(temp > 0)
    {
	    format(sss, 300, "{F08080}[Chat Noob] O admin '%s' bloqueou '%s' do Chat Noob por [%s], motivo: %s.", Nome(playerid), NomeConta(cc), ConvertTime(temp), mot);
		if(Online(player)) Conta[player][c_BanNoob] = gettime()+(temp*60);
		else salvar_conta(cc, 0, "c_BanNoob", sv_int(gettime()+(temp*60)));
	}
	else
	{
	    format(sss, 300, "{F08080}[Chat Noob] O admin '%s' desbloqueou '%s' do Chat Noob, motivo: %s.", Nome(playerid), NomeConta(cc), mot);
	    if(Online(player)) Conta[player][c_BanNoob] = 0;
		else salvar_conta(cc, 0, "c_BanNoob", sv_int(0));
	}

	foreach(new a:Player)
	{
	    if(Online(a))
	    {
	        new c = id[a];
	        if(c != -1)
	        {
	            if(Conta[a][c_Noob] == 0)
	            {
	                ms(a, 4, sss);
	            }
	        }
	    }
	}
	return 1;
}

stock tem_motorista(v)
{
	if(GetVehicleModel(v) != 0)
	{
		foreach(new i:Player)
		{
		    if(Online(i))
		    {
		        if(IsPlayerInAnyVehicle(i))
		        {
		            if(GetPlayerVehicleID(i) == v)
		            {
		                if(GetPlayerVehicleSeat(i) == 0)
		                {
		                    return 1;
		                }
		            }
		        }
		    }
	    }
	}
	return 0;
}

stock alguem_pegando(item)
{
	foreach(new i:Player)
	{
	    if(Online(i))
	    {
	        if(Barra[i][b_Acao] == 12)
	        {
	            if(pegando_grana[i] == item)
	            {
	                return 1;
	            }
	        }
		 }
	}
	return 0;
}

stock aviso_lavar_dinheiro(playerid, grana)
{
	new sss[600];
	format(sss, 600, "\
	\
	{ffff00}LAVAGEM DE DINHEIRO\n\n\
	\
	{ffffff}Quando voce lava seu {00ffff}dinheiro sujo {ffffff}no mercado negro, voce\n\
	recebe apenas a {ffff00}metade {ffffff}do valor total, voce tem {4169E1}R$ %s {ffffff}para\n\
	lavar, deseja realmente continuar ?\n\n\
	\
	{ffffff}Valor a receber: {4169E1}R$ %s\n\n", ConvertMoney(grana), ConvertMoney(grana/2));
	ShowPlayerDialog(playerid, DIALOG_LAVAR, DIALOG_STYLE_MSGBOX, "{000000}_", sss, "Lavar", "Cancelar");
	return 1;
}

stock menu_escada(playerid, a, opc=-123)
{
	if(GetVehicleModel(a) != 0)
	{
	    SetPVarInt(playerid, "veic", a);
		new i = Info_Veiculo[a];
		if(i != -1)
		{
		    if(opc != -123)
		    {
                if(opc == -1)
				{
				    if(escada_veiculo[a] == -1) ms(playerid, 0, "A escada do veiculo nao esta em uso !");
					else
					{
						if(IsValidDynamicObject(escada_obj[a])) DestroyDynamicObject_(escada_obj[a]);
						escada_veiculo[a] = opc;
						ms(playerid, 1, "A escada do veiculo foi removida.");
					}
				}
                else
                {
                    if(opc != escada_veiculo[a])
                    {
	                    if(IsValidDynamicObject(escada_obj[a])) DestroyDynamicObject_(escada_obj[a]);
					escada_obj[a] = CreateDynamicObject(8572, 0, 0, 0, 0, 0, 0);
				    	AttachDynamicObjectToVehicle(escada_obj[a], a, pos_escada[opc][0], pos_escada[opc][1], pos_escada[opc][2], 0, 0, 0);
						if(escada_veiculo[a] != -1) ms(playerid, 1, "Posicao da escada alterada.");
						else ms(playerid, 1, "A escada foi colocada.");
						escada_veiculo[a] = opc;

						foreach(new p:Player)
						{
						    if(Online(p))
							{
								if(IsPlayerInAnyVehicle(p))
								{
								    if(GetPlayerVehicleID(p) == a)
									{
									RemovePlayerFromVehicle(p);
									ms(p, 0, "Nao e possivel ficar no veiculo enquanto a escada e usada !");
								    }
								}
							}
						}
					}
				}
				return 1;
		    }
		    ShowPlayerDialog(playerid, DIALOG_ESCADA, DIALOG_STYLE_LIST, "Escada do veiculo", "Posicao 1\nPosicao 2\nPosicao 3\nPosicao 4\nPosicao 5\n{ff0000}Remover", "Contiuar", "Fechar");
		}
	}
	return 1;
}


stock player_concertar(playerid, tipo, cc)
{
	// caixa eletronico //
	if(tipo == 0)
	{
		if(alguem_concertando(tipo, cc)) return ms(playerid, 0, "Aguem ja esta concertando este caixa eletronico !");
		eletricista_tipo[playerid] = tipo;
		eletricista_ID[playerid] = cc;
		Acao(playerid, 14, 600, "CONCERTANDO CAIXA", 1, "OTB", "BETSLP_LKABT", true);
		SetPlayerAttachedObject(playerid, 9, 18644, 6, 0.069999, 0.045999, -0.014000, 0.000000, -179.300003, 0.000000, 1.000000, 1.000000, 1.000000);
		SetPlayerToFacePos(playerid, CaixaEletronico[cc][ce_X], CaixaEletronico[cc][ce_Y]);
	}

	// radar //
	if(tipo == 1)
	{
		if(alguem_concertando(tipo, cc)) return ms(playerid, 0, "Aguem ja esta concertando este Radar !");
		eletricista_tipo[playerid] = tipo;
		eletricista_ID[playerid] = cc;
		Acao(playerid, 14, 600, "CONCERTANDO RADAR", 1, "OTB", "BETSLP_LKABT", true);
		SetPlayerAttachedObject(playerid, 9, 18644, 6, 0.069999, 0.045999, -0.014000, 0.000000, -179.300003, 0.000000, 1.000000, 1.000000, 1.000000);
        SetPlayerToFacePos(playerid, Radar[cc][radar_X], Radar[cc][radar_Y]);
	}

	// camera //
	if(tipo == 2)
	{
        if(alguem_concertando(tipo, cc)) return ms(playerid, 0, "Aguem ja esta concertando esta Camera  !");
		eletricista_tipo[playerid] = tipo;
		eletricista_ID[playerid] = cc;
		Acao(playerid, 14, 600, "CONCERTANDO CAMERA", 1, "OTB", "BETSLP_LKABT", true);
		SetPlayerAttachedObject(playerid, 9, 18644, 6, 0.069999, 0.045999, -0.014000, 0.000000, -179.300003, 0.000000, 1.000000, 1.000000, 1.000000);
        SetPlayerToFacePos(playerid, Camera[cc][cam_X], Camera[cc][cam_Y]);
	}

	// camera caixa //
	if(tipo == 3)
	{
        if(alguem_concertando(tipo, cc)) return ms(playerid, 0, "Aguem ja esta concertando esta Camera  !");
		eletricista_tipo[playerid] = tipo;
		eletricista_ID[playerid] = cc;
		Acao(playerid, 14, 600, "CONCERTANDO CAMERA", 1, "OTB", "BETSLP_LKABT", true);
		SetPlayerAttachedObject(playerid, 9, 18644, 6, 0.069999, 0.045999, -0.014000, 0.000000, -179.300003, 0.000000, 1.000000, 1.000000, 1.000000);
        SetPlayerToFacePos(playerid, CaixaEletronico[cc][cec_X], CaixaEletronico[cc][cec_Y]);
	}
	return 1;
}

stock alguem_concertando(tipo, cc)
{
	foreach(new i:Player)
	{
	    if(Online(i))
	    {
	        if(Barra[i][b_Acao] == 14)
	        {
	            if(eletricista_tipo[i] == tipo)
	            {
	                if(eletricista_ID[i] == cc)
	            	{
	                	return 1;
	                }
	            }
	        }
		 }
	}
	return 0;
}

stock QuebrarRadares()
{
	new que;
    foreach(new r:Iter_Radares)
    {
        if(Radar[r][radar_Existe] == 1)
        {
            if(Radar[r][radar_Ativado] == 1)
            {
                que = random(3);
			    if(que == 0) Radar[r][radar_Ativado] = 0;
			    texto_radar(r);
				salvar_radar(r);
            }
        }
    }
	return 1;
}

stock mostrar_coisas_quebradas(playerid)
{
	SG[0] = EOS;
	new sss[200];
	new cont;
	strcat(SG, "Equipamento\tCidade\n");
    zerar_lista(playerid, 1);
	for(new t; t<75; t++)
	{
	    if(cont >= MAX_LISTA) break;
	    Lista[playerid][t] = -1;
	    Lista2[playerid][t] = -1;
	}

	foreach(new i:Iter_CaixasEletronicos)
	{
	    if(cont == 75) break;
	    if(CaixaEletronico[i][ce_Existe] == 1)
        {
            if(CaixaEletronico[i][ce_Quebrado] == 1)
            {
	            format(sss, 300, "{ffff00}Caixa Eletronico [%d]\t{ffffff}%s\n", i, cidade2(pegar_cidade(-1, CaixaEletronico[i][ce_X], CaixaEletronico[i][ce_Y], CaixaEletronico[i][ce_Z])));
	            strcat(SG, sss);
	            Lista[playerid][cont] =  i;
				Lista2[playerid][cont] = 0;
				cont ++;
	        }
	    }
	}

	foreach(new i:Iter_Radares)
	{
	    if(cont == 75) break;
	    if(Radar[i][radar_Existe] == 1)
        {
            if(Radar[i][radar_Ativado] == 0)
            {
	            format(sss, 300, "{ffff00}Radar de Velocidade [%d]\t{ffffff}%s\n", i, cidade2(pegar_cidade(-1, Radar[i][radar_X], Radar[i][radar_Y], Radar[i][radar_Z])));
	            strcat(SG, sss);
	            Lista[playerid][cont] =  i;
				Lista2[playerid][cont] = 1;
				cont ++;
	        }
	    }
	}

	foreach(new i:Iter_Cameras)
	{
	    if(cont == 75) break;
	    if(Camera[i][cam_Existe] == 1)
        {
            if(Camera[i][cam_Quebrada] == 1)
            {
	            format(sss, 300, "{ffff00}Camera de Seguranca [%d]\t{ffffff}%s\n", i, cidade2(pegar_cidade(-1, Camera[i][cam_X], Camera[i][cam_Y], Camera[i][cam_Z])));
	            strcat(SG, sss);
	            Lista[playerid][cont] =  i;
				Lista2[playerid][cont] = 2;
				cont ++;
	        }
	    }
	}

	foreach(new i:Iter_CaixasEletronicos)
	{
	    if(cont == 75) break;
	    if(CaixaEletronico[i][ce_Existe] == 1)
        {
            if(CaixaEletronico[i][cec_Quebrado] == 1)
            {
	            format(sss, 300, "{ffff00}Camera do Caixa [%d]\t{ffffff}%s\n", i, cidade2(pegar_cidade(-1, CaixaEletronico[i][ce_X], CaixaEletronico[i][ce_Y], CaixaEletronico[i][ce_Z])));
	            strcat(SG, sss);
	            Lista[playerid][cont] =  i;
				Lista2[playerid][cont] = 3;
				cont ++;
	        }
	    }
	}

	ShowPlayerDialog(playerid, DIALOG_ELETRICISTA, DIALOG_STYLE_TABLIST_HEADERS, "Equipamentos quebrados", SG, "Localizar", "Fechar");
	return 1;
}

stock converssas_wp(playerid)
{
	new c = id[playerid];
	if(c == -1) return 1;
	new cont;
	for(new a; a<MAX_WP; a++)
	{
	    if(WP[a][w_Existe] == 1)
	    {
	        if(WP[a][w_Conta][0] == c)
	        {
	    		cont++;
	    	}
	    	else if(WP[a][w_Conta][1] == c)
	    	{
	    	    cont++;
	    	}
	    }
	}
	return cont;
}

stock contatos_wp(playerid)
{
	new c = id[playerid];
	if(c == -1) return 1;
	new cont;
	for(new a; a<MAX_CONTATOS; a++)
	{
	    if(Contatos[playerid][a] != -1)
	    {
	    	cont++;
	    }
	}
	return cont;
}

stock chamadas_wp(playerid)
{
	new c = id[playerid];
	if(c == -1) return 1;
	new cont;
	for(new a; a<MAX_CHAMADAS; a++)
	{
	    if(Chamadas[playerid][a][wp_Existe] == 1)
	    {
	    	cont++;
	    }
	}
	return cont;
}

stock cor_vista(aaa)
{
	new sst[5];
	format(sst, 5, "~w~");
	if(aaa == 1) format(sst, 5, "~y~");
	if(aaa == 2) format(sst, 5, "~r~");
	return sst;
}

stock contatos_whatsapp(playerid)
{
    new c = id[playerid];
	if(c == -1) return 1;
	new cont;
    new contac;

	Item_DC[playerid] = 0;
    format(Titulo_DC[playerid], 100, "CONTATOS");
    format(Lista_DC[playerid][cont][cel_Nome], 100, "~W~~h~ADICIONAR CONTATO");
    Lista_DC[playerid][cont][cel_ID] = 99999;
    cont ++;

    for(new i; i<MAX_CONTATOS; i++)
    {
        Lista_DC[playerid][cont][cel_ID] = -1;
        if(Contatos[playerid][i] != -1)
        {
            contac = Contatos[playerid][i];
            format(Lista_DC[playerid][cont][cel_Nome], 100, "~g~~h~~h~%s", NomeConta(contac));
            Lista_DC[playerid][cont][cel_ID] = i;
            cont ++;
		}
    }

    MAX_DC[playerid] = cont;
    if(cont == 0) Item_DC[playerid] = -1;
    else Item_DC[playerid] = 0;
    ID_DC[playerid] = WHATSAPP_CONTATOS;
	Pagina_DC[playerid] = 0;
	celular(playerid, C_LISTA);
	return 1;
}

stock chamadas_whatsapp(playerid)
{
    new c = id[playerid];
	if(c == -1) return 1;
	Item_DC[playerid] = -1;
    format(Titulo_DC[playerid], 100, "CHAMADAS");
    new cont;
    new contac;
    for(new i; i<MAX_CHAMADAS; i++)
    {
        Lista_DC[playerid][i][cel_ID] = -1;
        if(Chamadas[playerid][i][wp_Existe] == 1)
        {
            contac = Chamadas[playerid][i][wp_Conta];
            format(Lista_DC[playerid][cont][cel_Nome], 100, "%s%s ~b~~h~~h~%s", cor_vista(Chamadas[playerid][i][wp_Vista]), NomeConta(contac), Chamadas[playerid][i][wp_Hora]);
            Lista_DC[playerid][cont][cel_ID] = i;
            cont ++;
		}
    }

    MAX_DC[playerid] = cont;
    if(cont == 0) Item_DC[playerid] = -1;
    else Item_DC[playerid] = 0;
    ID_DC[playerid] = WHATSAPP_CHAMADAS;
	Pagina_DC[playerid] = 0;
	celular(playerid, C_LISTA);
	return 1;
}

stock converssas_whatsapp(playerid)
{
    new c = id[playerid];
	if(c == -1) return 1;
    format(Titulo_DC[playerid], 100, "CONVERSSAS");
    new cont;
    new contac;

    for(new i; i<MAX_WP; i++)
    {
        if(WP[i][w_Existe] == 1)
        {
            if(c == WP[i][w_Conta][0])
			{
			    contac = WP[i][w_Conta][1];
			    if(contac != -1)
				{
				if(WP[i][w_Visto][0] == 0)
				{
                        if(tem_contato(playerid, contac)) format(Lista_DC[playerid][cont][cel_Nome], 100, "~b~~h~~h~%s~w~ - ~p~~h~%s", WP[i][w_Hora], NomeConta(contac));
						else format(Lista_DC[playerid][cont][cel_Nome], 100, "~b~~h~~h~%s~w~ - ~p~~h~%d", WP[i][w_Hora], GetContaInt(contac, "c_Chip"));
						Lista_DC[playerid][cont][cel_ID] = i;
		            	cont ++;
					}
			    }
			}
			else if(c == WP[i][w_Conta][1])
			{
			    contac = WP[i][w_Conta][0];
				{
				if(WP[i][w_Visto][1] == 0)
				{
                        if(tem_contato(playerid, contac)) format(Lista_DC[playerid][cont][cel_Nome], 100, "~b~~h~~h~%s~w~ - ~p~~h~%s", WP[i][w_Hora], NomeConta(contac));
						else format(Lista_DC[playerid][cont][cel_Nome], 100, "~b~~h~~h~%s~w~ - ~p~~h~%d", WP[i][w_Hora], GetContaInt(contac, "c_Chip"));
						Lista_DC[playerid][cont][cel_ID] = i;
		            	cont ++;
					}
				}
			}
		}
    }


    for(new i; i<MAX_WP; i++)
    {
        if(WP[i][w_Existe] == 1)
        {
            if(c == WP[i][w_Conta][0])
			{
			    contac = WP[i][w_Conta][1];
			    if(contac != -1)
				{
				if(WP[i][w_Visto][0] == 1)
				{
                        if(tem_contato(playerid, contac)) format(Lista_DC[playerid][cont][cel_Nome], 100, "~b~~h~~h~%s~w~ - ~w~%s", WP[i][w_Hora], NomeConta(contac));
						else format(Lista_DC[playerid][cont][cel_Nome], 100, "~b~~h~~h~%s~w~ - ~w~~h~%d", WP[i][w_Hora], GetContaInt(contac, "c_Chip"));
						Lista_DC[playerid][cont][cel_ID] = i;
		            	cont ++;
					}
			    }
			}
			else if(c == WP[i][w_Conta][1])
			{
			    contac = WP[i][w_Conta][0];
				{
				if(WP[i][w_Visto][1] == 1)
				{
                        if(tem_contato(playerid, contac)) format(Lista_DC[playerid][cont][cel_Nome], 100, "~b~~h~~h~%s~w~ - ~w~%s", WP[i][w_Hora], NomeConta(contac));
						else format(Lista_DC[playerid][cont][cel_Nome], 100, "~b~~h~~h~%s~w~ - ~w~~h~%d", WP[i][w_Hora], GetContaInt(contac, "c_Chip"));
						Lista_DC[playerid][cont][cel_ID] = i;
		            	cont ++;
					}
				}
			}
		}
    }

    if(cont == 0) Item_DC[playerid] = -1;
    else Item_DC[playerid] = 0;
    MAX_DC[playerid] = cont;
    ID_DC[playerid] = WHATSAPP_CONVERSSAS;
	Pagina_DC[playerid] = 0;
	celular(playerid, C_LISTA);
	return 1;
}

stock abrir_whatsapp(playerid)
{
	new c = id[playerid];
	if(c == -1) return 1;
	format(Lista_DC[playerid][0][cel_Nome], 50, "~p~~h~~h~GRUPO VIP SERVIDOR");
	format(Lista_DC[playerid][1][cel_Nome], 50, "~w~Converssas ~g~%s", ConvertMoney(converssas_wp(playerid)));
	format(Lista_DC[playerid][2][cel_Nome], 50, "~w~Chamadas ~g~%s", ConvertMoney(chamadas_wp(playerid)));
	format(Lista_DC[playerid][3][cel_Nome], 50, "~w~Contatos ~g~%s", ConvertMoney(contatos_wp(playerid)));
	format(Lista_DC[playerid][4][cel_Nome], 50, "~y~Meu Numero");
    ID_DC[playerid] = WHATSAPP_INICIO;
	MAX_DC[playerid] = 5;
	Pagina_DC[playerid] = 0;
	Item_DC[playerid] = 0;
	format(Titulo_DC[playerid], 100, "WHATSAPP - CIDADE GRANDE");
	celular(playerid, C_LISTA);
	return 1;
}


stock abrir_chamada(playerid, conv)
{
    new c = id[playerid];
	if(c == -1) return 1;

	if(Chamadas[playerid][conv][wp_Vista] == 0)
	{
	    format(str_aviso[playerid], 300, "\
		LIGACAO~n~REGISTRADA~n~~n~\
		\
		%s~n~~n~\
		\
		~g~~h~%s lhe ligou e voce aceitou a ligacao.", Chamadas[playerid][conv][wp_Hora], NomeConta(Chamadas[playerid][conv][wp_Conta]));
	}

	if(Chamadas[playerid][conv][wp_Vista] == 1)
	{
        format(str_aviso[playerid], 300, "\
		LIGACAO~n~~y~PERDIDA~w~~n~~n~\
		\
		%s~n~~n~\
		\
		~g~~h~%s lhe ligou e nao teve nenhum retorno, a ligacao foi perdida.", Chamadas[playerid][conv][wp_Hora], NomeConta(Chamadas[playerid][conv][wp_Conta]));
	}

	if(Chamadas[playerid][conv][wp_Vista] == 2)
	{
        format(str_aviso[playerid], 300, "\
		LIGACAO~n~~r~RECUSADA~w~~n~~n~\
		\
		%s~n~~n~\
		\
		~g~~h~%s lhe ligou voce recusou a ligacao.", Chamadas[playerid][conv][wp_Hora], NomeConta(Chamadas[playerid][conv][wp_Conta]));
	}

	SetPVarInt(playerid, "aviso", C_LISTA);
    celular(playerid, C_INFO);
	return 1;
}

stock criar_converssa(playerid, conts)
{
	new file[80];
	new c = id[playerid];
	if(c == -1) return -1;

	for(new a; a<MAX_WP; a++)
	{
	    if(WP[a][w_Existe] == 0)
	    {
	        WP[a][w_Existe] = 1;
	        WP[a][w_Conta][0] = c;
	        WP[a][w_Conta][1] = conts;
	        WP[a][w_Visto][0] = 1;
	        WP[a][w_Visto][1] = 0;
	        format(WP[a][w_Hora], 20, "%02d:%02d", HORA, MINUTO);
			format(file, 80, "WP_Menssagens/%d.txt", a);
			id_converssa[playerid] = a;
			salvar_wp(a);
	        return a;
	    }
	}
	return -1;
}

stock abrir_converssa(playerid, conv)
{
    new c = id[playerid];
	if(c != -1)
	{
		new i = conv;
		new file[80];
		format(file, 80, "WP_Menssagens/%d.txt", i);
		if(DOF2_FileExists(file))
		{
		    new str2[80];
		    new str[600];
		    for(new ii; ii<MAX_LINHAS; ii++)
		    {
		        format(str2, 80, "cv_Linha_%d", ii);
		        format(str, 500, "%s", DOF2_GetString(file, str2));
			 	split_linha(str, strlen(str));
		        player_converssa[playerid][ii][cv_Existe] = strval(split[0]);
		        player_converssa[playerid][ii][cv_Conta] = strval(split[1]);
		        format(player_converssa[playerid][ii][cv_Hora], 20, split[2]);
		        format(player_converssa[playerid][ii][cv_Menssagem], 200, split[3]);
			}

			if(WP[conv][w_Conta][0] == c) WP[conv][w_Visto][0] = 1;
			if(WP[conv][w_Conta][1] == c) WP[conv][w_Visto][1] = 1;
        }
		else
		{
		    for(new ii=1; ii<MAX_LINHAS; ii++)
		    {
		        player_converssa[playerid][ii][cv_Existe] = 0;
		        player_converssa[playerid][ii][cv_Conta] = c;
		        format(player_converssa[playerid][ii][cv_Hora], 20, "_");
		        format(player_converssa[playerid][ii][cv_Menssagem], 200, "_");
			}

            player_converssa[playerid][0][cv_Existe] = 0;
	        player_converssa[playerid][0][cv_Conta] = c;
	        format(player_converssa[playerid][0][cv_Hora], 20, "%d:%d", HORA, MINUTO);
	        format(player_converssa[playerid][0][cv_Menssagem], 200, "~g~~h~Inicie uma nova converssa com essa pesoa, digite uma menssagem abaixo:");
		}

        new contac;
        if(c == WP[conv][w_Conta][0]) contac = WP[conv][w_Conta][1];
        else contac = WP[i][w_Conta][0];
        id_converssa[playerid] = i;
        conta_converssa[playerid] = contac;
        grupo_vip[playerid] = 0;
		celular(playerid, C_WP_APK);
		return 1;
	}
	return 0;
}

stock paginas_converssa(playerid)
{
	new cont;
	for(new i; i<MAX_LINHAS; i++) if(player_converssa[playerid][i][cv_Existe] == 1) cont++;
	new tot = paginas(5, cont);
	return tot;
}

stock mostrar_converssa(playerid)
{
    new c = id[playerid];
	if(c != -1)
	{
	    new linha[85];
		if(grupo_vip[playerid] == 1)
		{
		    for(new a; a<5; a++)
			{
				new i = a+(pagina_converssa[playerid]*5);
				if(i < MAX_LINHAS)
				{
				    if(player_converssa[playerid][i][cv_Existe] == 1)
					{
					    if(player_converssa[playerid][i][cv_Conta] != c)
						{
							if(player_converssa[playerid][i][cv_Conta] != -1) format(linha, 80, "~p~%s: ~w~%s", NomeConta(player_converssa[playerid][i][cv_Conta]), player_converssa[playerid][i][cv_Menssagem]);
							else format(linha, 80, "~y~~h~Voce: ~w~%s", player_converssa[playerid][i][cv_Menssagem]);
						}
						else format(linha, 80, "~y~%s: ~w~%s", Nome(playerid), player_converssa[playerid][i][cv_Menssagem]);
						if(strlen(player_converssa[playerid][i][cv_Menssagem]) > 60) strcat(linha, " ...");
						PlayerTextDrawSetString(playerid, T_Celular_WP_APK_Converssa_p[playerid][a], linha);
						PlayerTextDrawSetString(playerid, T_Celular_WP_APK_Converssa_p[playerid][a+5], linha);
					    if(player_converssa[playerid][i][cv_Conta] == c ||
						player_converssa[playerid][i][cv_Conta] == -1)
		                {
							PlayerTextDrawShow(playerid, T_Celular_WP_APK_Converssa_p[playerid][a]);
							PlayerTextDrawHide(playerid, T_Celular_WP_APK_Converssa_p[playerid][a+5]);
						}
						else
						{
						    PlayerTextDrawShow(playerid, T_Celular_WP_APK_Converssa_p[playerid][a+5]);
							PlayerTextDrawHide(playerid, T_Celular_WP_APK_Converssa_p[playerid][a]);
						}
				    }
				    else
					{
						PlayerTextDrawHide(playerid, T_Celular_WP_APK_Converssa_p[playerid][a]);
						PlayerTextDrawHide(playerid, T_Celular_WP_APK_Converssa_p[playerid][a+5]);
				    }
				}
			}

			new pagsc = paginas_converssa(playerid);
			PlayerTextDrawHide(playerid, T_Celular_WP_APK_Converssa_p[playerid][11]);
			TextDrawHideForPlayer(playerid, T_Celular_WP_APK_Converssa[3]);
			TextDrawHideForPlayer(playerid, T_Celular_WP_APK_Converssa[4]);
			if(pagsc > 1)
			{
				format(linha, 20, "%d / %d", pagina_converssa[playerid]+1, pagsc);
				PlayerTextDrawSetString(playerid, T_Celular_WP_APK_Converssa_p[playerid][11], linha);
				PlayerTextDrawShow(playerid, T_Celular_WP_APK_Converssa_p[playerid][11]);
				if(pagina_converssa[playerid]+1 < pagsc) TextDrawShowForPlayer(playerid, T_Celular_WP_APK_Converssa[3]);
	 	 		if(pagina_converssa[playerid] > 0) TextDrawShowForPlayer(playerid, T_Celular_WP_APK_Converssa[4]);
			}

			PlayerTextDrawSetString(playerid, T_Celular_WP_APK_Converssa_p[playerid][10], "~y~~h~GRUPO VIP");
			PlayerTextDrawShow(playerid, T_Celular_WP_APK_Converssa_p[playerid][10]);
			TextDrawHideForPlayer(playerid, T_Celular_WP_APK_Converssa[0]);
		}
		else
	    {
			if(id_converssa[playerid] != -1)
			{
				for(new a; a<5; a++)
				{
				    new i = a+(pagina_converssa[playerid]*5);
				    if(i < MAX_LINHAS)
					{
					    if(player_converssa[playerid][i][cv_Existe] == 1)
						{
						format(linha, 80, player_converssa[playerid][i][cv_Menssagem]);
							if(strlen(player_converssa[playerid][i][cv_Menssagem]) > 80) strcat(linha, "...");
							PlayerTextDrawSetString(playerid, T_Celular_WP_APK_Converssa_p[playerid][a], linha);
							PlayerTextDrawSetString(playerid, T_Celular_WP_APK_Converssa_p[playerid][a+5], linha);

				        if(player_converssa[playerid][i][cv_Conta] == c)
				        {
								PlayerTextDrawShow(playerid, T_Celular_WP_APK_Converssa_p[playerid][a]);
								PlayerTextDrawHide(playerid, T_Celular_WP_APK_Converssa_p[playerid][a+5]);
							}
							else
							{
							    PlayerTextDrawShow(playerid, T_Celular_WP_APK_Converssa_p[playerid][a+5]);
								PlayerTextDrawHide(playerid, T_Celular_WP_APK_Converssa_p[playerid][a]);
							}
					    }
					    else
						{
							PlayerTextDrawHide(playerid, T_Celular_WP_APK_Converssa_p[playerid][a]);
							PlayerTextDrawHide(playerid, T_Celular_WP_APK_Converssa_p[playerid][a+5]);
					    }
				    }
				}

    			new pagsc = paginas_converssa(playerid);
				PlayerTextDrawHide(playerid, T_Celular_WP_APK_Converssa_p[playerid][11]);
				TextDrawHideForPlayer(playerid, T_Celular_WP_APK_Converssa[3]);
				TextDrawHideForPlayer(playerid, T_Celular_WP_APK_Converssa[4]);
				if(pagsc > 1)
				{
					format(linha, 20, "%d / %d", pagina_converssa[playerid]+1, pagsc);
					PlayerTextDrawSetString(playerid, T_Celular_WP_APK_Converssa_p[playerid][11], linha);
					PlayerTextDrawShow(playerid, T_Celular_WP_APK_Converssa_p[playerid][11]);
					if(pagina_converssa[playerid]+1 < pagsc) TextDrawShowForPlayer(playerid, T_Celular_WP_APK_Converssa[3]);
		 	 		if(pagina_converssa[playerid] > 0) TextDrawShowForPlayer(playerid, T_Celular_WP_APK_Converssa[4]);
				}
				new cc = conta_converssa[playerid];
				if(tem_contato(playerid, cc)) format(linha, 50, NomeConta(cc));
				else format(linha, 50, "%d", GetContaInt(cc, "c_Chip"));
				PlayerTextDrawSetString(playerid, T_Celular_WP_APK_Converssa_p[playerid][10], linha);
				PlayerTextDrawShow(playerid, T_Celular_WP_APK_Converssa_p[playerid][10]);
			}
			else
			{
				for(new ii; ii<MAX_LINHAS; ii++)
				{
				player_converssa[playerid][ii][cv_Existe] = 0;
				player_converssa[playerid][ii][cv_Conta] = 0;
				}
				for(new a; a<5; a++)
				{
					PlayerTextDrawHide(playerid, T_Celular_WP_APK_Converssa_p[playerid][a]);
					PlayerTextDrawHide(playerid, T_Celular_WP_APK_Converssa_p[playerid][a+5]);
				}

				format(linha, 50, NomeConta(conta_converssa[playerid]));
				PlayerTextDrawSetString(playerid, T_Celular_WP_APK_Converssa_p[playerid][10], linha);
				PlayerTextDrawShow(playerid, T_Celular_WP_APK_Converssa_p[playerid][10]);
				PlayerTextDrawHide(playerid, T_Celular_WP_APK_Converssa_p[playerid][11]);
			}
		}
	}
}

stock escrever_converssa(playerid, con, const menssagem[])
{
	new c = id[playerid];
	if(c != -1)
	{
	    if(WP[con][w_Existe] == 1)
	    {
	        new cc = conta_converssa[playerid];
	        if(WP[con][w_Conta][0] == cc) WP[con][w_Visto][0] = 0;
	        else if(WP[con][w_Conta][1] == cc) WP[con][w_Visto][1] = 0;
			for(new ii=(MAX_LINHAS-1); ii>-1; ii--)
			{
			    if(ii-1 > -1)
				{
				player_converssa[playerid][ii][cv_Existe] = player_converssa[playerid][ii-1][cv_Existe];
				player_converssa[playerid][ii][cv_Conta] = player_converssa[playerid][ii-1][cv_Conta];
				format(player_converssa[playerid][ii][cv_Hora], 20, player_converssa[playerid][ii-1][cv_Hora]);
				format(player_converssa[playerid][ii][cv_Menssagem], 200, player_converssa[playerid][ii-1][cv_Menssagem]);
			    }
			}
		    player_converssa[playerid][0][cv_Existe] = 1;
		    player_converssa[playerid][0][cv_Conta] = c;
		    format(player_converssa[playerid][0][cv_Hora], 20, "%02d:%02d:%02d", HORA, MINUTO, SEGUNDO);
		    format(player_converssa[playerid][0][cv_Menssagem], 200, "%s_", menssagem);
		    salvar_converssa(playerid, con);
		    salvar_wp(con);

			if(cc != -1)
			{
			    new idd = ContaOnline(cc);
			    if(Online(idd))
				{
				if(celular_aberto[idd] == C_WP_APK)
				{
						if(id_converssa[idd] == con)
						{
						    abrir_converssa(idd, con);
						    if(WP[con][w_Conta][0] == cc) WP[con][w_Visto][0] = 1;
        					else if(WP[con][w_Conta][1] == cc) WP[con][w_Visto][1] = 1;
				    }
				    else notificacao_cel(idd, playerid, 0);
				}
				else notificacao_cel(idd, playerid, 0);
			    }
			    else
				{
				new sss[150];
				format(sss, 150, "[WP] Nova menssagem de '%s' no Whatsapp.", Nome(playerid));
				msc(cc, 0x7CFC00ff, sss);
			    }

			}
			return 1;
		}
	}
	return 0;
}


stock escrever_converssa_vip(playerid, const menssagem[])
{
	new c = id[playerid];
	if(c != -1)
	{
		for(new ii=(MAX_LINHAS-1); ii>-1; ii--)
		{
		    if(ii-1 > -1)
		    {
		        player_converssa[playerid][ii][cv_Existe] = player_converssa[playerid][ii-1][cv_Existe];
		        player_converssa[playerid][ii][cv_Conta] = player_converssa[playerid][ii-1][cv_Conta];
		        format(player_converssa[playerid][ii][cv_Hora], 20, player_converssa[playerid][ii-1][cv_Hora]);
		        format(player_converssa[playerid][ii][cv_Menssagem], 200, player_converssa[playerid][ii-1][cv_Menssagem]);
		    }
		}
	    player_converssa[playerid][0][cv_Existe] = 1;
	    player_converssa[playerid][0][cv_Conta] = c;
	    format(player_converssa[playerid][0][cv_Hora], 20, "%02d:%02d:%02d", HORA, MINUTO, SEGUNDO);
	    format(player_converssa[playerid][0][cv_Menssagem], 200, "%s_", menssagem);
	    salvar_converssa_vip(playerid);

		foreach(new aa:Player)
		{
		    if(Online(aa))
		    {
		        if(id[aa] != -1)
		        {
				if(celular_aberto[aa] == C_WP_APK)
				{
				    if(grupo_vip[aa] == 1)
						{
						    grupo_vip_wp(aa);
				    }
				}
		        }
		    }
		}
		return 1;

	}
	return 0;
}

stock salvar_converssa_vip(playerid)
{
	new file[80];
	format(file, 80, "WP_Menssagens/GrupoVip.txt");
	if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
	DOF2_CreateFile(file);
	new str2[80];
    new str[500];
    for(new ii; ii<MAX_LINHAS; ii++)
    {
        format(str2, 80, "cv_Linha_%d", ii);
        format(str, 500, "%d|%d|%s|%s|",
		player_converssa[playerid][ii][cv_Existe],
		player_converssa[playerid][ii][cv_Conta],
		player_converssa[playerid][ii][cv_Hora],
		player_converssa[playerid][ii][cv_Menssagem]);
        DOF2_SetString(file, str2, str);
	}
	DOF2_SaveFile();
}

stock salvar_converssa(playerid, con)
{
	new file[80];
	format(file, 80, "WP_Menssagens/%d.txt", con);
	if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
	if(WP[con][w_Existe] == 1)
	{
		DOF2_CreateFile(file);
		new str2[80];
	    new str[500];
	    for(new ii; ii<MAX_LINHAS; ii++)
	    {
	        format(str2, 80, "cv_Linha_%d", ii);
	        format(str, 500, "%d|%d|%s|%s|",
			player_converssa[playerid][ii][cv_Existe],
			player_converssa[playerid][ii][cv_Conta],
			player_converssa[playerid][ii][cv_Hora],
			player_converssa[playerid][ii][cv_Menssagem]);
	        DOF2_SetString(file, str2, str);
		}
		DOF2_SaveFile();
	}
}

