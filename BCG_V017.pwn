	// Criar emprego Operador de Maquinas
	new omFile[80];
	format(omFile, 80, "Empregos/Emprego_%d.txt", OM_EMPREGO_ID);
	if(!DOF2_FileExists(omFile)) { DOF2_CreateFile(omFile); DOF2_SetInt(omFile, "e_Salario", 11000); DOF2_SetInt(omFile, "e_Nivel", 1); DOF2_SetInt(omFile, "e_Tipo", 0); DOF2_SetString(omFile, "e_Nome", "Operador de Maquinas"); DOF2_SaveFile(); }
	new ifoodFile[80]; format(ifoodFile, 80, "Empregos/Emprego_%d.txt", IFOOD_ID);
	if(!DOF2_FileExists(ifoodFile)) { DOF2_CreateFile(ifoodFile); DOF2_SetInt(ifoodFile, "e_Salario", 5000); DOF2_SetInt(ifoodFile, "e_Nivel", 1); DOF2_SetInt(ifoodFile, "e_Tipo", 0); DOF2_SetString(ifoodFile, "e_Nome", "Entregador iFood"); DOF2_SaveFile(); }
	CreatePickup(1239, 1, 588.1663, 1335.7125, 10.6352, 0);
