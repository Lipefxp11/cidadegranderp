	{
	    new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /portaoaberto [ ID do PORTAO ]");
		if(i < 0 || i >= MAX_PORTOES) return ms(playerid, 0, "ID de portao Invalido !");
		if(Portao[i][p_Existe] == 0) return ms(playerid, 0, "Este portao nao existe !");
		Streamer_Update(playerid);
		EditandoPortao[playerid] = i;
		SetPVarInt(playerid, "editando_portao", 1);
