            DOF2_SetInt(file, "c_XP", 1);
            DOF2_SetInt(file, "c_TempoJogado", 0);
            DOF2_SetInt(file, "c_Caixas", 0);
            DOF2_SetInt(file, "c_Ban_Tempo", 0);
            DOF2_SetInt(file, "c_Pix", 0);
            DOF2_SetInt(file, "c_Forca", 5);
            DOF2_SetInt(file, "c_Resistencia", 10);
            DOF2_SetInt(file, "c_Estamina", 100);
            DOF2_SetInt(file, "c_Banco", 5000);
            DOF2_SetInt(file, "c_Loteria", 0);
            DOF2_SetInt(file, "c_Procurado", 0);
            DOF2_SetInt(file, "c_Sede", 100);
            DOF2_SetInt(file, "c_Fome", 100);
            DOF2_SetInt(file, "c_Hospital", 0);
            DOF2_SetInt(file, "c_Hospital2", 0);
            DOF2_SetInt(file, "c_Interior", 0);
            DOF2_SetInt(file, "c_Mundo", 0);
            DOF2_SetInt(file, "c_CPF", 0);
            DOF2_SetInt(file, "c_RG", 0);
            DOF2_SetInt(file, "c_Liberado", 0);
            DOF2_SetInt(file, "c_Sexo", sexo);
            if(skin == -1) DOF2_SetInt(file, "c_Skin", gerar_skin(sexo));
            else DOF2_SetInt(file, "c_Skin", skin);
            DOF2_SetInt(file, "c_Org", -1);
            DOF2_SetInt(file, "c_Cargo", 0);
            DOF2_SetInt(file, "c_Cidade", cidade);
            DOF2_SetInt(file, "c_Idade", idade);
			DOF2_SetInt(file, "c_Dia", DIA);
			DOF2_SetInt(file, "c_Mes", MES);
			DOF2_SetInt(file, "c_Ano", ANO);
			DOF2_SetInt(file, "c_Hora", HORA);
			DOF2_SetInt(file, "c_Minuto", MINUTO);
			DOF2_SetInt(file, "c_Segundo", SEGUNDO);
			DOF2_SetInt(file, "c_Dia2", DIA);
			DOF2_SetInt(file, "c_Mes2", MES);
			DOF2_SetInt(file, "c_Ano2", ANO);
			DOF2_SetInt(file, "c_Hora2", HORA);
			DOF2_SetInt(file, "c_Minuto2", MINUTO);
			DOF2_SetInt(file, "c_Segundo2", SEGUNDO);
			DOF2_SetInt(file, "c_Nota", -1);
			DOF2_SetInt(file, "c_TagYT", 0);
			DOF2_SetInt(file, "c_Tag", 0);
			DOF2_SetInt(file, "c_Local", 0);
			DOF2_SetInt(file, "c_LocalID", 0);


            new sss1[40], sss2[40];
			for(new a; a<13; a++)
	        {
	            format(sss1, 40, "Arma_%d", a);
				format(sss2, 40, "Municao_%d", a);
				DOF2_SetInt(file, sss1, 0);
				DOF2_SetInt(file, sss2, 0);
	        }
	        new linh[500];
			for(new e; e<MAX_EMPREGOS; e++) strcat(linh, "0|");
			DOF2_SetString(file, "c_NivelEmprego", linh);
			conta_existe[i] = 1;
			Iter_Add(Iter_Contas, i);
			DOF2_SaveFile();

			format(file, 40, "Nicks/%s.txt", nick);
			if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
			DOF2_CreateFile(file);
			DOF2_SetInt(file, "c_Conta", i);
			DOF2_SaveFile();
	        return i;
	    }
	}
	return -1;
}

stock gerar_skin(sexo)
{
	new skinf;
	if(sexo == 0) skinf = 23;
	else skinf = 56;
	return skinf;
}

stock opcoes_conta(playerid, c)
{
	SetPVarInt(playerid, "cc", c);
	SG[0] = EOS;
	new sss[150];
	format(sss, 150, "{ffffff}Conta: {00ffff}%d", c);
	strcat(SG, "Mudar Nick\n");
	strcat(SG, "Mudar Senha\n");
	strcat(SG, "Mudar Sexo\n");
	strcat(SG, "Mudar Cidade\n");
	strcat(SG, "{ff0000}APAGAR\n");
	ShowPlayerDialog(playerid, DIALOG_OPCOES_CONTA, DIALOG_STYLE_LIST, sss, SG, "Continuar", "Cancelar");
	return 1;
}

stock abrir_contas(playerid)
{
	ShowPlayerDialog(playerid, DIALOG_CONTAS, DIALOG_STYLE_LIST, "Contas Registradas", "\
	Lista de Contas ( 0000 - 0999)\n\
	Lista de Contas ( 1000 - 1999)\n\
	Lista de Contas ( 2000 - 2999)\n\
	Pesquisar Nick\n\
	Inativo a X dias\n\
	Contas Banidas", "Continuar", "Fechar");
