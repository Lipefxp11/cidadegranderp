	if(!strcmp(cmd, "/socorrer", true))
	{
		if(PlayerMedico(playerid) || PlayerCop(playerid))//PlayerCop
		{
			new idd;
		    if(sscanf(params, "u", idd)) return ms(playerid, 2, "Use: /socorrer [ ID/Nick ]"), ms(playerid, 2, "Usado para localizar alguem gravemente ferido.");
			if(!Online(idd)) return ms(playerid, 0, "Este jogador nao esta Online !");
			if(id[idd] == -1 ) return ms(playerid, 0, "Este jogador nao esta Online !");
			if(Conta[idd][c_Morto] <= 0) return ms(playerid, 0, "Este jogador nao esta gravemente ferido !");
			new Float:pos[3];
			GetPlayerPos(idd, pos[0], pos[1], pos[2]);
			Localizar_Player(playerid, pos[0], pos[1], pos[2], 71, idd, Nome(idd));
		    MS(playerid, 2, "A posicao do jogador foi marcada de vermelho em seu mapa, use /salvar para realizar os socorros.");
		    ms(idd, 2, "Os medicos ja estao a caminho, aguente firme !");
	    }
	    else ms(playerid, 0, "Voce nao e um medico !");
		return 1;
	}

  	if(!strcmp(cmd, "/online", true))
	{
	    new sss[150];
		SG[0] = EOS;

		// cops online //
		strcat(SG, "\n");
		strcat(SG, "{00ffff}POLICIAIS");
		strcat(SG, "\n\n");
		new cont;
		foreach(new a:Player)
		{
		    if(Online(a))
		    {
		        if(PlayerCop(a))
		        {
		            if(EmServico(a))
		            {
				    format(sss, 150, "{ffffff}%s {00ffff}%d {ffff00}%d {a1a1a1}( %s )\n", Nome(a), id[a], a, NomeOrg(OrgPlayer(a)));
		                strcat(SG, sss);
		                cont ++;
	                }
				}
		    }
		}
		if(cont == 0) strcat(SG, "{a1a1a1}Ninguem\n\n");
		else strcat(SG, "\n");

		strcat(SG, "\n");
		strcat(SG, "{4169E1}Cargos importantes");
		strcat(SG, "\n");
		// medicos online //
		strcat(SG, "\n");
		strcat(SG, f("{ffffff}Medicos Online [{ffff00}%d{ffffff}]", medicos_online()));
		// mecanicos online //
		strcat(SG, "\n");
		strcat(SG, f("{ffffff}Mecanicos Online [{ffff00}%d{ffffff}]", mecanicos_online()));
		// mecanicos online //
		strcat(SG, "\n");
		strcat(SG, f("{ffffff}Advogados Online [{ffff00}%d{ffffff}]", advogados_online()));
		// ubers online //
		strcat(SG, "\n");
		strcat(SG, f("{ffffff}Ubers Online [{ffff00}%d{ffffff}]", ubers_online()));

		strcat(SG, "\n");
		ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}.", SG, "Ok", "Fechar");
		return 1;
	}

	if(!strcmp(cmd, "/locoff", true))
	{
		if(LocWp_id[playerid] == -123)
		{
		    LocWp_id[playerid] = -1;
		    Localizar_Player(playerid, 0.0,0.0,0.0,-1);
			MS(playerid, 2, "Voce desligou a localizacao do Whatsapp.");
		}
		else MS(playerid, 0, "Voce nao esta usando nenhuma localizacao do whatsapp !");
		return 1;
	}

	if(!strcmp(cmd, "/loc", true))
	{
		new dd = LocWp_id[playerid];
		if(Online(dd))
		{
		    Localizar_Player(playerid, LocWp_pos[playerid][0], LocWp_pos[playerid][1], LocWp_pos[playerid][2], 70, dd, Nome(dd));
		    MS(playerid, 2, "A posicao do jogador foi marcada de vermelho em seu mapa, Use /locoff se quiser desligar a localizacao.");
		    LocWp_id[playerid] = -123;
		}
		else MS(playerid, 0, "Nenunha Localizacao foi encontrada no Whatsapp, tente mais tarde.");
		return 1;
	}

	if(!strcmp(cmd, "/chatnoob", true))
	{
		new c, temp, mot[50];
	    if(sscanf(params, "dds[50]", c, temp, mot)) return ms(playerid, 2, "Use: /chatnoob [ ID da CONTA ] [ Minutos de Ban ] [ Motivo ]"), ms(playerid, 2, "Minutos: Use 0 para Desbanir.");
		if(c < 0 || c >= MAX_CONTAS) return ms(playerid, 0, "ID de conta Invalido !");
		if(ContaInvalida(c)) return ms(playerid, 0, "Esta Conta nao existe !");
		if(temp < 0) return ms(playerid, 0, "Use um valor maior ou igual a 0 !");
		ban_noob(playerid, c, temp, mot);
		return 1;
	}

    if(!strcmp(cmd, "/n", true) || !strcmp(cmd, "/noob", true))
	{
		new c = id[playerid];
		if(c == -1) return 1;
		new sss[200], avi[200];
		if(Conta[playerid][c_Noob] == 1) return ms(playerid, 0, "Voce desativou esse chat da sua conta, use N > Celular > Config, e ative para usa-lo.");
		format(sss, 150, "Voce esta bloqueado do Chat Noob, tempo restante: %s.", ConvertTime(Conta[playerid][c_BanNoob] - gettime()));
		if(Conta[playerid][c_BanNoob] > gettime()) return ms(playerid, 0, sss);
	    new temp = GetPVarInt(playerid, "flood_noob");
	    if(ModoAdmin[playerid] == 0)
	    {
		    if(temp > gettime())
		    {
				format(sss, 150, "Voce so pode usar o Chat Noob novamente em: %s.", temp-gettime());
				return 1;
		    }
	    }
	    if(sscanf(params, "s[200]", avi)) return ms(playerid, 2, "Use: /n [ Menssagem ]");
	    if(strlen(avi) > 198) return ms(playerid, 0, "Menssagem muito longa, tente novamente !");
	    msg_noob(playerid, avi);
		return 1;
	}

   	if(!strcmp(cmd, "/rn", true))
	{
	    new c = id[playerid];
	    new p;
		if(c == -1) return 1;
		new sss[200], avi[200];
		if(Conta[playerid][c_Noob] == 1) return ms(playerid, 0, "Voce desativou esse chat da sua conta, use N > Celular > Config, e ative para usa-lo.");
	    format(sss, 150, "Voce esta bloqueado do Chat Noob, tempo restante: %s.", ConvertTime(Conta[playerid][c_BanNoob] - gettime()));
		if(Conta[playerid][c_BanNoob] > gettime()) return ms(playerid, 0, sss);
		if(sscanf(params, "ds[200]", p, avi)) return ms(playerid, 2, "Use: /rn [ ID/Nick ] [ Menssagem ]");
		if(!Online(p)) return ms(playerid, 0, "Este jogador nao esta Online !");
		if(id[p] == -1) return ms(playerid, 0, "Este jogador nao esta em uma Conta !");
		if(strlen(avi) > 198) return ms(playerid, 0, "Menssagem muito longa, tente novamente !");
		msg_rnoob(playerid, p, avi);
		return 1;
	}

	if(!strcmp(cmd, "/vercameras", true))
	{
		if(player_arena[playerid] == 1) return ms(playerid, 0, "Voce nao pode fazer isso agora !");
		if(tv_player[playerid] != -1) return ms(playerid, 0, "Voce nao pode fazer isso agora !");
		if(tunando[playerid] == 1) return ms(playerid, 0, "Voce nao pode fazer isso agora !");
		mostrar_cameras(playerid);
		return 1;
	}

	if(!strcmp(cmd, "/fly", true))
	{
	    if(AdminPlayer(playerid) < 8) return ms(playerid, 0, "Apenas admin level 8+ pode usar este comando!");
	    if(flymode[playerid] == 1)
	    {
	    // desliga flymode
	        new Float:cx, Float:cy, Float:cz;
	        GetPlayerCameraPos(playerid, cx, cy, cz);
	        flymode[playerid] = 0;
	        TogglePlayerSpectating(playerid, false);
	        SetPlayerPos(playerid, cx, cy, cz);
	        SetPlayerInterior(playerid, flymode_interior[playerid]);
	        SetPlayerVirtualWorld_(playerid, flymode_mundo[playerid]);
	        ms(playerid, 0, "Flymode desativado. Voce foi teleportado para onde estava.");
	        return 1;
	    }
	    // liga flymode
	    GetPlayerPos(playerid, flymode_entrada[playerid][0], flymode_entrada[playerid][1], flymode_entrada[playerid][2]);
	    flymode_interior[playerid] = GetPlayerInterior(playerid);
	    flymode_mundo[playerid] = GetPlayerVirtualWorld_(playerid);
	    flymode[playerid] = 1;
	    TogglePlayerSpectating(playerid, true);
	    ms(playerid, 0, "Flymode ativado! Use /fly novamente para desativar.");
	    return 1;
	}

	if(!strcmp(cmd, "/pegarestoque", true))
	{
	    if(!VR_VerificarEmprego(playerid)) return ms(playerid, 0, "Voce nao e vendedor de roupas!");
	    if(!IsPlayerInRangeOfPoint(playerid, 5.0, 2111.8855, -1932.2644, 17.0425)) return ms(playerid, 0, "Va ao deposito!");
	    if(VR_Estoque[playerid] >= MAX_ESTOQUE_VR) return ms(playerid, 0, "Estoque cheio!");
	    for(new i; i<MAX_CASAS_VR; i++) VR_Cooldown[playerid][i] = 0;
	    VR_Estoque[playerid] = MAX_ESTOQUE_VR;
	    VR_EmServico[playerid] = 1;
	    ms(playerid, 0, f("Estoque pego! %d roupas. Use /marcarcasa", MAX_ESTOQUE_VR));
	    return 1;
	}
	if(!strcmp(cmd, "/baternaporta", true))
	{
	    if(!VR_VerificarEmprego(playerid)) return ms(playerid, 0, "Voce nao e vendedor!");
	    if(VR_Estoque[playerid] <= 0) return ms(playerid, 0, "Sem estoque!");
	    if(VR_Checkpoint[playerid] != 0) return ms(playerid, 0, "Va ate o checkpoint primeiro!");
	    new c = VR_CasaAtual[playerid];
	    if(!IsPlayerInRangeOfPoint(playerid, 10.0, VR_Casas[c][0], VR_Casas[c][1], VR_Casas[c][2])) return ms(playerid, 0, "Nao esta na casa!");
	    if(gettime() < VR_Cooldown[playerid][c]) { ms(playerid, 0, "Casa em cooldown!"); return 1; }
	    new vr_skin = random(311) + 1;
	    new Float:fa; GetPlayerFacingAngle(playerid, fa);
	    VR_Actor[playerid] = CreateActor(vr_skin, VR_Casas[c][0], VR_Casas[c][1]-1.0, VR_Casas[c][2]-0.9, fa+180.0);
	    ApplyActorAnimation(VR_Actor[playerid], "PED", "IDLE_CSAW", 4.1, 1, 0, 0, 0, 0);
	    new str[64]; format(str, 64, "Morador\nUse /convencer para negociar");
	    VR_Label[playerid] = CreateDynamic3DTextLabel(str, 0xFFFFFFFF, VR_Casas[c][0], VR_Casas[c][1]-1.0, VR_Casas[c][2], 10.0);
	    VR_NpcAtivo[playerid] = 1;
	    ms(playerid, 1, "Morador apareceu! Use /convencer para negociar.");
	    return 1;
	}
	if(!strcmp(cmd, "/convencer", true))
	{
	    if(!VR_NpcAtivo[playerid]) return ms(playerid, 0, "Nenhum NPC para convencer! Use /baternaporta");
	    VR_MostrarConv(playerid);
	    return 1;
	}
	if(!strcmp(cmd, "/pegarlanches", true))
	{
	    new e = EmpregoPlayer(playerid);
	    if(e != IFOOD_ID) return ms(playerid, 0, "Voce nao e entregador do iFood!");
	    if(Conta[playerid][c_H][0] != 1) return ms(playerid, 0, "Precisa de CNH de Moto (Categoria A)!");
	    IFOOD_Start(playerid);
	    return 1;
	}
	if(!strcmp(cmd, "/entregarifood", true))
	{
	    new e = EmpregoPlayer(playerid);
	    if(e != IFOOD_ID) return ms(playerid, 0, "Voce nao e entregador do iFood!");
	    if(IFOOD_CP[playerid] != 1) return ms(playerid, 0, "Nenhuma entrega pendente!");
	    if(IsPlayerInAnyVehicle(playerid)) return ms(playerid, 0, "Desca da moto para entregar!");
	    IFOOD_HideDeliveryPrompt(playerid);
	    IFOOD_CP[playerid] = 0;
	    TogglePlayerControllable(playerid, 0);
	    ApplyAnimation(playerid, "BOMBER", "BOM_Plant_Loop", 4.0, 1, 0, 0, 0, 0);
	    IFOOD_Timer[playerid] = SetTimerEx("IFOOD_AnimDone", 5000, false, "d", playerid);
	    return 1;
	}
	if(!strcmp(cmd, "/iniciarmaquinas", true))
	{
	    if(!OM_VerificarEmprego(playerid)) return ms(playerid, 0, "Voce nao e operador de maquinas!");
	    if(!IsPlayerInRangeOfPoint(playerid, 3.0, 588.1663, 1335.7125, 10.6352)) return ms(playerid, 0, "Va a fabrica!");
	    if(OM_EmServico[playerid]) return ms(playerid, 0, "Ja em servico!");
	    OM_EmServico[playerid] = 1; OM_Problema[playerid] = 0;
	    OM_Timer[playerid] = SetTimerEx("OM_GerarProblema", OM_TEMPO_PROBLEMA, false, "d", playerid);
	    ms(playerid, 0, "Servico iniciado! Uma maquina vai dar problema em breve.");
	    return 1;
	}
	if(!strcmp(cmd, "/consertarmaquina", true))
	{
	    if(!OM_VerificarEmprego(playerid)) return ms(playerid, 0, "Voce nao e operador!");
	    if(!OM_Problema[playerid]) return ms(playerid, 0, "Nenhuma maquina com problema!");
	    if(OM_Consertando[playerid]) return ms(playerid, 0, "Ja consertando!");
	    if(!IsPlayerInRangeOfPoint(playerid, 5.0, OM_CPX[playerid], OM_CPY[playerid], OM_CPZ[playerid])) return ms(playerid, 0, "Nao esta na maquina!");
	    DisablePlayerCheckpoint(playerid);
	    OM_Checkpoint[playerid] = 0;
	    esconder_hud(playerid);
	    if(OM_TDP[playerid][0] == PlayerText:INVALID_TEXT_DRAW) OM_CriarTDP(playerid);
	    OM_Consertando[playerid] = 1;
	    OM_AtualizarStatus(playerid);
	    for(new i; i<12; i++) TextDrawShowForPlayer(playerid, OM_TD[i]);
	    for(new i; i<5; i++) PlayerTextDrawShow(playerid, OM_TDP[playerid][i]);
	    SelectTextDraw(playerid, 0x0000FFFF);
	    ms(playerid, 0, "Painel aberto! Clique nos componentes com erro.");
	    return 1;
	}
	if(!strcmp(cmd, "/marcarcasa", true))
	{
	    if(!VR_VerificarEmprego(playerid)) return ms(playerid, 0, "Voce nao e vendedor de roupas!");
	    if(VR_Estoque[playerid] <= 0) return ms(playerid, 0, "Sem estoque! Use /pegarestoque");
	    VR_ProximaCasa(playerid);
	    return 1;
	}

	if(!strcmp(cmd, "/listaempregos", true))
	{
		mostrar_empregos(playerid);
		return 1;
	}

	if(!strcmp(cmd, "/encerrar", true))
	{
		new str[150];
		if(atendimento_player[playerid] != -1)
		{
		    new i = atendimento_player[playerid];
			format(str, 150, "O jogador %s finalizou o atendimento, Duracao: %s.", Nome(playerid), ConvertTime(gettime()-Atendimento[i][at_Atendido]) );
			foreach(new pla:Player)
			{
			    if(atendimento_admin[pla] == i)
				{
				ms(pla, 4, str);
				new idadm = AdminID(pla);
				if(idadm != -1)
				{
					Admin[idadm][adm_Atendimentos] ++;
					atendimento_admin[pla] = -1;
					salvar_admin(idadm);
				}
			    }
			}

			format(str, 150, "Voce finalizou o atendimento, duracao: %s.", ConvertTime(gettime()-Atendimento[i][at_Atendido]));
		    ms(playerid, 4, str);
		    destruir_atendimento(i);
		    atendimento_player[playerid] = -1;
			return 1;
		}

		if(atendimento_admin[playerid] != -1)
		{
		    new i = atendimento_admin[playerid];
			format(str, 150, "O Admin %s finalizou o atendimento, Duracao: %s.", Nome(playerid), ConvertTime(gettime()-Atendimento[i][at_Atendido]) );
			foreach(new pla:Player) if(Online(pla)) if(atendimento_player[pla] == i) atendimento_player[pla] = -1, ms(pla, 4, str);
			new idadm = AdminID(playerid);
			if(idadm != -1)
			{
				Admin[idadm][adm_Atendimentos] ++;
				salvar_admin(idadm);
			}
			format(str, 150, "Voce finalizou o atendimento, duracao: %s.", ConvertTime(gettime()-Atendimento[i][at_Atendido]) );
		    ms(playerid, 4, str);
		    destruir_atendimento(i);
		    atendimento_admin[playerid] = -1;
			return 1;
		}

		for(new ii; ii<MAX_ATENDIMENTOS; ii++)
		{
		    if(Atendimento[ii][at_Existe] != 0)
	     	{
		        if(Atendimento[ii][at_Player] == id[playerid])
		        {
		            ms(playerid, 4, "Voce cancelou o atendimento");
					destruir_atendimento(ii);
					return 1;
				}
			}
		}

		ms(playerid, 0, "Voce nao esta em um atendimento no momento !");
		return 1;
	}

	if(!strcmp(cmd, "/atendimento", true))
	{
		if(AdminPlayer(playerid) > 0) return ms(playerid, 0, "Voce e um Administrador, nao pode usar este comando !");
		new cont;
		for(new i; i<MAX_ATENDIMENTOS; i++)
		{
		    if(Atendimento[i][at_Existe] != 0)
	     	{
	     	    cont ++;
		        if(Atendimento[i][at_Player] == id[playerid])
		        {
					ms(playerid, 0, "Voce ja solicitou um atendimento recentemente, aguarde !");
					return 1;
				}
			}
		}
		if(cont == MAX_ATENDIMENTOS) return ms(playerid, 0, "Muitos atendimentos foram solicitados recentemente, aguarde e tente novamente !");
		ShowPlayerDialog(playerid, DIALOG_ATENDIMENTO, DIALOG_STYLE_LIST, "Prioridade do atendimento", "{4169E1}Baixa\n{ffff00}Media\n{ff0000}Alta", "Solicitar", "Cancelar");
		return 1;
	}

	if(!strcmp(cmd, "/atendimentos", true))
	{
	    mostrar_atendimentos(playerid);
		return 1;
	}

	if(!strcmp(cmd, "/ats", true))
	{
	    mostrar_atendimentos(playerid);
		return 1;
	}

	if(!strcmp(cmd, "/atender", true))
	{
		new i;
		new str[150];
	    if(sscanf(params, "d",  i)) return ms(playerid, 2, "Use: /atender [ ID do Atendimendo (/atendimentos) ].");
        if(!AdminPlayer(playerid))return ms(playerid, 2, "Voce nao e admin.");
		if(i < 0 || i >= MAX_ATENDIMENTOS) return ms(playerid, 0, "ID de atendimento Invalido !");
		if(Atendimento[i][at_Existe] == 0) return ms(playerid, 0, "Este ID de atendimento nao existe !");
		if(Atendimento[i][at_Existe] == 2) return ms(playerid, 0, "Algum Admin ja esta cuidando deste atendimento !");

		for(new ii; ii<MAX_ATENDIMENTOS; ii++)
		{
		    if(Atendimento[ii][at_Existe] != 0)
	     	{
		        if(Atendimento[ii][at_Admin] == id[playerid])
		        {
					ms(playerid, 0, "Voce ja esta em um atendimento no momento !");
					return 1;
				}
			}
		}

		new cc = Atendimento[i][at_Player];
		new idd = ContaOnline(cc);
		if(idd != -1)
		{
		    if(Online(idd))
		    {
				Atendimento[i][at_Existe] = 2;
				Atendimento[i][at_Atendido] = gettime();
				Atendimento[i][at_Admin] = id[playerid];
				format(str, 150, "O admin %s aceitou seu atendimento, use o chat para se comunicar.", Nome(playerid));
				ms(idd, 4, str);
				format(str, 150, "Voce aceitou o atendimento de %s, use o chat para se comunicar.", Nome(idd));
				ms(playerid, 4, str);
				format(str, 150, "Atendimento Iniciado, tempo de espera: %s.", ConvertTime(gettime()-Atendimento[i][at_Iniciado]));
				ms(playerid, 4, str);
				ms(idd, 4, str);
				atendimento_admin[playerid] = i;
				atendimento_player[idd] = i;
				ms(playerid, 4, "Use /encerrar para finalizar o atendimento.");
				ms(idd, 4, "Use /encerrar para finalizar o atendimento.");
				return 1;
			}
		}

		ms(playerid, 0, "O jogador que solicitou o atendimento nao esta mais Online !");
		return 1;
	}

	if(!strcmp(cmd, "/duvida", true))
	{
	    if(id[playerid] == -1) return ms(playerid, 0, "Voce nao esta em uma conta !");
		new mens[150];
		new sss[300];
		if(sscanf(params, "s[150]", mens)) return ms(playerid, 2, "Use: /duvida [ menssagem ]");
		if(strlen(mens) < 1) return ms(playerid, 0, "Menssagem muito curta ! Tente uma maior.");
		format(sss, 300, "{B0E0E6}[DUVIDA] {ffffff}%s {00ffff}%d {ffff00}%d: {B0E0E6}%s", Nome(playerid), id[playerid], playerid, mens);
		new cont;
		foreach(new i:Player)
		{
		    if(Online(i))
		    {
		        if(AdminPlayer(i) > 0)
				{
				    ms(i, 10, sss);
				    cont ++;
				}
		    }
		}
		if(cont == 0) ms(playerid, 0, "Nenhum admin Online no momento, tente mais tarde !");
		else ms(playerid, 1, "Menssagem enviada aos admins, aguarde ate que alguem lhe responsa com um /par.");
		return 1;
	}


	if(!strcmp(cmd, "/par", true))
	{
		if(id[playerid] == -1) return ms(playerid, 0, "Voce nao esta em uma conta !");
		new pla, mens[200];
		new sss[300];
		if(sscanf(params, "us[200]", pla, mens)) return ms(playerid, 2, "Use: /par [ ID/nick ] [ menssagem ]");
		if(pla == playerid) return ms(playerid, 0, "Voce nao pode enviar um particular a si mesmo !");
		if(strlen(mens) > 198) return ms(playerid, 0, "Menssagem muito longa, tente novamente !");
		if(!Online(pla)) return ms(playerid, 0, "Este jogador nao esta Online !");
		if(id[pla] == -1) return ms(playerid, 0, "Este player nao esta em uma conta !");
		if(strlen(mens) < 1) return ms(playerid, 0, "Menssagem muito curta ! Tente uma maior.");

		// se for um player usando //
		if(AdminPlayer(playerid) < 1)
		{
			if(AdminPlayer(pla) < 1)
			{
				ms(playerid, 0, "Voce so pode mandar /par para admins !");
				return 1;
			}
		    format(sss, 300, "{ffff00}[PAR] {ffffff}%s {00ffff}%d {ffff00}%d: {a1a1a1}%s", Nome(playerid), id[playerid], playerid, mens);
		    ms(pla, 10, sss);
		    format(sss, 300, "{ffff00}[PARTICULAR] Enviado para '%s': {a1a1a1}%s", Nome(pla), mens);
		    ms(playerid, 10, sss);
		    return 1;
		}

		format(sss, 300, "{FA8072}[ADMIN] {B0E0E6}%s {00ffff}%d {ffff00}%d: {a1a1a1}%s", Nome(playerid), id[playerid], playerid, mens);
		ms(pla, 10, sss);
		format(sss, 300, "{ffff00}[PARTICULAR] Enviado para '%s': {a1a1a1}%s", Nome(pla), mens);
		ms(playerid, 10, sss);
		return 1;
	}

	if(!strcmp(cmd, "/anims", true))
	{
		ShowAnimsDialog(playerid);
		return 1;
	}
	if(!strcmp(cmd, "/stopanims", true))
	{
		ClearAnimations(playerid, 1);
		return 1;
	}


	if(!strcmp(cmd, "/relaxar", true))
	{
	    if(em_anim[playerid] != 1)
		{
			em_anim[playerid] = 1;
			ApplyAnimation(playerid, "BEACH", "LAY_BAC_LOOP", 4.1, false, false, false, true, 0, 1);
		}
		else
		{
		    em_anim[playerid] = 0;
		    ClearAnimations(playerid, 1);
		}
		return 1;
	}

	if(!strcmp(cmd, "/sentar", true))
	{
		if(em_anim[playerid] != 2)
		{
			em_anim[playerid] = 2;
			ApplyAnimation(playerid, "PED","SEAT_idle", 4.1, false, false, false, true, 0, 1);
		}
		else
		{
		    em_anim[playerid] = 0;
		    ClearAnimations(playerid, 1);
		}
		return 1;
	}

	if(!strcmp(cmd, "/deitar", true))
	{
	    if(em_anim[playerid] != 3)
		{
			em_anim[playerid] = 3;
			ApplyAnimation(playerid, "CRACK","CRCKIDLE2", 4.1, false, false, false, true, 0, 1);
		}
		else
		{
		    em_anim[playerid] = 0;
		    ClearAnimations(playerid, 1);
		}
		return 1;
	}

	if(!strcmp(cmd, "/tirarcadeia", true))
	{
		new con, mot[100];
	    new sss[200];
		if(sscanf(params, "ds[100]", con, mot)) return ms(playerid, 2, "Use: /tirarcadeia [ CONTA ] [ Motivo ]");
		if(con < 0 || con >= MAX_CONTAS) return ms(playerid, 0, "Conta informada, Invalida !");
		if(ContaInvalida(con)) return ms(playerid, 0, "Conta informada, Nao existe !");
		if(strlen(mot) < 2) return ms(playerid, 0, "Digite um motivo mais especifico !");

	    new player = ContaOnline(con);
		if(Online(player))
		{
		    if(Conta[player][c_Cadeia] == -1) return ms(playerid, 0, "Este jogador nao foi preso por um Policial !");
		    Conta[player][c_TempoCadeia] = 1;
			PlayerSpawn(player);
		    format(sss, 300, "[STAFF] %s retirou '%s' da Prisao: %s.", Nome(playerid), Nome(player), mot);
			mst(0xF08080ff, sss);
			salvar_conta(con, -1, "c_Banimento");
		}
		else
		{
		    if(GetContaInt(con, "c_Cadeia") == -1) return ms(playerid, 0, "Este jogador nao foi preso por um Policial !");
	        salvar_conta(con, 0, "c_TempoCadeia", sv_int(1));
	        format(sss, 300, "[STAFF] %s lhe tirou da prisao: %s.", Nome(playerid), mot);
			msc(con, 0xF08080ff, sss);
			format(sss, 300, "[STAFF] %s retirou '%s' da Prisao: %s.", Nome(playerid), Nome(player), mot);
	        mst(0xF08080ff, sss);
		}

		return 1;
	}

	if(!strcmp(cmd, "/tirarcadeia2", true))
	{
		new con, mot[100];
	    new sss[200];
		if(sscanf(params, "ds[100]", con, mot)) return ms(playerid, 2, "Use: /tirarcadeia2 [ CONTA ] [ Motivo ]");
		if(con < 0 || con >= MAX_CONTAS) return ms(playerid, 0, "Conta informada, Invalida !");
		if(ContaInvalida(con)) return ms(playerid, 0, "Conta informada, Nao existe !");
		if(strlen(mot) < 2) return ms(playerid, 0, "Digite um motivo mais especifico !");

	    new player = ContaOnline(con);
		if(Online(player))
		{
		    if(Conta[player][c_Cadeia] == -1) return ms(playerid, 0, "Este jogador nao foi preso por um Policial !");
		    Conta[player][c_TempoCadeia] = 1;
			PlayerSpawn(player);
		    format(sss, 300, "[STAFF] %s retirou '%s' da Prisao: %s.", Nome(playerid), Nome(player), mot);
			mst(0xF08080ff, sss);
			salvar_conta(con, -1, "c_Banimento");
		}
		else
		{
		    if(GetContaInt(con, "c_Cadeia") == -1) return ms(playerid, 0, "Este jogador nao foi preso por um Policial !");
	        salvar_conta(con, 0, "c_TempoCadeia", sv_int(1));
	        format(sss, 300, "[STAFF] %s lhe tirou da prisao: %s.", Nome(playerid), mot);
			msc(con, 0xF08080ff, sss);
			format(sss, 300, "[STAFF] %s retirou '%s' da Prisao: %s.", Nome(playerid), Nome(player), mot);
	        mst(0xF08080ff, sss);
		}

		return 1;
	}

	if(!strcmp(cmd, "/comprararmas", true))
	{
		new nome[40], qtd;
		if(sscanf(params, "s[40]d", nome, qtd)) return ms(playerid, 2, "Use: /comprararmas [ Arma ] [ Quantidade ]");
		new o = OrgPlayer(playerid);
		if(o == -1) return ms(playerid, 0, "Voce nao pertence a uma organizacao !");
		if(!OrgCop(o)) return ms(playerid, 0, "Sua organizacao nao e uma corporacao policial !");
		if(Conta[playerid][c_Cargo] < 5) return ms(playerid, 0, "Apenas Lider e SubLider podem comprar armas !");
		if(qtd < 1 || qtd > 100) return ms(playerid, 0, "Quantidade invalida (1 a 100) !");
		new idx = -1;
		for(new a; a < sizeof armas_org; a++)
		{
			new wn[40];
			format(wn, 40, "%s", nome_arma(armas_org[a][0]));
			if(strcmp(wn, nome, true) == 0)
			{
				idx = a;
				break;
			}
		}
		if(idx == -1) return ms(playerid, 0, "Arma nao encontrada! Use: Desert, Escopeta, MP5, M4.");
		if(is_arma_bloqueada(armas_org[idx][0])) return ms(playerid, 0, "Esta arma foi removida do servidor e nao pode ser comprada !");
		new preco_unidade;
		switch(idx)
		{
			case 0: preco_unidade = 2000;   // desert eagle
			case 1: preco_unidade = 3000;   // escopeta
			case 2: preco_unidade = 5000;   // mp5
			case 3: preco_unidade = 8000;   // m4
		}
		new preco_total = preco_unidade * qtd;
		if(Org[o][o_Cofre] < preco_total) return ms(playerid, 0, f("A organizacao nao tem dinheiro suficiente no cofre! Precisa de R$ %s.", ConvertMoney(preco_total)));
		Org[o][o_Cofre] -= preco_total;
		add_cp(preco_total);
		Org[o][o_Armas][idx] += qtd;
		salvar_org(o);
		mst(0x00BFFFff, f("[ORG] %s comprou %d %s por R$ %s.", Nome(playerid), qtd, nome_arma(armas_org[idx][0]), ConvertMoney(preco_total)));
		ms(playerid, 1, f("Voce comprou %d %s por R$ %s para a organizacao.", qtd, nome_arma(armas_org[idx][0]), ConvertMoney(preco_total)));
		return 1;
	}

	if(!strcmp(cmd, "/comprarmunicoes", true))
	{
		new nome[40], qtd;
		if(sscanf(params, "s[40]d", nome, qtd)) return ms(playerid, 2, "Use: /comprarmunicoes [ Tipo ] [ Quantidade ]");
		new o = OrgPlayer(playerid);
		if(o == -1) return ms(playerid, 0, "Voce nao pertence a uma organizacao !");
		if(!OrgCop(o)) return ms(playerid, 0, "Sua organizacao nao e uma corporacao policial !");
		if(Conta[playerid][c_Cargo] < 5) return ms(playerid, 0, "Apenas Lider e SubLider podem comprar municoes !");
		if(qtd < 1 || qtd > 100) return ms(playerid, 0, "Quantidade invalida (1 a 100) !");
		new idx = -1;
		for(new a; a < sizeof municoes_org; a++)
		{
			new mn[40];
			format(mn, 40, "%s", nome_municao(municoes_org[a][0]));
			if(strcmp(mn, nome, true) == 0 || strcmp(mn[8], nome, true) == 0) { idx = a; break; }
		}
		if(idx == -1) return ms(playerid, 0, "Tipo de municao invalido! Use: Pistola, 12, Sub, Rifle.");
		new precos[] = {50, 50, 50, 50};
		new preco_total = precos[idx] * qtd;
		if(Org[o][o_Cofre] < preco_total) return ms(playerid, 0, f("A organizacao nao tem dinheiro suficiente! Precisa de R$ %s.", ConvertMoney(preco_total)));
		Org[o][o_Cofre] -= preco_total;
		add_cp(preco_total);
		Org[o][o_Municoes][idx] += qtd;
		salvar_org(o);
		mst(0x00BFFFff, f("[ORG] %s comprou %d caixas de municao %s por R$ %s.", Nome(playerid), qtd, nome_municao(municoes_org[idx][0]), ConvertMoney(preco_total)));
		ms(playerid, 1, f("Voce comprou %d caixas de %s por R$ %s.", qtd, nome_municao(municoes_org[idx][0]), ConvertMoney(preco_total)));
		return 1;
	}

	if(!strcmp(cmd, "/comprarcoletes", true))
	{
		new qtd;
		if(sscanf(params, "d", qtd)) return ms(playerid, 2, "Use: /comprarcoletes [ Quantidade ]");
		new o = OrgPlayer(playerid);
		if(o == -1) return ms(playerid, 0, "Voce nao pertence a uma organizacao !");
		if(!OrgCop(o)) return ms(playerid, 0, "Sua organizacao nao e uma corporacao policial !");
		if(Conta[playerid][c_Cargo] < 5) return ms(playerid, 0, "Apenas Lider e SubLider podem comprar coletes !");
		if(qtd < 1 || qtd > 100) return ms(playerid, 0, "Quantidade invalida (1 a 100) !");
		new preco_unidade = 1000;
		new preco_total = preco_unidade * qtd;
		if(Org[o][o_Cofre] < preco_total) return ms(playerid, 0, f("A organizacao nao tem dinheiro suficiente no cofre! Precisa de R$ %s.", ConvertMoney(preco_total)));
		Org[o][o_Cofre] -= preco_total;
		add_cp(preco_total);
		Org[o][o_Coletes] += qtd;
		salvar_org(o);
		mst(0x00BFFFff, f("[ORG] %s comprou %d coletes por R$ %s.", Nome(playerid), qtd, ConvertMoney(preco_total)));
		ms(playerid, 1, f("Voce comprou %d coletes por R$ %s para a organizacao.", qtd, ConvertMoney(preco_total)));
		return 1;
	}

	if(!strcmp(cmd, "/prender", true))
	{
		new con, dias, mot[100];
	    new sss[200];
		if(sscanf(params, "dds[100]", con, dias, mot)) return ms(playerid, 2, "Use: /prender [ CONTA ] [ Minutos ] [ Motivo ]"),
		ms(playerid, 2, "Retirar Cadeia: Use 0 Minutos para retirar a cadeia de uma conta.");
		if(con < 0 || con >= MAX_CONTAS) return ms(playerid, 0, "Conta informada, Invalida !");
		if(ContaInvalida(con)) return ms(playerid, 0, "Conta informada, Nao existe !");
		if(strlen(mot) < 2) return ms(playerid, 0, "Digite um motivo mais especifico !");

	    new player = ContaOnline(con);
		if(Online(player))
		{
		    new tava = Conta[player][c_CA_Tempo];
		    if(dias == 0)
		    {
		        if(tava > 0)
				{
					Conta[player][c_CA_Tempo] = 1;
					format(Conta[player][c_CA_Motivo], 100, mot);
					Conta[player][c_CA_Admin] = id[playerid];
					PlayerSpawn(player);
					format(sss, 300, "[STAFF] %s retirou '%s' da Cadeia Staff: %s.", Nome(playerid), Nome(player), mot);
					mst(0xF08080ff, sss);
					salvar_conta(con, -1, "c_Banimento");
				}
		        else ms(playerid, 0, "Este jogador nao esta na Cadeia Staff !");
		    }
		    else
		    {
			    Conta[player][c_CA_Tempo] = (dias*60);
			    format(Conta[player][c_CA_Motivo], 100, mot);
				Conta[player][c_CA_Admin] = id[playerid];
				PlayerSpawn(player);
			    format(sss, 300, "[STAFF] %s prendeu '%s' na Cadeia Staff por (%s): %s.", Nome(playerid), Nome(player), ConvertTime(dias*60), mot);
				mst(0xF08080ff, sss);
				salvar_conta(con, -1, "c_Banimento");
		    }
		}
		else
		{
		    new tava =  GetContaInt(con, "c_CA_Tempo");
		    if(dias == 0)
		    {
		        if(tava > 0)
		        {
		            salvar_conta(con, 0, "c_CA_Tempo", sv_int(0));
		            salvar_conta(con, 1, "c_X", sv_float(0.0));
				    salvar_conta(con, 1, "c_Y", sv_float(0.0));
				    salvar_conta(con, 1, "c_Z", sv_float(0.0));
				    salvar_conta(con, 1, "c_A", sv_float(0.0));
		            format(sss, 300, "[STAFF] %s retirou lhe retirou da Cadeia Staff: %s.", Nome(playerid), mot);
					msc(con, 0xF08080ff, sss);
		            format(sss, 300, "[STAFF] %s retirou '%s' da Cadeia Staff: %s.", Nome(playerid), NomeConta(con), mot);
					mst(0xF08080ff, sss);
				}
				else ms(playerid, 0, "Este jogador nao esta na Cadeia Staff !");
		    }
		    else
		    {
		        salvar_conta(con, 0, "c_CA_Tempo", sv_int(dias*60));
		        salvar_conta(con, 0, "c_CA_Admin", sv_int(id[playerid]));
		        salvar_conta(con, 2, "c_CA_Motivo", mot);
		        format(sss, 300, "[STAFF] %s lhe prendeu na Cadeia Staff (%s): %s.", Nome(playerid), ConvertTime(dias*60), mot);
				msc(con, 0xF08080ff, sss);
		        format(sss, 300, "[STAFF] %s prendeu '%s' na Cadeia Staff por (%s): %s.", Nome(playerid), NomeConta(con), ConvertTime(dias*60), mot);
				mst(0xF08080ff, sss);
			}
	        }

	        // deposito de veiculos //
			if(IsPlayerInRangeOfPoint(playerid, 3.0, 1224.4751, -1475.8009, 13.5392))
			{
				abrir_deposito_veiculos(playerid);
				return 1;
			}

		    return 1;
	}

	if(!strcmp(cmd, "/ban", true))
	{
	    new con, dias, mot[100];
	    new sss[200];
		if(sscanf(params, "dds[100]", con, dias, mot)) return ms(playerid, 2, "Use: /ban [ CONTA ] [ Dias ] [ motivo ]"),
		ms(playerid, 2, "Desbanir: Use 0 Dias para desbanir uma conta.");
		if(con < 0 || con >= MAX_CONTAS) return ms(playerid, 0, "Conta informada, Invalida !");
		if(ContaInvalida(con)) return ms(playerid, 0, "Conta informada, Nao existe !");
		if(strlen(mot) < 2) return ms(playerid, 0, "Digite um motivo mais especifico !");

		if(dias == 0)
		{
		    new ipconta[20];
			format(ipconta, 20, GetContaString(con, "c_IP"));
			new file[40];
		    format(file, 40, "IPS_Banidos/%s.txt", ipconta);
		    if(DOF2_FileExists(file))
		    {
		        conta_desban[playerid] = con;
		    	format(motivo_desban[playerid], 100, mot);
		    	format(ip_desban[playerid], 20, ipconta);
		    	new ssss[300];
		    	format(ssss, 300, "{ffffff}Deseja tambem desbanir o IP: {00ffff}%s {ffffff}?", ipconta);
		        ShowPlayerDialog(playerid, DIALOG_DESBAN_IP, DIALOG_STYLE_MSGBOX, "DESBANIR IP", ssss, "Sim", "Nao");
		        return 1;
		    }

		    salvar_conta(con, 0, "c_Ban_Tempo", sv_int(0));
		    format(sss, 150, "[DESBAN] O admin '%s' desbaniu a conta [%d] '%s', pelo motivo: %s.", Nome(playerid), con, NomeConta(con), mot);
		    mst(0xF08080ff, sss);
		    format(sss, 150, "[DESBAN] O admin '%s' desbaniu a sua conta, pelo motivo: %s.", Nome(playerid), mot);
		    msc(con, 5, sss);
		    escrever_log("Log/Desban.txt", sss);
		    return 1;
		}

	    if(dias >= 50) format(sss, 150, "[BAN] O admin '%s' BANIU a conta [%d] '%s' PERMANENTE, pelo motivo: %s.", Nome(playerid), con, NomeConta(con), mot);
		else format(sss, 150, "[BAN] O admin '%s' BANIU a conta [%d] '%s' por %d Dias, pelo motivo: %s.", Nome(playerid), con, NomeConta(con), dias, mot);
		mst(0xF08080ff, sss);
		escrever_log("Log/Ban.txt", sss);

		// tirar jogador do servidor //
		new pla = ContaOnline(con);
		new ipplayer[20];
		if(Online(pla))
		{
		    if(AdminPlayer(pla) > AdminPlayer(playerid)) return ms(playerid, 0, "Voce nao pode Banir nesse admin !");
		    if(dias >= 50) Conta[pla][c_Ban_Tempo] = -1;
		    else Conta[pla][c_Ban_Tempo] = gettime() + ((24*3600)*dias);
		    Conta[pla][c_Ban_Admin] = id[playerid];
		    format(Conta[pla][c_Ban_Motivo], 100, mot);
		    salvar_conta(con, -1, "c_Banimento");

		    new file[40];
		    GetPlayerIp(pla, ipplayer, 20);
		    format(file, 40, "IPS_Banidos/%s.txt", ipplayer);
		    if(!DOF2_FileExists(file)) DOF2_CreateFile(file);
			DOF2_SetInt(file, "c_Ban_Admin", id[playerid]);
			DOF2_SetInt(file, "c_Ban_Conta", id[pla]);
		    DOF2_SaveFile();
			banir(pla);
			return 1;
		}

	 	if(AdminConta(con) > AdminPlayer(playerid)) return ms(playerid, 0, "Voce nao pode Banir nesse admin !");
	    if(dias >= 50) salvar_conta(con, 0, "c_Ban_Tempo", sv_int(-1));
		salvar_conta(con, 0, "c_Ban_Tempo", sv_int(gettime() + ((24*3600)*dias)));
		salvar_conta(con, 0, "c_Ban_Admin", sv_int(id[playerid]));
		salvar_conta(con, 2, "c_Ban_Motivo", mot);

	    new file[40];
		format(ipplayer, 20, GetContaString(con, "c_IP"));
	    format(file, 40, "IPS_Banidos/%s.txt", ipplayer);
	    if(!DOF2_FileExists(file)) DOF2_CreateFile(file);
		DOF2_SetInt(file, "c_Ban_Admin", id[playerid]);
		DOF2_SetInt(file, "c_Ban_Conta", con);
	    DOF2_SaveFile();

		foreach(new a:Player)
		{
		    if(Online(a))
		    {
	      		if(id[a] == -1)
				{
				if(contas[a] == con)
				{
				    banir(a);
				}
	      		}
		    }
		}
		return 1;
	}


	if(!strcmp(cmd, "/kick", true))
	{
		new p, mot[100];
		if(sscanf(params, "us[100]", p, mot)) return ms(playerid, 2, "Use: /kick [ ID/Nick ] [ motivo ]");
		if(!Online(p)) return ms(playerid, 0, "Este jogador nao esta Online !");
		if(strlen(mot) < 2) return ms(playerid, 0, "Digite um motivo mais especifico !");
		new sss[150];
		format(sss, 150, "[KICK] O Admin '%s' Kickou '%s' do servidor pelo motivo: %s.", Nome(playerid), Nome(p), mot);
		mst(0xF08080ff, sss);
		escrever_log("Log/Kick.txt", sss);
		kikar(p);
		return 1;
	}


	if(!strcmp(cmd, "/payday", true))
	{
		new sss[150];
	    format(sss, 150, "O admin '%s' deu um PayDay manual.", Nome(playerid));
		mst( 2, sss);
		PayDay(1);
		return 1;
	}

	if(!strcmp(cmd, "/render", true))
	{
		render(playerid);
		return 1;
	}

	if(!strcmp(cmd, "/contas", true))
	{
		abrir_contas(playerid);
		return 1;
	}

	if(!strcmp(cmd, "/cc", true))
	{
	    dialog_criar_conta(playerid, 1);
		return 1;
	}

	if(!strcmp(cmd, "/arena", true))
	{
		if(Online(playerid))
		{
			new c = id[playerid];
			if(c != -1)
			{
			    if(player_arena[playerid] == 1)
				{
				    if(IsValidDynamicActor(actor_player[playerid])) DestroyDynamicActor(actor_player[playerid]);
				    if(IsValidDynamic3DTextLabel(actor_player_3D[playerid])) DestroyDynamic3DTextLabel(actor_player_3D[playerid]);
					actor_player_3D[playerid] = DynamicText3D:-1;
					actor_player[playerid] = -1;
	       			atualizar_conta(c);
				    player_arena[playerid] = 0;
				    PlayerSpawn(playerid);
				}
			}
		}
		return 1;
	}

	if(!strcmp(cmd, "/movel", true))
	{
		new i, m;
	    if(sscanf(params, "dd", i, m)) return ms(playerid, 2, "Use: /movel [ ID da casa ] [ ID do movel ]");
		if(i < 0 || i >= MAX_CASAS) return 1;
		if(m < 0 || m >= sizeof moveis) return 1;
		new Float:p[3];
	    GetPlayerPos(playerid, p[0], p[1], p[2]);
	    PegarFrentePlayer(playerid, p[0], p[1], 2);
		new mov = criar_movel(i, m, p[0], p[1], p[2]);
		if(mov == -1) return 1;
		SetPVarInt(playerid, "casa", i);
		EditandoMovel[playerid] = mov;
		EditDynamicObject2(playerid, Casa[i][casa_m_Obj][mov]);
		ms(playerid, 1, "Movimente o objeto usando o editor, e salve a posicao.");
		return 1;
	}

	if(!strcmp(cmd, "/roleta", true))
	{
		roleta_player(playerid);
		return 1;
	}

	if(!strcmp(cmd, "/vdp", true))
	{
	    PlayersPerto(playerid, 30, 5);
		return 1;
	}

	if(!strcmp(cmd, "/su", true))
	{
		mostrar_su(playerid);
		return 1;
	}

	if(!strcmp(cmd, "/procurados", true))
	{
		mostrar_procurados(playerid);
		return 1;
	}

	if(!strcmp(cmd, "/presos", true))
	{
		mostrar_presos(playerid);
		return 1;
	}

	if(!strcmp(cmd, "/d", true))
	{
		new o = OrgPlayer(playerid);
		if(o != -1)
		{
		    new falou[150];
		    if(sscanf(params, "s[150]", falou)) return ms(playerid, 2, "Use: /d [ Menssagem ]");
		    new sss[300];
		    format(sss, 300, "(( %s [%s]: %s ))", Nome(playerid), Org[o][o_Tag], falou);
		    mscop(sss, 0xFF8C00ff);
	    }
		return 1;
	}

	if(!strcmp(cmd, "/mec", true))
	{
	    if(PlayerMecanicoOrg(playerid))
	    {
	        new falou[150];
	        if(sscanf(params, "s[150]", falou)) return ms(playerid, 2, "Use: /mec [ Menssagem ]");
	        new sss[300];
	        format(sss, 300, "(( Mecanico %s: %s ))", Nome(playerid), falou);
	        msmmec(sss, 0x00BFFFff);
	    }
	    else ms(playerid, 0, "Voce nao eh um mecanico!");
	    return 1;
	}

	if(!strcmp(cmd, "/a", true))
	{
	    new falou[150];
	    if(sscanf(params, "s[150]", falou)) return ms(playerid, 2, "Use: /a [ Menssagem ]");
	    new sss[300];
	    format(sss, 300, "[STAFF] {FF69B4}%s[%d]: {FFB6C1}%s", Nome(playerid), playerid, falou);
	    msa(0xFF69B4ff, sss);
		return 1;
	}

	if(!strcmp(cmd, "/policia", true))
	{
	    new cont_total;
	    new SG_org[1000];
	    SG_org[0] = EOS;
	    for(new o; o<MAX_ORGS; o++)
	    {
	        if(Org[o][o_Existe] == 1)
	        {
	            if(Org[o][o_Tipo] == 0 || Org[o][o_Tipo] == 1)
	            {
	                new cont_org;
	                foreach(new p:Player)
	                {
	                    if(Online(p) && OrgPlayer(p) == o && EmServico(p))
	                        cont_org++;
	                }
	                if(cont_org > 0)
	                {
	                    new linha[100];
	                    format(linha, 100, "{ffffff}%s: {00ffff}%d\n", Org[o][o_Nome], cont_org);
	                    strcat(SG_org, linha);
	                    cont_total += cont_org;
	                }
	            }
	        }
	    }
	    if(cont_total == 0) ms(playerid, 0, "Nenhum policial em servico no momento.");
	    else
	    {
	        new final[1200];
	        format(final, 1200, "{ffffff}POLICIAIS EM SERVIÇO\n\n%s{ffffff}Total: {00ffff}%d", SG_org, cont_total);
	        ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}.", final, "Ok", "");
	    }
	    return 1;
	}

	if(!strcmp(cmd, "/r", true))
	{
		new o = OrgPlayer(playerid);
	    new falou[150];
	    if(sscanf(params, "s[150]", falou)) return ms(playerid, 2, "Use: /r [ Menssagem ]");
	    new sss[300];
	    format(sss, 300, "(( Radio - %s[%d]: %s ))", Nome(playerid), playerid, falou);
	    mso(o, sss);
		return 1;
	}


	if(!strcmp(cmd, "/membros", true))
	{
		new o = OrgPlayer(playerid);
	    new sss[150];
	    new cont;
	    SG[0] = EOS;
	    strcat(SG, "Conta\tNome\tCargo\n");
		zerar_lista(playerid);
	    for(new i; i<30; i++)
	    {
	        if(Org[o][o_Membros][i] != -1)
	        {
	            new c = Org[o][o_Membros][i];
	            format(sss, 150, "{ffffff}%d\t{ffffff}%s\t{a1a1a1}%s\n", c, NomeConta(c), nome_cargo(Org[o][o_Cargos][i], o));
	            strcat(SG, sss);
				Lista[playerid][cont] = c;
				cont ++;
	    	}
		}
		format(sss, 150, "{ffffff}Membros [ {ffff00}%d {ffffff}]", cont);
		ShowPlayerDialog(playerid, DIALOG_MEMBROS_ONLINE, DIALOG_STYLE_TABLIST_HEADERS, sss, SG, "Continuar", "Fechar");
		return 1;
	}

	if(!strcmp(cmd, "/nota", true))
	{
		if(EmpregoPlayer(playerid) == 7)
		{
		    if(NotaPlayer(playerid) != -1)
		    {
		        nota(playerid);
		    }
		    else MS(playerid, 0, "voce nao tem uma nota fiscal de entrega !");
		}
		else MS(playerid, 0, "Voce nao pode usar este comando !");
		return 1;
	}

    // BCG CEF: /celular e /cel sao interceptados pelo APK e abrem o telefone CEF.
    // Nunca mais direcionar celular para o inventario/menu antigo.
    if(!strcmp(cmd, "/celular", true) || !strcmp(cmd, "/cel", true))
    {
        ms(playerid, 5, "Celular CEF aberto pelo cliente oficial BCG.");
        return 1;
    }

    if(!strcmp(cmd, "/inv", true) || !strcmp(cmd, "/inventario", true) ||
       !strcmp(cmd, "/radio", true) || !strcmp(cmd, "/menu", true))
    {
	 	abrir_menu_player(playerid);
		return 1;
	}

	if(!strcmp(cmd, "/gps", true))
	{
		mostrar_ajuda_respawn(playerid);
		return 1;	
	}	
	
  	if(!strcmp(cmd, "/lnp", true))
	{
		new idd;
		if(sscanf(params, "d", idd)) return ms(playerid, 2, "Use: /lnp [ ID da Conta ]");
		if(ContaInvalida(idd)) return ms(playerid, 0, "Esta conta nao existe !");
	    new pla = ContaOnline(idd);
		if(Online(pla))
		{
		    if(Conta[pla][c_Procurado] == 0) return ms(playerid, 0, "Esta conta nao tem nenhum nivel de procura !");
		    LimparNivelProcurado(pla);
		}
		else
		{
		    if(GetContaInt(idd, "c_Procurado") == 0) return ms(playerid, 0, "Esta conta nao tem nenhum nivel de procura !");
			salvar_conta(idd, 0, "c_Procurado", sv_int(0));
		}

		new sss[150];
		format(sss, 150, "Voce limpou o Nivel de procura na conta %d '%s'.", idd, NomeConta(idd));
		ms(playerid, 4, sss);
		format(sss, 150, "O Administrador '%s' limpou seu nivel de procura.", Nome(playerid));
		msc(idd, 2, sss);
		return 1;
	}

	if(!strcmp(cmd, "/dnp", true))
	{
		new idd;
		if(sscanf(params, "d", idd)) return ms(playerid, 2, "Use: /dnp [ ID da Conta ]");
		if(ContaInvalida(idd)) return ms(playerid, 0, "Esta conta nao existe !");
	    new pla = ContaOnline(idd);
		if(Online(pla))
		{
		    if(Conta[pla][c_Procurado] > 9) return ms(playerid, 0, "Esta conta ja esta com 10 niveis de procura !");
	        DarNivelProcurado(pla, 1);
		}
		else
		{
		    new nivv = GetContaInt(idd, "c_Procurado");
		    if(nivv > 9) return ms(playerid, 0, "Esta conta ja esta com 10 niveis de procura !");
	        salvar_conta(idd, 0, "c_Procurado", sv_int(nivv+1));
		}

		new sss[150];
		format(sss, 150, "Voce deu 1 Nivel de procura na conta %d '%s'.", idd, NomeConta(idd));
		ms(playerid, 4, sss);
		format(sss, 150, "O Administrador '%s' lhe deu 1 nivel de procura.", Nome(playerid));
		msc(idd, 2, sss);
		return 1;
	}

	if(!strcmp(cmd, "/snp", true))
	{
		new skina, idd;
		if(sscanf(params, "dd", idd, skina)) return ms(playerid, 2, "Use: /snp [ ID da Conta ] [ 1 a 7 ]");
		if(ContaInvalida(idd)) return ms(playerid, 0, "Esta conta nao existe !");
		if(skina < 1 || skina > 10) return ms(playerid, 0, "Use um nivel de 1 a 7 !");
		new pla = ContaOnline(idd);
		if(Online(pla)) SetarNivelProcurado(pla, skina);
		else salvar_conta(idd, 0, "c_Procurado", sv_int(skina));
		new sss[150];
		format(sss, 150, "Voce setou Nivel %d de procura na conta %d '%s'.", skina, idd, NomeConta(idd));
		ms(playerid, 4, sss);
		format(sss, 150, "O Administrador '%s' setou seu nivel de procura em %d.", Nome(playerid), skina);
		msc(idd, 2, sss);
		return 1;
	}


	if(!strcmp(cmd, "/fabricacao", true))
	{
	    fabricacao(playerid);
		return 1;
	}

	if(!strcmp(cmd, "/armas", true))
	{
	    mostrar_info_armas(playerid);
		return 1;
	}

	if(!strcmp(cmd, "/editarveiculos", true) || !strcmp(cmd, "/eveiculo", true))
	{
	    mostrar_info_veiculos(playerid);
		return 1;
	}

	if(!strcmp(cmd, "/setarsede", true))
	{
		new sss[300], idd, vida;
		if(sscanf(params, "ud", idd, vida)) return ms(playerid, 0, "Use: /setarsede [ ID/Nick ] [ 1 a 100 ]");
		if(!Online(idd)) return ms(playerid, 0, "Este jogador nao esta Online.");
		if(id[idd] == -1) return ms(playerid, 0, "Este jogador nao esta em uma Conta !");
		if(vida < 1 || vida > 100) return ms(playerid, 0, "Use um valor entre 1 e 100 !");
		SetarSede(idd, vida);
		format(sss, 300, "O Admin %s setou sua Sede para [%d].",Nome(playerid), vida);
		ms(idd, 0xF08080ff, sss);
		format(sss, 300, "Voce setou a Sede de %s para [%d].",Nome(idd), vida);
		ms(playerid, 5, sss);
		return 1;
	}


	if(!strcmp(cmd, "/setarcash", true))
	{
		new sss[300], c, valor;
		if(sscanf(params, "dd", c, valor)) return ms(playerid, 0, "Use: /setarcash [ ID da conta ] [ R$ Cash ]");
		if(ContaInvalida(c)) return ms(playerid, 0, "Esta conta nao existe !");
		if(valor < 1 ) return ms(playerid, 0, "Use um valor maior ou igual a 1 !");
	    format(sss, 300, "O Admin %s setou seu Cash para [%s].", Nome(playerid), ConvertMoney(valor));
	    new pla = ContaOnline(c);
		if(Online(pla))
		{
		    SetarCash(pla, valor);
		    ms(pla, 0xF08080ff, sss);
		}
		else
		{
		    salvar_conta(c, 0, "c_Cash", sv_int(valor));
		    msc(c, 0xF08080ff, sss);
		}
		format(sss, 300, "Voce setou o Cash da Conta %d '%s', para [ R$ %s ].", c, NomeConta(c), ConvertMoney(valor));
		ms(playerid, 5, sss);

		format(sss, 300, "Admin '%s' setou [ R$ %s ] de cash da Conta %d '%s'.", Nome(playerid), ConvertMoney(valor), c, NomeConta(c));
		escrever_log("Log/DarCash.txt", sss);
		return 1;
	}

	if(!strcmp(cmd, "/darcash", true))
	{
		new sss[300], c, valor;
		if(sscanf(params, "dd", c, valor)) return ms(playerid, 0, "Use: /darcash [ ID da conta ] [ R$ Cash ]");
		if(ContaInvalida(c)) return ms(playerid, 0, "Esta conta nao existe !");
		if(valor < 1 ) return ms(playerid, 0, "Use um valor maior ou igual a 1 !");
	    format(sss, 300, "O Admin %s lhe deu [ R$ %s ] de Cash.", Nome(playerid), ConvertMoney(valor));

	    new pla = ContaOnline(c);
		if(Online(pla))
		{
		    DarCash(pla, valor);
		    ms(pla, 0xF08080ff, sss);
		}
		else
		{
		    new gran = GetContaInt(c, "c_Cash");
		    salvar_conta(c, 0, "c_Cash", sv_int(gran+valor));
		    msc(c, 0xF08080ff, sss);
		}

		format(sss, 300, "Voce deu [ R$ %s ] de cash, para a Conta %d '%s'.", ConvertMoney(valor), c, NomeConta(c));
		ms(playerid, 5, sss);

