		if(Casa[o][casa_Existe] == 0) return ms(playerid, 0, "Esta Casa nao existe !");
		SetPlayerPos_(playerid, Casa[o][casa_X1]+0.1, Casa[o][casa_Y1]+0.1, Casa[o][casa_Z1]+0.1);
