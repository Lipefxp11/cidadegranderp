stock VerificarSenha(const string[], maxx)
{
	new tem;
	for(new i; i<strlen(string); i++)
	{
        for(new a; a<sizeof caracteres_senha; a++) if(string[i] == caracteres_senha[a]) tem ++;
	}
	if(tem < maxx) return 0;
	return 1;
}

stock VerificarNick(const string[])
{
	new maxx = strlen(string);
	new espacos;
	new testa[] = "'";
	new tem;
	for(new i = 0, j = strlen(string); i < j; i++)
	{
	    if(string[i] == '?') return 0;
	    if(string[i] == '?') return 0;
	    if(string[i] == '?') return 0;
	    if(string[i] == '?') return 0;
	    if(string[i] == '?') return 0;
	    if(string[i] == '?') return 0;
	    if(string[i] == '?') return 0;
	    if(string[i] == '?') return 0;
		if(string[i] == '?') return 0;
		if(string[i] == '?') return 0;
        if(string[i] == '?') return 0;
        if(string[i] == '?') return 0;
        if(string[i] == '?') return 0;
        if(string[i] == '?') return 0;
        if(string[i] == '?') return 0;
        if(string[i] == '?') return 0;
	    if(string[i] == '?') return 0;
	    if(string[i] == '?') return 0;
	    if(string[i] == '?') return 0;
	    if(string[i] == '?') return 0;
	    if(string[i] == '?') return 0;
	    if(string[i] == '?') return 0;
	    if(string[i] == '?') return 0;
		if(string[i] == '?') return 0;
		if(string[i] == '?') return 0;
        if(string[i] == '?') return 0;
        if(string[i] == '?') return 0;
        if(string[i] == '?') return 0;
        if(string[i] == '?') return 0;
        if(string[i] == '?') return 0;
	    if(string[i] == '`') return 0;
	    if(string[i] == '?') return 0;
	    if(string[i] == '[') return 0;
	    if(string[i] == '{') return 0;
	    if(string[i] == '?') return 0;
	    if(string[i] == '-') return 0;
	    if(string[i] == '+') return 0;
	    if(string[i] == '=') return 0;
	    if(string[i] == '?') return 0;
	    if(string[i] == '!') return 0;
	    if(string[i] == '@') return 0;
	    if(string[i] == '#') return 0;
	    if(string[i] == '$') return 0;
	    if(string[i] == '%') return 0;
	    if(string[i] == '?') return 0;
	    if(string[i] == '?') return 0;
	    if(string[i] == '?') return 0;
	    if(string[i] == '&') return 0;
	    if(string[i] == '*') return 0;
	    if(string[i] == '(') return 0;
	    if(string[i] == ')') return 0;
	    if(string[i] == '~') return 0;
	    if(string[i] == '^') return 0;
	    if(string[i] == '}') return 0;
	    if(string[i] == ']') return 0;
	    if(string[i] == '?') return 0;
	    if(string[i] == '<') return 0;
	    if(string[i] == ',') return 0;
	    if(string[i] == '.') return 0;
	    if(string[i] == '>') return 0;
	    if(string[i] == ';') return 0;
	    if(string[i] == ':') return 0;
	    if(string[i] == '/') return 0;
	    if(string[i] == '?') return 0;
	    if(string[i] == '?') return 0;
	    if(string[i] == '"') return 0;
	    if(string[i] == testa[0]) return 0;
	    if(string[i] == ' ') return 0;
        if(string[i] == '_') espacos ++, tem ++;
        for(new a; a<sizeof caracteres_nick; a++) if(string[i] == caracteres_nick[a]) tem ++;
	}
	if(tem < maxx) return 0;
	if(espacos == 0 || espacos > 1) return 0;
	return 1;
}

stock esconder_contas(playerid)
{
    for(new ii; ii<sizeof T_Lobby; ii++) TextDrawHideForPlayer(playerid, T_Lobby[ii]);
    for(new ii; ii<9; ii++) PlayerTextDrawHide(playerid, LobbyP[playerid][ii]);
    for(new g; g<sizeof T_Premio; g++) TextDrawHideForPlayer(playerid, T_Premio[g]);
    PlayerTextDrawHide(playerid, T_Premio_p[playerid][0]);
    PlayerTextDrawHide(playerid, T_Premio_p[playerid][1]);
    for(new g; g<sizeof T_Fichas; g++) TextDrawHideForPlayer(playerid, T_Fichas[g]);
	PlayerTextDrawHide(playerid, T_Fichas_p[playerid][0]);
}


stock mostrar_premio(playerid)
{
    new c = contas[playerid];
    if(GetContaInt(c, "c_TempoOnlineDia") != getdate())
	{
        salvar_conta(c, 0, "c_TempoOnlineDia", sv_int(getdate()));
        salvar_conta(c, 0, "c_TempoOnline", sv_int(0));
    }
    for(new g; g<sizeof T_Premio; g++) TextDrawShowForPlayer(playerid, T_Premio[g]);
	new Float:baraa = 618.750854-490.895538;
	new Float:unids = baraa/TEMPO_RECOMPENSSA;
	new fichas = GetContaInt(c, "c_Fichas");
	new tmp = GetContaInt(c, "c_TempoOnline");
	if(tmp > TEMPO_RECOMPENSSA) tmp = TEMPO_RECOMPENSSA;
	new Float:total = 490.895538+(tmp*unids);
	PlayerTextDrawTextSize(playerid, T_Premio_p[playerid][0], total, 0.000000);
	PlayerTextDrawShow(playerid, T_Premio_p[playerid][0]);
	if(tmp < TEMPO_RECOMPENSSA)
	{
		PlayerTextDrawSetString(playerid, T_Premio_p[playerid][1], ConvertTime(tmp));
		PlayerTextDrawColor(playerid, T_Premio_p[playerid][1], 0xffff0090);
	}
	else
	{
		PlayerTextDrawSetString(playerid, T_Premio_p[playerid][1], "CONCLUIDO !");
		PlayerTextDrawColor(playerid, T_Premio_p[playerid][1], 0x00ff0090);
	}
	PlayerTextDrawShow(playerid, T_Premio_p[playerid][1]);
	for(new g; g<sizeof T_Fichas; g++) TextDrawShowForPlayer(playerid, T_Fichas[g]);
	PlayerTextDrawSetString(playerid, T_Fichas_p[playerid][0], ConvertMoney(fichas));
	PlayerTextDrawShow(playerid, T_Fichas_p[playerid][0]);
}



stock mostrar_lobby(playerid)
{
	for(new ii; ii<sizeof T_Lobby; ii++) TextDrawShowForPlayer(playerid, T_Lobby[ii]);
	new c = contas[playerid];

	new sss[64];
	format(sss, 64, "(%d)", c);
	PlayerTextDrawSetString(playerid, LobbyP[playerid][0], sss);
	PlayerTextDrawShow(playerid, LobbyP[playerid][0]);

	format(sss, 64, "%s", NomeConta(c));
	PlayerTextDrawSetString(playerid, LobbyP[playerid][1], sss);
	PlayerTextDrawShow(playerid, LobbyP[playerid][1]);

	format(sss, 64, "%s", cidade(GetContaInt(c, "c_Cidade")));
	PlayerTextDrawSetString(playerid, LobbyP[playerid][2], sss);
	PlayerTextDrawShow(playerid, LobbyP[playerid][2]);

	format(sss, 64, "R$ %s", ConvertMoney(GetContaInt(c, "c_Grana")));
	PlayerTextDrawSetString(playerid, LobbyP[playerid][3], sss);
	PlayerTextDrawShow(playerid, LobbyP[playerid][3]);

	format(sss, 64, "R$ %s", ConvertMoney(GetContaInt(c, "c_Banco")));
	PlayerTextDrawSetString(playerid, LobbyP[playerid][4], sss);
	PlayerTextDrawShow(playerid, LobbyP[playerid][4]);

	format(sss, 64, "%s", NomeOrg(GetContaInt(c, "c_Org")));
	PlayerTextDrawSetString(playerid, LobbyP[playerid][5], sss);
	PlayerTextDrawShow(playerid, LobbyP[playerid][5]);

	format(sss, 64, "%s", NomeEmprego(GetContaInt(c, "c_Emprego")));
	PlayerTextDrawSetString(playerid, LobbyP[playerid][6], sss);
	PlayerTextDrawShow(playerid, LobbyP[playerid][6]);

	PlayerTextDrawSetPreviewModel(playerid, LobbyP[playerid][7], GetContaInt(c, "c_Skin"));
	PlayerTextDrawShow(playerid, LobbyP[playerid][7]);

	format(sss, 64, "%d", GetContaInt(c, "c_Fichas"));
	PlayerTextDrawSetString(playerid, LobbyP[playerid][8], sss);
	PlayerTextDrawShow(playerid, LobbyP[playerid][8]);

	new tmp = GetContaInt(c, "c_TempoOnline");
	if(tmp > TEMPO_RECOMPENSSA) tmp = TEMPO_RECOMPENSSA;
	new restante = TEMPO_RECOMPENSSA - tmp;
	new minutos = restante / 60;
	new segundos = restante % 60;
	format(sss, 64, "%02d:%02d", minutos, segundos);
	TextDrawSetString(T_Lobby[28], sss);
	TextDrawShowForPlayer(playerid, T_Lobby[28]);

	SelectTextDraw(playerid, 0xFFDC33ff);
}

stock NivelPlayer(playerid)
{
	if(!IsPlayerConnected(playerid)) return 0;
	new idd = id[playerid];
	if(idd == -1) return 0;
	return Conta[playerid][c_Nivel];
}

stock XpPlayer(playerid)
{
	if(!IsPlayerConnected(playerid)) return 0;
	new idd = id[playerid];
	if(idd == -1) return 0;
	return Conta[playerid][c_XP];
}

BCG:: carregar_admins()
{
	new file[80];
	new cont;
	for(new i; i<MAX_ADMINS; i++)
	{
		format(file, 80, "Admins/Admin_%d.txt", i);
		if(DOF2_FileExists(file))
		{
		    cont++;
            Admin[i][adm_Existe] = 1;
			Admin[i][adm_Conta] = DOF2_GetInt(file, "adm_Conta");
			Admin[i][adm_Level] = DOF2_GetInt(file, "adm_Level");
			format(Admin[i][adm_Funcao], 40, "%s", DOF2_GetString(file, "adm_Funcao"));
			Admin[i][adm_Responssavel] = DOF2_GetInt(file, "adm_Responssavel");
			Admin[i][adm_Dia] = DOF2_GetInt(file, "adm_Dia");
			Admin[i][adm_Mes] = DOF2_GetInt(file, "adm_Mes");
			Admin[i][adm_Ano] = DOF2_GetInt(file, "adm_Ano");
			Admin[i][adm_Hora] = DOF2_GetInt(file, "adm_Hora");
			Admin[i][adm_Minuto] = DOF2_GetInt(file, "adm_Minuto");
			Admin[i][adm_Segundo] = DOF2_GetInt(file, "adm_Segundo");
			Admin[i][adm_Nota] = DOF2_GetInt(file, "adm_Nota");
			Admin[i][adm_Atendimentos] = DOF2_GetInt(file, "adm_Atendimentos");
		}
		else
		{
		    Admin[i][adm_Existe] = 0;
			Admin[i][adm_Conta] = -1;
			Admin[i][adm_Level] = 0;
			format(Admin[i][adm_Funcao], 40, "Nenhuma");
			Admin[i][adm_Responssavel] = -1;
			Admin[i][adm_Dia] = 0;
			Admin[i][adm_Mes] = 0;
			Admin[i][adm_Ano] = 0;
			Admin[i][adm_Hora] = 0;
			Admin[i][adm_Minuto] = 0;
			Admin[i][adm_Segundo] = 0;
			Admin[i][adm_Nota] = 0;
			Admin[i][adm_Atendimentos] = 0;
		}
	}
	printf("** %d Admins carregados.", cont);
}


stock salvar_admin(i)
{
	new file[80];
    format(file, 80, "Admins/Admin_%d.txt", i);

	if(Admin[i][adm_Existe] == 1)
	{
        if(!DOF2_FileExists(file))
        {
            DOF2_CreateFile(file);
        }

		DOF2_SetInt(file, "adm_Conta", Admin[i][adm_Conta]);
		DOF2_SetInt(file, "adm_Responssavel", Admin[i][adm_Responssavel]);
		DOF2_SetInt(file, "adm_Level", Admin[i][adm_Level]);
		DOF2_SetString(file, "adm_Funcao", Admin[i][adm_Funcao]);
		DOF2_SetInt(file, "adm_Dia", Admin[i][adm_Dia]);
		DOF2_SetInt(file, "adm_Mes", Admin[i][adm_Mes]);
	 	DOF2_SetInt(file, "adm_Ano", Admin[i][adm_Ano]);
		DOF2_SetInt(file, "adm_Hora", Admin[i][adm_Hora]);
		DOF2_SetInt(file, "adm_Minuto", Admin[i][adm_Minuto]);
		DOF2_SetInt(file, "adm_Segundo", Admin[i][adm_Segundo]);
		DOF2_SetInt(file, "adm_Nota", Admin[i][adm_Nota]);
		DOF2_SetInt(file, "adm_Atendimentos", Admin[i][adm_Atendimentos]);
		DOF2_SaveFile();
	}
	else
	{
	    if(DOF2_FileExists(file))
	    {
	        DOF2_RemoveFile(file);
	    }
	}
}

stock Scripter(playerid)
{
    if(!strcmp(Nome(playerid), "Ricardo_Santos", true)) return 1;
	if(AdminPlayer(playerid) >= 8)
	{
	    if(ModoAdmin[playerid] == 1)
	    {
	        return 1;
	    }
	}
	return 0;
}

stock AdminPlayer(playerid)
{
    // Dono Geral do Cidade Grande RP: acesso administrativo maximo.
    if(Online(playerid) && !strcmp(Nome(playerid), "Ricardo_Santos", true)) return 10;
	if(Online(playerid))
	{
	    if(id[playerid] != -1)
	    {
			for(new i; i<MAX_ADMINS; i++)
			{
				if(Admin[i][adm_Existe] == 1)
				{
					if(Admin[i][adm_Conta] == id[playerid])
					{
					    return Admin[i][adm_Level];
					}
				}
			}
		}
	}
	return 0;
}

forward OnAdminLevelCheck(playerid);
public OnAdminLevelCheck(playerid)
{
	return AdminPlayer(playerid);
}

stock AdminConta(c)
{
	if(ContaInvalida(c)) return 0;
	for(new i; i<MAX_ADMINS; i++)
	{
		if(Admin[i][adm_Existe] == 1)
		{
			if(Admin[i][adm_Conta] == c)
			{
			    return Admin[i][adm_Level];
			}
		}
	}
	return 0;
}


stock AdminID(playerid)
{
	if(Online(playerid))
	{
	    if(id[playerid] != -1)
	    {
			for(new i; i<MAX_ADMINS; i++)
			{
				if(Admin[i][adm_Existe] == 1)
				{
					if(Admin[i][adm_Conta] == id[playerid])
					{
					    return i;
					}
				}
			}
		}
	}
	return -1;
}


stock destruir_admin(player_admin)
{
    for(new i; i<MAX_ADMINS; i++)
	{
		if(Admin[i][adm_Existe] == 1)
		{
		    if(Admin[i][adm_Conta] == player_admin)
		    {
		        Admin[i][adm_Existe] = 0;
		        Admin[i][adm_Conta] = -1;
		        Admin[i][adm_Responssavel] = -1;
				Admin[i][adm_Level] = 0;
				format(Admin[i][adm_Funcao], 40, "Nenhuma");
				Admin[i][adm_Ano] = 0;
				Admin[i][adm_Mes] = 0;
				Admin[i][adm_Dia] = 0;
				Admin[i][adm_Hora] = 0;
				Admin[i][adm_Minuto] = 0;
				Admin[i][adm_Segundo] = 0;
				Admin[i][adm_Nota] = 0;
				Admin[i][adm_Atendimentos] = 0;
				salvar_admin(i);
				return 1;
		    }
		}
	}
	return 0;
}


stock criar_admin(player_admin, admin, level, const funcao[])
{
    for(new i; i<MAX_ADMINS; i++)
	{
		if(Admin[i][adm_Existe] == 0)
		{
		    Admin[i][adm_Existe] = 1;
			Admin[i][adm_Conta] = player_admin;
			Admin[i][adm_Responssavel] = admin;
			Admin[i][adm_Level] = level;
			format(Admin[i][adm_Funcao], 40, funcao);
			getdate(Admin[i][adm_Ano], Admin[i][adm_Mes], Admin[i][adm_Dia]);
			gettime(Admin[i][adm_Hora], Admin[i][adm_Minuto], Admin[i][adm_Segundo]);
			Admin[i][adm_Nota] = 0;
			Admin[i][adm_Atendimentos] = 0;
			salvar_admin(i);
			return 1;
		}
	}
	return 0;
}

stock zerar_lista(playerid, con=0)
{
	for(new a; a<MAX_LISTA; a++)
	{
		Lista[playerid][a] = -1;
		if(con == 1) Lista2[playerid][a] = -1;
	}	
}	

stock mostrar_admins(playerid)
{
    SG[0] = EOS;
    new linha[300];
    new cont;
    strcat(SG, "Admin\tResponssavel\tLevel\tFuncao\n");
	zerar_lista(playerid);
	for(new i; i<MAX_ADMINS; i++)
	{
	    if(Admin[i][adm_Conta] != -1)
	    {
	        Lista[playerid][cont] = i;
	        format(linha, 300, "{ffffff}%s\t{a1a1a1}%s\t{00ffff}%d\t{ffff00}%s\n", NomeConta(Admin[i][adm_Conta]), NomeConta(Admin[i][adm_Responssavel]), Admin[i][adm_Level], Admin[i][adm_Funcao]);
			strcat(SG, linha);
			cont++;
		}
	}
	format(linha, 300, "{ffffff}Admins do Servidor [{a1a1a1} %d {ffffff}]", cont);
    ShowPlayerDialog(playerid, DIALOG_LISTA_ADMIN, DIALOG_STYLE_TABLIST_HEADERS, linha, SG, "Continuar", "Fechar");
}

stock LevarPlayer(playerid, outroplayer)
{
	if(Online(outroplayer))
	{
		new Float:p[4];
		if(IsPlayerInAnyVehicle(outroplayer))
		{
			GetVehiclePos(GetPlayerVehicleID(outroplayer), p[0], p[1], p[2]);
			GetVehicleZAngle(GetPlayerVehicleID(outroplayer), p[3]);
			PegarFrente(p[0], p[1], p[3], 2.5);
		}
		else
		{
			GetPlayerPos(outroplayer, p[0], p[1], p[2]);
			GetPlayerFacingAngle(outroplayer, p[3]);
			PegarFrente(p[0], p[1], p[3], 1);
		}
	    SetPlayerPos_(playerid, p[0], p[1], p[2]);
	    SetPlayerInterior(playerid, GetPlayerInterior(outroplayer));
		SetPlayerVirtualWorld_(playerid, GetPlayerVirtualWorld_(outroplayer));
	}
}


stock salvar_pickup(i)
{
	new file[80];
	format(file, 80, "Pickups/Pickup_%d.txt", i);
	if(Pickup[i][pick_Existe] == 1)
	{
		if(!DOF2_FileExists(file)) DOF2_CreateFile(file);
        DOF2_SetInt(file, "pick_Tipo", Pickup[i][pick_Tipo]);
       	DOF2_SetFloat(file, "pick_X", Pickup[i][pick_X]);
        DOF2_SetFloat(file, "pick_Y", Pickup[i][pick_Y]);
        DOF2_SetFloat(file, "pick_Z", Pickup[i][pick_Z]);
        DOF2_SetFloat(file, "pick_X1", Pickup[i][pick_X1]);
        DOF2_SetFloat(file, "pick_Y1", Pickup[i][pick_Y1]);
        DOF2_SetFloat(file, "pick_Z1", Pickup[i][pick_Z1]);
        DOF2_SetInt(file, "pick_Funcao", Pickup[i][pick_Funcao]);
        DOF2_SetInt(file, "pick_Mundo", Pickup[i][pick_Mundo]);
        DOF2_SetInt(file, "pick_Modelo", Pickup[i][pick_Modelo]);
       	DOF2_SetInt(file, "pick_MapaModelo", Pickup[i][pick_MapaModelo]);
        DOF2_SetInt(file, "pick_Interior", Pickup[i][pick_Interior]);
		DOF2_SetString(file, "pick_Texto1", Pickup[i][pick_Texto1]);
		DOF2_SetString(file, "pick_Texto2", Pickup[i][pick_Texto2]);
		DOF2_SetString(file, "pick_Texto3", Pickup[i][pick_Texto3]);
		DOF2_SetString(file, "pick_Texto4", Pickup[i][pick_Texto4]);
		DOF2_SetString(file, "pick_Texto5", Pickup[i][pick_Texto5]);
		DOF2_SaveFile();
	}
	else if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
}

BCG:: carregar_pickups()
{
	new file[80];
	new cont;
	for(new i; i<MAX_PICKUP; i++)
	{
	    Pickup[i][pick_3D] = DynamicText3D:-1;
		format(file, 80, "Pickups/Pickup_%d.txt", i);
	    if(DOF2_FileExists(file))
	    {
	    	cont ++;
	        Pickup[i][pick_Existe] = 1;
	        Pickup[i][pick_Tipo] = DOF2_GetInt(file, "pick_Tipo");
	        Pickup[i][pick_X] = DOF2_GetFloat(file, "pick_X");
	        Pickup[i][pick_Y] = DOF2_GetFloat(file, "pick_Y");
	        Pickup[i][pick_Z] = DOF2_GetFloat(file, "pick_Z");
	        Pickup[i][pick_X1] = DOF2_GetFloat(file, "pick_X1");
	        Pickup[i][pick_Y1] = DOF2_GetFloat(file, "pick_Y1");
	        Pickup[i][pick_Z1] = DOF2_GetFloat(file, "pick_Z1");
	        Pickup[i][pick_Funcao] = DOF2_GetInt(file, "pick_Funcao");
	        Pickup[i][pick_Mundo] = DOF2_GetInt(file, "pick_Mundo");
	        Pickup[i][pick_Modelo] = DOF2_GetInt(file, "pick_Modelo");
	        Pickup[i][pick_MapaModelo] = DOF2_GetInt(file, "pick_MapaModelo");
	        Pickup[i][pick_Interior] = DOF2_GetInt(file, "pick_Interior");
			format(Pickup[i][pick_Texto1], 150, "%s", DOF2_GetString(file, "pick_Texto1"));
			format(Pickup[i][pick_Texto2], 150, "%s", DOF2_GetString(file, "pick_Texto2"));
			format(Pickup[i][pick_Texto3], 150, "%s", DOF2_GetString(file, "pick_Texto3"));
			format(Pickup[i][pick_Texto4], 150, "%s", DOF2_GetString(file, "pick_Texto4"));
			format(Pickup[i][pick_Texto5], 150, "%s", DOF2_GetString(file, "pick_Texto5"));
	        atualizar_pickup(i);
		}
		else
		{
	        Pickup[i][pick_Existe] = 0;
	        Pickup[i][pick_Tipo] = 0;
	        Pickup[i][pick_X] = 0.0;
	        Pickup[i][pick_Y] = 0.0;
	        Pickup[i][pick_Z] = 0.0;
	        Pickup[i][pick_X1] = 0.0;
	        Pickup[i][pick_Y1] = 0.0;
	        Pickup[i][pick_Z1] = 0.0;
	        Pickup[i][pick_Funcao] = 0;
	        Pickup[i][pick_Mundo] = 0;
	        Pickup[i][pick_Modelo] = 0;
	        Pickup[i][pick_MapaModelo] = 0;
	        Pickup[i][pick_Interior] = 0;
			format(Pickup[i][pick_Texto1], 150, "nada");
			format(Pickup[i][pick_Texto2], 150, "nada");
			format(Pickup[i][pick_Texto3], 150, "nada");
			format(Pickup[i][pick_Texto4], 150, "nada");
			format(Pickup[i][pick_Texto5], 150, "nada");
		}
	}
	printf("** %d Pickups carregados.", cont);
}

stock atualizar_pickup(i)
{
	if(IsValidDynamicMapIcon(Pickup[i][pick_Mapa])) DestroyDynamicMapIcon_(Pickup[i][pick_Mapa]);
	if(IsValidDynamicPickup(Pickup[i][pick_Pickup])) DestroyDynamicPickup_(Pickup[i][pick_Pickup]);
	if(IsValidDynamic3DTextLabel(Pickup[i][pick_3D])) DestroyDynamic3DTextLabel(Pickup[i][pick_3D]);
	Pickup[i][pick_3D] = DynamicText3D:-1;
	Iter_Remove(Iter_Pickups, i);
    new sss[150];
    format(sss, 450, "%s\n%s\n%s\n%s\n%s", Pickup[i][pick_Texto1], Pickup[i][pick_Texto2], Pickup[i][pick_Texto3], Pickup[i][pick_Texto4], Pickup[i][pick_Texto5]);
	if(Pickup[i][pick_Existe] == 1)
	{
	    Iter_Add(Iter_Pickups, i);
	    if(Pickup[i][pick_MapaModelo] != -1) Pickup[i][pick_Mapa] = CreateDynamicMapIcon(Pickup[i][pick_X], Pickup[i][pick_Y], Pickup[i][pick_Z], Pickup[i][pick_MapaModelo], 0xffffffff, Pickup[i][pick_Mundo], Pickup[i][pick_Interior], -1, 200, MAPICON_LOCAL, -1,  0);
	    if(Pickup[i][pick_Modelo] != -1) Pickup[i][pick_Pickup] = CreateDynamicPickup(Pickup[i][pick_Modelo], 1, Pickup[i][pick_X], Pickup[i][pick_Y], Pickup[i][pick_Z], Pickup[i][pick_Mundo], Pickup[i][pick_Interior], -1, STREAMER_PICKUP_SD, -1, 0);
	    if(!Comparar2(Pickup[i][pick_Texto1], "nada")) Pickup[i][pick_3D] = CreateDynamic3DTextLabel( sss, 0xffffff99, Pickup[i][pick_X], Pickup[i][pick_Y], Pickup[i][pick_Z], 10, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0,  Pickup[i][pick_Mundo], Pickup[i][pick_Interior], -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
	}
}

stock criar_pickup(Float:xx, Float:yy, Float:zz, mundo, interior, mapa, modelo, const texto1[], const texto2[], const texto3[], const texto4[], const texto5[])
{
	for(new i; i<MAX_PICKUP; i++)
	{
	    if(Pickup[i][pick_Existe] == 0)
	    {
	        Pickup[i][pick_Existe] = 1;
	        Pickup[i][pick_MapaModelo] = mapa;
	        Pickup[i][pick_Modelo] = modelo;
	        Pickup[i][pick_Mundo] = mundo;
	        Pickup[i][pick_Funcao] = mundo;
	        Pickup[i][pick_Interior] = interior;
	        format(Pickup[i][pick_Texto1], 150, texto1);
	        format(Pickup[i][pick_Texto2], 150, texto2);
	        format(Pickup[i][pick_Texto3], 150, texto3);
	        format(Pickup[i][pick_Texto4], 150, texto4);
	        format(Pickup[i][pick_Texto5], 150, texto5);
	        Pickup[i][pick_X] = xx;
	        Pickup[i][pick_Y] = yy;
	        Pickup[i][pick_Z] = zz;
	        Pickup[i][pick_X1] = 0;
	        Pickup[i][pick_Y1] = 0;
	        Pickup[i][pick_Z1] = 0;
            atualizar_pickup(i);
	        return i;
	    }
	}
	return -1;
}

stock destruir_pickup(i)
{
    Pickup[i][pick_Existe] = 0;
    atualizar_pickup(i);
    salvar_pickup(i);
}

stock PlayerPickup(playerid, pick)
{
	new tipo = Pickup[pick][pick_Tipo];
	new conta = id[playerid];
	new c = conta;
	if(conta != -1)
	{

        // bater cartao //
		if(tipo == 92)
		{
		    if(PlayerCop(playerid))
		    {
		        if(GetPVarInt(playerid, "flood_cartao") < gettime())
		        {
				SetPVarInt(playerid, "flood_cartao", gettime()+180);
			    	BaterCartao(playerid);
		    	}
		    	else ms(playerid, 0, "Voce so pode fazer isso a cada 3 Minutos !");
		    }
		    else ms(playerid, 0, "Voce nao pode fazer isso !");
		}

	    // comprar prods //
		if(tipo == 91)
		{
		    if(EmpregoPlayer(playerid) == 11)
		    {
		        if(IsPlayerInAnyVehicle(playerid))
		        {
		            new car = GetPlayerVehicleID(playerid);
		            new v = Info_Veiculo[car];
		            if(v != -1)
		            {
						if(produtos_veiculo[v] < 500)
						{
		                    mostrar_comprar_prods(playerid, car);
		                }
		                else MS(playerid, 0, "Este caminhao ja esta lotado de produtos !");
		            }
		            else MS(playerid, 0, "Voce nao esta em um veiculo do emprego !");
		        }
		        else MS(playerid, 0, "Voce nao esta em um veiculo do emprego !");
			}
			else MS(playerid, 0, "Voce nao pertence a este emprego !");
		}

		// tirar porte //
		if(tipo == 90)
		{
		    if(PlayerCPF(playerid) == 0) MS(playerid, 0, "Voce nao possue um CPF, se dirija ate um Cartorio para fazer o seu !");
	        else if(PlayerRG(playerid) == 0) MS(playerid, 0, "Voce nao possue um RG, se dirija ate um Cartorio para fazer o seu !");
			else comecar_tirar_porte(playerid);
		}

		// ajuda no respawn civil //
		if(tipo == 89)
		{
		    mostrar_ajuda_respawn(playerid);
		}

		// emplacar //
		if(tipo == 88)
		{
		    if(IsPlayerInAnyVehicle(playerid))
	        {
	            new v = GetPlayerVehicleID(playerid);
	            new i = Info_Veiculo[v];
	            if(i != -1)
	            {
	                if(Veiculo[i][v_Dono] == c)
	                {
	                    if(Veiculo[i][v_Emplacar] == 1)
	                    {
	                        if(GranaPlayer(playerid) >= TAXA_PLACA)
	                        {
	                            SetPVarInt(playerid, "veh", v);
	                            SetPVarInt(playerid, "info", i);
				    		Acao(playerid, 24, 500, "EMPLACANDO VEICULO", 0, "null", "null", false);
	                        }
	                        else
							{
							    new ssss[150];
							    format(ssss, 150, "Voce nao possue R$ %s para emplacar o veiculo !", ConvertMoney(TAXA_PLACA));
								ms(playerid, 0, ssss);
							}
	                    }
	                    else ms(playerid, 0, "Este veiculo ja possue uma placa !");
	                }
	                else ms(playerid, 0, "Voce nao e o dono desse veiculo !");
	            }
	            else  ms(playerid, 0, "Este veiculo nao pode ser emplacado !");
			}
			else ms(playerid, 0, "Voce nao esta em um Veiculo !");
		}

		// detran placa //
		if(tipo == 87)
		{
		    consulta_placa(playerid);
		}

		// desmanche //
		if(tipo == 86)
		{
		    if(PlayerDrift(playerid))
		    {
		        desmanche(playerid, pick);
		    }
		    else ms(playerid, 0, "Voce nao pode desmanchar veiculos !");
		}

		// vender maconha favela //
		if(tipo == 85)
		{
		    if(OrgPlayer(playerid) == -1) return ms(playerid, 0, "Apenas membros de organizacao podem vender maconha !");
		    if(PlayerCop(playerid)) return ms(playerid, 0, "Policiais nao podem vender maconha !");
		    new org = OrgPlayer(playerid);
		    new Float:px = Pickup[pick][pick_X], Float:py = Pickup[pick][pick_Y];
		    new bool:tem_gz;
		    for(new g; g<MAX_TERRITORIOS; g++)
		    {
		        if(TR[g][tr_Existe] == 1 && TR[g][tr_Dono] == org)
		        {
		            if(px >= TR[g][tr_X] - TR[g][tr_Largura]/2 && px <= TR[g][tr_X] + TR[g][tr_Largura]/2 && py >= TR[g][tr_Y] - TR[g][tr_Altura]/2 && py <= TR[g][tr_Y] + TR[g][tr_Altura]/2)
		            {
		                tem_gz = true;
		                break;
		            }
		        }
		    }
		    if(!tem_gz) return ms(playerid, 0, "Esta favela nao esta no territorio da sua organizacao !");
		    vender_maconha(playerid);
		}

		// menu 24/7 //
		if(tipo == 84)
		{
			abrir_eletronicos(playerid);
		}


		// procurar equipamentos quebrados //
		if(tipo == 83)
		{
	        if(EmpregoPlayer(playerid) == 10)
			{
			    mostrar_coisas_quebradas(playerid);
			}
			else ms(playerid, 0, "Apenas eletricistas podem fazer isso !");
		}

		// lavar dinheiro sujo //
		if(tipo == 82)
		{
			// somar dinheiro sujo //
			new grana;
			for(new a; a<MAX_SLOTS; a++) if(Inventario[playerid][a][inv_ID] == 76) grana += Inventario[playerid][a][inv_Unidades];
			if(grana >= 100)
			{
				aviso_lavar_dinheiro(playerid, grana);
			}
			else ms(playerid, 0, "Voce precisa ter no minimo R$ 100 de dinheiro sujo para lavar !");
		}

	    // sistema de cameras //
		if(tipo == 81)
		{
		    if(PlayerCop(playerid))
		    {
		        mostrar_cameras(playerid);
		    }
		    else ms(playerid, 0, "Apenas policiais podem acessar o sistema de cameras !");
		}

	    // usar contrato hospitalar //
		if(tipo == 80)
		{
		    new a = tem_item(playerid, 74);
			if(a != -1)
			{
			    if(VidaPlayer(playerid) < 100)
				{
				    SetPVarInt(playerid, "slot", a);
				    Acao(playerid, 9, 500, "RECEBENDO TRATAMENTO", 0, "null", "null", false);
					ms(playerid, 4, "Aguarde enquanto voce recebe os cuidados medicos ...");
				}
				else ms(playerid, 0, "Voce ja esta totalmente curado, nao precisa de tratamento no momento !");
			}
			else ms(playerid, 0, "Voce nao tem um Contrato Hospitalar em seu Inventario");
		}

		// comprar contrato hospitalar //
		if(tipo == 79)
		{
		    new temm = 0;
		    if(GranaPlayer(playerid) >= 500)
		    {
				for(new a; a<MAX_SLOTS; a++)
				{
					if(Inventario[playerid][a][inv_ID] == 0)
					{
						DarGrana(playerid, -500);
						Inventario[playerid][a][inv_ID] = 74;
						Inventario[playerid][a][inv_Unidades] = 1;
						Inventario[playerid][a][inv_Tipo] = 0;
						salvar_inventario(c, a);
						ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}_", "{00ffff}[INFO] {ffffff}Voce pagou {4169E1}R$ 500 {ffffff}por um {ffff00}Contrato Hospitalar{ffffff}, confira seu inventario.", "Ok", "Fechar");
						temm = 1;
						break;
					}
				}
				if(temm == 0) ms(playerid, 0, "Seu Inventario esta lotado !");
			}
			else ms(playerid, 0, "Voce nao tem dinheiro suficiente !");
		}

		// menu 24/7 //
		if(tipo == 48)
		{
			abrir_247(playerid);
		}

		// deposito do mercado negro //
		if(tipo == 47)
		{
			abrir_deposito(playerid);
		}

		// mercado negro //
		if(tipo == 46)
		{
			menu_mercado_negro(playerid, -1);
		}

		// auto escola renovar //
		if(tipo == 45)
		{
			renovar_auto_escola(playerid);
		}

		// auto escola //
		if(tipo == 44)
		{
			menu_auto_escola(playerid);
		}

		// concerto //
		if(tipo == 43)
		{
		    if(PlayerMecanicoOrg(playerid))
		    {
		        concerto_total(playerid, pick);
		    }
		    else ms(playerid, 0, "Voce nao e um mecanico !");
		}

	    // moveis decoracao //
		if(tipo == 42)
		{
		    if(comprando_moveis[playerid] == -1) ms(playerid, 0, "Va ate o caixa da loja para escolher a casa para onde os moveis serao enviados !");
		    else mostrar_lista_moveis(playerid, 4);
		}

		// moveis banheiro //
		if(tipo == 41)
		{
		    if(comprando_moveis[playerid] == -1) ms(playerid, 0, "Va ate o caixa da loja para escolher a casa para onde os moveis serao enviados !");
		    else mostrar_lista_moveis(playerid, 3);
		}

		// moveis cozinha //
		if(tipo == 40)
		{
		    if(comprando_moveis[playerid] == -1) ms(playerid, 0, "Va ate o caixa da loja para escolher a casa para onde os moveis serao enviados !");
		    else mostrar_lista_moveis(playerid, 2);
		}

		// moveis quarto //
		if(tipo == 39)
		{
		    if(comprando_moveis[playerid] == -1) ms(playerid, 0, "Va ate o caixa da loja para escolher a casa para onde os moveis serao enviados !");
		    else mostrar_lista_moveis(playerid, 1);
		}

		// moveis sala //
		if(tipo == 38)
		{
		    if(comprando_moveis[playerid] == -1) ms(playerid, 0, "Va ate o caixa da loja para escolher a casa para onde os moveis serao enviados !");
		    else mostrar_lista_moveis(playerid, 0);
		}

	    // caixa da loja casas bahia //
		if(tipo == 37)
		{
		    if(comprando_moveis[playerid] != -1) mostrar_compras(playerid, comprando_moveis[playerid]);
		    else mostrar_compras_casas(playerid);
		}

	    // transferir casa //
		if(tipo == 36)
		{
			transferencia_casas(playerid);
		}

	    // ver listas de presos //
		if(tipo == 35)
		{
		    if(EmpregoPlayer(playerid) == 9)
		    {
	        	mostrar_presos_na_cadeia(playerid);
			}
			else ms(playerid, 0, "Apenas Advogados podem fazer isso !");
		}

		// LIMPAR FICHA //
		if(tipo == 34)
		{
		    if(PlayerCop(playerid))
		    {
		        abrir_limpar_ficha(playerid);
			}
			else ms(playerid, 0, "Apenas Policiais podem limpar a ficha de alguem !");
		}

		// esvazia caminhao de lixo //
		if(tipo == 33)
		{
		    if(EmpregoPlayer(playerid) == 8)
		    {
		        if(IsPlayerInAnyVehicle(playerid))
		        {
		            new v = GetPlayerVehicleID(playerid);
		            new i = Info_Veiculo[v];
		            if(i != -1)
		            {
		                if(Veiculo[i][v_Emprego] == 8)
		                {
		                    if(lixo_veiculo[i] > 0)
		                    {
		                        descarregar_lixo(playerid, i);
		                    }
		                    else ms(playerid, 0, "Este caminhao de lixo esta vazio !");
		                }
		                else ms(playerid, 0, "Voce nao esta no caminhao de lixo !");
		            }
		            else ms(playerid, 0, "Voce nao esta no caminhao de lixo !");
		        }
		        else ms(playerid, 0, "Voce nao esta no caminhao de lixo !");
		    }
		    else ms(playerid, 0, "Voce nao pertence a este emprego !");
		}

	    // esvaziar caminhao //
		if(tipo == 32)
		{
		    if(EmpregoPlayer(playerid) == 7)
		    {
	            if(IsPlayerInAnyVehicle(playerid))
		        {
		            new idc = GetPlayerVehicleID(playerid);
		            new i = Info_Veiculo[idc];
		            if(i != -1)
		            {
		                if(Veiculo[i][v_Emprego] == 7)
		                {
		                    if(GetVehicleModel(idc) != 530)
		                    {
		                        if(emp_veiculo[i] != 0)
		                        {
		                            emp_veiculo[i] = 0;
		                            emp_m_veiculo[i] = 0;
		                            veiculo_acessorios(idc);
		                            ms(playerid, 1, "Voce esvaziou o caminhao, toda a carga foi removida !");
		                        }
		                        else ms(playerid, 0, "Este caminhao nao esta com nenhuma carga !");
		                    }
		                }
					}
				}
				else ms(playerid, 0, "Voce nao esta em um caminhao do emprego !");
			}
			else ms(playerid, 0, "Voce nao pertence a este emprego !");
		}

		// pegar nota de entrega //
		if(tipo == 31)
		{
		    if(EmpregoPlayer(playerid) == 7)
		    {
		        if(NotaPlayer(playerid) != -1) ms(playerid, 0, "Voce ja esta com uma nota de entrega, confira com /nota.");
		        else
				{
					setar_nota_player(playerid, random(sizeof entregas));
				mostrar_nota(playerid, playerid);
				ms(playerid, 1, "Voce pegou uma nova entrega, confira a sua /nota, e encha o caminhao.");
				ms(playerid, 1, "Use uma empilhadeira do patio, e pegue as mercadorias correspondentes na nota.");
				ms(playerid, 1, "Apos completar a carga, entre no veiculo e siga para a entrega.");
				ms(playerid, 1, "Quando finalizar a entrega, voce ira receber seu pagamento.");
		        }
			}
			else ms(playerid, 0, "Voce nao pertence a este emprego !");
		}

		// pegar pecas de veiculo para a empilhadeira  //
		if(tipo == 30)
		{
		    if(GetPVarInt(playerid, "flood_pegar_encomenda") > gettime()) ms(playerid, 0, "Voce nao pode pegar ou largar encomendas com tanta frequencia !");
		    else
			{
				if(EmpregoPlayer(playerid) == 7)
				{
				if(IsPlayerInAnyVehicle(playerid))
				{
				    new idc = GetPlayerVehicleID(playerid);
				    new i = Info_Veiculo[idc];
				    if(i != -1)
					{
				        if(Veiculo[i][v_Emprego] == 7)
				        {
				            if(emp_veiculo[i] != 0) ms(playerid, 0, "Este veiculo ja esta com uma encomenda, afaste-se do local !");
				            else
								{
									emp_veiculo[i] = 4;
					            veiculo_acessorios(idc);
					            ms(playerid, 5, "Voce pegou pecas de automovel com o veiculo, leve ate a trazeira do caminhao.");
					            ms(playerid, 5, "Para largar, e so buzinar com o veiculo.");
					            SetPVarInt(playerid, "flood_pegar_encomenda", gettime()+5);
				            }
				        }
				    }
				}
				else ms(playerid, 0, "Voce nao esta em um veiculo do emprego !");
			    }
			    else ms(playerid, 0, "Voce nao pertence a este emprego !");
		    }
		}

	    // pegar um botjoes de gas para a empilhadeira  //
		if(tipo == 29)
		{
		    if(GetPVarInt(playerid, "flood_pegar_encomenda") > gettime()) ms(playerid, 0, "Voce nao pode pegar ou largar encomendas com tanta frequencia !");
		    else
			{
				if(EmpregoPlayer(playerid) == 7)
				{
				if(IsPlayerInAnyVehicle(playerid))
				{
				    new idc = GetPlayerVehicleID(playerid);
				    new i = Info_Veiculo[idc];
				    if(i != -1)
					{
				        if(Veiculo[i][v_Emprego] == 7)
				        {
				            if(emp_veiculo[i] != 0)  ms(playerid, 0, "Este veiculo ja esta com uma encomenda, afaste-se do local !");
				            else
								{
									emp_veiculo[i] = 3;
					            veiculo_acessorios(idc);
					            ms(playerid, 1, "Voce pegou botijoes de gas com o veiculo, leve ate a trazeira do caminhao.");
					            ms(playerid, 1, "Para largar, e so buzinar com o veiculo.");
					            SetPVarInt(playerid, "flood_pegar_encomenda", gettime()+5);
				            }
				        }
				    }
				}
				else ms(playerid, 0, "Voce nao esta em um veiculo do emprego !");
			    }
			    else ms(playerid, 0, "Voce nao pertence a este emprego !");
			}
		}

	    // pegar um barril de oleo para a empilhadeira  //
		if(tipo == 28)
		{
		    if(GetPVarInt(playerid, "flood_pegar_encomenda") > gettime())  ms(playerid, 0, "Voce nao pode pegar ou largar encomendas com tanta frequencia !");
		    else
			{
				if(EmpregoPlayer(playerid) == 7)
				{
				if(IsPlayerInAnyVehicle(playerid))
				{
				    new idc = GetPlayerVehicleID(playerid);
				    new i = Info_Veiculo[idc];
				    if(i != -1)
					{
				        if(Veiculo[i][v_Emprego] == 7)
				        {
				            if(emp_veiculo[i] != 0)  ms(playerid, 0, "Este veiculo ja esta com uma encomenda, afaste-se do local !");
				            else
								{
									emp_veiculo[i] = 2;
					            veiculo_acessorios(idc);
					            ms(playerid, 1, "Voce pegou um barril de oleo com o veiculo, leve ate a trazeira do caminhao.");
					            ms(playerid, 1, "Para largar, e so buzinar com o veiculo.");
					            SetPVarInt(playerid, "flood_pegar_encomenda", gettime()+5);
				            }
				        }
				    }
				}
				else ms(playerid, 0, "Voce nao esta em um veiculo do emprego !");
			    }
			    else ms(playerid, 0, "Voce nao pertence a este emprego !");
		    }
		}

	    // pegar uma caixa para para a sedex com a empilhadeira //
		if(tipo == 27)
		{
		    if(GetPVarInt(playerid, "flood_pegar_encomenda") > gettime())  ms(playerid, 0, "Voce nao pode pegar ou largar encomendas com tanta frequencia !");
		    else
			{
				if(EmpregoPlayer(playerid) == 7)
				{
				if(IsPlayerInAnyVehicle(playerid))
				{
				    new idc = GetPlayerVehicleID(playerid);
				    new i = Info_Veiculo[idc];
				    if(i != -1)
					{
				        if(Veiculo[i][v_Emprego] == 7)
				        {
				            if(emp_veiculo[i] != 0) ms(playerid, 0, "Este veiculo ja esta com uma encomenda, afaste-se do local !");
				            else
								{
									emp_veiculo[i] = 1;
					            veiculo_acessorios(idc);
					            ms(playerid, 1, "Voce pegou uma encomenda da sedex com o veiculo, leve ate a trazeira do caminhao.");
					            ms(playerid, 1, "Para largar, e so buzinar com o veiculo.");
					            SetPVarInt(playerid, "flood_pegar_encomenda", gettime()+5);
				            }
				        }
				    }
				}
				else ms(playerid, 0, "Voce nao esta em um veiculo do emprego !");
			    }
			    else ms(playerid, 0, "Voce nao pertence a este emprego !");
		    }
		}

		// pegar malote carro forte //
		if(tipo == 26)
		{
			pegar_malote(playerid);
		}

		// iniciar trabalho carro forte //
		if(tipo == 25)
		{
		    if(EmpregoPlayer(playerid) == 6)
		    {
	         	iniciar_carro_forte(playerid);
		    }
		}

		// menu de skins loja de roupas //
		if(tipo == 24)
		{
		    mostrar_skins_lv(playerid);
		}

	    // menu de skins loja de roupas //
		if(tipo == 23)
		{
		    mostrar_skins_sf(playerid);
		}

	    // menu de acessorios //
		if(tipo == 22)
		{
		    mostrar_dialog_acessorios(playerid);
		}

		// menu de skins loja de roupas //
		if(tipo == 21)
		{
		    mostrar_skins_ls(playerid);
		}

		// opcoes banco //
		if(tipo == 20)
		{
		    if(Conta[playerid][c_Pix] > 0)
		    {
				SetPVarInt(playerid, "ce", -1);
		        AbrirBanco(playerid, 0);
		    }
		    else
		    {
				Banco(playerid, 1);
		    }
		}

		// vender pedras //
		if(tipo == 19)
		{
			if(EmpregoPlayer(playerid) == 5)
		    {
		        new seg = segurando_player[playerid];
		        if(seg == 3)
		        {
		            jogar(playerid);
		            new sss[150];
		            format(sss, 150, "Voce recebeu R$ %s por esta pedra.", ConvertMoney(PRECO_VENDA_PEDRA));
		            ms(playerid, 1, sss);
		            DarGrana(playerid, PRECO_VENDA_PEDRA);
		            MetaEmprego(playerid);
		        }
		        else ms(playerid, 0, "Voce nao esta com uma pedra em maos !");
		    }
		    else ms(playerid, 0, "Voce nao e um minerador !");
		}

		// pegar PA //
		if(tipo == 18)
		{
		    if(GetPVarInt(playerid, "flood_pegar_pa") > gettime())  ms(playerid, 0, "Voce nao pode fazer isso com muita frequencia !");
		    else
			{
				if(EmpregoPlayer(playerid) == 5)
				{
				new arf[2];
		         	GetPlayerWeaponData(playerid, 1, arf[0], arf[1]);
				if(arf[0] == 9 && arf[1] > 0) ms(playerid, 0, "Voce ja tem uma PA !");
				else
					{
				    GivePlayerWeapon_(playerid, 6, 1);
				    ms(playerid, 1, "Voce pegou uma PA, e ja pode quebrar pedras.");
				    SetPVarInt(playerid, "flood_pegar_pa", gettime()+60);
				}
			    }
			    else ms(playerid, 0, "Voce nao e um minerador !");
		    }
		}

		// menu da loterica //
		if(tipo == 17)
		{
		    mostrar_loterica(playerid);
		}

		// pegar moto serra //
		if(tipo == 16)
		{
		    if(GetPVarInt(playerid, "flood_pegar_motoserra") > gettime()) ms(playerid, 0, "Voce nao pode fazer isso com muita frequencia !");
		    else
			{
				if(EmpregoPlayer(playerid) == 4)
				{
				new arf[2];
		         	GetPlayerWeaponData(playerid, 1, arf[0], arf[1]);
				if(arf[0] == 9 && arf[1] > 0) ms(playerid, 0, "Voce ja tem uma Moto Serra !");
				else
					{
				    GivePlayerWeapon_(playerid, 9, 1);
				    ms(playerid, 1, "Voce pegou uma Moto Serra, e ja pode cortar madeiras.");
				    SetPVarInt(playerid, "flood_pegar_motoserra", gettime()+60);
				}
			    }
			    else ms(playerid, 0, "Voce nao e um lenhador !");
		    }
		}

		// vender madeira //
		if(tipo == 15)
		{
		    if(EmpregoPlayer(playerid) == 4)
		    {
		        new seg = segurando_player[playerid];
		        if(seg == 2)
		        {
		            jogar(playerid);
		            new sss[150];
		            format(sss, 150, "Voce recebeu R$ %s por esta madeira.", ConvertMoney(PRECO_VENDA_MADEIRA));
		            ms(playerid, 1, sss);
		            DarGrana(playerid, PRECO_VENDA_MADEIRA);
		            MetaEmprego(playerid);
		        }
		        else ms(playerid, 0, "Voce nao esta com madeira em maos !");
		    }
		    else ms(playerid, 0, "Voce nao e um lenhador !");
		}

		// transferir veiculo //
		if(tipo == 14)
		{
		    transferencia_veiculos(playerid);
		}

		// tirar RG //
		if(tipo == 13)
		{
		    if(PlayerRG(playerid) == 0)
		    {
		        if(PlayerCPF(playerid) != 0)
		        {
					Acao(playerid, 5, 300, "TIRANDO RG", 0, "null", "null", false);
					ms(playerid, 4, "Aguarde enquanto preparamos seu documento ...");
				}
				else ms(playerid, 0, "Voce ainda nao tem seu CPF, antes de tirar seu RG isso deve ser feito antes !.");
		    }
		    else ms(playerid, 0, "Voce ja emitiu seu RG ! Use a Tecla N > Celular > Carteira para visualizar ou mostrar a alguem.");
		}

		// tirar CPF //
		if(tipo == 12)
		{
		    if(PlayerCPF(playerid) == 0)
		    {
	            Acao(playerid, 4, 300, "TIRANDO CPF", 0, "null", "null", false);
	            ms(playerid, 4, "Aguarde enquanto preparamos seu documento ...");
		    }
		    else ms(playerid, 0, "Voce ja emitiu seu CPF ! Use a Tecla N > Celular > Carteira para visualizar ou mostrar a alguem.");
		}

		// pegar entrega Zona Oeste, emprego sedex //
		if(tipo == 11)
		{
		    if(EmpregoPlayer(playerid) == 2)
			{
			    if(GetPVarInt(playerid, "flood_entregas") > gettime())  ms(playerid, 0, "Voce nao pode fazer isso com muita frequencia !");
			    else
				{
					new r = random(sizeof EntregasLasVenturas);
					cidade_sedex[playerid] = 2; // LV
					entrega_sedex[playerid] = r; // ID do local
					ms(playerid, 1, "Voce pegou uma nova entrega, ao concluir voce ganha R$ 100 pelo trabalho.");
					Localizar_Player(playerid, EntregasLasVenturas[r][0], EntregasLasVenturas[r][1], EntregasLasVenturas[r][2], 101, -1, "LOCAL DE ENTREGA");
					SetPVarInt(playerid, "flood_entregas", gettime()+30);
				}
		    }
		    else ms(playerid, 0, "Voce nao pertence a este emprego !");
		}

		// pegar entrega Zona Sul, emprego sedex //
		if(tipo == 10)
		{
		    if(EmpregoPlayer(playerid) == 2)
			{
			    if(GetPVarInt(playerid, "flood_entregas") > gettime())  ms(playerid, 0, "Voce nao pode fazer isso com muita frequencia !");
			    else
				{
					new r = random(sizeof EntregasSanFierro);
					cidade_sedex[playerid] = 1; // SF
					entrega_sedex[playerid] = r; // ID do local
					ms(playerid, 1, "Voce pegou uma nova entrega, ao concluir voce ganha R$ 100 pelo trabalho.");
					Localizar_Player(playerid, EntregasSanFierro[r][0], EntregasSanFierro[r][1], EntregasSanFierro[r][2], 101, -1, "LOCAL DE ENTREGA");
					SetPVarInt(playerid, "flood_entregas", gettime()+30);
				}
		    }
		    else ms(playerid, 0, "Voce nao pertence a este emprego !");
		}

		// pegar entrega Zona Leste, emprego sedex //
		if(tipo == 9)
		{
		    if(EmpregoPlayer(playerid) == 2)
			{
			    if(GetPVarInt(playerid, "flood_entregas") > gettime()) ms(playerid, 0, "Voce nao pode fazer isso com muita frequencia !");
			    else
				{
					new r = random(sizeof EntregasLosSantos);
					cidade_sedex[playerid] = 0; // LS
					entrega_sedex[playerid] = r; // ID do local
					ms(playerid, 1, "Voce pegou uma nova entrega, ao concluir voce ganha R$ 100 pelo trabalho.");
					Localizar_Player(playerid, EntregasLosSantos[r][0], EntregasLosSantos[r][1], EntregasLosSantos[r][2], 101, -1, "LOCAL DE ENTREGA");
					SetPVarInt(playerid, "flood_entregas", gettime()+30);
				}
		    }
		    else ms(playerid, 0, "Voce nao pertence a este emprego !");
		}

		// pegar entrega sedex //
		if(tipo == 8)
		{
		    if(!IsPlayerInAnyVehicle(playerid))
		    {
				if(EmpregoPlayer(playerid) == 2)
				{
				    if(GetPVarInt(playerid, "flood_sedex") > gettime())  ms(playerid, 0, "Voce nao pode fazer isso com muita frequencia, aguarde 10 segundos e tente novamente !");
				    else
					{
						segurar(playerid, 1, 1);
					    ApplyAnimation(playerid, "BD_FIRE", "WASH_UP", 4.1, false, false, false, false, 0, 1);
					    SetPlayerToFacePos(playerid, Pickup[pick][pick_X], Pickup[pick][pick_Y]);
					    ms(playerid, 1, "Voce pegou 1 Caixa da Sedex, aperte H atras da Van, ou para largar no chao.");
					    SetPVarInt(playerid, "flood_sedex", gettime()+10);
				    }
				}
				else ms(playerid, 0, "Voce nao pertence a este emprego !");
		    }
		    else ms(playerid, 0, "Voce nao pode fazer isso em um veiculo !");
		}

		// abastecer veiculo //
		if(tipo == 7)
		{
			abrir_tabela_player(playerid);
		}

		// pegar entrega Zona Oeste, emprego entregador de gas //
		if(tipo == 6)
		{
		    if(EmpregoPlayer(playerid) == 0)
			{
			    if(GetPVarInt(playerid, "flood_entregas") > gettime())  ms(playerid, 0, "Voce nao pode fazer isso com muita frequencia !");
			    else
				{
					new Float:p[4];
				    GetPlayerPos(playerid, p[0], p[1], p[2]);
				    new r = random(sizeof EntregasLosSantos);
					cidade_gas[playerid] = 2; // LV
					entrega_gas[playerid] = r; // ID do local
					GetDistance(p[3], p[0],p[1],p[2], EntregasLasVenturas[r][0], EntregasLasVenturas[r][1], EntregasLasVenturas[r][2]);
					distancia_gas[playerid] = floatround(p[3]);
					ms(playerid, 1, "Voce pegou uma nova entrega, ao concluir voce ganha R$ 50 e a taxa de entrega dependendo da distancia.");
					Localizar_Player(playerid, EntregasLasVenturas[r][0], EntregasLasVenturas[r][1], EntregasLasVenturas[r][2], 100, -1, "LOCAL DE ENTREGA");
					SetPVarInt(playerid, "flood_entregas", gettime()+30);
				}
		    }
		    else ms(playerid, 0, "Voce nao pertence a este emprego !");
		}

		// pegar entrega Zona Sul, emprego entregador de gas //
		if(tipo == 5)
		{
		    if(EmpregoPlayer(playerid) == 0)
			{
			    if(GetPVarInt(playerid, "flood_entregas") > gettime())  ms(playerid, 0, "Voce nao pode fazer isso com muita frequencia !");
			    else
				{
					new Float:p[4];
				    GetPlayerPos(playerid, p[0], p[1], p[2]);
				    new r = random(sizeof EntregasLosSantos);
					cidade_gas[playerid] = 1; // SF
					entrega_gas[playerid] = r; // ID do local
					GetDistance(p[3], p[0],p[1],p[2], EntregasSanFierro[r][0], EntregasSanFierro[r][1], EntregasSanFierro[r][2]);
					distancia_gas[playerid] = floatround(p[3]);
					ms(playerid, 1, "Voce pegou uma nova entrega, ao concluir voce ganha R$ 50 e a taxa de entrega dependendo da distancia.");
					Localizar_Player(playerid, EntregasSanFierro[r][0], EntregasSanFierro[r][1], EntregasSanFierro[r][2], 100, -1, "LOCAL DE ENTREGA");
					SetPVarInt(playerid, "flood_entregas", gettime()+30);
				}
		    }
		    else ms(playerid, 0, "Voce nao pertence a este emprego !");
		}

		// pegar entrega Zona Leste, emprego entregador de gas //
		if(tipo == 4)
		{
		    if(EmpregoPlayer(playerid) == 0)
			{
			    if(GetPVarInt(playerid, "flood_entregas") > gettime())  ms(playerid, 0, "Voce nao pode fazer isso com muita frequencia !");
			    else
				{
					new Float:p[4];
				    GetPlayerPos(playerid, p[0], p[1], p[2]);
				    new r = random(sizeof EntregasLosSantos);
					cidade_gas[playerid] = 0; // LS
					entrega_gas[playerid] = r; // ID do local
					GetDistance(p[3], p[0],p[1],p[2], EntregasLosSantos[r][0], EntregasLosSantos[r][1], EntregasLosSantos[r][2]);
					distancia_gas[playerid] = floatround(p[3]);
					ms(playerid, 1, "Voce pegou uma nova entrega, ao concluir voce ganha R$ 50 e a taxa de entrega dependendo da distancia.");
					Localizar_Player(playerid, EntregasLosSantos[r][0], EntregasLosSantos[r][1], EntregasLosSantos[r][2], 100, -1, "LOCAL DE ENTREGA");
					SetPVarInt(playerid, "flood_entregas", gettime()+30);
				}
		    }
		    else ms(playerid, 0, "Voce nao pertence a este emprego !");
		}

		// pegar um botijao, emprego entregador de gas //
		if(tipo == 3)
		{
		    if(!IsPlayerInAnyVehicle(playerid))
		    {
				if(EmpregoPlayer(playerid) == 0)
				{
				    if(GetPVarInt(playerid, "flood_botijao") > gettime()) ms(playerid, 0, "Voce nao pode fazer isso com muita frequencia, aguarde 10 segundos e tente novamente !");
				    else
					{
						segurar(playerid, 0, 1);
					    ApplyAnimation(playerid, "BD_FIRE", "WASH_UP", 4.1, false, false, false, false, 0, 1);
					    SetPlayerToFacePos(playerid, Pickup[pick][pick_X], Pickup[pick][pick_Y]);
					    ms(playerid, 1, "Voce pegou 1 Botijao de Gas do reservatorio, aperte H atras do Veiculo, ou para largar no chao.");
					    SetPVarInt(playerid, "flood_botijao", gettime()+10);
				    }
				}
				else ms(playerid, 0, "Voce nao pertence a este emprego !");
		    }
		    else ms(playerid, 0, "Voce nao pode fazer isso em um veiculo !");
		}

		// tunar veiculo //
		if(tipo == 2)
		{
		    if(PlayerMecanicoOrg(playerid))
		    {
		        tunagem(playerid, pick);
	        }
	        else ms(playerid, 0, "Apenas mecanicos podem fazer isso !");
		}

		// agencia de empregos //
		if(tipo == 1)
		{
		    if(c != -1)
		    {
		    	if(PlayerCPF(playerid) == 0) MS(playerid, 0, "Voce nao possue um CPF, se dirija ate um Cartorio para fazer o seu !");
	        	else if(PlayerRG(playerid) == 0) MS(playerid, 0, "Voce nao possue um RG, se dirija ate um Cartorio para fazer o seu !");
	        	else ShowPlayerDialog(playerid, DIALOG_EMPREGOS_CNH, DIALOG_STYLE_LIST, "Selecionar Emprego", "Precisa de CNH\nNao precisa de CNH", "Continuar", "Voltar");
	        }
		}
	}
	return 1;
}

stock atualizar_actor(i)
{
	DestroyDynamicActor(Actor[i][a_Actor]);
	DestroyDynamic3DTextLabel(Actor[i][a_3D]);
	Actor[i][a_3D] = DynamicText3D:-1;
	if(Actor[i][a_Existe] == 1)
	{
        Actor[i][a_Actor] = CreateDynamicActor(Actor[i][a_Skin], Actor[i][a_X],Actor[i][a_Y],Actor[i][a_Z], Actor[i][a_A], 1, 100.0, Actor[i][a_Mundo], Actor[i][a_Interior], -1, STREAMER_ACTOR_SD,-1, 0);
	    if(!Comparar(".", Actor[i][a_Nome])) Actor[i][a_3D] = CreateDynamic3DTextLabel( Actor[i][a_Nome], 0xffffff99, Actor[i][a_X],Actor[i][a_Y],Actor[i][a_Z]+1.05, 5, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, Actor[i][a_Mundo], Actor[i][a_Interior], -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
		if(Actor[i][a_Animacao] == 1)
		{
		    ApplyDynamicActorAnimation(Actor[i][a_Actor], Actor[i][a_Anim1], Actor[i][a_Anim2], 4.1, 1, 0, 0, 0, 0);
		}
	}
}


stock salvar_actor(i)
{
    new file[80];
    format(file, 80, "Actors/Actor_%d.txt", i);
    if(Actor[i][a_Existe] == 1)
    {
        if(!DOF2_FileExists(file)) DOF2_CreateFile(file);
        DOF2_SetInt(file, "a_Skin", Actor[i][a_Skin]);
        DOF2_SetString(file, "a_Nome", Actor[i][a_Nome]);
        DOF2_SetString(file, "a_Anim1", Actor[i][a_Anim1]);
        DOF2_SetString(file, "a_Anim2", Actor[i][a_Anim2]);
        DOF2_SetInt(file, "a_Animacao", Actor[i][a_Animacao]);
		DOF2_SetFloat(file, "a_X", Actor[i][a_X]);
		DOF2_SetFloat(file, "a_Y", Actor[i][a_Y]);
		DOF2_SetFloat(file, "a_Z", Actor[i][a_Z]);
		DOF2_SetFloat(file, "a_A", Actor[i][a_A]);
        DOF2_SetInt(file, "a_Mundo", Actor[i][a_Mundo]);
		DOF2_SetInt(file, "a_Interior", Actor[i][a_Interior]);
		DOF2_SetInt(file, "a_Caixa", Actor[i][a_Caixa]);
        DOF2_SaveFile();
    }
	else if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
}


stock destruir_actor(i)
{
    Actor[i][a_Existe] = 0;
    atualizar_actor(i);
    salvar_actor(i);
}


stock criar_actor(Float:x, Float:y, Float:z, Float:a, const nome[], interior, mundo, skin, anim=0, const anim1[]="Nenhuma", const anim2[]="Nenhuma")
{
	for(new i; i<MAX_BOOTS; i++)
	{
		if(Actor[i][a_Existe] == 0)
		{
            Actor[i][a_Existe] = 1;
            Actor[i][a_X] = x;
            Actor[i][a_Y] = y;
            Actor[i][a_Z] = z;
            Actor[i][a_A] = a;
            Actor[i][a_Skin] = skin;
            Actor[i][a_Mundo] = mundo;
            Actor[i][a_Interior] = interior;
            Actor[i][a_Animacao] = anim;
            format(Actor[i][a_Nome], MAX_PLAYER_NAME, nome);
            format(Actor[i][a_Anim1], 40, anim1);
            format(Actor[i][a_Anim2], 40, anim2);
            atualizar_actor(i);
    		salvar_actor(i);
			return i;
		}
	}
	return -1;
}


BCG:: carregar_actors()
{
	new file[80];
	new cont;
	for(new i; i<MAX_BOOTS; i++)
	{
	    Actor[i][a_3D] = DynamicText3D:-1;
		format(file, 80, "Actors/Actor_%d.txt", i);
		if(DOF2_FileExists(file))
		{
		    cont++;
            Actor[i][a_Existe] = 1;
            Actor[i][a_Skin] = DOF2_GetInt(file, "a_Skin");
            format(Actor[i][a_Nome], MAX_PLAYER_NAME, "%s", DOF2_GetString(file, "a_Nome"));
            format(Actor[i][a_Anim1], 40, "%s", DOF2_GetString(file, "a_Anim1"));
            format(Actor[i][a_Anim2], 40, "%s", DOF2_GetString(file, "a_Anim2"));
            Actor[i][a_Animacao] = DOF2_GetInt(file, "a_Animacao");
			Actor[i][a_X] = DOF2_GetFloat(file, "a_X");
			Actor[i][a_Y] = DOF2_GetFloat(file, "a_Y");
			Actor[i][a_Z] = DOF2_GetFloat(file, "a_Z");
			Actor[i][a_A] = DOF2_GetFloat(file, "a_A");
            Actor[i][a_Mundo] = DOF2_GetInt(file, "a_Mundo");
            Actor[i][a_Interior] = DOF2_GetInt(file, "a_Interior");
            Actor[i][a_Caixa] = DOF2_GetInt(file, "a_Caixa");
            atualizar_actor(i);
		}
	}
	printf("** %d Actors carregadas.", cont);
}


stock ShowAnimsDialog(playerid)
{
	if(strlen(anims_lastlib[playerid]) == 0)
	{
		anims_String = "\0";//Reset the global string
		anims_lastlib[playerid] = "\0";
		for(new i; i<sizeof sAnimList; i++)
		{
			format(anims_String,sizeof(anims_String),"%s%s\n",anims_String,sAnimList[i]);
		}
		ShowPlayerDialog(playerid, DIALOG_ANIMS_INCLUDE, DIALOG_STYLE_LIST, "Please Choose an animation Library", anims_String, "Select", "Cancel");
	}
	else
	{
		ShowAnimsLib(playerid,anims_lastlib[playerid]);
	}
	ClearAnimations(playerid, 1);
}

stock PreloadAnimLib(playerid, animlib[]) ApplyAnimation(playerid,animlib,"null",0.0,false,false,false,false,0);
stock GetAnimsLibFromId(libid)
{
	new tmp[50];
	if(libid > sizeof(sAnimList))
	{
		printf("[N_ANIMS] Animation liabrary id %i is an invalid id",libid);
		format(tmp,sizeof(tmp),"Unknown");
	}
	else
	{
		format(tmp,sizeof(tmp),"%s",sAnimList[libid]);
	}
	return tmp;
}

stock ShowAnimsLib(playerid, lib[])
{
	new path[128];
	anims_String = "\0";//Reset the global string
	format(path, sizeof(path), "Anims/%s.txt", n_animtrim(lib));
	if(!fexist(path))
	{
		printf("[N_ANIMS] Animation liabrary %s not found. Check if %s is in your scriptfiles directory",lib,path);
		anims_lastlib[playerid] = "\0";
	}
	else
	{
		new line[128],File:anims_list = fopen(path, io_read), anims_title[128];
		while(fread(anims_list, line))
		{
			format(anims_String,sizeof(anims_String),"%s%s",anims_String,line);
		}
		fclose(anims_list);
		format(anims_title,sizeof(anims_title),"Please Choose an animation ( Animations/%s )",lib);
		ApplyAnimation(playerid,lib,"null",0.0,false,false,false,false,0);
		ShowPlayerDialog(playerid, DIALOG_ANIMS_INCLUDE2, DIALOG_STYLE_LIST, anims_title, anims_String, "Select", "Cancel");
	}
}


#define _strlib_included
#define _strlib_sma_string 128
#define _strlib_med_string 256
#define _strlib_big_string 512
stock n_animtrim(const sSource[])
{
    new
    iBegin,
    iEnd,
    iInputLength = strlen(sSource),
    sReturn[_strlib_med_string];
    strcat(sReturn, sSource, _strlib_med_string);
    for(iBegin = 0; iBegin < iInputLength; ++iBegin)
	{
        switch(sReturn[iBegin])
		{
            case ' ', '\t', '\r', '\n':
            {
                continue;
            }
            default:
            {
                break;
            }
        }
    }
    for(iEnd = (iInputLength - 1); iEnd > iBegin; --iEnd)
	{
        switch(sReturn[iEnd])
		{
            case ' ', '\t', '\r', '\n':
            {
                continue;
            }
            default:
            {
                break;
            }
        }
    }
    strdel(sReturn, (iEnd + 1), iInputLength);
    strdel(sReturn, 0, iBegin);
    return sReturn;
}

BCG:: carregar_veiculos_e_casas()
{
	iniciar_loop_lento(-1, LL_CARREGAR_VEICULOS, 0, MAX_VEICULOS);
}

stock spawn_veiculo(v)
{
	new idv = CreateVehicle_(Veiculo[v][v_Modelo], Veiculo[v][v_X], Veiculo[v][v_Y], Veiculo[v][v_Z], Veiculo[v][v_A], Veiculo[v][v_Cor1], Veiculo[v][v_Cor2], -1, 0);
	if(idv != INVALID_VEHICLE_ID)
	{
		Info_Veiculo[idv] = v;
		Veiculo[v][v_ID] = idv;
		rebocando_moto[v] = -1;
		texto_garagem(v);
		if( (Veiculo[v][v_Emprego] != -1) || (Veiculo[v][v_Org] == -1 && Veiculo[v][v_Emprego] == -1 && Veiculo[v][v_Dono] == -1))
		{
		    Veiculo[v][v_Trancado] = 0;
		    Veiculo[v][v_Gasolina] = 100;
		    Veiculo[v][v_Bateria] = 100;
		    Veiculo[v][v_Lataria] = 1000;
		}
		if(Veiculo[v][v_Dono] != -1)
		    SetVehicleHealth(idv, Veiculo[v][v_Vida]);
		KillTimer(timer_veiculo[idv]);
		timer_veiculo[idv] = SetTimerEx("veiculos", 1000, true, "d", idv);
	}
}

// painels
stock decode_panels(panels, &front_left_panel, &front_right_panel, &rear_left_panel, &rear_right_panel, &windshield, &front_bumper, &rear_bumper)
{
    front_left_panel = panels & 15;
    front_right_panel = panels >> 4 & 15;
    rear_left_panel = panels >> 8 & 15;
    rear_right_panel = panels >> 12 & 15;
    windshield = panels >> 16 & 15;
    front_bumper = panels >> 20 & 15;
    rear_bumper = panels >> 24 & 15;
}
stock encode_panels(front_left_panel, front_right_panel, rear_left_panel, rear_right_panel, windshield, front_bumper, rear_bumper)
{
    return front_left_panel | (front_right_panel << 4) | (rear_left_panel << 8) | (rear_right_panel << 12) | (windshield << 16) | (front_bumper << 20) | (rear_bumper << 24);
}

// portas //
stock decode_doors(doors, &bonnet, &boot, &driver_door, &passenger_door)
{
    bonnet = doors & 7;
    boot = doors >> 8 & 7;
    driver_door = doors >> 16 & 7;
    passenger_door = doors >> 24 & 7;
}
stock encode_doors(bonnet, boot, driver_door, passenger_door)
{
    return bonnet | (boot << 8) | (driver_door << 16) | (passenger_door << 24);
}

// farol //
stock decode_lights(lights, &front_left_light, &front_right_light, &back_lights)
{
    front_left_light = lights & 1;
    front_right_light = lights >> 2 & 1;
    back_lights = lights >> 6 & 1;
}
stock encode_lights(front_left_light, front_right_light, back_lights)
{
    return front_left_light | (front_right_light << 2) | (back_lights << 6);
}


// pneus //
stock encode_tires(rear_right_tire, front_right_tire, rear_left_tire, front_left_tire)
{
	return rear_right_tire | (front_right_tire << 1) | (rear_left_tire << 2) | (front_left_tire << 3);
}
stock decode_tires(tires, &rear_right_tire, &front_right_tire, &rear_left_tire, &front_left_tire)
{
    rear_right_tire = tires & 1;
    front_right_tire = tires >> 1 & 1;
    rear_left_tire = tires >> 2 & 1;
    front_left_tire = tires >> 3 & 1;
}

BCG:: carregar_tuning(vehicleid)
{
    new tires;
    new v = Info_Veiculo[vehicleid];
	if(v != -1)
	{
	    veiculo_acessorios(vehicleid);
		decode_tires(tires, Veiculo[v][v_Pneu][0], Veiculo[v][v_Pneu][1], Veiculo[v][v_Pneu][2], Veiculo[v][v_Pneu][3]);
		SetVehiclePos(vehicleid, Veiculo[v][v_X], Veiculo[v][v_Y], Veiculo[v][v_Z]);
		SetVehicleZAngle(vehicleid, Veiculo[v][v_A]);
		ChangeVehicleColor(vehicleid, Veiculo[v][v_Cor1], Veiculo[v][v_Cor2]);
		update_danos_veiculo(vehicleid, v);
	}
	return 1;
}

stock update_danos_veiculo(vehicleid, v)
{
	new panels = encode_panels(Veiculo[v][v_Painel][0], Veiculo[v][v_Painel][1], Veiculo[v][v_Painel][2], Veiculo[v][v_Painel][3], Veiculo[v][v_Painel][4], Veiculo[v][v_Painel][5], Veiculo[v][v_Painel][6]);
	new doors = encode_doors(Veiculo[v][v_Porta][0], Veiculo[v][v_Porta][1], Veiculo[v][v_Porta][2], Veiculo[v][v_Porta][3]);
	new lights = encode_lights(Veiculo[v][v_Farol][0], Veiculo[v][v_Farol][1], Veiculo[v][v_Farol][2]);
	new tirees = encode_tires(Veiculo[v][v_Pneu][0], Veiculo[v][v_Pneu][1], Veiculo[v][v_Pneu][2], Veiculo[v][v_Pneu][3]);
	UpdateVehicleDamageStatus(vehicleid, panels, doors, lights, tirees);
}

stock carregar_inventario(playerid, c)
{
    for(new ii; ii<MAX_SLOTS; ii++)
    {
        Inventario[playerid][ii][inv_ID] = 0;
        Inventario[playerid][ii][inv_Tipo] = 0;
        Inventario[playerid][ii][inv_Unidades] = 0;
        Inventario[playerid][ii][inv_Ativo] = 0;
        Inventario[playerid][ii][inv_Tempo] = 0;
    }

	new file[100];
	format(file, 100, "Inventarios/%d.txt", c);
	if(DOF2_FileExists(file))
	{
		new string[80];
		new str[350];
		for(new i; i<MAX_SLOTS; i++)
		{
			format(string, 80, "slot_%d", i);
			format(str, 300, "%s", DOF2_GetString(file, string));
			split_linha(str, strlen(str));
			Inventario[playerid][i][inv_ID] = strval(split[0]);
			Inventario[playerid][i][inv_Unidades] = strval(split[1]);
			Inventario[playerid][i][inv_Tipo] = strval(split[2]);
			Inventario[playerid][i][inv_Ativo] = strval(split[3]);
			Inventario[playerid][i][inv_Tempo] = strval(split[4]);
		}
	}
}

stock salvar_inventario(c, slot=-1)
{
	new playerid = ContaOnline(c);
	if(Online(playerid))
	{
		new file[100];
		format(file, 100, "Inventarios/%d.txt", c);
		if(!DOF2_FileExists(file)) DOF2_CreateFile(file);
		new string[100];
		new str[300];
		if(slot != -1)
		{
		    format(string, 100, "slot_%d", slot);
		    format(str, 300, "%d|%d|%d|%d|%d|", Inventario[playerid][slot][inv_ID],
			Inventario[playerid][slot][inv_Unidades], Inventario[playerid][slot][inv_Tipo],
			Inventario[playerid][slot][inv_Ativo], Inventario[playerid][slot][inv_Tempo]);
			DOF2_SetString(file, string, str);
			DOF2_SaveFile();
		}
		else
		{
			for(new i; i<MAX_SLOTS; i++)
			{
			    format(string, 100, "slot_%d", i);
			    format(str, 300, "%d|%d|%d|%d|%d|", Inventario[playerid][i][inv_ID],
				Inventario[playerid][i][inv_Unidades], Inventario[playerid][i][inv_Tipo],
				Inventario[playerid][i][inv_Ativo], Inventario[playerid][i][inv_Tempo]);
				DOF2_SetString(file, string, str);
			}
			DOF2_SaveFile();
		}
	}
}

stock Play_Som(som, Float:x, Float:y, Float:z, mun, inte)
{
    foreach(new i:Player)
	{
		if(Online(i))
		{
			if(IsPlayerInRangeOfPoint(i, 30, x,y,z))
			{
			    if(GetPlayerInterior(i) == inte)
				{
				    if(GetPlayerVirtualWorld_(i) == mun)
					{
			    		PlayerPlaySound(i, som, x,y,z);
			    	}
				}
			}
		}
	}
}

stock Play_Som_Veiculo(som, veh)
{
    foreach(new i:Player)
	{
		if(Online(i))
		{
			if(IsPlayerInAnyVehicle(i) && id[i] != -1)
			{
			    if(GetPlayerVehicleID(i) == veh)
				{
			    	PlayerPlaySound(i, som, 0.0, 0.0 , 0.0);
				}
			}
		}
	}
}

stock gerar_placa(placa[], tamanho=20)
{
	new letras[3];
	for(new i; i<3; i++) letras[i] = 'A' + random(26);
    format(placa, tamanho, "%c%c%c - %04d", letras[0], letras[1], letras[2], random(MAX_VEICULOS));
}

stock ConvertMoney(amount)
{
    new strl[50], lenl = sizeof strl;
    if(amount == cellmin)
    {
        strl[0] = EOS;
        strcat(strl, "-2.147.483.648", lenl);
        return strl;
    }

    format(strl, lenl, "%d", amount);

    for(new i = strlen(strl), end = amount >= 0 ? 0 : 1; (i -= 3) > end;)
   	strins(strl, ".", i, lenl);
    return strl;
}

stock abrir_portamalas(playerid, v)
{
	if(Online(playerid))
	{
		if(v != -1)
		{
			mostrando_portamalas[playerid] = v;
			// abre o inventario visual com o Porta-Malas no lado direito
			inv_modo[playerid] = INV_MODO_PM;
			inv_pm_alvo[playerid] = v;
			abrir_inv_novo(playerid);
		}
	}
}

stock Travado(vehicleid)
{
	if(Info_Veiculo[vehicleid] != -1) return Veiculo[Info_Veiculo[vehicleid]][v_Trancado];
	else
	{
		for(new i; i<MAX_CONCE; i++)
		{
		    if(Conce[i][con_Existe] == 1)
		    {
		        for(new a; a<MAX_VEICULOS_CONCE; a++)
		        {
		            if(Conce[i][con_v_Existe][a] == 1)
		            {
		                if(Conce[i][con_v_Veiculo][a] == vehicleid)
		                {
		                    return 1;
		                }
		            }
		        }
		    }
		}
	}
	return 0;
}

stock tem_chave(playerid, v)
{
	if(Veiculo[v][v_Dono] == id[playerid]) return 1;
	if(Veiculo[v][v_Org] != -1 && Veiculo[v][v_Org] == OrgPlayer(playerid)) return 1;
	if(Veiculo[v][v_Emprego] != -1 && Veiculo[v][v_Emprego] == EmpregoPlayer(playerid)) return 1;
	for(new i; i<3; i++) if(Veiculo[v][v_Keys][i] == id[playerid]) return 1;
	return 0;
}

stock SalvarVeiculo(idv)
{
	if(idv > -1 && idv < MAX_VEHICLES)
	{
		new v = Info_Veiculo[idv];
		if(v != -1) SalvarInfo(v);
	}
}

stock SalvarPortaMalas(v)
{
    if(v < 0 || v >= MAX_VEICULOS) return 0;
    SalvarInfo(v, 0);
    return 1;
}

stock SalvarInfo(v, opc=-1, opc2=-1)
{
	if(v != -1)
	{
	    new file[80];
	    new str[500];
	    new str2[80];
	    new arwui[60];
	    new strf[15];
	    format(file, 80, "Veiculos/Veiculo_%d.txt", v);

        if(opc == 0)
		{
		    if(DOF2_FileExists(file))
		    {
				// porta malas //
		        if(opc2 != -1)
		        {
		            format(str2, 80, "v_Malas_%d", opc2);
				format(str, 500, "%d|%d|%d|%d|%d|", PortaMalas[v][opc2][inv_ID], PortaMalas[v][opc2][inv_Unidades], PortaMalas[v][opc2][inv_Tipo], PortaMalas[v][opc2][inv_Ativo], PortaMalas[v][opc2][inv_Tempo]);
				DOF2_SetString(file, str2, str);
		        }
		        else
		        {
					for(new po; po<MAX_PORTA_MALAS; po++)
					{
					format(str2, 80, "v_Malas_%d", po);
					format(str, 500, "%d|%d|%d|%d|%d|", PortaMalas[v][po][inv_ID], PortaMalas[v][po][inv_Unidades], PortaMalas[v][po][inv_Tipo], PortaMalas[v][po][inv_Ativo], PortaMalas[v][po][inv_Tempo]);
					DOF2_SetString(file, str2, str);
				    }
			    }
	        	DOF2_SaveFile();
	        }
	    }
        else if(opc == 55)
		{
		    // pneus e lataria //
		    str[0] = EOS;
		    for(new a; a<4; a++) valstr(strf, Veiculo[v][v_Pneu][a]), strcat(str, strf), strcat(str, "|");
		    for(new a; a<3; a++) valstr(strf, Veiculo[v][v_Farol][a]), strcat(str, strf), strcat(str, "|");
		    for(new a; a<4; a++) valstr(strf, Veiculo[v][v_Porta][a]), strcat(str, strf), strcat(str, "|");
		    for(new a; a<7; a++) valstr(strf, Veiculo[v][v_Painel][a]), strcat(str, strf), strcat(str, "|");
            DOF2_SetString(file, "v_Pecas", str);
		    DOF2_SaveFile();
		}
		else if(opc == 51)
		{
		    if(DOF2_FileExists(file))
		    {
		        // multas //
				for(new a; a<MAX_MULTAS; a++)
				{
					str[0] = EOS;
					format(arwui, 60, "v_Multa_%d", a);
					valstr(strf, Veiculo_Multa[v][a][mu_Existe]), strcat(str, strf), strcat(str, "|");
					valstr(strf, Veiculo_Multa[v][a][mu_Valor]), strcat(str, strf), strcat(str, "|");
					valstr(strf, Veiculo_Multa[v][a][mu_Conta]), strcat(str, strf), strcat(str, "|");
					valstr(strf, Veiculo_Multa[v][a][mu_Radar]), strcat(str, strf), strcat(str, "|");
					strcat(str, Veiculo_Multa[v][a][mu_Motivo]), strcat(str, "|");
					strcat(str, Veiculo_Multa[v][a][mu_Data]), strcat(str, "|");
					DOF2_SetString(file, arwui, str);
				}
		        DOF2_SaveFile();
		    }
		}
		else if(opc == 52)
		{
		    if(DOF2_FileExists(file))
		    {

		        // shasi //



		        DOF2_SaveFile();
		    }
		}
		else if(opc == 50)
		{
		    if(DOF2_FileExists(file))
		    {
		        // chave //
		        DOF2_SetInt(file, "v_Trancado", Veiculo[v][v_Trancado]);
		        DOF2_SaveFile();
		    }
		}
		else
		{
	        if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
			if(Veiculo[v][v_Existe] == 1)
			{
				// salvar as informacoes //
				DOF2_CreateFile(file);
		    	DOF2_SetInt(file, "XenonVeiculo_1", XenonVeiculo[v][0]);
		    	DOF2_SetInt(file, "XenonVeiculo_2", XenonVeiculo[v][1]);
		    	DOF2_SetInt(file, "NeonVeiculo_1", NeonVeiculo[v][0]);
		    	DOF2_SetInt(file, "NeonVeiculo_2", NeonVeiculo[v][1]);
				DOF2_SetInt(file, "v_IPVA", Veiculo[v][v_IPVA]);
		    	DOF2_SetInt(file, "v_Emplacar", Veiculo[v][v_Emplacar]);
				DOF2_SetString(file, "v_Placa", PlacaVeiculo[v]);
				DOF2_SetInt(file, "v_Conce", Veiculo[v][v_Conce]);
				DOF2_SetInt(file, "v_ConceID", Veiculo[v][v_ConceID]);
				DOF2_SetInt(file, "v_Contas", Veiculo[v][v_Contas]);
				DOF2_SetInt(file, "v_Dono", Veiculo[v][v_Dono]);
				DOF2_SetInt(file, "v_Modelo", Veiculo[v][v_Modelo]);
				DOF2_SetInt(file, "v_Gasolina", Veiculo[v][v_Gasolina]);
				DOF2_SetInt(file, "v_Bateria", Veiculo[v][v_Bateria]);
				DOF2_SetFloat(file, "v_Lataria", Veiculo[v][v_Lataria]);
				DOF2_SetInt(file, "v_Trancado", Veiculo[v][v_Trancado]);
				DOF2_SetInt(file, "v_Cor1", Veiculo[v][v_Cor1]);
				DOF2_SetInt(file, "v_Cor2", Veiculo[v][v_Cor2]);
				DOF2_SetInt(file, "v_Org", Veiculo[v][v_Org]);
				DOF2_SetInt(file, "v_Cargo", Veiculo[v][v_Cargo]);
				DOF2_SetInt(file, "v_Garagem_ID", Veiculo[v][v_Garagem_ID]);
				DOF2_SetInt(file, "v_Emprego", Veiculo[v][v_Emprego]);
				DOF2_SetInt(file, "v_Compra", Veiculo[v][v_Compra]);
				DOF2_SetFloat(file, "v_Vida", Veiculo[v][v_Vida]);
				DOF2_SetFloat(file, "v_X", Veiculo[v][v_X]);
				DOF2_SetFloat(file, "v_Y", Veiculo[v][v_Y]);
				DOF2_SetFloat(file, "v_Z", Veiculo[v][v_Z]);
				DOF2_SetFloat(file, "v_A", Veiculo[v][v_A]);
				DOF2_SetInt(file, "v_TemChasi", Veiculo[v][v_TemChasi]);
				DOF2_SetString(file, "v_Chasi", Veiculo[v][v_Chasi]);
				DOF2_SetString(file, "v_Data", Veiculo[v][v_Data]);
				DOF2_SetInt(file, "v_Key1", Veiculo[v][v_Keys][0]);
				DOF2_SetInt(file, "v_Key2", Veiculo[v][v_Keys][1]);
				DOF2_SetInt(file, "v_Key3", Veiculo[v][v_Keys][2]);
				DOF2_SetString(file, "v_History", Veiculo[v][v_History]);

				// tunnings //
			    str[0] = EOS;
				for(new a; a<18; a++)
				{
				valstr(strf, TuningVeiculo[v][a]);
				strcat(str, strf);
				strcat(str, "|");
			    }
			    DOF2_SetString(file, "v_Tunings", str);

				// porta malas //
				for(new po; po<MAX_PORTA_MALAS; po++)
				{
				format(str2, 80, "v_Malas_%d", po);
				format(str, 500, "%d|%d|%d|%d|%d|", PortaMalas[v][po][inv_ID], PortaMalas[v][po][inv_Unidades], PortaMalas[v][po][inv_Tipo], PortaMalas[v][po][inv_Ativo], PortaMalas[v][po][inv_Tempo]);
				DOF2_SetString(file, str2, str);
			    }

				// multas //
				for(new a; a<MAX_MULTAS; a++)
				{
					str[0] = EOS;
					format(arwui, 60, "v_Multa_%d", a);
					valstr(strf, Veiculo_Multa[v][a][mu_Existe]), strcat(str, strf), strcat(str, "|");
					valstr(strf, Veiculo_Multa[v][a][mu_Valor]), strcat(str, strf), strcat(str, "|");
					valstr(strf, Veiculo_Multa[v][a][mu_Conta]), strcat(str, strf), strcat(str, "|");
					valstr(strf, Veiculo_Multa[v][a][mu_Radar]), strcat(str, strf), strcat(str, "|");
					strcat(str, Veiculo_Multa[v][a][mu_Motivo]), strcat(str, "|");
					strcat(str, Veiculo_Multa[v][a][mu_Data]), strcat(str, "|");
					DOF2_SetString(file, arwui, str);
				}

				DOF2_SaveFile();
			}
		}
	}
}


stock verificar_porta_malas(playerid)
{
	new Float:p[6];
	foreach(new v:Vehicles)
	{
		if(GetVehicleModel(v) != 0)
		{
		    if(Info_Veiculo[v] != -1)
		    {
		        new idv = Info_Veiculo[v];
			    GetVehiclePos(v, p[0], p[1], p[2]);
				GetVehicleZAngle(v, p[3]);
				PegarFrente(p[0], p[1], p[3], -3.5);
				if(IsPlayerInRangeOfPoint(playerid, 2.2, p[0], p[1], p[2]))
				{
				    GetVehiclePos(v, p[4], p[5], p[2]);
				    SetPlayerToFacePos(playerid, p[4], p[5]);
					if(Travado(v)) return -2;
					if(Veiculo[idv][v_Dono] != -1 && !tem_chave(playerid, idv)) return -5;
					if(Veiculo[idv][v_Org] != -1)
					{
					    if(OrgPlayer(playerid) != Veiculo[idv][v_Org])
						{
						return -3;
					    }
					}
					if(Veiculo[idv][v_Emprego] != -1)
					{
					    if(EmpregoPlayer(playerid) != Veiculo[idv][v_Emprego])
						{
						return -4;
					    }
					}
					SetPVarInt(playerid, "veiculo", v);
				    return idv;
				}
			}
		}
	}
	return -1;
}

stock PegarFrentePlayer(playerid, &Float:x, &Float:y, Float:dist)
{
	new Float:ang;
	GetPlayerFacingAngle(playerid, ang);
	PegarFrente(x, y, ang, dist);
}

stock PegarFrente(&Float:x, &Float:y, Float:a, Float:distance)
{
	if(a > 360.0) a -= 360.0;
	if(a < 0.0) a += 360.0;
	x += (distance * floatsin(-a, degrees));
	y += (distance * floatcos(-a, degrees));
}


BCG:: SetPlayerToFaceVehicle(playerid, vehicleid)
{
	new
	Float:Xxx,
	Float:Yyy,
	Float:Zzz,
	Float:pXxx,
	Float:pYyy,
	Float:pZzz,
	Float:ang;
	if(IsPlayerConnected(playerid))
	{
		if(GetVehicleModel(vehicleid) != 0)
		{
			GetPlayerPos(playerid, pXxx, pYyy, pZzz);
			GetVehiclePos(vehicleid, Xxx, Yyy, Zzz);
			if( Yyy > pYyy ) ang = (-acos((Xxx - pXxx) / floatsqroot((Xxx - pXxx)*(Xxx - pXxx) + (Yyy - pYyy)*(Yyy - pYyy))) - 90.0);
			else if( Yyy < pYyy && Xxx < pXxx ) ang = (acos((Xxx - pXxx) / floatsqroot((Xxx - pXxx)*(Xxx - pXxx) + (Yyy - pYyy)*(Yyy - pYyy))) - 450.0);
			else if( Yyy < pYyy ) ang = (acos((Xxx - pXxx) / floatsqroot((Xxx - pXxx)*(Xxx - pXxx) + (Yyy - pYyy)*(Yyy - pYyy))) - 90.0);
			if(Xxx > pXxx) ang = (floatabs(floatabs(ang) + 180.0));
			else ang = (floatabs(ang) - 180.0);
			SetPlayerFacingAngle(playerid, ang);
		}
	}
}

BCG:: SetPlayerToFacePos(playerid, Float:Xxx, Float:Yyy)
{
	new
	Float:pXxx,
	Float:pYyy,
	Float:pZzz,
	Float:ang;
	if(IsPlayerConnected(playerid))
	{
		GetPlayerPos(playerid, pXxx, pYyy, pZzz);
		if( Yyy > pYyy ) ang = (-acos((Xxx - pXxx) / floatsqroot((Xxx - pXxx)*(Xxx - pXxx) + (Yyy - pYyy)*(Yyy - pYyy))) - 90.0);
		else if( Yyy < pYyy && Xxx < pXxx ) ang = (acos((Xxx - pXxx) / floatsqroot((Xxx - pXxx)*(Xxx - pXxx) + (Yyy - pYyy)*(Yyy - pYyy))) - 450.0);
		else if( Yyy < pYyy ) ang = (acos((Xxx - pXxx) / floatsqroot((Xxx - pXxx)*(Xxx - pXxx) + (Yyy - pYyy)*(Yyy - pYyy))) - 90.0);
		if(Xxx > pXxx) ang = (floatabs(floatabs(ang) + 180.0));
		else ang = (floatabs(ang) - 180.0);
		SetPlayerFacingAngle(playerid, ang);
	}
}



stock mostrar_lista_acessorios(playerid)
{
    SG[0] = EOS;
	new sss1[100];
	new limite;
	new pags = paginas(50, sizeof(Acessorios_Info));
    strcat(SG, "ID\tNome\n");
	for(new i = pagina_dialog2[playerid]*50; i<sizeof(Acessorios_Info); i++)
	{
	    limite ++;
		format(sss1, 100, "{00ffff}%d\t{a1a1a1}%s\n", i, Acessorios_Info[i][acessorio_Nome]);
        strcat(SG, sss1);
        if(limite == 50)
		{
		    strcat(SG, "{4169E1}>>>> AVANCAR >>>>\t{000000}_\n");
		    strcat(SG, "{ffff00}<<<<  VOLTAR <<<<\t{000000}_\n");
            break;
		}
	}
	if(limite < 50)
	{
	    strcat(SG, "{4169E1}>>>> AVANCAR >>>>\t{000000}_\n");
	    strcat(SG, "{ffff00}<<<<  VOLTAR <<<<\t{000000}_\n");
	}
	format(sss1, 100, "{ffffff}Lista de Acessorios  {a1a1a1}Pagina {00ffff}%d{a1a1a1}/{ffff00}%d",  pagina_dialog2[playerid]+1, pags);
    ShowPlayerDialog(playerid, DIALOG_LISTA_ACESSORIOS, DIALOG_STYLE_TABLIST_HEADERS, sss1, SG, "Criar", "Fechar");
}


