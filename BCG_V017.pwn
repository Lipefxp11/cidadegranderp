	    if(OrgCop(org) || Org[org][o_Tipo] == 7) return ms(playerid, 0, "Sua organizacao nao pode usar o painel !");
	    PainelOrgsP[playerid][0] = CreatePlayerTextDraw(playerid, 420.000, 331.000, "");
	    PlayerTextDrawLetterSize(playerid, PainelOrgsP[playerid][0], 0.180, 0.898);
	    PlayerTextDrawTextSize(playerid, PainelOrgsP[playerid][0], 743.000, -66.000);
	    PlayerTextDrawAlignment(playerid, PainelOrgsP[playerid][0], 1);
	    PlayerTextDrawColor(playerid, PainelOrgsP[playerid][0], -1);
	    PlayerTextDrawSetShadow(playerid, PainelOrgsP[playerid][0], 0);
	    PlayerTextDrawSetOutline(playerid, PainelOrgsP[playerid][0], 0);
	    PlayerTextDrawBackgroundColor(playerid, PainelOrgsP[playerid][0], 150);
	    PlayerTextDrawFont(playerid, PainelOrgsP[playerid][0], 1);
	    PlayerTextDrawSetProportional(playerid, PainelOrgsP[playerid][0], true);
	    PlayerTextDrawSetString(playerid, PainelOrgsP[playerid][0], NomeOrg(org));
	    TextDrawSetPreviewModel(PainelOrgs[13], Org[org][o_Skins][6]);
	    TextDrawSetPreviewRot(PainelOrgs[13], 0.000, 0.000, 0.000, 1.000);
	    TextDrawSetPreviewVehicleColors(PainelOrgs[13], 0, 0);
	    for(new i; i<33; i++) TextDrawShowForPlayer(playerid, PainelOrgs[i]);
	    PlayerTextDrawShow(playerid, PainelOrgsP[playerid][0]);
	    SelectTextDraw(playerid, 0x00ffff90);
	    PainelOrgsAberto[playerid] = true;
	    return 1;
	}

