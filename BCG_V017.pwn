	if(!strcmp(cmd, "/ao", true))
	{
		if(CargoPlayer(playerid) < 5) return ms(playerid, 2, "Apenas Lider e Sub Liders podem Mandar anuncios Globais !");
		new sss[300], avi[200];
	    if(sscanf(params, "s[200]", avi)) return ms(playerid, 2, "Use: /ao [ Menssagem para todos ]");
		if(strlen(avi) > 198) return ms(playerid, 0, "Menssagem muito longa, tente novamente !");
	    format(sss, 300, "{a1a1a1}_________________ [ {FFFFFF}%s {a1a1a1}] _________________", NomeOrg(OrgPlayer(playerid)));
	    mst(-1, sss);
		format(sss, 300, "{BEBEBE}%s {a1a1a1}(%s): {FFFFFF}%s", Nome(playerid), nome_cargo(CargoPlayer(playerid), OrgPlayer(playerid)), avi);
