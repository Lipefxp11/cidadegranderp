		GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
		new c = CriarGZ(pos[0], pos[1], pos[2], 100, 100, 0, 0, nomegz);
		if(c == -1) return ms(playerid, 0, "Numero maximo de GZS do servidor atingido !");
		new sss[150];
		format(sss, 150, "Voce criou a GZ [%d] '%s', Use /ajudagzs para ver os comandos.", c, nomegz);
		ms(playerid, 5, sss);
		return 1;
	}

