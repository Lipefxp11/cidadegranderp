}

stock Telar(playerid, player)
{
	new c = id[playerid];
	if(c == -1) return 1;
	new sss[150];
    if(TestePlayer[playerid] == -1 && player_arena[playerid] == 0)
	{
	    if(tv_player[playerid] == -1)
	    {
	        Conta[playerid][c_Interior] = GetPlayerInterior(playerid);
			Conta[playerid][c_Mundo] = GetPlayerVirtualWorld(playerid);
			GetPlayerPos(playerid, Conta[playerid][c_X],Conta[playerid][c_Y],Conta[playerid][c_Z]);
			GetPlayerFacingAngle(playerid, Conta[playerid][c_A]);
			salvar_conta(c, -1, "c_Posicao");
			salvar_conta(c, playerid, "c_Armas");
		}

		tv_player[playerid] = player;
		TextDrawShowForPlayer(playerid, T_Telando[0]);
		PlayerTextDrawShow(playerid, T_Telando_p[playerid][0]);
		PlayerTextDrawShow(playerid, T_Telando_p[playerid][1]);
		PlayerTextDrawShow(playerid, T_Telando_p[playerid][2]);
		
	    TogglePlayerSpectating(playerid, true) ;
	    if(!IsPlayerInAnyVehicle(player)) 
		{
			SetPlayerInterior(playerid, GetPlayerInterior(player));
	    	SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(player));
			PlayerSpectatePlayer(playerid, player, SPECTATE_MODE_NORMAL);
		}
		else
		{
				new veicle = GetPlayerVehicleID(player);
				SetPlayerInterior(playerid, GetPlayerInterior(player));
				SetPlayerInterior(playerid, GetPlayerVirtualWorld(player));
				PlayerSpectateVehicle(playerid, veicle);
		}

	    format(sss, 150, "[TV] Voce esta Telando '%s[%d]' Conta: %d.", Nome(player), player, id[player]);
	    ms(playerid, 2, sss);
	    esconder_hud(playerid);
	    if(ta_de_tv[player] == 1)
	    {
	        format(sss, 150, "[TV] '%s[%d]' Conta: %d, esta de TV em voce.", Nome(playerid), playerid, id[playerid]);
            ms(player, 2, sss);
	    }
	    return 1;
	}
    else ms(playerid, 0, "Voce nao pode fazer isso no momento !");
	return 0;
}


BCG:: sentar_player(playerid)
{
	if(id[playerid] == -1)
	{
	    SetPlayerInterior(playerid, 3);
	    SetPlayerVirtualWorld_(playerid, playerid+1);
	    SetPlayerPos_(playerid, 1038.8840,0.5544,1001.2845);
	    SetPlayerFacingAngle(playerid, 85.1552);
	    Streamer_Update(playerid);
	    SetPlayerCameraPos(playerid, 1036.9847, -0.5999, 1001.2845);
		SetPlayerCameraLookAt(playerid, 1038.8840,0.5544,1001.2845);
    	ApplyAnimation(playerid, "PED","SEAT_idle", 25.0, false, false, false, true, 0, 1);
    }
    return 1;
}

stock fechar_menu_vei(playerid)
{
    menu_vei_aberto[playerid] = 0;
	CancelSelectTextDraw(playerid);
	for(new a; a<sizeof T_Menu_Veiculo; a++) TextDrawHideForPlayer(playerid, T_Menu_Veiculo[a]);
}

stock menu_vei(playerid, car, mud=-1)
{
    #pragma unused mud
    if(GetVehicleModel(car) != 0)
	{
	    if(menu_vei_aberto[playerid] == 0)
	    {
            menu_vei_aberto[playerid] = 1;
            SelectTextDraw(playerid, 0x00ffff50);
            if(!VeiculoMoto(car))
			{
			    TextDrawShowForPlayer(playerid, T_Menu_Veiculo[0]);
				for(new a=1; a<60; a++) TextDrawShowForPlayer(playerid, T_Menu_Veiculo[a]);
				if(motor[car] == 0) TextDrawShowForPlayer(playerid, T_Menu_Veiculo[2]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[54]);
				else TextDrawShowForPlayer(playerid, T_Menu_Veiculo[54]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[2]);
				if(farol[car] == 0) TextDrawShowForPlayer(playerid, T_Menu_Veiculo[4]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[56]);
				else TextDrawShowForPlayer(playerid, T_Menu_Veiculo[56]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[4]);
				if(Travado(car)) TextDrawShowForPlayer(playerid, T_Menu_Veiculo[58]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[36]);
				else TextDrawShowForPlayer(playerid, T_Menu_Veiculo[36]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[58]);
				if(Blutuf_Veiculo[car] == -1) TextDrawShowForPlayer(playerid, T_Menu_Veiculo[45]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[59]);
				else TextDrawShowForPlayer(playerid, T_Menu_Veiculo[59]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[45]);
				if(capo[car] == 0) TextDrawShowForPlayer(playerid, T_Menu_Veiculo[5]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[57]);
				else TextDrawShowForPlayer(playerid, T_Menu_Veiculo[57]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[5]);
				if(malas[car] == 0) TextDrawShowForPlayer(playerid, T_Menu_Veiculo[3]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[55]);
				else TextDrawShowForPlayer(playerid, T_Menu_Veiculo[55]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[3]);
				for(new a=6; a<54; a++) TextDrawShowForPlayer(playerid, T_Menu_Veiculo[a]);
			}
			else
			{
			    TextDrawShowForPlayer(playerid, T_Menu_Veiculo[0]);
				for(new a=1; a<60; a++) TextDrawShowForPlayer(playerid, T_Menu_Veiculo[a]);
				if(motor[car] == 0) TextDrawShowForPlayer(playerid, T_Menu_Veiculo[2]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[54]);
				else TextDrawShowForPlayer(playerid, T_Menu_Veiculo[54]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[2]);
				if(farol[car] == 0) TextDrawShowForPlayer(playerid, T_Menu_Veiculo[4]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[56]);
				else TextDrawShowForPlayer(playerid, T_Menu_Veiculo[56]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[4]);
				if(Travado(car)) TextDrawShowForPlayer(playerid, T_Menu_Veiculo[58]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[36]);
				else TextDrawShowForPlayer(playerid, T_Menu_Veiculo[36]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[58]);
				if(Blutuf_Veiculo[car] == -1) TextDrawShowForPlayer(playerid, T_Menu_Veiculo[45]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[59]);
				else TextDrawShowForPlayer(playerid, T_Menu_Veiculo[59]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[45]);
				for(new a=6; a<54; a++) TextDrawShowForPlayer(playerid, T_Menu_Veiculo[a]);
				TextDrawHideForPlayer(playerid, T_Menu_Veiculo[5]);
				TextDrawHideForPlayer(playerid, T_Menu_Veiculo[57]);
				TextDrawHideForPlayer(playerid, T_Menu_Veiculo[3]);
				TextDrawHideForPlayer(playerid, T_Menu_Veiculo[55]);
				TextDrawHideForPlayer(playerid, T_Menu_Veiculo[32]);
			}
	    }
	    else
	    {
			if(motor[car] == 0) TextDrawShowForPlayer(playerid, T_Menu_Veiculo[2]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[54]);
			else TextDrawShowForPlayer(playerid, T_Menu_Veiculo[54]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[2]);
			if(farol[car] == 0) TextDrawShowForPlayer(playerid, T_Menu_Veiculo[4]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[56]);
			else TextDrawShowForPlayer(playerid, T_Menu_Veiculo[56]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[4]);
			if(Travado(car)) TextDrawShowForPlayer(playerid, T_Menu_Veiculo[58]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[36]);
			else TextDrawShowForPlayer(playerid, T_Menu_Veiculo[36]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[58]);
			if(Blutuf_Veiculo[car] == -1) TextDrawShowForPlayer(playerid, T_Menu_Veiculo[45]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[59]);
			else TextDrawShowForPlayer(playerid, T_Menu_Veiculo[59]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[45]);
			if(capo[car] == 0) TextDrawShowForPlayer(playerid, T_Menu_Veiculo[5]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[57]);
			else TextDrawShowForPlayer(playerid, T_Menu_Veiculo[57]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[5]);
			if(malas[car] == 0) TextDrawShowForPlayer(playerid, T_Menu_Veiculo[3]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[55]);
			else TextDrawShowForPlayer(playerid, T_Menu_Veiculo[55]), TextDrawHideForPlayer(playerid, T_Menu_Veiculo[3]);
	    }
	}

	return 1;
}

stock player_veiculo(playerid, car, opc)
{
    new Float:vidacarro;
	GetVehicleHealth(car, vidacarro);

	// motor//
	if(opc == 3)
	{
	    if(RC[playerid] == car) return ms(playerid, 0,  "Voce nao pode fazer isso com este veiculo !");
	    if(VeiculoBicicleta(car)) return ms(playerid, 0,  "Este veiculo nao tem um motor !");
	    if(VeiculoTeste[playerid] == car) return ms(playerid, 0, "Voce nao pode ligar/desligar o motor do veiculo da auto escola !");
		if(vidacarro <= 300.0 ) return ms(playerid, 0, "Este veiculo esta muito danificado, precisa de um concerto no Motor !");
		new d = Info_Veiculo[car];
		if(d != -1)
		{
		    if(Veiculo[d][v_Dono] != -1 && !tem_chave(playerid, d)) return ms(playerid, 0, "Voce nao tem a chave deste veiculo !");
		    if(Veiculo[d][v_Gasolina] == 0)
		    {
	            ms(playerid, 0, "Este veiculo nao tem combistivel !");
		        return 1;
		    }
		    if(Veiculo[d][v_Bateria] == 0)
		    {
	            ms(playerid, 0, "Este veiculo esta com a bateria descarregada, nao e possivel dar partida !");
		        return 1;
		    }
		}
		if(motor[car] == 0)
		{
		    motor_(car, 1);
		}
		else
		{
		    motor_(car, 0);
		}
	}

	// farol//
	if(opc == 4)
	{
	    if(RC[playerid] == car) return ms(playerid, 0,  "Voce nao pode fazer isso com este veiculo !");
	    if(VeiculoBicicleta(car)) return ms(playerid, 0,  "Este veiculo nao tem um farol !");
	    if(VeiculoTeste[playerid] == car) return ms(playerid, 0, "Voce nao pode ligar/desligar o farol do veiculo da auto escola !");
        new d = Info_Veiculo[car];
		if(d != -1)
		{
		    if(Veiculo[d][v_Bateria] == 0)
		    {
	            ms(playerid, 0, "Este veiculo esta com a bateria descarregada !");
		        return 1;
		    }
		}
		if(farol[car] == 0)
		{
		    farol_(car, 1);
	    }
		else
		{
		    farol_(car, 0);
	    }
	}

	// trancas //
	if(opc == 2)
	{
	    if(RC[playerid] == car) return ms(playerid, 0,  "Voce nao pode fazer isso com este veiculo !");
	    if(VeiculoBicicleta(car)) return ms(playerid, 0,  "Este veiculo nao tem uma Tranca !");
	    if(VeiculoTeste[playerid] == car) return ms(playerid, 0, "Voce nao pode trancar/destrancar o veiculo da auto escola !");
		new d = Info_Veiculo[car];
		if(d != -1)
		{
		    if(Veiculo[d][v_Dono] == -1 && Veiculo[d][v_Org] == -1 && Veiculo[d][v_Emprego] == -1) return ms(playerid, 0, "Este veiculo e publico, nao pode ser trancado ou destrancado !");
		    if(Veiculo[d][v_Dono] != -1 && !tem_chave(playerid, d)) return ms(playerid, 0, "Voce nao tem a chave deste veiculo !");
	        if(Veiculo[d][v_Trancado] == 0)
			{
				Veiculo[d][v_Trancado] = 1;
			}
			else
			{
			    Veiculo[d][v_Trancado] = 0;
			}
            SalvarInfo(d, 50);
            if(GetVehicleModel(car) == 0 || Veiculo[d][v_Garagem] == 1) Play_Som(1145, Veiculo[d][v_X],Veiculo[d][v_Y],Veiculo[d][v_Z], 0, 0);
			else
			{
				new Float:pp[3];
				GetVehiclePos(car, pp[0],pp[1],pp[2]);
				Play_Som(1145, pp[0],pp[1],pp[2], 0, 0);
			}
	    }
	    else ms(playerid, 0, "Este veiculo nao pode ser trancado !");
	}

	// blutuf //
	if(opc == 5)
	{
	    if(RC[playerid] == car) return ms(playerid, 0,  "Voce nao pode fazer isso com este veiculo !");
	    if(VeiculoBicicleta(car)) return ms(playerid, 0,  "Este veiculo nao tem Sistema de bluetooth !");
	    if(VeiculoTeste[playerid] == car) return ms(playerid, 0, "Voce nao pode ligar/desligar o bluetooth do veiculo da auto escola !");
        new d = Info_Veiculo[car];
		if(d != -1)
		{
		    if(!pode_jbl(playerid, car)) return ms(playerid, 0, "Ja tem um dispositivo conectado muito proximo desse local !");
		    if(Blutuf_Veiculo[car] >= 0)
			{
			    desconectar_veiculo(car);
			}
		    else if(Blutuf_Veiculo[car] == -1) Blutuf_Veiculo[car] = -2;
		    else Blutuf_Veiculo[car] = -1;

		}
		else ms(playerid, 0, "Este veiculo nao possue bluetooth !");
	}

	// capo //
	if(opc == 1)
	{
		if(RC[playerid] == car) return ms(playerid, 0,  "Voce nao pode fazer isso com este veiculo !");
 		if(VeiculoAviao(car) || VeiculoBarco(car) || VeiculoMoto(car) || VeiculoBicicleta(car)) return ms(playerid, 0, "Este veiculo nao tem capo.");
		if(VeiculoTeste[playerid] == car) return ms(playerid, 0, "Voce nao pode abrir/fechar o capo do veiculo da auto escola !");
        if(capo[car] == 0)
		{
		    capo_(car, 1);
	    }
		else
		{
		    capo_(car, 0);
	    }
	}

	// malas //
	if(opc == 6)
	{
	 	if(RC[playerid] == car) return ms(playerid, 0,  "Voce nao pode fazer isso com este veiculo !");
 		if(VeiculoAviao(car) || VeiculoBarco(car) || VeiculoMoto(car) || VeiculoBicicleta(car)) return ms(playerid, 0, "Este veiculo nao tem porta malas.");
		if(VeiculoTeste[playerid] == car) return ms(playerid, 0, "Voce nao pode abrir/fechar o porta-malas do veiculo da auto escola !");
		if(malas[car] == 0)
		{
		    malas_(car, 1);
	    }
		else
		{
		    malas_(car, 0);
	    }
	}

	return 1;
}

stock perguntar_tutorial(playerid)
{
	ShowPlayerDialog(playerid, DIALOG_TUTORIAL, DIALOG_STYLE_MSGBOX, "{000000}_", "{ffff00}[INFO] {ffffff}\
	Parece que voce ainda nao viu o nosso tutorial, recomendamos\n\
	que veja e preste bastante atencao para ficar por dentro de como\n\
	funciona as coisas pelas cidade, e oque fazer de inicio, se caso\n\
	ja conheca nosso servidor, nao tem problema, e Bom Jogo !", "Tutorial", "Pular");
	return 1;
}

stock mostrar_tutorial(playerid)
{
	SetPlayerInterior(playerid, 0);
	PlayAudioStreamForPlayer(playerid, som_tuto);
    esconder_contas(playerid);
    for(new dd; dd<sizeof HudFomeSede; dd++) TextDrawHideForPlayer(playerid, HudFomeSede[dd]);
    /*TextDrawHideForPlayer(playerid, T_Rodape[0]);
	TextDrawHideForPlayer(playerid, T_Rodape[1]);
	TextDrawHideForPlayer(playerid, T_Rodape[2]);*/
    player_tutorial[playerid] = 0;
	player_tutorial_tempo[playerid] = 0;
	return 1;
}

stock spawn_conta(playerid, cond=0)
{
    new c = contas[playerid];
    if(c != -1)
    {
        if(conta_existe[c] == 1)
        {
		    id[playerid] = c;
		    player_conta[c] = playerid;
		    esconder_contas(playerid);
		    SetarNickPlayer(playerid);
		    logou_agora[playerid] = 1;
		    mostrar_logomarca(playerid);
		    if(cond == 0) PlayerSpawn(playerid);
			else
			{
				TogglePlayerSpectating(playerid, false);
		    	PlayerSpawn(playerid);
		    }
		    mostrar_logomarca(playerid);
		    SetTimerEx("HudNewTimer", 500, true, "d", playerid);
		    Descongelar(playerid);
		    SetPlayerScore(playerid, Conta[playerid][c_Nivel]);
		    Conta[playerid][c_UltimoLogin] = getdate();
		    gettime(Conta[playerid][c_Hora], Conta[playerid][c_Minuto], Conta[playerid][c_Segundo]);
			getdate(Conta[playerid][c_Ano], Conta[playerid][c_Mes], Conta[playerid][c_Dia]);
			Conta[playerid][c_Tuto] = 1;
			salvar_conta(c, 0, "c_Hora", sv_int(Conta[playerid][c_Hora]));
			salvar_conta(c, 0, "c_Minuto", sv_int(Conta[playerid][c_Minuto]));
			salvar_conta(c, 0, "c_Segundo", sv_int(Conta[playerid][c_Segundo]));
			salvar_conta(c, 0, "c_Ano", sv_int(Conta[playerid][c_Ano]));
			salvar_conta(c, 0, "c_Mes", sv_int(Conta[playerid][c_Mes]));
			salvar_conta(c, 0, "c_Dia", sv_int(Conta[playerid][c_Dia]));
			salvar_conta(c, 0, "c_UltimoLogin", sv_int(Conta[playerid][c_UltimoLogin]));
			salvar_conta(c, 0, "c_Tuto", sv_int(Conta[playerid][c_Tuto]));
			CancelSelectTextDraw(playerid);
		}
	}
}

stock finalizar_tutorial(playerid)
{
	if(player_tutorial[playerid] != -1)
	{
	    PlayerTextDrawHide(playerid, T_Tutorial_p[playerid][0]);
	    PlayerTextDrawHide(playerid, T_Tutorial_p[playerid][1]);
	    player_tutorial[playerid] = -1;
	    player_tutorial_tempo[playerid] = 0;
	    new cc = contas[playerid];
	    carregar_conta_player(playerid, cc);
	    spawn_conta(playerid, 1);
	}
}

stock mostrar_cameras(playerid)
{
	SG[0] = EOS;
	strcat(SG, "{ffff00}Caixas Eletronicos\n");
	new cont;
	zerar_lista(playerid);
	foreach(new i:Iter_Cameras)
	{
	    if(cont >= MAX_LISTA) break;
	    if(Camera[i][cam_Existe] == 1)
	    {
			if(Camera[i][cam_Quebrada] == 0) strcat(SG, "{ffffff}");
			else strcat(SG, "{ff0000}");
			strcat(SG, Camera[i][cam_Nome]);
			strcat(SG, "\n");
			Lista[playerid][cont] = i;
			cont++;
	    }
	}
	ShowPlayerDialog(playerid, DIALOG_CAMERAS, DIALOG_STYLE_LIST, "Cameras de Seguranca", SG, "Continuar", "Fechar");
}

stock ver_camera(playerid, i)
{
    new c = id[playerid];
	if(c == -1) return 1;
	if(Camera[i][cam_Existe] == 1)
	{
	    if(Camera[i][cam_Quebrada] == 0)
	    {
	        if(olhando_camera[playerid] != -1)
	        {
	            olhando_camera[playerid] = 0;
				olhando_camera_id[playerid] = i;
				InterpolateCameraPos(playerid, Camera[i][cam_X],Camera[i][cam_Y],Camera[i][cam_Z], Camera[i][cam_X],Camera[i][cam_Y],Camera[i][cam_Z], 1000, CAMERA_CUT);
				InterpolateCameraLookAt(playerid, Camera[i][cam_FX],Camera[i][cam_FY],Camera[i][cam_FZ], Camera[i][cam_FX],Camera[i][cam_FY],Camera[i][cam_FZ], 1000, CAMERA_CUT);
				SetPlayerInterior(playerid, Camera[i][cam_Interior]);
				SetPlayerVirtualWorld_(playerid, Camera[i][cam_Mundo]);
				ms(playerid, 5, "[CAMERAS] Voce entrou no sistema da camera, aperte F ou ENTER para sair ou trocar de camera.");
				GameTextForPlayer(playerid, "~W~APERTE ~Y~F ~w~OU ~Y~ENTER ~W~PARA~N~~B~~H~ABRIR O MENU", 2000, 3);
	            return 1;
	        }

	        Conta[playerid][c_Interior] = GetPlayerInterior(playerid);
			Conta[playerid][c_Mundo] = GetPlayerVirtualWorld_(playerid);
	        GetPlayerPos(playerid, Conta[playerid][c_X], Conta[playerid][c_Y], Conta[playerid][c_Z]);
	        GetPlayerFacingAngle(playerid, Conta[playerid][c_A]);
			salvar_conta(c, -1, "c_Posicao");
			salvar_conta(c, playerid, "c_Armas");
	        if(IsValidDynamicActor(actor_player[playerid])) DestroyDynamicActor(actor_player[playerid]);
            if(IsValidDynamic3DTextLabel(actor_player_3D[playerid])) DestroyDynamic3DTextLabel(actor_player_3D[playerid]);
			actor_player[playerid] = CreateDynamicActor(GetPlayerSkin_(playerid), Conta[playerid][c_X], Conta[playerid][c_Y], Conta[playerid][c_Z], Conta[playerid][c_A], 0, 9999999.0, Conta[playerid][c_Mundo], Conta[playerid][c_Interior], -1, STREAMER_ACTOR_SD, -1, 0);
            new str_nick[150];
			format(str_nick, 150, "{00ffff}%d {ffff00}%d\n{a1a1a1}OLHANDO CAMERA", c, playerid);
			actor_player_3D[playerid] = CreateDynamic3DTextLabel( str_nick, 0xffffffff, Conta[playerid][c_X], Conta[playerid][c_Y], Conta[playerid][c_Z]+1.15, 15, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, Conta[playerid][c_Mundo], Conta[playerid][c_Interior], -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
			TogglePlayerSpectating(playerid, true);
			olhando_camera[playerid] = 0;
			olhando_camera_id[playerid] = i;
			InterpolateCameraPos(playerid, Camera[i][cam_X],Camera[i][cam_Y],Camera[i][cam_Z], Camera[i][cam_X],Camera[i][cam_Y],Camera[i][cam_Z], 1000, CAMERA_CUT);
			InterpolateCameraLookAt(playerid, Camera[i][cam_FX],Camera[i][cam_FY],Camera[i][cam_FZ], Camera[i][cam_FX],Camera[i][cam_FY],Camera[i][cam_FZ], 1000, CAMERA_CUT);
			SetPlayerInterior(playerid, Camera[i][cam_Interior]);
			SetPlayerVirtualWorld_(playerid, Camera[i][cam_Mundo]);
			ms(playerid, 5, "[CAMERAS] Voce entrou no sistema da camera, aperte F ou ENTER para sair ou trocar de camera.");
			GameTextForPlayer(playerid, "~W~APERTE ~Y~F ~w~OU ~Y~ENTER ~W~PARA~N~~B~~H~ABRIR O MENU", 2000, 3);
	        return 1;
		}
	}
	return 0;
}

stock menu_cameras(playerid)
{
	ShowPlayerDialog(playerid, DIALOG_MENU_CAMERA, DIALOG_STYLE_LIST, "Sistema de Cameras", "Mudar de Camera\n{ff0000}Sair", "Continuar", "Fechar");
}

stock ver_camera_caixa(playerid, i)
{
	new c = id[playerid];
	if(c == -1) return 1;
	if(CaixaEletronico[i][ce_Existe] == 1)
	{
	    if(CaixaEletronico[i][cec_Quebrado] == 0)
	    {
	        if(olhando_camera[playerid] != -1)
