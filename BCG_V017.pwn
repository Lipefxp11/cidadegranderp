stock escolher_tipo_org(playerid, i)
{
	new sss[150];
	SG[0] = EOS;
	SetPVarInt(playerid, "org", i);
	for(new a; a<sizeof tipo_org; a++)
	{
	    if(Org[i][o_Tipo] == a) format(sss, 150, "{00ffff}%s\n", tipo_org[a]);
	    else format(sss, 150, "{a1a1a1}%s\n", tipo_org[a]);
	    strcat(SG, sss);
	}
    ShowPlayerDialog(playerid, DIALOG_TIPOORG, DIALOG_STYLE_LIST, Org[i][o_Nome], SG, "Setar", "Cancelar");
}

stock nome_categoria_org(categoria)
{
	new sss[40];
	format(sss, 40, "Todas");
	if(categoria == ORG_CAT_CORPS) format(sss, 40, "Corporacoes");
	else if(categoria == ORG_CAT_FACCOES) format(sss, 40, "Faccoes");
	else if(categoria == ORG_CAT_MAFIAS) format(sss, 40, "Mafias");
	else if(categoria == ORG_CAT_DESMANCHE) format(sss, 40, "Desmanche");
	else if(categoria == ORG_CAT_NEUTRAS) format(sss, 40, "Neutras");
	return sss;
}

stock org_na_categoria(orgid, categoria)
{
	if(orgid < 0 || orgid >= MAX_ORGS) return 0;
	if(Org[orgid][o_Existe] != 1) return 0;
	if(categoria == ORG_CAT_TODAS) return 1;
	if(categoria == ORG_CAT_CORPS) return OrgGov(orgid) && Org[orgid][o_Tipo] != 8;
	if(categoria == ORG_CAT_FACCOES) return (Org[orgid][o_Tipo] == 5);
	if(categoria == ORG_CAT_MAFIAS) return (Org[orgid][o_Tipo] == 4);
	if(categoria == ORG_CAT_DESMANCHE) return (Org[orgid][o_Tipo] == 6);
	if(categoria == ORG_CAT_NEUTRAS) return (Org[orgid][o_Tipo] == 7 || Org[orgid][o_Tipo] == 8);
	return 0;
}

stock mostrar_categorias_orgs(playerid)
{
	SG[0] = EOS;
	zerar_lista(playerid);

	strcat(SG, "{4169E1}Corporacoes\n");
	Lista[playerid][0] = ORG_CAT_CORPS;
	strcat(SG, "{ff0000}Faccoes\n");
	Lista[playerid][1] = ORG_CAT_FACCOES;
	strcat(SG, "{EEE8AA}Mafias\n");
	Lista[playerid][2] = ORG_CAT_MAFIAS;
	strcat(SG, "{C0C0C0}Desmanche\n");
	Lista[playerid][3] = ORG_CAT_DESMANCHE;
	strcat(SG, "{00ffff}Neutras\n");
	Lista[playerid][4] = ORG_CAT_NEUTRAS;
	strcat(SG, "{ffffff}Todas\n");
	Lista[playerid][5] = ORG_CAT_TODAS;

	ShowPlayerDialog(playerid, DIALOG_ORGS_CATEGORIA, DIALOG_STYLE_LIST, "Organizacoes do Servidor", SG, "Abrir", "Fechar");
	return 1;
}

stock mostrar_orgs_categoria(playerid, categoria)
{
	new sss[300];
	new cont;
	new dataa[50];
	new c;
	new membs;

	SG[0] = EOS;
	strcat(SG, "ID\tNome - Tipo\tOn - Lider\tLideranca\n");
	zerar_lista(playerid);

	foreach(new a:Iter_Orgs)
	{
		if(cont >= MAX_LISTA || cont > 50) break;
		if(org_na_categoria(a, categoria))
		{
			c = Org[a][o_Membros][0];
			membs = membros_on(a);
			if(c != -1)
			{
				new player = ContaOnline(c);
				if(Online(player)) format(dataa, 50, "%02d/%02d/%02d - %02d:%02d", Conta[player][c_Dia], Conta[player][c_Mes], Conta[player][c_Ano], Conta[player][c_Hora], Conta[player][c_Minuto]);
				else format(dataa, 50, "%02d/%02d/%02d - %02d:%02d", GetContaInt(c, "c_Dia"), GetContaInt(c, "c_Mes"), GetContaInt(c, "c_Ano"), GetContaInt(c, "c_Hora"), GetContaInt(c, "c_Minuto"));
				format(sss, 300, "{EEE8AA}%d\t{%06x}%s - {a1a1a1}%s\t[%d] - {00ffff}%s\t{ffffff}%s\n", a, CorOrg(a) >>> 8, NomeOrg(a), tipo_org[Org[a][o_Tipo]], membs, NomeConta(c), dataa);
			}
			else
			{
				format(dataa, 50, "00/00/00 - 00:00");
				format(sss, 300, "{EEE8AA}%d\t{%06x}%s - {a1a1a1}%s\t[%d] - {a1a1a1}%s\t{a1a1a1}%s\n", a, CorOrg(a) >>> 8, NomeOrg(a), tipo_org[Org[a][o_Tipo]], membs, NomeConta(c), dataa);
			}
			strcat(SG, sss);
			Lista[playerid][cont] = a;
			cont ++;
		}
	}

	if(cont == 0)
	{
		strcat(SG, "{a1a1a1}-\tNenhuma organizacao nesta categoria\t-\t-\n");
	}

	format(sss, 300, "{ffffff}%s {ffff00}[{ffffff}%d{ffff00}]", nome_categoria_org(categoria), cont);
	ShowPlayerDialog(playerid, DIALOG_ORGS, DIALOG_STYLE_TABLIST_HEADERS, sss, SG, "Localizar", "Voltar");
	return 1;
}

stock DestroyVehicle_(vee)
{
	if(vee != -1 && vee != INVALID_VEHICLE_ID)
	{
	    KillTimer(timer_veiculo[vee]);
	    Iter_Remove(Vehicles, vee);
	    DestroyVehicle(vee);
	}
}

stock CreateVehicle_(tipe, Float:xx, Float:yy, Float:zz, Float:aa, cor1, cor2, resp, siren=0)
{
	new vee;
    vee = CreateVehicle(tipe, xx, yy, zz, aa, cor1, cor2, resp, siren);
    if(vee != INVALID_VEHICLE_ID)
    {
        Iter_Add(Vehicles, vee);
        ir_garagem[vee] = 1;
		objetos_do_veiculo(vee);
		OnVehicleSpawn(vee);
    }
	return vee;
}

stock fabricacao(playerid, con=-1)
{
	new sss[200];
	new mun = GetPVarInt(playerid, "municao");
	new arma = GetPVarInt(playerid, "arma");
	SG[0] = EOS;
	if(con == -1)
	{
		strcat(SG, "Colete\n");
		strcat(SG, "Municoes\n");
		strcat(SG, "Armas\n");
		format(sss, 200, "Fabricacao de Armamentos");
		ShowPlayerDialog(playerid, DIALOG_FABRICACAO, DIALOG_STYLE_LIST, sss, SG, "Continuar", "Fechar");
	}

	// colete //
	if(con == 0)
	{
	    strcat(SG, "Material\tUnidades\n");
	    for(new a; a<sizeof materiais; a++) format(sss, 200, "{ffffff}%s\t{a1a1a1}%s\n", materiais[a], ConvertMoney(coletes_org[0][a+1])), strcat(SG, sss);
		format(sss, 200, "{00ffff}Producao\t{a1a1a1}%s\n", ConvertMoney(coletes_org[0][6]) );
		strcat(SG, sss);
		format(sss, 200, "{ffffff}Fabricacao: {ffff00}Colete");
		ShowPlayerDialog(playerid, DIALOG_FABRICACAO1, DIALOG_STYLE_TABLIST_HEADERS, sss, SG, "Continuar", "Fechar");
        SetPVarInt(playerid, "opcao", con);
	}

	// municoes //
	if(con == 1)
	{
	    strcat(SG, "Material\tUnidades\n");
        for(new a; a<sizeof materiais; a++) format(sss, 200, "{ffffff}%s\t{a1a1a1}%s\n", materiais[a], ConvertMoney(municoes_org[mun][a+1])), strcat(SG, sss);
		format(sss, 200, "{00ffff}Producao\t{a1a1a1}%s\n", ConvertMoney(municoes_org[mun][6]));
		strcat(SG, sss);
		format(sss, 200, "{ffffff}Fabricacao: {ffff00}Caixa de '%s'", nome_municao(mun));
		ShowPlayerDialog(playerid, DIALOG_FABRICACAO2, DIALOG_STYLE_TABLIST_HEADERS, sss, SG, "Continuar", "Fechar");
        SetPVarInt(playerid, "opcao", con);
	}

	// armas //
	if(con == 2)
	{
	    strcat(SG, "Material\tUnidades\n");
        for(new a; a<sizeof materiais; a++) format(sss, 200, "{ffffff}%s\t{a1a1a1}%s\n", materiais[a], ConvertMoney(armas_org[arma][a+1])), strcat(SG, sss);
		format(sss, 200, "{00ffff}Producao\t{a1a1a1}%s\n", ConvertMoney(armas_org[arma][6]));
		strcat(SG, sss);
		format(sss, 200, "{ffffff}Fabricacao: {ffff00}Caixa de '%s'", nome_arma(armas_org[arma][0]));
		ShowPlayerDialog(playerid, DIALOG_FABRICACAO3, DIALOG_STYLE_TABLIST_HEADERS, sss, SG, "Continuar", "Fechar");
        SetPVarInt(playerid, "opcao", con);
	}

	// escolher municao //
	if(con == 3)
	{
	    for(new a; a<sizeof municoes_org; a++) format(sss, 200, "%s\n", nome_municao(a)), strcat(SG, sss);
		format(sss, 200, "{ffff00}Caixa de 'Municao'");
		ShowPlayerDialog(playerid, DIALOG_FABRICACAO4, DIALOG_STYLE_LIST, sss, SG, "Continuar", "Fechar");
	}

	// escolher arma //
	if(con == 4)
	{
	    for(new a; a<sizeof armas_org; a++) format(sss, 200, "%s\n", nome_arma(armas_org[a][0])), strcat(SG, sss);
		format(sss, 200, "{ffff00}Caixa de 'Arma'");
		ShowPlayerDialog(playerid, DIALOG_FABRICACAO5, DIALOG_STYLE_LIST, sss, SG, "Continuar", "Fechar");
	}
}

