	PlayerTextDrawDestroy(playerid, HudInfoBox[playerid]);
	PlayerTextDrawDestroy(playerid, HudInfoIDF[playerid]);
	PlayerTextDrawDestroy(playerid, HudInfoNIVEL[playerid]);
	PlayerTextDrawDestroy(playerid, HudInfoXP[playerid]);
	for(new a; a<sizeof T_Loop_Lento_p[]; a++) PlayerTextDrawDestroy(playerid, T_Loop_Lento_p[playerid][a]);
	Velo_DestroyTDs(playerid);
	PlayerTextDrawDestroy(playerid, PainelOrgsP[playerid][0]);
	return 1;
}

public OnPlayerStaminaOver(playerid)
{
	SetPlayerExhausted(playerid, true);
	return 1;
}

stock plataforma(playerid)
{
	new sss[100];
	if(IsPlayerAndroid(playerid)) format(sss, 100, "Android");
	else format(sss, 100, "PC");
	return sss;
}

stock GivePlayerWeapon_(playerid, arma, mun)
{
	if(IsPlayerConnected(playerid))
	{
	    if(mun > 1000) mun = 1000;
	    GivePlayerWeapon(playerid, arma, mun);
	    if(mostrando_armas[playerid] == 1)
	    {
	        KillTimer(timer_atualizar_arma[playerid]);
	        timer_atualizar_arma[playerid] = SetTimerEx("atualizar_arma", 600, false, "d", playerid);
	    }
	}
}

BCG:: Mala_Check(playerid, playerid2)
{// checar mala da viatura
	new Float:var0[3];
	GetPlayerPos(playerid, var0[0], var0[1], var0[2]);
    SetPlayerInterior(playerid2, 0);
    SetPlayerVirtualWorld(playerid2, 0);
	SetPlayerPos(playerid2, 0.1 + var0[0], 0.1 + var0[1], var0[2]);
    SSM(playerid2, -1, "{00FF00}[FUNCAO MALA] {BEBEBE}Voce foi retidado do Porta Malas.");
    SSM(playerid, -1, "{00FF00}[FUNCAO MALA] {BEBEBE}Player Retirado do Porta Malas.");
    SetTimerEx("DCANIM", 500, false, "d", playerid2);
	return 1;
}

BCG:: AcertarPayDay(){
	return PayDay(1);
}

BCG:: Tempo()
{
    new HoraRoYal, MinutoRoYal, SegundoRoYal, Dia, Mes, Ano;
    gettime(HoraRoYal, MinutoRoYal, SegundoRoYal);
    getdate(Ano, Mes, Dia);
    gettime(HORA, MINUTO, SEGUNDO);
	getdate(ANO, MES, DIA);

	if(MINUTO == 0 && SEGUNDO == 0 && HORA == 0) MeiaNoite();
	// dinamites //
	for(new d; d<MAX_EXPLOSIVOS; d++)
	{
	    if(Explosivo[d][explosivo_Existe] == 1)
	    {
	        if(Explosivo[d][explosivo_Tempo] > 0)
	        {
	            Explosivo[d][explosivo_Tempo] --;
	            texto_explosivo(d);
	            if(Explosivo[d][explosivo_Tempo] == 0)
	            {
	                explodir_dinamite(d);
	                destruir_dinamite(d);
	            }
	        }
	    }
	}

	// verificar voip //
	if(tempo_verificar_voip == 0)
	{
	    new file[80];
	    format(file,80, "FS_DO_VOIP.txt");
	    tempo_verificar_voip = 30;
	    if(DOF2_FileExists(file))
	    {
	        if(DOF2_GetInt(file, "VOIP_ATUALIZAR") < (gettime()-15))
	        {
	            // voip caiu //
	            tempo_verificar_voip = 60;
	            DOF2_SetString(file, "VOIP_CAIU", f("[ %02d/%02d/%04d - %02d:%02d:%02d ]", DIA, MES, ANO, HORA, MINUTO, SEGUNDO));
				DOF2_SetInt(file, "VOIP_RECARREGADO", DOF2_GetInt(file, "VOIP_RECARREGADO")+1);
				DOF2_SaveFile();
			}
	    }
	}
	else tempo_verificar_voip --;

	// territorios //
	new cont;
	for(new a; a<MAX_TERRITORIOS; a++)
	{
		if(TR[a][tr_TempoGuerra] > 0)
		{
		foreach(new o:Iter_Orgs)
		    {
		        if(OrgTerritorio(o, a))
		        {
	                cont = 0;
		            foreach(new p:Player) if(OrgPlayer(p) == o) if(EmTerritorio(p, a)) if(!Player_AFK(p)) if(Conta[p][c_Morto] == 0) cont ++;
	                if(cont == 0)
					{
						if(TR[a][tr_OrgPontos][o] > 0) TR[a][tr_OrgPontos][o] --;
					}
	                else TR[a][tr_OrgPontos][o] += cont;
		        }
		    }

			TR[a][tr_TempoGuerra] --;
			if(TR[a][tr_TempoGuerra] == 0)
			{
			    finalizar_guerra(a);
			}
		}
		if(TR[a][tr_TempoUltimaGuerra] > 0) TR[a][tr_TempoUltimaGuerra] --;
	}

	// portoes vencidos //
	new hra = gettime();
	foreach(new p:Iter_Portoes)
	{
	    if(Portao[p][p_Existe] == 1)
	    {
	        if(Portao[p][p_Dono] != -1)
	        {
	            if(Portao[p][p_Tempo] != 0 && Portao[p][p_Tempo] < hra)
	            {
	                new c = Portao[p][p_Dono];
	                new sss[300];
					destruir_portao(p);
					format(sss, 300, "O seu Portao [%d] foi destruido por vencimento !", p);
					msc(c, 2, sss);
	            }
	        }
		}
	}

	// clima //
	if(timer_clima == -1) clima_server(-100);
	else
	{
	    if(timer_clima == 0) clima_server(-1);
	    else timer_clima --;
	    temperatura_server();
	    format(str_clima, 300, "~b~~h~%d ~h~c~n~~n~~n~~w~CLIMA_ATUAL~n~~y~~h~%s~n~~n~~n~PREVISAO~n~~r~~h~%s~n~", temperatura, Clima[clima_atual][clima_Nome], Clima[proximo_clima][clima_Nome]);
		TextDrawSetString(T_Celular_Clima[10], str_clima);
	}

	// blaze //
	if(blaze_status == -100) blaze_iniciar();
	else if(blaze_status > -1)
	{
	    blaze_mudar = 1;
	}

	// carregar servidor //
	if(carregamento_rapido == 0)
	{
		carregar_servidor();
	}

	// relogio //
    new str_data[32], str_hora[32];
    format(str_data, 32, "%02d/%02d/%04d", DIA, MES, ANO);
    format(str_hora, 32, "%02d:%02d:%02d", HORA, MINUTO, SEGUNDO);
    foreach(new p:Player) if(Online(p) && id[p] != -1 && mostrando_hud[p] == 1)
    {
        PlayerTextDrawSetString(p, HudFomeSedeP[p][0], str_data);
        PlayerTextDrawSetString(p, HudFomeSedeP[p][1], str_hora);
    }

	// setar tempo certo //
	new mudar_hora;
    switch(HORA)
	{
		case 0..4: if(hora_certa != 3) hora_certa = 3, mudar_hora = 1;
		case 5..10: if(hora_certa != 7) hora_certa = 7, mudar_hora = 1;
		case 11..15: if(hora_certa != 12) hora_certa = 12, mudar_hora = 1;
		case 16..18: if(hora_certa != 20) hora_certa = 20, mudar_hora = 1;
		case 19..23: if(hora_certa != 0) hora_certa = 0, mudar_hora = 1;
	}
	if(munito_certo != MINUTO)
	{
	    munito_certo = MINUTO;
	    mudar_hora = 1;
	}
	if(mudar_hora == 1)
	{
	    foreach(new p:Player)
	    {
	        if(Online(p))
	        {
	            if(id[p] != -1)
	            {
	                if(travar_hora[p] == -1) SetPlayerTime(p, hora_certa, munito_certo);
	            }
	        }
	    }
	}

	// colocar veiculos da conce a posicao deles //
	flood_spawn_conce --;
	if(flood_spawn_conce <= 0)
	{
	    flood_spawn_conce = 120;
		for(new i; i<MAX_CONCE; i++)
		{
		    if(Conce[i][con_Existe] == 1)
		    {
		        for(new a; a<MAX_VEICULOS_CONCE; a++)
		        {
		            if(Conce[i][con_v_Existe][a] == 1)
		            {
		                if(GetVehicleModel(Conce[i][con_v_Veiculo][a]) != 0)
				  	{
				        new veh_info = Info_Veiculo[Conce[i][con_v_Veiculo][a]];
				        if(veh_info != -1 && Veiculo[veh_info][v_Conce] == 2) continue;
				        if(VeiculoDesocupado(Conce[i][con_v_Veiculo][a]))
				        {
								SetVehicleZAngle(Conce[i][con_v_Veiculo][a], Conce[i][con_v_A][a]);
								new Float:moto_z = Conce[i][con_v_Z][a];
								if(VeiculoMoto(Conce[i][con_v_Veiculo][a])) moto_z -= 0.5;
								SetVehiclePos(Conce[i][con_v_Veiculo][a], Conce[i][con_v_X][a], Conce[i][con_v_Y][a], moto_z);
				        }
		                }
		            }
		        }
		    }
		}
	}


	// maquinas de equipamentos //
	foreach(new m:Iter_Maquinas)
	{
	    if(Maquina[m][m_Existe] == 1)
	    {
			for(new a; a<10; a++)
			{
			    if(Maquina[m][m_Status][a] == 1)
				{
				if(Maquina[m][m_Tempo][a] > 0)
				{
				    Maquina[m][m_Tempo][a] --;
				    if(Maquina[m][m_Tempo][a] == 0)
					{
				        Maquina[m][m_Status][a] = 2;
				        salvar_maquina(m);
				        new o = Maquina[m][m_Org];
							mso(o, "[MAQUINA] Uma fabricacao acabou de ficar pronta !");
				    }
				}
			    }
			}
		}
	}

	// entregas casas //
	foreach(new c:Iter_Casas)
	{
	    if(Casa[c][casa_Existe] == 1)
	    {
	        if(Compras[c][com_Existe] == 1)
	        {
	            if(Compras[c][com_Tempo] > 0)
	            {
	                Compras[c][com_Tempo] --;
	                if(Compras[c][com_Tempo] == 0)
	                {
	                    entregar_moveis(c);
					}
	            }
	        }
	    }
	}


	// empresas - concerto cofre //
 	lucro_empresa ++;
	foreach(new cc:Iter_Empresas)
    {
        if(Empresa[cc][em_Existe] == 1)
        {

            // lucro //
            if(lucro_empresa == 1)
            {
                if(Empresa[cc][em_Produtos] > 0)
                {
                    Empresa[cc][em_Produtos] --;
                    Empresa[cc][em_Cofre] += LUCRO_PRODUTO;
                    salvar_empresa(cc);
                }
            }

            if(Cofre[cc][cofre_Status] == 1)
            {
	            if(Cofre[cc][cofre_Tempo] < gettime())
	            {
                    Cofre[cc][cofre_Tempo] = 0;
                    Cofre[cc][cofre_Status] = 0;
                    atualizar_cofre(cc, 1);
                    salvar_empresa(cc);
	            }
            }
            if(Cofre[cc][cofre_Status2] == 1)
            {
	            if(Cofre[cc][cofre_Tempo2] < gettime())
	            {
                    Cofre[cc][cofre_Tempo2] = 0;
                    Cofre[cc][cofre_Status2] = 0;
                    atualizar_cofre(cc, 2);
                    salvar_empresa(cc);
	            }
            }
        }
    }
    if(lucro_empresa == TEMPO_LUCRO_EMPRESA) lucro_empresa = 0;

	// verificar gmx automatico //
	if(MINUTO == 0 && SEGUNDO == 0 && HORA == 0) mst(2, "[GMX] Faltam 30 minutos para o GMX automatico do servidor.");
	if(MINUTO == 20 && SEGUNDO == 0 && HORA == 0) mst(2, "[GMX] Faltam 10 minutos para o GMX automatico do servidor.");
	if(MINUTO == 25 && SEGUNDO == 0 && HORA == 0) mst(2, "[GMX] Faltam 5 minutos para o GMX automatico do servidor.");
	if(MINUTO == 29 && SEGUNDO == 0 && HORA == 0) mst(2, "[GMX] Falta 1 minuto para o GMX automatico do servidor.");
	/*if(MINUTO == 30 && SEGUNDO == 0 && HORA == 0)
	{
	    if(GMX == 0)
	    {
			gmx();
	    }
	}*/
	switch(HoraRoYal)
    {// definindo funcao
        case 0: SetWorldTime(0);
        case 1: SetWorldTime(0);
        case 2: SetWorldTime(1);
        case 3: SetWorldTime(2);
        case 4: SetWorldTime(4);
        case 5: SetWorldTime(5);
        case 6: SetWorldTime(6);
        case 7: SetWorldTime(7);
        case 8: SetWorldTime(8);
        case 9: SetWorldTime(9);
        case 10: SetWorldTime(10);
        case 11: SetWorldTime(11);
        case 12: SetWorldTime(12);
        case 13: SetWorldTime(13);
        case 14: SetWorldTime(14);
        case 15: SetWorldTime(15);
        case 16: SetWorldTime(16);
        case 17: SetWorldTime(20);
        case 18: SetWorldTime(21);
        case 19: SetWorldTime(0);
        case 20: SetWorldTime(0);
        case 21: SetWorldTime(0);
        case 22: SetWorldTime(0);
        case 23: SetWorldTime(0);
    }
	// relogio //
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(logado[i] == 1){
	    format(stttrlo, sizeof(stttrlo), "IDF: %d", id[i]);
	    PlayerTextDrawSetString(i, HudInfoIDF[i], stttrlo);
	    format(stttrlo, sizeof(stttrlo), "NIVEL: %d", Conta[i][c_Nivel]);
	    PlayerTextDrawSetString(i, HudInfoNIVEL[i], stttrlo);
		format(stttrlo, sizeof(stttrlo), "XP: %d/%d", Conta[i][c_XP], Conta[i][c_Nivel]*12);
		PlayerTextDrawSetString(i, HudInfoXP[i], stttrlo);
		}
    }
    return 1;
}
BCG:: atualizar_arma(playerid)
{
    if(IsPlayerConnected(playerid))
	{
	    if(mostrando_armas[playerid] == 1)
		{
		    mostrar_armas_novo(playerid);
		}
	}
}

stock NickBot(playerid)
{
	for(new a; a<sizeof NickB; a++)
	{
		if(Comparar(NickB[a], Nome(playerid)))
		{
            return 1;
		}
	}
	return 0;
}

BCG:: AttArrastar2(playerid)
{
	new Float:X123, Float:Y123, Float:Z123;
	GetPlayerPos(playerid, X123, Y123, Z123);
	for(new i = 0; i < MAX_PLAYERS; i++)
	{
		if(i == ArrastadoID[playerid])
	  	{
	 		GameTextForPlayer(i, "~r~Arrastado!", 2000, 3);
			SetPlayerPos(i, X123, Y123, Z123+1);
			ApplyAnimation(i, "DEALER", "DEALER_IDLE", 4.0, 0, 1, 1, 1, -1);
		}
	}
	return 1;
}

public OnPlayerSpawn(playerid)
{
	
	// dbug skin //
	SetPlayerSkinFix(playerid, skin_player[playerid]);	
	ArrastadoID[playerid] = -1;
	AttArrastar[playerid] = -1;
	ArrastadoTT[playerid] = -1;
    // morreu pelo jogo //
	if(morreu_agora[playerid] == 1)
	{
	    morreu_agora[playerid] = 0;
	    SetPlayerSkinFix(playerid, skin_morreu[playerid]);
	    SetPlayerPos_(playerid, pos_morreu[playerid][0], pos_morreu[playerid][1], pos_morreu[playerid][2]);
		SetPlayerFacingAngle(playerid, pos_morreu[playerid][3]);
		SetPlayerInterior(playerid, interior_morreu[playerid]);
		SetPlayerVirtualWorld_(playerid, mundo_morreu[playerid]);
		for(new a; a<13; a++) GivePlayerWeapon_(playerid, armas_morreu[playerid][a][0], armas_morreu[playerid][a][1]);
		SetPlayerArmedWeapon(playerid, arma_morreu[playerid]);
		for(new a; a<10; a++) RemovePlayerAttachedObject(playerid, a);
		acessorios_player(playerid);
	    return 1;
	}

	// mostrar tela de login //
	if(mostrartela[playerid] == 1)
	{
	    mostrartela[playerid] = 0;
	    if(logado[playerid] == 0)
	    {
			if(NickBot(playerid))
			{
				SetPlayerScore(playerid, 4+(random(3)));
			    return 1;
			}

	        // android //
			MS(playerid, 2, f("Plataforma reconhecida '%s', se o reconhecimento falhou,~n~use /plataforma.",  plataforma(playerid)));
			
	        // timer do player //
	        MostrarLogin(playerid);
			// BCG FIX: manter o jogador spawnado em coordenada valida durante o login.
			TogglePlayerControllable(playerid, false);
		    tempo_login[playerid] = 0;
		    SetPlayerWeather(playerid, 1);
		    SetPlayerTime(playerid, hora_certa, 0);
	        PlayAudioStreamForPlayer(playerid, som_login);
	        ouvindo[playerid] = 1;
	        GZ_MostrarGzPlayer(playerid, GZ_PRETA);
	        new nick_logado[MAX_PLAYER_NAME];
			GetPlayerName(playerid, nick_logado, MAX_PLAYER_NAME);
		    SetPlayerInterior(playerid, 0);
		    SetPlayerVirtualWorld_(playerid, MAX_PLAYERS+1);
	        SetarNickPlayer(playerid);
	        InterpolateCameraPos(playerid, 1162.228881, -1503.522216, 87.321685, 1437.002929, -1300.794433, 92.657562, 56000);
			InterpolateCameraLookAt(playerid, 1166.235595, -1500.532104, 87.399810, 1441.025878, -1297.826293, 92.735687, 47000);
	        GZ_MostrarGzPlayer(playerid, GZ_PRETA);
	        SSM(playerid, 0x00000000, "");
			SetPlayerWeather(playerid, 1);
			SetPlayerTime(playerid, hora_certa, 0);
            // BCG UI/CEF possui o proprio foco de entrada; nao selecionar TextDraw no login.
            CancelSelectTextDraw(playerid);
            return 1;
	    }
    }

	// desbugar player //
	if(player_algemado[playerid] == 1) SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CUFFED);
	if(player_amarrado[playerid] == 1) SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CUFFED);
	if(player_rendido[playerid] == 1) SetPlayerSpecialAction(playerid, 10);
	return 1;
}

stock PlayerSpawn(playerid)
{

	// criacao de conta //
	if(logado[playerid] == 999)
	{
	    criar_conta_lobby(playerid);
	    return 1;
	}

    // esconder que ta carregando conta //
	for(new a; a<4; a++) TextDrawHideForPlayer(playerid, T_CarregandoConta[a]);

    // skills das armas //
	SetPlayerSkillLevel(playerid, 0, 1);
	SetPlayerSkillLevel(playerid, 1, 999);
	SetPlayerSkillLevel(playerid, 2, 999);
	SetPlayerSkillLevel(playerid, 3, 999);
	SetPlayerSkillLevel(playerid, 4, 1);
	SetPlayerSkillLevel(playerid, 5, 999);
	SetPlayerSkillLevel(playerid, 6, 1);
	SetPlayerSkillLevel(playerid, 7, 999);
	SetPlayerSkillLevel(playerid, 8, 999);
	SetPlayerSkillLevel(playerid, 9, 999);
	SetPlayerSkillLevel(playerid, 10, 999);

	// cinuca //
	if(player_cinuca[playerid] != -1) acabar_partida_cinuca(player_cinuca[playerid]);

    // fumando //
    fumando[playerid] = 0;

    // nome player //
    Attach3DTextLabelToPlayer(Nome_Player[playerid], playerid, 0, 0, 0.6);

    // jetpack //
	player_jetpack[playerid] = 0;
	ClearAnimations(playerid, 1);
    SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);

	// cancelar acoes no spawn //
	KillTimer(timer_spawn_player[playerid]);
    if(Barra[playerid][b_Acao] != 0) Carregando(playerid, 2);
    if(dbug_morreu[playerid] == 1) return 1;
    ResetPlayerWeapons_(playerid);
    Arma_Player[playerid] = -1;

    // RESETAR OS DANOS //
    resetar_dano(playerid);

    // esconder info do hospital //
    if(mostrando_hospital[playerid] == 1)
    {
        mostrando_hospital[playerid] = 0;
		TextDrawHideForPlayer(playerid, T_Hospital[0]);
		PlayerTextDrawHide(playerid, T_Hospital_p[playerid][0]);
	}

	// esconder info Cadeia admin //
    if(mostrando_cadeia_staf[playerid] == 1)
    {
        mostrando_cadeia_staf[playerid] = 0;
		TextDrawHideForPlayer(playerid, T_Cadeia_Staff[0]);
		TextDrawHideForPlayer(playerid, T_Cadeia_Staff[1]);
		TextDrawHideForPlayer(playerid, T_Cadeia_Staff[2]);
		TextDrawHideForPlayer(playerid, T_Cadeia_Staff[3]);
		TextDrawHideForPlayer(playerid, T_Cadeia_Staff[4]);
		PlayerTextDrawHide(playerid, T_Cadeia_Staff_p[playerid][0]);
		PlayerTextDrawHide(playerid, T_Cadeia_Staff_p[playerid][1]);
	}

	// esconder info cadeia //
	if(mostrando_cadeia[playerid] == 1)
    {
        mostrando_cadeia[playerid] = 0;
        TextDrawHideForPlayer(playerid, T_Cadeia[0]);
		TextDrawHideForPlayer(playerid, T_Cadeia[1]);
        PlayerTextDrawHide(playerid, T_Cadeia_p[playerid][0]);
    }

    // MOSTRAR RODAPE //
    for(new dd; dd<sizeof HudFomeSede; dd++) TextDrawHideForPlayer(playerid, HudFomeSede[dd]);
	/*TextDrawHideForPlayer(playerid, T_Rodape[0]);
	TextDrawHideForPlayer(playerid, T_Rodape[1]);
	TextDrawHideForPlayer(playerid, T_Rodape[2]);*/

	// parar de dancar //
	ID_Dancando[playerid] = -1;
	comprando_moveis[playerid] = -1;

    // se tiver com algo na mao excluir //
    jogar(playerid);

    // quebrando arvore ou pedra //
    if(craft_tipo[playerid] != 0)
    {
        craft_tipo[playerid] = 0;
        craft_player[playerid] = 0;
        terminar_craft(playerid);
    }

	// sistema de CELULAR E Uber //
	if(celular_aberto[playerid] != -1) fechar_celular(playerid, 1);
    cancelar_uber(playerid);
    parar_de_ouvir(playerid);

    //remover items no corpo //
	for(new a; a<10; a++) RemovePlayerAttachedObject(playerid, a);

	// se tiver logado //
	new c = id[playerid];
	if(id[playerid] == -1)
	{
	    // tirar de modo admin //
	    ModoAdmin[playerid] = 0;

	    // esconder hud //
	    esconder_hud(playerid);
        esconder_logomarca(playerid);
	    logado_full[playerid] = 0;

	    // esconder mapa //
	    GZ_MostrarGzPlayer(playerid, GZ_PRETA);

	    // sentar player no lobby //
	    new ccc = contas[playerid];
	    SetPlayerSkinFix(playerid,  GetContaInt(ccc, "c_Skin"));
	    acessorios_player(playerid);
	    sentar_player(playerid);
        mostrar_lobby(playerid);
		SelectTextDraw(playerid, 0xFFDC33ff);
		SetPlayerWeather(playerid, 1);
		SetPlayerTime(playerid, hora_certa, 0);

		// criou a conta agr //
		if(mostrar_info_conta_lobby[playerid] == 1)
		{
		    mostrar_info_conta_lobby[playerid] = 0;
      		ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}_", sss_cc[playerid], "Ok", "Fechar");
		}

		// esconder chat no lobby //
		SSM(playerid, -1, "");
	    return 1;
	}

	// setar clima //
	SetPlayerWeather(playerid, Clima[clima_atual][clima_ID]);
	if(travar_hora[playerid] == -1) SetPlayerTime(playerid, hora_certa, munito_certo);
	else SetPlayerTime(playerid, travar_hora[playerid], 0);

	// parar musica //
	StopAudioStreamForPlayer(playerid);

	// MOSTRAR DATA E HORA //
	mostrar_hud(playerid);

	/*// MOSTRAR RODAPE //
	TextDrawShowForPlayer(playerid, T_Rodape[0]);
	TextDrawShowForPlayer(playerid, T_Rodape[1]);
	TextDrawShowForPlayer(playerid, T_Rodape[2]); */

	// setar no ultimo spawn do player //
	GZ_EsconderGzPlayer(playerid, GZ_PRETA);

	// setar acessorios //
	for(new a; a<10; a++) RemovePlayerAttachedObject(playerid, a);
	acessorios_player(playerid);

	// arena //
	if(player_arena[playerid] == 1)
    {
		player_arena[playerid] = 1;
	    new rand = random(sizeof pos_arena);
		SetPlayerPos_(playerid, pos_arena[rand][0], pos_arena[rand][1], pos_arena[rand][2]);
		SetarVida(playerid, 100);
		SetarColete(playerid, 100);
		ResetPlayerWeapons_(playerid);
		GivePlayerWeapon_(playerid, 24, 9999);
		SetPlayerArmedWeapon(playerid, 24);
		SetPlayerInterior(playerid, 10);
		SetPlayerVirtualWorld_(playerid, 5);
	}
	else
	{
	    KillTimer(verificar_armas[playerid]);
		KillTimer(timer_uppp[playerid]);
	    verificar_armas[playerid] = SetTimerEx("VerificarArmas", 2500, true, "d", playerid);
	    timer_uppp[playerid] = SetTimerEx("PlayerUppp", 500, true, "d", playerid);

	    // logou e carregar posicao //
	    verificar_membro_org(c);
	    if(logou_agora[playerid] == 1)
	    {
	        // casa //
	        limpar_chat[playerid] = 1;
		    new local2 = Conta[playerid][c_LocalID];
		    new local;

		    local = Conta[playerid][c_Local];
			if(local == 2)
			{
			    if(local2 != -1)
				{
				if(Casa[local2][casa_Existe] == 1)
				{
				    if(Casa[local2][casa_Dono] == c)
					{
				        SetPlayerPos_(playerid, Casa[local2][casa_X1]+0.1, Casa[local2][casa_Y1]+0.1, Casa[local2][casa_Z1]+0.1);
							SetPlayerInterior(playerid, 0);
							SetPlayerVirtualWorld_(playerid, 0);
				    }
				    else Conta[playerid][c_Local] = 0;
				}
				else Conta[playerid][c_Local] = 0;
			    }
			    else Conta[playerid][c_Local] = 0;
			}

			// org //
			local = Conta[playerid][c_Local];
			if(local == 1)
			{
			    new o = local2;
			    if(o != -1)
				{
				if(Org[o][o_Existe] == 1)
				{
				    if(OrgPlayer(playerid) == o)
					{
					    SetPlayerInterior(playerid, 0);
							SetPlayerVirtualWorld_(playerid, 0);
							SetPlayerPos_(playerid, Org[o][o_X]+0.1, Org[o][o_Y]+0.1, Org[o][o_Z]+0.1);
						}
						else Conta[playerid][c_Local] = 0;
	   				}
				   	else Conta[playerid][c_Local] = 0;
			    }
			    else Conta[playerid][c_Local] = 0;
			}

			// respaw civil //
			local = Conta[playerid][c_Local];
			if(local == 0)
			{
				// colocar em local inicial //
			if(Conta[playerid][c_Cidade] == 0)
			{
			    // Zona Leste //
				SetPlayerInterior(playerid, 0);
				SetPlayerVirtualWorld_(playerid, 0);
				SetPlayerPos_(playerid, 1154.2063,-1767.5226,16.5938);
				SetPlayerFacingAngle(playerid, 0);
			}

			if(Conta[playerid][c_Cidade] == 1)
			{
			    // Zona Sul //
				SetPlayerInterior(playerid, 0);
				SetPlayerVirtualWorld_(playerid, 0);
				SetPlayerPos_(playerid, -1901.2472,487.3093,35.1719);
			}

			if(Conta[playerid][c_Cidade] == 2)
			{
			    // Zona Oeste //
				SetPlayerInterior(playerid, 0);
				SetPlayerVirtualWorld_(playerid, 0);
				SetPlayerPos_(playerid, 2170.8716,1682.1053,10.8203);
			}
			}

			// BCG FIX: no primeiro spawn apos login, NAO restaurar c_X/c_Y/c_Z.
			// O local civil/casa/org definido acima e a fonte segura do spawn inicial.
			SetPlayerInterior(playerid, GetPlayerInterior(playerid));
			TogglePlayerSpectating(playerid, false);
			SetCameraBehindPlayer(playerid);
			TogglePlayerControllable(playerid, true);

	        logou_agora[playerid] = 0;
		    SSM(playerid, -1, "");
			carregar_chat(playerid, c);
			SSM(playerid, -1, "");
			SSM(playerid, -1, "{800080}FS >> {FFFFFF}Nossos comandos de ajuda estao em: /comandos ou /ajuda.");
			SSM(playerid, -1, "{800080}FS >> {BEBEBE}Em caso de panes, use: /atendimento e espere uma resposta..");
			SSM(playerid, -1, "{800080}@CidadeGrandeRP - Des de ja seja muito bem vindo ao servidor, esperamos que tenha uma otima experiencia!");
			SSM(playerid, -1, "");
			if(VipPlayer(playerid) == 3) mostrar_online(playerid, 1);
	    }
	    else
	    {
	        if(floatabs(Conta[playerid][c_X]) < 20000.0 && floatabs(Conta[playerid][c_Y]) < 20000.0 && Conta[playerid][c_Z] > -100.0 && Conta[playerid][c_Z] < 1500.0 && (Conta[playerid][c_X] != 0.0 || Conta[playerid][c_Y] != 0.0 || Conta[playerid][c_Z] != 0.0))
			{
		        // spawnou dentro do jogo - posicao salva validada //
		        SetPlayerInterior(playerid, Conta[playerid][c_Interior]);
				SetPlayerVirtualWorld_(playerid, Conta[playerid][c_Mundo]);
				SetPlayerPos_(playerid, Conta[playerid][c_X]+0.1,Conta[playerid][c_Y]+0.1,Conta[playerid][c_Z]+0.1);
				SetPlayerFacingAngle(playerid, Conta[playerid][c_A]);
			}
			else
			{
			    // casa //
			    new local2 = Conta[playerid][c_LocalID];
			    new local;

			    local = Conta[playerid][c_Local];
				if(local == 2)
				{
				    if(local2 != -1)
					{
					if(Casa[local2][casa_Existe] == 1)
					{
					    if(Casa[local2][casa_Dono] == c)
						{
					        SetPlayerPos_(playerid, Casa[local2][casa_X1]+0.1, Casa[local2][casa_Y1]+0.1, Casa[local2][casa_Z1]+0.1);
								SetPlayerInterior(playerid, 0);
								SetPlayerVirtualWorld_(playerid, 0);
					    }
					    else Conta[playerid][c_Local] = 0;
					}
					else Conta[playerid][c_Local] = 0;
				    }
				    else Conta[playerid][c_Local] = 0;
				}

				// org //
				local = Conta[playerid][c_Local];
				if(local == 1)
				{
				    new o = local2;
				    if(o != -1)
					{
					if(Org[o][o_Existe] == 1)
					{
					    if(OrgPlayer(playerid) == o)
						{
						    SetPlayerInterior(playerid, 0);
								SetPlayerVirtualWorld_(playerid, 0);
								SetPlayerPos_(playerid, Org[o][o_X]+0.1, Org[o][o_Y]+0.1, Org[o][o_Z]+0.1);
							}
							else Conta[playerid][c_Local] = 0;
		   				}
					   	else Conta[playerid][c_Local] = 0;
				    }
				    else Conta[playerid][c_Local] = 0;
				}

				// respaw civil //
				local = Conta[playerid][c_Local];
				if(local == 0)
				{
					// colocar em local inicial //
				if(Conta[playerid][c_Cidade] == 0)
				{
				    // Zona Leste //
					SetPlayerInterior(playerid, 0);
					SetPlayerVirtualWorld_(playerid, 0);
					SetPlayerPos_(playerid, 1154.2063,-1767.5226,16.5938);
					SetPlayerFacingAngle(playerid, 0);
				}

				if(Conta[playerid][c_Cidade] == 1)
				{
				    // Zona Sul //
					SetPlayerInterior(playerid, 0);
					SetPlayerVirtualWorld_(playerid, 0);
					SetPlayerPos_(playerid, -1901.2472,487.3093,35.1719);
				}

				if(Conta[playerid][c_Cidade] == 2)
				{
				    // Zona Oeste //
					SetPlayerInterior(playerid, 0);
					SetPlayerVirtualWorld_(playerid, 0);
					SetPlayerPos_(playerid, 2170.8716,1682.1053,10.8203);
				}
				}

			}

	   	    ResetPlayerWeapons_(playerid);
		    KillTimer(timer_dar_armas[playerid]);
	    	Arma_Player[playerid] = 0;
		    for(new w; w<13; w++)
		    {
		        if(Conta[playerid][c_Arma][w] != 0)
		        {
		            GivePlayerWeapon_(playerid, Conta[playerid][c_Arma][w], Conta[playerid][c_Municao][w]);
		        }
		    }
		    // setar vida e colete salvo //
		    SetarVida(playerid, Conta[playerid][c_Vida]);
		    SetarColete(playerid, Conta[playerid][c_Colete]);
	    }
	    Congelar(playerid);
		OnPlayerInteriorChange(playerid, GetPlayerInterior(playerid), GetPlayerInterior(playerid));
	}

	// setar informacoes no player //
	SetPlayerSkinFix(playerid, Conta[playerid][c_Skin]);
	SetCameraBehindPlayer(playerid);
	if(Conta[playerid][c_CA_Tempo] > 0) Cadeia_Staff(playerid);
	else if(Conta[playerid][c_Hospital] > 0) Hospital(playerid);
	else if(Conta[playerid][c_Morto] > 0) Morreu(playerid);

	mostrar_hud(playerid);
    mostrar_logomarca(playerid);
	SetPlayerArmedWeapon(playerid, 0);
	Arma_Player[playerid] = -1;

	// estamina //
	SetPlayerStamina(playerid, Conta[playerid][c_Estamina]);
	SetTimerEx("armas_costas", 1500, false, "d", playerid);

	logado_full[playerid] = 1;
	return 1;
}


BCG:: OnPlayerDeath2(playerid, killerid, WEAPON:reason)
{
    if(logado[playerid] == 0) return 1;
    if(JogadorCongelado[playerid] == 1){
        Controle(playerid, 1);
        JogadorCongelado[playerid] = 0;
        KillTimer(TimerFicarParado[playerid]);
    }
    if(BikeAlugada[playerid] == 1)
    {
        BikeAlugada[playerid] = 0;
        DestroyVehicle(VeiculoCivil[playerid]);
    }
    Colocado[playerid] = false;
    // arena //
    if(player_arena[playerid] == 1)
    {
        new rand = random(sizeof pos_arena);
        SetPlayerPos_(playerid, pos_arena[rand][0], pos_arena[rand][1], pos_arena[rand][2]);
		SetarVida(playerid, 100);
		SetarColete(playerid, 100);
		ResetPlayerWeapons_(playerid);
		GivePlayerWeapon_(playerid, 24, 9999);
		SetPlayerArmedWeapon(playerid, 24);
		SetPlayerInterior(playerid, 10);
		SetPlayerVirtualWorld_(playerid, 5);
		ResetPlayerWeapons_(killerid);
		GivePlayerWeapon_(killerid, 24, 9999);
		SetarVida(killerid, 100);
		SetarColete(killerid, 100);
    }
    else
    {
        // lock pick //
        terminar_lockpick(playerid, -1);

	    // jetpack //
		player_jetpack[playerid] = 0;
	    SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);

	    // se tiver dancando //
	    ID_Dancando[playerid] = -1;

	    // cinuca //
		if(player_cinuca[playerid] != -1) acabar_partida_cinuca(player_cinuca[playerid]);

	    // academia //
	    if(academia_player[playerid] != -1)
	    {
	        new i = academia_player[playerid];
	        academia_player[playerid] = -1;
			sair_academia(playerid, i);
	    }

	    // quebrando arvore ou pedra //
	    if(craft_tipo[playerid] != 0)
	    {
	        craft_tipo[playerid] = 0;
	        craft_player[playerid] = 0;
	        terminar_craft(playerid);
	    }

	    // menu aberto //
	    if(mostrando_menu[playerid] == 1) fechar_menu(playerid);

	    // se tiver em uma acao //
	    if(Barra[playerid][b_Acao] != 0) Carregando(playerid, 2);

	    // segurando algo //
	    if(segurando_player[playerid] != -1) largar(playerid);
	    KillTimer(timer_spawn_player[playerid]);

		// sistema de CELULAR E Uber //
		if(celular_aberto[playerid] != -1) fechar_celular(playerid, 1);
	    cancelar_uber(playerid);

        // dar estrelas se derrubar alguem //
	    if(playerid != killerid)
	    {
	        if(!PlayerCop(killerid))
	        {
	            if(Online(killerid))
	            {
	                if(player_arena[killerid] == 0)
	                {
	            		aplicar_su(killerid, -1, 3);
	            	}
	            }
	        }
	    }

	    new g = PegarTerritorio(playerid);
	    if(g == -1) g = PegarTerritorio(killerid);
	    if(g != -1)
	    {
	        if(TR[g][tr_EmGuerra] == 1)
	        {
		        new org1 = OrgPlayer(playerid);
		   		new org2 = OrgPlayer(killerid);
		        if(org1 != -1 && org2 != -1)
		        {
		            if(org1 != org2)
		            {
		                if(OrgTerritorio(org1, g) && OrgTerritorio(org2, g))
		                {
                            TR[g][tr_OrgPontos][org2] += 100;
		                }
		            }
		        }
	        }
	    }

	    // pegar a posicao de onde ele morreu //
	    ClearAnimations(playerid, 1);
		new c = id[playerid];
	    if(c != -1)
	    {
	        GetPlayerPos(playerid, Conta[playerid][c_X], Conta[playerid][c_Y], Conta[playerid][c_Z]);
			GetPlayerFacingAngle(playerid, Conta[playerid][c_A]);
			Conta[playerid][c_Interior] = GetPlayerInterior(playerid);
			Conta[playerid][c_Mundo] = GetPlayerVirtualWorld_(playerid);
			if(ModoAdmin[playerid] == 0)
			{
			    if(Conta[playerid][c_Morto] == 0)
				{
				new strm[300];
					if(Online(killerid))
					{
					    if(id[killerid] != -1)
						{
						    Conta[playerid][c_Killer] = id[killerid];
							salvar_conta(c, 0, "c_Killer", sv_int(id[killerid]));
							format(strm, 300, "Jogador [%s] deixou [%s] gravemente ferido.", Nome(killerid), Nome(playerid));
						}
						else format(strm, 300, "Jogador [%s] se feriu gravemente.", Nome(playerid));
					}
					else format(strm, 300, "Jogador [%s] se feriu gravemente.", Nome(playerid));
					escrever_log("Server/ChatKill.txt", strm);
		        	Morreu(playerid);
					salvar_conta(c, -1, "c_Posicao");
				}
				else SelectTextDraw(playerid, 0x00ffffff);
	}
	}
	}
	return 1;
}

public OnPlayerDeath(playerid, killerid, reason)
{
    if(logado[playerid] == 0) return 1;
    if(JogadorCongelado[playerid] == 1){
        Controle(playerid, 1);
        JogadorCongelado[playerid] = 0;
        KillTimer(TimerFicarParado[playerid]);
    }
    RecLig[playerid] = -1;
    EmLigacao[playerid] = -1;
    morreu_agora[playerid] = 1;
    ArrastadoID[playerid] = -1;
	AttArrastar[playerid] = -1;
	ArrastadoTT[playerid] = -1;
	GetPlayerPos(playerid, pos_morreu[playerid][0], pos_morreu[playerid][1], pos_morreu[playerid][2]);
	GetPlayerFacingAngle(playerid, pos_morreu[playerid][3]);
	interior_morreu[playerid] = GetPlayerInterior(playerid);
	mundo_morreu[playerid] = GetPlayerVirtualWorld_(playerid);
	skin_morreu[playerid] = GetPlayerSkin_(playerid);
	arma_morreu[playerid] = GetPlayerWeapon(playerid);
	for(new a; a<13; a++) GetPlayerWeaponData(playerid, a, armas_morreu[playerid][a][0],armas_morreu[playerid][a][1]);
	new c = id[playerid];
	if(c != -1)
	{
	    SetarVida(playerid, Conta[playerid][c_Vida]);
	    SetarColete(playerid, Conta[playerid][c_Colete]);
	}
	else
	{
		SetPlayerHealth(playerid, 5);
		SetPlayerArmour(playerid, 0);
	}
    if(ConesColocados[playerid] >= 1)
	{
		for(new i = 1; i < 11; i++)
		{
	 		DestroyObject(ConeOBJ[playerid][i]);
	 		ConesColocados[playerid] = 0;
	 	}
	}
    if(pRoadblock[playerid] != 0)
	{
		RemoveRoadblock(playerid);
	}
	ClearAnimations(playerid, 1);
	return 1;
}

