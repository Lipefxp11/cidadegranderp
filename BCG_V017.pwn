stock lista_empresas(playerid)
{
    SG[0] = EOS;
    new linha[300];
    new cont, cofre, dono, prods, prodsv;
    strcat(SG, "ID    Nome\tDono\tCofre\tProdutos   Pagando\n");
	zerar_lista(playerid);
    foreach(new i:Iter_Empresas)
    {
        if(cont >= MAX_LISTA) break;
        if(Empresa[i][em_Existe] == 1)
        {
            cofre = Empresa[i][em_Cofre];
            dono = Empresa[i][em_Dono];
            prods = Empresa[i][em_Produtos];
            prodsv = Empresa[i][em_ValorProdutos];
            format(linha, 300, "{ffffff}%02d    {ffff00}%s\t{a1a1a1}%s\t{4169E1}R$ %s\t{a1a1a1}%03d/500     {00ffff}R$ %s\n", i, Empresa[i][em_Nome], NomeConta(dono), ConvertMoney(cofre), prods, ConvertMoney(prodsv));
			strcat(SG, linha);
			Lista[playerid][cont] = i;
			cont ++;

        }
    }
    format(linha, 300, "{ffffff}Empresas do Servidor {ffff00}[{ffffff}%d{ffff00}]", cont);
    ShowPlayerDialog(playerid, DIALOG_EMPRESAS, DIALOG_STYLE_TABLIST_HEADERS, linha, SG, "Localizar", "Fechar");
}

stock abrir_empresa(playerid, a)
{
	SetPVarInt(playerid, "empresa", a);
	if(id[playerid] != -1)
	{
		if(Empresa[a][em_Existe] == 1)
		{
			if(Empresa[a][em_Dono] == id[playerid])
			{
				new sss[500];
				new Float:p[4];
				new valor = (Empresa[a][em_Valor]/100)*80;
				GetPlayerPos(playerid, p[0], p[1], p[2]);
				GetDistance(p[3], p[0],p[1],p[2], Empresa[a][em_X], Empresa[a][em_Y], Empresa[a][em_Z]);
				strcat(sss, f("{ffffff}Localizar\t{a1a1a1}%.0f Metros\n", p[3]));
				strcat(sss, f("{ffffff}Valor Entrada\t{4169E1}R$ %s\n", ConvertMoney(Empresa[a][em_Entrada])));
				strcat(sss, f("{ffffff}Pagar por Produto\t{00ffff}R$ %s\n", ConvertMoney(Empresa[a][em_ValorProdutos])));
				strcat(sss, f("{ffffff}Depositar no Cofre\t{a1a1a1}Proximo ao Cofre\n"));
				strcat(sss, f("{ffffff}Retirar Dinheiro\t{a1a1a1}Proximo ao Cofre\n"));
				strcat(sss, f("{ff0000}Vender Empresa\t{ffff00}R$ %s\n", ConvertMoney(valor)));
				ShowPlayerDialog(playerid, DIALOG_MENU_EMPRESA, DIALOG_STYLE_TABLIST, Empresa[a][em_Nome], sss, "Continuar", "Voltar");
			}
		}
	}
}

