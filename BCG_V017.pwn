	    if(id[playerid] != -1)
	    {
	        ShowPlayerDialog(playerid, DIALOG_COMECO, DIALOG_STYLE_MSGBOX, "{000000}.", texto_ajuda_novato, "Localizar", "Fechar");
	    }
	}
}

stock escolher_cor_conce(playerid, i, aa)
{
	menu_id[playerid] = MENU_COR_CONCE;
    SetPVarInt(playerid, "conce", i);
    SetPVarInt(playerid, "veic", aa);
 	pagina_menu[playerid] = 0;
	escolhendo_menu[playerid] = 0;
	format(nome_menu[playerid], 100, "Escolher Cor");
	format(botao_menu[playerid], 100, "ESCOLHER");
    for(new a; a<sizeof Cores; a++)
	{
	    format(Menu[playerid][a][menu_Nome], 200, "%s", Cores[a][coresNome]);
	    format(Menu[playerid][a][menu_Info], 200, "Use 'ESCOLHER' para colocar a Cor no veiculo.");
	    Menu[playerid][a][menu_Modelo] = Conce[i][con_v_Modelo][aa];
	    Menu[playerid][a][menu_Valor] = Cores[a][coresID];
	    Menu[playerid][a][menu_Tipo] = 777777;
	}
    max_menu[playerid] = sizeof Cores;
	mostrar_menu(playerid, menu_id[playerid]);
}

stock DinheiroTerritorios()
{
	new contt[MAX_ORGS];
	new o;
	new sss[300];
	new grana;
	for(new t; t<MAX_TERRITORIOS; t++)
	{
	    if(TR[t][tr_Existe] == 1 && TR[t][tr_Tipo] != 0)
	    {
			o = TR[t][tr_Dono];
			if(o != -1)
			{
			    contt[o] ++;
			}
	    }
	}
	foreach(new a:Iter_Orgs)
	{
	    if(Org[a][o_Existe] == 1)
	    {
	        if(contt[a] > 0)
			{
			    grana = contt[a]*VALOR_TERRITORIO;
			    format(sss, 300, "[TERRITORIOS] Sua Organizacao recebeu R$ %s por manter %d territorios sob Controle.", ConvertMoney(grana), contt[a]);
			    mso(a, sss, -1, 0x1E90FFff);
			    Org[a][o_Cofre] += grana;
				salvar_org(a);
			}
	    }
	}
}

stock bilhete_player(playerid)
{
	for(new a; a<1000; a++)
	{
	    if(bilhetes[a][0] == id[playerid] && id[playerid] != -1)
	    {
	        return a;
		}
	}
	return -1;
}

stock comprar_bilhete()
{
    for(new a; a<1000; a++)
	{
	    if(bilhetes[a][0] == -1)
	    {
	        return a;
		}
	}
	return -1;
}

stock resposta_apk_caixa(playerid, con)
{
	new c = id[playerid];
	if(c != -1)
	{
	    // ipva //
	    SG[0] = EOS;
	    if(con == 0)
		{
            new cont;
            new ipva[100];
			foreach(new a:Iter_Veiculos)
			{
				if(Veiculo[a][v_Existe] == 1)
				{
				    if(Veiculo[a][v_Dono] == c)
					{
					    if(Veiculo[a][v_IPVA] < 2) format(ipva, 100, "~y~VENCE HOJE");
					    else format(ipva, 100, "~g~~h~%d DIAS", Veiculo[a][v_IPVA]);
					    format(Lista_DC[playerid][cont][cel_Nome], 100, "~p~%s ~w~( %s ~w~) ~g~~h~R$ %s", PlacaVeiculo[a], ipva, ConvertMoney(Veiculo[a][v_Contas]));
	                    Lista_DC[playerid][cont][cel_ID] = a;
	                    cont++;
					}
				}
			}
			if(cont == 0) Item_DC[playerid] = -1;
			else Item_DC[playerid] = 0;
			format(Titulo_DC[playerid], 100, "~w~SEUS VEICULOS ( ~y~%d ~w~)", cont);
			MAX_DC[playerid] = cont;
			ID_DC[playerid] = CAIXA_LOTERICA_IPVA;
			Pagina_DC[playerid] = 0;
			celular(playerid, C_LISTA);
		}

		// iptu //
	    if(con == 1)
		{
            new cont;
            new ipva[100];
			foreach(new a:Iter_Casas)
			{
				if(Casa[a][casa_Existe] == 1)
				{
				    if(Casa[a][casa_Dono] == c)
					{
					    if(Casa[a][casa_Data] < 2) format(ipva, 100, "~y~VENCE HOJE");
					    else format(ipva, 100, "~g~~h~%d DIAS", Casa[a][casa_Data]);
					    format(Lista_DC[playerid][cont][cel_Nome], 100, "~p~%s: ~b~%d ~w~( %s ~w~) ~g~~h~R$ %s", tipo_casa2(a), a, ipva, ConvertMoney(Casa[a][casa_Contas]));
	                    Lista_DC[playerid][cont][cel_ID] = a;
	                    cont++;
					}
				}
			}
			if(cont == 0) Item_DC[playerid] = -1;
			else Item_DC[playerid] = 0;
			format(Titulo_DC[playerid], 100, "~w~SUAS RESIDENCIAS ( ~y~%d ~w~)", cont);
			MAX_DC[playerid] = cont;
			ID_DC[playerid] = CAIXA_LOTERICA_IPTU;
			Pagina_DC[playerid] = 0;
			celular(playerid, C_LISTA);
		}

		// multas //
	    if(con == 2)
		{
            new cont;
            for(new i; i<MAX_MULTAS; i++)
			{
			    if(Multas[playerid][i][mu_Existe] == 1)
				{
		            format(Lista_DC[playerid][cont][cel_Nome], 100, "~g~~h~R$ %s ~w~[PESSOAL] ~w~%s", ConvertMoney(Multas[playerid][i][mu_Valor]), str_cortada(Multas[playerid][i][mu_Motivo], 16));
		            Lista_DC[playerid][cont][cel_ID] = i;
		            Lista_DC[playerid][cont][cel_Tipo] = 0;
		            cont ++;
			    }
	        }
	        foreach(new a:Iter_Veiculos)
	        {
	            if(Veiculo[a][v_Existe] == 1 && Veiculo[a][v_Dono] == c)
	            {
	                for(new i; i<MAX_MULTAS; i++)
	                {
	                    if(Veiculo_Multa[a][i][mu_Existe] == 1)
	                    {
	                        format(Lista_DC[playerid][cont][cel_Nome], 100, "~g~~h~R$ %s ~w~[%s] ~w~%s", ConvertMoney(Veiculo_Multa[a][i][mu_Valor]), PlacaVeiculo[a], str_cortada(Veiculo_Multa[a][i][mu_Motivo], 12));
	                        Lista_DC[playerid][cont][cel_ID] = i;
	                        Lista_DC[playerid][cont][cel_Unidades] = a;
	                        Lista_DC[playerid][cont][cel_Tipo] = 1;
	                        cont ++;
	                    }
	                }
	            }
	        }
	        if(cont == 0) Item_DC[playerid] = -1;
			else Item_DC[playerid] = 0;
			format(Titulo_DC[playerid], 100, "~w~MULTAS PARA PAGAR ( ~y~%d ~w~)", cont);
			MAX_DC[playerid] = cont;
			ID_DC[playerid] = CAIXA_LOTERICA_MULTAS;
			Pagina_DC[playerid] = 0;
			celular(playerid, C_LISTA);
		}

		// aposta //
	    if(con == 3)
		{
            format(Lista_DC[playerid][0][cel_Nome], 50, "~w~Fazer Aposta por ~g~~h~R$ %s", ConvertMoney(BILHETE));
			format(Lista_DC[playerid][1][cel_Nome], 50, "~w~Ver premio Acumulado: ~g~~h~R$ %s", ConvertMoney(sizeof Local_SanFierro));
			format(Lista_DC[playerid][2][cel_Nome], 50, "~y~~h~Ver meu Bilhete: ~g~~h~%s", ConvertMoney(sizeof Local_LasVenturas));
		    ID_DC[playerid] = CAIXA_LOTERICA_APOSTA;
			MAX_DC[playerid] = 3;
			Pagina_DC[playerid] = 0;
			Item_DC[playerid] = 0;
			format(Titulo_DC[playerid], 100, "MEGA DA VIRADA");
			celular(playerid, C_LISTA);
		}

	}
}


stock str_cortada(const strf[], max=15, const addd[]="...")
{
	new strtotal[500];
	format(strtotal, max+5, "%s%s", strf, (strlen(strf) > max)? addd:"");
	return strtotal;
}

stock consultar_placa_apk(playerid, v=-1)
{
	new c = id[playerid];
	if(c != -1)
	{
	    if(v == -1)
	    {
		    ID_DC[playerid] = CONSULTAR_PLACA;
			format(Titulo_DC[playerid], 100, "~b~~h~PESQUISAR PLACA NCT-XXXX~n~~w~Digite os 4 numeros finais da placa que deseja consultar:");
			Numero_MAX_DC[playerid] = 0;
			celular(playerid, C_NUMERO);
		}
		else
		{
		    new cont;
		    for(new m; m<MAX_MULTAS; m++) if(Veiculo_Multa[v][m][mu_Existe] == 1) cont++;
			new ipva[15];
		    if(Veiculo[v][v_IPVA] < 2) format(ipva, 100, "VENCE HOJE");
		    else format(ipva, 100, "%d DIAS", Veiculo[v][v_IPVA]);
		    format(str_aviso[playerid], 300, "\
			~b~~h~VEICULO~n~~n~\
			~y~Dono: ~w~%s~n~\
			~y~Modelo: ~y~~h~%s~n~\
			~y~Chasi: ~w~%s~n~\
			~y~Placa: ~b~~h~%s~n~\
			~y~IPVA: ~g~R$ %s ~w~%s~n~\
			~y~Multas: ~b~~h~%d~n~~n~\
			~p~Detran Estadual~n~\
			Servicos Online", NomeConta(Veiculo[v][v_Dono]), NomeVeiculo(Veiculo[v][v_Modelo]), Veiculo[v][v_Chasi], PlacaVeiculo[v], ConvertMoney(Veiculo[v][v_Contas]), ipva, cont);
    		SetPVarInt(playerid, "aviso", C_DETRAN);
    		celular(playerid, C_INFO);
		}
	}
}

stock multar_apk(playerid, a=-1)
{
    new c = id[playerid];
	if(c != -1)
	{
		if(PlayerCop(playerid))
		{
		    if(a == -1)
		    {
		        ID_DC[playerid] = MULTAR_PLACA;
				format(Titulo_DC[playerid], 100, "~b~~h~MULTAR PLACA NCT-XXXX~n~~w~Digite os 4 numeros finais da placa que deseja multar:");
				Numero_MAX_DC[playerid] = 0;
				celular(playerid, C_NUMERO);
		    }
		    else
			{
				mostrar_lista_multas(playerid, a);
			}
		}
		else
		{
            format(str_aviso[playerid], 300, "Voce nao tem permicao para usar esta Area dos servicos do Aplicativo !");
    		SetPVarInt(playerid, "aviso", C_DETRAN);
    		celular(playerid, C_ERRO);
		}
	}
}

stock mostrar_lista_multas(playerid, v)
{
    SetPVarInt(playerid, "info", v);
    new cont;
	for(new a; a<sizeof tipo_multa; a++)
	{
		format(Lista_DC[playerid][a][cel_Nome], 100, "~w~%s", str_cortada(tipo_multa[a][tm_Nome], 30));
		cont++;
	}
	if(cont != 0) Item_DC[playerid] = 0;
	else Item_DC[playerid] = -1;
	format(Titulo_DC[playerid], 100, "~w~TIPOS DE MULTAS ( ~y~%d ~w~)", sizeof tipo_multa);
	MAX_DC[playerid] = sizeof tipo_multa;
	ID_DC[playerid] = LISTA_MULTAS;
	Pagina_DC[playerid] = 0;
	celular(playerid, C_LISTA);
}

stock finalizar_multa(playerid, a)
{
	new v = GetPVarInt(playerid, "info");
    SetPVarInt(playerid, "multa", a);
	format(Lista_DC[playerid][0][cel_Nome], 100, "~y~MULTAR");
	format(Lista_DC[playerid][1][cel_Nome], 100, "~w~VIZUALIZAR");
	format(Lista_DC[playerid][2][cel_Nome], 100, "~w~ALTERAR MOTIVO");
	format(Lista_DC[playerid][3][cel_Nome], 100, "~r~CANCELAR");
	Item_DC[playerid] = 0;
	format(Titulo_DC[playerid], 100, "~y~PLACA: ~w~%s~n~~w~Valor: ~g~~h~R$ %s", PlacaVeiculo[v], ConvertMoney(tipo_multa[a][tm_Valor]));
	MAX_DC[playerid] = 4;
	ID_DC[playerid] = FINALIZAR_MULTA;
	Pagina_DC[playerid] = 0;
	celular(playerid, C_LISTA);
}


stock palavra_grande(const stringp[])
{
	new cont;
	for(new a; a<strlen(stringp); a++)
	{
	    if(stringp[a] != ' ')
		{
			cont++;
			if(cont >= 15) return 1;
		}
		else cont = 0;
	}
	return 0;
}

