	        {
	            new niv = AdminPlayer(playerid);
	            format(sss, 900, "{00ffff}COMANDOS DE EDICAO (ate nivel %d):{ffffff}\n", niv);
	            strcat(SG, sss);
	            for(new a; a<sizeof ComandosAdmin2; a++)
	            {
	                if(ComandosAdmin2[a][cmd_Level] <= niv)
	                {
	                    strcat(SG, ComandosAdmin2[a][cmd_Comando]);
	                    strcat(SG, "  ");
	                    cc++;
	                    if(cc == 6) strcat(SG, "\n"), cc = 0;
	                }
	            }
	            format(titulo, 60, "{00ffff}Comandos de Edicao (Nivel: %d)", niv);
	        }
	        else
	        {
	            new nivel = listitem + 1;
	            if(AdminPlayer(playerid) < nivel) return ms(playerid, 0, f("Voce nao tem nivel admin %d para ver estes comandos !", nivel));
	            format(sss, 900, "{00ffff}COMANDOS NIVEL %d:{ffffff}\n", nivel);
	            strcat(SG, sss);
