		        new idv = Info_Veiculo[veh];
		        if(idv != -1)
		        {
		            for(new ii; ii<18; ii++)
		            {
		                if(TuningVeiculo[idv][ii] == i)
		                {
		                    TuningVeiculo[idv][ii] = -1;
		                    SalvarVeiculo(veh);
