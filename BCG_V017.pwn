    TextDrawFont(IFOOD_TD[9], 2); TextDrawLetterSize(IFOOD_TD[9], 0.500000, 2.000000);
    TextDrawTextSize(IFOOD_TD[9], 0.000000, 0.000000);
    TextDrawSetOutline(IFOOD_TD[9], 0); TextDrawSetShadow(IFOOD_TD[9], 2);
    TextDrawAlignment(IFOOD_TD[9], 2);
    TextDrawColor(IFOOD_TD[9], 852308735); TextDrawBackgroundColor(IFOOD_TD[9], 255);
    TextDrawBoxColor(IFOOD_TD[9], 50); TextDrawUseBox(IFOOD_TD[9], 0);
    TextDrawSetProportional(IFOOD_TD[9], 1);
}

stock IFOOD_HideHUD(playerid)
{
    for(new dd; dd<sizeof HudFomeSede; dd++) TextDrawHideForPlayer(playerid, HudFomeSede[dd]);
    PlayerTextDrawHide(playerid, HudFomeSedeP[playerid][0]);
    PlayerTextDrawHide(playerid, HudFomeSedeP[playerid][1]);
    PlayerTextDrawHide(playerid, HudFomeSedeP[playerid][2]);
    PlayerTextDrawHide(playerid, HudInfoBox[playerid]);
    PlayerTextDrawHide(playerid, HudInfoIDF[playerid]);
    PlayerTextDrawHide(playerid, HudInfoNIVEL[playerid]);
    PlayerTextDrawHide(playerid, HudInfoXP[playerid]);
    for(new a; a<6; a++) PlayerTextDrawHide(playerid, T_HudPlayer[playerid][a]);
}

stock IFOOD_ShowHUD(playerid)
{
    for(new dd; dd<sizeof HudFomeSede; dd++) TextDrawHideForPlayer(playerid, HudFomeSede[dd]);
    PlayerTextDrawHide(playerid, HudFomeSedeP[playerid][0]);
    PlayerTextDrawHide(playerid, HudFomeSedeP[playerid][1]);
    PlayerTextDrawHide(playerid, HudFomeSedeP[playerid][2]);
    PlayerTextDrawShow(playerid, HudInfoBox[playerid]);
    PlayerTextDrawShow(playerid, HudInfoIDF[playerid]);
    PlayerTextDrawShow(playerid, HudInfoNIVEL[playerid]);
    PlayerTextDrawShow(playerid, HudInfoXP[playerid]);
    for(new a; a<6; a++) PlayerTextDrawShow(playerid, T_HudPlayer[playerid][a]);
}

stock IFOOD_ClearChat(playerid)
{
    for(new c; c<40; c++) SendClientMessage(playerid, -1, " ");
}

stock IFOOD_BlackShow(playerid)
{
    for(new i; i<9; i++) TextDrawShowForPlayer(playerid, IFOOD_TD[i]);
    IFOOD_HideHUD(playerid);
    IFOOD_ClearChat(playerid);
}

stock IFOOD_BlackHide(playerid)
{
    for(new i; i<9; i++) TextDrawHideForPlayer(playerid, IFOOD_TD[i]);
    IFOOD_ShowHUD(playerid);
}

stock IFOOD_ShowDeliveryPrompt(playerid)
{
    TextDrawShowForPlayer(playerid, IFOOD_TD[9]);
}

stock IFOOD_HideDeliveryPrompt(playerid)
{
    TextDrawHideForPlayer(playerid, IFOOD_TD[9]);
}

stock IFOOD_DestroyNPC(playerid)
{
    if(IFOOD_NPCSet[playerid] && IFOOD_NPCActor[playerid] != INVALID_ACTOR_ID)
    {
        DestroyActor(IFOOD_NPCActor[playerid]);
        IFOOD_NPCActor[playerid] = INVALID_ACTOR_ID;
        IFOOD_NPCSet[playerid] = 0;
    }
}

stock IFOOD_SpawnNPC(playerid, Float:x, Float:y, Float:z)
{
    IFOOD_DestroyNPC(playerid);
    new npcSkin = 50 + random(250);
    IFOOD_NPCActor[playerid] = CreateActor(npcSkin, x, y, z - 1.0, 0.0);
    IFOOD_NPCSet[playerid] = 1;
    ApplyActorAnimation(IFOOD_NPCActor[playerid], "PED", "IDLE_chat", 4.0, 1, 0, 0, 0, 0);
}

stock IFOOD_GetRandomProperty(&Float:x, &Float:y, &Float:z)
{
    new total;
    new possiveis[500];
    for(new i; i<MAX_CASAS; i++)
    {
        if(Casa[i][casa_Existe] && Casa[i][casa_Dono])
        {
            possiveis[total++] = i;
            if(total >= 500) break;
        }
    }
    if(total > 0)
    {
        new idx = possiveis[random(total)];
        x = Casa[idx][casa_X1]; y = Casa[idx][casa_Y1]; z = Casa[idx][casa_Z1];
        return 1;
    }
    return 0;
}

forward IFOOD_AnimDone(playerid);
public IFOOD_AnimDone(playerid)
{
    ClearAnimations(playerid);
    TogglePlayerControllable(playerid, 1);
    IFOOD_Count[playerid]++;
    DarGrana(playerid, IFOOD_PAY);
    ms(playerid, 1, f("Entrega %d/%d! +$%d", IFOOD_Count[playerid], IFOOD_TOTAL, IFOOD_PAY));
    if(IFOOD_Count[playerid] >= IFOOD_TOTAL)
    {
        DarGrana(playerid, IFOOD_BONUS);
        ms(playerid, 1, f("Todas as entregas feitas! Bonus de $%d!", IFOOD_BONUS));
        IFOOD_Working[playerid] = 0;
        IFOOD_Count[playerid] = 0;
        DisablePlayerCheckpoint(playerid);
        IFOOD_CP[playerid] = 0;
        SetPlayerCheckpoint(playerid, IFOOD_X, IFOOD_Y, IFOOD_Z, 5.0);
        IFOOD_CP[playerid] = 2;
        ms(playerid, 0, "Volte ao McDonald's e use /pegarlanches para mais entregas!");
        return;
    }
    IFOOD_InProgress[playerid] = 1;
    SetTimerEx("IFOOD_SetNextDelivery", 5000, false, "d", playerid);
}

forward IFOOD_SetNextDelivery(playerid);
public IFOOD_SetNextDelivery(playerid)
{
    IFOOD_InProgress[playerid] = 0;
    new Float:cx, Float:cy, Float:cz;
    if(IFOOD_GetRandomProperty(cx, cy, cz))
    {
        IFOOD_SpawnNPC(playerid, cx, cy, cz);
        SetPlayerCheckpoint(playerid, cx, cy, cz, 5.0);
        IFOOD_CP[playerid] = 1;
        PlayAudioStreamForPlayer(playerid, "http://som.brasilplaygames.com.br/som/ifood.mp3");
        ms(playerid, 0, "Nova entrega disponivel! Vá ate o checkpoint.");
    }
    else
    {
        ms(playerid, 0, "Nenhuma propriedade disponivel para entrega!");
        IFOOD_Working[playerid] = 0;
        IFOOD_Count[playerid] = 0;
    }
}

forward IFOOD_Finish(playerid);
public IFOOD_Finish(playerid)
{
    IFOOD_BlackHide(playerid);
    IFOOD_InProgress[playerid] = 0;
    TogglePlayerControllable(playerid, 1);
    new Float:cx, Float:cy, Float:cz;
    if(IFOOD_GetRandomProperty(cx, cy, cz))
    {
        IFOOD_SpawnNPC(playerid, cx, cy, cz);
        SetPlayerCheckpoint(playerid, cx, cy, cz, 5.0);
        IFOOD_CP[playerid] = 1;
        PlayAudioStreamForPlayer(playerid, "http://som.brasilplaygames.com.br/som/ifood.mp3");
        ms(playerid, 0, "Lanche pronto! Entregue no checkpoint.");
    }
    else
    {
        ms(playerid, 0, "Nenhuma propriedade disponivel para entrega! Tente novamente.");
        IFOOD_Working[playerid] = 0;
        IFOOD_Count[playerid] = 0;
    }
}

stock IFOOD_Start(playerid)
{
    if(!IsPlayerInRangeOfPoint(playerid, 5.0, IFOOD_X, IFOOD_Y, IFOOD_Z))
        return ms(playerid, 0, "Va ate o McDonald's!");
    new bag_ok;
    for(new w; w<MAX_ACESSORIOS; w++) { if(Acessorios[playerid][w][ac_Existe] && Acessorios[playerid][w][ac_Usando] && Acessorios[playerid][w][ac_ID] == 217) { bag_ok = 1; break; } }
    if(!bag_ok)
        return ms(playerid, 0, "Voce precisa equipar a Bag iFood! Use pelo inventario.");
    if(IFOOD_InProgress[playerid])
        return ms(playerid, 0, "Aguarde a entrega atual!");
    if(IFOOD_Working[playerid] && IFOOD_Count[playerid] >= IFOOD_TOTAL)
        return ms(playerid, 0, "Entregas concluidas! Volte ao McDonald's.");
    IFOOD_Working[playerid] = 1;
    IFOOD_BlackShow(playerid);
    PlayAudioStreamForPlayer(playerid, "http://som.brasilplaygames.com.br/som/zipper.mp3");
    TogglePlayerControllable(playerid, 0);
    IFOOD_InProgress[playerid] = 1;
    IFOOD_Timer[playerid] = SetTimerEx("IFOOD_Finish", IFOOD_TEMPO_PEGAR, false, "d", playerid);
    return 1;
}

// ===== FIM iFood.inc =====
