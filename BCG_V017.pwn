stock Registro(playerid)
{
    criar_conta_lobby(playerid);
    return 1;
}

stock Login(playerid)
{
	format(sttr, 500, "\n\n\
	{ffffff}Bem Vindo, por favor digite o ID de sua Conta\n para poder logar em nosso no nosso servidor:\n\n{00ffff}[INFO] {a1a1a1}Caso nao lembre, clique no botao MEU ID e\nuse o Nick cadastrado para pesquisar.\n\n");
	Input(playerid, DIALOG_LOGIN, "{BEBEBE}Cidade Grande{4169E1}[RP]", sttr, 0);
}

stock Congelar(playerid, con=0)
{
	if(con == 1)
	{
		GetPlayerPos(playerid, pos_con[playerid][0], pos_con[playerid][1], pos_con[playerid][2]);
		pos_cong[playerid] = 1;
	}
	else pos_cong[playerid] = 0;
    KillTimer(timer_congelado[playerid]);
    Controle(playerid, false);
    congelado[playerid] = 1;
    timer_congelado[playerid] = SetTimerEx("desconlgelar_player", 500, true, "d", playerid);
}


stock Congelado(playerid) return congelado[playerid];
BCG:: Descongelar(playerid)
{
    KillTimer(timer_congelado[playerid]);
    congelado[playerid] = 0;
    Controle(playerid, true);
    if(pos_cong[playerid] == 1)
	{
		SetPlayerPos_(playerid, pos_con[playerid][0]+0.1, pos_con[playerid][1]+0.1, pos_con[playerid][2]+0.1);
		pos_cong[playerid] = 0;
	}
    return 1;
}

BCG:: desconlgelar_player(playerid)
{
	if(Online(playerid))
	{
	    if(congelado[playerid] == 1)
		{
			Controle(playerid, false);
		}
		else
		{
		    Controle(playerid, true);
		    KillTimer(timer_congelado[playerid]);
		}
	}
	else KillTimer(timer_congelado[playerid]);
	return 1;
}

stock setar_lobby(playerid)
{
	logado[playerid] = 1;
	TogglePlayerControllable(playerid, true);
	PlayerSpawn(playerid);
    carregar_mapa(playerid);
	sentar_player(playerid);
	SetTimerEx("sentar_player", 1000, false, "d", playerid);
}

BCG:: veiculos(i)
{
	new v;
	new file[80];
	new Float:lifecar;
    if(GetVehicleModel(i) != 0)
    {
        v = Info_Veiculo[i];
        if(v != -1)
        {
			if(Veiculo[v][v_Garagem] == 0)
			{
			    new spawnou;
	            if(Veiculo[v][v_Emprego] != -1)
	            {
	                if(veiculo_desoculpado[i] == 1)
	                {
	                    veiculo_desoculpado_tempo[i] ++;
	                    if(veiculo_desoculpado_tempo[i] >= TEMPO_VEICULO_EMPREGO)
	                    {
	                        spawn_veiculo_desocupado(i, 0, veiculo_desoculpado_tempo[i]);
	                        veiculo_desoculpado_tempo[i] = 0;
	                        spawnou = 1;
	                    }
	                }
	            }
	            else if(Veiculo[v][v_Org] == -1 && Veiculo[v][v_Dono] == -1 && Veiculo[v][v_Emprego] == -1)
	            {
	                if(veiculo_desoculpado[i] == 1)
	                {
	                    veiculo_desoculpado_tempo[i] ++;
	                    if(veiculo_desoculpado_tempo[i] >= TEMPO_VEICULO_PUBLICO)
	                    {
	                        spawn_veiculo_desocupado(i, 1, veiculo_desoculpado_tempo[i]);
	                        veiculo_desoculpado_tempo[i] = 0;
	                        spawnou = 1;
	                    }
	                }
	            }

		        if(spawnou == 0)
		        {
		            GetVehicleHealth(i, lifecar);
		            format(file, 80, "Veiculos/Veiculo_%d.txt", v);
			    	if(lifecar != 0.0) Veiculo[v][v_Vida] = lifecar;

					// verificar se o motor ta bom //
					if(lifecar < 300.0 && lifecar != 0.0)
					{
					    SetVehicleHealth(i, 300.0);
					    Veiculo[v][v_Vida] = 300.0;
						motor_(i, 0);
					    foreach(new p:Player) if(Online(p)) if(IsPlayerInVehicle(p, i)) GameTextForPlayer( p, "MOTOR DANIFICADO" , 5000 , 1 ) ;
					}
					else if(lifecar == 300.0 && motor[i] == 1)
					{
					    SetVehicleHealth(i, 300.0);
					    Veiculo[v][v_Vida] = 300.0;
					    motor_(i, 0);
					    foreach(new p:Player) if(Online(p)) if(IsPlayerInVehicle(p, i)) GameTextForPlayer( p, "MOTOR DANIFICADO" , 5000 , 1 ) ;
					}

				    if(motor[i] != 0 || farol[i] != 0)
					{

					// diminuir gasolina de acordo com a velocidade //
						new dimin;
						if(GetVehicleSpeed(i) > 100) dimin = 2;
					else dimin = 1;

					// gasolina //
					if(motor[i] != 0)
					{
					    if(GetVehicleSpeed(i) > 50)
						{
					        if(!VeiculoBarco(i) && !VeiculoBicicleta(i) && !VeiculoAviao(i) && !VeiculoAviao2(i))
					        {
						        new rand = random(PNEU_CHANCE);
						        if(rand == 5)
						        {
						            new randr;
										if(VeiculoMoto(i)) randr = random(2);
										else randr = random(4);
						            if(Veiculo[v][v_Pneu][randr] == 0)
						            {
						                Veiculo[v][v_Pneu][randr] = 1;
						                foreach(new p:Player) if(Online(p)) if(IsPlayerInVehicle(p, i)) GameTextForPlayer( p, "PNEU FURADO" , 5000 , 1 ) ;
				                        update_danos_veiculo(i, v);
										}
						        }
					        }
					    }
					    diminuir_gasolina[i] ++;
					    if(diminuir_gasolina[i] == diminuir_modelo(i))
						{
					        diminuir_gasolina[i] = 0;
					        Veiculo[v][v_Gasolina] -= dimin;
					        if(Veiculo[v][v_Gasolina] < 0) Veiculo[v][v_Gasolina] = 0;
					        if(Veiculo[v][v_Gasolina] < 10)
					        {
					            foreach(new p:Player) if(Online(p)) if(IsPlayerInVehicle(p, i)) GameTextForPlayer( p, "POUCA GASOLINA" , 5000 , 1 ) ;
		                            motor_(i, 0);
								}
								DOF2_SetInt(file, "v_Gasolina", Veiculo[v][v_Gasolina]);
								DOF2_SaveFile();
					    }
					}

					// bateria //
					if(farol[i] != 0)
					{
		                    diminuir_bateria[i] ++;
					    if(diminuir_bateria[i] == 140)
						{
		                        diminuir_bateria[i] = 0;
		                        Veiculo[v][v_Bateria] --;
		                        if(Veiculo[v][v_Bateria] < 0) Veiculo[v][v_Bateria] = 0;
					        if(Veiculo[v][v_Bateria] < 10)
					        {
		                        	foreach(new p:Player) if(Online(p)) if(IsPlayerInVehicle(p, i)) GameTextForPlayer( p, "BATERIA FRACA" , 5000 , 1 ) ;
		                       		farol_(i, 0);
								}
								DOF2_SetInt(file, "v_Bateria", Veiculo[v][v_Bateria]);
								DOF2_SaveFile();
					    }
					}
				    }

			    }
		    }
	    }
	}
}


stock MeiaNoite()
{
    new sss[300];
    new cont;

    new vall;

    // todas as contas //
    cont = 0;
    new cc = -1;
    new c = -1;
	foreach(new i:Player)
	{
	    if(Online(i))
	    {
	        c = id[i];
            if(c != -1)
            {
		        if(Conta[i][c_H][0] != 0 || Conta[i][c_H][1] != 0 || Conta[i][c_H][2] != 0 || Conta[i][c_H][3] != 0)
		        {
	                vall = Conta[i][c_HV];
	                if(vall < 1000) Conta[i][c_HV] = gettime()+(30*UM_DIA);
	                else if(vall < gettime())
	                {
	                    Conta[i][c_H][0] = 0;
	                    Conta[i][c_H][1] = 0;
	                    Conta[i][c_H][2] = 0;
	                    Conta[i][c_H][3] = 0;
	                    msc(c, 5, "[AUTO ESCOLA] Voce perdeu sua Habilitacao por vencimento !");
						Conta[i][c_HV] = vall;
						salvar_conta(c, -1, "c_Habilitacao");
						cont ++;
					}
	            }
			}
		}
	}
	if(cont > 0)
	{
	    format(sss, 300, "? %s pessoas perderam sua Habilitacao por vencimento ?", ConvertMoney(cont));
	    msa2(6, sss);
	}

	// veiculos pessoais //
	cont = 0;
	foreach(new v:Iter_Veiculos)
	{
	    if(Veiculo[v][v_Existe] == 1)
	    {
	        if(Veiculo[v][v_Dono] != -1 && Veiculo[v][v_Emprego] == -1 && Veiculo[v][v_Org] == -1)
	        {
	            cc = Veiculo[v][v_Dono];
	            if(Veiculo[v][v_IPVA] >= 0)
	            {
	                Veiculo[v][v_IPVA]--;
	                Veiculo[v][v_Contas] += (40+random(60));
	                if(Veiculo[v][v_IPVA] <= 0)
	                {
	                    if(Veiculo[v][v_ID] != -1 && GetVehicleModel(Veiculo[v][v_ID]) != 0)
						{
							Info_Veiculo[Veiculo[v][v_ID]] = -1;
							DestroyVehicle_(Veiculo[v][v_ID]);
						}
						Veiculo[v][v_Garagem] = 1;
						Veiculo[v][v_ID] = -1;
						Veiculo[v][v_Dono] = -1;
						format(Veiculo[v][v_History], 300, "%d", cc);
						msc(cc, 5, "Seu veiculo foi apreendido por IPVA atrasado! Va ao deposito para recupera-lo.");
	                    cont++;
	                }
	                SalvarInfo(v);
	            }
	        }
	    }
	}
	if(cont > 0)
	{
	    format(sss, 300, "? %s Veiculos foram destruidos por vencimento do IPVA ?", ConvertMoney(cont));
	    msa2(6, sss);
	}

	cont = 0;
	// casas //
	foreach(new a:Iter_Casas)
	{
		if(Casa[a][casa_Existe] == 1)
		{
			if(Casa[a][casa_Dono] != -1)
			{
			    cc = Casa[a][casa_Dono];
			    if(Casa[a][casa_Data] >= 0)
				{
				Casa[a][casa_Data] --;
				Casa[a][casa_Contas] += (30+random(40));
				if(Casa[a][casa_Data] <= 0)
				{
			    Casa[a][casa_Dono] = -1;
			    Casa[a][casa_Venda] = 1;
			    Casa[a][casa_Keys][0] = -1; Casa[a][casa_Keys][1] = -1; Casa[a][casa_Keys][2] = -1;
				    msc(cc, 5, "Voce perdeu uma Casa por nao pagar o IPTU no prazo de validade!");
				    atualizar_casa(a);
	                    cont++;
				}
				salvar_casa(a);
			    }
			}
	    }
	}
	if(cont > 0)
	{
	    format(sss, 300, "? %s Casas foram colocadas a venda por vencimento do IPTU ?", ConvertMoney(cont));
	    msa2(6, sss);
	}
}

stock PayDay(con=-1)
{
	// cofrepublico //
	add_cp(30000);

    // verificar ganhadores da loteria //
	Loteria();

	// restaurar as arvores //
    RespawnArvores();

    // restaurar as pedras //
    RespawnPedras();

    // reabastecer os lixeiros //
    RespawnLixos();

	// dar pagamento //
	foreach(new pla:Player)
	{
	    if(Online(pla))
	    {
	        dar_payday(pla);
	    }
	}

	// dar grana pras orgs dos territorios //
    if(con == 1)
	{
	    // pagar donos territorios //
		DinheiroTerritorios();

   	 	// pagar corps //
    	pagamento_corps();

    	// dar materiais as orgs do governo //
		QuebrarRadares();

		// dar grana caixas eletronicos //
		GranaCaixas();

		// dar materiais as orgs do governo //
		MateriaisGoverno();

		payday_server ++;
   	 	salvar_definicoes("PayDay");
    }
    return 1;
}

stock GranaCaixas()
{
    foreach(new i:Iter_CaixasEletronicos)
	{
	    if(CaixaEletronico[i][ce_Existe] == 1)
	    {
	        if(CaixaEletronico[i][ce_Quebrado] == 0)
	        {
                if(CaixaEletronico[i][ce_Dinheiro] < 120000)
                {
			    	CaixaEletronico[i][ce_Dinheiro] += 7000+random(8000);
			    	texto_caixa_eletronico(i);
			    	salvar_caixa_eletronico(i);
			    }
	        }
	    }
	}
}

stock MateriaisGoverno()
{
	foreach(new i:Iter_Maquinas)
	{
	    if(Maquina[i][m_Existe] == 1)
	    {
			new org = Maquina[i][m_Org];
			if(OrgCop(org))
			{
				for(new a; a<4; a++)
				{
				if(Maquina[i][m_Materiais][a] < 10000)
				{
				    Maquina[i][m_Materiais][a] += 1000;
				}
			    }
			}
	    }
	}
}

stock Loteria()
{
	new strq[300];
	new bilhetes2[1000];
	new cont2;
	for(new a; a<sizeof bilhetes; a++)
	{
	    bilhetes2[a] = -1;
	    if(bilhetes[a][0] != -1)
	    {
	        bilhetes2[cont2] = a;
	    }
	}
	new Bilhete_Premiado = random(100000);
	if(cont2 == 0)
	{
	    // ninguem comprou bilhetes //
	    format(strq, 300, "LOTERIA: Bilhete premiado [ %05d ], Ninguem ganhou e o premio, acumulou para R$ %s !", Bilhete_Premiado, ConvertMoney(premio_loteria));
		mst( 2, strq);
	}
	else
	{
	    // foi comrado algum //
		new ganhador[50] = {-1, ...};
	    new cont;
	    new aa;
	    for(new i; i<cont2; i++)
		{
		    aa = bilhetes2[i];
		    if(bilhetes[aa][0] != -1)
		    {
		        if(bilhetes[aa][1] == Bilhete_Premiado)
		    	{
		    	    ganhador[cont] = bilhetes[aa][0];
		    	    cont ++;
		    	}
	        }
	    }
	    if(cont == 0)
		{
		    format(strq, 300, "LOTERIA: Bilhete premiado [ %05d ], Ninguem ganhou e o premio, acumulou para R$ %s !", Bilhete_Premiado, ConvertMoney(premio_loteria));
			mst( 2, strq);
		}
		else if(cont == 1)
		{
	        new c = ganhador[0];
	        format(sttr, 300, "LOTERIA: %s foi o Vencedor com o bilhete [ %05d ], Premio entregue R$ %s !", NomeConta(c), Bilhete_Premiado, ConvertMoney(premio_loteria));
        	msa2(5, sttr);
        	new playerid = ContaOnline(c);
        	new gran = GetContaInt(c, "c_Banco");
        	format(strq, 300, "Parabens, Voce foi o sortudo que ganhou R$ %s no premio da Loteria !", ConvertMoney(premio_loteria));
        	msc(c, 1, strq);
			if(Online(playerid)) DarBanco(playerid, premio_loteria);
	        else salvar_conta(c, 0, "c_Banco", sv_int(gran+premio_loteria));
	        premio_loteria = 50000;
	    }
	    else
	    {
	        new novo_premio = premio_loteria/cont;
	        format(sttr, 300, "LOTERIA: %d pessoas ganharam, bilhete [ %05d ], premio dividido cada um ganhou R$ %s !", cont, Bilhete_Premiado, ConvertMoney(novo_premio));
        	msa2(5, sttr);
            for(new a; a<cont; a++)
	    	{
	    	    new c = ganhador[a];
	    	    new playerid = ContaOnline(c);
	    	    new gran = GetContaInt(c, "c_Banco");
	    	    format(strq, 300, "Parabens, Voce foi um dos %d sortudos que ganharam R$ %s no premio da Loteria !", cont, ConvertMoney(novo_premio));
                if(Online(playerid)) DarBanco(playerid, novo_premio);
				else salvar_conta(c, 0, "c_Banco", sv_int(gran+novo_premio));
				msc(c, 1, strq);

	    	}
            premio_loteria = 50000;
	    }
	}

	// zerar bilhetes //
	for(new l; l<sizeof bilhetes; l++)
	{
	    bilhetes[l][0] = -1;
	    bilhetes[l][1] = -1;
	}
    salvar_definicoes("Loteria");
}

stock GetWeekDay()
{
    new year, month, day;
    getdate(year, month, day);
    new weekday_str[20], j, e;
    if (month <= 2)
    {
        month += 12;
        --year;
    }
    j = year % 100;
    e = year / 100;
    switch ((day + (month+1)*26/10 + j + j/4 + e/4 - 2*e) % 7)
    {
        case 0: weekday_str = "SABADO";
        case 1: weekday_str = "DOMINGO";
        case 2: weekday_str = "SEGUNDA FEIRA";
        case 3: weekday_str = "TERCA FEIRA";
        case 4: weekday_str = "QUARTA FEIRA";
        case 5: weekday_str = "QUINTA FEIRA";
        case 6: weekday_str = "SEXTA FEIRA";
    }
    return weekday_str;
}

stock GetWeekDay2()
{
    new year, month, day;
    getdate(year, month, day);
    new j, e;
    if (month <= 2)
    {
        month += 12;
        --year;
    }
    j = year % 100;
    e = year / 100;
    return ((day + (month+1)*26/10 + j + j/4 + e/4 - 2*e) % 7);
}

stock pegar_mes(mes)
{
	new mes_agora[50];
	format(mes_agora, 50, "Nenhum");
	if(mes == 1) format(mes_agora, 50, "Janeiro");
	if(mes == 2) format(mes_agora, 50, "Fevereiro");
	if(mes == 3) format(mes_agora, 50, "Marco");
	if(mes == 4) format(mes_agora, 50, "Abril");
	if(mes == 5) format(mes_agora, 50, "Maio");
	if(mes == 6) format(mes_agora, 50, "Junho");
	if(mes == 7) format(mes_agora, 50, "Julho");
	if(mes == 8) format(mes_agora, 50, "Agosto");
	if(mes == 9) format(mes_agora, 50, "Setembro");
	if(mes == 10) format(mes_agora, 50, "Outrubro");
	if(mes == 11) format(mes_agora, 50, "Novembro");
	if(mes == 12) format(mes_agora, 50, "Dezembro");
	return mes_agora;
}

stock sv_int(salve)
{
	new sal[300];
	format(sal, 300, "%d", salve);
	return sal;
}

stock sv_float(Float:salve)
{
	new sal[300];
	format(sal, 300, "%f", salve);
	return sal;
}

stock sv_str(const salve[])
{
	new sal[300];
	format(sal, 300, "%s", salve);
	return sal;
}

stock salvar_conta(i, tip=0, const salve[]="nada", const valor[]="nada")
{
	new file[80];
    format(file, 80, "Contas/%d.txt", i);
	if(!ContaInvalida(i))
	{
	    if(!Comparar("nada", salve))
	    {
	        if(DOF2_FileExists(file))
	        {
				if(Comparar("c_Tags", salve))
	            {
	                new player = ContaOnline(i);
	                if(Online(player))
	                {
	                    DOF2_SetInt(file, "c_Tag", Conta[player][c_Tag]);
					    DOF2_SetInt(file, "c_TagYT", Conta[player][c_TagYT]);
		                DOF2_SaveFile();
	                }
	            }
	            else if(Comparar("c_Presidio", salve))
	            {
	                new player = ContaOnline(i);
	                if(Online(player))
	                {
	                    DOF2_SetInt(file, "c_Cadeia", Conta[player][c_Cadeia]);
					    DOF2_SetInt(file, "c_TempoCadeia", Conta[player][c_TempoCadeia]);
					    DOF2_SetInt(file, "c_Ajuste", Conta[player][c_Ajuste]);
					    DOF2_SetInt(file, "c_Cela", Conta[player][c_Cela]);
					    DOF2_SetInt(file, "c_FichaPolicial", Conta[player][c_FichaPolicial]);
		                DOF2_SaveFile();
	                }
	            }
	            else if(Comparar("c_Documentos", salve))
	            {
	                new player = ContaOnline(i);
	                if(Online(player))
	                {
	                    DOF2_SetString(file, "c_Mae", Conta[player][c_Mae]);
					    DOF2_SetString(file, "c_Pai", Conta[player][c_Pai]);
					    DOF2_SetInt(file, "c_CPF", Conta[player][c_CPF]);
					    DOF2_SetInt(file, "c_RG", Conta[player][c_RG]);
		                DOF2_SaveFile();
	                }
	            }
	            else if(Comparar("c_Habilitacao", salve))
	            {
	                new player = ContaOnline(i);
	                if(Online(player))
	                {
	                    DOF2_SetInt(file, "c_H1", Conta[player][c_H][0]);
					    DOF2_SetInt(file, "c_H2", Conta[player][c_H][1]);
					    DOF2_SetInt(file, "c_H3", Conta[player][c_H][2]);
					    DOF2_SetInt(file, "c_H4", Conta[player][c_H][3]);
					    DOF2_SetInt(file, "c_HP", Conta[player][c_HP]);
					    DOF2_SetInt(file, "c_HV", Conta[player][c_HV]);
					    DOF2_SetString(file, "c_HD", Conta[player][c_HD]);
		                DOF2_SaveFile();
	                }
	            }
	            else if(Comparar("c_Banimento", salve))
	            {
	                new player = ContaOnline(i);
	                if(Online(player))
	                {
	                    DOF2_SetInt(file, "c_CA_Tempo", Conta[player][c_CA_Tempo]);
	                    DOF2_SetInt(file, "c_CA_Admin", Conta[player][c_CA_Admin]);
	                    DOF2_SetString(file, "c_CA_Motivo", Conta[player][c_CA_Motivo]);
	                    DOF2_SetString(file, "c_CA_Data", Conta[player][c_CA_Data]);
	                    DOF2_SetInt(file, "c_Ban_Tempo", Conta[player][c_Ban_Tempo]);
				     	DOF2_SetInt(file, "c_Ban_Admin", Conta[player][c_Ban_Admin]);
				     	DOF2_SetString(file, "c_Ban_Motivo", Conta[player][c_Ban_Motivo]);
		                DOF2_SaveFile();
	                }
	            }
	            else if(Comparar("c_Posicao2", salve))
	            {
	                new player = ContaOnline(i);
	                if(Online(player))
	                {
	                    Conta[player][c_Interior] = GetPlayerInterior(player);
						Conta[player][c_Mundo] = GetPlayerVirtualWorld_(player);
						GetPlayerPos(player, Conta[player][c_X],Conta[player][c_Y],Conta[player][c_Z]);
						GetPlayerFacingAngle(player, Conta[player][c_A]);
	                    DOF2_SetInt(file, "c_Interior", Conta[player][c_Interior]);
				    	DOF2_SetInt(file, "c_Mundo", Conta[player][c_Mundo]);
				    	DOF2_SetFloat(file, "c_X", Conta[player][c_X]);
					    DOF2_SetFloat(file, "c_Y", Conta[player][c_Y]);
					    DOF2_SetFloat(file, "c_Z", Conta[player][c_Z]);
					    DOF2_SetFloat(file, "c_A", Conta[player][c_A]);
					    DOF2_SetInt(file, "c_Vida", Conta[player][c_Vida]);
				    	DOF2_SetInt(file, "c_Fome", Conta[player][c_Fome]);
					    DOF2_SetInt(file, "c_Sede", Conta[player][c_Sede]);
					    DOF2_SetInt(file, "c_Local", Conta[player][c_Local]);
					    DOF2_SetInt(file, "c_LocalID", Conta[player][c_LocalID]);
		                DOF2_SaveFile();
	                }
	            }
	            else if(Comparar("c_Posicao", salve))
	            {
	                new player = ContaOnline(i);
	                if(Online(player))
	                {
	                    DOF2_SetInt(file, "c_Interior", Conta[player][c_Interior]);
				    	DOF2_SetInt(file, "c_Mundo", Conta[player][c_Mundo]);
				    	DOF2_SetFloat(file, "c_X", Conta[player][c_X]);
					    DOF2_SetFloat(file, "c_Y", Conta[player][c_Y]);
					    DOF2_SetFloat(file, "c_Z", Conta[player][c_Z]);
					    DOF2_SetFloat(file, "c_A", Conta[player][c_A]);
					    DOF2_SetInt(file, "c_Vida", Conta[player][c_Vida]);
				    	DOF2_SetInt(file, "c_Fome", Conta[player][c_Fome]);
					    DOF2_SetInt(file, "c_Sede", Conta[player][c_Sede]);
		                DOF2_SaveFile();
	                }
	            }
	            else if(Comparar("Metas_Empregos", salve))
	            {
	                new player = ContaOnline(i);
	                if(Online(player))
	                {
	                    new linh[500];
	                    for(new e; e<MAX_EMPREGOS; e++)
						{
						    strcat(linh, ConvertMoney(Conta[player][c_MetaEmprego][e]));
							strcat(linh, "|");
	                    }
	                    DOF2_SetString(file, "c_MetaEmprego", linh);
	                    DOF2_SetInt(file, "c_MetaHora", Conta[player][c_MetaHora]);
		                DOF2_SaveFile();
	                }
	            }
	            else if(Comparar("c_NivelEmprego", salve))
	            {
	                new player = ContaOnline(i);
	                if(Online(player))
	                {
		                new linh[500];
						for(new e; e<MAX_EMPREGOS; e++)
						{
							strcat(linh, ConvertMoney(Conta[player][c_NivelEmprego][e]));
							strcat(linh, "|");
						}
						DOF2_SetString(file, "c_NivelEmprego", linh);
		                DOF2_SaveFile();
	                }
	            }
	            else if(Comparar("c_Armas", salve))
	            {
	                if(tip == -1)
	                {
	                    new sss1[40], sss2[40];
						for(new a; a<13; a++)
						{
						    format(sss1, 40, "Arma_%d", a);
						    format(sss2, 40, "Municao_%d", a);
						    DOF2_SetInt(file, sss1, 0);
						    DOF2_SetInt(file, sss2, 0);
						}
						DOF2_SetInt(file, "c_Colete", 0);
		                DOF2_SaveFile();
	                }
	                else
	                {
	                    new player = ContaOnline(i);
		                if(Online(player))
		                {
		                    if(player_arena[player] == 0)
		                    {
					        new sss1[40], sss2[40];
								for(new a; a<13; a++)
								{
								    GetPlayerWeaponData(player, a, Conta[player][c_Arma][a], Conta[player][c_Municao][a]);
								    format(sss1, 40, "Arma_%d", a);
								    format(sss2, 40, "Municao_%d", a);
								    DOF2_SetInt(file, sss1, Conta[player][c_Arma][a]);
								    DOF2_SetInt(file, sss2, Conta[player][c_Municao][a]);
								}
								DOF2_SetInt(file, "c_Colete", Conta[player][c_Colete]);
					        DOF2_SaveFile();
		                    }
	                    }
                    }
	            }
	            else if(Comparar("Desconectou", salve))
	            {
	                new player = ContaOnline(i);
	                if(Online(player))
	                {
	                    DOF2_SetInt(file, "c_CA_Tempo", Conta[player][c_CA_Tempo]);
	                    DOF2_SetInt(file, "c_CA_Admin", Conta[player][c_CA_Admin]);
