stock temperatura_server()
{
	temperatura = 23;
	if(HORA == 20) temperatura -= 1;
	if(HORA == 21) temperatura -= 1;
	if(HORA == 22) temperatura -= 1;
	if(HORA == 23) temperatura -= 1;
	if(HORA == 0) temperatura -= 2;
	if(HORA == 1) temperatura -= 2;
	if(HORA == 2) temperatura -= 2;
	if(HORA == 3) temperatura -= 3;
	if(HORA == 4) temperatura -= 1;
	if(HORA == 5) temperatura += 1;
	if(HORA == 6) temperatura += 1;
	if(HORA == 7) temperatura -= 2;
	if(HORA == 8) temperatura -= 2;
	if(HORA == 9) temperatura -= 3;
	if(HORA == 10) temperatura -= 4;
	if(HORA == 11) temperatura -= 5;
	if(HORA == 12) temperatura -= 6;
	if(HORA == 13) temperatura -= 7;
	if(HORA == 14) temperatura -= 8;
	if(HORA == 15) temperatura -= 9;
	if(HORA == 16) temperatura -= 6;
	if(HORA == 17) temperatura -= 4;
	if(HORA == 18) temperatura -= 3;
	if(HORA == 19) temperatura -= 2;
	if(clima_atual == 1) temperatura -= 2;
	if(clima_atual == 2) temperatura -= 3;
	if(clima_atual == 3) temperatura -= 3;
	if(clima_atual == 4) temperatura -= 4;
	if(clima_atual == 5) temperatura -= 7;
	if(clima_atual == 6) temperatura -= 5;
	if(clima_atual == 8) temperatura -= 5;
	if(clima_atual == 9) temperatura -= 5;
}

stock clima_server(con)
{
	if(con == -100)
	{
		clima_atual = random(sizeof Clima);
		proximo_clima = clima_aleatorio();
	}
	else if(con == -1)
	{
	    clima_atual = proximo_clima;
		proximo_clima = clima_aleatorio();
	}
	else
	{
	    clima_atual = con;
		proximo_clima = clima_aleatorio();
	}

	foreach(new a:Player) if(Online(a)) SetPlayerWeather(a, Clima[clima_atual][clima_ID]);
	timer_clima = Clima[clima_atual][clima_Duracao]*60;
}

stock clima_aleatorio()
{
	new a = random(20);
	if(a < 3)
	{
		new ruins[20], total;
		for(new i; i<sizeof Clima; i++) if(Clima[i][clima_Duracao] <= 10) ruins[total++] = i;
		if(total > 0) return ruins[random(total)];
	}
	return random(sizeof Clima);
}

stock climas_servidor(playerid)
{
	SG[0] = EOS;
	for(new a; a<sizeof Clima; a++)
	{
	    if(clima_atual == a) strcat(SG, "{ffff00}");
	    else strcat(SG, "{ffffff}");
	    strcat(SG, Clima[a][clima_Nome]);
	    strcat(SG, "\n");
	}
	ShowPlayerDialog(playerid, DIALOG_CLIMAS, DIALOG_STYLE_LIST, "Lista de Climas", SG, "Setar", "Fechar");
}


stock meuid(playerid)
