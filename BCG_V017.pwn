		if(o < 0 || o >= MAX_GARAGEMS) return ms(playerid, 0, "ID de Garagem invalido !");
		if(Garagem[o][ga_Existe] == 0) return ms(playerid, 0, "Esta Garagem nao existe !");
		if(c < -1 || c >= MAX_EMPREGOS) return ms(playerid, 0, "ID de Emprego Invalido !");
		if(c != -1  && Emprego[c][e_Existe] == 0) return ms(playerid, 0, "Este Emprego nao existe !");
		Garagem[o][ga_Emprego] = c;
		Garagem[o][ga_Org] = -1;
		Garagem[o][ga_Dono] = -1;
		new sss[150];
		if(c != -1) format(sss, 150, "Voce setou o Emprego '%s' [%d] na Garagem ID: %d.", NomeEmprego(c), c, o);
		else format(sss, 150, "Voce removeu o Emprego da Garagem ID: %d.", o);
		ms(playerid, 5, sss);
		atualizar_garagem(o);
		salvar_garagem(o);
		return 1;
	}


