stock atualizar_cofre(i, con=0)
{
    new obj;
    new rot;
	if(con == 1)
	{
	    // apenas cofre //
	    if(IsValidDynamicObject(Cofre[i][cofre_Obj])) DestroyDynamicObject_(Cofre[i][cofre_Obj]);
		if(Cofre[i][cofre_Status] == 0) obj = 2332;
		else obj = 1829;
		Cofre[i][cofre_Obj] = CreateDynamicObject(obj, pos_cofre[0], pos_cofre[1], pos_cofre[2], 0,0,0, i, -1, -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
	}
	else if(con == 2)
	{
		// apenas a porta //
	    if(IsValidDynamicObject(Cofre[i][cofre_Obj2])) DestroyDynamicObject_(Cofre[i][cofre_Obj2]);
	    if(Cofre[i][cofre_Status2] == 0) rot = 180;
		else rot = -90;
	    Cofre[i][cofre_Obj2] = CreateDynamicObject(19799, pos_porta[0], pos_porta[1], pos_porta[2], 0,0,rot, i, -1, -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
	}
	else
	{
	    // os dois //
	    if(IsValidDynamicObject(Cofre[i][cofre_Obj])) DestroyDynamicObject_(Cofre[i][cofre_Obj]);
	    if(IsValidDynamicObject(Cofre[i][cofre_Obj2])) DestroyDynamicObject_(Cofre[i][cofre_Obj2]);
		if(Cofre[i][cofre_Status] == 0) obj = 2332;
		else obj = 1829;
		Cofre[i][cofre_Obj] = CreateDynamicObject(obj, pos_cofre[0], pos_cofre[1], pos_cofre[2], 0,0,0, i, -1, -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
    	if(Cofre[i][cofre_Status2] == 0) rot = 180;
		else rot = -90;
	    Cofre[i][cofre_Obj2] = CreateDynamicObject(19799, pos_porta[0], pos_porta[1], pos_porta[2], 0,0,rot, i, -1, -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
	}
}

