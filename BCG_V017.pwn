	        else if(strlen(inputtext) > 190) escrever_menssagem_vip(playerid, 2);
	        else if(palavra_grande(inputtext)) escrever_menssagem_vip(playerid, 3);
	        else
			{
	            escrever_converssa_vip(playerid, inputtext);
	        }
	    }
	    return 1;
	}

	// DIALOG ESCREVER WHATSAPP //
	if(dialogid == DIALOG_ESCREVER)
	{
	    if(response)
	    {
	        if(strlen(inputtext) < 1) escrever_menssagem(playerid, 1);
	        else if(strlen(inputtext) > 190) escrever_menssagem(playerid, 2);
	        else if(palavra_grande(inputtext)) escrever_menssagem(playerid, 3);
	        else
			{
				new con = id_converssa[playerid];
		        if(con == -1)
		        {
		            new conts = conta_converssa[playerid];
		            if(conts != -1)
		            {
				    new conv = tem_converssa(c, conts);
				    if(conv == -1)
					{
				        new convf = criar_converssa(playerid, conts);
				        if(!escrever_converssa(playerid, convf, inputtext))
				        {
				            abrir_whatsapp(playerid);
						    format(str_aviso[playerid], 300, "Esta converssa foi apagada, ou esta temporariamente indisponivel !");
					    		SetPVarInt(playerid, "aviso", C_LISTA);
					    		celular(playerid, C_ERRO);
				        }
						if(!abrir_converssa(playerid, convf))
						{
						    abrir_whatsapp(playerid);
						    format(str_aviso[playerid], 300, "Esta converssa foi apagada, ou esta temporariamente indisponivel !");
					    		SetPVarInt(playerid, "aviso", C_LISTA);
					    		celular(playerid, C_ERRO);
						}
				    }
				    else
					{
				        if(!escrever_converssa(playerid, conv, inputtext))
				        {
				            abrir_whatsapp(playerid);
						    format(str_aviso[playerid], 300, "Esta converssa foi apagada, ou esta temporariamente indisponivel !");
					    		SetPVarInt(playerid, "aviso", C_LISTA);
					    		celular(playerid, C_ERRO);
				        }
						if(!abrir_converssa(playerid, conv))
						{
						    abrir_whatsapp(playerid);
						    format(str_aviso[playerid], 300, "Esta converssa foi apagada, ou esta temporariamente indisponivel !");
					    		SetPVarInt(playerid, "aviso", C_LISTA);
					    		celular(playerid, C_ERRO);
						}
				    }
		            }
		            else abrir_whatsapp(playerid);
		        }
		        else
		        {
                    if(!escrever_converssa(playerid, con, inputtext))
	                {
	                    abrir_whatsapp(playerid);
				    format(str_aviso[playerid], 300, "Esta converssa foi apagada, ou esta temporariamente indisponivel !");
			    		SetPVarInt(playerid, "aviso", C_LISTA);
			    		celular(playerid, C_ERRO);
	                }
		        	if(!abrir_converssa(playerid, con))
				{
				    abrir_whatsapp(playerid);
				    format(str_aviso[playerid], 300, "Esta converssa foi apagada, ou esta temporariamente indisponivel !");
			    		SetPVarInt(playerid, "aviso", C_LISTA);
			    		celular(playerid, C_ERRO);
				}
				}
			}
	    }
	    return 1;
	}


	// dialog escolher um concerto eletricista //
	if(dialogid == DIALOG_ELETRICISTA)
	{
	    if(response)
	    {
	        new idd = Lista[playerid][listitem];
	        new tipo = Lista2[playerid][listitem];

	        // caixas eletronicos //
	        if(tipo == 0)
	        {
                Localizar_Player(playerid, CaixaEletronico[idd][ce_X], CaixaEletronico[idd][ce_Y], CaixaEletronico[idd][ce_Z], 66, idd, "CAIXA ELETRONICO");
				ms(playerid, 3, "O Caixa Eletronico foi marcado em seu mapa.");
				ms(playerid, 3, "Chegando ao local, aperte H proximo a ele para comecar a concertar.");
				ms(playerid, 3, "Se o local for auto, use ALT proximo ao seu veiculo para usar a escada.");
			}

	        // radares //
	        if(tipo == 1)
	        {
                Localizar_Player(playerid, Radar[idd][radar_X], Radar[idd][radar_Y], Radar[idd][radar_Z], 67, idd, "RADAR");
				ms(playerid, 3, "O Radar foi marcado em seu mapa.");
				ms(playerid, 3, "Chegando ao local, aperte H proximo a ele para comecar a concertar.");
				ms(playerid, 3, "Se o local for auto, use ALT proximo ao seu veiculo para usar a escada.");
	        }

	        // cameras //
	        if(tipo == 2)
	        {
                Localizar_Player(playerid, Camera[idd][cam_X], Camera[idd][cam_Y], Camera[idd][cam_Z], 68, idd, "CAMERA DE SEGURANCA");
				ms(playerid, 3, "A Camera de seguranca foi marcada em seu mapa.");
				ms(playerid, 3, "Chegando ao local, aperte H proximo a ela para comecar a concertar.");
				ms(playerid, 3, "Se o local for auto, use ALT proximo ao seu veiculo para usar a escada.");
	        }

	        // cameras dos caixas //
	        if(tipo == 3)
	        {
                Localizar_Player(playerid, CaixaEletronico[idd][cec_X], CaixaEletronico[idd][cec_Y], CaixaEletronico[idd][cec_Z], 69, idd, "CAMERA DO CAIXA");
				ms(playerid, 3, "A Camera do Caixa foi marcada em seu mapa.");
				ms(playerid, 3, "Chegando ao local, aperte H proximo a ela para comecar a concertar.");
				ms(playerid, 3, "Se o local for auto, use ALT proximo ao seu veiculo para usar a escada.");
	        }
	    }
	    return 1;
	}

	// dialog escada veiculo //
	if(dialogid == DIALOG_ESCADA)
	{
		if(response)
	    {
	        new a = GetPVarInt(playerid, "veic");
	        if(listitem == 5) menu_escada(playerid, a, -1);
	        else menu_escada(playerid, a, listitem);
	    }
	    return 1;
	}

	// DIALOG LAVAR GRANA SUJA //
	if(dialogid == DIALOG_LAVAR)
	{
	    if(response)
	    {
            Acao(playerid, 13, 1000, "LAVANDO DINHEIRO", 0, "null", "null", false);
            ms(playerid, 0xffffffff, "{FF4500}[MERCADO NEGRO] {A1A1A1}Aguarde enquanto lavamos seu dinheiro ...");
		}
	    return 1;
	}

	// menu cameras //
	if(dialogid == DIALOG_MENU_CAMERA)
	{
	    if(response)
	    {
            if(listitem == 0) mostrar_cameras(playerid);
            if(listitem == 1) sair_camera(playerid);
		}
	    return 1;
	}

	// menu tunar //
	if(dialogid == DIALOG_MENU_TUNAR)
	{
	    if(response)
	    {
	        new veh = GetPVarInt(playerid, "tunando");
	        new i = Info_Veiculo[veh];
			if(i != -1)
			{
		        if(listitem == 0) Mostrar_Tuning(playerid, veh);
				if(listitem == 1) sair_tuning(playerid);
    		}
		}
	    return 1;
	}

	// solicitar atendimento //
	if(dialogid == DIALOG_ATENDIMENTOS)
	{
	    if(response)
	    {
	        new sss[10];
	        if(atendimentos_player[playerid][listitem] == -1) return comando(playerid, "/atendimentos", "");
	        format(sss, 10, "%d", atendimentos_player[playerid][listitem]);
	        comando(playerid, "/atender", sss);
	    }
	    return 1;
	}

	// solicitar atendimento //
	if(dialogid == DIALOG_ATENDIMENTO)
	{
	    if(response)
	    {
	        new cont;
	        for(new i; i<MAX_ATENDIMENTOS; i++) if(Atendimento[i][at_Existe] != 0) cont ++;
            new att = criar_atendimento(playerid, listitem);
			if(att == 0) return ms(playerid, 0, "Muitos atendimentos foram solicitados recentemente, aguarde e tente novamente !");
			if(listitem  == 0) ms(playerid, 4, "Voce solicitou um atendimento com um Administrador prioridade: BAIXA, aguarde ser atendido.");
	    	if(listitem  == 1) ms(playerid, 4, "Voce solicitou um atendimento com um Administrador prioridade: MEDIA, aguarde ser atendido.");
	    	if(listitem  == 2) ms(playerid, 4, "Voce solicitou um atendimento com um Administrador prioridade: ALTA,  aguarde ser atendido.");
	    	ms(playerid, 2, "Para cancelar seu atendimento use /encerrar.");
	    }
	    return 1;
	}

    // dialog cameras //
	if(dialogid == DIALOG_CAMERAS2)
	{
	    if(response)
	    {
	        new idc = listitem;
			new idd = Lista[playerid][idc];
	        if(!ver_camera_caixa(playerid, idd))
			{
			    ms(playerid, 0, "Esta camera esta quebrada !");
			    mostrar_cameras_caixas(playerid);
			}
	    }
	    else mostrar_cameras(playerid);
	    return 1;
	}

	// dialog cameras //
	if(dialogid == DIALOG_CAMERAS)
	{
	    if(response)
	    {
	        if(listitem == 0)
	        {
	            mostrar_cameras_caixas(playerid);
	            return 1;
	        }

			new idc = listitem-1;
			new idd = Lista[playerid][idc];
			if(!ver_camera(playerid, idd))
			{
			    ms(playerid, 0, "Esta camera esta quebrada !");
			    mostrar_cameras(playerid);
			}
	    }
	    return 1;
	}

	// tutorial //
	if(dialogid == DIALOG_TUTORIAL)
	{
	    if(response)
	    {
	        mostrar_tutorial(playerid);
	    }
	    else
	    {
	        new cc = contas[playerid];
	        carregar_conta_player(playerid, cc);
			spawn_conta(playerid);
	    }
	    return 1;
	}

	// dialog interior de casa //
	if(dialogid == DIALOG_INTERIORES)
	{
	    if(response)
	    {
	        new casa = GetPVarInt(playerid, "casa");
	        if(Casa[casa][casa_Existe] == 1)
	        {
	            if(Casa[casa][casa_Tipo] != 1)
	            {
	                Casa[casa][casa_X2] = interiores[listitem][0];
					Casa[casa][casa_Y2] = interiores[listitem][1];
					Casa[casa][casa_Z2] = interiores[listitem][2];
					Casa[casa][casa_X3] = local_bau[listitem][0];
					Casa[casa][casa_Y3] = local_bau[listitem][1];
					Casa[casa][casa_Z3] = local_bau[listitem][2];
					Casa[casa][casa_Interior] = floatround(interiores[listitem][3]);
					atualizar_casa(casa);
					salvar_casa(casa);
					new sss[150];
					format(sss, 150, "Voce escolheu o Mapa de Interior [%d] para a casa ID: %d.", listitem+1, casa);
					ms(playerid, 1, sss);
					SetPlayerPos_(playerid, Casa[casa][casa_X2]+0.1, Casa[casa][casa_Y2]+0.1, Casa[casa][casa_Z2]+0.1);
					SetPlayerInterior(playerid, Casa[casa][casa_Interior]);
					SetPlayerVirtualWorld_(playerid, Casa[casa][casa_Mundo]);
	            }
	            else ms(playerid, 0, "Apartamentos nao podem ter interior !");
	        }
	        else ms(playerid, 0, "Esta casa nao existe mais !");
	    }
	    return 1;
	}

	// informacoes de banimento //
	if(dialogid == DIALOG_BANIDO)
	{
	    new conta = GetPVarInt(playerid, "conta");
	    if(response) return Banido(playerid, conta);
	    Login(playerid);
	    return 1;
	}

	// informacoes de banimento //
	if(dialogid == DIALOG_IPBANIDO)
	{
	    if(response) ShowPlayerDialog(playerid, DIALOG_IPBANIDO, DIALOG_STYLE_MSGBOX, "{000000}_", str_ban[playerid], "Ok", "Voltar");
	    return 1;
	}

	// bau senha //
	if(dialogid == DIALOG_BAU_SENHA)
	{
	    if(response)
	    {
	        new bid = GetPVarInt(playerid, "bau_id");
	        if(Comparar(inputtext, BauI[bid][bau_Senha]))
	        {
	            ShowPlayerDialog(playerid, DIALOG_BAU_OPCOES, DIALOG_STYLE_LIST, "{ffffff}Bau", "Abrir Bau\nGuardar Item", "Selecionar", "Fechar");
	        }
	        else ms(playerid, 0, "Senha incorreta!");
	    }
	    return 1;
	}

	// bau itens //
	if(dialogid == DIALOG_BAU_ABRIR)
	{
	    if(response)
	    {
	        new bid = GetPVarInt(playerid, "bau_id");
	        new slot = listitem;
	        if(BauI_Itens[bid][slot][inv_ID] > 0)
	        {
	            new sss[300];
	            format(sss, 300, "{ffffff}Item: {ffff00}%s\n{ffffff}Quantidade: {4169E1}%d\n\n{ff0000}Deseja pegar este item do bau?", NomeItem(BauI_Itens[bid][slot][inv_ID], BauI_Itens[bid][slot][inv_Tipo]), BauI_Itens[bid][slot][inv_Unidades]);
	            SetPVarInt(playerid, "bau_pegar", slot);
	            ShowPlayerDialog(playerid, DIALOG_BAU_PEGAR, DIALOG_STYLE_MSGBOX, "{000000}.", sss, "Pegar", "Voltar");
	        }
	        else
	        {
	            SetPVarInt(playerid, "bau_guardar_slot", slot);
	            abrir_inventario_bau(playerid, bid);
	        }
	    }
	    else abrir_bau_item(playerid, GetPVarInt(playerid, "bau_id"));
	    return 1;
	}

	// bau confirmar pegar //
	if(dialogid == DIALOG_BAU_PEGAR)
	{
	    if(response)
	    {
	        new bid = GetPVarInt(playerid, "bau_id");
	        new slot = GetPVarInt(playerid, "bau_pegar");
	        if(BauI_Itens[bid][slot][inv_ID] > 0)
	        {
	            new cc3 = id[playerid];
	            if(cc3 != -1)
	            {
	                add_inv(cc3, BauI_Itens[bid][slot][inv_ID], BauI_Itens[bid][slot][inv_Unidades], BauI_Itens[bid][slot][inv_Tipo], BauI_Itens[bid][slot][inv_Ativo], BauI_Itens[bid][slot][inv_Tempo]);
	                BauI_Itens[bid][slot][inv_ID] = 0;
	                BauI_Itens[bid][slot][inv_Unidades] = 0;
	                BauI_Itens[bid][slot][inv_Tipo] = 0;
	                BauI_Itens[bid][slot][inv_Ativo] = 0;
	                BauI_Itens[bid][slot][inv_Tempo] = 0;
	                salvar_bau_item(bid);
	                ms(playerid, 1, "Item retirado do bau!");
	            }
	        }
	        abrir_bau_item(playerid, bid);
	    }
	    else abrir_bau_item(playerid, GetPVarInt(playerid, "bau_id"));
	    return 1;
	}

	// bau guardar item (selecao do inventario) //
	if(dialogid == DIALOG_BAU_GUARDAR)
	{
	    if(response)
	    {
	        new bid = GetPVarInt(playerid, "bau_id");
	        if(bid >= 0 && bid < MAX_BAUS && BauI[bid][bau_Existe] == 1)
	        {
	            new inv_slot = Lista[playerid][listitem];
	            if(inv_slot >= 0 && inv_slot < MAX_SLOTS && Inventario[playerid][inv_slot][inv_ID] > 0)
	            {
	                if(BauI[bid][bau_Slots] < 1) BauI[bid][bau_Slots] = 10;
	                for(new s; s<BauI[bid][bau_Slots]; s++)
	                {
	                    if(BauI_Itens[bid][s][inv_ID] == 0)
	                    {
	                        BauI_Itens[bid][s][inv_ID] = Inventario[playerid][inv_slot][inv_ID];
	                        BauI_Itens[bid][s][inv_Unidades] = Inventario[playerid][inv_slot][inv_Unidades];
	                        BauI_Itens[bid][s][inv_Tipo] = Inventario[playerid][inv_slot][inv_Tipo];
	                        BauI_Itens[bid][s][inv_Ativo] = Inventario[playerid][inv_slot][inv_Ativo];
	                        BauI_Itens[bid][s][inv_Tempo] = Inventario[playerid][inv_slot][inv_Tempo];
	                        Inventario[playerid][inv_slot][inv_ID] = 0;
	                        Inventario[playerid][inv_slot][inv_Unidades] = 0;
	                        Inventario[playerid][inv_slot][inv_Tipo] = 0;
	                        Inventario[playerid][inv_slot][inv_Ativo] = 0;
	                        Inventario[playerid][inv_slot][inv_Tempo] = 0;
	                        salvar_inventario(id[playerid], inv_slot);
	                        salvar_bau_item(bid);
	                        ms(playerid, 1, "Item guardado no bau!");
	                        abrir_bau_item(playerid, bid);
	                        return 1;
	                    }
	                }
	                ms(playerid, 0, "Bau cheio!");
	            }
	        }
	    }
	    else abrir_bau_item(playerid, GetPVarInt(playerid, "bau_id"));
	    return 1;
	}

	// bau opcoes //
	if(dialogid == DIALOG_BAU_OPCOES)
	{
	    if(response)
	    {
	        new bid = GetPVarInt(playerid, "bau_id");
	        if(listitem == 0)
	        {
	            abrir_bau_item(playerid, bid);
	        }
        else if(listitem == 1)
        {
            abrir_bau_guardar(playerid, bid);
        }
	    }
	    return 1;
	}

	// dialog de aceitar abordagem //
	if(dialogid == DIALOG_ABORDAGEM)
	{
	    if(response) resposta_abordagem(playerid, 1);
	    else resposta_abordagem(playerid, 0);
	    return 1;
	}

	// dialog apagar conta //
	if(dialogid == DIALOG_APAGAR_CONTA)
	{
	    new cc = GetPVarInt(playerid, "cc");
	    if(response)
	    {
	        apagar_conta(cc);
			ms(playerid, 1, "Conta apagada com sucesso !");
			continuar_lista_contas(playerid);
	    }
	    else opcoes_conta(playerid, cc);
	    return 1;
	}

	// dialog trocar senha no lobby erro //
	if(dialogid == DIALOG_TROCAR_SENHA_ERRO)
	{
	    new cc = GetPVarInt(playerid, "cc");
	    new opc = GetPVarInt(playerid, "opcao");
	    abrir_trocar_senha(playerid, cc, opc);
	    return 1;
	}

	// dialog trocar senha no lobby //
	if(dialogid == DIALOG_TROCAR_SENHA)
	{
	    new cc = GetPVarInt(playerid, "cc");
	    new opc = GetPVarInt(playerid, "opcao");
	    if(response)
	    {
	        if(response)
	        {
	            // senha atual //
	            if(opc == 0)
	            {
                    if(strlen(inputtext) < 4 || strlen(inputtext) > 12)
					{
					    ShowPlayerDialog(playerid, DIALOG_TROCAR_SENHA_ERRO, DIALOG_STYLE_MSGBOX, "SENHA INCORRETA", "{ff0000}[ERRO] {a1a1a1}Voce digitou sua senha atual errada ! Tente tovamente.", "Ok", "Voltar");
					    return 1;
					}

					if(!Comparar(inputtext,  GetContaString(cc, "c_Senha")))
					{
					    ShowPlayerDialog(playerid, DIALOG_TROCAR_SENHA_ERRO, DIALOG_STYLE_MSGBOX, "SENHA INCORRETA", "{ff0000}[ERRO] {a1a1a1}Voce digitou sua senha atual errada ! Tente tovamente.", "Ok", "Voltar");
					    return 1;
					}
					abrir_trocar_senha(playerid, cc, 1);
					return 1;
	            }

	            // nova senha //
	            if(opc == 1)
	            {
                    if(strlen(inputtext) < 4 || strlen(inputtext) > 12)
					{
					    ShowPlayerDialog(playerid, DIALOG_TROCAR_SENHA_ERRO, DIALOG_STYLE_MSGBOX, "SENHA NAO COMPATIVEL", "{ff0000}[ERRO] {a1a1a1}Sua senha deve conter de 4 a 12 caracteres !", "Ok", "Voltar");
					    return 1;
					}
					format(nova_senha[playerid], 20, inputtext);
                    abrir_trocar_senha(playerid, cc, 2);
                    return 1;
	            }

	            // confirmar nova senha //
	            if(opc == 2)
	            {
                    if(strlen(inputtext) < 4 || strlen(inputtext) > 12)
					{
					    ShowPlayerDialog(playerid, DIALOG_TROCAR_SENHA_ERRO, DIALOG_STYLE_MSGBOX, "SENHAS DESIGUAIS", "{ff0000}[ERRO] {a1a1a1}As senhas nao estao iguais, digite a nova senha corretamente.", "Ok", "Voltar");
					    return 1;
					}

					if(!Comparar(inputtext, nova_senha[playerid]))
					{
					    ShowPlayerDialog(playerid, DIALOG_TROCAR_SENHA_ERRO, DIALOG_STYLE_MSGBOX, "SENHAS DESIGUAIS", "{ff0000}[ERRO] {a1a1a1}As senhas nao estao iguais, digite a nova senha corretamente.", "Ok", "Voltar");
					    return 1;
					}

					new sss[150];
					format(sss, 150, "\n[INFO] {a1a1a1}Senha alterada com sucesso !\n\n{ffffff}Nova senha: {ffff00}%s", nova_senha[playerid]);
                    salvar_conta(cc, 2, "c_Senha", nova_senha[playerid]);
                    ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "TROCA CONCLUIDA", sss, "Ok", "Fechar");
	            }
	        }
	    }
	    return 1;
	}

	// TROCAR nick criar UMA conta //
	if(dialogid == DIALOG_MUDAR_SENHA)
	{
	    new cc = GetPVarInt(playerid, "cc");
	    if(response)
	    {
			if(strlen(inputtext) < 4 || strlen(inputtext) > 12)
			{
			    ms(playerid, 0, "A Senha deve ter de 4 a 12 caracteres !");
	        	trocar_senha_conta(playerid);
	        	return 1;
			}

			new player = ContaOnline(cc);
			if(Online(player)) format(Conta[player][c_Senha], MAX_PLAYER_NAME, inputtext);
			salvar_conta(cc, 2, "c_Senha", inputtext);
	   		new sss[150];
		   	format(sss, 150, "Voce mudou a Senha da conta ID: %d para '%s'.", cc, inputtext);
		   	continuar_lista_contas(playerid);
			opcoes_conta(playerid, cc);
			ms(playerid, 1, sss);
	    }
	    else opcoes_conta(playerid, cc);
	    return 1;
	}

	// TROCAR nick criar UMA conta //
	if(dialogid == DIALOG_MUDAR_NICK)
	{
	    new cc = GetPVarInt(playerid, "cc");
	    if(!response) return opcoes_conta(playerid, cc);

	    if(strlen(inputtext) < 3 || strlen(inputtext) > 20)
	    {
	        ms(playerid, 0, "O Nick deve ter de 3 a 20 caracteres !");
	        trocar_nick_conta(playerid);
	        return 1;
	    }

	    if(!VerificarNick(inputtext))
	    {
	    	ms(playerid, 0, "O Nick nao pode ter caracteres especiais e nem espaco !");
	        trocar_nick_conta(playerid);
	        return 1;
	    }

		if(nick_existe(inputtext))
		{
  			ms(playerid, 0, "Este Nick ja esta em uso !");
	        trocar_nick_conta(playerid);
		    return 1;
		}

		// continuar mudar nick
		new sss[150];
		new file[40];
		new file1[40];
		format(file, 40, "Nicks/%s.txt", NomeConta(cc));
		format(file1, 40, "Nicks/%s.txt", inputtext);
		DOF2_RenameFile(file, file1);
		new player = ContaOnline(cc);
		if(Online(player))
		{
			format(Conta[player][c_Nick], MAX_PLAYER_NAME, inputtext);
			SetarNickPlayer(player);
		}
		salvar_conta(cc, 2, "c_Nick", inputtext);
	   	format(sss, 150, "Voce mudou o Nick da conta ID: %d para '%s'.", cc, nick_pesquisar[playerid]);
	   	continuar_lista_contas(playerid);
		opcoes_conta(playerid, cc);
		ms(playerid, 1, sss);
	    return 1;
	}


	// OPCOES DE EDITAR CONTA //
	if(dialogid == DIALOG_OPCOES_CONTA)
	{
	    if(response)
	    {
	        new cc = GetPVarInt(playerid, "cc");
	        // mudar nick //
	        if(listitem == 0)
	        {
                trocar_nick_conta(playerid);
                return 1;
	        }

	        // mudar senha //
	        if(listitem == 1)
	        {
	            if(AdminConta(cc) > 0)
				{
					ms(playerid, 0, "Voce nao pode trocar a senha de um administrador !");
					opcoes_conta(playerid, cc);
					return 1;
				}
                trocar_senha_conta(playerid);
                return 1;
	        }

	        // mudar sexo //
	        if(listitem == 2)
	        {
	            new sss[150];
				new player = ContaOnline(cc);
				if(Online(player))
				{
				    if(Conta[player][c_Sexo] == 0) Conta[player][c_Sexo] = 1;
					else Conta[player][c_Sexo] = 0;
					format(sss, 150, "Voce setou o Sexo da Conta ID: %d, para '%s'.", cc, sexo(Conta[player][c_Sexo]));
				}
				else
				{
				    if(GetContaInt(cc, "c_Sexo") == 0) salvar_conta(cc, 0, "c_Sexo", sv_int(1));
				    else salvar_conta(cc, 0, "c_Sexo", sv_int(0));
				    format(sss, 150, "Voce setou o Sexo da Conta ID: %d, para '%s'.", cc, sexo(GetContaInt(cc, "c_Sexo")));
				}
				ms(playerid, 1, sss);
				opcoes_conta(playerid, cc);
                return 1;
	        }

	        // mudar cidade //
	        if(listitem == 3)
	        {
	            new sss[150];
	            new player = ContaOnline(cc);
				if(Online(player))
				{
				    if(Conta[player][c_Cidade] == 0) Conta[player][c_Cidade] = 1;
					else if(Conta[player][c_Cidade] == 1) Conta[player][c_Cidade] = 2;
					else if(Conta[player][c_Cidade] == 2) Conta[player][c_Cidade] = 0;
				    format(sss, 150, "Voce setou a Cidade da Conta ID: %d, para '%s'.", cc, cidade(Conta[player][c_Cidade]));
				}
				else
				{
				    if(GetContaInt(cc, "c_Cidade") == 0) salvar_conta(cc, 0, "c_Cidade", sv_int(1));
				    else if(GetContaInt(cc, "c_Cidade") == 1) salvar_conta(cc, 0, "c_Cidade", sv_int(2));
				    else if(GetContaInt(cc, "c_Cidade") == 2) salvar_conta(cc, 0, "c_Cidade", sv_int(0));
				    format(sss, 150, "Voce setou a Cidade da Conta ID: %d, para '%s'.", cc, cidade(GetContaInt(cc, "c_Cidade")));
				}

				ms(playerid, 1, sss);
				opcoes_conta(playerid, cc);
                return 1;
	        }

	        // apagar conta //
	        if(listitem == 4)
	        {
				abrir_apagar_conta(playerid);
	        }
	    }
	    return 1;
	}

	// pesquisar offline //
	if(dialogid == DIALOG_PESQUISAR2)
	{
	    if(!response) return abrir_contas(playerid);

	    if(!IsNumeric(inputtext))
	    {
	        pesquisar_offline(playerid);
		    ms(playerid, 0, "Digite apenas numeros !");
	        return 1;
		}

	    if(strval(inputtext) < 0)
		{
		    pesquisar_offline(playerid);
		    ms(playerid, 0, "Use um numero maior que 0 !");
		    return 1;
		}

		continuar_contas_offline(playerid, inputtext);
	    return 1;
	}

	// pesquisar nick //
	if(dialogid == DIALOG_PESQUISAR)
	{
	    if(!response) return abrir_contas(playerid);
	    if(strlen(inputtext) < 3)
		{
		    pesquisar_nick(playerid);
		    ms(playerid, 0, "Digite no minimo 3 caracteres no campo de pesquisa !");
		    return 1;
		}
		continuar_contas_nick(playerid, inputtext);
	    return 1;
	}

	// OPCOES CONTAS //
	if(dialogid == DIALOG_CONTAS)
	{
	    if(response)
	    {
	        // lista de contas //
	        if(listitem == 0)
	        {
	            lista_contas_player[playerid] = 0;
	            continuar_lista_contas(playerid);
	        }
	        if(listitem == 1)
	        {
	            lista_contas_player[playerid] = 1000;
	            continuar_lista_contas(playerid);
	        }
	        if(listitem == 2)
	        {
	            lista_contas_player[playerid] = 2000;
	            continuar_lista_contas(playerid);
	        }

	        // pesquisar nick //
	        if(listitem == 3)
	        {
	            pesquisar_nick(playerid);
	        }

	        // dias offline //
	        if(listitem == 4)
	        {
	            pesquisar_offline(playerid);
	        }

	        // dias offline //
	        if(listitem == 5)
	        {
	            continuar_contas_banidas(playerid);
	        }
	    }
	    return 1;
	}

    // nick de criar conta //
	if(dialogid == DIALOG_IDADE)
	{
	    if(!response) return dialog_criar_conta(playerid);

		if(strlen(inputtext) < 2)
		{
		    ms(playerid, 0, "Use uma idade maior ou igual a 18 !");
	        definir_idade(playerid);
		    return 1;
		}

		if(!IsNumeric(inputtext))
		{
		    ms(playerid, 0, "Use apenas numeros !");
	        definir_idade(playerid);
		    return 1;
		}

		new num = strval(inputtext);
		if(num < 18 || num > 60)
		{
		    ms(playerid, 0, "Use uma idade de 18 a 60 !");
	        definir_idade(playerid);
		    return 1;
		}

		CriarConta[playerid][cc_Idade] = num;
		dialog_criar_conta(playerid);
		ms(playerid, 1, "Idade definida, prossiga com a criacao da conta.");
		return 1;
	}

	// nick de criar conta //
	if(dialogid == DIALOG_ERRO_NICK)
	{
	    definir_nick_lobby(playerid);
	    return 1;
	}

	// SENHA de criar conta //
	if(dialogid == DIALOG_ERRO_SENHA)
	{
	    definir_senha_lobby(playerid);
	    return 1;
	}

	// senha de criar conta //
	if(dialogid == DIALOG_SENHA_LOBBY)
	{
	    if(!response) return 1;
	    if(strlen(inputtext) < 4 || strlen(inputtext) > 12) ShowPlayerDialog(playerid, DIALOG_ERRO_SENHA, DIALOG_STYLE_MSGBOX, "{000000}.", "{ff0000}[ERRO] {a1a1a1}A senha deve ter de 4 a 12 caracteres !", "OK", "Voltar");
		else if(!VerificarSenha(inputtext, strlen(inputtext))) ShowPlayerDialog(playerid, DIALOG_ERRO_SENHA, DIALOG_STYLE_MSGBOX, "{000000}.", "{ff0000}[ERRO] {a1a1a1}Use apenas letras ou numeros !", "OK", "Voltar");
	    else
		{
			format(CriarConta[playerid][cc_Senha], MAX_PLAYER_NAME, inputtext);
	    	atualizar_criar_conta(playerid);
	    }
	    return 1;
	}

	// nick de criar conta //
	if(dialogid == DIALOG_NICK_LOBBY)
	{
	    if(!response) return 1;
	    if(strlen(inputtext) < 5 || strlen(inputtext) > 20) ShowPlayerDialog(playerid, DIALOG_ERRO_NICK, DIALOG_STYLE_MSGBOX, "{000000}.", "{ff0000}[ERRO] {a1a1a1}O Nick deve ter de 5 a 20 caracteres !", "OK", "Voltar");
	    else if(!VerificarNick(inputtext)) ShowPlayerDialog(playerid, DIALOG_ERRO_NICK, DIALOG_STYLE_MSGBOX, "{000000}.", "{ff0000}[ERRO] {a1a1a1}O Nick nao pode ter caracteres especiais e nem espaco !", "OK", "Voltar");
		else if(nick_existe(inputtext)) ShowPlayerDialog(playerid, DIALOG_ERRO_NICK, DIALOG_STYLE_MSGBOX, "{000000}.", "{ff0000}[ERRO] {a1a1a1}Ja existe uma conta com este nick !", "OK", "Voltar");
		else
		{
		    format(CriarConta[playerid][cc_Nick], MAX_PLAYER_NAME, inputtext);
			atualizar_criar_conta(playerid);
		}
	    return 1;
	}

    // nick de criar conta //
	if(dialogid == DIALOG_NICK)
	{
	    if(!response) return dialog_criar_conta(playerid);

	    if(strlen(inputtext) < 3 || strlen(inputtext) > 20)
	    {
	        ms(playerid, 0, "O Nick deve ter de 3 a 20 caracteres !");
	        definir_nick(playerid);
	        return 1;
	    }

	    if(!VerificarNick(inputtext))
	    {
	    	ms(playerid, 0, "O Nick nao pode ter caracteres especiais e nem espaco !");
	        definir_nick(playerid);
	        return 1;
	    }

		if(nick_existe(inputtext))
		{
		    ms(playerid, 0, "Ja existe uma conta com este nick !");
	        definir_nick(playerid);
	        return 1;
		}

		

	   	format(CriarConta[playerid][cc_Nick], MAX_PLAYER_NAME, inputtext);
		dialog_criar_conta(playerid);
		ms(playerid, 1, "Nick disponivel, prossiga com a criacao da conta.");
	    return 1;
	}

    // dialog criar conta //
	if(dialogid == DIALOG_CC)
	{
	    if(response)
	    {
	        // nick //
	        if(listitem == 0)
	        {
				definir_nick(playerid);
				return 1;
	        }

	        // cidade //
	        if(listitem == 1)
	        {
                if(CriarConta[playerid][cc_Cidade] == 0) CriarConta[playerid][cc_Cidade] = 1;
                else if(CriarConta[playerid][cc_Cidade] == 1) CriarConta[playerid][cc_Cidade] = 2;
                else if(CriarConta[playerid][cc_Cidade] == 2) CriarConta[playerid][cc_Cidade] = 0;
                dialog_criar_conta(playerid);
                ms(playerid, 1, "Cidade natal da conta alterada, prossiga com a criacao da conta.");
                return 1;

	        }

	        // sexo //
	        if(listitem == 2)
	        {
                if(CriarConta[playerid][cc_Sexo] == 0) CriarConta[playerid][cc_Sexo] = 1;
                else CriarConta[playerid][cc_Sexo] = 0;
                dialog_criar_conta(playerid);
                ms(playerid, 1, "Sexo da conta alterado, prossiga com a criacao da conta.");
                return 1;
	        }


	        // idade //
	        if(listitem == 3)
	        {
                definir_idade(playerid);
                return 1;
	        }


	        // CRIAR CONTA //
	        if(listitem == 4) return dialog_criar_conta(playerid);
	        if(listitem == 5)
	        {
	            if(!VerificarNick(CriarConta[playerid][cc_Nick]))
	            {
	                ms(playerid, 0, "Este nick nao responde aos requisitos !");
	                dialog_criar_conta(playerid);
	                return 1;
	            }

	            

 	            new cc = criar_conta(CriarConta[playerid][cc_Nick], CriarConta[playerid][cc_Cidade], CriarConta[playerid][cc_Sexo], CriarConta[playerid][cc_Idade], -1, "nada123", -1);
				if(cc != -1)
				{
				    
				    // stop na musica //
				    new sss[500];
				    format(sss, 500, "\n\n{ffffff}Conta ID: {00ffff}%d {ffffff}criada com sucesso.\n\n{a1a1a1}Nick: {ffffff}%s\n\
					{a1a1a1}Senha: '{ffff00}%s{a1a1a1}'\n\n\
					{ffff00}[INFO] {a1a1a1}Guarde bem essas informacoes, elas serao\n\
					nescessarias na Hora de logar no servidor !\n\
					Se for preciso, tire uma PRINT da tela.\n\n", cc, NomeConta(cc), GetContaString(cc, "c_Senha"));
				    ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}_", sss, "Ok", "Fechar");
				}
				else ms(playerid, 0, "Numero maximo de Contas no servidor atingido !");
				return 1;
	        }
	    }
	    else ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}_", "\n{ff0000}INFO {a1a1a1}Criacao de conta cancelada !\n", "Ok", "Fechar");
	    return 1;
	}

	// dialog deposito do mercado negro //
	if(dialogid == DIALOG_DEPOSITO)
	{
	    if(response)
	    {
	        new i = Lista[playerid][listitem];
	        if(i > -1)
	        {
	            retirar_mercado_negro(playerid, i);
	        }
	        else
	        {
	            abrir_deposito(playerid);
	            ms(playerid, 0, "Voce nao tem mercadorias para retirar !");
	        }
	    }
	    return 1;
	}

	// dialog mercado negro lista //
	if(dialogid == DIALOG_MN)
	{
	    if(response)
	    {
	        menu_mercado_negro(playerid, listitem);
	    }
	    return 1;
	}

	// dialog mercado negro confirmar compra //
	if(dialogid == DIALOG_MN2)
	{
	    new a = GetPVarInt(playerid, "id_mn");
		if(response) menu_mercado_negro(playerid, -2, a);
	    else menu_mercado_negro(playerid, -1);
	    return 1;
	}

	// dialog auto escola renovar //
	if(dialogid == DIALOG_AUTO_ESCOLA2)
	{
	    if(c == -1) return 1;
	    if(response)
	    {
	        new valor_total =GetPVarInt(playerid, "valor_total");
	        if(GranaPlayer(playerid) < valor_total)
	        {
	            new sss[150];
	            format(sss, 150, "Voce nao tem R$ %s em maos para pagar a renovacao !", ConvertMoney(valor_total));
	            ms(playerid, 0, sss);
				return 1;
			}
			renovar_auto_escola(playerid, 1);
			DarGrana(playerid, -valor_total);
	    }
	    return  1;
	}

	// dialog procurados //
	if(dialogid == DIALOG_PROCURADOS)
	{
	    if(response)
	    {
			new i = Lista2[playerid][listitem];
	        if(i == -1)
	        {
	            mostrar_procurados(playerid);
	            ms(playerid, 0, "Nenhum procurado Online no momento !");
				return 1;
	        }

	        if(id[i] == -1)
	        {
	            mostrar_procurados(playerid);
	            ms(playerid, 0, "Este Jogador nao esta mais Online !");
				return 1;
	        }

	        if(Conta[i][c_Procurado] == 0)
	        {
	            mostrar_procurados(playerid);
	            ms(playerid, 0, "Este Jogador nao esta mais sendo procurado !");
				return 1;
	        }

	        comando(playerid, "/procurar", f("d",i));
	    }
	    return 1;
	}

	// compras de certa casa  //
	if(dialogid == DIALOG_CASAS_COMPRAS4)
	{
        new i = comprando_moveis[playerid];
        if(response)
        {
            if(i == -1)  mostrar_compras_casas(playerid);
            else
            {
	            if(Casa[i][casa_Existe] == 0)
				{
				    comprando_moveis[playerid] = -1;
					mostrar_compras_casas(playerid);
					ms(playerid, 0, "Esta casa ou apartamento nao existe mais !");
					return 1;
				}

				if(Casa[i][casa_Dono] != c)
				{
				    comprando_moveis[playerid] = -1;
					mostrar_compras_casas(playerid);
					ms(playerid, 0, "Voce nao e mais o dono desta casa ou apartamento !");
					return 1;
				}

				if(Compras[i][com_Existe] == 0)
				{
				    comprando_moveis[playerid] = -1;
					mostrar_compras_casas(playerid);
					ms(playerid, 0, "As compras ainda nao foram iniciadas !");
					return 1;
				}

				new a = Lista2[playerid][listitem];
				if(a == -1)  mostrar_carrinho_compras(playerid, i);
				else
				{
					new sss[150];
					new mov = Compras[i][com_Movel][a];
					format(sss, 150, "Voce removeu 1 '%s' do carrinho de compras !", moveis[mov][mov_Nome]);
		            ms(playerid, 1, sss);
		            Compras[i][com_Movel][a] = -1;
		            mostrar_carrinho_compras(playerid, i);
		            salvar_compras(i);
	            }
            }
        }
        else mostrar_compras(playerid, i);
        return 1;
    }

    // compras de certa casa  //
	if(dialogid == DIALOG_CASAS_COMPRAS2)
	{
	    new i = comprando_moveis[playerid];
	    if(response)
	    {
	        if(i == -1)
			{
				mostrar_compras_casas(playerid);
				ms(playerid, 0, "Voce nao tem uma casa ou apartamento !");
				return 1;
			}

			if(Casa[i][casa_Existe] == 0)
			{
			    comprando_moveis[playerid] = -1;
				mostrar_compras_casas(playerid);
				ms(playerid, 0, "Esta casa ou apartamento nao existe mais !");
				return 1;
			}

			if(Casa[i][casa_Dono] != c)
			{
			    comprando_moveis[playerid] = -1;
				mostrar_compras_casas(playerid);
				ms(playerid, 0, "Voce nao e mais o dono desta casa ou apartamento !");
				return 1;
			}

			if(Compras[i][com_Existe] == 0)
			{
			    comprando_moveis[playerid] = -1;
				mostrar_compras_casas(playerid);
				ms(playerid, 0, "As compras dos moveis foi cancelada, tente novamente !");
				return 1;
			}

	        // pagar e finalizar //
	        if(listitem == 0)
	        {
				if(moveis_no_carrinho(i) == 0)
				{
				    mostrar_compras(playerid, i);
				    ms(playerid, 0, "Nao tem nenhum Movel no carrinho para ser comprado !");
				    return 1;
				}

				new sss[150];
				if(Compras[i][com_Tempo] > 0)
				{
				   	mostrar_compras(playerid, i);
					format(sss, 150, "A compras ja estao no camihao, e chegarao na casa/apartamento em %s !", ConvertTime(Compras[i][com_Tempo]));
					ms(playerid, 0, sss);
					return 1;
				}

				new valor = valor_moveis(i);
				if(GranaPlayer(playerid) < valor)
				{
				    format(sss, 150, "Voce nao tem R$ %s para pagar pelos %d Moveis.", valor, moveis_no_carrinho(i));
				    ms(playerid, 0, sss);
				    mostrar_compras(playerid, i);
				    return 1;
				}

				DarGrana(playerid, -valor);
				Compras[i][com_Tempo] = DEZ_MINUTOS;
		        salvar_compras(i);
		        comprando_moveis[playerid] = -1;
		        format(sss, 150, "Voce pagou R$ %s pelos %d Moveis, eles chegarao em %s em sua residencia.", ConvertMoney(valor), moveis_no_carrinho(i), ConvertTime(Compras[i][com_Tempo]));
				ms(playerid, 5, sss);
				ms(playerid, 1, "Compra finalizada com sucesso !");
			}

			// abrir carrinho //
			if(listitem == 1)
			{
				if(moveis_no_carrinho(i) == 0)
				{
				    ms(playerid, 0, "O carrinho de compras esta vazio !");
				    mostrar_compras(playerid, i);
				    return 1;
				}
				mostrar_carrinho_compras(playerid, i);
			}

			// cancelar tudo //
			if(listitem == 2)
			{
				ShowPlayerDialog(playerid, DIALOG_CASAS_COMPRAS3, DIALOG_STYLE_MSGBOX, "Limpar Carrinho", "\n{ffff00}[INFO] {ffffff}Deseja realmente {ff0000}cancelar {ffffff}as compras ?\n{a1a1a1}Nenhum diheiro sera perdido, os moveis ainda nao foram pagos.\n", "Sim", "Voltar");
			}

	    }
	    return 1;
	}

	// limpar carrinho //
	if(dialogid == DIALOG_CASAS_COMPRAS3)
	{
	    new i = comprando_moveis[playerid];
	    if(response)
	    {
	        if(i != -1)
	        {
	            if(Compras[i][com_Existe] == 1)
	            {
                    Compras[i][com_Existe] = 0;
                    Compras[i][com_Tempo] = 0;
					for(new a; a<MAX_COMPRAS; a++) Compras[i][com_Movel][a] = -1;
					salvar_compras(i);
					comprando_moveis[playerid] = -1;
                    ms(playerid, 1, "Voce limpou o carrinho, e cancelou a compra dos moveis !");
                    mostrar_compras_casas(playerid);
	            }
	        }
	    }
	    else mostrar_compras(playerid, i);
	    return 1;
	}

	// lista de casas pra comprar movel //
	if(dialogid == DIALOG_CASAS_COMPRAS)
	{
	    if(response)
	    {
	        new i = Lista2[playerid][listitem];
	        if(i == -1)
			{
				mostrar_compras_casas(playerid);
				ms(playerid, 0, "Voce nao tem uma casa ou apartamento !");
				return 1;
			}

			if(Casa[i][casa_Existe] == 0)
			{
				mostrar_compras_casas(playerid);
				ms(playerid, 0, "Esta casa ou apartamento nao existe mais !");
				return 1;
			}

			if(Casa[i][casa_Dono] != c)
			{
				mostrar_compras_casas(playerid);
				ms(playerid, 0, "Voce nao e mais o dono desta casa ou apartamento !");
				return 1;
			}

			new sss[150];
			if(Compras[i][com_Existe] == 1 && Compras[i][com_Tempo] > 0)
			{
			   	mostrar_compras_casas(playerid);
				format(sss, 150, "A compras ja estao no camihao, e chegarao na casa/apartamento em %s !", ConvertTime(Compras[i][com_Tempo]));
			    ms(playerid, 0, sss);
				return 1;
			}
	        mostrar_compras(playerid, i);
	    }
	    return 1;
	}

    // dialog dos elevadores //
	if(dialogid == DIALOG_ELEVADOR)
	{
	    if(response)
	    {
	        new i = GetPVarInt(playerid, "elevador");
	        new a = GetPVarInt(playerid, "andar");
			if(Elevador[i][ele_Status] != 0) player_elevador(playerid, i, a);
			else
			{
				if(Elevador[i][ele_Andar] == listitem)
				{
				    player_elevador(playerid, i, a);
				    ms(playerid, 0, "O elevador ja esta no andar que voce escolheu !");
				    return 1;
				}
	            mover_elevador(i, listitem, 0);
	            ms(playerid, 1, "Andar escolhido ! Aguarde.");
            }
	    }
	    return 1;
	}

	// dialog comprar casa ou entrar //
	if(dialogid == DIALOG_ENTRAR_CASA)
	{
	    new casa = GetPVarInt(playerid, "casa");
	    new i = casa;
	    if(i < 0 || i >= MAX_CASAS) return 1;
	    if(response)
	    {
	        if(Casa[casa][casa_Existe] == 1)
	        {
	            if(IsPlayerInRangeOfPoint(playerid, 2.2, Casa[casa][casa_X1], Casa[casa][casa_Y1], Casa[casa][casa_Z1]))
	           	{
	            	if(GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld_(playerid) == 0)
	            	{

	        			// entrar //
	        			if(listitem == 0)
	        			{
		                    if(c != Casa[casa][casa_Dono] )
		                    {
		                        // se tiver trancada //
		                        if(Casa[casa][casa_Chave] == 1 && Casa[casa][casa_Dono] != -1 && Casa[casa][casa_Venda] == 0)
		                        {
		                            if(!TemChaveCasa(playerid, casa))
		                            {
		                                GameTextForPlayer(playerid, "~r~~h~CASA TRANCADA", 1500, 3);
		                                ms(playerid, 0, "Esta casa esta trancada !");
		                                mostrar_entrar_casa(playerid, i);
		                                return 1;
		                            }
		                        }
		                    }
		                    SetPlayerPos_(playerid, Casa[casa][casa_X2]+0.1, Casa[casa][casa_Y2]+0.1, Casa[casa][casa_Z2]+0.1);
							SetPlayerInterior(playerid, Casa[casa][casa_Interior]);
							SetPlayerVirtualWorld_(playerid, Casa[casa][casa_Mundo]);
							OnPlayerInteriorChange(playerid, Casa[casa][casa_Interior], 0);
							return 1;
		                }

		                // comprar //
	        			if(listitem == 1)
	        			{
	        			    if(Casa[casa][casa_Venda] == 0)
		                    {
		                        ms(playerid, 0, "Esta casa nao esta mais a venda !");
		                        return 1;
		                    }

		                    if(!PodeComprarCasa(playerid))
		                    {
		                        mostrar_entrar_casa(playerid, i);
		                        return 1;
		                    }

		                    if(Casa[casa][casa_Cash] == 1)
		                    {
		                        if(CashPlayer(playerid) < Casa[casa][casa_Valor])
		                        {
		                            mostrar_entrar_casa(playerid, i);
		                            ms(playerid, 0, "Voce nao tem Cash suficiente para comprar a casa !");
		                            return 1;
		                        }
		                    }
		                    else
		                    {
		                        if(GranaPlayer(playerid) < Casa[casa][casa_Valor])
		                        {
		                            mostrar_entrar_casa(playerid, i);
		                            ms(playerid, 0, "Voce nao tem dinheiro suficiente para comprar a casa !");
		                            return 1;
		                        }
		                    }

		                    new sss[150];
		                    if(Casa[casa][casa_Cash] == 1)
		                    {
		                        DarCash(playerid, -Casa[casa][casa_Valor]);
		                    }
		                    else
		                    {
		                        if(Casa[i][casa_Dono] != -1)
		                        {
		                            new cc = Casa[i][casa_Dono];
		                            new idd = ContaOnline(cc);
		                            if(Online(idd))
		                            {
		                                DarGrana(idd, Casa[casa][casa_Valor]);
		                            }
		                            else
		                            {
		                                new grann = GetContaInt(cc, "c_Grana");
		                                salvar_conta(cc, 0, "c_Grana", sv_int(grann+Casa[casa][casa_Valor]));
		                            }
		                        }
		                        DarGrana(playerid, -Casa[casa][casa_Valor]);
		                    }
		                    format(sss, 150, "'%s' comprou a sua casa ID: %d, no valor de %s.", Nome(playerid), casa, ConvertMoney(Casa[casa][casa_Valor]));
		                    if(Casa[i][casa_Dono] != -1) msc(Casa[i][casa_Dono], 1, sss);

		                    Casa[i][casa_Dono] = c;
		                    Casa[i][casa_Data] = 3;
	                        Casa[casa][casa_Venda] = 0;
	                        atualizar_casa(i);
	                        salvar_casa(i);
	                        if(Casa[casa][casa_Cash] == 1) format(sss, 150, "Voce comprou a casa ID: %d, por %s Cash!", casa, ConvertMoney(Casa[casa][casa_Valor]));
	                        else format(sss, 150, "Voce comprou a casa ID: %d, por R$ %s.", casa, ConvertMoney(Casa[casa][casa_Valor]));
	                        ms(playerid, 1, sss);
	                        ms(playerid, 1, "Voce pode ver suas casas usando /casas.");
	                        ms(playerid, 1, "Nao esqueca de pagar as contas de sua Casa na loterica !!!");
	                        GameTextForPlayer(playerid, "~g~~h~CASA COMPRADA !", 3500, 3);
	                        SetPlayerPos_(playerid, Casa[casa][casa_X2]+0.1, Casa[casa][casa_Y2]+0.1, Casa[casa][casa_Z2]+0.1);
							SetPlayerInterior(playerid, Casa[casa][casa_Interior]);
							SetPlayerVirtualWorld_(playerid, Casa[casa][casa_Mundo]);
							OnPlayerInteriorChange(playerid, Casa[casa][casa_Interior], 0);
		                }
		            }
		        }
	        }
	    }
	    return 1;
	}

	// TABELA DE COMBUSTIVEIS //
	if(dialogid == DIALOG_TABELA)
	{
	    if(response)
	    {
	        if(GetPVarInt(playerid, "galao") == 0)
	        {
	        	abastecer_player(playerid, listitem);
	        }
	        else
	        {
	            abastecer_galao_player(playerid, listitem);
	        }
		}
	    return 1;
	}


    // opcoes slot maquina //
	if(dialogid == DIALOG_MAQUINA3)
	{
	    new i = GetPVarInt(playerid, "maquina");
	    if(response)
	    {
	        new a = GetPVarInt(playerid, "slot");
	        new cc = Maquina[i][m_ID][a];
	        new sss[150];

	        if(Maquina[i][m_Status][a] == 1)
	        {
	         	// aumentar fabricacao //
				if(listitem == 0)
				{
				    // caixa de armas //
				    if(Maquina[i][m_Tipo][a] == 1)
					{
				    	// se nao tiver algum material suficiente //
					for(new aa; aa<4; aa++)
					{
							if(Maquina[i][m_Materiais][aa] < armas_org[cc][aa+1])
							{
							    format(sss, 150, "A maquina nao tem %s de %s para fabricar uma %s.", ConvertMoney(armas_org[cc][aa+1]), materiais[aa], nome_fabricacao(Maquina[i][m_Tipo][a], cc));
								ms(playerid, 0, sss);
								abrir_maquina_opcoes(playerid, i, a);
								return 1;
							}
					}

					// se tiver, diminuir materiais e aumentar unidade da fabricacao //
					if(Maquina[i][m_Existe] == 1)
					{
					    for(new aaa; aaa<4; aaa++) if(armas_org[cc][aaa+1] > 0) Maquina[i][m_Materiais][aaa] -= armas_org[cc][aaa+1];
				        Maquina[i][m_Tempo][a] = armas_org[cc][5];
				        Maquina[i][m_Unidades][a] += 1;
							salvar_maquina(i);
				        format(sss, 150, "Voce colocou +1 Caixa de %s para ser fabricada.", nome_arma(armas_org[cc][0]));
							ms(playerid, 1, sss);
							abrir_maquina(playerid, i);
					}
				}

				// caixa de municoes //
				    if(Maquina[i][m_Tipo][a] == 2)
					{
					// se nao tiver algum material suficiente //
					for(new aa; aa<4; aa++)
					{
							if(Maquina[i][m_Materiais][aa] < municoes_org[cc][aa+1])
							{
							    format(sss, 150, "A maquina nao tem %s de %s para fabricar uma %s.", ConvertMoney(municoes_org[cc][aa+1]), materiais[aa], nome_fabricacao(Maquina[i][m_Tipo][a], cc));
								ms(playerid, 0, sss);
								abrir_maquina_opcoes(playerid, i, a);
								return 1;
							}
					}
					// se tiver, diminuir materiais e aumentar unidade da fabricacao //
					if(Maquina[i][m_Existe] == 1)
					{
					    for(new aaa; aaa<4; aaa++) if(municoes_org[cc][aaa+1] > 0) Maquina[i][m_Materiais][aaa] -= municoes_org[cc][aaa+1];
				        Maquina[i][m_Tempo][a] = municoes_org[cc][5];
				        Maquina[i][m_Unidades][a] += 1;
							salvar_maquina(i);
				        format(sss, 150, "Voce colocou +1 Caixa de %s para ser fabricada.", nome_municao(municoes_org[cc][0]));
							ms(playerid, 1, sss);
							abrir_maquina(playerid, i);
					}
				    }

                    // caixa de coletes //
				    if(Maquina[i][m_Tipo][a] == 3)
					{
					// se nao tiver algum material suficiente //
					for(new aa; aa<4; aa++)
					{
							if(Maquina[i][m_Materiais][aa] < coletes_org[cc][aa+1])
							{
							    format(sss, 150, "A maquina nao tem %s de %s para fabricar uma Caixa de Coletes.", ConvertMoney(coletes_org[cc][aa+1]), materiais[aa]);
								ms(playerid, 0, sss);
								abrir_maquina_opcoes(playerid, i, a);
								return 1;
							}
					}
					// se tiver, diminuir materiais e aumentar unidade da fabricacao //
					if(Maquina[i][m_Existe] == 1)
					{
					    for(new aaa; aaa<4; aaa++) if(coletes_org[cc][aaa+1] > 0) Maquina[i][m_Materiais][aaa] -= coletes_org[cc][aaa+1];
				        Maquina[i][m_Tempo][a] = coletes_org[cc][5];
				        Maquina[i][m_Unidades][a] += 1;
							salvar_maquina(i);
				        format(sss, 150, "Voce colocou +1 Caixa de Coletes para ser fabricada.");
							ms(playerid, 1, sss);
							abrir_maquina(playerid, i);
					}
				    }
				}

				// cancelar fabricacao //
				if(listitem == 1)
				{
				    new uni = Maquina[i][m_Unidades][a];

                    // caixa de armas //
				    if(Maquina[i][m_Tipo][a] == 1)
					{
                        format(sss, 150, "Voce cancelou a fabricacao da %s, os materiais foram reaproveitados.", nome_fabricacao(Maquina[i][m_Tipo][a], cc));
                        ms(playerid, 1, sss);
                        for(new aa; aa<4; aa++)
                        {
                            if(armas_org[cc][aa+1] > 0)
                            {
                                Maquina[i][m_Materiais][aa] += (armas_org[cc][aa+1]*uni);
                            }
                        }
                        Maquina[i][m_Status][a] = 0;
		                Maquina[i][m_Unidades][a] = 0;
		                Maquina[i][m_Tipo][a] = 0;
		                Maquina[i][m_ID][a] = 0;
		                Maquina[i][m_Tempo][a] = 0;
						salvar_maquina(i);
						abrir_maquina(playerid, i);
					}

					// caixa de municoes //
				    if(Maquina[i][m_Tipo][a] == 2)
					{
                        format(sss, 150, "Voce cancelou a fabricacao da %s, os materiais foram reaproveitados.", nome_fabricacao(Maquina[i][m_Tipo][a], cc));
                        ms(playerid, 1, sss);
                        for(new aa; aa<4; aa++)
                        {
                            if(municoes_org[cc][aa+1] > 0)
                            {
                                Maquina[i][m_Materiais][aa] += (municoes_org[cc][aa+1]*uni);
                            }
                        }
                        Maquina[i][m_Status][a] = 0;
		                Maquina[i][m_Unidades][a] = 0;
		                Maquina[i][m_Tipo][a] = 0;
		                Maquina[i][m_ID][a] = 0;
		                Maquina[i][m_Tempo][a] = 0;
						salvar_maquina(i);
						abrir_maquina(playerid, i);
					}

					// caixa de coletes //
				    if(Maquina[i][m_Tipo][a] == 3)
					{
                        format(sss, 150, "Voce cancelou a fabricacao da Caixa de coletes, os materiais foram reaproveitados.");
                        ms(playerid, 1, sss);
                        for(new aa; aa<4; aa++)
                        {
                            if(coletes_org[cc][aa+1] > 0)
                            {
                                Maquina[i][m_Materiais][aa] += (coletes_org[cc][aa+1]*uni);
                            }
                        }
                        Maquina[i][m_Status][a] = 0;
		                Maquina[i][m_Unidades][a] = 0;
		                Maquina[i][m_Tipo][a] = 0;
		                Maquina[i][m_ID][a] = 0;
		                Maquina[i][m_Tempo][a] = 0;
						salvar_maquina(i);
						abrir_maquina(playerid, i);
					}
				}
			}
			else
			{
			    ms(playerid, 0, "Parece que esta fabricacao ja terminou, tente novamente !");
				abrir_maquina(playerid, i);
			}
	    }
	    else abrir_maquina(playerid, i);
	    return 1;
	}









	// fabricar maquina //
	if(dialogid == DIALOG_MAQUINA2)
	{
	    new i = GetPVarInt(playerid, "maquina");
	    new a = GetPVarInt(playerid, "slot");
	    if(response)
	    {
	        // armas //
			if(listitem == 0)
			{
				mostrar_armas_maquina(playerid);
			}
			// municoes //
			else if(listitem == 1)
			{
                mostrar_municoes_maquina(playerid);
			}
			// coletes //
			else if(listitem == 2)
			{
				new sss[150];
				new cc = 0;
		        for(new aa; aa<4; aa++)
		        {
					if(Maquina[i][m_Materiais][aa] < coletes_org[cc][aa+1])
					{
					    format(sss, 150, "A maquina nao tem %s de %s para fabricar um Colete.", ConvertMoney(coletes_org[cc][aa+1]), materiais[aa]);
						ms(playerid, 0, sss);
						abrir_maquina_fabricar(playerid, i, a);
						return 1;
					}
		        }
		        for(new aaa; aaa<4; aaa++) if(coletes_org[cc][aaa+1] > 0) Maquina[i][m_Materiais][aaa] -= coletes_org[cc][aaa+1];
                Maquina[i][m_Status][a] = 1;
                Maquina[i][m_Tipo][a] = 3;
                Maquina[i][m_Tempo][a] = coletes_org[cc][5];
                Maquina[i][m_ID][a] = 0;
                Maquina[i][m_Unidades][a] = 1;
				salvar_maquina(i);
                format(sss, 150, "Voce colocou 1 Colete para ser fabricado.");
				ms(playerid, 1, sss);
				abrir_maquina(playerid, i);
			}
	    }
	    else abrir_maquina(playerid, i);
	    return 1;
	}

	// escolher municao pra fabricar //
	if(dialogid == DIALOG_MAQUINA7)
	{
        new i = GetPVarInt(playerid, "maquina");
	    new a = GetPVarInt(playerid, "slot");
     	if(response)
	    {
	        new sss[150];
	        new cc = listitem;

     		// se nao tiver algum material suficiente //
	        for(new aa; aa<4; aa++)
	        {
				if(Maquina[i][m_Materiais][aa] < municoes_org[cc][aa+1])
				{
				    format(sss, 150, "A maquina nao tem %s de %s para fabricar %s.", ConvertMoney(municoes_org[cc][aa+1]), materiais[aa], nome_municao(municoes_org[cc][0]));
					ms(playerid, 0, sss);
					mostrar_municoes_maquina(playerid);
					return 1;
				}
	        }

	        // ver se ta vazio e fabricar //
	        if(Maquina[i][m_Existe] == 1)
	        {
	            if(Maquina[i][m_Status][a] != 0)
				{
					ms(playerid, 0, "Parece que este slot ja esta em uso, tente novamente !");
					abrir_maquina(playerid, i);
					return 1;
				}
	            for(new aaa; aaa<4; aaa++) if(municoes_org[cc][aaa+1] > 0) Maquina[i][m_Materiais][aaa] -= municoes_org[cc][aaa+1];
                Maquina[i][m_Status][a] = 1;
                Maquina[i][m_Tipo][a] = 2;
                Maquina[i][m_Tempo][a] = municoes_org[cc][5];
                Maquina[i][m_ID][a] = cc;
                Maquina[i][m_Unidades][a] = 1;
				salvar_maquina(i);
                format(sss, 150, "Voce colocou 1 %s para ser fabricada.", nome_municao(municoes_org[cc][0]));
				ms(playerid, 1, sss);
				abrir_maquina(playerid, i);
	        }
	    }
	    else abrir_maquina(playerid, i);
		return 1;
	}

    // escolher arma pra fabricar //
	if(dialogid == DIALOG_MAQUINA6)
	{
	    new i = GetPVarInt(playerid, "maquina");
	    new a = GetPVarInt(playerid, "slot");
	    if(response)
	    {
	        new sss[150];
	        new cc = armas_item_map[playerid][listitem];

	        // se nao tiver algum material suficiente //
	        for(new aa; aa<4; aa++)
	        {
				if(Maquina[i][m_Materiais][aa] < armas_org[cc][aa+1])
				{
				    format(sss, 150, "A maquina nao tem %s de %s para fabricar %s.", ConvertMoney(armas_org[cc][aa+1]), materiais[aa], nome_arma(armas_org[cc][0]));
					ms(playerid, 0, sss);
					mostrar_armas_maquina(playerid);
					return 1;
				}
	        }

	        // ver se ta vazio e fabricar //
	        if(Maquina[i][m_Existe] == 1)
	        {
	            if(Maquina[i][m_Status][a] != 0)
				{
					ms(playerid, 0, "Parece que este slot ja esta em uso, tente novamente !");
					abrir_maquina(playerid, i);
					return 1;
				}
	            for(new aaa; aaa<4; aaa++) if(armas_org[cc][aaa+1] > 0) Maquina[i][m_Materiais][aaa] -= armas_org[cc][aaa+1];
                Maquina[i][m_Status][a] = 1;
                Maquina[i][m_Tipo][a] = 1;
                Maquina[i][m_Tempo][a] = armas_org[cc][5];
                Maquina[i][m_ID][a] = cc;
                Maquina[i][m_Unidades][a] = 1;
				salvar_maquina(i);
                format(sss, 150, "Voce colocou 1 %s para ser fabricada.", nome_arma(armas_org[cc][0]));
				ms(playerid, 1, sss);
				abrir_maquina(playerid, i);
	        }
	    }
		else abrir_maquina(playerid, i);
	    return 1;
	}

	// digitar quantia material //
	if(dialogid == DIALOG_MAQUINA5)
	{
	    new sss[150];
	    new i = GetPVarInt(playerid, "maquina");
	    new a = GetPVarInt(playerid, "material");
	    new opc = GetPVarInt(playerid, "opc");
	    if(response)
	    {
	        if(strlen(inputtext) < 1)
	        {
	            ms(playerid, 0, "Digite a quantia corretamente !");
	            opcao_materiais_maquina(playerid, i, a, opc);
	            return 1;
	        }

	        if(!IsNumeric(inputtext))
	        {
	            ms(playerid, 0, "Digite apenas numeros !");
	            opcao_materiais_maquina(playerid, i, a, opc);
	            return 1;
	        }

	        new cc = strval(inputtext);
	        if(cc < 1 || cc > 30)
	        {
	            ms(playerid, 0, "Use um valor de 1 a 30 !");
	            opcao_materiais_maquina(playerid, i, a, opc);
	            return 1;
	        }

	        // se tiver pegando //
	        if(opc == 1)
	        {
                if(Maquina[i][m_Materiais][a] < cc)
				{
				    opcao_materiais_maquina(playerid, i, a, opc);
				    format(sss, 150, "A maquina nao tem %s de %s para ser retirado !", ConvertMoney(cc), materiais[a]);
				    ms(playerid, 0, sss);
				    return 1;
				}
                Maquina[i][m_Materiais][a] -= cc;
				salvar_maquina(i);
				format(sss, 150, "Voce retirou %s de %s da maquina !", ConvertMoney(cc), materiais[a]);
				ms(playerid, 1, sss);
				if(a == 0) segurar(playerid, 2, cc);
				if(a == 1) segurar(playerid, 3, cc);
				if(a == 2) segurar(playerid, 9, cc);
				if(a == 3) segurar(playerid, 10, cc);
	        }

		}
		else abrir_materiais_maquina(playerid, i, a);
	    return 1;
	}

	// abrir maquina //
	if(dialogid == DIALOG_MAQUINA)
	{
	    new i = GetPVarInt(playerid, "maquina");
	    if(response)
	    {
	        // madeira //
	        if(listitem < 4)
	        {
				abrir_materiais_maquina(playerid, i, listitem);
	        }

	        // fabricacao //
	        if(listitem == 4)
	        {
                abrir_maquina(playerid, i);
	        }
	    }
	    return 1;
	}

	// fabricacao da maquina //
	if(dialogid == DIALOG_MAQUINA1)
	{
	    new i = GetPVarInt(playerid, "maquina");
	    if(response)
	    {
	        if(Maquina[i][m_Existe] == 1)
	        {
                abrir_maquina_slot(playerid, i, listitem);
	        }
	    }
	    else maquina(playerid, i);
	    return 1;
	}

	// pegar ou colocar material na maquina //
	if(dialogid == DIALOG_MAQUINA4)
	{
	    new i = GetPVarInt(playerid, "maquina");
	    new a = GetPVarInt(playerid, "material");
	    if(response)
	    {
	        opcao_materiais_maquina(playerid, i, a, listitem);
	    }
	    else maquina(playerid, i);
	    return 1;
	}


	// pegrar veiculo da garagem da concessionaria //
	if(dialogid == DIALOG_CONCE3)
	{
	    new i = GetPVarInt(playerid, "conce");
	    new v = Lista2[playerid][listitem];
	    if(response)
	    {
	        if(v != -1)
	        {
	            if(Veiculo[v][v_Existe] == 1)
	            {
	                if(Veiculo[v][v_Garagem] == 1)
	                {
	                    if(Veiculo[v][v_Conce] != 0)
	                    {
	                        if(Veiculo[v][v_ConceID] == i)
	                        {
	                            GetPlayerPos(playerid, Veiculo[v][v_X], Veiculo[v][v_Y], Veiculo[v][v_Z]);
	                            GetPlayerFacingAngle(playerid, Veiculo[v][v_A]);
	                            Veiculo[v][v_Garagem] = 0;
	                            Veiculo[v][v_Conce] = 2;
	                            spawn_veiculo(v);
	                            PutPlayerInVehicle(playerid, Veiculo[v][v_ID], 0);
	                            MS(playerid, 1, "Voce pegou seu veiculo da garagem da Concessionaria.");
	                            ms(playerid, 1, "Voce ainda nao estacionou seu veiculo, estacione seu veiculo em algum lugar disponivel imediatamente !");
	                        }
	                    }
	                }
	            }
			}
			else abrir_garagem_concessionaria(playerid, i);
	    }
	    return 1;
	}

