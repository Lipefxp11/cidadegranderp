					            funcao_id[playerid] = veh;
							    funcao_usando[playerid] = pick;
							    SetVehicleParamsEx_(veh, 0, 0, 0, 0, 0, 0, 0);
							    if(tip == 0) Acao(playerid, 7, 300, "CONCERTANDO MOTOR", 0, "null", "null", false);
							    if(tip == 5) Acao(playerid, 7, 300, "CARREGANDO BATERIA", 0, "null", "null", false);
							    if(tip == 4) Acao(playerid, 7, 300, "TROCANDO PNEU RUIM", 0, "null", "null", false);
							    if(tip == 2) Acao(playerid, 7, 300, "TROCANDO FAROL", 0, "null", "null", false);
							    if(tip == 3) Acao(playerid, 7, 300, "TROCANDO PECA RUIM", 0, "null", "null", false);
							    if(tip == 1) Acao(playerid, 7, 300, "TROCANDO PECA RUIM", 0, "null", "null", false);
									ms(playerid, 5, "[OFICINA] Concertando veiculo, aguarde ate a conclusao total ...");
									SetPVarInt(playerid, "tip", tip);
									SetPVarInt(playerid, "a", a);
