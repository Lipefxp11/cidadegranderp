		atualizar_org(i);
		salvar_org(i);
		return 1;
	}
	
	if(!strcmp(cmd, "/limpararmasorg", true))
	{
	    new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /limpararmasorg [ ID da org ].");
		if(i < 0 || i >= MAX_ORGS) return ms(playerid, 0, "ID de organizacao invalido !");
		if(Org[i][o_Existe] == 0) return ms(playerid, 0, "Esta Org nao existe !");
		new sss[300];
		for(new a; a<20; a++) Org[i][o_Armas][a] = 0;
		for(new a; a<5; a++) Org[i][o_Municoes][a] = 0;
		format(sss, 300, "O admin '%s' Limpou as armas e municoes da Organizacao.", Nome(playerid));
		escrever_log(f("OrgsLog/Org_%d.txt", i), sss);
		format(sss, 100, "Voce Limpou as Armas e municoes da Organizacao [%d] '%s'.", i, Org[i][o_Nome]);
		ms(playerid, 5, sss);
		salvar_org(i);
		return 1;
	}

	if(!strcmp(cmd, "/tipoorg", true))
	{
	    new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /tipoorg [ ID da org ]");
		if(i < 0 || i >= MAX_ORGS) return ms(playerid, 0, "ID de organizacao invalido !");
		if(Org[i][o_Existe] == 0) return ms(playerid, 0, "Esta Org nao existe !");
		escolher_tipo_org(playerid, i);
		return 1;
	}


	if(!strcmp(cmd, "/cororg", true))
	{
	    new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /cororg [ ID da org ]");
		if(i < 0 || i >= MAX_ORGS) return ms(playerid, 0, "ID de organizacao invalido !");
		if(Org[i][o_Existe] == 0) return ms(playerid, 0, "Esta Org nao existe !");
		SetPVarInt(playerid, "org_cor", i);
		mostrar_cores(playerid, 0);
		return 1;
	}


	if(!strcmp(cmd, "/mapaorg", true))
	{
	    new i, d;
		if(sscanf(params, "dd", i, d)) return ms(playerid, 2, "Use: /mapaorg [ ID da org ] [ Icone (-1 para remover) ].");
		if(i < 0 || i >= MAX_ORGS) return ms(playerid, 0, "ID de organizacao invalido !");
		if(Org[i][o_Existe] == 0) return ms(playerid, 0, "Esta Org nao existe !");
		if(d < -1 ) return ms(playerid, 0, "Id de icone Invalido, use -1 para remover ou outro ID para setar !");
		new sss[100];
		if(d == -1) format(sss, 100, "Voce removeu o icone do mapa da org '%s' [%d].", Org[i][o_Nome], i);
		else format(sss, 100, "Voce setou o icone [%d] do mapa da org '%s' [%d].", d, Org[i][o_Nome], i);
		ms(playerid, 5, sss);
		Org[i][o_MapaID] = d;
		atualizar_org(i);
		salvar_org(i);
		return 1;
	}

	if(!strcmp(cmd, "/skinsorg", true))
	{
	    new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /skinsorg [ ID da Org ].");
		if(GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld_(playerid) != 0) return ms(playerid, 0, "Voce nao pode criar uma org em interiores !");
		if(i < 0 || i >= MAX_ORGS) return ms(playerid, 0, "ID de organizacao invalido !");
		if(Org[i][o_Existe] == 0) return ms(playerid, 0, "Esta Org nao existe !");
		setar_skins_org(playerid, i);
		return 1;
	}

	if(!strcmp(cmd, "/localorg", true))
	{
		new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /localorg [ ID da Org ].");
		if(i < 0 || i >= MAX_ORGS) return ms(playerid, 0, "ID de organizacao invalido !");
		if(Org[i][o_Existe] == 0) return ms(playerid, 0, "Esta Org nao existe !");
		GetPlayerPos(playerid, Org[i][o_LX], Org[i][o_LY], Org[i][o_LZ]);
		salvar_org(i);
		atualizar_org(i);
		new sss[300];
		format(sss, 300, "Voce mudou a Localizacao da Organizacao '%s'[%d].", Org[i][o_Nome], i);
		ms(playerid, 5, sss);
		return 1;
	}

	if(!strcmp(cmd, "/trazerorg", true))
	{
		new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /trazerorg [ ID da Org ].");
		if(GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld_(playerid) != 0) return ms(playerid, 0, "Voce nao pode criar uma org em interiores !");
		if(i < 0 || i >= MAX_ORGS) return ms(playerid, 0, "ID de organizacao invalido !");
		if(Org[i][o_Existe] == 0) return ms(playerid, 0, "Esta Org nao existe !");
		GetPlayerPos(playerid, Org[i][o_X], Org[i][o_Y], Org[i][o_Z]);
		GetPlayerPos(playerid, Org[i][o_LX], Org[i][o_LY], Org[i][o_LZ]);
		salvar_org(i);
		atualizar_org(i);
		new sss[300];
		format(sss, 300, "Voce mudou o local da Organizacao '%s'[%d].", Org[i][o_Nome], i);
		ms(playerid, 5, sss);
		ms(playerid, 2, "Use o comando /localorg pois a localizacao do /orgs foi resetada !");
		return 1;
	}

	if(!strcmp(cmd, "/verlogorg", true))
	{
	    new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /verlogorg [ ID da org ].");
		if(i < 0 || i >= MAX_ORGS) return ms(playerid, 0, "ID de organizacao invalido !");
		if(Org[i][o_Existe] == 0) return ms(playerid, 0, "Esta Org nao existe !");
		logs_org2(playerid, i);
		return 1;
	}

	if(!strcmp(cmd, "/setarliderorg", true))
	{
	    new i, c;
		if(sscanf(params, "dd", i, c)) return ms(playerid, 2, "Use: /setarliderorg [ ID da org ] [ ID da Conta ].");
		if(i < 0 || i >= MAX_ORGS) return ms(playerid, 0, "ID de organizacao invalido !");
		if(c < 0 || c >= MAX_CONTAS) return ms(playerid, 0, "ID de conta invalido !");
		if(Org[i][o_Existe] == 0) return ms(playerid, 0, "Esta Org nao existe !");
		if(ContaInvalida(c)) return ms(playerid, 0, "Esta Conta nao existe !");
		if(LiderOrg(i) != -1) return ms(playerid, 0, "Esta Org ja tem um Lider !");
		new player = ContaOnline(c);
		if(Online(player))
		{
		    if(Conta[player][c_Org] != -1) return ms(playerid, 0, "Esta Conta ja pertence a uma Organizacao");
			Org[i][o_Membros][0] = c;
			Org[i][o_Cargos][0] = 6;
			salvar_org(i);
			Conta[player][c_Org] = i;
			Conta[player][c_Cargo] = 6;
			Conta[player][c_Local] = 1;
			Conta[player][c_LocalID] = i;
			salvar_conta(c, 0, "c_Org", sv_int(i));
			salvar_conta(c, 0, "c_Cargo", sv_int(6));
			salvar_conta(c, 0, "c_Local", sv_int(1));
			salvar_conta(c, 0, "c_LocalID", sv_int(i));
			SetarSpawn(player);
			PlayerSpawn(player);
		}
		else
		{
		    if(GetContaInt(c, "c_Org") != -1) return ms(playerid, 0, "Esta Conta ja pertence a uma Organizacao");
			Org[i][o_Membros][0] = c;
			Org[i][o_Cargos][0] = 6;
			salvar_org(i);
		    salvar_conta(c, 0, "c_Org", sv_int(i));
			salvar_conta(c, 0, "c_Cargo", sv_int(6));
			salvar_conta(c, 0, "c_Local", sv_int(1));
			salvar_conta(c, 0, "c_LocalID", sv_int(i));
		}
	    new sss[300];
		format(sss, 300, "Voce setou a conta '%s' [%d], como lider da Organizacao '%s'[%d].", NomeConta(c), c, Org[i][o_Nome], i);
		ms(playerid, 5, sss);
		format(sss, 300, "O admin '%s' setou '%s' como lider da Organizacao.", Nome(playerid), NomeConta(c));
		escrever_log(f("OrgsLog/Org_%d.txt", i), sss);
		return 1;
	}


	if(!strcmp(cmd, "/limparorgconta", true))
	{
	    new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /limparorgconta [ ID da Conta ].");
		if(i < 0 || i >= MAX_CONTAS) return ms(playerid, 0, "ID de Conta invalido !");
		if(ContaInvalida(i)) return ms(playerid, 0, "Esta Conta nao existe !");

		new org;
	    new player = ContaOnline(i);
		if(Online(player))
		{
		    if(Conta[player][c_Org] == -1) return ms(playerid, 0, "Esta Conta nao esta em uma organizacao !");
		    org = Conta[player][c_Org];
		    Conta[player][c_Org] = -1;
		    Conta[player][c_Cargo] = 0;
		    remover_taser_player(player);
		}
		else
		{
		    if(GetContaInt(i, "c_Org") == -1) return ms(playerid, 0, "Esta Conta nao esta em uma organizacao !");
		    org = GetContaInt(i, "c_Org");
		    salvar_conta(i, 0, "c_Org", sv_int(-1));
		    salvar_conta(i, 0, "c_Cargo", sv_int(0));
		    remover_taser_conta(i);
		}

		new sss[300];
		if(Org[org][o_Existe] == 1)
		{
		    for(new a; a<30; a++)
			{
			    if(Org[org][o_Membros][a] == i)
				{
				Org[org][o_Membros][a] = -1;
					Org[org][o_Cargos][a] = 0;
					format(sss, 300, "O admin '%s' retirou '%s' da Organizacao.", Nome(playerid), NomeConta(i));
					escrever_log(f("OrgsLog/Org_%d.txt", org), sss);
			    }
			}
		    salvar_org(org);
		    format(sss, 300, "Voce retirou '%s' da Organizacao '%s'[%d].", NomeConta(i), Org[org][o_Nome], org);
			ms(playerid, 5, sss);
		}
		else ms(playerid, 1, "O jogador estava em uma org que nao existe, e foi limpo mesmo assim !");
		return 1;
	}


	if(!strcmp(cmd, "/limparliderorg", true))
	{
	    new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /limparliderorg [ ID da org ].");
		if(i < 0 || i >= MAX_ORGS) return ms(playerid, 0, "ID de organizacao invalido !");
		if(Org[i][o_Existe] == 0) return ms(playerid, 0, "Esta Org nao existe !");
	 	if(LiderOrg(i) == -1) return ms(playerid, 0, "Esta Org nao tem Lider !");
		new c = Org[i][o_Membros][0];
		for(new a; a<30; a++)
		{
		    if(Org[i][o_Membros][a] != -1)
		    {
		        if(Org[i][o_Cargos][a] >= 6)
		        {
					Org[i][o_Membros][a] = -1;
					Org[i][o_Cargos][a] = 0;
				}
			}
		}
		new player = ContaOnline(c);
		if(Online(player))
		{
		    Conta[player][c_Org] = -1;
			Conta[player][c_Cargo] = 0;
			Conta[player][c_Local] = 0;
			Conta[player][c_LocalID] = -1;
			salvar_conta(c, 0, "c_Org", sv_int(-1));
			salvar_conta(c, 0, "c_Cargo", sv_int(0));
			salvar_conta(c, 0, "c_Local", sv_int(-1));
			salvar_conta(c, 0, "c_LocalID", sv_int(-1));
			SetPlayerSkin(player, 26);
			Conta[player][c_Skin] = 26;
			salvar_conta(c, 0, "c_Skin", sv_int(26));
			if(OrgCop(i)) limpar_armas_player(player, c);
			SetarSpawn(player);
			PlayerSpawn(player);
		}
		else
		{
		    salvar_conta(c, 0, "c_Org", sv_int(-1));
			salvar_conta(c, 0, "c_Cargo", sv_int(0));
			salvar_conta(c, 0, "c_Local", sv_int(-1));
			salvar_conta(c, 0, "c_LocalID", sv_int(-1));
			salvar_conta(c, 0, "c_Skin", sv_int(26));
			if(OrgCop(i)) limpar_armas_player(-1, c);
		}
		salvar_org(i);
	    new sss[300];
		format(sss, 300, "Voce limpou o Lider da Organizacao '%s'[%d].", Org[i][o_Nome], i);
		ms(playerid, 5, sss);
		format(sss, 300, "O admin '%s' retirou o lider da Organizacao.", Nome(playerid));
		escrever_log(f("OrgsLog/Org_%d.txt", i), sss);
		return 1;
	}
	
	if(!strcmp(cmd, "/limparmembrosorg", true))
	{
	    new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /limparmembrosorg [ ID da org ].");
		if(i < 0 || i >= MAX_ORGS) return ms(playerid, 0, "ID de organizacao invalido !");
		if(Org[i][o_Existe] == 0) return ms(playerid, 0, "Esta Org nao existe !");
		new cont;
		new sss[300];
		
		for(new a=1; a<30; a++)
		{
			new c = Org[i][o_Membros][a];
		    if(c != -1)
		    {
				cont ++;
				Org[i][o_Membros][a] = -1;
				Org[i][o_Cargos][a] = 0;
				format(sss, 300, "O admin '%s' lhe retirou da Organizacao.", Nome(playerid));
				msc(c, 5, sss);
				new player = ContaOnline(c);
				if(Online(player))
				{
					Conta[player][c_Org] = -1;
					Conta[player][c_Cargo] = 0;
					Conta[player][c_Local] = 0;
					Conta[player][c_LocalID] = -1;
					salvar_conta(c, 0, "c_Org", sv_int(-1));
					salvar_conta(c, 0, "c_Cargo", sv_int(0));
					salvar_conta(c, 0, "c_Local", sv_int(-1));
					salvar_conta(c, 0, "c_LocalID", sv_int(-1));
					SetPlayerSkin(player, 26);
					Conta[player][c_Skin] = 26;
					salvar_conta(c, 0, "c_Skin", sv_int(26));
					remover_taser_player(player);
					SetarSpawn(player);
					PlayerSpawn(player);
				}
				else
				{
					salvar_conta(c, 0, "c_Org", sv_int(-1));
					salvar_conta(c, 0, "c_Cargo", sv_int(0));
					salvar_conta(c, 0, "c_Local", sv_int(-1));
					salvar_conta(c, 0, "c_LocalID", sv_int(-1));
					salvar_conta(c, 0, "c_Skin", sv_int(26));
					remover_taser_conta(c);
				}
			}
		}
		
		if(cont > 0)
		{
			salvar_org(i);
			format(sss, 300, "Voce limpou [%d] Vagas da Organizacao '%s' [%d].", cont, Org[i][o_Nome], i);
			ms(playerid, 5, sss);
			format(sss, 300, "O admin '%s' retirou [%d] Membros da Organizacao.", Nome(playerid), cont);
			escrever_log(f("OrgsLog/Org_%d.txt", i), sss);
		}
		else ms(playerid, 0, "Nenhuma Vaga da Organizacao estava sendo ocupada !");
		return 1;
	}

	if(!strcmp(cmd, "/irorg", true))
	{
	    new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /irorg [ ID da org ].");
		if(i < 0 || i >= MAX_ORGS) return ms(playerid, 0, "ID de organizacao invalido !");
		if(Org[i][o_Existe] == 0) return ms(playerid, 0, "Esta Org nao existe !");
		new sss[100];
		format(sss, 100, "Voce foi ate a Organizacao '%s' [%d].", Org[i][o_Nome], i);
		ms(playerid, 5, sss);
		format(string_prox, 300, "** '%s' foi ate a organizacao '%s' [%d] **", Nome(playerid), Org[i][o_Nome], i);
		ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
		SetPlayerInterior(playerid, 0);
	 	SetPlayerVirtualWorld_(playerid, 0);
	 	SetPlayerPos_(playerid, Org[i][o_X]+0.1, Org[i][o_Y]+0.1, Org[i][o_Z]+0.1);
		return 1;
	}


	if(!strcmp(cmd, "/destruirorg", true))
	{
