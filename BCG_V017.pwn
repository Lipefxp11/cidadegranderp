	    if(livre == -1) return ms(playerid, 0, "Numero maximo de cupons atingido !");
	    SetPVarInt(playerid, "editando_cupom", livre);
	    for(new p; p<MAX_PREMIOS_CUPOM; p++) { SetPVarInt(playerid, f("cupom_tipo_%d", p), 0); SetPVarInt(playerid, f("cupom_valor_%d", p), 0); }
	    ShowPlayerDialog(playerid, DIALOG_CUPOM_CRIAR, DIALOG_STYLE_INPUT, "{ffffff}Criar Cupom", "{ffffff}Digite o codigo do cupom:", "Continuar", "Cancelar");
	    return 1;
