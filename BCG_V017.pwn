stock players_perto_documentos(playerid)
{
    new idd = id[playerid];
    if(idd != -1)
    {
	    new cont;
	    new Float:p[3];
	    foreach(new v:Player)
		{
		    if(Online(v))
		    {
		        GetPlayerPos(v, p[0], p[1], p[2]);
				if(IsPlayerInRangeOfPoint(playerid, 10, p[0], p[1], p[2]))
				{
				    if(v != playerid)
					{
					    if(GetPlayerInterior(v) == GetPlayerInterior(playerid) && GetPlayerVirtualWorld_(v) == GetPlayerVirtualWorld_(playerid))
						{
							format(Lista_DC[playerid][cont][cel_Nome], 100, "~w~%s  ~y~%d", Nome(v), v );
		                	Lista_DC[playerid][cont][cel_ID] = v;
							cont++;
						}
					}
				}
			}
		}
		Item_DC[playerid] = 0;
		format(Titulo_DC[playerid], 100, "~b~~h~PLAYERS PROXIMOS ~P~~h~%d", cont);
		MAX_DC[playerid] = cont;
		ID_DC[playerid] = DOCUMENTOS_PLAYERS;
		Pagina_DC[playerid] = 0;
		celular(playerid, C_LISTA);
	}
}

