		if(i < 0 || i > 1000000) return ms(playerid, 0, "Use um valor entre 0 e 1.000.000.");
		new Float:pos[3];
		GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
		PegarFrentePlayer(playerid, pos[0], pos[1], 2);
		new ca = CriarCaixaEletronico( pos[0], pos[1], pos[2], GetPlayerInterior(playerid), GetPlayerVirtualWorld_(playerid), i);
		if(ca == -1) return ms(playerid, 0, "Numero maximo de caixas eletronicos atingido !");
		new sss[300];
		CaixaEletronico[ca][ce_Cidade] = pegar_cidade(playerid);
		salvar_caixa_eletronico(ca);
		format(sss, 300, "Caixa eletronico ID %d criado, com R$ %s de grana.", ca, ConvertMoney(i));
		ms(playerid, 5, sss);
		EditandoCaixaEletronico[playerid] = ca;
		EditDynamicObject2(playerid, CaixaEletronico[ca][ce_Obj]);
		ms(playerid, 1, "Movimente o objeto usando o editor de objeto e salve a posicao.");
		return 1;
	}

	if(!strcmp(cmd, "/spawncaixaeletronico", true))
	{
	    new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /spawncaixaeletronico [ ID do CAIXA ]");
		if(i < 0 || i >= MAX_CAIXAS_ELETRONICOS) return ms(playerid, 0, "ID de Caixa eletronico Invalido !");
		if(CaixaEletronico[i][ce_Existe] == 0) return ms(playerid, 0, "Este caixa eletronico nao existe !");
	    CaixaEletronico[i][ce_Quebrado] = 0;
	    CaixaEletronico[i][cec_Quebrado] = 0;
	    CaixaEletronico[i][ce_Roubo] = 0;
	    CaixaEletronico[i][cec_Vida] = 100;
	    /*CaixaEletronico[i][ce_TempoFogo] = 0;
	    CaixaEletronico[i][cec_TempoFogo] = 0;*/
	    atualizar_caixa_eletronico(i);
	    salvar_caixa_eletronico(i);
		ms(playerid, 5, "O caixa eletronico foi respawnado com sucesso !");
		return 1;
	}

	if(!strcmp(cmd, "/movercameracaixa", true))
	{
	    new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /movercameracaixa [ ID do CAIXA ]");
		if(i < 0 || i >= MAX_CAIXAS_ELETRONICOS) return ms(playerid, 0, "ID de Caixa eletronico Invalido !");
		if(CaixaEletronico[i][ce_Existe] == 0) return ms(playerid, 0, "Este caixa eletronico nao existe !");
		if(CaixaEletronico[i][cec_Quebrado] == 1)
		{
		    CaixaEletronico[i][cec_Quebrado] = 0;
		    atualizar_caixa_eletronico(i);
		}
		EditandoCaixaEletronico[playerid] = i;
	    SetPVarInt(playerid, "caixa_camera", 1);
		EditDynamicObject2(playerid, CaixaEletronico[i][cec_Obj]);
		ms(playerid, 1, "Movimente o objeto usando o editor de objeto e salve a posicao.");
		return 1;
	}

	if(!strcmp(cmd, "/movercaixaeletronico", true))
	{
	    new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /movercaixaeletronico [ ID do CAIXA ]");
		if(i < 0 || i >= MAX_CAIXAS_ELETRONICOS) return ms(playerid, 0, "ID de Caixa eletronico Invalido !");
		if(CaixaEletronico[i][ce_Existe] == 0) return ms(playerid, 0, "Este caixa eletronico nao existe !");
	    EditandoCaixaEletronico[playerid] = i;
