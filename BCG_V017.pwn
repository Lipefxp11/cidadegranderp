	    if(listitem == 0)
	        {
	            if(Conta[playerid][c_Cargo] < 5 && !Scripter(playerid))
	                return ms(playerid, 0, "Apenas Lider e SubLider podem retirar dinheiro do cofre !");
	            pegar_valor_org(playerid, i);
	        }
	        if(listitem == 1) colocar_valor_org(playerid, i);
	        if(listitem == 2) lavar_valor_org(playerid, i);
	    }
	    else abrir_org(playerid, i);
	    return 1;
	}

	// equipar colete da org //
	if(dialogid == DIALOG_ORG17)
	{
	    new i = GetPVarInt(playerid, "id_org");
	    if(response)
	    {
	        if(Org[i][o_Coletes] > 0)
	        {
	            Org[i][o_Coletes] --;
	            salvar_org(i);
	            SetarColete(playerid, 100);
	            ms(playerid, 1, "Voce se equipou com 1 Colete a prova de balas, da Organizacao.");
	            abrir_org(playerid, i);
	        }
	        else
	        {
	        	ms(playerid, 0, "A organizacao nao tem coletes no momento !");
		        abrir_org(playerid, i);
	        }
	    }
	    else abrir_org(playerid, i);
	    return 1;
	}




	// equipar quantidade de arma da org //
	if(dialogid == DIALOG_ORG15)
	{
	    new i = GetPVarInt(playerid, "id_org");
	    new a = GetPVarInt(playerid, "id_arma");
	    if(response)
	    {
	        if(Org[i][o_Armas][a] > 0)
         	{
		        if(strlen(inputtext) < 1)
		        {
		            ShowPlayerDialog(playerid, DIALOG_ORG16, DIALOG_STYLE_MSGBOX, "Erro de Digitacao", "{a1a1a1}Digite a quantidade corretamente !", "Ok", "Voltar");
		            return 1;
		        }

		        if(!IsNumeric(inputtext))
		        {
		            ShowPlayerDialog(playerid, DIALOG_ORG16, DIALOG_STYLE_MSGBOX, "Erro de Digitacao", "{a1a1a1}Digite apenas numeros !", "Ok", "Voltar");
		            return 1;
		        }
		        new cc = strval(inputtext);
				if(cc <= 0 || cc > 300)
				{
				    ShowPlayerDialog(playerid, DIALOG_ORG16, DIALOG_STYLE_MSGBOX, "Municao invalida", "{ff0000}[ERRO]{a1a1a1}Digite uma quantidade 1 a 300 !", "Ok", "Voltar");
		            return 1;
				}

				new idmun = municao(armas_org[a][0]);
				if(idmun !=-1)
				{
					if(cc >  Org[i][o_Municoes][idmun])
					{
					    ShowPlayerDialog(playerid, DIALOG_ORG16, DIALOG_STYLE_MSGBOX, "Quantidade invalida", "{a1a1a1}A organizacao nao tem essa quantidade de municoes disponivel !", "Ok", "Voltar");
				    return 1;
					}
				}

				if(Org[i][o_Municoes][idmun] > 0)
				{

				    if(slot_arma(armas_org[a][0]) == 2)
					{
					if(Taser(playerid))
					{
					    ms(playerid, 0, "Voce nao pode equipar uma pistola enquanto usa o /taser !");
					    abrir_armas_org(playerid, i);
					    return 1;
					}
				    }

				    new sss[150];
				    new ja_tem;
				    for(new s; s<13; s++) { new w, am; GetPlayerWeaponData(playerid, s, w, am); if(w == armas_org[a][0]) { ja_tem = 1; break; } }
				    if(!ja_tem) { Org[i][o_Armas][a] --; GivePlayerWeapon_(playerid, armas_org[a][0], cc); }
				    else GivePlayerWeapon_(playerid, armas_org[a][0], cc);
				    Org[i][o_Municoes][idmun] -= cc;
                    salvar_org(i);
                    format(sss, 150, "Voce se equipou com um(a) %s, e %s municoes, da organizacao.", nome_arma(armas_org[a][0]), ConvertMoney(cc));
                    ms(playerid, 1, sss);
                    SetPlayerArmedWeapon(playerid, armas_org[a][0]);
                    SetTimerEx("salvar_armas", 1500, false, "dd", playerid, 0);
				}
				else
		        {
		            ms(playerid, 0, "A municao para esta arma acabou !");
	             	abrir_armas_org(playerid, i);
		        }
	        }
	        else
	        {
	            ms(playerid, 0, "Esta arma da org acabou !");
             	abrir_armas_org(playerid, i);
	        }
	    }
	    else abrir_org(playerid, i);
	    return 1;
	}


	// equipar arma da org //
	if(dialogid == DIALOG_ORG14)
	{
	    new i = GetPVarInt(playerid, "id_org");
	    if(response)
	    {
	        new a = Lista2[playerid][listitem];
	        if(a != -1)
	        {
	            new sss[300];
	            SetPVarInt(playerid, "id_arma", a);
	            new idmun = municao(armas_org[a][0]);
	            if(Org[i][o_Armas][a] > 0)
	            {
	                // se for arma com municao //
	                if(idmun != -1)
	                {
		                if(Org[i][o_Municoes][idmun] > 0)
		                {
							digitar_municoes_arma(playerid, i, a);
		                }
		                else
		                {
		                    ms(playerid, 0, "A municao para esta arma acabou !");
		                	abrir_armas_org(playerid, i);
		                }
	                }
	                else
	                {
	                    new ja_tem;
	                    for(new s; s<13; s++) { new w, am; GetPlayerWeaponData(playerid, s, w, am); if(w == armas_org[a][0]) { ja_tem = 1; break; } }
	                    if(!ja_tem) Org[i][o_Armas][a] --;
	                    GivePlayerWeapon_(playerid, armas_org[a][0], 1);
	                    salvar_org(i);
	                    format(sss, 150, "Voce se equipou com um(a) %s, da organizacao.", nome_arma(armas_org[a][0]));
	                    ms(playerid, 1, sss);
	                    SetPlayerArmedWeapon(playerid, armas_org[a][0]);
	                    SetTimerEx("salvar_armas", 1500, false, "dd", playerid, 0);
	                }
	            }
	            else
	            {
	                ms(playerid, 0, "Esta arma da org acabou !");
	                abrir_armas_org(playerid, i);
	            }
	        }
		}
		else abrir_org(playerid, i);
		return 1;
	}


	// recrutar membro pra org //
	if(dialogid == DIALOG_ORG11)
	{
	    new i = GetPVarInt(playerid, "id_org");
	    if(response)
	    {
	        if(strlen(inputtext) < 1)
	        {
	            ShowPlayerDialog(playerid, DIALOG_ORG12, DIALOG_STYLE_MSGBOX, "Erro de ID", "{a1a1a1}Digite o ID da conta corretamente !", "Ok", "Voltar");
	            return 1;
	        }

	        if(!IsNumeric(inputtext))
	        {
	            ShowPlayerDialog(playerid, DIALOG_ORG12, DIALOG_STYLE_MSGBOX, "Erro de Digitacao", "{a1a1a1}Digite apenas numeros !", "Ok", "Voltar");
	            return 1;
	        }

	        new cc = strval(inputtext);
	        if(cc < 0 || cc >= MAX_CONTAS)
	        {
	            ShowPlayerDialog(playerid, DIALOG_ORG12, DIALOG_STYLE_MSGBOX, "Erro no ID", "{a1a1a1}ID de conta Invalido !", "Ok", "Voltar");
	            return 1;
	        }

	        if(ContaInvalida(cc))
	        {
	            ShowPlayerDialog(playerid, DIALOG_ORG12, DIALOG_STYLE_MSGBOX, "Erro no ID", "{a1a1a1}Esta conta nao existe !", "Ok", "Voltar");
	            return 1;
	        }

            new player = ContaOnline(cc);
	        if(!Online(player))
	        {
	            new sss[150];
	            format(sss, 150, "{ff0000}[INFO] {a1a1a1}O Jogador {ffff00}%s {a1a1a1}nao esta Online no momento !", NomeConta(cc));
	            ShowPlayerDialog(playerid, DIALOG_ORG12, DIALOG_STYLE_MSGBOX, "Jogador Offline", sss, "Ok", "Voltar");
	            return 1;
	        }

	        if(OrgPlayer(player) != -1)
	        {
	            ShowPlayerDialog(playerid, DIALOG_ORG12, DIALOG_STYLE_MSGBOX, "Erro ao recrutar", "{a1a1a1}Este jogador ja pertence a uma organizacao !", "Ok", "Voltar");
	            return 1;
	        }

	        new Float:pos[3];
	        GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
	        if(!IsPlayerInRangeOfPoint(player, 5, Org[i][o_X], Org[i][o_Y], Org[i][o_Z]) || GetPlayerInterior(player) != GetPlayerInterior(playerid) || GetPlayerVirtualWorld_(player) != GetPlayerVirtualWorld_(playerid))
	        {
	            new sss[150];
	            format(sss, 150, "{a1a1a1}O jogador {ffffff}%s {a1a1a1}precisa estar proximo para ser recrutado.", NomeConta(cc));
	            ShowPlayerDialog(playerid, DIALOG_ORG12, DIALOG_STYLE_MSGBOX, "Jogador Distante", sss, "Ok", "Voltar");
	            return 1;
	        }

	        if(membros(i) == 30)
	        {
	            ShowPlayerDialog(playerid, DIALOG_ORG12, DIALOG_STYLE_MSGBOX, "Lista Cheia", "{a1a1a1}A lista de membros da organizacao ja atingiu o limite !", "Ok", "Voltar");
	            return 1;
	        }

	        Conta[player][c_Org] = i;
	        Conta[player][c_Cargo] = 1;
	        Conta[player][c_Local] = 1;
	        Conta[player][c_LocalID] = i;
	        salvar_conta(cc, 0, "c_Org", sv_int(i));
			salvar_conta(cc, 0, "c_Cargo", sv_int(0));
			salvar_conta(cc, 0, "c_Local", sv_int(1));
			salvar_conta(cc, 0, "c_LocalID", sv_int(i));

	        for(new a; a<30; a++)
	        {
	            if(Org[i][o_Membros][a] == -1)
	            {
	                Org[i][o_Membros][a] = cc;
	                Org[i][o_Cargos][a] = 0;
	                break;
	            }
	        }
	        salvar_org(i);
	        new sss1[150];
	        format(sss1, 150, "Voce recrutou '%s' para a organizacao !", NomeConta(cc));
	        ms(playerid, 1, sss1);
	        format(sss1, 150, "Voce foi recrutado para a Org '%s' ID: %d, por '%s' !", Org[i][o_Nome], i, Nome(playerid));
	        ms(player, 1, sss1);
	        format(sss1, 150, "'%s' recrutou '%s' para a organizacao.", Nome(playerid), NomeConta(cc));
	        escrever_log(f("OrgsLog/Org_%d.txt", i), sss1);
			abrir_org(playerid, i);
	    }
	    else abrir_org(playerid, i);
	    return 1;
	}

	if(dialogid == DIALOG_CONVIDAR_ORG)
	{
	    new i = GetPVarInt(playerid, "convidar_org");
	    if(response)
	    {
	        if(strlen(inputtext) < 1 || !IsNumeric(inputtext)) {
	            ShowPlayerDialog(playerid, DIALOG_CONVIDAR_ORG, DIALOG_STYLE_INPUT, Org[i][o_Nome], "\n{4169E1}[INFO] {a1a1a1}Digite o ID da Conta valido:\n\n", "Convidar", "Cancelar");
	            return 1;
	        }
	        new cc = strval(inputtext);
	        if(cc < 0 || cc >= MAX_CONTAS || ContaInvalida(cc)) {
	            ShowPlayerDialog(playerid, DIALOG_CONVIDAR_ORG, DIALOG_STYLE_INPUT, Org[i][o_Nome], "\n{a1a1a1}Esta conta nao existe ! Digite outro ID:\n\n", "Convidar", "Cancelar");
	            return 1;
	        }
	        new player = ContaOnline(cc);
	        if(!Online(player)) { MS(playerid, 0, f("'{NomeConta(cc)}' nao esta online !")); return 1; }
	        if(OrgPlayer(player) != -1) { MS(playerid, 0, "Este jogador ja pertence a uma organizacao !"); return 1; }
	        if(membros(i) >= 30) { MS(playerid, 0, "A org ja atingiu o limite de membros !"); return 1; }
	        if((Org[i][o_Tipo] == 0 || Org[i][o_Tipo] == 1 || Org[i][o_Tipo] == 8) && GetContaInt(cc, "c_FichaPolicial") == 1)
	        {
	            MS(playerid, 0, f("'{NomeConta(cc)}' ja foi preso(a) pela policia e nao pode ser convidado(a) para esta organizacao !"));
	            return 1;
	        }

	        Conta[player][c_Org] = i;
	        Conta[player][c_Cargo] = 1;
	        salvar_conta(cc, 0, "c_Org", sv_int(i));
	        salvar_conta(cc, 0, "c_Cargo", sv_int(1));
	        for(new a; a<30; a++) if(Org[i][o_Membros][a] == -1) { Org[i][o_Membros][a] = cc; Org[i][o_Cargos][a] = 1; break; }
	        salvar_org(i);
	        MS(playerid, 1, f("Voce recrutou '%s' para a organizacao !", NomeConta(cc)));
	        MS(player, 1, f("Voce foi recrutado para a Org '%s' !", Org[i][o_Nome]));
	        escrever_log(f("OrgsLog/Org_%d.txt", i), f("'%s' recrutou '%s'.", Nome(playerid), NomeConta(cc)));
	    }
	    return 1;
	}

	// deposito de veiculos //
	if(dialogid == DIALOG_DEPOSITO_LISTA)
	{
		if(response)
		{
			new v = Lista[playerid][listitem];
			if(v >= 0 && Veiculo[v][v_Existe] == 1 && Veiculo[v][v_Dono] == -1)
				mostrar_info_deposito(playerid, v);
			else ms(playerid, 0, "Este veiculo nao esta mais disponivel.");
		}
		return 1;
	}

	if(dialogid == DIALOG_DEPOSITO_INFO)
	{
		if(response)
		{
			new v = GetPVarInt(playerid, "dep_veiculo");
			if(v < 0 || Veiculo[v][v_Existe] == 0 || Veiculo[v][v_Dono] != -1)
				return ms(playerid, 0, "Este veiculo nao esta mais disponivel.");
			new cc4 = id[playerid];
			new old_dono = strval(Veiculo[v][v_History]);
			new barra = strfind(Veiculo[v][v_History], "|");
			new detran_time;
			if(barra != -1) detran_time = strval(Veiculo[v][v_History][barra+1]);
			new preco = Veiculo[v][v_Contas] * 2;
			if(cc4 == old_dono) preco = Veiculo[v][v_Contas] + (Veiculo[v][v_Contas] / 2);
			if(detran_time > 0)
			{
			    if(gettime() - detran_time < 1296000 && cc4 != old_dono)
			        return ms(playerid, 0, "Apenas o ex-dono pode comprar este veiculo nos proximos 15 dias!");
			    if(cc4 == old_dono && gettime() - detran_time < 1296000) preco = Veiculo[v][v_Contas];
			}
			if(GranaPlayer(playerid) < preco)
				return ms(playerid, 0, f("Voce precisa de R$ %s para este veiculo!", ConvertMoney(preco)));
			DarGrana(playerid, -preco);
			Veiculo[v][v_Dono] = cc4;
			Veiculo[v][v_IPVA] = 30;
			Veiculo[v][v_Contas] = 0;
			SalvarInfo(v);
			ms(playerid, 1, f("Veiculo '%s' comprado por R$ %s!", NomeVeiculo(Veiculo[v][v_Modelo]), ConvertMoney(preco)));
		}
		return 1;
	}

	if(dialogid == DIALOG_OBJETOS)
	{
		if(response)
		{
			new i = Lista[playerid][listitem];
			if(i < 0 || i >= MAX_OBJETOS || Objeto[i][o_Existe] == 0) return ms(playerid, 0, "Objeto invalido !");
			SetPlayerPos_(playerid, Objeto[i][o_X], Objeto[i][o_Y], Objeto[i][o_Z]+1);
			SetPlayerInterior(playerid, Objeto[i][o_Interior]);
			SetPlayerVirtualWorld_(playerid, Objeto[i][o_Mundo]);
			ms(playerid, 1, f("Teleportado para o Objeto ID %d.", i));
		}
		return 1;
	}

	if(dialogid == DIALOG_INV_QTY)
	{
		if(response)
		{
			new val = strval(inputtext);
			if(val < 1) return ms(playerid, 0, "Quantidade invalida!");
			inv_qty[playerid] = val;
			ms(playerid, 1, f("Quantidade definida para %d.", val));
			if(inv_novo_aberto[playerid] == 1) abrir_inv_novo(playerid);
			SelectTextDraw(playerid, 0xffff0080);
		}
		return 1;
	}

	// cargo do veiculo da org //
	if(dialogid == DIALOG_ORG10)
	{
	    new i = GetPVarInt(playerid, "id_org");
	    new v = GetPVarInt(playerid, "info");
	    if(response)
	    {
	        if(OrgPlayer(playerid) == i)
			{
			    if(Veiculo[v][v_Org] == i)
				{
				new sss[120];
				format(sss, 120, "Voce setou o Cargo deste veiculo para '%s'.", nome_cargo(listitem+1, i));
				ms(playerid, 1, sss);
				Veiculo[v][v_Cargo] = listitem+1;
					SalvarInfo(v);
					mostrar_veiculos_org(playerid, i);
			    }
	        }
	    }
	    else mostrar_veiculos_org(playerid, i);
		return 1;
	}

	// passa lider da org //
	if(dialogid == DIALOG_ORG9)
	{
	    new i = GetPVarInt(playerid, "id_org");
	    new v = Lista2[playerid][listitem];
	    if(response)
	    {
	        if(v != -1)
	        {
	            if(Veiculo[v][v_Org] == i)
	            {
	                if(OrgPlayer(playerid) == i)
	                {
	                    if(c == -1) return 1;
	                    if(Conta[playerid][c_Cargo] < Veiculo[v][v_Cargo] && !Scripter(playerid))
	                    {
	                        mostrar_veiculos_org(playerid, i);
	                        ms(playerid, 0, "Apenas o Lider pode setar o cargo deste veiculo !");
	                        return 1;
	                    }
		                new sss[150];
		                for(new fff=1; fff<6; fff++) strcat(sss, nome_cargo(fff, i)), strcat(sss, "\n");
	                	if(Conta[playerid][c_Cargo] == 6) strcat(sss, nome_cargo(6, i)), strcat(sss, "\n");
		                SetPVarInt(playerid, "info", v);
		                ShowPlayerDialog(playerid, DIALOG_ORG10, DIALOG_STYLE_LIST, "Cargo do Veiculo", sss, "Ok", "Voltar");
	                }
	            }
	        }
		}
		else abrir_org(playerid, i);
		return 1;
	}

	// passa lider da org //
	// setar cargo do membro da org //
	if(dialogid == DIALOG_ORG7)
	{
	    new i = GetPVarInt(playerid, "id_org");
	    new a = GetPVarInt(playerid, "id_membro");
	    new ca = listitem;
	    if(response)
	    {
	        if(OrgPlayer(playerid) == i)
	        {
	            new cc = Org[i][o_Membros][a];

	            new player = ContaOnline(cc);
	            if(Online(player)) Conta[player][c_Cargo] = ca;
	            else salvar_conta(cc, 0, "c_Cargo", sv_int(ca));
	            Org[i][o_Cargos][a] = ca;
	            salvar_org(i);
	            new sss[150];
	            format(sss, 150, "Voce setou '%s' como %s da Organizacao.", NomeConta(cc), nome_cargo(ca, i));
	            ms(playerid, 1, sss);
				format(sss, 150, "'%s' lhe setou %s da Organizacao !", Nome(playerid), nome_cargo(ca, i));
	            msc(cc, 2, sss);
	            format(sss, 150, "'%s' setou %s em '%s'.", Nome(playerid), nome_cargo(ca, i), NomeConta(cc));
	            escrever_log(f("OrgsLog/Org_%d.txt", i), sss);
	            opcoes_membro_org(playerid, i, a);
	        }
	    }
	    else opcoes_membro_org(playerid, i, a);
	    return 1;
	}

	// expulssar membro da org //
	if(dialogid == DIALOG_ORG6)
	{
	    new i = GetPVarInt(playerid, "id_org");
	    new a = GetPVarInt(playerid, "id_membro");
	    if(response)
	    {
	        if(OrgPlayer(playerid) == i)
	        {
	            new cc = Org[i][o_Membros][a];
            new player = ContaOnline(cc);
            if(Online(player))
            {
                Conta[player][c_Org] = -1;
                Conta[player][c_Cargo] = 0;
                salvar_conta(cc, 0, "c_Org", sv_int(-1));
                salvar_conta(cc, 0, "c_Cargo", sv_int(0));
                remover_taser_player(player);
                SetPlayerSkin(player, 26);
                Conta[player][c_Skin] = 26;
                salvar_conta(cc, 0, "c_Skin", sv_int(26));
                if(OrgCop(i)) limpar_armas_player(player, cc);
            }
            else
            {
                salvar_conta(cc, 0, "c_Org", sv_int(-1));
                salvar_conta(cc, 0, "c_Cargo", sv_int(0));
                remover_taser_conta(cc);
                salvar_conta(cc, 0, "c_Skin", sv_int(26));
                if(OrgCop(i)) limpar_armas_player(-1, cc);
            }
	            Org[i][o_Membros][a] = -1;
	            Org[i][o_Cargos][a] = 0;
	            salvar_org(i);
	            new sss[150];
	            format(sss, 150, "Voce expulsou '%s' da Organizacao.", NomeConta(cc));
	            ms(playerid, 1, sss);
				format(sss, 150, "'%s' expusou voce da Organizacao !", Nome(playerid));
	            msc(cc, 2, sss);
	            format(sss, 150, "'%s' expusou '%s' da Organizacao.", Nome(playerid), NomeConta(cc));
	            escrever_log(f("OrgsLog/Org_%d.txt", i), sss);
	            abrir_membros_org(playerid, i);
	        }
	    }
	    else opcoes_membro_org(playerid, i, a);
	    return 1;
	}

	// dialog opcoes membro da org //
	if(dialogid == DIALOG_ORG4)
	{
	    new i = GetPVarInt(playerid, "id_org");
	    new a = GetPVarInt(playerid, "id_membro");
	    if(i == -1) return 1;
	    new cc = Org[i][o_Membros][a];

	    if(response)
	    {
	        // ultimo login //
	        if(listitem == 0)
	        {
	            new sss[300];
	            strcat(sss, "\n{00ffff}");
	            strcat(sss, NomeConta(cc));
	            strcat(sss, "\n");
	            strcat(sss, "{ffff00}");
	            strcat(sss, nome_cargo(Org[i][o_Cargos][a], i));
	            strcat(sss, "\n");
	            strcat(sss, "\n");
	            strcat(sss, "{ffffff}Ultimo Login: {a1a1a1}");
	            new ss1[100];
	            new player = ContaOnline(cc);
	            if(Online(player)) format(ss1, 100, "%02d/%02d/%02d - %02d:%02d", Conta[player][c_Dia], Conta[player][c_Mes], Conta[player][c_Ano], Conta[player][c_Hora], Conta[player][c_Minuto]);
	            else format(ss1, 100, "%02d/%02d/%02d - %02d:%02d", GetContaInt(cc, "c_Dia"), GetContaInt(cc, "c_Mes"), GetContaInt(cc, "c_Ano"), GetContaInt(cc, "c_Hora"), GetContaInt(cc, "c_Minuto"));
				strcat(sss, ss1);
	            strcat(sss, "\n\n");
				ShowPlayerDialog(playerid, DIALOG_ORG5, DIALOG_STYLE_MSGBOX, "Ultimo Login", sss, "Ok", "Voltar");
	        }

	        // expulssar membro //
	        if(listitem == 1)
	        {
                new sss[300];
	            strcat(sss, "\n{00ffff}");
	            strcat(sss, NomeConta(cc));
	            strcat(sss, "\n");
	            strcat(sss, "{ffff00}");
	            strcat(sss, nome_cargo(Org[i][o_Cargos][a], i));
	            strcat(sss, "\n");
	            strcat(sss, "\n");
	            strcat(sss, "{ffffff}Deseja expulsar este membro da Organizacao ?\n\n");
	            ShowPlayerDialog(playerid, DIALOG_ORG6, DIALOG_STYLE_MSGBOX, "Expulsar membro", sss, "Ok", "Voltar");
	        }

	        // setar cargo //
	        if(listitem == 2)
	        {
                new sss[300];
                if(c == -1) return 1;
                if(OrgPlayer(playerid) == i)
                {
	                for(new fff; fff<5; fff++) strcat(sss, nome_cargo(fff, i)), strcat(sss, "\n");
	                if(Conta[playerid][c_Cargo] == 6) strcat(sss, nome_cargo(5, i)), strcat(sss, "\n");
	                ShowPlayerDialog(playerid, DIALOG_ORG7, DIALOG_STYLE_LIST, NomeConta(Org[i][o_Membros][a]), sss, "Setar", "Voltar");
                }
	        }

	        // setar cargo manual //
	        if(listitem == 3)
	        {
                new sss[300];
                if(c == -1) return 1;
                if(OrgPlayer(playerid) == i)
                {
					for(new fff=1; fff<6; fff++) strcat(sss, nome_cargo(fff, i)), strcat(sss, "\n");
	                ShowPlayerDialog(playerid, DIALOG_ORG7, DIALOG_STYLE_LIST, NomeConta(Org[i][o_Membros][a]), sss, "Setar", "Voltar");
                }
	        }

	    }
	    else abrir_membros_org(playerid, i);
	    return 1;
	}

	// dialog membros da org //
	if(dialogid == DIALOG_ORG3)
	{
	    new i = GetPVarInt(playerid, "id_org");
	    if(i == -1) return 1;
	    if(Org[i][o_Existe] == 0) return 1;
	    if(response)
	    {
	    	new a = listitem;
			if(OrgPlayer(playerid) != i) return 1;
			if(c == -1) return 1;

			// se nao for lider ou sub //
			if(Conta[playerid][c_Cargo] < 5)
			{
			    ms(playerid, 0, "Apenas Lider e Sub Liders podem fazer isso !");
				abrir_membros_org(playerid, i);
	    	    return 1;
			}

	    	// vaga vazia //
	    	if(Org[i][o_Membros][a] == -1)
	    	{
				ms(playerid, 0, "Vaga vazia !");
				abrir_membros_org(playerid, i);
	    	    return 1;
	    	}

	    	// se for a vada dele //
			if(c == Org[i][o_Membros][a])
			{
			    ms(playerid, 0, "Voce nao pode editar sua propria vaga !");
				abrir_membros_org(playerid, i);
	    	    return 1;
			}

	    	// vaga de lider //
	    	if(Org[i][o_Cargos][a] > 5)
	    	{
	    	    ms(playerid, 0, "Nao e possivel editar a vaga do Lider !");
				abrir_membros_org(playerid, i);
				return 1;
	    	}
			opcoes_membro_org(playerid, i, a);
	    }
	    else abrir_org(playerid, i);
	    return 1;
	}

	// lavar dinheiro //
	if(dialogid == DIALOG_ORG21)
	{
	    new i = GetPVarInt(playerid, "id_org");
		if(response)
		{
		    Acao(playerid, 21, 1000, "LAVANDO DINHEIRO", 0, "null", "null", false);
		    ms(playerid, 2, "Lavando dinheiro, aguarde ...");
		}
		else abrir_org(playerid, i);
	    return 1;
	}

	// garagem dinamica - pegar veiculo //
	if(dialogid == DIALOG_GARAGEM_DINAMICA)
	{
	    if(response)
		{
		    new v = Lista2[playerid][listitem];
		    if(v != -1 && Veiculo[v][v_Existe] == 1 && Veiculo[v][v_Garagem] == 1)
			{
			    if(Veiculo[v][v_Dono] == id[playerid])
				{
				    GetPlayerPos(playerid, Veiculo[v][v_X], Veiculo[v][v_Y], Veiculo[v][v_Z]);
				    GetPlayerFacingAngle(playerid, Veiculo[v][v_A]);
				    Veiculo[v][v_Garagem] = 0;
				    if(flood_tirar_veiculo[v] > gettime()) return ms(playerid, 0, "AntFlood da garagem detectado, aguarde e tente novamente !");
				    flood_tirar_veiculo[v] = gettime()+2;
				    spawn_veiculo(v);
				    PutPlayerInVehicle(playerid, Veiculo[v][v_ID], 0);
				    ms(playerid, 1, "Voce pegou o veiculo da garagem.");
				}
			}
		}
	    return 1;
	}

	// dialog info org //
	if(dialogid == DIALOG_ORG2)
	{
	    new i = GetPVarInt(playerid, "id_org");
	    abrir_org(playerid, i);
	    return 1;
	}

	// dialog menu org //
	if(dialogid == DIALOG_ORG)
	{
	    new i = GetPVarInt(playerid, "id_org");
	    if(i == -1) return 1;
	    if(Org[i][o_Existe] == -1) return 1;
	    if(response)
	    {
			// informacoes //
	        if(listitem == 0)
	        {
	            new sss[150];
	            SG[0] = EOS;
	            strcat(SG, "{00ffff}"),strcat(SG, Org[i][o_Nome]),strcat(SG, "\n\n");
	            format(sss, 150, "{ffffff}Tag: {a1a1a1}%s\n", Org[i][o_Tag]);
	            strcat(SG, sss);
	            format(sss, 150, "{ffffff}Criada: {a1a1a1}%02d/%02d/%04d\n", Org[i][o_Dia], Org[i][o_Mes], Org[i][o_Ano]);
	            strcat(SG, sss);
	            format(sss, 150, "{ffffff}Cofre: {4169E1}R$ %s\n", ConvertMoney(Org[i][o_Cofre]));
	            strcat(SG, sss);
	            if(Org[i][o_Membros][0] != -1)
	            {
	                new ccc = Org[i][o_Membros][0];
					new player = ContaOnline(ccc);
					if(Online(player)) format(sss, 150, "{ffffff}Lider: {ffff00}%s {a1a1a1}%d\n\n", Nome(player), Org[i][o_Membros][0]);
					else format(sss, 150, "{ffffff}Lider: {ffff00}%s {a1a1a1}%d\n\n", NomeConta(ccc), Org[i][o_Membros][0]);
		            strcat(SG, sss);
	            }
	            else strcat(SG, "{ffffff}Lider: {a1a1a1}Ninguem\n\n");

				// comandos //
	            strcat(SG, "{00ffff}COMANDOS\n\n");
	            for(new v; v<sizeof ComandosOrg; v++)
	            {
	                if(strval(ComandosOrg[v][2]) == -1 )
	                {
	                    format(sss, 150, "{ffffff}%s  {a1a1a1}%s\n", ComandosOrg[v][0], ComandosOrg[v][1]);
	                    strcat(SG, sss);
	                }

	                if(strval(ComandosOrg[v][2]) == 0)
	                {
	                    if(OrgCop(i))
	                    {
		                    format(sss, 150, "{ffffff}%s  {a1a1a1}%s\n", ComandosOrg[v][0], ComandosOrg[v][1]);
		                    strcat(SG, sss);
	                    }
	                }
	                else
	                {
	                    if(strval(ComandosOrg[v][2]) == Org[i][o_Tipo])
	                    {
	                        format(sss, 150, "{ffffff}%s  {a1a1a1}%s\n", ComandosOrg[v][0], ComandosOrg[v][1]);
		                    strcat(SG, sss);
	                    }
	                }
	            }

	            ShowPlayerDialog(playerid,  DIALOG_ORG2, DIALOG_STYLE_MSGBOX, "Informacoes", SG, "Ok", "Voltar");
	        }

	        // logs //
	        if(listitem == 1)
	        {
	            if(OrgPlayer(playerid) != i && !Scripter(playerid))
	            {
	                ms(playerid, 0, "Area restrita apenas para membros da organizacao !");
	                abrir_org(playerid, i);
	                return 1;
	            }
	            else logs_org(playerid, i);
	        }

	        // membros //
	        if(listitem == 2)
	        {
	            if(OrgPlayer(playerid) != i  && !Scripter(playerid))
	            {
	                ms(playerid, 0, "Area restrita apenas para membros da organizacao !");
	                abrir_org(playerid, i);
	                return 1;
	            }
	            else abrir_membros_org(playerid, i);
	        }

	        // veiculos //
	        if(listitem == 3)
	        {
	            if(OrgPlayer(playerid) != i  && !Scripter(playerid))
	            {
	                ms(playerid, 0, "Area restrita apenas para membros da organizacao !");
	                abrir_org(playerid, i);
	                return 1;
	            }
	            else mostrar_veiculos_org(playerid, i);
	        }

	        // cofre //
	        if(listitem == 4)
	        {
	            if(OrgPlayer(playerid) != i  && !Scripter(playerid))
	            {
	                ms(playerid, 0, "Area restrita apenas para membros da organizacao !");
	                abrir_org(playerid, i);
	                return 1;
	            }
	            else mostrar_cofre_org(playerid, i);
	        }

	        // convidar //
	        if(listitem == 5)
	        {
	            if(OrgPlayer(playerid) != i)
	            {
	                ms(playerid, 0, "Area restrita apenas para membros da organizacao !");
	                abrir_org(playerid, i);
	                return 1;
	            }

	            if(Conta[playerid][c_Cargo] < 5)
				{
	                ms(playerid, 0, "Voce precisa ser Lider ou Sub lider para convidar alguem !");
	                abrir_org(playerid, i);
	                return 1;
	            }

	            if(membros(i) == 30)
	            {
	                ms(playerid, 0, "A Organizacao atingiu o Limite de membros !");
	                abrir_org(playerid, i);
	                return 1;
	            }
	            convidar_org(playerid, i);
	        }

	        // armas //
	        if(listitem == 6)
	        {
	            if(OrgPlayer(playerid) != i && ModoAdmin[playerid] == 0)
	            {
	                ms(playerid, 0, "Area restrita apenas para membros da organizacao !");
	                abrir_org(playerid, i);
	                return 1;
	            }
	            else if(CargoPlayer(playerid) < 2 && ModoAdmin[playerid] == 0)
	            {
	                ms(playerid, 0, "Area restrita apenas para Cargo 3 ou superior !");
	                abrir_org(playerid, i);
	                return 1;
	            }
	            else abrir_armas_org(playerid, i);
	        }

	        // colete //
	        if(listitem == 7)
	        {
	            if(OrgPlayer(playerid) != i)
	            {
	                ms(playerid, 0, "Voce nao pertence a esta organizacao !");
	                abrir_org(playerid, i);
	                return 1;
	            }
	            else abrir_colete_org(playerid, i);
			}

	        // skins //
	        if(listitem == 8)
	        {
	            if(OrgPlayer(playerid) != i  && !Scripter(playerid))
	            {
	                ms(playerid, 0, "Voce nao pertence a esta organizacao !");
	                abrir_org(playerid, i);
	                return 1;
	            }
	        	else abrir_skins_org(playerid, i);
			}
	    }
	    return 1;
	}

    // dialog tipo academia //
	if(dialogid == DIALOG_ACADEMIA_TIPO)
	{
	    if(response)
	    {
	        new i = GetPVarInt(playerid, "id_aparelho");
	        if(Academia[i][aca_Existe] == 1)
	        {
				Academia[i][aca_Tipo] = listitem;
				atualizar_academia(i);
				salvar_academia(i);
				ms(playerid, 1, "O tipo do aparelho de academia foi alterado com sucesso !");
			}
			else ms(playerid, 0, "Este aparelho de academia nao existe mais !");
		}
	    return 1;
	}

	// dialog criar academia //
	if(dialogid == DIALOG_ACADEMIA_CRIAR)
	{
	    if(response)
	    {
			new Float:pos[4];
			GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
			GetPlayerFacingAngle(playerid, pos[3]);
			PegarFrentePlayer(playerid, pos[0], pos[1], 4);
			new l = criar_academia(pos[0], pos[1], pos[2], pos[3], listitem, GetPlayerInterior(playerid), GetPlayerVirtualWorld_(playerid));
			if(l == -1) return ms(playerid, 0, "Numero Maximo de Aparelhos de Academia criados !");
			new sss[300];
			format(sss, 300, "Aparelho ID: %d criado, Tipo - %s.", l, academia_nome[listitem]);
			ms(playerid, 1, sss);
			EditandoAcademia[playerid] = l;
			EditDynamicObject2(playerid, Academia[l][aca_Obj][0]);
			ms(playerid, 1, "Movimente o objeto usando o editor, e salve a posicao.");
		}
	    return 1;
	}

	// dialog academia //
	if(dialogid == DIALOG_ACADEMIA)
	{
	    if(response)
	    {
			new i = GetPVarInt(playerid, "id_aparelho");
	        if(Academia[i][aca_Existe] == 1)
	        {
	            if(Academia[i][aca_Disponivel] == 0)
	            {
		            if(Academia[i][aca_Player] == -1)
		            {
		                if(GetPVarInt(playerid, "flood_academia") < gettime())
		                {
		                	usar_aparelho(playerid, i);
		                }
		                else ms(playerid, 0, "Aguarde algums segundos para usar um aparelho novamente !");
		            }
		            else ms(playerid, 0, "Este aparelho ja esta sendo usado no momento !");
	            }
	            else ms(playerid, 0, "Aguarde ate o aparelho estar disponivel !");
	        }
	    }
	    return 1;
	}

	// dialog comprar lanche //
	if(dialogid == DIALOG_COMPRAR_LANCHE)
	{
	    if(c == -1) return 1;
	    if(response)
	    {
	        new i = GetPVarInt(playerid, "id_lanche");

			// caso nao tenha grana //
	        if(GranaPlayer(playerid) < lanches[i][lan_Valor])
	        {
	            comprar_lanche(playerid, i);
	            ms(playerid, 0, "Voce nao tem dinheiro suficiente para comprar o lanche !");
	            return 1;
	        }
	        new sss[150];

	        // comer no local //
	        if(listitem == 0)
	        {
	            DarVida(playerid, 3);
				format(sss, 150, "Voce pagou R$ %s em %d %s.", ConvertMoney(lanches[i][lan_Valor]), lanches[i][lan_Unidades], nome_lanche(i));
				// se for comida //
				if(lanches[i][lan_Tipo] == -999)
				{
					Conta[playerid][c_Fome] += diminuir_lanche(lanches[i][lan_ID]);
					if(Conta[playerid][c_Fome] > 100) Conta[playerid][c_Fome] = 100;
					atualizar_fome(playerid);
					format(string_prox, 300, "? '%s' comeu %d %s ?", Nome(playerid), 1, nome_lanche(i));
				}
				// se for bebida //
				if(lanches[i][lan_Tipo] == -888)
				{
				    Conta[playerid][c_Sede] += diminuir_lanche(lanches[i][lan_ID]);
					if(Conta[playerid][c_Sede] > 100) Conta[playerid][c_Sede] = 100;
					atualizar_sede(playerid);
					format(string_prox, 300, "** '%s' bebeu %d %s **", Nome(playerid), 1, nome_lanche(i));
				}
				ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
			}

	        // colocar no inventario //
	        new slot = inv_vazio(playerid);
	        if(listitem == 1)
	        {
				if(slot == -1)
				{
				    comprar_lanche(playerid, i);
					ms(playerid, 0, "Seu inventario esta cheio !");
					return 1;
				}
				Inventario[playerid][slot][inv_ID] = lanches[i][lan_ID];
				Inventario[playerid][slot][inv_Unidades] = lanches[i][lan_Unidades];
				Inventario[playerid][slot][inv_Tipo] = lanches[i][lan_Tipo];
				format(sss, 150, "Voce pagou R$ %s em %d %s, confira seu inventario.", ConvertMoney(lanches[i][lan_Valor]), lanches[i][lan_Unidades], nome_lanche(i));
	        }
	        DarGrana(playerid, -lanches[i][lan_Valor]);
	        ms(playerid, 1, sss);
	        salvar_inventario(c, slot);
	    }
	    return 1;
	}


	// dialog nota fiscal de entrega //
	if(dialogid == DIALOG_NOTA2)
	{
	    if(response)
	    {
	        resetar_nota_player(playerid);
	        ms(playerid, 1, "Voce rasgou a nota fiscal e a entrega foi cancelada !");
	    }
	    else nota(playerid);
	    return 1;
	}

	// dialog nota fiscal de entrega //
	if(dialogid == DIALOG_NOTA)
	{
	    if(response)
	    {
	        if(listitem == 0)
	        {
	            mostrar_nota(playerid, playerid);
	        }
	        if(listitem == 1)
	        {
	            PlayersPerto(playerid, 20, 4);
	        }
	        if(listitem == 2)
	        {
	            ShowPlayerDialog(playerid, DIALOG_NOTA2, DIALOG_STYLE_MSGBOX, "Rasgar Nota", "{a1a1a1}Deseja realmente rasgar a nota Fiscal e\ncancelar a entrega atual ?", "Rasgar", "Nao");
	        }
	    }
	    return 1;
	}

	// DIALOG COMPRAR ACESSORIOS //
	if(dialogid == DIALOG_COMPRAR_ACESSORIOS)
	{
	    if(response)
	    {
            lista_de_acessorios(playerid, listitem);
	    }
	    return 1;
	}

	// dialog banco deposito invalido //
	if(dialogid == DIALOG_BANCO11)
	{
		if(c == -1) return 1;
		AbrirBanco(playerid, 3);
	    return 1;
	}

	// dialog banco saque invalido //
	if(dialogid == DIALOG_BANCO13)
	{
		if(c == -1) return 1;
		AbrirBanco(playerid, 4);
	    return 1;
	}

	// dialog banco //
	if(dialogid == DIALOG_BANCO10)
	{
		if(response)
		{

		    new ce = GetPVarInt(playerid, "ce");
		    if(ce != -1)
		    {
			    if(CaixaEletronico[ce][ce_Dinheiro] >= 100000)
				{
					ShowPlayerDialog(playerid, DIALOG_BANCO11, DIALOG_STYLE_MSGBOX, "{FF0000}ERRO", "{ffffff}Este Caixa eletronico ja tem muito\ndinheiro, tente outro ou va ate o Banco !", "Voltar", "Fechar");
	                return 1;
				}
			}

		    if(strlen(inputtext) < 1)
		    {
		        ShowPlayerDialog(playerid, DIALOG_BANCO11, DIALOG_STYLE_MSGBOX, "{FF0000}ERRO", "{ffffff}Digite um valor para ser depositado !", "Voltar", "Fechar");
		        return 1;
		    }

		    if(!IsNumeric(inputtext))
		    {
		        ShowPlayerDialog(playerid, DIALOG_BANCO11, DIALOG_STYLE_MSGBOX, "{FF0000}ERRO", "{ffffff}Digite apenas Numeros !", "Voltar", "Fechar");
		        return 1;
		    }

			new valor = strval(inputtext);
		    if(valor <= 0)
		    {
		    	ShowPlayerDialog(playerid, DIALOG_BANCO11, DIALOG_STYLE_MSGBOX, "{FF0000}ERRO", "{ffffff}Digite um valor maior que 0 !", "Voltar", "Fechar");
		    	return 1;
		    }

		    if(valor > GranaPlayer(playerid))
		    {
		    	ShowPlayerDialog(playerid, DIALOG_BANCO11, DIALOG_STYLE_MSGBOX, "{FF0000}ERRO", "{ffffff}Voce nao tem esse valor em maos !", "Voltar", "Fechar");
		        return 1;
		    }


		    if(ce != -1)
		    {
		        if(valor > 10000)
				{
                    ShowPlayerDialog(playerid, DIALOG_BANCO11, DIALOG_STYLE_MSGBOX, "{FF0000}ERRO", "{ffffff}Depositos acima de R$ 10.000 devem ser feitos no banco !", "Voltar", "Fechar");
                    return 1;
			    }
		    }

		    if(ce != -1)
			{
			    CaixaEletronico[ce][ce_Dinheiro] += valor;
			    texto_caixa_eletronico(ce);
			    salvar_caixa_eletronico(ce);
			}

            SetPVarInt(playerid, "flood_deposito", gettime()+300);
		    DarGrana(playerid, -valor);
		    DarBanco(playerid, valor);
		    new sss[300];
		    format(sss, 300, "ITAU - Deposito no valor de R$ %s concluido com sucesso !", ConvertMoney(valor));
		    ms(playerid, 1, sss);
		}
		else AbrirBanco(playerid, 0);
	    return 1;
	}

	// dialog saque banco //
	if(dialogid == DIALOG_BANCO12)
	{
		if(response)
		{
		    if(strlen(inputtext) < 1)
		    {
		        ShowPlayerDialog(playerid, DIALOG_BANCO13, DIALOG_STYLE_MSGBOX, "{FF0000}ERRO", "{ffffff}Digite um valor para sacar da conta !", "Voltar", "Fechar");
		        return 1;
		    }

		    if(!IsNumeric(inputtext))
		    {
		        ShowPlayerDialog(playerid, DIALOG_BANCO13, DIALOG_STYLE_MSGBOX, "{FF0000}ERRO", "{ffffff}Digite apenas Numeros !", "Voltar", "Fechar");
		        return 1;
		    }

			new valor = strval(inputtext);
		    if(valor <= 0)
		    {
		    	ShowPlayerDialog(playerid, DIALOG_BANCO13, DIALOG_STYLE_MSGBOX, "{FF0000}ERRO", "{ffffff}Digite um valor maior que 0 !", "Voltar", "Fechar");
		    	return 1;
		    }

		    if(valor > Conta[playerid][c_Banco])
		    {
		    	ShowPlayerDialog(playerid, DIALOG_BANCO13, DIALOG_STYLE_MSGBOX, "{FF0000}ERRO", "{ffffff}Voce nao tem esse valor na sua conta bancaria !", "Voltar", "Fechar");
		        return 1;
		    }

		    new ce = GetPVarInt(playerid, "ce");
		    if(ce != -1)
		    {
		        if(valor > 10000)
				{
                    ShowPlayerDialog(playerid, DIALOG_BANCO13, DIALOG_STYLE_MSGBOX, "{FF0000}ERRO", "{ffffff}Saques acima de R$ 10.000 devem ser feitos no banco !", "Voltar", "Fechar");
                    return 1;
			    }
		    }

		    if(ce != -1)
			{
			    if(CaixaEletronico[ce][ce_Dinheiro] < valor)
				{
				ShowPlayerDialog(playerid, DIALOG_BANCO13, DIALOG_STYLE_MSGBOX, "{FF0000}ERRO", "{ffffff}Este caixa eletronico nao possue essa quantia no momento !", "Voltar", "Fechar");
                    return 1;
			    }
			    CaixaEletronico[ce][ce_Dinheiro] -= valor;
			    texto_caixa_eletronico(ce);
			    salvar_caixa_eletronico(ce);
			}

		    DarGrana(playerid, valor);
		    DarBanco(playerid, -valor);
		    new sss[300];
		    format(sss, 300, "ITAU - Saque no valor de R$ %s concluido com sucesso !", ConvertMoney(valor));
		    ms(playerid, 1, sss);
		}
		else AbrirBanco(playerid, 0);
	    return 1;
	}

	// dialog banco conta invalida //
	if(dialogid == DIALOG_BANCO9)
	{
		if(c == -1) return 1;
		AbrirBanco(playerid, 2);
	    return 1;
	}

	// transferencia  //
	if(dialogid == DIALOG_BANCO8)
	{
		if(c == -1) return 1;
		if(response)
		{
		    // digitar ID da CONTA //
		    if(opcao_transferir[playerid] == 0)
		    {

		        if(strlen(inputtext) < 1)
				{
				ShowPlayerDialog(playerid, DIALOG_BANCO9, DIALOG_STYLE_MSGBOX, "{FF0000}ERRO", "{ffffff}A conta informada nao existe !", "Voltar", "Fechar");
				return 1;
			    }

			    if(!IsNumeric(inputtext))
				{
				ShowPlayerDialog(playerid, DIALOG_BANCO9, DIALOG_STYLE_MSGBOX, "{FF0000}ERRO", "{ffffff}Digite apenas Numeros !", "Voltar", "Fechar");
				return 1;
			    }

			    new cc = strval(inputtext);
			    if(ContaInvalida(cc))
				{
				ShowPlayerDialog(playerid, DIALOG_BANCO9, DIALOG_STYLE_MSGBOX, "{FF0000}ERRO", "{ffffff}A conta informada nao existe !", "Voltar", "Fechar");
				return 1;
			    }

			    if(c == cc)
				{
				ShowPlayerDialog(playerid, DIALOG_BANCO9, DIALOG_STYLE_MSGBOX, "{FF0000}ERRO", "{ffffff}Voce nao pode transferir alguma quantia para sua propria conta !", "Voltar", "Fechar");
				return 1;
			    }

			    SetPVarInt(playerid, "id_transferencia", cc);
			    opcao_transferir[playerid] = 1;
			    AbrirBanco(playerid, 2);
			    return 1;
		    }

		    // digitar valor da transferencia //
		    if(opcao_transferir[playerid] == 1)
		    {
		        if(!IsNumeric(inputtext))
				{
				ShowPlayerDialog(playerid, DIALOG_BANCO9, DIALOG_STYLE_MSGBOX, "{FF0000}ERRO", "{ffffff}Digite apenas Numeros !", "Voltar", "Fechar");
				return 1;
			    }

			    if(strlen(inputtext) < 1)
				{
				ShowPlayerDialog(playerid, DIALOG_BANCO9, DIALOG_STYLE_MSGBOX, "{FF0000}ERRO", "{ffffff}Informe um valor a ser transferido !", "Voltar", "Fechar");
				return 1;
			    }

			    new valor = strval(inputtext);
			    if(valor <= 0)
				{
				ShowPlayerDialog(playerid, DIALOG_BANCO9, DIALOG_STYLE_MSGBOX, "{FF0000}ERRO", "{ffffff}Digit um evalor maior que 0 !", "Voltar", "Fechar");
				return 1;
			    }

			    if(GetPVarInt(playerid, "ce") != -1)
				{
				if(valor > 10000)
					{
	                    ShowPlayerDialog(playerid, DIALOG_BANCO9, DIALOG_STYLE_MSGBOX, "{FF0000}ERRO", "{ffffff}Transferencias acima de R$ 10.000 devem ser feitos no banco !", "Voltar", "Fechar");
	                    return 1;
				    }
			    }

			    if(valor > Conta[playerid][c_Banco])
				{
			    	ShowPlayerDialog(playerid, DIALOG_BANCO9, DIALOG_STYLE_MSGBOX, "{FF0000}ERRO", "{ffffff}Voce nao tem essa quantia em sua conta bancaria !", "Voltar", "Fechar");
				return 1;
			    }

			    new str1[300];
			    format(str1, 300, "ITAU - O Jogador '%s' transferiu R$ %s para sua conta bancaria.", Nome(playerid), ConvertMoney(valor) );
			    new cc = GetPVarInt(playerid, "id_transferencia");
			    new player = ContaOnline(cc);
			    if(Online(player))
				{
				ms(player, 1, str1);
				DarBanco(player, valor);
			    }
			    else
				{
				msc(cc, 1, str1);
				new grana = GetContaInt(cc, "c_Banco");
				salvar_conta(cc, 0, "c_Banco", sv_int(grana+valor));
			    }
			    DarBanco(playerid, -valor);
			    format(str1, 300, "ITAU - Voce transferiu R$ %s para a conta bancaria de '%s'.", ConvertMoney(valor), NomeConta(cc));
				ms(playerid, 1, str1);
				return 1;
			}
		}
		else AbrirBanco(playerid, 0);
	    return 1;
	}


	// dialog banco //
	if(dialogid == DIALOG_BANCO7)
	{
		if(c == -1) return 1;
		AbrirBanco(playerid, 0);
	    return 1;
	}

	// dialog criar conta do banco //
	if(dialogid == DIALOG_BANCO1)
	{
		if(c == -1) return 1;
	    if(response)
	    {
			MS(playerid, 2, "Documentos verificados com sucesso ! Aguarde ...");
			Acao(playerid, 26, 300, "CRIANDO CONTA", 0, "null", "null", false);
	    }
	    return 1;
	}

	// dialog da loterica - loteria //
	if(dialogid == DIALOG_LOTERICA3)
	{
	    new linha[150];
	    if(response)
	    {
	        if(c != -1)
	        {
	            new b = bilhete_player(playerid);
	            if(b != -1)
		        {
		            format(linha, 150, "Voce ja possui um bilhete para o proximo sorteio ! Numero: %05d.", bilhetes[b][1]);
		            ms(playerid, 2, linha);
		            mostrar_loterica(playerid);
		            return 1;
		        }

		        if(GranaPlayer(playerid) < BILHETE)
		        {
		            format(linha, 150, "Voce nao tem R$ %s para comprar um bilhete !", ConvertMoney(BILHETE));
		            ms(playerid, 0, linha);
	                mostrar_loterica(playerid);
	                return 1;
		        }

				new bbb = comprar_bilhete();
		        if(bbb == -1)
		        {
		            ms(playerid, 0, "Os Bilhetes desse sorteio se esgotaram ! Tente Na Prtoxima vez.");
	                mostrar_loterica(playerid);
	                return 1;
		        }

		        new numero = random(100000);
		        Conta[playerid][c_Loteria] = payday_server;
		        salvar_conta(c, 0, "c_Loteria", sv_int(payday_server));
		        bilhetes[bbb][0] = id[playerid];
				bilhetes[bbb][1] = numero;
		        format(linha, 150, "Voce pagou R$ %s em um bilhete da Loteria! Numero: %05d.", ConvertMoney(BILHETE), numero);
		        DarGrana(playerid, -BILHETE);
		        ms(playerid, 2, linha);
		        new sorteio[50];
		        if(HORA == 23) format(sorteio, 50, "00:00");
		        else format(sorteio, 50, "%02d:00", HORA+1);
		        premio_loteria += BILHETE;
		        format(linha, 150, "O sorteio do premio de R$ %s sera as %s.", ConvertMoney(premio_loteria), sorteio);
		        ms(playerid, 2, linha);
		        mostrar_loterica(playerid);
		        salvar_definicoes("Loteria");
	        }
	    }
	    else mostrar_loterica(playerid);
	    return 1;
	}

	// dialog das Multas //
	if(dialogid == DIALOG_LOTERICA5)
	{
	    if(response)
	    {
	        if(c == -1) return 1;
	        new linha[150];
	        new i = Lista[playerid][listitem];

	        if(i == -1)
	        {
	            ms(playerid, 0, "Voce nao tem multas para pagar !");
                mostrar_loterica(playerid);
                return 1;
	        }

	        if(GranaPlayer(playerid) < Multas[playerid][i][mu_Valor])
	        {
	            format(linha, 150, "Voce nao tem R$ %s para pagar esta Multa !", ConvertMoney(Multas[playerid][i][mu_Valor]));
	            ms(playerid, 0, linha);
                mostrar_loterica(playerid, 4);
                return 1;
	        }

	        format(linha, 150, "Voce pagou uma multa no valor de R$ %s.", ConvertMoney(Multas[playerid][i][mu_Valor]));
	        DarGrana(playerid, -Multas[playerid][i][mu_Valor]);
	        Multas[playerid][i][mu_Existe] = 0;
	        Multas[playerid][i][mu_Valor] = 0;
	        Multas[playerid][i][mu_Conta] = -1;
	        Multas[playerid][i][mu_Radar] = -1;
	        format(Multas[playerid][i][mu_Motivo], 100, "_");
	        format(Multas[playerid][i][mu_Data], 50, "_");
	        salvar_multas(c);
	        mostrar_loterica(playerid, 4);
	        ms(playerid, 1, linha);
	    }
	    else mostrar_loterica(playerid);
		return 1;
	}

	// dialog da LOTERICA IPTU //
	if(dialogid == DIALOG_LOTERICA4)
	{
	    if(response)
	    {
	        if(c == -1) return 1;
	        new linha[150];
	        new i = Lista[playerid][listitem];

	        if(i == -1)
	        {
	            ms(playerid, 0, "Voce nao tem uma Casa ou Apartamento !");
                mostrar_loterica(playerid);
                return 1;
	        }

	        if(Casa[i][casa_Existe] == 0)
	        {
	            ms(playerid, 0, "Esta casa nao existe mais !");
                mostrar_loterica(playerid, 3);
                return 1;
	        }

	        if(Casa[i][casa_Dono] != c)
	        {
	            ms(playerid, 0, "Voce nao e o dono desta casa ou apartamento !");
                mostrar_loterica(playerid, 3);
                return 1;
	        }

	        if(Casa[i][casa_Contas] == 0)
	        {
	            ms(playerid, 0, "O IPTU desta casa/apartamento ja foi pago recentemente !");
                mostrar_loterica(playerid, 3);
                return 1;
	        }

	        if(GranaPlayer(playerid) < Casa[i][casa_Contas])
	        {
	            format(linha, 150, "Voce nao tem R$ %s para pagar este IPTU !", ConvertMoney(Casa[i][casa_Contas]));
	            ms(playerid, 0, linha);
                mostrar_loterica(playerid, 3);
                return 1;
	        }

	        format(linha, 150, "Voce pagou R$ %s de IPTU da Casa/Apartamento ID: %d.", ConvertMoney(Casa[i][casa_Contas]), i);
	        DarGrana(playerid, -Casa[i][casa_Contas]);
	        add_cp(Casa[i][casa_Contas]);
	        Casa[i][casa_Contas] = 0;
	        Casa[i][casa_Data] = 7;
	        salvar_casa(i);
	        mostrar_loterica(playerid, 3);
	        ms(playerid, 1, linha);
	    }
	    else mostrar_loterica(playerid);
	    return 1;
	}

	// dialog da LOTERICA IPVA //
	if(dialogid == DIALOG_LOTERICA2)
	{
	    if(response)
	    {
	        if(c == -1) return 1;
	        new linha[150];
	        new i = Lista[playerid][listitem];
	        if(i == -1)
	        {
	            ms(playerid, 0, "Voce nao tem um veiculo pessoal !");
                mostrar_loterica(playerid);
                return 1;
	        }

	        if(Veiculo[i][v_Dono] != c)
	        {
	            ms(playerid, 0, "Voce nao e o dono deste veiculo !");
                mostrar_loterica(playerid, 1);
                return 1;
	        }

	        if(Veiculo[i][v_Existe] == 0)
	        {
	            ms(playerid, 0, "Este veiculo nao existe mais !");
                mostrar_loterica(playerid, 1);
                return 1;
	        }

	        if(Veiculo[i][v_Contas] == 0)
	        {
	            ms(playerid, 0, "O IPVA deste veiculo ja foi pago recentemente !");
                mostrar_loterica(playerid, 1);
                return 1;
	        }

         	if(GranaPlayer(playerid) < Veiculo[i][v_Contas])
	        {
	            format(linha, 150, "Voce nao tem R$ %s para pagar este IPVA !", ConvertMoney(Veiculo[i][v_Contas]));
	            ms(playerid, 0, linha);
                mostrar_loterica(playerid, 1);
                return 1;
	        }

	        format(linha, 150, "Voce pagou R$ %s de IPVA do veiculo '%s' info: %d.", ConvertMoney(Veiculo[i][v_Contas]), NomeVeiculo(Veiculo[i][v_Modelo]), i);
	        DarGrana(playerid, -Veiculo[i][v_Contas]);
	        add_cp(Veiculo[i][v_Contas]);
	        Veiculo[i][v_Contas] = 0;
	        Veiculo[i][v_IPVA] = 15;
	        SalvarInfo(i);
	        mostrar_loterica(playerid, 1);
	        ms(playerid, 1, linha);
	    }
	    else mostrar_loterica(playerid);
	    return 1;
	}


	// dialog da LOTERICA //
	if(dialogid == DIALOG_LOTERICA)
	{
	    if(response)
	    {
	        // pagar casas //
	        if(listitem == 0)
	        {
                mostrar_loterica(playerid, 3);
	        }

	        // pagar veiculos //
	        if(listitem == 1)
	        {
                mostrar_loterica(playerid, 1);
	        }

	        // fazer aposta //
	        if(listitem == 2)
	        {
                mostrar_loterica(playerid, 2);
	        }

	        // multas //
	        if(listitem == 3)
	        {
                mostrar_loterica(playerid, 4);
	        }

	    }
	    return 1;
	}


	// dialog editar info dos veiculos //
	if(dialogid == DIALOG_INFO_VEICULOS3)
	{
	    new i = GetPVarInt(playerid, "id_info_veiculo");
	    if(!response) opcao_veiculo(playerid, i);
	    else
		{

		    new opc = GetPVarInt(playerid, "opcao_info_veiculo");
		    // nome //
		    if(opc == 0)
		    {
				if(strlen(inputtext) < 3)
				{
				    ms(playerid, 0, "Nome muito curto, Tente novamente !");
				    OnDialogResponse(playerid, DIALOG_INFO_VEICULOS2, 1, opc, "");
				    return 1;
				}
				format(info_veiculos[i][veh_Nome], 80, inputtext);
	            salvar_info_veiculo(i);
				ms(playerid, 1, "Nome do veiculo alterado com sucesso !");
				opcao_veiculo(playerid, i);
		        return 1;
		    }

		    // velocidade //
		    if(opc == 1)
		    {
				if(!IsNumeric(inputtext))
				{
				    ms(playerid, 0, "Digite Apenas Numeros !");
				    OnDialogResponse(playerid, DIALOG_INFO_VEICULOS2, 1, opc, "");
				    return 1;
				}
				new valo = strval(inputtext);
				if(valo < 0 || valo > 500)
				{
				    ms(playerid, 0, "Use um valor entre 0 e 500 !");
				    OnDialogResponse(playerid, DIALOG_INFO_VEICULOS2, 1, opc, "");
				    return 1;
				}
				info_veiculos[i][veh_Velocidade] = valo;
	            salvar_info_veiculo(i);
				ms(playerid, 1, "Velcidade maxima do veiculo alterado com sucesso !");
				opcao_veiculo(playerid, i);
		        return 1;
		    }

		    // combustivel //
		    if(opc == 2)
		    {
				info_veiculos[i][veh_Combustivel] = listitem;
				salvar_info_veiculo(i);
				ms(playerid, 1, "Tipo de combustivel alterado com sucesso !");
				opcao_veiculo(playerid, i);
		        return 1;
		    }

		    // capacidade //
		    if(opc == 3)
		    {
	            if(!IsNumeric(inputtext))
				{
				    ms(playerid, 0, "Digite Apenas Numeros !");
				    OnDialogResponse(playerid, DIALOG_INFO_VEICULOS2, 1, opc, "");
				    return 1;
				}
				new valo = strval(inputtext);
				if(valo < 1 || valo > 300)
				{
				    ms(playerid, 0, "Use um valor entre 1 e 300 !");
				    OnDialogResponse(playerid, DIALOG_INFO_VEICULOS2, 1, opc, "");
				    return 1;
				}
				info_veiculos[i][veh_Capacidade] = valo;
	            salvar_info_veiculo(i);
				ms(playerid, 1, "Litros do Tanque do veiculo alterado com sucesso !");
				opcao_veiculo(playerid, i);
		        return 1;
		    }

		    // porta malas //
		    if(opc == 4)
		    {
		        if(!IsNumeric(inputtext))
				{
				    ms(playerid, 0, "Digite Apenas Numeros !");
				    OnDialogResponse(playerid, DIALOG_INFO_VEICULOS2, 1, opc, "");
				    return 1;
				}
				new valo = strval(inputtext);
				if(valo < 0 || valo > MAX_PORTA_MALAS)
				{
				    new str2[150];
				    format(str2, 150, "Use um valor entre 0 e %d !", MAX_PORTA_MALAS);
				    ms(playerid, 0, str2);
				    OnDialogResponse(playerid, DIALOG_INFO_VEICULOS2, 1, opc, "");
				    return 1;
				}
				info_veiculos[i][veh_PortaMalas] = valo;
	            salvar_info_veiculo(i);
				ms(playerid, 1, "Slots do porta Malas alterado com sucesso !");
				opcao_veiculo(playerid, i);
		    }
	    }
	    return 1;
	}

	// dialog editar info dos veiculos //
	if(dialogid == DIALOG_INFO_VEICULOS2)
	{
	    new i = GetPVarInt(playerid, "id_info_veiculo");
	    if(response)
	    {
	        new sss[300];
	        SetPVarInt(playerid, "opcao_info_veiculo", listitem);
	        if(listitem == 0)
	        {
                format(sss, 300, "\n{ffffff}Nome: {ffff00}%s\n{ffffff}Velocidade: {a1a1a1}%d - Km/h\n{ffffff}Combustivel: {ffffff}%s\n{ffffff}Litros: {ffffff}%d\n{ffffff}Slots Porta Malas: {ffffff}%d\n\n{4169E1}INFO: {a1a1a1}Digite o novo Nome do Veiculo:\n\n", info_veiculos[i][veh_Nome], info_veiculos[i][veh_Velocidade], Combustivel(info_veiculos[i][veh_Combustivel]), info_veiculos[i][veh_Capacidade], info_veiculos[i][veh_PortaMalas]);
				ShowPlayerDialog(playerid, DIALOG_INFO_VEICULOS3, DIALOG_STYLE_INPUT, "Alterar Nome", sss, "Ok", "Voltar");
	        }

	        if(listitem == 1)
	        {
                format(sss, 300, "\n{ffffff}Nome: {ffff00}%s\n{ffffff}Velocidade: {a1a1a1}%d - Km/h\n{ffffff}Combustivel: {ffffff}%s\n{ffffff}Litros: {ffffff}%d\n{ffffff}Slots Porta Malas: {ffffff}%d\n\n{4169E1}INFO: {a1a1a1}Digite a nova Velocidade maxima do Veiculo:\n{a1a1a1}O valor 0 ira deixar a velocidade original do GTA.\n\n", info_veiculos[i][veh_Nome], info_veiculos[i][veh_Velocidade], Combustivel(info_veiculos[i][veh_Combustivel]), info_veiculos[i][veh_Capacidade], info_veiculos[i][veh_PortaMalas]);
				ShowPlayerDialog(playerid, DIALOG_INFO_VEICULOS3, DIALOG_STYLE_INPUT, "Alterar Velocidade", sss, "Ok", "Voltar");
	        }

	        if(listitem == 2)
	        {
                ShowPlayerDialog(playerid, DIALOG_INFO_VEICULOS3, DIALOG_STYLE_LIST, "Alterar Combustivel", "Gasolina\nAlcool\nOleo Disel\nGas", "Ok", "Voltar");
	        }

	        if(listitem == 3)
	        {
                format(sss, 300, "\n{ffffff}Nome: {ffff00}%s\n{ffffff}Velocidade: {a1a1a1}%d - Km/h\n{ffffff}Combustivel: {ffffff}%s\n{ffffff}Litros: {ffffff}%d\n{ffffff}Slots Porta Malas: {ffffff}%d\n\n{4169E1}INFO: {a1a1a1}Digite a nova Litros do Tanque do Veiculo:\n\n", info_veiculos[i][veh_Nome], info_veiculos[i][veh_Velocidade], Combustivel(info_veiculos[i][veh_Combustivel]), info_veiculos[i][veh_Capacidade], info_veiculos[i][veh_PortaMalas]);
				ShowPlayerDialog(playerid, DIALOG_INFO_VEICULOS3, DIALOG_STYLE_INPUT, "Alterar Litros do Tanque", sss, "Ok", "Voltar");
	        }

	        if(listitem == 4)
	        {
                format(sss, 300, "\n{ffffff}Nome: {ffff00}%s\n{ffffff}Velocidade: {a1a1a1}%d - Km/h\n{ffffff}Combustivel: {ffffff}%s\n{ffffff}Litros: {ffffff}%d\n{ffffff}Slots Porta Malas: {ffffff}%d\n\n{4169E1}INFO: {a1a1a1}Digite a noma quantidade de slots no porta malas o Veiculo vai ter:\n\n", info_veiculos[i][veh_Nome], info_veiculos[i][veh_Velocidade], Combustivel(info_veiculos[i][veh_Combustivel]), info_veiculos[i][veh_Capacidade], info_veiculos[i][veh_PortaMalas]);
				ShowPlayerDialog(playerid, DIALOG_INFO_VEICULOS3, DIALOG_STYLE_INPUT, "Alterar Slots Porta Malas", sss, "Ok", "Voltar");
	        }
	    }
	    else mostrar_info_veiculos(playerid);
	    return 1;
	}

    // dialog editar info dos veiculos //
	if(dialogid == DIALOG_INFO_VEICULOS)
	{
	    if(response)
	    {
	        new cont = 212;
			new pags;
		    new sobra;
		    new div;
		    if(cont <= 30)
		    {
				pags = 1;
		    }
		    else
		    {
		        pags = cont/30;
		        div = pags*30;
		        sobra = cont - (div);
		        if(sobra > 0) pags ++;
		    }

		    if(pagina_dialog3[playerid]+1 == pags )
		    {
		        if(pags == 1)
		        {
		            if(listitem == 212) // avancar
					{
				    mostrar_info_veiculos(playerid);
						return 1;
		        	}

		        	if(listitem == 212+1) // voltar
					{
				    mostrar_info_veiculos(playerid);
						return 1;
		        	}
		        }
		        else
		        {
		            new sizeo = 212-((pags-1)*30);
		            if(listitem == sizeo)
		            {
		                mostrar_info_veiculos(playerid);
						return 1;
		            }
		            if(listitem == sizeo+1)
		            {
		                if(pagina_dialog3[playerid] > 0) pagina_dialog3[playerid]--;
		                mostrar_info_veiculos(playerid);
						return 1;
		            }
		        }
		    }

	        if(pags == 1)
	        {
	            if(listitem == cont)
	            {
	                mostrar_info_veiculos(playerid);
	            }
				else if(listitem == cont+1)
	            {
	                mostrar_info_veiculos(playerid);
	            }
	            else opcao_veiculo(playerid, listitem);
	            return 1;
	        }
	        else
	        {
		        if(listitem == 30)
		        {
		            if(pagina_dialog3[playerid]+1 < pags)
					{
		                pagina_dialog3[playerid]++;
					}
		            mostrar_info_veiculos(playerid);
				    return 1;
		        }

		        if(listitem == 31)
		        {
	                if(pagina_dialog3[playerid] > 0) pagina_dialog3[playerid]--;
		            mostrar_info_veiculos(playerid);
		            return 1;
		        }
			}
			SetPVarInt(playerid, "listitem", listitem);
			opcao_veiculo(playerid, (pagina_dialog3[playerid]*30) + listitem);
	    }
	    return 1;
	}

	// dialog editar info dos veiculos //
	if(dialogid == DIALOG_INFO_VEICULOS4)
	{
	    if(response)
	    {
	        new cont = 212;
			new pags;
		    new sobra;
		    new div;
		    if(cont <= 30)
		    {
				pags = 1;

		    }
		    else
		    {
		        pags = cont/30;
		        div = pags*30;
		        sobra = cont - (div);
		        if(sobra > 0) pags ++;
		    }

		    if(pagina_dialog5[playerid]+1 == pags )
		    {
		        if(pags == 1)
		        {
		            if(listitem == 212) // avancar
					{
				    lista_veiculo_inv(playerid);
						return 1;
		        	}

		        	if(listitem == 212+1) // voltar
					{
				    lista_veiculo_inv(playerid);
						return 1;
		        	}
		        }
		        else
		        {
		            new sizeo = 212-((pags-1)*30);
		            if(listitem == sizeo)
		            {
		                lista_veiculo_inv(playerid);
						return 1;
		            }
		            if(listitem == sizeo+1)
		            {
		                if(pagina_dialog5[playerid] > 0) pagina_dialog3[playerid]--;
		                lista_veiculo_inv(playerid);
						return 1;
		            }
		        }
		    }

	        if(pags == 1)
	        {
	            if(listitem == cont)
	            {
	                lista_veiculo_inv(playerid);
	            }
				else if(listitem == cont+1)
	            {
	                lista_veiculo_inv(playerid);
	            }
	            else veiculo_opcao(playerid, listitem);
	            return 1;
	        }
	        else
	        {
		        if(listitem == 30)
		        {
		            if(pagina_dialog5[playerid]+1 < pags)
					{
		                pagina_dialog5[playerid]++;
					}
		            lista_veiculo_inv(playerid);
				    return 1;
		        }

		        if(listitem == 31)
		        {
	                if(pagina_dialog5[playerid] > 0) pagina_dialog5[playerid]--;
		            lista_veiculo_inv(playerid);
		            return 1;
		        }
			}
			SetPVarInt(playerid, "listitem", listitem);
