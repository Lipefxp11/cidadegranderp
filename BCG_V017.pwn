	// garagem da casa //
	if(ID_menu == MENU_VEICULOS_CASA)
	{
	    if(resposta == 1)
	    {
	        new c = id[playerid];
	        if(c != -1)
	        {
		        new v = Menu[playerid][listitem][menu_ID];
		        new unidades = Menu[playerid][listitem][menu_Unidades];
		        new ca = GetPVarInt(playerid, "casa_garagem_id");
		        if(v != -1)
		        {
		            if(unidades == 1)
		            {
		                // guardar //
		                if(Veiculo[v][v_Dono] != c) return ms(playerid, 0, "Este veiculo nao e seu!");
		                new car = Veiculo[v][v_ID];
		                if(GetVehicleModel(car) == 0) return ms(playerid, 0, "Veiculo invalido!");
		                new Float:x, Float:y, Float:z;
		                GetVehiclePos(car, x, y, z);
		                if(!IsPlayerInRangeOfPoint(playerid, 30, x, y, z)) return ms(playerid, 0, "Veiculo muito longe!");
		                if(Casa[ca][casa_GarV] != -1) return ms(playerid, 0, "A garagem ja possui um veiculo!");
		                Casa[ca][casa_GarV] = v;
		                Veiculo[v][v_Garagem] = -ca;
		                DestroyVehicle(car);
		                SalvarInfo(v);
		                salvar_casa(ca);
		                ms(playerid, 1, "Veiculo guardado na garagem da casa!");
		                fechar_menu(playerid);
		            }
		            else
		            {
		                // retirar //
		                if(Casa[ca][casa_GarV] != v) return 1;
		                new model = Veiculo[v][v_Modelo];
		                new c1 = Veiculo[v][v_Cor1], c2 = Veiculo[v][v_Cor2];
		                new car = CreateVehicle(model, Casa[ca][casa_GarX], Casa[ca][casa_GarY], Casa[ca][casa_GarZ], 0, c1, c2, -1);
		                if(car == INVALID_VEHICLE_ID) return ms(playerid, 0, "Erro ao criar veiculo!");
		                LinkVehicleToInterior(car, Casa[ca][casa_GarInterior]);
		                SetVehicleVirtualWorld(car, Casa[ca][casa_GarMundo]);
		                Veiculo[v][v_ID] = car;
		                Veiculo[v][v_Garagem] = 0;
		                Casa[ca][casa_GarV] = -1;
		                Info_Veiculo[car] = v;
		                PutPlayerInVehicle(playerid, car, 0);
		                SalvarInfo(v);
		                salvar_casa(ca);
		                ms(playerid, 1, "Veiculo retirado da garagem!");
		                fechar_menu(playerid);
		            }
		        }
	        }
	    }
	    else fechar_menu(playerid);
	    return 1;
	}

