		strcat(SG, "{ffffff}/orgveiculo {a1a1a1}Para setar a Organizacao de um Veiculo ( -1 = Nenhuma ).\n");
		strcat(SG, "{ffffff}/donoveiculo {a1a1a1}Para setar o Dono de um Veiculo ( -1 = Ninguem ).\n");
		strcat(SG, "{ffffff}/corveiculo {a1a1a1}Para setar as cores de um veiculo.\n");
		strcat(SG, "{ffffff}/garagemveiculo {a1a1a1}Para setar o veiculo em uma Garagem ( -1 = Nenhuma ).\n");
		strcat(SG, "{ffffff}/garageminfo {a1a1a1}Para setar o veiculo pela Info, em uma Garagem ( -1 = Nenhuma ).\n");
