stock lavar_valor_org(playerid, i)
{
    new grana;
    new conta = id[playerid];
    if(conta != -1)
    {
		for(new a; a<MAX_SLOTS; a++) if(Inventario[playerid][a][inv_ID] == 76) grana += Inventario[playerid][a][inv_Unidades];
		if(grana == 0)
		{
		    MS(playerid, 0, "Voce nao possue Dinheiro Sujo para lavar !");
		    mostrar_cofre_org(playerid, i);
		}
		else
		{
			new sss[200];
			format(sss, 200, "\n\
			\
			{ffffff}Voce possue {4169E1}R$ %s {ffffff}Sujo, todo dinheiro sera recuperado com a lavagem na Organizacao.\n\
			{FFFF00}[INFO] {a1a1a1}Deseja lavar esta quantia agora ?", ConvertMoney(grana));
	        ShowPlayerDialog(playerid, DIALOG_ORG21, DIALOG_STYLE_MSGBOX, "Lavar Dinheiro", sss, "Lavar", "Voltar");
		}
	}
}

stock fumar(playerid)
{
	new c = id[playerid];
	if(c != -1)
	{
		Conta[playerid][c_Fome] += 1;
		Conta[playerid][c_Sede] += 1;
		if(Conta[playerid][c_Fome] > 100) Conta[playerid][c_Fome] = 100;
		if(Conta[playerid][c_Sede] > 100) Conta[playerid][c_Sede] = 100;
		atualizar_fome(playerid);
		atualizar_sede(playerid);
		new Float:pos[4];
		GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
		GetPlayerFacingAngle(playerid, pos[3]);
		new occ = CreateDynamicObject(18677, pos[0], pos[1], pos[2]-1.1,   0.00000, 0.00000, pos[3], GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid));
		SetTimerEx("destruir_obj", 2000, false, "d", occ);
		foreach(new i:Player) if(Online(i)) if(IsPlayerInRangeOfPoint(i, 15, pos[0], pos[1], pos[2])) Streamer_Update(i);
	}
}

BCG:: destruir_obj(c)
{
	DestroyDynamicObject_(c);
	return 1;
}

BCG:: timer_cinuca(i)
{
	if(i > -1)
	{
	    if(Cinuca[i][ci_Existe] == 	1)
		{
		    new Float:pos[7];
		   	new Float:pas[5];
	        new vez = Cinuca[i][ci_Player];
	        if(vez > -1)
	        {
		        new player1 = Cinuca[i][ci_Players][vez];
		        if(player1 > -1)
		        {
				new parar = 1;
				new cont_bolas;

					for(new a; a<16; a++)
					{
						if(Cinuca[i][ci_BolaStatus][a] == 1)
						{
						    // diminuir velocidade da bola //
						    if(Cinuca[i][ci_BolaVelocidade][a] > 1.0) Cinuca[i][ci_BolaVelocidade][a] -= 0.03;
						    else if(Cinuca[i][ci_BolaVelocidade][a] > 0.3) Cinuca[i][ci_BolaVelocidade][a] -= 0.02;
							else if(Cinuca[i][ci_BolaVelocidade][a] > 0.0) Cinuca[i][ci_BolaVelocidade][a] -= 0.010;

							// parar a bola se chegar em 0 de velocidade //
							if(Cinuca[i][ci_BolaVelocidade][a] < 0.0)
							{
								Cinuca[i][ci_BolaVelocidade][a] = 0.0;
								StopDynamicObject(Cinuca[i][ci_BolaObj][a]);
							}

							// bola se movendo //
							if(Cinuca[i][ci_BolaVelocidade][a] > 0.0)
							{
							    parar = 0;
							GetDynamicObjectPos(Cinuca[i][ci_BolaObj][a], pos[0], pos[1], pos[2]);

							    // bocas da cinuca //
								for(new b; b<6; b++)
								{
								GetDistance(pos[6], Cinuca[i][ci_X]+bocas[b][0], Cinuca[i][ci_Y]+bocas[b][1], pos[2], pos[0], pos[1], pos[2]);
								if(pos[6] <= 0.045)
								{
								    Cinuca[i][ci_BolaStatus][a] = 0;
								    StopDynamicObject(Cinuca[i][ci_BolaObj][a]);
								    DestroyDynamicObject_(Cinuca[i][ci_BolaObj][a]);
								    Cinuca[i][ci_BolaVelocidade][a] = 0.0;
								    if(a == 0)
										{
											cegou[player1] = 2;
											format(string_prox, 300, "** '%s' derrubou a Bola Braca, passou a vez **", Nome(player1));
											ProxDetector(5.0, player1, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
										}
										else
										{
											Cinuca[i][ci_Pontos][vez] += a;
											derrubou[player1] = 1;
											format(string_prox, 300, "** '%s' derrubou a Bola %d **", Nome(player1), a);
											ProxDetector(5.0, player1, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
											format(string_prox, 300, "~y~+%d Pontos", a);
											GameTextForPlayer(player1, string_prox, 2000, 3);
										}
								}
							    }

							    if(Cinuca[i][ci_BolaStatus][a] == 1)
								{

								// tocar em outra bola //
									for(new w; w<16; w++)
									{
									if(Cinuca[i][ci_BolaStatus][w] == 1)
										{
										if(w != a)
										{
										    if(Cinuca[i][ci_BolaUltima][a] != w)
											{
										        if(Cinuca[i][ci_BolaUltima][w] != a)
										    	{
											        GetDynamicObjectPos(Cinuca[i][ci_BolaObj][w], pas[0], pas[1], pas[2]);
											        GetDistance(pas[3], pas[0], pas[1], pas[2], pos[0], pos[1], pos[2]);
														if(pas[3] <= 0.077)
														{
														    if(a == 0) cegou[player1] = 0;
														    pas[4] = GetAngleToPoint(pas[0], pas[1], pos[0], pos[1]);
														    pas[3] = GetAngleToPoint(pos[0], pos[1], pas[0], pas[1]);
															Cinuca[i][ci_BolaDirecao][w] = pas[3];
															Cinuca[i][ci_BolaDirecao][a] = pas[4];
															Cinuca[i][ci_BolaVelocidade][a] -= 0.10;
															if(Cinuca[i][ci_BolaVelocidade][a] < 0.0) Cinuca[i][ci_BolaVelocidade][a] = 0.0;
															if(Cinuca[i][ci_BolaVelocidade][a] > 0.0)
															{
																Cinuca[i][ci_BolaVelocidade][w] = Cinuca[i][ci_BolaVelocidade][a]-0.01;
																if(Cinuca[i][ci_BolaVelocidade][w] < 0.0) Cinuca[i][ci_BolaVelocidade][w] = 0.0;
															}
															Cinuca[i][ci_BolaUltima][a] = w;
															Cinuca[i][ci_BolaUltima][w] = a;
														}
											    }
										    }
										}
									}
								    }

								// tabela //
								   	if(Cinuca[i][ci_BolaStatus][a] == 1)
									{
									GetDynamicObjectPos(Cinuca[i][ci_BolaObj][a], pos[0], pos[1], pos[2]);
								    	PegarFrente(pos[0], pos[1], Cinuca[i][ci_BolaDirecao][a], 0.05);
										if(pos[1] >= Cinuca[i][ci_YL2])
										{
										    // MAIOR Y //
										    novo_angulo_bola(i, a, 0);
										    Cinuca[i][ci_BolaUltima][a] = -1;
										}
										if(pos[0] <= Cinuca[i][ci_XL1])
										{
										    // MENOR X //
										    novo_angulo_bola(i, a, 1);
										    Cinuca[i][ci_BolaUltima][a] = -1;
										}
										if(pos[1] <= Cinuca[i][ci_YL1])
										{
										    // menor y //
										    novo_angulo_bola(i, a, 2);
										    Cinuca[i][ci_BolaUltima][a] = -1;
										}
										if(pos[0] >= Cinuca[i][ci_XL2])
										{
										    // maior x //
										    novo_angulo_bola(i, a, 3);
										    Cinuca[i][ci_BolaUltima][a] = -1;
										}

										GetDynamicObjectPos(Cinuca[i][ci_BolaObj][a], pos[3], pos[4], pos[5]);
										PegarFrente(pos[3], pos[4], Cinuca[i][ci_BolaDirecao][a], 0.05);
										MoveDynamicObject(Cinuca[i][ci_BolaObj][a], pos[3], pos[4], pos[5], Cinuca[i][ci_BolaVelocidade][a], random(280), random(250), random(180));
									}
			   					}
							}
							else
							{
							    if(IsValidDynamicObject(Cinuca[i][ci_BolaObj][a]))
								{
								if(IsDynamicObjectMoving(Cinuca[i][ci_BolaObj][a]))
								{
								    StopDynamicObject(Cinuca[i][ci_BolaObj][a]);
								}
							    }
							}
						}
					}

					if(parar == 1)
					{
						for(new aa; aa<16; aa++)
						{
						if(Cinuca[i][ci_BolaStatus][aa] == 1)
						{
						    if(aa != 0)
							{
				                cont_bolas ++;
						    }
						}
					    }

					    if(cont_bolas > 0)
						{
						KillTimer(Cinuca[i][ci_Timer]);
						    if(cegou[player1] != 0)
							{
							if(cegou[player1] == 1)
								{
									format(string_prox, 300, "** '%s' cegou, passou a vez **", Nome(player1));
									ProxDetector(5.0, player1, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
							}
							if(vez == 0) Cinuca[i][ci_Player] = 1;
							else Cinuca[i][ci_Player] = 0;
							DestroyDynamicObject_(Cinuca[i][ci_BolaObj][0]);
							Cinuca[i][ci_BolaObj][0] = CreateDynamicObject(bolas[0], Cinuca[i][ci_X]+pos_cinuca[0][0], Cinuca[i][ci_Y]+pos_cinuca[0][1], Cinuca[i][ci_ZZ], 0, 0, 0, -1, -1, -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
							}
							else if(derrubou[player1] == 0)
							{
						    	if(vez == 0) Cinuca[i][ci_Player] = 1;
							else Cinuca[i][ci_Player] = 0;
							}
							proximo_tacada(i);
						}
						else
						{
						    KillTimer(Cinuca[i][ci_Timer]);
						    acabar_partida_cinuca(i);
						}
					}
				}
			}
		}
	}
}

stock novo_angulo_bola(i, a, bateu)
{
	if(i > -1 && i < MAX_CINUCAS)
	{
	    if(a > -1 && a < 16)
		{
		    new Float:atual = Cinuca[i][ci_BolaDirecao][a];
			new Float:novo = atual;
			new Float:diferencia;
			// maior Y //
			if(bateu == 0)
			{
				if(atual >= 0.0 && atual <= 45.0)
				{
				    diferencia = atual;
		            novo = (atual+180)-(2*diferencia);
				}
				else if(atual >= 45 && atual <= 90.0)
				{
				    diferencia = 90.0-atual;
		            novo = (atual+(2*diferencia));
				}
				else if(atual <= 360.0 && atual >= 315.0)
				{
				    diferencia = (360.0-atual);
		            novo = (atual-180) + (2*diferencia);
				}
				else if(atual <= 315.0 && atual >= 270.0)
				{
				    diferencia = (atual-270.0);
				    novo = (atual)-(2*diferencia);
				}
			}
			// menor X //
			if(bateu == 1)
			{
		        if(atual >= 90.0 && atual <= 135.0)
				{
				    diferencia = atual-90.0;
		            novo = (atual+180)-(2*diferencia);
				}
				else if(atual >= 135.0 && atual <= 180.0)
				{
				    diferencia = 180.0-atual;
		            novo = (atual+(2*diferencia));
				}
				else if(atual <= 90.0 && atual >= 45.0)
				{
				    diferencia = (90.0-atual);
		            novo = (atual+180)+(2*diferencia);
				}
				else if(atual <= 45.0 && atual >= 0.0)
				{
				    diferencia = atual;
				    novo = atual-(2*diferencia);
				}
			}
			// menor Y //
			if(bateu == 2)
			{
				if(atual >= 90.0 && atual <= 135.0)
				{
				    diferencia = atual-90.0;
		            novo = (atual)-(2*diferencia);
				}
				else if(atual >= 135.0 && atual <= 180.0)
				{
				    diferencia = 180.0-atual;
		            novo = (atual-180.0)+(2*diferencia);
				}
				else if(atual <= 225.0 && atual >= 180.0)
				{
				    diferencia = (atual-180.0);
		            novo = (atual+180.0)-(2*diferencia);
				}
				else if(atual <= 270.0 && atual >= 225.0)
				{
				    diferencia = (270.0-atual);
				    novo = (atual)+(2*diferencia);
				}
			}
			// maior X //
			if(bateu == 3)
			{
				if(atual <= 360.0 && atual >= 315.0)
				{
				    diferencia = 360.0-atual;
		            novo = (atual)+(2*diferencia);
				}
				else if(atual <= 315.0 && atual >= 270.0)
				{
				    diferencia = atual-270;
		            novo = (atual-180.0)-(2*diferencia);
				}
				else if(atual <= 270.0 && atual >= 225.0)
				{
				    diferencia = (270.0-atual);
		            novo = (atual-180.0)+(2*diferencia);
				}
				else if(atual <= 225.0 && atual >= 180.0)
				{
				    diferencia = (atual-180);
				    novo = (atual)-(2*diferencia);
				}
			}
			if(novo > 360.0) novo -= 360.0;
			if(novo < 0.0) novo += 360.0;
			Cinuca[i][ci_BolaDirecao][a] = novo;
		}
	}
}

stock fechar_tacada(playerid)
{
    for(new a; a<sizeof T_Tacada; a++) TextDrawHideForPlayer(playerid, T_Tacada[a]);
	CancelSelectTextDraw(playerid);
	dando_tacada[playerid] = 0;
	SetCameraBehindPlayer(playerid);
}

stock mostrar_tacada(playerid, i)
{
	if(i > -1)
	{
	    player_cinuca[playerid] = i;
	    Cinuca[i][ci_BolaStatus][0] = 1;
		for(new a; a<sizeof T_Tacada; a++) TextDrawShowForPlayer(playerid, T_Tacada[a]);
		SelectTextDraw(playerid, 0xffff00ff);
		dando_tacada[playerid] = 1;
		agulo_tacada_player(playerid);
	    GameTextForPlayer(playerid, "~g~SUA VEZ", 2000, 3);
    }
}

stock agulo_tacada_player(playerid)
{
	new i = player_cinuca[playerid];
	if(i != -1)
	{
		if(dando_tacada[playerid] == 1)
		{
		    new Float:pos[9];
		    GetDynamicObjectPos(Cinuca[i][ci_BolaObj][0], pos[0], pos[1], pos[2]);
		    PegarFrente(pos[0], pos[1], angulo_tacada[playerid], -1.0);
		    SetPlayerCameraPos(playerid, pos[0], pos[1], pos[2]+0.3);
		    PegarFrente(pos[0], pos[1], angulo_tacada[playerid], 2.2);
			SetPlayerCameraLookAt(playerid, pos[0], pos[1], pos[2]-0.1, CAMERA_CUT);
		}
	}
	else fechar_tacada(playerid);
}

stock salvar_cinuca(i)
{
    new file[80];
    format(file, 80, "Cinucas/%d.txt", i);
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
    if(Cinuca[i][ci_Existe] == 1)
    {
		DOF2_CreateFile(file);
    	DOF2_SetFloat(file, "ci_X", Cinuca[i][ci_X]);
	    DOF2_SetFloat(file, "ci_Y", Cinuca[i][ci_Y]);
	    DOF2_SetFloat(file, "ci_Z", Cinuca[i][ci_Z]);
        DOF2_SaveFile();
    }
}

BCG:: carregar_cinucas()
{
	new file[80];
	for(new i; i<MAX_CINUCAS; i++)
	{
	    Cinuca[i][ci_3D] = DynamicText3D:-1;
		format(file, 80, "Cinucas/%d.txt", i);
		if(DOF2_FileExists(file))
		{
		    Cinuca[i][ci_Existe] = 1;
		    Cinuca[i][ci_X]  = DOF2_GetFloat(file, "ci_X");
		    Cinuca[i][ci_Y]  = DOF2_GetFloat(file, "ci_Y");
		    Cinuca[i][ci_Z]  = DOF2_GetFloat(file, "ci_Z");
		    atualizar_cinuca(i);
		}
	}
}

stock criar_cinuca(Float:xx, Float:yy, Float:zz)
{
	for(new i; i<MAX_CINUCAS; i++)
	{
	    if(Cinuca[i][ci_Existe] == 0)
	    {
	        Cinuca[i][ci_Existe] = 1;
	        Cinuca[i][ci_X] = xx;
	        Cinuca[i][ci_Y] = yy;
	        Cinuca[i][ci_Z] = zz;
	        atualizar_cinuca(i);
	        salvar_cinuca(i);
	        return i;
	    }
	}
	return -1;
}

stock destruir_cinuca(i)
{
	acabar_partida_cinuca(i);
    Cinuca[i][ci_Existe] = 0;
    atualizar_cinuca(i);
    salvar_cinuca(i);
}

stock atualizar_cinuca(i)
{
	if(i > -1)
	{
		if(IsValidDynamicObject(Cinuca[i][ci_Obj])) DestroyDynamicObject_(Cinuca[i][ci_Obj]);
		for(new a; a<16; a++) if(IsValidDynamicObject(Cinuca[i][ci_BolaObj][a])) DestroyDynamicObject_(Cinuca[i][ci_BolaObj][a]);
	    KillTimer(Cinuca[i][ci_Timer]);

		if(Cinuca[i][ci_Existe] == 	1)
		{
		    Cinuca[i][ci_Obj] = CreateDynamicObject(2964, Cinuca[i][ci_X], Cinuca[i][ci_Y], Cinuca[i][ci_Z], 0, 0, 0, -1, -1, -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
	        Cinuca[i][ci_XL1] = Cinuca[i][ci_X] + bordas[1];
	        Cinuca[i][ci_XL2] = Cinuca[i][ci_X] + bordas[3];
	        Cinuca[i][ci_YL1] = Cinuca[i][ci_Y] + bordas[2];
	        Cinuca[i][ci_YL2] = Cinuca[i][ci_Y] + bordas[0];
		    Cinuca[i][ci_ZZ] = Cinuca[i][ci_Z] + 0.9280;
		    Cinuca[i][ci_Player] = 0;
		    Cinuca[i][ci_Partida] = 0;
		    Cinuca[i][ci_Players][0] = -1;
		    Cinuca[i][ci_Players][1] = -1;
		    Cinuca[i][ci_Pontos][0] = 0;
		    Cinuca[i][ci_Pontos][1] = 0;
		}
		texto_cinuca(i);
	}
}

stock texto_cinuca(i)
{
    if(i > -1)
    {
		if(IsValidDynamic3DTextLabel(Cinuca[i][ci_3D])) DestroyDynamic3DTextLabel(Cinuca[i][ci_3D]);
		Cinuca[i][ci_3D] = DynamicText3D:-1;
	    if(Cinuca[i][ci_Existe] == 	1)
		{
		    if(Cinuca[i][ci_Partida] == 0)
		    {
		        new sss[150];
		        format(sss, 150, "{00ffff}Sinuca ID: %d\n\n{a1a1a1}Aperte {ffffff}Y {a1a1a1}para\nconvidar ou jogar", i);
		    	Cinuca[i][ci_3D] = CreateDynamic3DTextLabel(sss, 0xffffff99, Cinuca[i][ci_X], Cinuca[i][ci_Y], Cinuca[i][ci_Z]+1.1, 5, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0,  0, 0, -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
		    }
		}
	}
}

stock proximo_tacada(i)
{
	if(i > -1)
	{
	    if(Cinuca[i][ci_Existe] == 	1)
		{
	        if(Cinuca[i][ci_Partida] == 1)
		    {
		        new vez = Cinuca[i][ci_Player];
				new player = Cinuca[i][ci_Players][vez];
				cegou[player] = 1;
				derrubou[player] = 0;
	            mostrar_tacada(player, i);
			}
		}
	}
}

stock iniciar_partida(i, player1, player2)
{
    if(i > -1)
    {
	    if(Cinuca[i][ci_Existe] == 	1)
		{
		    for(new a; a<16; a++)
			{
				if(IsValidDynamicObject(Cinuca[i][ci_BolaObj][a])) DestroyDynamicObject_(Cinuca[i][ci_BolaObj][a]);
		        Cinuca[i][ci_BolaStatus][a] = 1;
		        Cinuca[i][ci_BolaUltima][a] = -1;
		        Cinuca[i][ci_BolaObj][a] = CreateDynamicObject(bolas[a], Cinuca[i][ci_X]+pos_cinuca[a][0], Cinuca[i][ci_Y]+pos_cinuca[a][1], Cinuca[i][ci_ZZ], 0, 0, 0, -1, -1, -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
			}

			player_cinuca[player1] = i;
		    player_cinuca[player2] = i;
		    Cinuca[i][ci_Player] = 0;
		    Cinuca[i][ci_Players][0] = player1;
		    Cinuca[i][ci_Players][1] = player2;
		    Cinuca[i][ci_Partida] = 1;
		    angulo_tacada[player1] = 90;
		    angulo_tacada[player2] = 90;
		    mostrar_tacada(player1, i);
		    Streamer_Update(player1);
		    Streamer_Update(player2);
		    texto_cinuca(i);
		}
	}
}

stock acabar_partida_cinuca(i)
{
	if(i > -1)
	{
	    if(Cinuca[i][ci_Existe] == 	1)
		{
		    if(Cinuca[i][ci_Partida] == 1)
		    {
		        new venc;
				new pontos[2];
				new player1 = Cinuca[i][ci_Players][0];
				new player2 = Cinuca[i][ci_Players][1];
				if(dando_tacada[player1] == 1) fechar_tacada(player1);
				if(dando_tacada[player2] == 1) fechar_tacada(player2);
				pontos[0] = Cinuca[i][ci_Pontos][0];
				pontos[1] = Cinuca[i][ci_Pontos][1];
				if(pontos[0] > pontos[1]) venc = player1;
				else if(pontos[1] > pontos[0]) venc = player2;
				else venc = -1;
				if(venc == -1)
				{
					format(string_prox, 300, "** A partida entre '%s' e '%s' acabou em empate **", Nome(player1), Nome(player2));
					ProxDetector(15.0, player1, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
				}
				else
				{
					format(string_prox, 300, "** O jogador '%s' venceu a partida de sinuca **", Nome(venc));
					ProxDetector(15.0, venc, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
				}
				player_cinuca[player1] = -1;
			    player_cinuca[player2] = -1;
			    Cinuca[i][ci_Player] = 0;
			    Cinuca[i][ci_Players][0] = -1;
			    Cinuca[i][ci_Players][1] = -1;
			    Cinuca[i][ci_Pontos][0] = 0;
			    Cinuca[i][ci_Pontos][1] = 0;
			    Cinuca[i][ci_Partida] = 0;
			    texto_cinuca(i);
		    }
		}
	}
}

stock GetContaInt(c, const listaa[])
{
	new num;
	new file[80];
	format(file, 80, "Contas/%d.txt", c);
	if(DOF2_FileExists(file))
	{
	    num = DOF2_GetInt(file, listaa);
	}
	return num;
}

stock Float:GetContaFloat(c, const listaa[])
{
	new Float:num;
	new file[80];
	format(file, 80, "Contas/%d.txt", c);
	if(DOF2_FileExists(file))
	{
	    num = DOF2_GetFloat(file, listaa);
	}
	return num;
}

stock GetContaString(c, const listaa[])
{
	new textoaki[128];
	format(textoaki, 128, "Nada");
	new file[80];
	format(file, 80, "Contas/%d.txt", c);
	if(DOF2_FileExists(file)) format(textoaki, 128, "%s", DOF2_GetString(file, listaa));
	return textoaki;
}


stock NickNumero(const string[])
{
    for(new i = 0, j = strlen(string); i < j; i++)
	{
        if(string[i] >= '0' && string[i] <= '9') return true;
    }
    return 0;
}

stock parar_lockpick(playerid)
{
	if(Lock[playerid][lp_Status] > -1 && Lock[playerid][lp_Status] < 5)
	{
	    if(Lock[playerid][lp_Angulo] == Lock[playerid][lp_AnguloStatus]) Lock[playerid][lp_Acertos][Lock[playerid][lp_Status]] = 1;
	    else Lock[playerid][lp_Acertos][Lock[playerid][lp_Status]] = 0;

		Lock[playerid][lp_Status] ++;
		if(Lock[playerid][lp_Status] == 5)
		{
		    // verificar se conseguiu //
		    new cont;
			for(new a; a<5; a++) if(Lock[playerid][lp_Acertos][a] == 1) cont ++;
			if(cont >= 4)
			{
			    // consegiu //
			    terminar_lockpick(playerid, 1);
			}
			else
			{
			    // errou //
                terminar_lockpick(playerid, 2);
			}
		}
		else
		{
		    iniciar_lockpick(playerid, Lock[playerid][lp_Status], -1, Lock[playerid][lp_Hotwire]);
			mostrar_lockpick(playerid);
		}
	}
}

stock mostrar_lockpick(playerid, con=0)
{
	if(Lock[playerid][lp_Status] > -1)
	{
	    new Float:pos[2];
	    if(con == 1)
		{
			for(new a; a<sizeof T_LockPick; a++) TextDrawShowForPlayer(playerid, T_LockPick[a]);
			pos[0] = 92.0;
			pos[1] = -340.0;
			PegarFrente(pos[0], pos[1], Lock[playerid][lp_AnguloStatus], 30);
		    pos[1] = pos[1]*(-1);

			PlayerTextDrawDestroy(playerid, T_LockPick_p[playerid][0]);
			T_LockPick_p[playerid][0] = CreatePlayerTextDraw(playerid, pos[0]-50, pos[1]-50, "");
			PlayerTextDrawTextSize(playerid, T_LockPick_p[playerid][0], 100.000000, 100.000000);
			PlayerTextDrawAlignment(playerid, T_LockPick_p[playerid][0], 1);
			PlayerTextDrawColor(playerid, T_LockPick_p[playerid][0], cores_lock2[Lock[playerid][lp_Status]]);
			PlayerTextDrawSetShadow(playerid, T_LockPick_p[playerid][0], 0);
			PlayerTextDrawSetPreviewModel(playerid, T_LockPick_p[playerid][0], 19134);
			PlayerTextDrawBackgroundColor(playerid, T_LockPick_p[playerid][0], 0x00000000);
			PlayerTextDrawFont(playerid, T_LockPick_p[playerid][0], 5);
			PlayerTextDrawSetProportional(playerid, T_LockPick_p[playerid][0], false);
			PlayerTextDrawSetPreviewRot(playerid, T_LockPick_p[playerid][0], 0.000000, Lock[playerid][lp_AnguloStatus], 90.000000, 1.000000);

			PlayerTextDrawShow(playerid, T_LockPick_p[playerid][0]);
			PlayerTextDrawShow(playerid, T_LockPick_p[playerid][2]);
			PlayerTextDrawShow(playerid, T_LockPick_p[playerid][3]);
		}

	    pos[0] = 92.0;
		pos[1] = -340.0;
		PegarFrente(pos[0], pos[1], Lock[playerid][lp_Angulo], 30);
	    pos[1] = pos[1]*(-1);

		PlayerTextDrawDestroy(playerid, T_LockPick_p[playerid][1]);
		T_LockPick_p[playerid][1] = CreatePlayerTextDraw(playerid, pos[0]-50, pos[1]-50, "");
		PlayerTextDrawTextSize(playerid, T_LockPick_p[playerid][1], 100.000000, 100.000000);
		PlayerTextDrawAlignment(playerid, T_LockPick_p[playerid][1], 1);
		PlayerTextDrawColor(playerid, T_LockPick_p[playerid][1], cores_lock[Lock[playerid][lp_Status]]);
		PlayerTextDrawSetShadow(playerid, T_LockPick_p[playerid][1], 0);
		PlayerTextDrawSetPreviewModel(playerid, T_LockPick_p[playerid][1], 19134);
		PlayerTextDrawBackgroundColor(playerid, T_LockPick_p[playerid][1], 0x00000000);
		PlayerTextDrawFont(playerid, T_LockPick_p[playerid][1], 5);
		PlayerTextDrawSetProportional(playerid, T_LockPick_p[playerid][1], false);
		PlayerTextDrawSetPreviewRot(playerid, T_LockPick_p[playerid][1], 0.000000, Lock[playerid][lp_Angulo], 90.000000, 1.000000);
		PlayerTextDrawShow(playerid, T_LockPick_p[playerid][1]);

		new strlp[20];
		for(new a; a<5; a++)
		{
		    if(a < Lock[playerid][lp_Status])
		    {
		    	if(Lock[playerid][lp_Acertos][a] == 1) strcat(strlp, "~g~.");
		    	else strcat(strlp, "~r~.");
		    }
		    else if(a == Lock[playerid][lp_Status])
		    {
		        strcat(strlp, "~y~.");
		    }
		}
		strcat(strlp, "_");
		PlayerTextDrawShow(playerid, T_LockPick_p[playerid][4]);
		PlayerTextDrawSetString(playerid, T_LockPick_p[playerid][5], strlp);
		PlayerTextDrawShow(playerid, T_LockPick_p[playerid][5]);
	}
}


stock terminar_lockpick(playerid, con)
{
    if(Lock[playerid][lp_Status] > -1)
    {
		for(new a; a<sizeof T_LockPick; a++) TextDrawHideForPlayer(playerid, T_LockPick[a]);
		for(new a; a<6; a++) PlayerTextDrawHide(playerid, T_LockPick_p[playerid][a]);
		KillTimer(Lock[playerid][lp_Timer]);
		CancelSelectTextDraw(playerid);
		Lock[playerid][lp_Status] = -1;
		new a = Lock[playerid][lp_Veiculo];
		if(a != -1)
		{
			new i = Info_Veiculo[a];
			if(i != -1)
			{
				KillTimer(furto_timer[i]);
				furto_ativo[a] = 0;
			}
		}
		if(con != -1)
		{
			SetPlayerToFaceVehicle(playerid, a);
			ApplyAnimation(playerid, "CAMERA", "CAMCRCH_TO_CAMSTND", 4.1, false, false, false, false, 0, 1);
		}
		if(con == 1)
		{
			GameTextForPlayer(playerid, "~G~ARROMBAMENTO~N~CONCLUIDO", 1000, 3);
			if(GetVehicleModel(a) != 0)
			{
				if(Lock[playerid][lp_Hotwire] == 1)
				{
				    new i = Info_Veiculo[a];
				    if(i != -1)
				    {
				        SetVehicleParamsEx(a, 1, 1, 0, 0, 0, 0, 0);
				        furto_ativo[a] = 0;
				        KillTimer(furto_timer[i]);
				    }
				}
				else
				{
				    new i = Info_Veiculo[a];
				    if(i != -1)
				    {
				        if(Travado(a)) chaves_veiculo(playerid, i, a);
				    }
				}
			}
		}
		if(con == 0) GameTextForPlayer(playerid, "~Y~ARROMBAMENTO~N~CANCELADO", 1000, 3);
		if(con == 2) GameTextForPlayer(playerid, "~r~ARROMBAMENTO~N~FALHOU", 1000, 3);
	}
}

stock iniciar_lockpick(playerid, con, veh=-1, hotwire=0)
{
	Lock[playerid][lp_Hotwire] = hotwire;
	if(veh != -1)
	{
		Lock[playerid][lp_Veiculo] = veh;
		SetPlayerToFaceVehicle(playerid, veh);
		if(!hotwire) ApplyAnimation(playerid, "COP_AMBIENT", "COPBROWSE_LOOP", 4.1, true, false, false, false, 0, 1);
	}
    Lock[playerid][lp_Status] = con;
    Lock[playerid][lp_Angulo] = (random(36)*10);
    Lock[playerid][lp_AnguloStatus] = (random(36)*10);
	KillTimer(Lock[playerid][lp_Timer]);
	mostrar_lockpick(playerid, 1);
    Lock[playerid][lp_Timer] = SetTimerEx("arrombamento", 500, true, "d", playerid);
    SelectTextDraw(playerid, 0x00ffff90);
}

BCG:: arrombamento(playerid)
{
	new Float:pos[3];
	new continua = 0;
	new a = Lock[playerid][lp_Veiculo];
	if(GetVehicleModel(a) != 0)
	{
	    GetVehiclePos(a, pos[0], pos[1], pos[2]);
	    if(IsPlayerInRangeOfPoint(playerid, 3, pos[0], pos[1], pos[2]))
	    {
	        continua = 1;
	        SetPlayerToFaceVehicle(playerid, a);
	        ApplyAnimation(playerid, "COP_AMBIENT", "COPBROWSE_LOOP", 4.1, true, false, false, false, 0, 1);
	    }
	}

	if(continua == 1)
	{
	    Lock[playerid][lp_Angulo] += 10;
	    if(Lock[playerid][lp_Angulo] >= 360) Lock[playerid][lp_Angulo] = 0;
		mostrar_lockpick(playerid);
	}
	else
	{
	    terminar_lockpick(playerid, -1);
	    ms(playerid, 0, "Arrobamento cancelado, veiculo muito longe !");
	}
}

forward furto_alarme(vehicleid, inf, contagem);
public furto_alarme(vehicleid, inf, contagem)
{
    if(!GetVehicleModel(vehicleid) || inf < 0 || inf >= MAX_VEICULOS)
    {
        furto_ativo[vehicleid] = 0;
        return;
    }
    if(contagem >= 80)
    {
        furto_ativo[vehicleid] = 0;
        return;
    }
    new engine, lights, alarm, doors, bonnet, boot, objective;
    GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
    if(lights == 1) SetVehicleParamsEx(vehicleid, 0, 0, 1, 0, 0, 0, 0);
    else SetVehicleParamsEx(vehicleid, 0, 1, 1, 0, 0, 0, 0);
    GetVehiclePos(vehicleid, furto_pos[inf][0], furto_pos[inf][1], furto_pos[inf][2]);
    KillTimer(furto_timer[inf]);
    furto_timer[inf] = SetTimerEx("furto_alarme", 1500, false, "ddd", vehicleid, inf, contagem+1);
}

