stock add_xenon(vehicleid, idd)
{
	new idv = Info_Veiculo[vehicleid];
	if(IsValidDynamicObject(xenon_veiculo[vehicleid])) DestroyDynamicObject_(xenon_veiculo[vehicleid]);
	if(idv != -1)
	{
	    if(idd != -1)
	    {
		    XenonVeiculo[idv][0] = 1;
		    XenonVeiculo[idv][1] = idd;
	        new mod = modelo_xenon[idd];
	        if(farol[vehicleid] == 1)
	        {
		    	xenon_veiculo[vehicleid] = CreateDynamicObject(mod, 0, 0, 0, 0, 0, 0);
		    	AttachDynamicObjectToVehicle(xenon_veiculo[vehicleid], vehicleid, 0.0, 2.4, 0.0, 0, 0, 0);
			}
	    }
	    else XenonVeiculo[idv][0] = 0;
	}
}

