stock format_aposta(playerid)
{
	new str_bla[100];
	new cor = blaze_player[playerid][bz_Cor];
    format(str_bla, 100, "%sR$ %s", blaze_cor_text2[cor], ConvertMoney(blaze_player[playerid][bz_Valor]));
	PlayerTextDrawSetString(playerid, T_Celular_Blaze_APK_p[playerid][0], str_bla);
	format(str_bla, 100, "R$ %s", ConvertMoney(blaze_player[playerid][bz_Saldo]));
	PlayerTextDrawSetString(playerid, T_Celular_Blaze_APK_p[playerid][1], str_bla);

	if(blaze_player[playerid][bz_Status] == 0 && blaze_status == -1)
	{
	    TextDrawShowForPlayer(playerid, T_Celular_Blaze_APK[13]);
	    TextDrawShowForPlayer(playerid, T_Celular_Blaze_APK[14]);
	    TextDrawShowForPlayer(playerid, T_Celular_Blaze_APK[16]);
	    TextDrawHideForPlayer(playerid, T_Celular_Blaze_APK[21]);
	}
	else
	{
	    TextDrawHideForPlayer(playerid, T_Celular_Blaze_APK[13]);
	    TextDrawHideForPlayer(playerid, T_Celular_Blaze_APK[14]);
	    TextDrawHideForPlayer(playerid, T_Celular_Blaze_APK[16]);
	    TextDrawShowForPlayer(playerid, T_Celular_Blaze_APK[21]);
	}
}

stock blaze_iniciar()
{
	KillTimer(braze_timer);

	blaze_mudar = 0;
	braze_tempo = 0;
    blaze_status = sizeof blaze_tempos - 1;
    blaze_cor = random(sizeof blaze_cores);
    braze_timer = SetTimer("blaze_doble", blaze_tempos[blaze_status], true);
}

BCG:: blaze_doble()
{
    if(blaze_status != -1) blaze_cor += 1;
    if(blaze_cor >= sizeof blaze_cores) blaze_cor = 0;
	new cores_blaze[5];
    cores_blaze[0] = blaze_cor -2;
    cores_blaze[1] = blaze_cor -1;
    cores_blaze[2] = blaze_cor;
    cores_blaze[3] = blaze_cor +1;
    cores_blaze[4] = blaze_cor +2;
    for(new a; a<5; a++)
	{
		if(cores_blaze[a] < 0) cores_blaze[a] += sizeof blaze_cores;
		if(cores_blaze[a] >= sizeof blaze_cores) cores_blaze[a] -= sizeof blaze_cores;
		TextDrawBoxColor(T_Celular_Blaze_APK[a+2], blaze_cor_text[blaze_cores[cores_blaze[a]]]);
		foreach(new i:Player)
		{
		    if(Online(i))
		    {
		        if(celular_aberto[i] == C_BLAZE)
		        {
		        	TextDrawShowForPlayer(i, T_Celular_Blaze_APK[a+2]);
		        }
		    }
		}
	}

    if(blaze_status == -1)
    {
        if(blaze_mudar == 1)
        {
            blaze_mudar = 0;
            braze_tempo = 45;
	        for(new a=5; a>-1; a--)
	        {
	            if(a > 0)
	            {
	            	blaze_ultimos[a] = blaze_ultimos[a-1];
	            }
	        }
	        blaze_ultimos[0] = blaze_cores[blaze_cor];

			new str_ultimos[100];
	        for(new a=5; a>-1; a--)
	        {
	            strcat(str_ultimos, blaze_cor_text2[blaze_ultimos[a]]), strcat(str_ultimos, "O ");
	        }
	        strcat(str_ultimos, "~n~~n~~n~");
	        TextDrawSetString(T_Celular_Blaze_APK[1], str_ultimos);

	        foreach(new i:Player)
			{
			    if(Online(i))
				{
				if(blaze_player[i][bz_Status] == 1)
				{
				    if(blaze_player[i][bz_Cor] == blaze_ultimos[0])
					{
				        if(blaze_ultimos[0] == 1) blaze_player[i][bz_Saldo] += blaze_player[i][bz_Valor]*15;
				        else blaze_player[i][bz_Saldo] += blaze_player[i][bz_Valor]*2;
				        new cc = id[i];
				        if(cc != -1) salvar_conta(cc, 0, "c_Blaze", sv_int(blaze_player[i][bz_Saldo]));
				    }
					blaze_player[i][bz_Status] = 0;
				}
				if(celular_aberto[i] == C_BLAZE)
					{
						format_aposta(i);
					}
			    }
			}
        }
        else
        {
            if(braze_tempo == 0)
			{
			    KillTimer(braze_timer);
			    blaze_iniciar();
			    TextDrawSetString(T_Celular_Blaze_APK[17], "GIRANDO");
            }
            else
			{
				braze_tempo --;
                TextDrawSetString(T_Celular_Blaze_APK[17], ConvertTime(braze_tempo));
            }
        }
    }
    else
    {
        if(blaze_mudar == 1)
        {
            blaze_mudar = 0;
            blaze_status --;
            if(blaze_status > -1)
            {
                KillTimer(braze_timer);
                braze_timer = SetTimer("blaze_doble", blaze_tempos[blaze_status], true);
            }
            else
            {
                KillTimer(braze_timer);
                blaze_mudar = 1;
                braze_timer = SetTimer("blaze_doble", 1000, true);
            }
        }
    }
}

