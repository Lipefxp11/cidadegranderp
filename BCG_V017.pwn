	{
		if(response)
	    {
	    	SelectTextDraw(playerid, 0x00ffff90);
			SetPVarInt(playerid, "NotAndroid", 0);
			ShowPlayerDialog(playerid, DIALOG_PLATAFORMA2, DIALOG_STYLE_MSGBOX, "Plataforma Escolhida", "\n\n{a1a1a1}Voce escolheu a Plataforma {ffff00}ANDROID {a1a1a1}se caso escolheu a\nplataforma errada, voce pode usar {ffffff}/plataforma {a1a1a1}quando estiver no lobby para\ndefinir corretamente se esta logado pelo PC ou Android.\n\n", "Ok", "Fechar");
		}
	    else
	    {
	    	SelectTextDraw(playerid, 0x00ffff90);
			SetPVarInt(playerid, "NotAndroid", 1);
			ShowPlayerDialog(playerid, DIALOG_PLATAFORMA2, DIALOG_STYLE_MSGBOX, "Plataforma Escolhida", "\n\n{a1a1a1}Voce escolheu a Plataforma {00ffff}PC {a1a1a1}se caso escolheu a\nplataforma errada, voce pode usar {ffffff}/plataforma {a1a1a1}quando estiver no lobby para\ndefinir corretamente se esta logado pelo PC ou Android.\n\n", "Ok", "Fechar");
