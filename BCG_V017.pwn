		Portao ID: %d\n\
		Modelo: [%d]\n\n\
		Dono: %s\n\
		Organizacao: %s\n\
		Emprego: %s\n", i, Portao[i][p_Modelo], NomeConta( Portao[i][p_Dono]), NomeOrg( Portao[i][p_Org]), NomeEmprego( Portao[i][p_Emprego]));
		ShowPlayerDialog(playerid, DIALOG_VAZIO, 0, "Informacoes", sss, "Ok", "Fechar");
		return 1;
	}

	if(!strcmp(cmd, "/orgportao", true))
	{
	    new i, c;
		if(sscanf(params, "dd", i, c)) return ms(playerid, 2, "Use: /orgportao [ ID do PORTAO ] [ ID da Org ]");
		if(i < 0 || i >= MAX_PORTOES) return ms(playerid, 0, "ID de portao Invalido !");
		if(Portao[i][p_Existe] == 0) return ms(playerid, 0, "Este portao nao existe !");

	    if(c == -1)
		{
		    new sss[300];
			format(sss, 300, "Voce retirou a Organizacao do portao portao %d.",  i);
			ms(playerid, 5, sss);
		    Portao[i][p_Org] = c;
			Portao[i][p_Cargo] = 0;
		    texto_portao(i);
		    salvar_portao(i);
		    return 1;
		}

		if(c < 0 || c >= MAX_ORGS) return ms(playerid, 0, "ID de Organizacao Invalido !");
		if(Org[c][o_Existe] == 0) return ms(playerid, 0, "Esta Organizacao nao existe !");
		Portao[i][p_Org] = c;
		Portao[i][p_Cargo] = 1;
		new sss[300];
		format(sss, 300, "Voce definiu a organizacao '%s' id %d, no do portao %d.", NomeOrg(c), c, i);
		ms(playerid, 5, sss);
