	if(!strcmp(cmd, "/criarpedra", true))
	{
	    new Float:pos[4];
		GetPlayerPos(playerid, pos[0],pos[1],pos[2]);
		GetPlayerFacingAngle(playerid, pos[3]);
		new ar = CriarPedra(pos[0],pos[1],pos[2], pos[3], GetPlayerInterior(playerid), GetPlayerVirtualWorld_(playerid));
		if(ar == -1) return ms(playerid, 0, "Numero maximo de pedras atingido !");
		Streamer_Update(playerid);
		EditandoPedra[playerid] = ar;
		EditDynamicObject2(playerid, Pedra[ar][pe_Obj]);
		PegarFrentePlayer(playerid, pos[0],pos[1], -3);
		SetPlayerPos_(playerid, pos[0],pos[1],pos[2]);
		ms(playerid, 5, "Nova pedra criada, movimente e salve a posicao.");
		return 1;
	}

	if(!strcmp(cmd, "/destruirpedra", true))
	{
	    foreach(new i:Iter_Pedras)
		{
			if(Pedra[i][pe_Existe] == 1)
			{
			    if(IsPlayerInRangeOfPoint(playerid, 5, Pedra[i][pe_X], Pedra[i][pe_Y], Pedra[i][pe_Z]))
				{
				if(GetPlayerInterior(playerid) == Pedra[i][pe_Interior] && GetPlayerVirtualWorld_(playerid) == Pedra[i][pe_Mundo])
				{
				    DestruirPedra(i);
				    ms(playerid, 5, "Voce destruiu esta pedra !");
				    return 1;
				}
			    }
			}
		}
		ms(playerid, 0, "Voce nao esta proximo a uma pedra !");
		return 1;
	}

