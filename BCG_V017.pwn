}

stock Validade(tempo)
{
	new novo, dias, horas, minutos;
	new adda[20];
	new val[60];
	if(tempo <= gettime())
	{
		format(val, 60, "VENCIDO");
	}
	else
	{
		novo = tempo-gettime();
		dias = novo/UM_DIA;
		if(dias > 0)
		{
			novo -= (dias*UM_DIA);
			if(dias == 1) format(adda, 10, "%d Dia", dias);
			else format(adda, 20, "%d Dias", dias);
			strcat(val, adda);
		}
		horas = novo/(60*60);
		if(horas > 0) novo -= (horas*(60*60));
		minutos = novo/60;
		if(minutos > 0) novo -= (minutos*60);
		if((horas != 0 || minutos != 0 || novo != 0) && dias > 0) strcat(val, ", ");
		if(horas != 0 || minutos != 0 || novo != 0)
		{
			format(adda, 20, "%02d:%02d:%02d", horas, minutos, novo);
			strcat(val, adda);
		}
	}
	return val;
}

stock Validade2(tempo)
{
	new novo, dias, horas, minutos;
	new adda[10];
	new val[50];

	novo = tempo;
	dias = novo/UM_DIA;
	if(dias > 0)
	{
		novo -= (dias*UM_DIA);
		if(dias == 1) format(adda, 10, "%d Dia", dias);
		else format(adda, 10, "%d Dias", dias);
		strcat(val, adda);
	}
	horas = novo/(60*60);
	if(horas > 0) novo -= (horas*(60*60));
	minutos = novo/60;
	if(minutos > 0) novo -= (minutos*60);
	if((horas != 0 || minutos != 0 || novo != 0) && dias > 0) strcat(val, ", ");
	if(horas != 0 || minutos != 0 || novo != 0)
	{
		format(adda, 10, "%02d:%02d:%02d", horas, minutos, novo);
		strcat(val, adda);
	}
	return val;
}


