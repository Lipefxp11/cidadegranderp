stock Banido(playerid, c)
{
	new ban = GetContaInt(c, "c_Ban_Tempo");
	new sss[1000];
	if(ban > 0)
	{
		if(ban > gettime())
		{
		    new tempo_restante = ban - gettime();
			format(sss, 1000, "\n\
			\
			{ff0000}ESTA CONTA ESTA BANIDA !\n\
			\n\
			{ffffff}Admin: {a1a1a1}%s\n\
			{ffffff}Motivo: {00ffff}%s\n\
   			{ffffff}Tempo restante: {ffff00}%s\n\
   			\n\
			{a1a1a1}Caso tenha provas para uma revisao de Ban\n\
			procure algum Admin em nosso discord.\
			\
			", NomeConta(GetContaInt(c, "c_Ban_Admin")),  GetContaString(c, "c_Ban_Motivo"), ConvertTime(tempo_restante));
			ShowPlayerDialog(playerid, DIALOG_BANIDO, DIALOG_STYLE_MSGBOX, "{000000}_", sss, "Ok", "Voltar");
			return 1;
		}
		else salvar_conta(c, 0, "c_Ban_Tempo", sv_int(0));
	}
	else if(ban < 0)
	{
		format(sss, 1000, "\n\
		\
		{ff0000}ESTA CONTA ESTA BANIDA !\n\
		\n\
		{ffffff}Admin: {a1a1a1}%s\n\
		{ffffff}Motivo: {00ffff}%s\n\
		{ff0000}PERMANENTE\n\
		\n\
		{a1a1a1}Caso tenha provas para uma revisao de Ban\n\
		procure algum Admin em nosso discord.\
		\
		", NomeConta(GetContaInt(c, "c_Ban_Admin")),  GetContaString(c, "c_Ban_Motivo"));
		ShowPlayerDialog(playerid, DIALOG_BANIDO, DIALOG_STYLE_MSGBOX, "{000000}_", sss, "Ok", "Voltar");
		return 1;
	}

	new ipplayer[20];
	GetPlayerIp(playerid, ipplayer, 20);
	new file[80];
	format(file, 80, "IPS_Banidos/%s.txt", ipplayer);
	if(DOF2_FileExists(file))
	{
	    format(sss, 1000, "\n\
		\
		{ff0000}ESTE IP ESTA BANIDO !\n\
		\n\
		{ffffff}Admin: {a1a1a1}%s\n\
		{ffffff}Conta: {a1a1a1}%s\n\
		\n\
		{a1a1a1}Quando uma conta e banida, o IP logado tambem sera banido\n\
		evitando a criacao de outra conta pelo mesmo IP, entre em contato com\n\
		um admin para resolver isso.\
		\
		", NomeConta(DOF2_GetInt(file, "c_Ban_Admin")),  NomeConta(DOF2_GetInt(file, "c_Ban_Conta")));
		ShowPlayerDialog(playerid, DIALOG_BANIDO, DIALOG_STYLE_MSGBOX, "{000000}_", sss, "Ok", "Voltar");
		return 1;
	}
	return 0;
}


stock abrir_247(playerid)
{
	if(Online(playerid))
	{
		max_menu[playerid] = sizeof(Menu_247);
		menu_id[playerid] = MENU_247;
		escolhendo_menu[playerid] = 0;
		format(nome_menu[playerid], 100, "Mercado 24/7");
		format(botao_menu[playerid], 100, "COMPRAR");
		for(new i; i<max_menu[playerid]; i++)
		{
		    if(i < MAX_MENU)
		    {
			    Menu[playerid][i][menu_ID] = Menu_247[i][mercado_ID];
			    Menu[playerid][i][menu_Unidades] = Menu_247[i][mercado_Unidades];
			    Menu[playerid][i][menu_Tipo] = Menu_247[i][mercado_Tipo];
			    Menu[playerid][i][menu_Valor] = Menu_247[i][mercado_Valor];
			    format(Menu[playerid][i][menu_Nome], 200, "%d - %s",i, Menu_247[i][mercado_Nome]);
			    format(Menu[playerid][i][menu_Info], 200, "~w~ Valor: ~g~R$ %s", ConvertMoney(Menu[playerid][i][menu_Valor]));
			    if(Menu_247[i][mercado_ID] != 0) Menu[playerid][i][menu_Modelo] = Itens[Menu_247[i][mercado_ID]][item_Modelo];
			    else Menu[playerid][i][menu_Modelo] = 19285;
		    }
		}
		mostrar_menu(playerid, menu_id[playerid]);
	}
	return 1;
}

