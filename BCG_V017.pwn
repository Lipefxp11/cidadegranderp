stock atualizar_conta(i)
{
	new player = ContaOnline(i);
	if(Online(player))
	{
		new file[80];
	    format(file, 80, "Contas/%d.txt", i);
	    if(DOF2_FileExists(file))
	    {
			new sss1[40], sss2[40];
	        for(new a; a<13; a++)
	        {
	            format(sss1, 40, "Arma_%d", a);
	            format(sss2, 40, "Municao_%d", a);
	            Conta[player][c_Arma][a] = DOF2_GetInt(file, sss1);
	            Conta[player][c_Municao][a] = DOF2_GetInt(file, sss2);
	        }
	    }
    }
}


stock salvar_contatos(playerid, i)
{
    new file[80];
    new str2[80];
    format(file, 80, "WP_Contatos/%d.txt", i);
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
	DOF2_CreateFile(file);
	for(new a; a<MAX_CONTATOS; a++)
	{
	    format(str2, 80, "wp_Contato_%d", a);
        DOF2_SetInt(file, str2, Contatos[playerid][a]);
	}
	DOF2_SaveFile();
}


stock salvar_chamadas(playerid, i)
{
    new file[80];
    new str[300];
    new str2[80];
    format(file, 80, "WP_Chamadas/%d.txt", i);
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
	DOF2_CreateFile(file);
	for(new a; a<MAX_CHAMADAS; a++)
	{
	    format(str, 300, "%d|%d|%d|%s|", Chamadas[playerid][a][wp_Existe], Chamadas[playerid][a][wp_Vista], Chamadas[playerid][a][wp_Conta], Chamadas[playerid][a][wp_Hora]);
	    format(str2, 80, "wp_Linha_%d", a);
        DOF2_SetString(file, str2, str);
	}
	DOF2_SaveFile();
}

stock salvar_whatsapp(playerid, i)
{
    salvar_contatos(playerid, i);
    salvar_chamadas(playerid, i);
}

stock salvar_wp(i)
{
    new file[80];
    format(file, 80, "WP_Converssas/%d.txt", i);
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
    if(WP[i][w_Existe] == 1)
    {
        DOF2_CreateFile(file);
		DOF2_SetInt(file, "w_Conta_0", WP[i][w_Conta][0]);
		DOF2_SetInt(file, "w_Conta_1", WP[i][w_Conta][1]);
		DOF2_SetInt(file, "w_Visto_0", WP[i][w_Visto][0]);
		DOF2_SetInt(file, "w_Visto_1", WP[i][w_Visto][1]);
		DOF2_SetString(file, "w_Hora", WP[i][w_Hora]);
		DOF2_SaveFile();
	}
}

BCG:: carregar_wp()
{
    new file[80];
    for(new i; i<MAX_WP; i++)
	{
        format(file, 80, "WP_Converssas/%d.txt", i);
        if(DOF2_FileExists(file))
        {
        	WP[i][w_Existe] = 1;
			WP[i][w_Conta][0] = DOF2_GetInt(file, "w_Conta_0");
			WP[i][w_Conta][1] = DOF2_GetInt(file, "w_Conta_1");
			WP[i][w_Visto][0] = DOF2_GetInt(file, "w_Visto_0");
			WP[i][w_Visto][1] = DOF2_GetInt(file, "w_Visto_1");
			format(WP[i][w_Hora], 20, "%s", DOF2_GetString(file, "w_Hora"));
		}
	}
}

stock carregar_whatsapp(playerid, i)
{
    new file[80];
	new str[400];
	new str2[80];

    // chamadas //
    format(file, 80, "WP_Chamadas/%d.txt", i);
    if(DOF2_FileExists(file))
    {
		for(new a; a<MAX_CHAMADAS; a++)
		{
		    format(str2, 80, "wp_Linha_%d", a);
		    format(str, 300, "%s", DOF2_GetString(file, str2));
		    split_linha(str, strlen(str));
		    Chamadas[playerid][a][wp_Existe] = strval(split[0]);
		    Chamadas[playerid][a][wp_Vista] = strval(split[1]);
		    Chamadas[playerid][a][wp_Conta] = strval(split[2]);
		    format(Chamadas[playerid][a][wp_Hora], 20, split[3]);
		}
    }
    else
    {
        for(new a; a<MAX_CHAMADAS; a++)
		{
		    Chamadas[playerid][a][wp_Existe] = 0;
		}
    }

    // contatos //
    format(file, 80, "WP_Contatos/%d.txt", i);
    if(DOF2_FileExists(file))
    {
		for(new a; a<MAX_CONTATOS; a++)
		{
		    format(str2, 80, "wp_Contato_%d", a);
		    Contatos[playerid][a] = DOF2_GetInt(file, str2);
		}
    }
    else
    {
        for(new a; a<MAX_CONTATOS; a++) Contatos[playerid][a] = -1;
    }
}


