	    if(o < 0 || o >= MAX_TERRITORIOS) return ms(playerid, 0, "ID de GZ invalido !");
	    if(TR[o][tr_Existe] == 0) return ms(playerid, 0, "Esta GZ nao existe !");
		format(TR[o][tr_Nome], 100, nomegz);
		new sss[150];
		format(sss, 150, "Voce setou o Nome da GZ ID: %d, para '%s'.", o, nomegz);
		ms(playerid, 5, sss);
		atualizar_gz(o);
		salvar_gz(o);
		return 1;
	}

