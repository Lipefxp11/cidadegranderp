		return 1;
	}

	if(!strcmp(cmd, "/criarorg", true))
	{
		new tag[10], d[60];
		if(sscanf(params, "s[10]s[60]", tag, d)) return ms(playerid, 2, "Use: /criarorg [ Tag ] [ Nome ].");
		if(GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld_(playerid) != 0) return ms(playerid, 0, "Voce nao pode criar uma org em interiores !");
		new Float:pos[3];
		GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
		new o = criar_org(pos[0], pos[1], pos[2], d, tag);
		if(o == -1) return ms(playerid, 0, "Numero maximo de Orgs atinjido !");
		new sss[150];
		format(sss, 150, "O admin '%s' criou a organizacao.", Nome(playerid));
		escrever_log(f("OrgsLog/Org_%d.txt", o), sss);
		format(sss, 150, "Voce criou a Org ID: %d, Nome: %s.", o, d);
		ms(playerid, 5, sss);
		return 1;
	}

    if(!strcmp(cmd, "/estoqueorg", true))
	{
	    if(AdminPlayer(playerid) < 8) return ms(playerid, 0, "Apenas admin nivel 8+ !");
	    new val;
	    if(sscanf(params, "d", val)) return ms(playerid, 2, "Use: /estoqueorg [ quantidade ]");
