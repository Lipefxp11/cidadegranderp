stock tmp_uber(playerid)
{
    // sair da corrida uber //
    if(Uber[playerid][uber_Status] == 3 )
	{
	    new plaa = Uber[playerid][uber_Motorista];
	    if(Online(plaa))
	    {
		    new veic = Uber[playerid][uber_Veiculo];
		    if(GetVehicleModel(veic) != 0)
		    {
			    if(!IsPlayerInAnyVehicle(playerid))
				{
					new grana = Uber[playerid][uber_Valor];
					new vv = Info_Veiculo[veic];
					finalizar_corrida(playerid, plaa, grana, vv);
					cancelar_uber(playerid, 1);
				}
			}
		}
	}
}


stock tmp_anims(playerid)
{
    // dancando //
    if(ID_Dancando[playerid] != -1)
	{
	    new dan = ID_Dancando[playerid];
	    if(GetPlayerSpeed(playerid) > 1)
	    {
	        ClearAnimations(playerid, 1);
        	ApplyAnimation(playerid, Dancas[dan][1], Dancas[dan][2], 4.1, true, true, true, true, 0, 1);
	    }
	}
	else
	{
	    // anims //
		if(em_anim[playerid] != 0)
		{
		    if(GetPlayerSpeed(playerid) > 2)
		    {
		        em_anim[playerid] = 0;
		        ClearAnimations(playerid, 1);
		    }
		}
		else
		{
		    // anim celular //
		    if(celular_aberto[playerid] != -1)
		    {
		        if(!IsPlayerInAnyVehicle(playerid))
		        {
		            ApplyAnimation(playerid, "CASINO", "CARDS_LOOP", 8.1, true, false,false, false, 0, 1);
		        }
		    }

		    // anim inventario //
		    if(inv_novo_aberto[playerid] == 1)
		    {
		        if(!IsPlayerInAnyVehicle(playerid))
		        {
		            ApplyAnimation(playerid, "COP_AMBIENT", "COPBROWSE_LOOP", 8.1, true, false, false, false, 0, 1);
		        }
		    }
		}
	}
}

stock tmp_lobby(playerid)
{
    // no lobby //
    if(id[playerid] == -1 && player_tutorial[playerid] == -1)
    {
        if(!IsPlayerInRangeOfPoint(playerid, 2, 1038.8840,0.5544,1001.2845))
		{
            sentar_player(playerid);
        }
    }
}

stock tmp_funcao_pickup(playerid)
{
    // desgugar funcao do pickup //
    if(funcao_usando[playerid] != -1)
    {
        if(!IsPlayerInRangeOfPoint(playerid, 5, funcao_pos[playerid][0], funcao_pos[playerid][1], funcao_pos[playerid][2]))
        {
            funcao_usando[playerid] = -1;
        }
    }

	if(em_pedagio[playerid] != -1)
	{
	    new i = em_pedagio[playerid];
	    if(Pedagio[i][ped_Existe] == 0 || Pedagio[i][ped_Aberta] != 0 || !IsPlayerInRangeOfPoint(playerid, 2.5, Pedagio[i][ped_PX], Pedagio[i][ped_PY], Pedagio[i][ped_PZ]))
		{
	        em_pedagio[playerid] = -1;
	    }
	}
	else
	{
	    if(IsPlayerInAnyVehicle(playerid))
		{
		    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		    {
				new car = GetPlayerVehicleID(playerid);
				if(GetVehicleModel(car) != 0)
				{
					for(new i; i<MAX_PEDAGIOS; i++)
					{
					    if(Pedagio[i][ped_Existe] == 1)
						{
						    if(Pedagio[i][ped_Aberta] == 0)
							{
						    if(IsPlayerInRangeOfPoint(playerid, 3.5, Pedagio[i][ped_PX], Pedagio[i][ped_PY], Pedagio[i][ped_PZ]))
							{
									mostrar_pedagio(playerid, i);
	                                SetVehicleVelocity(car, 0, 0, 0);
	                                em_pedagio[playerid] = i;
					    	    break;
						    }
						    }
					    }
					}
				}
			}
		}
	}

}

stock tmp_rc(playerid)
{
    // veiculos de inv //
	if(flood_rc[playerid] < gettime() && RC[playerid] != -1)
	{
		if(GetVehicleModel(RC[playerid]) != 0)
		{
		    if(Veiculo_RC[RC[playerid]] == playerid)
		    {
		        new Float:vidarc;
		        GetVehicleHealth(RC[playerid], vidarc);
		        if(vidarc <= 300.0)
		        {
		            Veiculo_RC[RC[playerid]] = -1;
				    DestroyVehicle_(RC[playerid]);
				    RC[playerid] = -1;
				    MS(playerid, 2, "O RC estava muito danificado e foi guardado !");
		        }
		        else
		        {
				if(!IsPlayerInVehicle(playerid, RC[playerid]))
				{
				    Veiculo_RC[RC[playerid]] = -1;
					    DestroyVehicle_(RC[playerid]);
					    RC[playerid] = -1;
					    MS(playerid, 2, "Voce nao estava mais no RC e ele foi guardado !");
				}
		        }
		    }
		}
	}
}

stock tmp_voip(playerid)
{
    // botao do voip no android //
    new c = id[playerid];
    if(IsPlayerAndroid(playerid))
    {
		if( menu_vei_aberto[playerid] != 0 || inv_novo_aberto[playerid] != 0 || celular_aberto[playerid] != -1 || editando[playerid] == 1)
		{
		    if(GetPVarInt(playerid, "VOIP_BotaoRemover") == 0) SetPVarInt(playerid, "VOIP_BotaoRemover", 1);
		}
		else
		{
            if(GetPVarInt(playerid, "VOIP_BotaoRemover") == 1) SetPVarInt(playerid, "VOIP_BotaoRemover", 0);
		}
    }

    // sistema de voip //
	if(GetPVarInt(playerid, "VOIP_ID") != -1)
	{
	    if(tem_item(playerid, 86) == -1)
		{
		    if(GetPVarInt(playerid, "VOIP_Desconectar") == 0) SetPVarInt(playerid, "VOIP_Desconectar", 1);
		}
		else
		{
            if(c == -1)
            {
                if(GetPVarInt(playerid, "VOIP_Desconectar") == 0) SetPVarInt(playerid, "VOIP_Desconectar", 1);
            }
		}
	}
}

stock tmp_trade(playerid)
{
    // trade //
    if(negociando[playerid] != -1)
    {
        new sss[150];
		new Float:pos[6];
		GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
        new pla = negociando[playerid];
		GetPlayerPos(pla, pos[0], pos[1], pos[2]);
		if(!IsPlayerInRangeOfPoint(playerid, 10, pos[0], pos[1], pos[2]))
		{
		    cancelar_trade(playerid);
		    ms(playerid, 0, "Voce se distanciou muito de quem estava negociando !");
		    ms(pla, 0, "Voce se distanciou muito de quem estava negociando !");
		}
		else
		{
	        if(Online(pla))
	        {
	            if(trade_tempo[playerid] > 0)
	            {
	                trade_tempo[playerid] --;
	                format(sss, 100, "~Y~FINALIZANDO~N~~W~%d", trade_tempo[playerid]);
	                PlayerTextDrawSetString(playerid, T_Trade_p[playerid][23], sss);
	                PlayerTextDrawShow(playerid, T_Trade_p[playerid][23]);
	                if(trade_tempo[playerid] == 0)
	                {
	                    finalizar_trade(playerid, pla);
	                }
	            }
	        }
        }
    }
}

stock tmp_metas(playerid)
{
    // metas empregos //
    if(Conta[playerid][c_MetaHora] != 0)
    {
        if(Conta[playerid][c_MetaHora]+UMA_HORA < gettime())
        {
            Conta[playerid][c_MetaHora] = 0;
            for(new a; a<MAX_EMPREGOS; a++) Conta[playerid][c_MetaEmprego][a] = 0;
        }
    }
    new empe = EmpregoPlayer(playerid);
    if(empe != -1)
    {
        new info = -1;
        new car = GetPlayerVehicleID(playerid);
        if(IsPlayerInAnyVehicle(playerid)) info = Info_Veiculo[car];

        // uber //
        if(empe == 1)
        {
			if(info != -1)
			{
			    if(Veiculo[info][v_Emprego] == empe)
				{
        			tempo_meta[playerid] ++;
        			if(tempo_meta[playerid] >= 60)
        			{
        			    tempo_meta[playerid] = 0;
        			    MetaEmprego(playerid);
        			}
        		}
        	}
        }

        // mecanico (org) //
        if(PlayerMecanicoOrg(playerid))
        {
			foreach(new a:Iter_Pickups)
			{
			    if(Pickup[a][pick_Existe] == 1)
				{
				if(Pickup[a][pick_Tipo] == 43)
				{
				    if(IsPlayerInRangeOfPoint(playerid, 100, Pickup[a][pick_X], Pickup[a][pick_Y], Pickup[a][pick_Z]))
					{
				        tempo_meta[playerid] ++;
				        if(tempo_meta[playerid] >= 60)
		        			{
		        			    tempo_meta[playerid] = 0;
		        			    MetaEmprego(playerid);
		        			}
				    }
				}
			    }
			}
        }
    }
}

stock tmp_validade(playerid)
{
    // verificar acessorios vencidos //
    new aaa;
    new c = id[playerid];
    new sss[300];
    for(new a; a<MAX_ACESSORIOS; a++)
    {
        if(Acessorios[playerid][a][ac_Existe] == 1)
        {
            if(Acessorios[playerid][a][ac_Tempo] != 0)
            {
                if(Acessorios[playerid][a][ac_Tempo] < gettime())
            	{
            	    aaa = Acessorios[playerid][a][ac_ID];
            	    format(sss, 300, "Voce perdeu o Acessorio '%s' por vencimento !", Acessorios_Info[aaa][acessorio_Nome]);
            	    ms(playerid, 2, sss);
                    Acessorios[playerid][a][ac_Existe] = 0;
                    acessorios_player(playerid);
					salvar_acessorios(playerid, c);
                }
            }
        }
    }

    // verificar items vencidos //
    if(inv_novo_aberto[playerid] == 0)
    {
        for(new slot; slot<MAX_SLOTS; slot++)
        {
            if(Inventario[playerid][slot][inv_ID] > 0)
         	{
		        if(Inventario[playerid][slot][inv_Ativo] == 1 && Inventario[playerid][slot][inv_Tempo] != 0)
	            {
	                if(Inventario[playerid][slot][inv_Tempo] <= gettime())
	                {
	                    format(sss, 300, "O Item '%s' foi excluido do seu inventario, por vencimento !", NomeItem(Inventario[playerid][slot][inv_ID], Inventario[playerid][slot][inv_Tipo]));
						ms(playerid, 2, sss);
						limpar_slot(playerid, slot);
					}
	            }
            }
        }
    }
}

stock tmp_textdraw(playerid)
{
    // cash //
    new srdp[150];
    new sss[300];
    new Float:distt;
    new Float:pos[6];
    format(srdp, 150, "CASH: %s", ConvertMoney(CashPlayer(playerid)));
	PlayerTextDrawSetString(playerid, HudFomeSedeP[playerid][2], srdp);

	// ultima pos //
	PlayerTextDrawSetString(playerid, T_UltimaPos_p[playerid][0], "CARREGAR");
	PlayerTextDrawBoxColor(playerid, T_UltimaPos_p[playerid][0], 0x00FF0070);

	/*
	new texto_ultima[100];
	format(texto_ultima, 100, "%s", ConvertTime(Conta[playerid][c_UltimaPos]-gettime()));
	if(Conta[playerid][c_UltimaPos] < gettime())
	{
		PlayerTextDrawSetString(playerid, T_UltimaPos_p[playerid][0], "CARREGAR");
		PlayerTextDrawBoxColor(playerid, T_UltimaPos_p[playerid][0], 0x00FF0070);
	}
	else
	{
		PlayerTextDrawSetString(playerid, T_UltimaPos_p[playerid][0], texto_ultima);
		PlayerTextDrawBoxColor(playerid, T_UltimaPos_p[playerid][0], -33619872);
	}
	*/

	// uber //
    if(Uber[playerid][uber_Status] == 1)
    {
        if(Uber[playerid][uber_Tempo] > 0) Uber[playerid][uber_Tempo] --;
    	format(sss, 300, "aguarde: %s", ConvertMoney(Uber[playerid][uber_Tempo]));
 		PlayerTextDrawSetString(playerid, T_Celular_Uber_Cliente_p[playerid][4], sss);
 		if(Uber[playerid][uber_Tempo] == 0)
 		{
 		    cancelar_corrida(playerid);
 		}
    }
    if(Uber[playerid][uber_Status] == 2)
    {
        new veic = Uber[playerid][uber_Veiculo];
	   	if(veic != INVALID_VEHICLE_ID && veic != -1)
        {
            if(GetVehicleModel(veic) != 0)
	        {
		        new vv = Info_Veiculo[veic];
		        if(vv != -1)
		        {
				format(sss, 300, "~n~~r~~h~corrida aceita");
		     		PlayerTextDrawSetString(playerid, T_Celular_Uber_Cliente_p[playerid][4], sss);
		     		new mo = Uber[playerid][uber_Motorista];
		     		GetPlayerPos(mo, pos[3], pos[4], pos[5]);
					distt = GetPlayerDistanceFromPoint(mo, pos[0], pos[1], pos[2]);
		     		format(sss, 300, "~y~~h~~w~%.0f~y~~h~ metros~n~~w~placa: ~g~~h~%s", distt, PlacaVeiculo[vv]);
		     		PlayerTextDrawSetString(playerid, T_Celular_Uber_Cliente_p[playerid][5], sss);
	     		}
	 		}
 		}
    }

    // corrida em andamento //
    if(Uber[playerid][uber_Status] == 3)
    {
        format(sss, 300, "~g~~h~em corrida");
 		PlayerTextDrawSetString(playerid, T_Celular_Uber_Cliente_p[playerid][4], sss);
 		distt = GetPlayerDistanceFromPoint(playerid, Uber[playerid][uber_DX], Uber[playerid][uber_DY], Uber[playerid][uber_DZ]);
 		format(sss, 300, "~y~~h~Destino %.0f Metros", distt);
 		PlayerTextDrawSetString(playerid, T_Celular_Uber_Cliente_p[playerid][5], sss);
    }

    // celular //
    if(celular_aberto[playerid] != -1)
    {
        format(sss, 300, "%02d/%02d/%04d", DIA, MES, ANO);
		PlayerTextDrawSetString(playerid, T_Celular_p[playerid][0], sss);
		format(sss, 300, "%02d:%02d", HORA, MINUTO);
		PlayerTextDrawSetString(playerid, T_Celular_p[playerid][1], sss);
    }

    // banco //
    if(celular_aberto[playerid] == C_ITAU)
    {
        format(sss, 300, "R$ %s", ConvertMoney(Conta[playerid][c_Banco]));
		PlayerTextDrawSetString(playerid, T_Celular_Itau_APK_p[playerid][0], sss);
    }

    // gps //
    if(celular_aberto[playerid] == C_GPS)
    {
        if(GPS[playerid][gps_Status] == 1)
    	{
    	    distt = GetPlayerDistanceFromPoint(playerid, GPS[playerid][gps_DX], GPS[playerid][gps_DY], GPS[playerid][gps_DZ]);
    	    format(sss, 300, "~w~distancia aproximada~n~~g~~h~%.0f metros", distt);
     		PlayerTextDrawSetString(playerid, T_Celular_GPS_APK_p[playerid][3], sss);
    	}
    }

	// tela do caixa eletronico //
	if(mostrando_banco[playerid] == 1)
	{
	    format(srdp, sizeof(srdp), "R$ %s", ConvertMoney(Conta[playerid][c_Banco]));
		PlayerTextDrawSetString(playerid, T_CaixaEletronico_p[playerid][0], srdp);
	}

	// vip e socio //
	if(mostrando_vip[playerid] == 1)
	{
	    new vip = Conta[playerid][c_Vip];
	    new tempo = Conta[playerid][c_VipTempo];
		format(srdp, sizeof(srdp), "%s~n~%s~n~", NomeVip(vip), Validade(tempo));
		PlayerTextDrawSetString(playerid, T_Vip_p[playerid][0], srdp);
	}
}

stock tmp_tazer(playerid)
{
    // tazer //
	if(imobilizado[playerid] == 1)
	{
	    if(tempo_imobilizado[playerid] >= gettime()) mostrar_tazer(playerid);
	    else
	    {
	        imobilizado[playerid] = 0;
	        esconder_tazer(playerid);
	        CancelSelectTextDraw(playerid);
	    }
	}
}

stock tmp_player(playerid)
{
    // setar grana //
    if(Conta[playerid][c_Grana] != GetPlayerMoney(playerid))
    {
        ResetPlayerMoney(playerid);
		GivePlayerMoney(playerid, Conta[playerid][c_Grana]);
    }

    // jetpack //
	if(GetPlayerSpecialAction(playerid) == 2) player_jetpack[playerid] = 1;
	else player_jetpack[playerid] = 0;

    // abordagem policial //
    if(sendo_abordado[playerid] == 1)
    {
        if(tempo_abordado[playerid] < gettime())
        {
            resposta_abordagem(playerid, 2);
		}
    }

    // se tiver rendido //
    if(player_rendido[playerid] == 1)
	{
		if(GetPlayerSpecialAction(playerid) != 10)
		{
			SetPlayerSpecialAction(playerid, 10);
		}

		if(GetPlayerSpeed(playerid) > 1)
		{
		    SetPlayerSpecialAction(playerid, 10);
		}
	}

    // se tiver arrastado //
    if(player_arrastado[playerid] != -1)
    {
        new carro = player_arrastado[playerid];
        new asento = player_asento[playerid];
        if(GetVehicleModel(carro) != 0)
        {
			if(GetPlayerVehicleID(playerid) != carro)
			{
                PutPlayerInVehicle(playerid, carro, asento);
            }
        }
        else player_arrastado[playerid] = -1;
    }

    // verificar se o vip acabou //
	if(Conta[playerid][c_Vip] > 0)
	{
	    if(Conta[playerid][c_VipTempo] < gettime())
	    {
	        LimparVip(playerid);
	        ms(playerid, 2, "Seu Vip ou Socio Venceu !");
	        fechar_vip(playerid);
	    }
	}
	else
	{
	    if(mostrando_vip[playerid] == 1)
		{
		    fechar_vip(playerid);
		}
	}

    // diminuir nivel procurado //
    if(Conta[playerid][c_Procurado] > 0)
    {
	    if(diminuir_procura[playerid] >= 60*60)
	    {
	        diminuir_procura[playerid] = 0;
	        ms(playerid, 0xBA55D3ff, "[SUSPEITO] Voce perdeu 1 nivel de procurado.");
	        DarNivelProcurado(playerid, -1);
	    }
	    else diminuir_procura[playerid] ++;
	}

	// loc whatsapp/
    if(LocWp_id[playerid] != -1 && LocWp_id[playerid] != -123)
    {
        if(!Online(LocWp_id[playerid]))
        {
            LocWp_id[playerid] = -1;
            notificacao_cel(playerid, playerid, 2);
        }
    }

    // pegando grana suja //
    if(Barra[playerid][b_Acao] == 12)
    {
        new idd = pegando_grana[playerid];
        if(idd != -1)
        {
	        if(Item[idd][item_Existe] == 0)
	        {
	            ms(playerid, 0, "A grana nao existe mais, ou ja foi recolhida !");
                Carregando(playerid, 2);
	        }
	    }
    }

    // saqueando jogador //
	if(Barra[playerid][b_Acao] == 27)
	{
	    new idd = saqueando_player[playerid];
	    if(!Online(idd))
	    {
	        ms(playerid, 0, "O jogador nao esta mais Online !");
            Carregando(playerid, 2);
	    }
	}
}

stock tmp_blutuf(playerid)
{
    // conectado em dispositivo //
    if(Blutuf_Tipo[playerid] != -1)
    {
        // veiculo //
        if(Blutuf_Tipo[playerid] == 0)
        {
            new Float:p[3];
            new v = Blutuf_ID[playerid];
            GetVehiclePos(v, p[0], p[1], p[2]);
            if(!IsPlayerInRangeOfPoint(playerid, alcance_blu_veiculo(v), p[0], p[1], p[2]))
            {
                desconectar_blu(playerid);
                ms(playerid, 2, "O bluetooth foi desconectado, o sinal ficou fraco !");
            }
        }

        // jbl //
        if(Blutuf_Tipo[playerid] == 1)
        {
            new j = Blutuf_ID[playerid];
            if(!IsPlayerInRangeOfPoint(playerid, 20, JBL[j][jbl_X], JBL[j][jbl_Y], JBL[j][jbl_Z]))
            {
                desconectar_blu(playerid);
                ms(playerid, 2, "O bluetooth foi desconectado, o sinal ficou fraco !");
            }
        }
    }

    // ouvindo jbl //
    if(player_ouvindo[playerid] == 1)
    {
        new j = player_ouvindo_id[playerid];
        if(j != -1)
        {
	        if(JBL[j][jbl_Existe] == 1)
	        {
	            if(!IsPlayerInRangeOfPoint(playerid, 20, JBL[j][jbl_X], JBL[j][jbl_Y], JBL[j][jbl_Z]))
	            {
	                player_ouvindo[playerid] = -1;
			    	player_ouvindo_id[playerid] = -1;
			    	StopAudioStreamForPlayer(playerid);
	            }
	        }
			else
			{
			    player_ouvindo[playerid] = -1;
			    player_ouvindo_id[playerid] = -1;
			    StopAudioStreamForPlayer(playerid);
			}
		}
		else
		{
		    player_ouvindo[playerid] = -1;
		    player_ouvindo_id[playerid] = -1;
		    StopAudioStreamForPlayer(playerid);
		}
    }

    // ouvindo veiculo //
    if(player_ouvindo[playerid] == 0)
    {
        new j = player_ouvindo_id[playerid];
        if(GetVehicleModel(j) != 0)
        {
            new Float:p[3];
            GetVehiclePos(j, p[0], p[1], p[2]);
            if(!IsPlayerInRangeOfPoint(playerid, alcance_blu_veiculo(j), p[0], p[1], p[2]))
            {
                player_ouvindo[playerid] = -1;
		    	player_ouvindo_id[playerid] = -1;
		    	StopAudioStreamForPlayer(playerid);
            }
        }
		else
		{
		    player_ouvindo[playerid] = -1;
		    player_ouvindo_id[playerid] = -1;
		    StopAudioStreamForPlayer(playerid);
		}
    }

    // procurar pra ouvir jbl //
    if(player_ouvindo[playerid] == -1)
    {
	    foreach(new j:Iter_JBL)
	    {
	        if(JBL[j][jbl_Existe] == 1)
	        {
                if(JBL[j][jbl_Blu] >= 0)
	        	{
	        	    if(JBL[j][jbl_Link] != -1)
	        	    {
	        	        if(IsPlayerInRangeOfPoint(playerid, 20, JBL[j][jbl_X], JBL[j][jbl_Y], JBL[j][jbl_Z]))
	        	        {
	        	            if(JBL[j][jbl_Link] > -1)
	        	        	{
					        player_ouvindo[playerid] = 1;
				    			player_ouvindo_id[playerid] = j;
				    			PlayAudioStreamForPlayer(playerid, Estacoes[JBL[j][jbl_Link]][1]);
				    			break;
			    			}
			    			else
			    			{
			    			    player_ouvindo[playerid] = 1;
				    			player_ouvindo_id[playerid] = j;
				    			PlayAudioStreamForPlayer(playerid, JBL[j][jbl_LinkPlayer]);
			    			}
		    			}
	        	    }
				}
	        }
		}

	}

	// procurar pra ouvir veiculo //
    if(player_ouvindo[playerid] == -1)
    {
	    new Float:p[3];
		foreach(new v:Vehicles)
		{
	        if(GetVehicleModel(v) != 0)
	        {
	            if(Blutuf_Veiculo[v] >= 0)
	            {
	                if(Blutuf_Veiculo_Link[v] != -1)
	                {
			    GetVehiclePos(v, p[0], p[1], p[2]);
			    if(IsPlayerInRangeOfPoint(playerid, alcance_blu_veiculo(v), p[0], p[1], p[2]))
					{
				        if(Blutuf_Veiculo_Link[v] > -1)
				        {
					        player_ouvindo[playerid] = 0;
				    			player_ouvindo_id[playerid] = v;
				    			PlayAudioStreamForPlayer(playerid, Estacoes[Blutuf_Veiculo_Link[v]][1]);
				    			break;
			    			}
			    			else
			    			{
			    			    player_ouvindo[playerid] = 0;
				    			player_ouvindo_id[playerid] = v;
				    			PlayAudioStreamForPlayer(playerid, Blutuf_Veiculo_Linkp[v]);
				    			break;
			    			}
				    }
		            }
	            }
	        }
	    }
    }
}

stock alcance_blu_veiculo(v)
{
	if(malas[v] == 1)
	{
		new m = GetVehicleModel(v);
		if(m == 475 || m == 565) return 80;
		return 50;
	}
	return 20;
}

stock tmp_velo(playerid)
{
    if( flood_radar[playerid] > 0) flood_radar[playerid] --;
    if(mostrando_velocimetro[playerid] == 1)
    {
        if(IsPlayerInAnyVehicle(playerid))
		{
		    if(Conta[playerid][c_Velo] == 0)
			{
			    AttVelocimetro(playerid);
			}
		}
    }
}

stock tmp_explosivo(playerid)
{
	if(id[playerid] != -1)
	{
		// explosivo //
		if(player_c4_id[playerid] != -1 )
		{
		    if(Barra[playerid][b_Acao] != 11)
		    {
			    player_c4[playerid] = -1;
		     	player_c4_id[playerid] = -1;
	     	}
		}
	}

    // plantando explosivo //
	if(Barra[playerid][b_Acao] == 11)
	{
	    if(caixa_com_explosivo(player_c4_id[playerid]))
        {
            ms(playerid, 0, "Ja tem um explosivo plantado neste caixa eletronico !");
            Carregando(playerid, 2);
        }
        else if(explosivo_proximo(playerid))
		{
		    ms(playerid, 0, "Ja tem um explosivo plantado proximo a este local !");
            Carregando(playerid, 2);
		}
	}
}

stock tmp_revistando(playerid)
{
    // revistando //
	if(Barra[playerid][b_Acao] == 10)
	{
	    new i = revistando[playerid];
	    if(i != -1)
	    {
		    new Float:p[4];
			GetPlayerPos(i, p[0], p[1], p[2]);
			GetPlayerFacingAngle(i, p[3]);
			if(!Online(i))
			{
			    ms(playerid, 0, "O jogador nao esta online !");
			    Carregando(playerid, 2);
			}
			else if(id[i] == -1)
			{
			    ms(playerid, 0, "O jogador nao esta online !");
			    Carregando(playerid, 2);
			}
			else if(!IsPlayerInRangeOfPoint(playerid, 3, p[0], p[1], p[2]))
			{
			    ms(playerid, 0, "O jogador esta muito longe, nao e possivel revistar !");
			    Carregando(playerid, 2);
			}
			else if(player_rendido[i] == 0)
			{
			    ms(playerid, 0, "O jogador precisa continuar rendido !");
			    Carregando(playerid, 2);
			}
		}
	}
}

stock tmp_oficina(playerid)
{
    // verificar se o veiculo ta na oficina //
    if(funcao_usando[playerid] != -1)
    {
        new veh = funcao_id[playerid];
        if(GetVehicleModel(veh) == 0)
        {
            ms(playerid, 0, "O veiculo foi removido do local !");
            if(Barra[playerid][b_Acao] != 0) Carregando(playerid, 2);
            if(tunando[playerid] == 1) sair_tuning(playerid);
        }
        else
        {
            new Float:dis;
			dis = GetVehicleDistanceFromPoint(veh, funcao_pos[playerid][0], funcao_pos[playerid][1], funcao_pos[playerid][2]);
			if(dis > 3.0)
	        {
	            ms(playerid, 0, "O veiculo foi removido do local !");
                if(Barra[playerid][b_Acao] != 0) Carregando(playerid, 2);
				if(tunando[playerid] == 1) sair_tuning(playerid);
	        }
        }
    }
}
stock tmp_fomesede(playerid)
{
    // fome e sede //
	if(ModoAdmin[playerid] == 0)
    {
        if(Conta[playerid][c_Morto] == 0)
        {
	        if(Conta[playerid][c_TempoCadeia] == 0)
	        {
	            if(olhando_camera[playerid] == -1 && tunando[playerid] == 0)
	        	{
		            if(Conta[playerid][c_CA_Tempo] == 0)
	        		{
	        		    if(Conta[playerid][c_Hospital] == 0)
	        		    {
						    if(diminuir_fome[playerid] >= 60)
							{
						    diminuir_fome[playerid] = 0;
							if(Conta[playerid][c_Fome] > 0)
								{
									Conta[playerid][c_Fome]--;
								}
							if(Conta[playerid][c_Fome] <= 0)
							{
						        Conta[playerid][c_Fome] = 0;
						        Dano(-1, playerid, 1, 19);
						    }
							if(Conta[playerid][c_Fome] <= 20 && Conta[playerid][c_Fome] > 0) ms(playerid, 2, "Voce esta com fome, coma algo !");
							atualizar_fome(playerid);
							}
			    if(diminuir_sede[playerid] >= 60)
							{
						    diminuir_sede[playerid] = 0;
						    if(Conta[playerid][c_Sede] > 0)
								{
									Conta[playerid][c_Sede]--;
								}
						    if(Conta[playerid][c_Sede] <= 0)
							{
						        Conta[playerid][c_Sede] = 0;
						        Dano(-1, playerid, 1, 20);
						    }
						    if(Conta[playerid][c_Sede] <= 20 && Conta[playerid][c_Sede] > 0) ms(playerid, 2, "Voce esta com sede, beba algo !");
						    atualizar_sede(playerid);
							}
							diminuir_sede[playerid] ++;
							diminuir_fome[playerid] ++;
						}
					}
				}
			}
		}
	}
}

stock tmp_telando(playerid)
{
    new pla = tv_player[playerid];
    // telando alguem //
    if(pla != -1)
    {
        new c = id[playerid];
        if(!Online(pla) || id[pla] == -1)
        {
            ms(playerid, 0, "O jogador que voce estava telando, nao esta mais Online !");
            tv_player[playerid] = -1;
            TextDrawHideForPlayer(playerid, T_Telando[0]);
			PlayerTextDrawHide(playerid, T_Telando_p[playerid][0]);
			PlayerTextDrawHide(playerid, T_Telando_p[playerid][1]);
			PlayerTextDrawHide(playerid, T_Telando_p[playerid][2]);
            atualizar_conta(c);
            TogglePlayerSpectating(playerid, false);
            PlayerSpawn(playerid);
            carregar_mapa(playerid);
        }
        else
        {
            if(GetPlayerInterior(playerid) != GetPlayerInterior(pla)) SetPlayerInterior(playerid, GetPlayerInterior(pla));
	    	if(GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(pla)) SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(pla));
			new inf = -1;
			new placa[30];
			new lataria[30];
			new Float:vida_carro;
			new afk = Player_AFK(pla);
			new veic = GetPlayerVehicleID(pla);
			if(GetVehicleModel(veic) == 0)
			{
				veic = -1;
				format(placa, 30, "xxx-xxxx");
				format(lataria, 30, "xxx%%");
			}
			else
			{
			    inf = Info_Veiculo[veic];
			    if(inf != -1) format(placa, 30, PlacaVeiculo[inf]);
			    else if(Veiculo_RC[veic] == pla) format(placa, 30, "Inventario");
				else format(placa, 30, "Nenhuma");
			    GetVehicleHealth(veic, vida_carro);
				format(lataria, 30, "%d", floatround(vida_carro/10));
			}

			// formatar string //
			format(string_tv[playerid], 600,"\
			~y~Nome ~w~%s~n~\
			~y~Conta ~w~%d~n~\
			~y~Nivel ~w~%d~n~\
			~y~Dinheiro ~w~%s~n~\
			~y~Banco ~w~%s~n~\
			~y~Org ~w~%s~n~\
			~y~Emprego ~w~%s", Nome(pla), id[pla], NivelPlayer(pla), ConvertMoney(GranaPlayer(pla)), ConvertMoney(Conta[pla][c_Banco]),
			NomeOrg(OrgPlayer(pla)), NomeEmprego(EmpregoPlayer(pla)));
			PlayerTextDrawSetString(playerid, T_Telando_p[playerid][0], string_tv[playerid]);

			format(string_tv[playerid], 600,"\
			~y~Velocidade ~w~%d km/h~n~\
			~y~Arma ~w~%s~n~\
			~y~Municao ~w~%d~n~\
			~y~Ping ~w~%d", GetPlayerSpeed(pla), nome_arma(GetPlayerWeapon(pla)), GetPlayerAmmo(pla), GetPlayerPing(pla));
			PlayerTextDrawSetString(playerid, T_Telando_p[playerid][1], string_tv[playerid]);

			new taafk[20];
			format(taafk, 20, "Nao");
			if(afk > 2) format(taafk, 20, "%s", ConvertTime(afk));
			format(string_tv[playerid], 600,"\
			~y~Veiculo ~w~%s~n~\
			~y~Placa ~w~%s~n~\
			~y~Lataria ~w~%s~n~\
			~y~AFK ~w~%s", NomeVeiculo(GetVehicleModel(veic)), placa, lataria, taafk);
			PlayerTextDrawSetString(playerid, T_Telando_p[playerid][2], string_tv[playerid]);
		}
	}
}

stock tmp_gps(playerid)
{
    // localizando gps //
    if(Localizando[playerid] != -1)
    {
        if(IsValidDynamic3DTextLabel(Localizando_3D[playerid]))
        {
            new strloc[150];
            new Float:distt;
			distt = GetPlayerDistanceFromPoint(playerid, Localizando_Pos[playerid][0],Localizando_Pos[playerid][1],Localizando_Pos[playerid][2]);
			format(strloc, 150, "%s\n{ffff00}%.0f {ffffff}Metros", Localizando_Destino[playerid], distt);
			UpdateDynamic3DTextLabelText(Localizando_3D[playerid], 0xaa00ffff, strloc);
        }
    }
    else
    {
        if(IsValidDynamic3DTextLabel(Localizando_3D[playerid])) DestroyDynamic3DTextLabel(Localizando_3D[playerid]);
        Localizando_3D[playerid] = DynamicText3D:-1;
    }
}

stock tmp_nivel(playerid)
{
    // subir XP da conta //
    if(id[playerid] != -1)
    {
        new c = id[playerid];
        if(Conta[playerid][c_TempoOnlineDia] != getdate())
		{
			Conta[playerid][c_TempoOnlineDia] = getdate();
			Conta[playerid][c_TempoOnline] = 0;
			salvar_conta(c, 0, "c_TempoOnlineDia", sv_int(getdate()));
            salvar_conta(c, 0, "c_TempoOnline", sv_int(0));
		}
		else
		{
        	if(Conta[playerid][c_TempoOnline] < TEMPO_RECOMPENSSA)
         	{
             	Conta[playerid][c_TempoOnline] ++;
             	if(Conta[playerid][c_TempoOnline] >= TEMPO_RECOMPENSSA)
        	    {
        	        Conta[playerid][c_Fichas] += ADD_FICHAS;
					MS(playerid, 1, "Voce ficou 1 Hora Online e a recompenssa diaria foi coletada !");
					salvar_conta(c, 0, "c_Fichas", sv_int(Conta[playerid][c_Fichas]));
            		salvar_conta(c, 0, "c_TempoOnline", sv_int(TEMPO_RECOMPENSSA));
            		salvar_conta(c, 0, "c_TempoOnlineDia", sv_int(getdate()));
        	    }
        	}
        }
	    Conta[playerid][c_TempoJogado] ++;
	    if(flood_xp[playerid] >= 500)
	    {
	        Conta[playerid][c_XP] ++;
	        flood_xp[playerid] = 0;
	        verificar_nivel(playerid);
	    }
	    else flood_xp[playerid] ++;
    }
    else
    {
        new c = contas[playerid];
        if(c != -1)
        {
            if(GetContaInt(c, "c_TempoOnlineDia") != getdate())
			{
                salvar_conta(c, 0, "c_TempoOnlineDia", sv_int(getdate()));
                salvar_conta(c, 0, "c_TempoOnline", sv_int(0));
            }
		}
    }
}

stock tmp_arena(playerid)
{
    // arena //
    if(player_arena[playerid] == 1)
    {
        new c = id[playerid];
        new sss[150];
	    if(Player_AFK(playerid) > 30)
	    {
            if(IsValidDynamicActor(actor_player[playerid])) DestroyDynamicActor(actor_player[playerid]);
		    if(IsValidDynamic3DTextLabel(actor_player_3D[playerid])) DestroyDynamic3DTextLabel(actor_player_3D[playerid]);
			actor_player_3D[playerid] = DynamicText3D:-1;
			actor_player[playerid] = -1;
		    atualizar_conta(c);
		    player_arena[playerid] = 0;
		    PlayerSpawn(playerid);
		    ms(playerid, 0, "Voce ficou mais de 30 segundos AFK na arena e foi kikado do combate !");
		    foreach(new a:Player)
		    {
		        if(Online(a))
		        {
		            if(player_arena[a] == 1 && a != playerid)
		            {
		                format(sss, 150, "O jogador '%s' ficou mais de 30 segundos AFK e foi kikado do combate !", Nome(playerid));
		                ms(a, 2, sss);
		            }
		        }
		    }
	    }
    }
}

stock tmp_emprego(playerid)
{
    // advogado //
	if(EmpregoPlayer(playerid) == 9)
	{
	    new i = GetPVarInt(playerid, "preso");
	    if(GetPVarInt(playerid, "ajuste") > gettime())
	    {
	    	new valor = GetPVarInt(playerid, "valor");
	    	if(Online(i))
	    	{
	    	    mostrar_ajuste(playerid, i, valor);
	    	}
	        else
			{
			    SetPVarInt(playerid, "ajuste", 0);
				desconectou_ajuste(playerid, i);
			}
	    }
	    else if(GetPVarInt(playerid, "ajuste") == gettime())
	    {
	    	SetPVarInt(playerid, "ajuste", 0);
	        acabou_tempo_ajuste(playerid, i);
	    }
    }
}

stock tmp_verificacoes(playerid)
{
    // voz de prisao //
    if(GetPlayerWantedLevel(playerid) != Conta[playerid][c_Procurado]) SetPlayerWantedLevel(playerid, Conta[playerid][c_Procurado]);
    if(GetPVarInt(playerid, "vdp") == gettime())
    {
        ms(playerid, 1, "O tempo da voz de prisao acabou !");
        ms(playerid, 1, "Voce perdeu 1 Nivel de procurado.");
        Conta[playerid][c_Procurado] -= 1;
		if(Conta[playerid][c_Procurado] < 0 ) Conta[playerid][c_Procurado] = 0;
        SetPlayerWantedLevel(playerid, Conta[playerid][c_Procurado]);
        GZ_EsconderGzPlayer(playerid, gz_policia);
    }

    // estamina player //
	if(ModoAdmin[playerid] == 0 && IsPlayerRunning(playerid) && GetPlayerSpeed(playerid) > 0) dar_estamina(playerid, -diminuir_estamina(playerid)), mostrar_atributos(playerid);
	else if(Conta[playerid][c_Estamina] < 100) dar_estamina(playerid, 1);
}

stock tmp_academia(playerid)
{
    // academias //
	if(academia_player[playerid] != -1)
	{
	    new i = academia_player[playerid];
	    if(mostrando_academia[playerid] == 0) mostrar_academia(playerid);
	    if(Academia[i][aca_Existe] == 1)
	    {
	        if(IsPlayerInRangeOfPoint(playerid, 2.5, Academia[i][aca_X], Academia[i][aca_Y], Academia[i][aca_Z]))
	        {
	            new tipo = Academia[i][aca_Tipo];
			    if(Conta[playerid][c_Estamina] > 5)
				{
				exercicio[playerid][tipo] += 2;
				dar_estamina(playerid, -(1+random(2)));
				if(exercicio[playerid][tipo] == 100)
				{
				    almentar_exercicio(playerid, tipo);
				    exercicio[playerid][tipo] = 0;
				}

				// iniciar exercicio //
				if(iniciar_exercicio[playerid] > 0) iniciar_exercicio[playerid] --;
				if(iniciar_exercicio[playerid] == 0)
				{
						colocar_no_aparelho(playerid, i, tipo);
					}

				atualizar_academia_player(playerid, tipo);
			    }
			    else
				{
				academia_player[playerid] = -1;
					sair_academia(playerid, i);
				ms(playerid, 0, "Voce ficou sem estamina, aguarde e treine novamente !");
			    }
	        }
	        else
		    {
		        fechar_academia(playerid);
		        ClearAnimations(playerid, 1);
		    }
	    }
	    else
	    {
	        fechar_academia(playerid);
	        ClearAnimations(playerid, 1);
	    }
	}
	else if(mostrando_academia[playerid] == 1) fechar_academia(playerid);

}

stock tmp_craft(playerid)
{
    // craft //
    if(craft_tipo[playerid] != 0)
    {
        new is = craft_id[playerid];
        // arvore //
        if(craft_tipo[playerid] == 1)
        {
			if(is >= 0)
	        {
		        if(craft_player[playerid] >= 9)
		        {
		            terminar_craft(playerid);
		            craft_tipo[playerid] = 0;
		            craft_player[playerid] = 0;
		        }
		        else
		        {
				craft_player[playerid] += 1;
				if(craft_player[playerid] > 9) craft_player[playerid] = 9;
				SetPlayerAngleToPoint(playerid, Arvore[is][ar_X], Arvore[is][ar_Y]);
				SetPlayerArmedWeapon(playerid, craft_arma[playerid]);
				if(craft_player[playerid] > 0)
				{
					for(new fg; fg<craft_player[playerid]; fg++)
					{
							TextDrawShowForPlayer(playerid, T_Craft[fg+1]);
					}
				}
		        }
	        }
	        else
	        {
	            craft_tipo[playerid] = 0;
		        craft_player[playerid] = 0;
		        terminar_craft(playerid);
	        }
        }

        // pedra //
        if(craft_tipo[playerid] == 2)
        {
			if(is >= 0)
	        {
		        if(craft_player[playerid] >= 9)
		        {
		            terminar_craft(playerid);
		            craft_tipo[playerid] = 0;
		            craft_player[playerid] = 0;
		        }
		        else
		        {
				craft_player[playerid] += 1;
				if(craft_player[playerid] > 9) craft_player[playerid] = 9;
				SetPlayerAngleToPoint(playerid, Pedra[is][pe_X], Pedra[is][pe_Y]);
				SetPlayerArmedWeapon(playerid, craft_arma[playerid]);
				if(craft_player[playerid] > 0)
				{
					for(new fg; fg<craft_player[playerid]; fg++)
					{
							TextDrawShowForPlayer(playerid, T_Craft[fg+1]);
					}
				}
		        }
	        }
	        else
	        {
	            craft_tipo[playerid] = 0;
		        craft_player[playerid] = 0;
		        terminar_craft(playerid);
	        }

        }
    }
}

stock tmp_cabeca(playerid)
{
    // mostrar id e conta na cabeca //
	new mostrar_id[120];
	new c = id[playerid];
	new tag = Conta[playerid][c_Tag];
	new yt = Conta[playerid][c_TagYT];
	new org =  OrgPlayer(playerid);
	new e = EmpregoPlayer(playerid);
	format(mostrar_id, 120, "%d {ffff00}%d", c, playerid);
	


	// sistema de tag //
	if(tag == 1)
	{
	    if(yt == 1) strcat(mostrar_id, "\n{ff0000}YouTuber");
	    else Conta[playerid][c_Tag] = 0;
	}
	if(tag == 2)
	{
	    if(e != -1) strcat(mostrar_id, f("\n{ffffff}%s", NomeEmprego(e)));
	    else Conta[playerid][c_Tag] = 0;
	}
	if(tag == 3)
	{
	    if(org != -1) strcat(mostrar_id, f("\n{%06x}%s", CorOrg(org) >>> 8, TagOrg(org)));
	    else Conta[playerid][c_Tag] = 0;
	}

	// se for admin
	if(ModoAdmin[playerid] == 1) strcat(mostrar_id, "\n{FA8072}STAFF");
	else
	{
		if(imobilizado[playerid] > gettime()) strcat(mostrar_id, "\n{ff0000}IMOBILIZADO");
		else if(player_rendido[playerid] == 1) strcat(mostrar_id, "\n{a1a1a1}RENDIDO");
		else if(Novato(playerid)) strcat(mostrar_id, "\n{a1a1a1}NOVATO");
	}
	if(Player_AFK(playerid) != 0)
	{
		new strafk[20];
		format(strafk, 20, "\n{a1a1a1}AFK: %s", ConvertTime(Player_AFK(playerid)));
		strcat(mostrar_id, strafk);
	}
	Update3DTextLabelText(Nome_Player[playerid], 0x00ffffff, mostrar_id);
}

stock longe_cadeia(playerid)
{
	if(Online(playerid))
	{
	    if(GetPlayerInterior(playerid) != 5 || GetPlayerVirtualWorld_(playerid) != 0 || !IsPlayerInRangeOfPoint(playerid, 100, 322.197998,302.497985,999.148437))
	    {
	        return 1;
		}
	}
	return 0;
}


stock tmp_anticheat(playerid)
{
    new arms[13][2];
    new suspeitoAC;
    for(new i; i<13; i++)
    {
        GetPlayerWeaponData(playerid, i, arms[i][0], arms[i][1]);
        if(arms[i][0] != 0 && arms[i][1] > 5000) suspeitoAC = 1;
    }
    if(!suspeitoAC)
    {
        for(new s; s<MAX_SLOTS; s++)
        {
            new id_item = Inventario[playerid][s][inv_ID];
            if(id_item >= 44 && id_item <= 48)
            {
                if(Inventario[playerid][s][inv_Unidades] > 3000) suspeitoAC = 1;
            }
        }
    }
    if(suspeitoAC)
    {
        ResetPlayerWeapons_(playerid);
        for(new s; s<MAX_SLOTS; s++)
        {
            new id_item = Inventario[playerid][s][inv_ID];
            if(id_item >= 18 && id_item <= 48)
            {
                Inventario[playerid][s][inv_ID] = 0;
                Inventario[playerid][s][inv_Unidades] = 0;
                Inventario[playerid][s][inv_Tipo] = 0;
                Inventario[playerid][s][inv_Ativo] = 0;
                Inventario[playerid][s][inv_Tempo] = 0;
            }
        }
        for(new a; a<13; a++) Conta[playerid][c_Arma][a] = 0, Conta[playerid][c_Municao][a] = 0;
        salvar_inventario(id[playerid], -1);
        salvar_conta(id[playerid], -1, "c_Armas");
        ms(playerid, 4, "[ANTICHEAT] Municao excessiva detectada! Todas as armas foram removidas.");
    }
    return 1;
}

stock tmp_cadeia_staff(playerid)
{
	// verificar cadeia admin //
	new c = id[playerid];
	if(c != -1)
	{
	    new sss[300];
		new tempo = Conta[playerid][c_CA_Tempo];
		new admin = Conta[playerid][c_CA_Admin];
		if(tempo > 0)
		{
		    if(mostrando_cadeia_staf[playerid] == 1)
		    {
			    format(sss, 300, "~y~%s~n~~w~%s~n~", NomeConta(admin), ConvertTime(tempo));
	            PlayerTextDrawSetString(playerid, T_Cadeia_Staff_p[playerid][0], sss);
				PlayerTextDrawShow(playerid, T_Cadeia_Staff_p[playerid][0]);
				PlayerTextDrawSetString(playerid, T_Cadeia_Staff_p[playerid][1], Conta[playerid][c_CA_Motivo]);
				PlayerTextDrawShow(playerid, T_Cadeia_Staff_p[playerid][1]);
			}

			Conta[playerid][c_CA_Tempo] --;
			if(Conta[playerid][c_CA_Tempo] == 0)
			{
			    SetarSpawn(playerid);
			    ms(playerid, 2, "Voce cumpriu sua pena na Cadeia Staff !");
			    salvar_conta(c, -1, "c_Banimento");
			    PlayerSpawn(playerid);
			}
			else
			{
			    salvar_conta(c, 0, "c_CA_Tempo", sv_int(Conta[playerid][c_CA_Tempo]));
			    if(longe_cadeia(playerid))
				{
				SetPlayerVirtualWorld_(playerid, 0);
				SetPlayerInterior(playerid, 5);
				SetPlayerPos_(playerid, 322.197998,302.497985,999.148437);
				ClearAnimations(playerid);
			    }
			}
		}
		else tmp_hospital(playerid);
	}
}

stock tmp_hospital(playerid)
{
    if(logado[playerid] != 1) return;
    // verificar Hospital //
    new sss[300];
    new c = id[playerid];
	if(Conta[playerid][c_Hospital] > 0)
	{
	    if(mostrando_hospital[playerid] == 1)
        {
            format(sss, 300, "~b~~h~~h~VOCE ESTA HOSPITALIZADO~n~~w~LOCAL: ~y~~h~%s~n~~n~~g~~h~%s~n~~w~AGUARDE ATE RECEBER ALTA~n~", cidade(Conta[playerid][c_Hospital2]), ConvertTime(Conta[playerid][c_Hospital]));
            PlayerTextDrawSetString(playerid, T_Hospital_p[playerid][0], sss);
			PlayerTextDrawShow(playerid, T_Hospital_p[playerid][0]);
        }

	    new rand = GetPVarInt(playerid, "cama");
		if(!IsPlayerInRangeOfPoint(playerid, 2, CamasHospital[rand][0], CamasHospital[rand][1], CamasHospital[rand][2]))
		{
		    SetPlayerInterior(playerid, 0);
			SetPlayerVirtualWorld_(playerid, 0);
		    SetPlayerPos_(playerid, CamasHospital[rand][0]+0.1, CamasHospital[rand][1]+0.1, CamasHospital[rand][2]+1);
		    SetPlayerFacingAngle(playerid, CamasHospital[rand][3]);
		}
	    ApplyAnimation(playerid, "CRACK", "CRCKIDLE2", 4.1, true, false, false, false, 0, 1);
	    Conta[playerid][c_Hospital] --;
	    if(Conta[playerid][c_Hospital] == 0)
	    {
	        ClearAnimations(playerid);
            SetPlayerInterior(playerid, 0);
			SetPlayerVirtualWorld_(playerid, 0);
		    SetPlayerPos_(playerid, 1167.8068,-1324.9576,15.4066);
		    SetPlayerFacingAngle(playerid, 90);
            salvar_conta(c, -1, "c_Posicao2");
            salvar_conta(c, 0, "c_Hospital", sv_int(0));
            if(mostrando_hospital[playerid] == 1)
            {
                mostrando_hospital[playerid] = 0;
				TextDrawHideForPlayer(playerid, T_Hospital[0]);
				PlayerTextDrawHide(playerid, T_Hospital_p[playerid][0]);
    		}
	    }
	}
}

forward Timer_Player_Logged(playerid, c);
public Timer_Player_Logged(playerid, c)
{
    if(!IsPlayerConnected(playerid)) return;
    if(atirou_camera[playerid] > 0) atirou_camera[playerid] --;
    tmp_kikar(playerid);
    if(servidor_ligado == 1)
	{
		if(logado[playerid] == 1)
		{
			if(salvar_player[playerid] == 15)
			{				
				salvar_player[playerid] = 0;
				if(TestePlayer[playerid] == -1 && player_arena[playerid] == 0 && tv_player[playerid] == -1 && olhando_camera[playerid] == -1 && tunando[playerid] == 0)
				{
		            Conta[playerid][c_Interior] = GetPlayerInterior(playerid);
					Conta[playerid][c_Mundo] = GetPlayerVirtualWorld_(playerid);
					GetPlayerPos(playerid, Conta[playerid][c_X],Conta[playerid][c_Y],Conta[playerid][c_Z]);
					GetPlayerFacingAngle(playerid, Conta[playerid][c_A]);
					salvar_conta(c, -1, "c_Posicao");
					if(remocao_arma[playerid] < gettime()) salvar_conta(c, playerid, "c_Armas");
				}	
			}
			else salvar_player[playerid] ++;
			tmp_territorios(playerid);
			tmp_cinucas(playerid);
            tmp_tuto(playerid);
			tmp_explosivo(playerid);
			tmp_jbl(playerid);
			tmp_uber(playerid);
			tmp_anims(playerid);
            tmp_lobby(playerid);
            tmp_funcao_pickup(playerid);
			tmp_rc(playerid);
            tmp_voip(playerid);
		}
	}
	if(c != -1)
	{
		if(GetPlayerSkin(playerid) != Conta[playerid][c_Skin]) SetPlayerSkinFix(playerid, Conta[playerid][c_Skin]);
		tmp_trade(playerid);
		tmp_metas(playerid);
		tmp_validade(playerid);
		tmp_textdraw(playerid);
		tmp_tazer(playerid);
		tmp_player(playerid);
		tmp_blutuf(playerid);
		tmp_velo(playerid);
		tmp_revistando(playerid);
		tmp_oficina(playerid);
		tmp_fomesede(playerid);
		tmp_gps(playerid);
		tmp_arena(playerid);
		verificar_cadeia(playerid);
		tmp_emprego(playerid);
		tmp_verificacoes(playerid);
		tmp_academia(playerid);
		tmp_craft(playerid);
		tmp_cabeca(playerid);
		tmp_cadeia_staff(playerid);
		tmp_nivel(playerid);
		tmp_anticheat(playerid);
	}
	else
	{
		if(GetPlayerMoney(playerid) != 0) ResetPlayerMoney(playerid);
		if(craft_tipo[playerid] != 0)
		{
			craft_tipo[playerid] = 0;
			craft_player[playerid] = 0;
			terminar_craft(playerid);
		}
	}
	Streamer_Update(playerid);
}

BCG:: Timer_Player(playerid)
{
    if(playerid < 0 || playerid >= MAX_PLAYERS) { printf("Timer_Player: playerid out of bounds %d", playerid); return; }
    if(!IsPlayerConnected(playerid)) return;
    SetTimerEx("Timer_Player_Logged", 0, false, "dd", playerid, id[playerid]);
}

stock nome_municao(arma)
{
	new namee[40];
	format(namee, 40, "nenhuma");
	if(arma > -1 && arma < 4)
	{
	    format(namee, 40, Itens[44+arma][item_Nome]);
	}
	return namee;
}

stock municao(arma)
{
	new mu = -1;
    if(arma > -1 && arma < sizeof(lista_armas))
    {
        mu = lista_armas[arma][a_Slot]-2;
        if(mu < 0 || mu > 4)
        {
            mu = -1;
        }
    }
	return mu;
}

stock tipo_arma(arma)
{
	new tips[40];
	format(tips, 40, "Nenhuma");
	if(arma > -1 && arma < sizeof(lista_armas))
	{
	    if(lista_armas[arma][a_Slot] == 0) format(tips, 40, "Nenhuma");
	    if(lista_armas[arma][a_Slot] == 1) format(tips, 40, "Arma Branca");
	    if(lista_armas[arma][a_Slot] == 10) format(tips, 40, "Arma Branca");
	    if(lista_armas[arma][a_Slot] == 8) format(tips, 40, "Granada");
	    if(lista_armas[arma][a_Slot] == 2) format(tips, 40, "Pistola");
	    if(lista_armas[arma][a_Slot] == 3) format(tips, 40, "Shotgun");
	    if(lista_armas[arma][a_Slot] == 4) format(tips, 40, "Sub Metralhadora");
	    if(lista_armas[arma][a_Slot] == 5) format(tips, 40, "Rifle");
	    if(lista_armas[arma][a_Slot] == 6) format(tips, 40, "Sniper de Precisao");
	    if(lista_armas[arma][a_Slot] == 7) format(tips, 40, "Arma Pesda");
	    if(lista_armas[arma][a_Slot] == 11) format(tips, 40, "Especial");
	}
	return tips;
}

stock nome_arma(arma)
{
	new slot[60];
	if(arma > -1 && arma < sizeof(lista_armas)) format(slot, 60, "%s", lista_armas[arma][a_Nome]);
	else
	{
	    format(slot, 60, tipodano(arma));
	    for(new i; i<sizeof lista_armas; i++)
	    {
			if(arma == lista_armas[i][a_Modelo])
			{
			    format(slot, 60, "%s", lista_armas[i][a_Nome]);
			    break;
	        }
	    }
	}
	return slot;
}

stock tipodano(arma)
{
	new ssr[40];
	format(ssr, 40, "Queda");
	if(arma == 9999) format(ssr, 40, "Explosivo C-4");
	if(arma == 8888) format(ssr, 40, "Cigarro");
	return ssr;
}

stock slot_arma(arma)
{
	new slot = -1;
	if(arma > -1 && arma < sizeof(lista_armas))
	{
	    slot = lista_armas[arma][a_Slot];
	}
	else
	{
	    for(new i; i<sizeof lista_armas; i++)
	    {
			if(arma == lista_armas[i][a_Modelo])
			{
			    slot = lista_armas[i][a_Slot];
				break;
	        }
	    }
	}
	return slot;
}

stock arma_id(arma, con=0)
{
	new slot;
	if(arma > -1 && arma < sizeof(lista_armas))
	{
	    slot = lista_armas[arma][a_Item];
	    if(con == 1) slot = lista_armas[arma][a_Modelo];
	}
	else
	{
	    for(new i; i<sizeof lista_armas; i++)
	    {
			if(arma == lista_armas[i][a_Modelo])
			{
			    slot = lista_armas[i][a_Item];
			    if(con == 1) slot = lista_armas[i][a_Modelo];
				break;
	        }
	    }
	}
	return slot;
}


stock contar_armas(playerid)
{
	new cont;
	new armsdata[13][2];
	for(new i; i<13; i++)
	{
	    GetPlayerWeaponData(playerid, i, armsdata[i][0], armsdata[i][1]);
	    if(i == 1 || i == 2 || i == 3 || i == 4 || i == 5 || i == 6  )
	    {
		    if(armsdata[i][0] != 0)
		    {
		    	cont++;
		    }
	    }
	}
	return cont;
}


stock dano_arma(arma, &dadoo)
{
    if(arma > -1 && arma < sizeof(lista_armas))
	{
	    dadoo = floatround(lista_armas[arma][a_Dano]);
	    return 1;
	}
	if(arma == 49)
	{
		dadoo = 0;
		return 1;
	}
	if(arma == 50)
	{
		dadoo = 0;
		return 1;
	}
    for(new i; i<sizeof lista_armas; i++)
    {
        if(arma == lista_armas[i][a_Modelo])
		{
			dadoo = floatround(lista_armas[i][a_Dano]);
			return 1;
		}
    }
	return 0;
}


stock mostrar_dano(playerid)
{
	if(Online(playerid))
	{
		if(dano_sofrido_player[playerid] != -123)
		{
		    PlayerTextDrawSetString(playerid, DanoLevouText[playerid][0], Nome(dano_sofrido_player[playerid]));
			PlayerTextDrawSetString(playerid, DanoLevouText[playerid][1], ConvertMoney(dano_sofrido[playerid]));
			PlayerTextDrawSetString(playerid, DanoLevouText[playerid][2], nome_arma(dano_sofrido_arma[playerid]));
			PlayerTextDrawShow(playerid, DanoLevouText[playerid][0]);
			PlayerTextDrawShow(playerid, DanoLevouText[playerid][1]);
			PlayerTextDrawShow(playerid, DanoLevouText[playerid][2]);
  		}
		if(dano_causado_player[playerid] != -123)
		{
		    PlayerTextDrawSetString(playerid, DanoAtirouText[playerid][0], Nome(dano_causado_player[playerid]));
			PlayerTextDrawSetString(playerid, DanoAtirouText[playerid][1], ConvertMoney(dano_causado[playerid]));
			PlayerTextDrawSetString(playerid, DanoAtirouText[playerid][2], nome_arma(dano_causado_arma[playerid]));
            PlayerTextDrawShow(playerid, DanoAtirouText[playerid][0]);
			PlayerTextDrawShow(playerid, DanoAtirouText[playerid][1]);
			PlayerTextDrawShow(playerid, DanoAtirouText[playerid][2]);
  		}
	}
}


BCG:: resetar_dano(playerid)
{
    KillTimer(timer_dano[playerid]);
    dano_sofrido_player[playerid] = -123;
    dano_sofrido[playerid] = 0;
    dano_sofrido_arma[playerid] = 0;
    dano_causado_player[playerid] = -123;
    dano_causado[playerid] = 0;
    dano_causado_arma[playerid] = 0;
    PlayerTextDrawHide(playerid, DanoLevouText[playerid][0]);
	PlayerTextDrawHide(playerid, DanoLevouText[playerid][1]);
	PlayerTextDrawHide(playerid, DanoLevouText[playerid][2]);
	PlayerTextDrawHide(playerid, DanoAtirouText[playerid][0]);
	PlayerTextDrawHide(playerid, DanoAtirouText[playerid][1]);
	PlayerTextDrawHide(playerid, DanoAtirouText[playerid][2]);
}

stock destruir_emprego(i)
{
    if(Emprego[i][e_Existe] == 1)
    {
	    foreach(new a:Iter_Veiculos)
	    {
		    if(Veiculo[a][v_Existe] == 1)
		    {
		        if(Veiculo[a][v_Emprego] == i)
		    	{
		    	    if(Veiculo[a][v_Garagem] == 0)
					{
	    				new idv = Veiculo[a][v_ID];
	                    DestruirVeiculo(idv);
					}
					else
					{
					    DestruirInfo(i);
	            		SalvarInfo(i);
					}
				}
		    }
	    }

        Emprego[i][e_Existe] = 0;
        Emprego[i][e_Salario] = 0;
        Emprego[i][e_Nivel] = 0;
        Emprego[i][e_Tipo] = 0;
        format(Emprego[i][e_Nome], 80, "Nenhum");
        salvar_emprego(i);
	}
}

BCG:: carregar_empregos()
{
	new file[80];
	new cont;
	for(new i; i<MAX_EMPREGOS; i++)
	{
		format(file, 80, "Empregos/Emprego_%d.txt", i);
		if(DOF2_FileExists(file))
		{
	        Emprego[i][e_Existe] = 1;
	        Emprego[i][e_Salario] = DOF2_GetInt(file, "e_Salario");
	        Emprego[i][e_Nivel] = DOF2_GetInt(file, "e_Nivel");
	        Emprego[i][e_Tipo] = DOF2_GetInt(file, "e_Tipo");
	        format(Emprego[i][e_Nome], 80, "%s", DOF2_GetString(file, "e_Nome"));
	        cont ++;
	    }
	    else
	    {
	        Emprego[i][e_Existe] = 0;
	        Emprego[i][e_Salario] = 0;
	        Emprego[i][e_Nivel] = 0;
	        Emprego[i][e_Tipo] = 0;
	        format(Emprego[i][e_Nome], 80, "Nenhum");
	    }
	}
	printf("** %d Empregos do Servidor carregados.", cont);
}

stock salvar_emprego(i)
{
	new file[80];
	format(file, 80, "Empregos/Emprego_%d.txt", i);
	if(Emprego[i][e_Existe] == 1)
	{
	    if(!DOF2_FileExists(file)) DOF2_CreateFile(file);
	    DOF2_SetInt(file, "e_Salario", Emprego[i][e_Salario]);
	    DOF2_SetInt(file, "e_Nivel", Emprego[i][e_Nivel]);
	    DOF2_SetInt(file, "e_Tipo", Emprego[i][e_Tipo]);
        DOF2_SetString(file, "e_Nome", Emprego[i][e_Nome]);
	    DOF2_SaveFile();
	}
	else if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
}


stock jogar(playerid)
{
    if(segurando_player[playerid] != -1)
	{
        RemovePlayerAttachedObject(playerid,9);
        segurando_player[playerid] = -1;
        segurando_unidades[playerid] = 0;
        segurando_tipo[playerid] = 0;
        segurando_ativo[playerid] = 0;
        segurando_tempo[playerid] = 0;
	}
}


stock largar(playerid)
{
    if(segurando_player[playerid] != -1)
	{
		new Float:pos[4];
		new idd = segurando_player[playerid];
        RemovePlayerAttachedObject(playerid,9);
        ApplyAnimation(playerid, "BOMBER", "BOM_PLANT_2IDLE", 4.1, false, false, false, false, 0, 1);
		GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
	    GetPlayerFacingAngle(playerid, pos[3]);
	    PegarFrente(pos[0], pos[1], pos[3], 1);
	    criar_item(itens_segurando[idd][seg_ID], pos[0], pos[1], pos[2], segurando_unidades[playerid], GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), segurando_tipo[playerid], (5*60), segurando_ativo[playerid], segurando_tempo[playerid]);
        segurando_player[playerid] = -1;
        segurando_unidades[playerid] = 0;
        segurando_tipo[playerid] = 0;
        segurando_ativo[playerid] = 0;
        segurando_tempo[playerid] = 0;
	}
}


stock segurar(playerid, idd, unidades, tipo=0, ativo=0, tempo=0)
{
	if(segurando_player[playerid] == -1)
	{
        segurando_player[playerid] = idd;
        segurando_unidades[playerid] = unidades;
        segurando_tipo[playerid] = tipo;
        segurando_ativo[playerid] = ativo;
        segurando_tempo[playerid] = tempo;
        SetPlayerAttachedObject(playerid, 9, itens_segurando[idd][seg_Modelo], itens_segurando[idd][seg_Local], itens_segurando[idd][seg_X], itens_segurando[idd][seg_Y], itens_segurando[idd][seg_Z], itens_segurando[idd][seg_RX], itens_segurando[idd][seg_RY], itens_segurando[idd][seg_RZ], itens_segurando[idd][seg_TX], itens_segurando[idd][seg_TY], itens_segurando[idd][seg_TZ]);
        ApplyAnimation(playerid, "BOMBER", "BOM_PLANT_2IDLE", 4.1, false, false, false, false, 0, 1);
	}
}

stock VeiculoQuatroPortas(carid)
{
	for(new ss; ss<sizeof quatro_portas; ss++) if(GetVehicleModel(carid) == quatro_portas[ss]) return 1;
	return 0;
}

stock VeiculoBicicleta(carid)
{
    new oo = GetVehicleModel(carid);
	if(oo == 481 ||  oo == 509 || oo == 510 ) return 1;
	return 0;
}

stock Moto(oo)
{
	if(oo == 448 ||  oo == 461 ||  oo == 462 ||  oo == 463 ||  oo == 468 ||  oo == 521 ||  oo == 487 ||  oo == 522 ||  oo == 523 ||  oo == 581 ||  oo == 586 ) return 1;
	return 0;
}

stock VeiculoMoto(carid)
{
	new oo = GetVehicleModel(carid);
