stock componentes_instalados(playerid, veh)
{
	new cont;
	menu_id[playerid] = MENU_TUNING20;
	pagina_menu[playerid] = 0;
	escolhendo_menu[playerid] = 0;
	format(nome_menu[playerid], 100, "Tunings Instalados");
	format(botao_menu[playerid], 100, "REMOVER");

    new component;
    for(new i; i<14; i++)
	{
	    component = GetVehicleComponentInSlot(veh, i);
	    if(component != 0)
	    {
		    Menu[playerid][cont][menu_ID] = i;
		    Menu[playerid][cont][menu_Unidades] = 1;
		    Menu[playerid][cont][menu_Tipo] = component;
		    Menu[playerid][cont][menu_Valor] = cont;
		    format(Menu[playerid][cont][menu_Nome], 200, "%d - %s", cont+1, gVehicleComponentName[component-1000]);
		    format(Menu[playerid][cont][menu_Info], 200, "Use 'REMOVER' para retirar o tuning do veiculo.");
		    Menu[playerid][cont][menu_Modelo] = 19627;
			cont ++;
		}
	}

	max_menu[playerid] = cont;
	mostrar_menu(playerid, menu_id[playerid]);
}

stock texto_garagem(idv)
{
	new sss[300];
    if(IsValidDynamicPickup(Veiculo[idv][v_Pickup])) DestroyDynamicPickup_(Veiculo[idv][v_Pickup]);
	if(IsValidDynamic3DTextLabel(Veiculo[idv][v_3D])) DestroyDynamic3DTextLabel(Veiculo[idv][v_3D]);
	Veiculo[idv][v_3D] = DynamicText3D:-1;
	if(Veiculo[idv][v_PlacaLabel] != DynamicText3D:-1) DestroyDynamic3DTextLabel(Veiculo[idv][v_PlacaLabel]);
	Veiculo[idv][v_PlacaLabel] = DynamicText3D:-1;
    if(Veiculo[idv][v_Existe] == 1)
    {
        if(Veiculo[idv][v_Garagem] == 0)
        {
		    if(Veiculo[idv][v_Garagem_ID] == -1)
            {
                if(Veiculo[idv][v_Dono] == -1)
                {
		 			if(Veiculo[idv][v_Emprego] != -1) format(sss, 300, "{00ffff}Veiculo '%s' [%d]\n{ffffff}Emprego: {a1a1a1}%s\n\n{ffffff}Pra guardar {ffff00}BUZINE {ffffff}com\no veiculo", NomeVeiculo(Veiculo[idv][v_Modelo]), idv, Emprego[Veiculo[idv][v_Emprego]][e_Nome]);
					else if(Veiculo[idv][v_Org] != -1) format(sss, 300, "{00ffff}Veiculo '%s' [%d]\n{ffffff}Organizacao: {a1a1a1}%s\n\n{ffffff}Pra guardar {ffff00}BUZINE {ffffff}com\no veiculo", NomeVeiculo(Veiculo[idv][v_Modelo]), idv, Org[Veiculo[idv][v_Org]][o_Nome]);
					else format(sss, 300, "{00ffff}Veiculo '%s' [%d]\n\n{ffffff}Pra guardar {ffff00}BUZINE {ffffff}com\no veiculo", NomeVeiculo(Veiculo[idv][v_Modelo]), idv);
					Veiculo[idv][v_Pickup] = CreateDynamicPickup(11746, 1, Veiculo[idv][v_X], Veiculo[idv][v_Y], Veiculo[idv][v_Z], 0, 0, -1, STREAMER_PICKUP_SD, -1, 0);
				    Veiculo[idv][v_3D] = CreateDynamic3DTextLabel( sss, 0xffffff99, Veiculo[idv][v_X], Veiculo[idv][v_Y], Veiculo[idv][v_Z], 3, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0,  0, 0, -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
				}
				else
				{
				    if(Veiculo[idv][v_Conce] == 0)
					{
					    if(Veiculo[idv][v_Emprego] != -1) format(sss, 300, "{00ffff}Veiculo '%s' [%d]\n{ffffff}Emprego: {a1a1a1}%s\n\n{ffffff}Pra guardar {ffff00}BUZINE {ffffff}com\no veiculo", NomeVeiculo(Veiculo[idv][v_Modelo]), idv, Emprego[Veiculo[idv][v_Emprego]][e_Nome]);
						else if(Veiculo[idv][v_Org] != -1) format(sss, 300, "{00ffff}Veiculo '%s' [%d]\n{ffffff}Organizacao: {a1a1a1}%s\n\n{ffffff}Pra guardar {ffff00}BUZINE {ffffff}com\no veiculo", NomeVeiculo(Veiculo[idv][v_Modelo]), idv, Org[Veiculo[idv][v_Org]][o_Nome]);
						else format(sss, 300, "{00ffff}Veiculo '%s' [%d]\n\n{ffffff}Pra guardar {ffff00}BUZINE {ffffff}com\no veiculo", NomeVeiculo(Veiculo[idv][v_Modelo]), idv);
						Veiculo[idv][v_Pickup] = CreateDynamicPickup(11746, 1, Veiculo[idv][v_X], Veiculo[idv][v_Y], Veiculo[idv][v_Z], 0, 0, -1, STREAMER_PICKUP_SD, -1, 0);
					    Veiculo[idv][v_3D] = CreateDynamic3DTextLabel( sss, 0xffffff99, Veiculo[idv][v_X], Veiculo[idv][v_Y], Veiculo[idv][v_Z], 3, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0,  0, 0, -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
					}
				}
			}
			format(sss, 64, "{AA00FF}%s{FFFFFF}\n| {FFFFFF}%s |", NomeVeiculo(Veiculo[idv][v_Modelo]), PlacaVeiculo[idv]);
			Veiculo[idv][v_PlacaLabel] = CreateDynamic3DTextLabel(sss, 0xffffffff, 0.0, -2.0, 0.2, 20.0, INVALID_PLAYER_ID, Veiculo[idv][v_ID], 0, -1, -1, -1, 100.0);
		}
	}
}


stock EmpregoPlayer(playerid)
{
	if(!IsPlayerConnected(playerid)) return -1;
	new idd = id[playerid];
	if(idd == -1) return -1;
	return Conta[playerid][c_Emprego];
}

stock OrgPlayer(playerid)
{
	if(!IsPlayerConnected(playerid)) return -1;
	new idd = id[playerid];
	if(idd == -1) return -1;
	return Conta[playerid][c_Org];
}

stock CargoPlayer(playerid)
{
	if(!IsPlayerConnected(playerid)) return -1;
	if(OrgPlayer(playerid) == -1) return -1;
	new idd = id[playerid];
	if(idd == -1) return -1;
	return Conta[playerid][c_Cargo];
}


stock VeiculoDesocupado(v)
{
	if(GetVehicleModel(v) != 0)
	{
	    foreach(new i:Player)
	    {
	        if(IsPlayerInAnyVehicle(i))
	        {
	            if(GetPlayerVehicleID(i) == v)
	            {
					return 0;
	            }
	        }
	    }
	}
	return 1;
}

BCG:: SpawnVeiculo(v)
{
    if(GetVehicleModel(v) != 0)
	{
	    if(GetVehicleVirtualWorld(v) != 99999)
	    {
		    new idv = Info_Veiculo[v];
		    if(idv != -1)
		    {
		        new vv = rebocando_moto[idv];
		        if(vv != -1)
		        {
		            if(GetVehicleModel(vv) != 0)
		            {
				    SetVehicleVirtualWorld(vv, 0);
				    new iddd = Info_Veiculo[vv];
				    if(iddd != -1)
						{
						Veiculo[iddd][v_Garagem] = 1;
					    }
					    SetVehicleToRespawn(vv);
				    }
				    rebocando_moto[idv] = -1;
		        }
		        Veiculo[idv][v_Garagem] = 1;
		        texto_garagem(idv);
		        Info_Veiculo[v] = -1;
		        DestroyVehicle_(v);
		    }
	    }
	}
}

stock criar_cpf(c)
{
	new player = ContaOnline(c);
	if(Online(player))
	{
		if(Conta[player][c_CPF] == 0)
		{
	        new file[80];
	        new cpf_player[20];
			new Numeros[9];
			new DIA_HORA[30];
			for(new d; d<10; d++)
			{
				for(new i; i < 9; i++) Numeros[i] = random(9);
			    format(cpf_player, 20, "%d%d%d%d%d%d%d%d%d", Numeros[0], Numeros[1], Numeros[2], Numeros[3], Numeros[4], Numeros[5], Numeros[6],Numeros[7], Numeros[8]);
                format(file, 80, "CPF/%s.txt", cpf_player);
                if(!DOF2_FileExists(file))
				{
                    DOF2_CreateFile(file);
					DOF2_SetInt(file, "Conta", c);
					format(Conta[player][c_Pai], 120, "%s %s %s", Nome_Pai[random(sizeof(Nome_Pai))], sobrenome_conta(c), Nome_Familia[random(sizeof(Nome_Familia))]);
					format(Conta[player][c_Mae], 120, "%s %s %s", Nome_Mae[random(sizeof(Nome_Mae))], sobrenome_conta(c), Nome_Familia[random(sizeof(Nome_Familia))]);
					format(DIA_HORA, sizeof(DIA_HORA), "%02d/%02d/%04d", DIA, MES, ANO);
					DOF2_SetString(file, "Data", DIA_HORA);
					format(DIA_HORA, sizeof(DIA_HORA), "%02d:%02d:%02d", HORA, MINUTO, SEGUNDO);
					DOF2_SetString(file, "Hora", DIA_HORA);
					format(DIA_HORA, sizeof(DIA_HORA), "%02d/%02d/%04d", Conta[player][c_Dia2], Conta[player][c_Mes2], Conta[player][c_Ano2]-Conta[player][c_Idade]);
					DOF2_SetString(file, "Nascimento_Data", DIA_HORA);
					format(DIA_HORA, sizeof(DIA_HORA), "%02d:%02d:%02d", Conta[player][c_Hora2], Conta[player][c_Minuto2], Conta[player][c_Segundo2]);
					DOF2_SetString(file, "Nascimento_Hora", DIA_HORA);
					DOF2_SetString(file, "Sexo", sexo(Conta[player][c_Sexo]));
					DOF2_SetString(file, "Pai", Conta[player][c_Pai]);
					DOF2_SetString(file, "Mae", Conta[player][c_Mae]);
					DOF2_SetString(file, "Cidade", cidade(Conta[player][c_Cidade]));
					DOF2_SaveFile();
					Conta[player][c_CPF] = strval(cpf_player);
					salvar_conta(c, -1, "c_Documentos");
					return 1;
				}
			}
			return 2;
		}
	}
	return 0;
}

stock criar_rg(c)
{
    new player = ContaOnline(c);
	if(Online(player))
	{
		if(Conta[player][c_RG] == 0)
		{
		    if(Conta[player][c_CPF] != 0)
		    {
		        new file[80];
		        new cpf_player[20];
				new Numeros[7];
				new DIA_HORA[30];
				for(new d; d<10; d++)
				{
					for(new i; i <7; i++) Numeros[i] = random(9);
				format(cpf_player, 20, "%d%d%d%d%d%d%d", Numeros[0], Numeros[1], Numeros[2], Numeros[3], Numeros[4], Numeros[5], Numeros[6]);
					format(file, 80, "RG/%s.txt", cpf_player);
					if(!DOF2_FileExists(file))
					{
					DOF2_CreateFile(file);
						DOF2_SetInt(file, "Conta", c);
						format(DIA_HORA, sizeof(DIA_HORA), "%02d/%02d/%04d", DIA, MES, ANO);
						DOF2_SetString(file, "Data", DIA_HORA);
						format(DIA_HORA, sizeof(DIA_HORA), "%02d:%02d:%02d", HORA, MINUTO, SEGUNDO);
						DOF2_SetString(file, "Hora", DIA_HORA);
						format(DIA_HORA, sizeof(DIA_HORA), "%02d/%02d/%04d", Conta[player][c_Dia2], Conta[player][c_Mes2], Conta[player][c_Ano2]-Conta[player][c_Idade]);
						DOF2_SetString(file, "Nascimento_Data", DIA_HORA);
						format(DIA_HORA, sizeof(DIA_HORA), "%02d:%02d:%02d", Conta[player][c_Hora2], Conta[player][c_Minuto2], Conta[player][c_Segundo2]);
						DOF2_SetString(file, "Nascimento_Hora", DIA_HORA);
						DOF2_SetString(file, "Sexo", sexo(Conta[player][c_Sexo]));
						DOF2_SetString(file, "Pai", Conta[player][c_Pai]);
						DOF2_SetString(file, "Mae", Conta[player][c_Mae]);
						DOF2_SetString(file, "Cidade", cidade(Conta[player][c_Cidade]));
						DOF2_SaveFile();
						Conta[player][c_RG] = strval(cpf_player);
						Conta[player][c_Liberado] = 1;
						salvar_conta(c, -1, "c_Documentos");
						return 1;
				    }
				}
				return 2;
			}
			else return 0;
		}
	}
	return -1;
}

stock sobrenome_conta(c)
{
	new plaay;
    new sobre[MAX_PLAYER_NAME];
	new nicck[MAX_PLAYER_NAME];
	format(nicck, MAX_PLAYER_NAME, NomeConta(c));
	new cont;
	for(new i; i<strlen(nicck); i++)
	{
	    if(plaay == 0)
	    {
	        if(nicck[i] == '_')
	        {
	            plaay = 1;
	        }
	    }
	    else
	    {
	        sobre[cont] = nicck[i];
	        cont++;
	    }
	}
	return sobre;
}
