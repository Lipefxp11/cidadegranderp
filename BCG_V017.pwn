	    for(new i; i<MAX_CUPONS; i++)
	    {
	        if(Cupom[i][cup_Existe] == 1 && !strcmp(Cupom[i][cup_Codigo], codigo, true))
	        {
	            if(Cupom[i][cup_CurrentUses] >= Cupom[i][cup_MaxUses]) return ms(playerid, 0, "Este cupom ja atingiu o limite de usos !");
	            new sss[300];
	            format(sss, 300, "{ffffff}Voce deseja resgatar o cupom {ffff00}%s{ffffff} ?", codigo);
	            SetPVarInt(playerid, "resgatando_cupom", i);
	            ShowPlayerDialog(playerid, DIALOG_CUPOM_CONFIRMAR, DIALOG_STYLE_MSGBOX, "{00ff00}Resgatar Cupom", sss, "Resgatar", "Cancelar");
	            return 1;
	        }
	    }
