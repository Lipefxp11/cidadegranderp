		if(o < 0 || o >= MAX_MAQUINAS) return ms(playerid, 0, "ID de Maquina de armamentos invalido !");
		if(Maquina[o][m_Existe] == 0) return ms(playerid, 0, "Esta Maquina de armamentos nao existe !");
		for(new a; a<4; a++) Maquina[o][m_Materiais][a] = 0;
		for(new a; a<10; a++)
		{
			Maquina[o][m_Tempo][a] = 0;
			Maquina[o][m_Status][a] = 0;
			Maquina[o][m_Tipo][a] = 0;
			Maquina[o][m_Unidades][a] = 0;
			Maquina[o][m_ID][a] = 0;
		}		
