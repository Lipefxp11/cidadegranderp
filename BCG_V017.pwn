	    if(i < 0 || i >= MAX_ELEVADORES) return ms(playerid, 0, "ID de elevador invalido !");
		if(Elevador[i][ele_Existe] == 0) return ms(playerid, 0, "Este elevador nao existe !");
		for(new a; a<MAX_ANDARES; a++)
		{
		    if(Elevador[i][ele_a_Existe][a] == 0)
		    {
	            Elevador[i][ele_a_Existe][a] = 1;
				GetPlayerPos(playerid, Elevador[i][ele_a_X][a], Elevador[i][ele_a_Y][a], Elevador[i][ele_a_Z][a]);
				PegarFrentePlayer(playerid, Elevador[i][ele_a_X][a], Elevador[i][ele_a_Y][a], 4);
				KillTimer(Elevador[i][ele_Timer]);
				StopDynamicObject(Elevador[i][ele_Obj]);
				Elevador[i][ele_Andar] = 0;
		        Elevador[i][ele_Status] = 0;
		        SetDynamicObjectPos(Elevador[i][ele_Obj], Elevador[i][ele_a_X][a], Elevador[i][ele_a_Y][a], Elevador[i][ele_a_Z][a]);
		        new sss[150];
				format(sss, 150, "Voce criou o Andar [%d] do elevador ID: %d.", a, i);
				ms(playerid, 1, sss);
				EditandoElevador[playerid] = i;
				andar_elevador[playerid] = a;
				EditDynamicObject2(playerid, Elevador[i][ele_Obj]);
				ms(playerid, 1, "Movimente o objeto usando o editor, e salve a posicao.");
				return 1;
			}
		}
		ms(playerid, 0, "Este elevador ja atingiu o maximo de andares !");
		return 1;
	}

