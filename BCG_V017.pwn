	            if(ID_menu == MENU_247) format(sss, 150, "Voce comprou '%s %s' por R$ %s.", ConvertMoney(unidades), Menu_247[listitem][mercado_Nome], ConvertMoney(valor));
				if(ID_menu == MENU_ELETRONICOS) format(sss, 150, "Voce comprou '%s %s' por R$ %s.", ConvertMoney(unidades), Menu_Eletronicos[listitem][mercado_Nome], ConvertMoney(valor));
