stock mostrar_veiculos_org(playerid, i)
{
    if(Org[i][o_Existe] == 1)
	{
        if(Online(playerid))
	    {
	        new cont;
	        SG[0] = EOS;
	        new sss[150];
	        Lista2[playerid][0] = -1;
	        strcat(SG, "Info\tPlaca\tModelo\tCargo\n");
	        foreach(new v:Iter_Veiculos)
	        {
	            if(Veiculo[v][v_Existe] == 1)
	            {
                    if(Veiculo[v][v_Org] == i)
                    {
                        format(sss, 150, "{a1a1a1}%d\t{ffff00}%s\t{ffffff}%s\t{00ffff}%s\n", v, PlacaVeiculo[v], NomeVeiculo(Veiculo[v][v_Modelo]), nome_cargo(Veiculo[v][v_Cargo],Veiculo[v][v_Org]));
                        strcat(SG, sss);
                        Lista2[playerid][cont] = v;
                        cont++;
                    }
	            }
	        }
	        if(cont == 0)
	        {
	            abrir_org(playerid, i);
	            ms(playerid, 0, "A organizacao nao tem nenhum veiculo !");
	        }
			else ShowPlayerDialog(playerid, DIALOG_ORG9, DIALOG_STYLE_TABLIST_HEADERS, "Veiculos da Organizacao", SG, "Continuar", "Voltar");
		}
	}
}

