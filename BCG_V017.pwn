	if(!strcmp(cmd, "/ajudaactors", true))
	{
	    new sss[1000];
		strcat(sss, "{ffffff}/iractor {a1a1a1}Para ir ate um Actor.\n");
		strcat(sss, "{ffffff}/copiaractor {a1a1a1}Para copiar um Actor e criar outro igual.\n");
		strcat(sss, "{ffffff}/criaractor {a1a1a1}Para criar um novo Actor.\n");
		strcat(sss, "{ffffff}/destruiractor	{a1a1a1}Para destruir um Actor existente.\n");
		strcat(sss, "{ffffff}/actor	{a1a1a1}para obter o ID de um actor proximo.\n");
		strcat(sss, "{ffffff}/skinactor	{a1a1a1}Para alterar a Skin de um Actor.\n");
		strcat(sss, "{ffffff}/nomeactor	{a1a1a1}Para alterar o Nome de um Actor.\n");
		strcat(sss, "{ffffff}/animactor	{a1a1a1}Para alterar a Animacao de um Actor.\n");
		strcat(sss, "{ffffff}/trazeractor {a1a1a1}Para alterar a Posicao de um Actor.\n");
		ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Comandos para Actors", sss, "Ok", "Fechar");
		return 1;
	}

	if(!strcmp(cmd, "/copiaractor", true))
	{
	    new i;
	    if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /copiaractor [ID].");
		if(i < 0 || i >= MAX_BOOTS) return ms(playerid, 0, "ID de Actor invalido !");
		if(Actor[i][a_Existe] == 0) return ms(playerid, 0, "ID de Actor invalido !");

		for(new a; a<MAX_BOOTS; a++)
		{
			if(Actor[a][a_Existe] == 0)
			{
			    Actor[a][a_Existe] = 1;
	        	Actor[a][a_Skin] = Actor[i][a_Skin];
	            format(Actor[a][a_Nome], MAX_PLAYER_NAME, Actor[i][a_Nome]);
	            format(Actor[a][a_Anim1], MAX_PLAYER_NAME, Actor[i][a_Anim1]);
	            format(Actor[a][a_Anim2], MAX_PLAYER_NAME, Actor[i][a_Anim2]);
	            Actor[a][a_Animacao] = Actor[i][a_Animacao];
				GetPlayerPos(playerid, Actor[a][a_X],Actor[a][a_Y],Actor[a][a_Z]);
				GetPlayerFacingAngle(playerid, Actor[a][a_A]);
	            Actor[a][a_Mundo] = GetPlayerVirtualWorld_(playerid);
				Actor[a][a_Interior] = GetPlayerInterior(playerid);
				atualizar_actor(a);
	    		salvar_actor(a);
				new sss[150];
	    		format(sss, 150,"Voce copiou Actor ID %d,  e criou o Actor ID:%d." , i, a);
				ms(playerid, 5, sss);
				return 1;
			}
		}
		ms(playerid, 0, "Numero maximo de Actors atingido !");
		return 1;
	}

	if(!strcmp(cmd, "/animactor", true))
	{
	    new i, anim1[40],anim2[40], an;
	    if(sscanf(params, "dds[40]s[40]", i, an, anim1, anim2)) return ms(playerid, 2, "Use: /animactor [ID] [ 1 = sim, 0 = nao] [ anim1 ] [ anim 2 ].");
		if(i < 0 || i >= MAX_BOOTS) return ms(playerid, 0, "ID de Actor invalido !");
		if(Actor[i][a_Existe] == 0) return ms(playerid, 0, "ID de Actor invalido !");
	    Actor[i][a_Animacao] = an;
		format(Actor[i][a_Anim1], 40, anim1 );
		format(Actor[i][a_Anim2], 40, anim2 );
	    atualizar_actor(i);
	    salvar_actor(i);
	    new sss[150];
	    format(sss, 150, "Voce alterou a Animacao do Actort.");
		ms(playerid, 5, sss);
		return 1;
	}

	if(!strcmp(cmd, "/iractor", true))
	{
	    new i;
	    if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /iractor [ID].");
		if(i < 0 || i >= MAX_BOOTS) return ms(playerid, 0, "ID de Actor invalido !");
		if(Actor[i][a_Existe] == 0) return ms(playerid, 0, "ID de Actor invalido !");
		SetPlayerPos_(playerid, Actor[i][a_X]+0.1, Actor[i][a_Y]+0.1, Actor[i][a_Z]+0.1);
		SetPlayerInterior(playerid, Actor[i][a_Interior]);
		SetPlayerVirtualWorld_(playerid, Actor[i][a_Mundo]);
	    new sss[150];
	    format(sss, 150,"Voce foi ate o Actor ID %d." , i);
		ms(playerid, 5, sss);
		return 1;
	}

	if(!strcmp(cmd, "/trazeractor", true))
	{
	    new i;
	    if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /nomeactor [ID].");
		if(i < 0 || i >= MAX_BOOTS) return ms(playerid, 0, "ID de Actor invalido !");
		if(Actor[i][a_Existe] == 0) return ms(playerid, 0, "ID de Actor invalido !");
		GetPlayerPos(playerid, Actor[i][a_X], Actor[i][a_Y], Actor[i][a_Z]);
		GetPlayerFacingAngle(playerid, Actor[i][a_A]);
	    atualizar_actor(i);
	    salvar_actor(i);
	    new sss[150];
	    format(sss, 150, "Voce alterou a Posicao do Actort ID %d." , i);
		ms(playerid, 5, sss);
		return 1;
	}

	if(!strcmp(cmd, "/nomeactor", true))
	{
	    new i, nome[MAX_PLAYER_NAME];
	    if(sscanf(params, "ds[24]", i, nome)) return ms(playerid, 2, "Use: /nomeactor [ID do Actor use /actor] [Nome].");
		if(i < 0 || i >= MAX_BOOTS) return ms(playerid, 0, "ID de Actor invalido !");
		if(Actor[i][a_Existe] == 0) return ms(playerid, 0, "ID de Actor invalido !");
		format(Actor[i][a_Nome], MAX_PLAYER_NAME, nome );
	    atualizar_actor(i);
	    salvar_actor(i);
	    new sss[150];
	    format(sss, 150, "Voce alterou o Nome do Actort ID %d, para skin: '%s'.", i, nome);
		ms(playerid, 5, sss);
		return 1;
	}

	if(!strcmp(cmd, "/skinactor", true))
	{
	    new i, skina;
	    if(sscanf(params, "dd", i, skina)) return ms(playerid, 2, "Use: /skinactor [ID do Actor use /actor] [ID da skin].");
		if(i < 0 || i >= MAX_BOOTS) return ms(playerid, 0, "ID de Actor invalido !");
		if(Actor[i][a_Existe] == 0) return ms(playerid, 0, "ID de Actor invalido !");
		if(skina < 0 || skina > 311) return ms(playerid, 0, "ID de Skin invalido ! Use de 0 - 311.");
		Actor[i][a_Skin] = skina;
	    atualizar_actor(i);
	    salvar_actor(i);
	    new sss[150];
	    format(sss, 150, "Voce alterou a Skin do Actort ID %d, para skin: %d.", i, skina);
		ms(playerid, 5, sss);
		return 1;
	}

	if(!strcmp(cmd, "/actor", true))
	{
	    for(new i; i<MAX_BOOTS; i++)
		{
			if(Actor[i][a_Existe] == 1)
			{
			    if(IsPlayerInRangeOfPoint(playerid, 5, Actor[i][a_X],Actor[i][a_Y],Actor[i][a_Z]))
				{
				if(GetPlayerInterior(playerid) == Actor[i][a_Interior])
				{
				    if(GetPlayerVirtualWorld_(playerid) == Actor[i][a_Mundo])
					{
		            		new sss[150];
				    		format(sss, 150, "Actor de ID %d, Nome: %s.", i, Actor[i][a_Nome]);
							ms(playerid, 5, sss);
							return 1;
						}
					}
				}
			}
		}
		ms(playerid, 0, "Nenhum Actor proximo a voce !");
		return 1;
	}

	if(!strcmp(cmd, "/destruiractor", true))
	{
	    new i;
	    if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /destruiractor [ID do Actor use /actor].");
		if(i < 0 || i >= MAX_BOOTS) return ms(playerid, 0, "ID de Actor invalido !");
		if(Actor[i][a_Existe] == 0) return ms(playerid, 0, "ID de Actor invalido !");
	    Actor[i][a_Existe] = 0;
	    atualizar_actor(i);
	    salvar_actor(i);
	    new sss[150];
	    format(sss, 150, "Voce destruiu o Actort de ID %d.", i);
		ms(playerid, 5, sss);
		return 1;
	}

	if(!strcmp(cmd, "/criaractor", true))
	{
	    new sss[150];
	    new Float:p[4];
	    new nome[MAX_PLAYER_NAME], skina;
	    GetPlayerPos(playerid, p[0], p[1], p[2]);
	    GetPlayerFacingAngle(playerid, p[3]);
	    if(sscanf(params, "ds[24]", skina, nome)) return ms(playerid, 2, "Use: /actor [skin] [Nome].");
	    if(skina < 0 || skina > 311) return ms(playerid, 0, "ID de Skin invalido ! Use de 0 - 311.");
		new a = criar_actor(p[0], p[1], p[2], p[3], nome, GetPlayerInterior(playerid), GetPlayerVirtualWorld_(playerid), skina);
		format(sss, 150, "Novo Actor criado ID: %d ! Use /ajudaactors para ver os comandos.", a);
		ms(playerid, 5, sss);
		return 1;
	}


	if(!strcmp(cmd, "/irpos", true))
	{
		new Float:pos[3], inter, mund;
		if(sscanf(params, "fffdd", pos[0], pos[1], pos[2], inter, mund)) return ms(playerid, 2, "Use: /irpos [X] [Y] [Z] [interior] [mundo].");
		SetPlayerPos_(playerid, pos[0], pos[1], pos[2]);
		SetPlayerInterior(playerid, inter);
		SetPlayerVirtualWorld_(playerid, mund);
	    ms(playerid, 5, "Voce se teleportou para uma Posicao nova.");
		return 1;
	}

    if(!strcmp(cmd, "/criarcaixa", true))
	{
	    if(AdminPlayer(playerid) < 5) return ms(playerid, 0, "Apenas admin nivel 5+ !");
	    for(new i; i<MAX_BOOTS; i++) if(Actor[i][a_Existe] == 1 && IsPlayerInRangeOfPoint(playerid, 5, Actor[i][a_X], Actor[i][a_Y], Actor[i][a_Z]) && GetPlayerInterior(playerid) == Actor[i][a_Interior] && GetPlayerVirtualWorld_(playerid) == Actor[i][a_Mundo])
	    {
	        Actor[i][a_Caixa] = 1;
	        salvar_actor(i);
	        ms(playerid, 1, f("Actor ID %d marcado como caixa!", i));
	        return 1;
	    }
	    ms(playerid, 0, "Nenhum actor encontrado perto de voce !");
	    return 1;
	}

    if(!strcmp(cmd, "/irassalto", true))
	{
	    new actorid = GetPVarInt(playerid, "assalto_actor");
	    if(actorid < 0 || actorid >= MAX_BOOTS || Actor[actorid][a_RouboStatus] == 0) return ms(playerid, 0, "Nenhum assalto ativo no momento !");
	    Localizar_Player(playerid, Actor[actorid][a_X], Actor[actorid][a_Y], Actor[actorid][a_Z], 78, actorid, "ASSALTO EM ANDAMENTO");
	    ms(playerid, 1, "Um checkpoint foi marcado no local do assalto !");
	    return 1;
	}

	if(!strcmp(cmd, "/ajudapickups", true))
	{
	    SG[0] = EOS;
	    strcat(SG, "Comando\tO que faz\n");
	    strcat(SG, "/criarpickup\tCria um novo pickup\n");
	    strcat(SG, "/pickup\tMostra o ID do pickup proximo\n");
	    strcat(SG, "/infopickup [ID]\tMostra dados completos\n");
	    strcat(SG, "/funcaopickup [ID]\tAbre menu de funcoes explicado\n");
	    strcat(SG, "/trazerpickup [ID]\tMove para sua posicao/mundo/interior\n");
	    strcat(SG, "/tipopickup [ID] [tipo]\tAltera o tipo de funcionamento\n");
	    strcat(SG, "/modelopickup [ID] [modelo]\tAltera o modelo 3D\n");
	    strcat(SG, "/mapapickup [ID] [modelo]\tAltera icone/modelo do mapa\n");
	    strcat(SG, "/textopickup [ID] [texto]\tAltera o texto exibido\n");
	    strcat(SG, "/mundopickup [ID] [mundo]\tAltera o virtual world\n");
	    strcat(SG, "/interiorpickup [ID] [int]\tAltera o interior\n");
	    strcat(SG, "/copiarpickup [ID]\tCopia configuracao existente\n");
	    strcat(SG, "/irpickup [ID]\tTeleporta ate o pickup\n");
	    strcat(SG, "/acharpickup [tipo]\tLocaliza pickups pelo tipo\n");
	    strcat(SG, "/destruirpickup [ID]\tRemove o pickup");
	    ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_TABLIST_HEADERS, "{E53935}BCG | Central de Pickups", SG, "Fechar", "");
	    return 1;
	}

	if(!strcmp(cmd, "/pickup", true))
	{
		foreach(new i:Iter_Pickups)
		{
			if(Pickup[i][pick_Existe] == 1)
			{
			    if(IsPlayerInRangeOfPoint(playerid, 3, Pickup[i][pick_X],Pickup[i][pick_Y],Pickup[i][pick_Z]))
				{
				if(GetPlayerInterior(playerid) == Pickup[i][pick_Interior])
				{
				    if(GetPlayerVirtualWorld_(playerid) == Pickup[i][pick_Mundo])
					{
		            		new sss[150];
				    		format(sss, 150, "Pickup de ID %d.", i);
							ms(playerid, 5, sss);
							return 1;
						}
					}
				}
			}
		}
		ms(playerid, 0, "Nenhum Pickup proximo a voce !");
		return 1;
	}


	if(!strcmp(cmd, "/infopickup", true))
	{
		new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /infopickup [ ID ].");
	    if(i < 0 || i >= MAX_PICKUP) return ms(playerid, 0, "ID de pickup Invalido !");
		if(Pickup[i][pick_Existe] == 0) return ms(playerid, 0, "ID de pickup Invalido !");
		new sss[500];
		ms(playerid, 4,  "");
		ms(playerid, 4,  "--------------------------");
		format(sss, 500, "-- ID do Pickup: %d.", i), ms(playerid, 4, sss);
		format(sss, 500, "-- Tipo: %d.", Pickup[i][pick_Tipo]), ms(playerid, 4, sss);
		format(sss, 500, "-- Modelo: %d.", Pickup[i][pick_Modelo]), ms(playerid, 4, sss);
		format(sss, 500, "-- Mapa: %d.", Pickup[i][pick_MapaModelo]), ms(playerid, 4, sss);
		format(sss, 500, "-- Interior: %d.", Pickup[i][pick_Interior]), ms(playerid, 4, sss);
		format(sss, 500, "-- Mundo: %d.", Pickup[i][pick_Mundo]), ms(playerid, 4, sss);
		ms(playerid, 4,  "-------------------------");
		ms(playerid, 4,  "");
		return 1;
	}

	if(!strcmp(cmd, "/funcaopickup", true))
	{
	    // Novo fluxo: abre uma interface explicada. Tambem aceita /funcaopickup [ID].
	    new i;
	    if(sscanf(params, "d", i))
	    {
	        ShowPlayerDialog(playerid, DIALOG_PICKUP_FUNCAO_ID, DIALOG_STYLE_INPUT, "{E53935}BCG | Funcao do Pickup",
	            "{FFFFFF}Configure a funcao do pickup sem decorar numeros.\n\nDigite o {E53935}ID do pickup{FFFFFF}:", "Continuar", "Cancelar");
	        return 1;
	    }
	    if(i < 0 || i >= MAX_PICKUP || Pickup[i][pick_Existe] == 0) return ms(playerid, 0, "ID de pickup invalido !");
	    SetPVarInt(playerid, "BCG_PickupEdit", i);
	    ShowPlayerDialog(playerid, DIALOG_PICKUP_FUNCAO_LISTA, DIALOG_STYLE_TABLIST_HEADERS, "{E53935}BCG | Configurar Pickup",
	        "Funcao\tDescricao\n{FFFFFF}Sem funcao\tRemove o ponto de funcao atual\n{E53935}Definir neste local\tUsa sua posicao atual como ponto de funcao", "Aplicar", "Voltar");
	    return 1;
	}

	if(!strcmp(cmd, "/cprods", true))
	{
		if(ISP(playerid, 10.0, 1636.1149,960.7747,11.4126)){
			if(EmpregoPlayer(playerid) == 11){
		        if(IsPlayerInAnyVehicle(playerid)){
		            new car = GetPlayerVehicleID(playerid);
		            new v = Info_Veiculo[car];
		            if(v != -1)
		            {
						if(produtos_veiculo[v] < 500)
						{
		                    mostrar_comprar_prods(playerid, car);
		                }
		                else MS(playerid, 0, "Este caminhao ja esta lotado de produtos !");
		            }
		            else MS(playerid, 0, "Voce nao esta em um veiculo do emprego !");
		        }
		        else MS(playerid, 0, "Voce nao esta em um veiculo do emprego !");
			}
			else MS(playerid, 0, "Voce nao pertence a este emprego !");
		}
		else{
			MS(playerid, 0, "{FF0000}Voce nao esta no local correto.");
		}
		return 1;
	}
	if(!strcmp(cmd, "/irpickup", true))
	{
		new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /irpickup [ ID ].");
	    if(i < 0 || i >= MAX_PICKUP) return ms(playerid, 0, "ID de pickup Invalido !");
		if(Pickup[i][pick_Existe] == 0) return ms(playerid, 0, "ID de pickup Invalido !");
		SetPlayerPos_(playerid, Pickup[i][pick_X]+0.1, Pickup[i][pick_Y]+0.1, Pickup[i][pick_Z]+0.1);
		SetPlayerInterior(playerid, Pickup[i][pick_Interior]);
		SetPlayerVirtualWorld_(playerid, Pickup[i][pick_Mundo]);
		new sss[150];
		format(sss, 150, "Voce foi ate o Pickup ID: %d.", i);
		ms(playerid, 5, sss);
		return 1;
	}

	if(!strcmp(cmd, "/acharpickup", true))
	{
		new i;
		new sss[150];
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /acharpickup [ ID do Tipo ].");
		new sim;
		foreach(new a:Iter_Pickups)
		{
		    if(Pickup[a][pick_Existe] == 1)
		    {
		        if(Pickup[a][pick_Tipo] == i)
		        {
		            format(sss, 150, "Pickup do tipo [%d] encontrado, ID: %d.", i, a);
					ms(playerid, 5, sss);
		        }
		    }
		}
		if(sim == 0) ms(playerid, 0, "Nenhum ID de Pickup encontrado com o Tipo Informado !");
		return 1;
	}

	if(!strcmp(cmd, "/copiarpickup", true))
	{
		new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /copiarpickup [ ID ].");
	    if(i < 0 || i >= MAX_PICKUP) return ms(playerid, 0, "ID de pickup Invalido !");
		if(Pickup[i][pick_Existe] == 0) return ms(playerid, 0, "ID de pickup Invalido !");
		new pick = criar_pickup(Pickup[i][pick_X], Pickup[i][pick_Y], Pickup[i][pick_Z], Pickup[i][pick_Mundo], Pickup[i][pick_Interior], Pickup[i][pick_MapaModelo], Pickup[i][pick_Modelo], Pickup[i][pick_Texto1], Pickup[i][pick_Texto2], Pickup[i][pick_Texto3], Pickup[i][pick_Texto4], Pickup[i][pick_Texto5]);
		if(pick == -1) return ms(playerid, 0, "Numero maximo de Pickups atingido !");
		new sss[150];
		Pickup[pick][pick_Tipo] = Pickup[i][pick_Tipo];
		format(sss, 150, "Pickup %d copiado, Novo Pickup criado ID: %d, use /ajudapickups.", i, pick);
		ms(playerid, 5, sss);
		GetPlayerPos(playerid, Pickup[pick][pick_X], Pickup[pick][pick_Y], Pickup[pick][pick_Z]);
		atualizar_pickup(pick);
		salvar_pickup(pick);
		return 1;
	}

	if(!strcmp(cmd, "/tipopickup", true))
	{
	    new i, tipo;
		if(sscanf(params, "dd", i, tipo)) return ms(playerid, 2, "Use: /tipopickup [ ID ] [ Tipo ].");
	    if(i < 0 || i >= MAX_PICKUP) return ms(playerid, 0, "ID de pickup Invalido !");
		if(Pickup[i][pick_Existe] == 0) return ms(playerid, 0, "ID de pickup Invalido !");
	    Pickup[i][pick_Tipo] = tipo;
	    new sss[150];
		format(sss, 150, "Voce salvou o Tipo do Pickup ID: %d para [%d].", i, tipo);
		ms(playerid, 5, sss);
		salvar_pickup(i);
		return 1;
	}

	if(!strcmp(cmd, "/textopickup", true))
	{
	    new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /textopickup [ ID ].");
		if(i < 0 || i >= MAX_PICKUP) return ms(playerid, 0, "ID de pickup Invalido !");
		if(Pickup[i][pick_Existe] == 0) return ms(playerid, 0, "ID de pickup Invalido !");
		SetPVarInt(playerid, "id_texto", i);
		new sss[450];
		format(sss, 450, "%s\n%s\n%s\n%s\n%s", Pickup[i][pick_Texto1], Pickup[i][pick_Texto2], Pickup[i][pick_Texto3], Pickup[i][pick_Texto4], Pickup[i][pick_Texto5]);
	    ShowPlayerDialog(playerid, DIALOG_TEXTO_PICKUP, DIALOG_STYLE_LIST, "Aterar Texto", sss, "Continuar", "Cancelar");
		return 1;
	}


	if(!strcmp(cmd, "/modelopickup", true))
	{
	    new i, modelo;
		if(sscanf(params, "dd", i, modelo)) return ms(playerid, 2, "Use: /modelopickup [ ID ] [ Modelo do Pickup ].");
	    if(i < 0 || i >= MAX_PICKUP) return ms(playerid, 0, "ID de pickup Invalido !");
		if(Pickup[i][pick_Existe] == 0) return ms(playerid, 0, "ID de pickup Invalido !");
	    Pickup[i][pick_Modelo] = modelo;
	    atualizar_pickup(i);
	    new sss[150];
		format(sss, 150, "Voce salvou o Modelo do Pickup ID: %d para [%d].", i, modelo);
		ms(playerid, 5, sss);
		salvar_pickup(i);
		return 1;
	}

	if(!strcmp(cmd, "/mapapickup", true))
	{
	    new i, mapa;
		if(sscanf(params, "dd", i, mapa)) return ms(playerid, 2, "Use: /mundopickup [ ID ] [ Modelo no Mapa ].");
	    if(i < 0 || i >= MAX_PICKUP) return ms(playerid, 0, "ID de pickup Invalido !");
		if(Pickup[i][pick_Existe] == 0) return ms(playerid, 0, "ID de pickup Invalido !");
	    Pickup[i][pick_MapaModelo] = mapa;
	    atualizar_pickup(i);
	    new sss[150];
		format(sss, 150, "Voce salvou o Modelo no Mapa do Pickup ID: %d para [%d].", i, mapa);
		ms(playerid, 5, sss);
		salvar_pickup(i);
		return 1;
	}

	if(!strcmp(cmd, "/interiorpickup", true))
	{
	    new i, interior;
		if(sscanf(params, "dd", i, interior)) return ms(playerid, 2, "Use: /mundopickup [ ID ] [ Interior ].");
	    if(i < 0 || i >= MAX_PICKUP) return ms(playerid, 0, "ID de pickup Invalido !");
		if(Pickup[i][pick_Existe] == 0) return ms(playerid, 0, "ID de pickup Invalido !");
	    Pickup[i][pick_Interior] = interior;
	    atualizar_pickup(i);
	    new sss[150];
		format(sss, 150, "Voce salvou o Interior do Pickup ID: %d para [%d].", i, interior);
		ms(playerid, 5, sss);
		salvar_pickup(i);
		return 1;
	}

	if(!strcmp(cmd, "/mundopickup", true))
	{
	    new i;
		new mundo;
		if(sscanf(params, "dd", i, mundo)) return ms(playerid, 2, "Use: /mundopickup [ ID ] [ Mundo ].");
	    if(i < 0 || i >= MAX_PICKUP) return ms(playerid, 0, "ID de pickup Invalido !");
		if(Pickup[i][pick_Existe] == 0) return ms(playerid, 0, "ID de pickup Invalido !");
	    Pickup[i][pick_Mundo] = mundo;
	    atualizar_pickup(i);
	    new sss[150];
		format(sss, 150, "Voce salvou o Mundo do Pickup ID: %d para [%d].", i, mundo);
		ms(playerid, 5, sss);
		salvar_pickup(i);
		return 1;
	}


	if(!strcmp(cmd, "/trazerpickup", true))
	{
	    new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /trazerpickup [ ID ].");
		if(i < 0 || i >= MAX_PICKUP) return ms(playerid, 0, "ID de pickup Invalido !");
		if(Pickup[i][pick_Existe] == 0) return ms(playerid, 0, "ID de pickup Invalido !");
	    GetPlayerPos(playerid, Pickup[i][pick_X], Pickup[i][pick_Y], Pickup[i][pick_Z]);
		Pickup[i][pick_Interior] = GetPlayerInterior(playerid);
		Pickup[i][pick_Mundo] = GetPlayerVirtualWorld_(playerid);
		atualizar_pickup(i);
		new sss[150];
		format(sss, 150, "Voce salvou a posicao, interior, e mundo do Pickup ID: %d.", i);
		ms(playerid, 5, sss);
		salvar_pickup(i);
		return 1;
	}

	if(!strcmp(cmd, "/destruirpickup", true))
	{
		new i;
	    if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /destruirpickup [ ID ].");
		if(i < 0 || i >= MAX_PICKUP) return ms(playerid, 0, "ID de pickup Invalido !");
		if(Pickup[i][pick_Existe] == 0) return ms(playerid, 0, "ID de pickup Invalido !");
		new sss[150];
		format(sss, 150, "Voce destruiu o Pickup ID: %d.", i);
		ms(playerid, 5, sss);
		destruir_pickup(i);
		return 1;
	}

	if(!strcmp(cmd, "/criarpickup", true))
	{
		new texto[150];
		new modelo, mapa;
		if(sscanf(params, "dds[150]", modelo, mapa, texto)) return ms(playerid, 2, "Use: /criarpickup [ modelo ] [ mapa ] [ texto ].");
		new Float:pos[3];
		GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
		new pick = criar_pickup(pos[0], pos[1], pos[2], GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), mapa, modelo, texto, "{a1a1a1}", "{a1a1a1}", "{a1a1a1}", "{a1a1a1}");
		if(pick == -1) return ms(playerid, 0, "Numero maximo de Pickups atingido !");
		new sss[150];
		format(sss, 150, "Novo Pickup criado ID: %d, use /ajudapickups.", pick);
		ms(playerid, 5, sss);
		salvar_pickup(pick);
		return 1;
	}

	if(!strcmp(cmd, "/aa", true))
	{
	    new sss[300];
	    SG[0] = EOS;
	    for(new i = 1; i <= 8; i++)
	    {
	        format(sss, 300, "{ffffff}Comandos de Nivel {ffff00}%d\n", i);
	        strcat(SG, sss);
	    }
	    strcat(SG, "{00ffff}Comandos de Edicao\n");
	    ShowPlayerDialog(playerid, DIALOG_AA_NIVEL, DIALOG_STYLE_LIST, "{ffff00}Selecione o nivel admin", SG, "Ver", "Fechar");
	    return 1;
	}


	if(!strcmp(cmd, "/t", true))
	{
		if(GetPVarInt(playerid, "flood_adm") > gettime()) return ms(playerid, 0, "Voce nao pode usar este comando com muita frequencia !");
		new sss[150];
		new c = id[playerid];
		if(c == -1) return 1;
		if(ModoAdmin[playerid] == 0)
		{
		    ModoAdmin[playerid] = 1;
		    SetPVarInt(playerid, "staff_skin_original", GetPlayerSkin(playerid));
		    SetPlayerSkin(playerid, 217);
		    format(sss, 150, "O Administrador %s entrou em modo Trabalho.", Nome(playerid));
		    SetPVarInt(playerid, "flood_adm", gettime()+3);
		}
		else
		{
		    ModoAdmin[playerid] = 0;
		    new orig = GetPVarInt(playerid, "staff_skin_original");
		    if(orig > 0 && orig < 312) SetPlayerSkin(playerid, orig);
		    format(sss, 150, "O Administrador %s entrou em modo Jogo.", Nome(playerid));
		    SetPVarInt(playerid, "flood_adm", gettime()+3);
		}
		foreach(new i:Player) if(Online(i)) ms(i, 0xF08080ff, sss);
		return 1;
	}

	if(!strcmp(cmd, "/t2", true))
	{
	    new c = id[playerid];
		if(c == -1) return 1;
		if(GetPVarInt(playerid, "flood_adm") > gettime()) return ms(playerid, 0, "Voce nao pode usar este comando com muita frequencia !");
		if(ModoAdmin[playerid] == 0)
		{
		    ModoAdmin[playerid] = 1;
		    SetPVarInt(playerid, "staff_skin_original", GetPlayerSkin(playerid));
		    SetPlayerSkin(playerid, 217);
		    ms(playerid, 5, "Voce entrou em modo trabalho sem ninguem saber !");
		    SetPVarInt(playerid, "flood_adm", gettime()+3);
		}
		else
		{
		    ModoAdmin[playerid] = 0;
		    new orig = GetPVarInt(playerid, "staff_skin_original");
		    if(orig > 0 && orig < 312) SetPlayerSkin(playerid, orig);
		    ms(playerid, 5, "Voce saiu do modo trabalho sem ninguem saber !");
		    SetPVarInt(playerid, "flood_adm", gettime()+3);
		}
		return 1;
	}

	if(!strcmp(cmd, "/lobby", true))
	{
		if(id[playerid] != -1)
		{
			spawn_lobby(playerid);
			SetTimerEx("sentar_player", 1000, false, "d", playerid);
		}
		return 1;
	}

	new sss[300];
    format(sss, 300, "O comando digitado '%s' nao existe em nosso servidor, tente /ajuda ou /comandos", cmd);
 	MS(playerid, 0, sss);
	return 1;
}

public OnPlayerText(playerid, text[])
{
    if(logado[playerid] == 0) return 0;
	new string[200];

	if(atendimento_player[playerid] != -1)
    {
        format(string, 200, "{7B68EE}[PLAYER] {ffffff}%s {00ffff}%d {ffff00}%d: {ffffff}%s", Nome(playerid), id[playerid], playerid, text);
        foreach(new i:Player) if(Online(i)) if(atendimento_admin[i] == atendimento_player[playerid]) ms(i, 4, string);
        ms(playerid, 4, string);
        return 0;
    }

    if(atendimento_admin[playerid] != -1)
    {
        format(string, 200, "{F08080}[ADMIN] {ffffff}%s {00ffff}%d {ffff00}%d: {ffffff}%s", Nome(playerid),id[playerid], playerid, text);
        foreach(new i:Player) if(Online(i)) if(atendimento_player[i] == atendimento_admin[playerid]) ms(i, 4, string);
        ms(playerid, 4, string);
        return 0;
    }

	if(id[playerid] != -1)
	{
	    if(ModoAdmin[playerid] == 1)
	        format(string, 200, "{FF69B4}* [{FFB6C1}STAFF{FF69B4}] ID:{FFFF00}(%d) {FFB6C1}diz: %s", id[playerid], text);
		else
        	format(string, 200, "{BEBEBE}* ID:{FFDC33}(%d) {BEBEBE}diz: %s", id[playerid], text);
		ProxDetector(30.0, playerid, string, 0xffffffff,0xDCDCDCff,0xC0C0C0ff,0xA9A9A9ff,0x808080ff);
		SetPlayerChatBubble(playerid, text, 0xF0F0F0ff, 15, 5000);
	}
	return 0;
}


BCG:: ProxDetector(Float:radi, playerid, const string[],col1,col2,col3,col4,col5)
{
	if(Online(playerid))
	{
		new Float:posx, Float:posy, Float:posz;
		new Float:oldposx, Float:oldposy, Float:oldposz;
		new Float:tempposx, Float:tempposy, Float:tempposz;
		GetPlayerPos(playerid, oldposx, oldposy, oldposz);

  		foreach(new i:Player)
		{
			if(Online(i))
			{
			    if(playerid == i)
				{
				ms(i, 4, string);
			    }
			    else if(player_arena[playerid] == player_arena[i])
				{
				    if(GetPlayerInterior(playerid) == GetPlayerInterior(i) && GetPlayerVirtualWorld_(playerid) == GetPlayerVirtualWorld_(i))
					{
						GetPlayerPos(i, posx, posy, posz);
						tempposx = (oldposx -posx);
						tempposy = (oldposy -posy);
						tempposz = (oldposz -posz);
						if (((tempposx < radi/16) && (tempposx > -radi/16)) && ((tempposy < radi/16) && (tempposy > -radi/16)) && ((tempposz < radi/16) && (tempposz > -radi/16))) ms(i, col1, string);
						else if (((tempposx < radi/8) && (tempposx > -radi/8)) && ((tempposy < radi/8) && (tempposy > -radi/8)) && ((tempposz < radi/8) && (tempposz > -radi/8)))  ms(i, col2, string);
						else if (((tempposx < radi/4) && (tempposx > -radi/4)) && ((tempposy < radi/4) && (tempposy > -radi/4)) && ((tempposz < radi/4) && (tempposz > -radi/4)))  ms(i, col3, string);
						else if (((tempposx < radi/2) && (tempposx > -radi/2)) && ((tempposy < radi/2) && (tempposy > -radi/2)) && ((tempposz < radi/2) && (tempposz > -radi/2)))  ms(i, col4, string);
						else if (((tempposx < radi) && (tempposx > -radi)) && ((tempposy < radi) && (tempposy > -radi)) && ((tempposz < radi) && (tempposz > -radi))) ms(i, col5, string);
					}
				}
				else
				{
				    // se eu tiver na arena //
					if(player_arena[playerid] == 1)
					{
					new ccc = id[playerid];
				    if(ccc != -1)
					{
				       if(GetPlayerInterior(i) == Conta[playerid][c_Interior] && GetPlayerVirtualWorld_(i) == Conta[playerid][c_Mundo])
				       {
				            if(IsPlayerInRangeOfPoint(i, radi, Conta[playerid][c_X], Conta[playerid][c_Y], Conta[playerid][c_Z]))
				            {
				                ms(i, 4, string);
				            }
				       }
						}
					}
				    else
					{
					new ccc = id[i];
					if(ccc != -1)
					{
				       		if(GetPlayerInterior(playerid) == Conta[i][c_Interior] && GetPlayerVirtualWorld_(playerid) == Conta[i][c_Mundo])
				       	{
				            if(IsPlayerInRangeOfPoint(playerid, radi, Conta[i][c_X], Conta[i][c_Y], Conta[i][c_Z]))
				            {
				                ms(i, 4, string);
				            }
				       	}
					}
				    }
				}
			}
		}
	}
	return 0;
}

public OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{
    if(logado[playerid] == 0) return 1;
	new entrar = 1;
    if(ModoAdmin[playerid] == 0)
	{
	    if(Travado(vehicleid))
		{
			Parar_Anim(playerid);
			GameTextForPlayer(playerid, "~y~VEICULO FECHADO", 1500, 4);
			entrar = 0;
		}
	}

	new idv = Info_Veiculo[vehicleid];
	if(idv != -1)
	{
		if(escada_veiculo[vehicleid] > -1)
		{
		    Parar_Anim(playerid);
			MS(playerid, 0, "Nao e possivel entrar no veiculo enquanto opera a escada !");
			entrar = 0;
		}
	}

	if(imobilizado[playerid] == 1)
	{
	    Parar_Anim(playerid);
		MS(playerid, 0, "Voce esta imobilizado, nao pode fazer isso agora !");
		mostrar_tazer(playerid);
		entrar = 0;
	}

	if(carro_com_explosivo(vehicleid))
	{
	    Parar_Anim(playerid);
		MS(playerid, 0, "Este carro forte esta sendo assaltado, nao e possivel entrar !");
		entrar = 0;
	}

	if(segurando_player[playerid] != -1)
	{
		Parar_Anim(playerid);
		MS(playerid, 0, "Voce nao pode entrar em um veiculo segurando alguma coisa !");
		entrar = 0;
	}

	if(player_rendido[playerid] == 1)
	{
		Parar_Anim(playerid);
		MS(playerid, 0, "Voce nao pode entrar em um veiculo enquanto estiver rendido !");
		entrar = 0;
	}

	if(player_algemado[playerid] == 1)
	{
		Parar_Anim(playerid);
		MS(playerid, 0, "Voce nao pode entrar em um veiculo enquanto estiver algemado !");
		entrar = 0;
	}

	if(player_amarrado[playerid] == 1)
	{
		Parar_Anim(playerid);
		MS(playerid, 0, "Voce nao pode entrar em um veiculo enquanto estiver amarrado !");
		entrar = 0;
	}

	if(em_anim[playerid] != 0)
	{
		Parar_Anim(playerid);
		em_anim[playerid] = 0;
		MS(playerid, 0, "A animacao foi cancelada ao tentar entrar em um veiculo !");
		entrar = 0;
	}

	new i = ID_Dancando[playerid];
	if(i != -1)
	{
		Parar_Anim(playerid);
		MS(playerid, 0, "Voce nao pode entrar em um veiculo enquanto danca !");
        ApplyAnimation(playerid, Dancas[i][1], Dancas[i][2], 4.1, true, true, true, true, 0, 1);
        entrar = 0;
	}

	if(academia_player[playerid] != -1)
	{
	    new ii = academia_player[playerid];
		new tipo = Academia[ii][aca_Tipo];
		colocar_no_aparelho(playerid, ii, tipo);
		MS(playerid, 0, "Voce nao pode entrar em um veiculo enquanto treina !");
		entrar = 0;
	}

	if(player_cinuca[playerid] != -1)
	{
	    Parar_Anim(playerid);
	    MS(playerid, 0, "Voce nao pode entrar em um veiculo enquanto joga Sinuca !");
		entrar = 0;
	}

	if(Barra[playerid][b_Acao] != 0)
	{
	    Parar_Anim(playerid);
	    MS(playerid, 0, "Voce nao pode entrar em um veiculo no momento !");
	    if(Barra[playerid][b_Anim] != 0) ApplyAnimation(playerid, Barra[playerid][b_Anim1], Barra[playerid][b_Anim2], 4.1, Barra[playerid][b_Lop], false, false, false, 0, 1);
		entrar = 0;
	}

	if(ispassenger == 0)
	{
		if(tem_motorista(vehicleid))
		{
		    Parar_Anim(playerid);
			MS(playerid, 0, "Este veiculo ja tem um condutor, nao e possivel entrar como motorista ou piloto !");
			entrar = 0;
		}
	}

	if(entrar == 1)
	{
	    if(Scripter(playerid))
	    {
	        if(ispassenger == 0)
			{
			    new acento = pegar_acento_disponivel(vehicleid);
				if(acento == 0) PutPlayerInVehicle(playerid, vehicleid, 0);
			}
	        else
	        {
	            new acento = pegar_acento_disponivel(vehicleid, 1);
	            if(acento != -1)
	            {
	                PutPlayerInVehicle(playerid, vehicleid, acento);
	            }
	        }
	    }
	}

	return 1;
}

stock PlayerEmVeiculo(p, vehicleid)
{
	if(GetVehicleModel(vehicleid) != 0)
	{
	    if(Online(p))
	    {
	        if(IsPlayerInAnyVehicle(p))
	        {
	            if(GetPlayerVehicleID(p) == vehicleid)
	            {
					return GetPlayerVehicleSeat(p);
	            }
	        }
	    }
    }
	return -1;
}


stock pegar_acento_disponivel(vehicleid, con=0)
{
	new model = GetVehicleModel(vehicleid);
	if(model != 0)
	{
	    if(model-400 >= 0 && model-400 < sizeof acentos)
	    {
		    new idd = model-400;
		    if(acentos[idd] == 1)
		    {
		        if(con == 0)
		        {
		            foreach(new p:Player) if(PlayerEmVeiculo(p, vehicleid) == 0) return -1;
					return 0;
		        }
		        return -1;
		    }
		    if(acentos[idd] == 2)
		    {
		        new acen;
		        if(con == 0)
		        {
		            acen = 0;
		            foreach(new p:Player) if(PlayerEmVeiculo(p, vehicleid) == 0) acen = -1;
		        }
		        else
		        {
		            acen = 0;
		            foreach(new p:Player) if(PlayerEmVeiculo(p, vehicleid) == 1) acen = -1;
		        }
		        return acen;
		    }
		    else
		    {
		        new ta;
				for(new a; a<4; a++)
				{
				if(acentos[idd] >= a+1)
				{
					ta = 0;
						if(a == 0 && con == 1) continue;
						foreach(new p:Player) if(PlayerEmVeiculo(p, vehicleid) == a) ta = 1;
						if(ta == 0) return a;
					}
			    }
			    return -1;
			}
		}
	}
	return -1;
}

public OnPlayerExitVehicle(playerid, vehicleid)
{
    if(logado[playerid] == 0) return 1;
	new veic = vehicleid;
	new oldstate = acento_veiculo[playerid];
    if(GetVehicleModel(veic) == 578)
    {
        new v = Info_Veiculo[veic];
        if(v != -1)
        {
            if(Veiculo[v][v_Emprego] == 11)
            {
	            new Float:p[4];
				GetVehiclePos(veic, p[0], p[1], p[2]);
				GetVehicleZAngle(veic, p[3]);
				PegarFrente(p[0], p[1], p[3], 3.2);
	            if(oldstate == PLAYER_STATE_DRIVER) p[3] += 90.0;
	            if(oldstate == PLAYER_STATE_PASSENGER)  p[3] -= 90.0;
	            if(p[3] < 0.0) p[3] += 360.0;
	            if(p[3] > 360.0) p[3] -= 360.0;
	            PegarFrente(p[0], p[1], p[3], 2.1);
	            SetPlayerPos_(playerid, p[0], p[1], p[2]-0.3);
            }
        }
    }
	return 1;
}

public OnPlayerStateChange(playerid, newstate, oldstate)
{
    if(logado[playerid] == 0) return 1;
    // salvar em qual veiculo ta //
    if(newstate == PLAYER_STATE_DRIVER || newstate == PLAYER_STATE_PASSENGER || menu_id[playerid] != -1 || inv_novo_aberto[playerid] == 1)
	{
	    ////TextDrawHideForPlayer(playerid, T_Item_Perto[0]);
	    em_veiculo[playerid] = GetPlayerVehicleID(playerid);
	    if(newstate == PLAYER_STATE_DRIVER)
	    {
	        if(GetVehicleModel(em_veiculo[playerid]) == 578)
	        {
	            caminhao_player[playerid] = GetPlayerVehicleID(playerid);
	        }
	    }
		acento_veiculo[playerid] = newstate;
	}
	else Streamer_Update(playerid);
    new veic = em_veiculo[playerid];

    // sistema de tv //
    if(newstate == PLAYER_STATE_DRIVER || newstate == PLAYER_STATE_PASSENGER)
	{
	    foreach(new i:Player)
	    {
	        if(Online(i))
	        {
				if(tv_player[i] == playerid)
				{
				    PlayerSpectateVehicle(i, veic);
				}
	        }
	    }
	}
	else
	{
	    foreach(new i:Player)
	    {
	        if(Online(i))
	        {
				if(tv_player[i] == playerid)
				{
				    PlayerSpectatePlayer(i, playerid);
				}
	        }
	    }
	}



    // desocupar veiculo //
    if(oldstate == PLAYER_STATE_DRIVER || oldstate == PLAYER_STATE_PASSENGER )
    {
        if(GetVehicleModel(veic) == 578)
        {
            new v = Info_Veiculo[veic];
            if(v != -1)
            {
                if(Veiculo[v][v_Emprego] == 11)
                {
		            new Float:p[4];
					GetVehiclePos(veic, p[0], p[1], p[2]);
					GetVehicleZAngle(veic, p[3]);
					PegarFrente(p[0], p[1], p[3], 3.2);
		            if(oldstate == PLAYER_STATE_DRIVER) p[3] += 90.0;
		            if(oldstate == PLAYER_STATE_PASSENGER)  p[3] -= 90.0;
		            if(p[3] < 0.0) p[3] += 360.0;
		            if(p[3] > 360.0) p[3] -= 360.0;
		            PegarFrente(p[0], p[1], p[3], 2.1);
		            SetPlayerPos_(playerid, p[0], p[1], p[2]-0.3);
	            }
            }
        }

        if(veic != -1)
        {
	        if(GetVehicleModel(veic) != 0)
	        {
	            new desocupado = 1;
	            new inf = Info_Veiculo[veic];
	            if(inf != -1)
	            {
	                foreach(new a:Player)
	                {
	                    if(a != playerid)
	                    {
		                    if(Online(a))
		                    {
		                        if(IsPlayerInAnyVehicle(a))
		                        {
		                            if(GetPlayerVehicleID(a) == veic)
		                            {
		                                desocupado = 0;
		                            }
		                        }
		                    }
	                    }
	                }
	            }
	            if(desocupado == 1)
				{
				    veiculo_desoculpado[veic] = 1;
					veiculo_desoculpado_tempo[veic] = 0;
				}
	            else
				{
					veiculo_desoculpado[veic] = 0;
					veiculo_desoculpado_tempo[veic] = 0;
				}
	        }
		}
    }

    // menssagem quando entra em veiculo //
	if(newstate == PLAYER_STATE_DRIVER)
	{
	    new car = GetPlayerVehicleID(playerid);
	    if(VeiculoBicicleta(car)) SetVehicleParamsEx_(car, 1, 0, 0, 0, 0, 0, 0);
        else SetVehicleParamsEx_(car, motor[car], farol[car], 0, 0, capo[car], malas[car], 0);
        veiculo_desoculpado[car] = 0;
        veiculo_desoculpado_tempo[car] = 0;

		// emprego coleta de lixo //
		if(EmpregoPlayer(playerid) == 8)
		{
		    new i = Info_Veiculo[car];
		    if(i != -1)
		    {
		        if(Veiculo[i][v_Emprego] == 8)
		        {
		            marcar_lixo(playerid, i);
		        }
		    }
		}

     	// entregador //
	    if(EmpregoPlayer(playerid) == 7)
	    {
	        if(NotaPlayer(playerid) != -1)
	        {
		        if(GetVehicleModel(car) != 530)
		        {
		        	if(Info_Veiculo[car] != -1)
			    	{
			    	    new i = Info_Veiculo[car];
				    if(Veiculo[i][v_Emprego] == 7)
					{
				        if(emp_veiculo[i] == entregas[NotaPlayer(playerid)][ec_Tipo])
				        {
				            new e = NotaPlayer(playerid);
				            if(emp_m_veiculo[i] >= entregas[e][ec_Quantidade])
				            {
				                iniciar_entrega(playerid, e);
				            }
				        }
				    }
			    	}
			    }
		    }
	    }

	    // carro forte //
	    if(EmpregoPlayer(playerid) == 6)
	    {
		    if(Info_Veiculo[car] != -1)
		    {
		        new i = Info_Veiculo[car];
		        if(Veiculo[i][v_Emprego] == 6)
		        {
					if(malotes_veiculo[i] > 0 && CF_Etapa[playerid] < 3)
					{
						CF_Etapa[playerid] = 2;
					    GetPlayerPos(playerid, CF_Pos[playerid][0], CF_Pos[playerid][1], CF_Pos[playerid][2]);
					    procurar_caixa_eletronico(playerid);
					}
		        }
		    }
	    }

	    // teste da auto escola //
	    if(TestePlayer[playerid] != -1)
	    {
	        new tipo = TestePlayer[playerid];
		    if(VeiculoTeste[playerid] == car)
		    {
                if(FaseTeste[playerid] == -1)
                {
                    FaseTeste[playerid] = 0;
				SetVehicleParamsEx_(car,1,1,0,0,0,0,0);

					// teste de moto //
					if(tipo == 0) SetPlayerRaceCheckpoint(playerid, 0, PosTestesMoto[0][0],PosTestesMoto[0][1],PosTestesMoto[0][2], PosTestesMoto[1][0],PosTestesMoto[1][1],PosTestesMoto[1][2], 4);
				// teste de carro //
				if(tipo == 1) SetPlayerRaceCheckpoint(playerid, 0, PosTestesCarro[0][0],PosTestesCarro[0][1],PosTestesCarro[0][2], PosTestesCarro[1][0],PosTestesCarro[1][1],PosTestesCarro[1][2], 4);
				// teste de caminhao //
				if(tipo == 2) SetPlayerRaceCheckpoint(playerid, 0, PosTestesCaminhao[0][0],PosTestesCaminhao[0][1],PosTestesCaminhao[0][2], PosTestesCaminhao[1][0],PosTestesCaminhao[1][1],PosTestesCaminhao[1][2], 4);
					// teste de aviao //
				if(tipo == 3) SetPlayerRaceCheckpoint(playerid, 0, PosTestesAviao[0][0],PosTestesAviao[0][1],PosTestesAviao[0][2], PosTestesAviao[1][0],PosTestesAviao[1][1],PosTestesAviao[1][2], 4);
		        }
		        return 1;
		    }
	    }

		if(!VeiculoBicicleta(car) && Veiculo_RC[car] == -1) ms(playerid, 3, "Aperte Y para Ligar ou Desligar o motor, use /ajudaveiculo para ver os comandos.");
		new idx = Info_Veiculo[car];
		if(idx != -1)
		{
		    if(ModoAdmin[playerid] == 0)
		    {
			    if(Veiculo[idx][v_Emprego] != -1)
				{
				if(EmpregoPlayer(playerid) != Veiculo[idx][v_Emprego])
				{
				    new string[150];
				    format(string, 150, "Este veiculo pertence ao emprego '%s', voce nao pode usa-lo !", Emprego[Veiculo[idx][v_Emprego]][e_Nome]);
				    RemovePlayerFromVehicle(playerid);
				    MS(playerid, 0, string);
				}
			    }

			    if(Veiculo[idx][v_Org] != -1)
				{
				if(OrgPlayer(playerid) != Veiculo[idx][v_Org])
				{
				    new string[150];
				    format(string, 150, "Este veiculo pertence a Org '%s', voce nao pode usa-lo !", Org[Veiculo[idx][v_Org]][o_Nome]);
				    RemovePlayerFromVehicle(playerid);
				    MS(playerid, 0, string);
				}
				else
				{
				    new c = id[playerid];
				    if(c != -1)
					{
				        if(Conta[playerid][c_Cargo] < Veiculo[idx][v_Cargo])
				        {
				            new string[150];
						    format(string, 150, "Voce precisa ser '%s' da Organizacao para usar este veiculo !", nome_cargo(Veiculo[idx][v_Cargo],Veiculo[idx][v_Org]));
						    RemovePlayerFromVehicle(playerid);
						    MS(playerid, 0, string);
				        }
				    }
				}
			    }
		    }
		}
	}

	// quando entrar no uber que pediu //
	if(newstate == PLAYER_STATE_PASSENGER)
	{
	    new car = GetPlayerVehicleID(playerid);
	    veiculo_desoculpado[car] = 0;
	    veiculo_desoculpado_tempo[car] = 0;

	    if(Uber[playerid][uber_Status] == 2)
	    {
	        if(car == Uber[playerid][uber_Veiculo])
	        {
	            Uber[playerid][uber_Status] = 3;
	            if(Online(Uber[playerid][uber_Motorista]))
	            {
	                new idd = Uber[playerid][uber_Motorista];
	                ms(idd, 3, "O passageiro acabou de entrar no veiculo, a corrida foi iniciada.");
	                ms(playerid, 3, "Voce entrou no veiculo do Uber, a corrida foi iniciada.");
	                ms(playerid, 3, "Caso saia do veiculo a corrida sera cancelada automaticamente.");
	                Localizar_Player(idd, Uber[playerid][uber_DX], Uber[playerid][uber_DY], Uber[playerid][uber_DZ], 666, playerid, "DESTINO");
	                Localizar_Player(playerid, Uber[playerid][uber_DX], Uber[playerid][uber_DY], Uber[playerid][uber_DZ], 5165413, idd, "DESTINO");
	            }
	        }
	    }
	}

	// velocimetro //
	if(newstate == PLAYER_STATE_DRIVER ) mostrar_velocimetro(playerid);
	else
	{
		esconder_velocimetro(playerid);
	}

	// nao ta mais em veiculo //
	if(newstate != PLAYER_STATE_DRIVER && newstate != PLAYER_STATE_PASSENGER ) em_veiculo[playerid] = -1;
	return 1;
}

public OnPlayerEnterCheckpoint(playerid)
{
    if(logado[playerid] == 0) return 1;
    if(VR_ChegouCheckpoint(playerid)) return 1;
    if(IFOOD_CP[playerid] == 1)
    {
        IFOOD_DestroyNPC(playerid);
        DisablePlayerCheckpoint(playerid);
        IFOOD_ShowDeliveryPrompt(playerid);
        ms(playerid,1,"Cliente por perto! Use /entregarifood.");
        return 1;
    }
    if(IFOOD_CP[playerid] == 2)
    {
        DisablePlayerCheckpoint(playerid); IFOOD_CP[playerid] = 0;
        ms(playerid,0,"Chegou ao McDonald's! Use /pegarlanches para pegar mais entregas.");
        return 1;
    }
    if(Localizando[playerid] != -1) Localizar_Player(playerid, 0, 0, 0, 99999);
    if(CheckMarcado[playerid] == 1)
	{
        DisablePlayerRaceCheckpoint(playerid);
        DisablePlayerCheckpoint(playerid);
		PlayerPlaySound(playerid,1083,0.0,0.0,0.0);
        GameTextForPlayer(playerid, "~w~Checkpoint ~r~Desmarcado", 1200, 4);
        CheckMarcado[playerid] = 0;
	}
	return 1;
}

public OnPlayerEnterRaceCheckpoint(playerid)
{
    if(logado[playerid] == 0) return 1;
    if(CheckMarcado[playerid] == 1)
	{
        DisablePlayerRaceCheckpoint(playerid);
        DisablePlayerCheckpoint(playerid);
		PlayerPlaySound(playerid,1083,0.0,0.0,0.0);
        GameTextForPlayer(playerid, "~w~Checkpoint ~r~Desmarcado", 1200, 4);
        CheckMarcado[playerid] = 0;
	}
    new tipo = TestePlayer[playerid];
	new fase = FaseTeste[playerid];
	if(tipo != -1 && fase != -1)
	{
	    // teste de moto //
	    if(tipo == 0)
	    {
            if(IsPlayerInAnyVehicle(playerid))
			{
			    // ultimo check point //
			    if(fase == (sizeof(PosTestesMoto)-1))
		    	{
		    	    cancelar_teste(playerid, 1);
		    	    DisablePlayerRaceCheckpoint(playerid);
				return 1;
			    }
			    if(PosTestesMoto[fase][4] == 1.0)
				{
				// se for chekc point de congelar //
					Congelar(playerid);
					CongeladoTeste[playerid] = 6;
					DisablePlayerRaceCheckpoint(playerid);
			    }
			    else
				{
				// checkpoint normal //
				FaseTeste[playerid] ++;
				if(FaseTeste[playerid] < (sizeof(PosTestesMoto)-1))
                    {
					if(PosTestesMoto[FaseTeste[playerid]][3] == 1.0) SetPlayerRaceCheckpoint(playerid, 2, PosTestesMoto[FaseTeste[playerid]][0],PosTestesMoto[FaseTeste[playerid]][1],PosTestesMoto[FaseTeste[playerid]][2], PosTestesMoto[FaseTeste[playerid]+1][0],PosTestesMoto[FaseTeste[playerid]+1][1],PosTestesMoto[FaseTeste[playerid]+1][2], 2);
					else SetPlayerRaceCheckpoint(playerid, 0, PosTestesMoto[FaseTeste[playerid]][0],PosTestesMoto[FaseTeste[playerid]][1],PosTestesMoto[FaseTeste[playerid]][2], PosTestesMoto[FaseTeste[playerid]+1][0],PosTestesMoto[FaseTeste[playerid]+1][1],PosTestesMoto[FaseTeste[playerid]+1][2],  2);
				}
					else SetPlayerRaceCheckpoint(playerid, 1, PosTestesMoto[FaseTeste[playerid]][0],PosTestesMoto[FaseTeste[playerid]][1],PosTestesMoto[FaseTeste[playerid]][2], PosTestesMoto[FaseTeste[playerid]][0],PosTestesMoto[FaseTeste[playerid]][1],PosTestesMoto[FaseTeste[playerid]][2],  2);
				}
			}
			else SetPlayerRaceCheckpoint(playerid, 2, PosTestesMoto[fase][0],PosTestesMoto[fase][1],PosTestesMoto[fase][2], PosTestesMoto[fase][0],PosTestesMoto[fase][1],PosTestesMoto[fase][2], 2);
	    }

	    // teste de carro //
	    if(tipo == 1)
	    {
			if(IsPlayerInAnyVehicle(playerid))
			{
			    // ultimo check point //
			    if(fase == (sizeof(PosTestesCarro)-1))
		    	{
		    	    cancelar_teste(playerid, 1);
		    	    DisablePlayerRaceCheckpoint(playerid);
				return 1;
			    }
			    if(PosTestesCarro[fase][4] == 1.0)
				{
				// se for chekc point de congelar //
					Congelar(playerid);
					CongeladoTeste[playerid] = 6;
					DisablePlayerRaceCheckpoint(playerid);
			    }
			    else
				{
				// checkpoint normal //
				FaseTeste[playerid] ++;
				if(FaseTeste[playerid] < (sizeof(PosTestesCarro)-1))
                    {
					if(PosTestesCarro[FaseTeste[playerid]][3] == 1.0) SetPlayerRaceCheckpoint(playerid, 2, PosTestesCarro[FaseTeste[playerid]][0],PosTestesCarro[FaseTeste[playerid]][1],PosTestesCarro[FaseTeste[playerid]][2], PosTestesCarro[FaseTeste[playerid]+1][0],PosTestesCarro[FaseTeste[playerid]+1][1],PosTestesCarro[FaseTeste[playerid]+1][2], 5);
					else SetPlayerRaceCheckpoint(playerid, 0, PosTestesCarro[FaseTeste[playerid]][0],PosTestesCarro[FaseTeste[playerid]][1],PosTestesCarro[FaseTeste[playerid]][2], PosTestesCarro[FaseTeste[playerid]+1][0],PosTestesCarro[FaseTeste[playerid]+1][1],PosTestesCarro[FaseTeste[playerid]+1][2], 5);
				}
					else SetPlayerRaceCheckpoint(playerid, 1, PosTestesCarro[FaseTeste[playerid]][0],PosTestesCarro[FaseTeste[playerid]][1],PosTestesCarro[FaseTeste[playerid]][2], PosTestesCarro[FaseTeste[playerid]][0],PosTestesCarro[FaseTeste[playerid]][1],PosTestesCarro[FaseTeste[playerid]][2], 5);
				}
			}
			else SetPlayerRaceCheckpoint(playerid, 2, PosTestesCarro[fase][0],PosTestesCarro[fase][1],PosTestesCarro[fase][2], PosTestesCarro[fase][0],PosTestesCarro[fase][1],PosTestesCarro[fase][2], 2);
	    }

	    // teste de caminhao //
	    if(tipo == 2)
	    {
			if(IsPlayerInAnyVehicle(playerid))
			{
			    // ultimo check point //
			    if(fase == (sizeof(PosTestesCaminhao)-1))
		    	{
		    	    cancelar_teste(playerid, 1);
		    	    DisablePlayerRaceCheckpoint(playerid);
				return 1;
			    }
			    if(PosTestesCaminhao[fase][4] == 1.0)
				{
				// se for chekc point de congelar //
					Congelar(playerid);
					CongeladoTeste[playerid] = 6;
					DisablePlayerRaceCheckpoint(playerid);
			    }
			    else
				{
				// checkpoint normal //
				FaseTeste[playerid] ++;
				if(FaseTeste[playerid] < (sizeof(PosTestesCaminhao)-1))
                    {
					if(PosTestesCaminhao[FaseTeste[playerid]][3] == 1.0) SetPlayerRaceCheckpoint(playerid, 2, PosTestesCaminhao[FaseTeste[playerid]][0],PosTestesCaminhao[FaseTeste[playerid]][1],PosTestesCaminhao[FaseTeste[playerid]][2], PosTestesCaminhao[FaseTeste[playerid]+1][0],PosTestesCaminhao[FaseTeste[playerid]+1][1],PosTestesCaminhao[FaseTeste[playerid]+1][2], 5);
					else SetPlayerRaceCheckpoint(playerid, 0, PosTestesCaminhao[FaseTeste[playerid]][0],PosTestesCaminhao[FaseTeste[playerid]][1],PosTestesCaminhao[FaseTeste[playerid]][2],PosTestesCaminhao[FaseTeste[playerid]+1][0],PosTestesCaminhao[FaseTeste[playerid]+1][1],PosTestesCaminhao[FaseTeste[playerid]+1][2], 2);
				}
					else SetPlayerRaceCheckpoint(playerid, 1, PosTestesCaminhao[FaseTeste[playerid]][0],PosTestesCaminhao[FaseTeste[playerid]][1],PosTestesCaminhao[FaseTeste[playerid]][2],  PosTestesCaminhao[FaseTeste[playerid]][0],PosTestesCaminhao[FaseTeste[playerid]][1],PosTestesCaminhao[FaseTeste[playerid]][2], 2);
				}
			}
			else SetPlayerRaceCheckpoint(playerid, 2, PosTestesCaminhao[fase][0],PosTestesCaminhao[fase][1],PosTestesCaminhao[fase][2], PosTestesCaminhao[FaseTeste[playerid]+1][0],PosTestesCaminhao[FaseTeste[playerid]+1][1],PosTestesCaminhao[FaseTeste[playerid]+1][2], 2);
	    }

	    // teste de aviao //
	    if(tipo == 3)
	    {
            if(IsPlayerInAnyVehicle(playerid))
			{
			    // ultimo check point //
			    if(fase == (sizeof(PosTestesAviao)-1))
		    	{
		    	    cancelar_teste(playerid, 1);
		    	    DisablePlayerRaceCheckpoint(playerid);
				return 1;
			    }
			    else
				{
				// checkpoint normal //
				FaseTeste[playerid] ++;
				if(FaseTeste[playerid] < (sizeof(PosTestesAviao)-1))
                    {
                        new ft = FaseTeste[playerid];
					if(ft > 3 && ft < (sizeof(PosTestesAviao)-3)) SetPlayerRaceCheckpoint(playerid, 3, PosTestesAviao[FaseTeste[playerid]][0],PosTestesAviao[FaseTeste[playerid]][1],PosTestesAviao[FaseTeste[playerid]][2], PosTestesAviao[FaseTeste[playerid]+1][0],PosTestesAviao[FaseTeste[playerid]+1][1],PosTestesAviao[FaseTeste[playerid]+1][2], 8);
						else SetPlayerRaceCheckpoint(playerid, 0, PosTestesAviao[FaseTeste[playerid]][0],PosTestesAviao[FaseTeste[playerid]][1],PosTestesAviao[FaseTeste[playerid]][2], PosTestesAviao[FaseTeste[playerid]+1][0],PosTestesAviao[FaseTeste[playerid]+1][1],PosTestesAviao[FaseTeste[playerid]+1][2], 8);
					}
					else SetPlayerRaceCheckpoint(playerid, 1, PosTestesAviao[FaseTeste[playerid]][0],PosTestesAviao[FaseTeste[playerid]][1],PosTestesAviao[FaseTeste[playerid]][2], PosTestesAviao[FaseTeste[playerid]][0],PosTestesAviao[FaseTeste[playerid]][1],PosTestesAviao[FaseTeste[playerid]][2], 8);
				}

			}
			else SetPlayerRaceCheckpoint(playerid, 2, PosTestesAviao[fase][0],PosTestesAviao[fase][1],PosTestesAviao[fase][2], PosTestesAviao[fase][0],PosTestesAviao[fase][1],PosTestesAviao[fase][2], 8);
	    }

	    return 1;
	}

	return 1;
}

stock NomeVeiculo(modelo)
{
	new nomeveh[80];
	modelo -= 400;
	format(nomeveh, 80, "Nenhum");
	if(modelo > -1 && modelo < 212) format(nomeveh, 80, info_veiculos[modelo][veh_Nome]);
	return nomeveh;
}


stock AddVehicleComponentEx_x(vehicleid, componentid)
{
    new Varz = InitComponents(componentid);
    new i  = Info_Veiculo[vehicleid];
    if(i != -1)
    {
        switch(Varz)
        {
        	case 1: TuningVeiculo[i][0] = componentid;
            case 2: TuningVeiculo[i][1] = componentid;
            case 3: TuningVeiculo[i][2] = componentid;
            case 4: TuningVeiculo[i][3] = componentid;
            case 5: TuningVeiculo[i][4] = componentid;
            case 6: TuningVeiculo[i][5] = componentid;
            case 7: TuningVeiculo[i][6] = componentid;
            case 8: TuningVeiculo[i][7] = componentid;
            case 9: TuningVeiculo[i][8] = componentid;
            case 10: TuningVeiculo[i][9] = componentid;
            case 11: TuningVeiculo[i][10] = componentid;
            case 12: TuningVeiculo[i][11] = componentid;
            case 13: TuningVeiculo[i][12] = componentid;
            case 14: TuningVeiculo[i][13] = componentid;
            case 15: TuningVeiculo[i][14] = componentid;
            case 16: TuningVeiculo[i][15] = componentid;
            case 17: TuningVeiculo[i][16] = componentid;
        }
        AddVehicleComponent(vehicleid, componentid);
    }
}

stock InitComponents(componentid)
{
	new i;
 	for(i=0; i<20; i++) if(spoiler[i][0]==componentid)  return 1;
	for(i=0; i<3; i++) if(nitro[i][0]==componentid) return 2;
	for(i=0; i<23; i++) if(fbumper[i][0]==componentid) return 3;
 	for(i=0; i<22; i++) if(rbumper[i][0]==componentid) return 4;
	for(i=0; i<28; i++) if(exhaust[i][0]==componentid) return 5;
	for(i=0; i<2; i++) if(bventr[i][0]==componentid) return 6;
    for(i=0; i<2; i++) if(bventl[i][0]==componentid) return 7;
    for(i=0; i<4; i++) if(bscoop[i][0]==componentid) return 8;
    for(i=0; i<13; i++) if(rscoop[i][0]==componentid) return 9;
    for(i=0; i<21; i++) if(lskirt[i][0]==componentid) return 10;
    for(i=0; i<21; i++) if(rskirt[i][0]==componentid) return 11;
	if(hydraulics[0][0]==componentid) return 12;
	if(base[0][0]==componentid) return 13;
	for(i=0; i<2; i++) if(rbbars[i][0]==componentid) return 14;
	for(i=0; i<2; i++) if(fbbars[i][0]==componentid) return 15;
	for(i=0; i<17; i++) if(wheels[i][0]==componentid) return 16;
	for(i=0; i<2; i++) if(lightss[i][0]==componentid) return 17;
	return 0;
}

stock ChangeVehicleColorEx(vehicleid, color1, color2)
{
	if(GetVehicleModel(vehicleid) != 0)
	{
	    new idv = Info_Veiculo[vehicleid];
		if(idv != -1)
		{
		    Veiculo[idv][v_Cor1] = color1;
		    Veiculo[idv][v_Cor2] = color2;
		    SalvarVeiculo(vehicleid);
	    }
	    ChangeVehicleColor(vehicleid, color1, color2);
    }
}

BCG:: Mundo(playerid)
{
    SetPlayerVirtualWorld(playerid, mundo_player[playerid]);
}

stock GetPlayerVirtualWorld_(playerid)
{
	new mund = GetPlayerVirtualWorld(playerid);
	if(mundo_player[playerid] == mund) return mund;
	else return mundo_player[playerid];
}

stock SetPlayerVirtualWorld_(playerid, mund)
{
	if(IsPlayerConnected(playerid))
	{
        SetPlayerVirtualWorld(playerid, mund);
        mundo_player[playerid] = mund;
	}
}

stock debug_mundo(playerid, temp=3000)
{
    KillTimer(timer_mundo[playerid]);
	timer_mundo[playerid] = SetTimerEx("Mundo", temp+600, false, "d", playerid);
	SetPlayerVirtualWorld(playerid, 12345+playerid);
}

stock OnPlayerInteriorChangeEx(playerid, newinteriorid, oldinteriorid, temp=3000, con=0)
{
    #pragma unused newinteriorid, oldinteriorid
    if(id[playerid] == -1) return 1;
    Congelar(playerid, con);
	mostrar_territorios(playerid);
	KillTimer(timer_descon[playerid]);
	timer_descon[playerid] = SetTimerEx("Descongelar", temp, false, "d", playerid);
	GameTextForPlayer(playerid, "~y~CARREGANDO", temp, 3);
	return 1;
}

public OnPlayerInteriorChange(playerid, newinteriorid, oldinteriorid)
{
    if(logado[playerid] == 0) return 1;
    OnPlayerInteriorChangeEx(playerid, newinteriorid, oldinteriorid);
	return 1;
}

public OnPlayerKeyStateChange(playerid, newkeys, oldkeys)
{
    if(logado[playerid] == 0) return 1;
    
    // tecla H abrir bau //
    // (movido para OnPlayerKeyStateChange2 junto com o porta-malas)
    
    if(Apertou(KEY_FIRE | KEY_AIM))
    {
        new Float:x, Float:y, Float:z;
        GetPlayerPos(playerid, x, y, z);
        if(GetPlayerWeapon(playerid) >= 16 && !PlayerCop(playerid)){
            for(new ip; ip < MAX_PLAYERS; ip++){
                if(PlayerCop(ip)){
                    if(CheckMarcado[ip] == 0){
                        SSM(playerid, -1, "{0000FF}[QRR - POLICIA] {E5EEFD}Um disparo foi efetuado na localizacao no mapa > {0000FF}[QRR - POLICIA] ");
                    }
                    SetPlayerCheckpoint(ip, x,y,z, 1);
                    GameTextForPlayer(ip, "~w~Disparo ~r~permanecem.", 1200, 4);
                    CheckMarcado[ip] = 1;
                }
            }
        }
    }
    if(newkeys == KEY_YES) // tecla Y //
	{
	    // cinucas //
	    if(player_cinuca[playerid] == -1)
	    {
	        if(GetPVarInt(playerid, "flood_cin") < gettime())
	        {
	            SetPVarInt(playerid, "flood_cin", gettime()+1);
				for(new i; i<MAX_CINUCAS; i++)
				{
				    if(Cinuca[i][ci_Existe] == 1)
					{
					if(IsPlayerInRangeOfPoint(playerid, 3, Cinuca[i][ci_X], Cinuca[i][ci_Y], Cinuca[i][ci_Z]))
						{
							if(Cinuca[i][ci_Partida] == 0)
							{
							if(cinuca_convidou[playerid] != -1)
							{
							    if(Online(playerid))
								{
							        if(id[cinuca_convidou[playerid]] != -1)
							        {
							        	iniciar_partida(i, cinuca_convidou[playerid], playerid);
							        	ms(cinuca_convidou[playerid], 1, "O convite foi aceito, a partida comecou !");
							        	ms(playerid, 3, "Voce aceitou o convite, a partida comecou !");
							        	ms(playerid, 3, "Caso queira desistir da partida, aperte Y proximo a mesa de sinuca !");
							        	ms(cinuca_convidou[playerid], 3, "Caso queira desistir da partida, aperte Y proximo a mesa de sinuca !");
											ms(playerid, 3, "Use /placar para ver a pontuacao da partida.");
											ms(cinuca_convidou[playerid], 3, "Use /placar para ver a pontuacao da partida.");
										}
							    }
							}
							else
								{
								    ms(playerid, 2, "Convide um Jogador Proximo para uma partida !");
									PlayersPerto(playerid, 10, 16);
								}
							    return 1;
						    }
						    else
							{
							    ms(playerid, 0, "Esta sinuca ja esta em uso no momento !");
							    return 1;
							}
						}
				    }
				}
			}
		}
		else
		{
		    format(string_prox, 300, "** O jogador '%s' finalizou a partida de sinuca **", Nome(playerid));
			ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
		    acabar_partida_cinuca(player_cinuca[playerid]);
		}

	    new Float:p[3];
	    if(IsPlayerInAnyVehicle(playerid))
	    {
	        if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	        {
		        new v = GetPlayerVehicleID(playerid);
		        new i = Info_Veiculo[v];
		        if(i != -1)
		        {
					menu_vei(playerid, v);
					return 1;
		        }
			}
	    }
	    else
	    {
			if(GetPVarInt(playerid, "flood_chave") < gettime())
			{
			    SetPVarInt(playerid, "flood_chave", gettime()+1);
				foreach(new i:Iter_Casas)
				{
					if(Casa[i][casa_Dono] == id[playerid])
					{
						if(IsPlayerInRangeOfPoint(playerid, 1.7, Casa[i][casa_X1], Casa[i][casa_Y1], Casa[i][casa_Z1]))
						{
							if(Casa[i][casa_Chave] == 0)
							{
							    Casa[i][casa_Chave] = 1;
							    GameTextForPlayer(playerid, "~r~~h~CASA TRACADA", 1500, 3);
							    atualizar_casa(i);
							    salvar_casa(i);
								SetPVarInt(playerid, "flood_chave", gettime()+2);
							}
							else
							{
							    Casa[i][casa_Chave] = 0;
							    GameTextForPlayer(playerid, "~g~~h~CASA ABERTA", 1500, 3);
							    salvar_casa(i);
							    atualizar_casa(i);
								SetPVarInt(playerid, "flood_chave", gettime()+2);
							}
						}			
					}
				}			
			
				foreach(new a:Vehicles)
				{
		            if(GetVehicleModel(a) != 0)
		            {
		                new i = Info_Veiculo[a];
		                if(i != -1)
					{
							GetVehiclePos(a, p[0], p[1], p[2]);
							if(IsPlayerInRangeOfPoint(playerid, 1.7, p[0], p[1], p[2]))
							{
							    if(GetPlayerVirtualWorld_(playerid) == GetVehicleVirtualWorld(a))
								{
								if(Veiculo[i][v_Dono] != -1 && Veiculo[i][v_Dono] == id[playerid])
								{
										chaves_veiculo(playerid, i, a);
										return 1;
								}
								else
								{
										if(Veiculo[i][v_Org] != -1 && Veiculo[i][v_Org] == OrgPlayer(playerid))
									{
		                                    chaves_veiculo(playerid, i, a);
		                                    return 1;
									}
									else if(Veiculo[i][v_Emprego] != -1 && Veiculo[i][v_Emprego] == EmpregoPlayer(playerid))
									{
		                                    chaves_veiculo(playerid, i, a);
		                                    return 1;
									}
								}
							    }
							}
					}
		            }
		        }
	        }
	    }
	}

	// flood de keys //
    if(flood_keys(playerid, newkeys)) return 1;

	// prosseguir verificacao de keys //
	if(OnPlayerKeyStateChange2(playerid, newkeys) != -12345)
	{
		if(keys_que_floodam(newkeys))
    	{
		    floodkey[playerid] = 1;
		    KillTimer(timer_liberar_key[playerid]);
		    timer_liberar_key[playerid] = SetTimerEx("liberar_keys", 350, false, "d", playerid);
	    }
    }
	return 1;
}

BCG:: liberar_keys(playerid)
{
	floodkey[playerid] = 0;
	return 1;
}

stock keys_que_floodam(key)
{
    if(key == KEY_CROUCH) return 1;
    if(key == KEY_WALK) return 1;
    if(key == KEY_CTRL_BACK) return 1;
    if(key == KEY_NO) return 1;
    if(key == KEY_YES) return 1;
    if(key == KEY_SECONDARY_ATTACK) return 1;
	return 0;
}

stock flood_keys(playerid, key)
{
    if(floodkey[playerid] == 1)
    {
        if(key == KEY_CROUCH) return 1;
        if(key == KEY_WALK) return 1;
        if(key == KEY_CTRL_BACK) return 1;
        if(key == KEY_NO) return 1;
        if(key == KEY_YES) return 1;
        if(key == KEY_SECONDARY_ATTACK) return 1;
    }
	return 0;
}

stock OnPlayerKeyStateChange2(playerid, newkeys)
{
    new c = id[playerid];
    if(c == -1) return 1;
	if(Barra[playerid][b_Acao] == 0) if(congelado[playerid] == 1) return 1;
	if(Conta[playerid][c_Morto] != 0) return 1;
	if(imobilizado[playerid] == 1) return 1;

	// tecla H //
	if(newkeys == KEY_CROUCH)
	{
		// Vendedor de Roupas - deposito
		if(IsPlayerInRangeOfPoint(playerid, 5.0, 2111.8855, -1932.2644, 17.0425))
		{
		    if(VR_VerificarEmprego(playerid))
		    {
		        if(VR_Estoque[playerid] < MAX_ESTOQUE_VR)
		        {
		            for(new i; i<MAX_CASAS_VR; i++) VR_Cooldown[playerid][i] = 0;
		            VR_Estoque[playerid] = MAX_ESTOQUE_VR;
		            VR_EmServico[playerid] = 1;
		            ms(playerid, 0, f("Estoque pego! %d roupas. Va ate uma casa usar o GPS.", MAX_ESTOQUE_VR));
		            return 1;
		        }
		        else ms(playerid, 0, "Estoque ja cheio!");
		    }
		}

		if(IsPlayerInAnyVehicle(playerid))
		{
			if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
			{
		    	new idc = GetPlayerVehicleID(playerid);
		    	new sss[300];

			    // guardar veiculo //
			    new idf = Info_Veiculo[idc];
			    if(idf != -1)
				{
				    // verificar garagem de casa primeiro //
				    if(GetPVarInt(playerid, "flood_garagem") < gettime())
				    {
				        foreach(new ca:Iter_Casas)
				        {
				            if(Casa[ca][casa_Garagem] == 1 && Casa[ca][casa_GarV] == -1)
				            {
				                if(Casa[ca][casa_Dono] == id[playerid] || TemChaveCasa(playerid, ca))
				                {
				                    if(IsPlayerInRangeOfPoint(playerid, 5.0, Casa[ca][casa_GarX], Casa[ca][casa_GarY], Casa[ca][casa_GarZ]))
				                    {
				                        SetPVarInt(playerid, "flood_garagem", gettime() + 2);
				                        Casa[ca][casa_GarV] = idf;
				                        Veiculo[idf][v_Garagem] = -ca;
				                        Veiculo[idf][v_Garagem_ID] = -1;
				                        SalvarInfo(idf);
				                        salvar_casa(ca);
				                        DestroyVehicle(idc);
				                        MS(playerid, 1, "Veiculo guardado na garagem da casa!");
				                        return 1;
				                    }
				                }
				            }
				        }
				    }
				    if(Veiculo[idf][v_Garagem_ID] == -1)
					{
					new g = -1;
						for(new a; a<MAX_GARAGEMS; a++)
						{
						    if(Garagem[a][ga_Existe] == 1)
							{
							    if(Garagem[a][ga_Org] == -1 && Garagem[a][ga_Emprego] == -1)
								{
								    if(IsPlayerInRangeOfPoint(playerid, 5.0, Garagem[a][ga_X2], Garagem[a][ga_Y2], Garagem[a][ga_Z2]) || IsPlayerInRangeOfPoint(playerid, 5.0, Garagem[a][ga_X], Garagem[a][ga_Y], Garagem[a][ga_Z]))
									{
									    g = a;
									    break;
									}
								}
							}
						}
					if(GetPVarInt(playerid, "flood_garagem") < gettime())
            			{
            			    SetPVarInt(playerid, "flood_garagem", gettime() + 2);
            			    if(g != -1)
            				{
							    Veiculo[idf][v_Garagem_ID] = g;
							    Veiculo[idf][v_Conce] = 0;
							    SalvarInfo(idf);
							    desconectar_veiculo(idc);
	                            SpawnVeiculo(idc);
	                            MS(playerid, 1, "Voce guardou o veiculo na Garagem.");
							}
                            return 1;
						}
				    }
				    else
					{
					new g = -1;
						for(new a; a<MAX_GARAGEMS; a++)
						{
							if(Garagem[a][ga_Existe] == 1)
							{
								if(IsPlayerInRangeOfPoint(playerid, 3.5, Garagem[a][ga_X2], Garagem[a][ga_Y2], Garagem[a][ga_Z2]))
								{
									g = a;
									break;
								}
							}
						}
					if(g != -1)
					{
							if(GetPVarInt(playerid, "flood_garagem") < gettime())
            				{
            				    SetPVarInt(playerid, "flood_garagem", gettime() + 2);
							    
							    // verificar garagem de casa //
							    foreach(new ca:Iter_Casas)
							    {
							        if(Casa[ca][casa_Garagem] == 1 && Casa[ca][casa_GarV] == -1)
							        {
							            if(Casa[ca][casa_Dono] == id[playerid] || TemChaveCasa(playerid, ca))
							            {
							                if(IsPlayerInRangeOfPoint(playerid, 5.0, Casa[ca][casa_GarX], Casa[ca][casa_GarY], Casa[ca][casa_GarZ]))
							                {
							                    Casa[ca][casa_GarV] = idf;
							                    Veiculo[idf][v_Garagem] = -ca;
							                    Veiculo[idf][v_Garagem_ID] = -1;
							                    SalvarInfo(idf);
							                    salvar_casa(ca);
							                    DestroyVehicle(idc);
							                    MS(playerid, 1, "Veiculo guardado na garagem da casa!");
							                    return 1;
							                }
							            }
							        }
							    }
							    
								if(Garagem[g][ga_Org] != -1 && Garagem[g][ga_Org] != OrgPlayer(playerid))
								{
								    format(sss, 200, "Esta garagem e exclusiva do Emprego '%s' !", NomeEmprego(Garagem[g][ga_Emprego]));
								    ms(playerid, 0, sss);
								}
								else if(Garagem[g][ga_Dono] != -1 && Garagem[g][ga_Dono] != c)
								{
								    ms(playerid, 0, "Apenas o dono da garagem pode guardar veiculo aqui !");
								}
								else
								{
								    Veiculo[idf][v_Garagem_ID] = g;
								    Veiculo[idf][v_Conce] = 0;
								    SalvarInfo(idf);
								    MS(playerid, 1, "Voce guardou o veiculo na Garagem.");
								    foreach(new a:Player)
									{
									    if(IsPlayerInVehicle(a, idc))
										{
										OnPlayerInteriorChangeEx(a, GetPlayerInterior(playerid), GetPlayerInterior(playerid), 2800, 1);
											Streamer_Update(a);
									    }
									}
									desconectar_veiculo(idc);
									SpawnVeiculo(idc);
								}
								return 1;
						}
					}
				    }
				}

		        // emprego empilhador //
		        if(EmpregoPlayer(playerid) == 7)
		        {

				if(GetVehicleModel(idc) == 530)
				{
					    new i = Info_Veiculo[idc];
					    if(i != -1)
						{
						if(Veiculo[i][v_Emprego] == 7)
							{
						    if(emp_veiculo[i] != 0)
							{
						        if(GetPVarInt(playerid, "flood_pegar_encomenda") > gettime()) return MS(playerid, 0, "Voce nao pode pegar ou largar encomendas com tanta frequencia !");
						        new Float:pos[4];
									foreach(new v:Vehicles)
									{
		              				    if(GetVehicleModel(v) != 0 && GetVehicleModel(v) != 530)
		              					{

			  								GetVehiclePos(v, pos[0], pos[1], pos[2]);
											GetVehicleZAngle(v, pos[3]);
			  								PegarFrente(pos[0], pos[1], pos[3], -4.5);
			  								if(IsPlayerInRangeOfPoint(playerid, 2, pos[0], pos[1], pos[2] ))
			  								{
				      					new idv  = Info_Veiculo[v];
				      					if(idv != -1)
				      					{
				                                if(Veiculo[idv][v_Emprego] == 7)
				                                {
				                                    if(emp_veiculo[idv] == 0 || emp_veiculo[idv] == emp_veiculo[i])
				                                    {
				                                        if(emp_m_veiculo[idv] == 100) return MS(playerid, 0, "Este Caminhao ja esta cheio !");
															emp_m_veiculo[idv] += unidades_mercadoria(emp_veiculo[i]);
															emp_veiculo[idv] = emp_veiculo[i];
															format(sss, 300, "Voce colocou %d de %s no caminhao, agora ele tem %d / 100.", unidades_mercadoria(emp_veiculo[i]), nome_mercadoria(emp_veiculo[i]), emp_m_veiculo[idv]);
															MS(playerid, 1, sss);
															emp_veiculo[i] = 0;
						    							veiculo_acessorios(idc);
						    							veiculo_acessorios(v);
						    							SetPVarInt(playerid, "flood_pegar_encomenda", gettime()+5);
						    							return 1;
				                                    }
				                                    else return MS(playerid, 0, "Voce deve colocar a mercadoria em um caminhao vazio ou com a mesma mercadoria !");
				      					    }
				      					}
		              					}
		              				    }
		              				}
						        emp_veiculo[i] = 0;
						    	veiculo_acessorios(idc);
									MS(playerid, 1, "Voce largou a encomenda do veiculo !");
									SetPVarInt(playerid, "flood_pegar_encomenda", gettime()+5);
						    }
						}
					    }
				    }
			    }

		        // abrir portao //
		        foreach(new i:Iter_Portoes)
		        {
		            if(Portao[i][p_Existe] == 1)
		            {
		                if(IsPlayerInRangeOfPoint(playerid, 7, Portao[i][p_X1], Portao[i][p_Y1], Portao[i][p_Z1]))
		                {
		                    if(GetPlayerInterior(playerid) == Portao[i][p_Interior])
		                    {
		                        if(GetPlayerVirtualWorld_(playerid) == Portao[i][p_Mundo])
		                        {
		                            if(verificar_portao(playerid, i))
		                            {
		            					abrir_portao(playerid, i);
		            					return 1;
		            				}
		            			}
		            		}
		            	}
		            }
		        }

		        new veh = GetPlayerVehicleID(playerid);
		        if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		        {

	                // veiculo truck //
	             	if(GetVehicleModel(veh) == 525)
	             	{
	             	    if(!IsTrailerAttachedToVehicle(veh))
						{
						    new Float:pos[8];
	  						GetVehiclePos(veh, pos[0], pos[1], pos[2]);
							GetVehicleZAngle(veh, pos[3]);
	  						PegarFrente(pos[0], pos[1], pos[3], -5.5);
							new vei = -1;
							foreach(new i:Vehicles)
							{
							if(GetVehicleModel(i) != 0)
							{
							    if(i != veh)
								{
								    if(!VeiculoMoto(i) && !VeiculoBicicleta(i))
									{
								        GetVehiclePos(i, pos[4], pos[5], pos[6]);
								        GetDistance(pos[7], pos[0], pos[1], pos[2], pos[4], pos[5], pos[6]);
								        if(pos[7] < 1.5)
								        {
								            vei = i;
								            break;
								        }
							        }
						        }
							}
						    }
							if(vei != -1)
							{
           						AttachTrailerToVehicle(vei, veh);
							    PlayerPlaySound(playerid, 3016, 0, 0, 0);
							    GameTextForPlayer(playerid, "~y~VEICULO REBOCADO", 2000, 3);
							}
	             	    }
	             	    else
	             	    {
	             	        DetachTrailerFromVehicle(veh);
	             	        GameTextForPlayer(playerid, "~W~VEICULO LIBERADO", 2000, 3);
	             	    }
		            }

		            // rebocar motos //
		            if(GetVehicleModel(veh) == 440)
	             	{
	             	    new idv = Info_Veiculo[veh];
	             	    if(idv != -1)
	             	    {
	             	        new Float:pos[8];
  							GetVehiclePos(veh, pos[0], pos[1], pos[2]);
							GetVehicleZAngle(veh, pos[3]);
	  						PegarFrente(pos[0], pos[1], pos[3], -4.5);
	             	        if(rebocando_moto[idv] == -1)
	             	        {

								new vei = -1;
								foreach(new i:Vehicles)
								{
								if(GetVehicleModel(i) != 0)
								{
								    if(i != veh)
									{
									    if(VeiculoMoto(i) || VeiculoBicicleta(i))
										{
										    if(VeiculoDesocupado(i))
											{
										        GetVehiclePos(i, pos[4], pos[5], pos[6]);
										        GetDistance(pos[7], pos[0], pos[1], pos[2], pos[4], pos[5], pos[6]);
										        if(pos[7] < 1.5)
										        {
										            vei = i;
										            break;
										        }
									        }
								        }
							        }
								}
							    }
								if(vei != -1)
								{
								    rebocando_moto[idv] = vei;
									SetVehicleVirtualWorld(vei, 99999);
									veiculo_acessorios(veh);
								    PlayerPlaySound(playerid, 3016, 0, 0, 0);
								    GameTextForPlayer(playerid, "~y~VEICULO REBOCADO", 2000, 3);
								}
	             	        }
	             	        else
	             	        {
	             	            new vei = rebocando_moto[idv];
	             	            SetVehiclePos(vei, pos[0], pos[1], pos[2]);
	             	            SetVehicleVirtualWorld(vei, 0);
	             	            rebocando_moto[idv] = -1;
	             	            GameTextForPlayer(playerid, "~W~VEICULO LIBERADO", 2000, 3);
	             	            veiculo_acessorios(veh);
	             	        }
	             	    }
	             	}
		        }

		        foreach(new i:Iter_Pickups)
				{
				    if(Pickup[i][pick_Existe] == 1)
					{
					if(Pickup[i][pick_Tipo] != 0)
					{
					    if(GetPlayerInterior(playerid) == Pickup[i][pick_Interior])
						{
					        if(GetPlayerVirtualWorld_(playerid) == Pickup[i][pick_Mundo])
					    	{
					            if(IsPlayerInRangeOfPoint(playerid, 4, Pickup[i][pick_X], Pickup[i][pick_Y], Pickup[i][pick_Z]))
					            {
			    						PlayerPickup(playerid, i);
			    						return 1;
			    					}
			    				}
			    			}
			    		}
			    	}
			    }
	        }

		    return 1;
	    }
	}

	// tecla H //
	if(newkeys == KEY_CTRL_BACK)
	{

	    new Float:p[3];
	    if(Barra[playerid][b_Acao] == 0)
	    {

        	// aparelhos de academia //
	        foreach(new a:Iter_Academias)
	        {
	            if(Academia[a][aca_Existe] == 1)
	            {
	                if(Academia[a][aca_Player] == -1)
	                {
	                    if(IsPlayerInRangeOfPoint(playerid, 1.5, Academia[a][aca_X], Academia[a][aca_Y], Academia[a][aca_Z]))
	                    {
	                        if(GetPlayerInterior(playerid) ==  Academia[a][aca_Interior]  && GetPlayerVirtualWorld_(playerid) ==  Academia[a][aca_Mundo])
	                        {
		                        if(GetPlayerSpecialAction(playerid) == 2) return MS(playerid, 0, "Voce nao pode fazer isso enquanto estiver em um JetPack !");
		                        if(segurando_player[playerid] != -1) return MS(playerid, 0, "Voce nao pode fazer isso enquanto segura algo !");
	    						if(ID_Dancando[playerid] != -1) return MS(playerid, 0, "Voce nao pode fazer isso enquanto danca !");
		                        abrir_aparelho(playerid, a);
		                        return 1;
	                        }
	                    }
	                }
	            }
	        }


			// se nao tiver em interior //
            if(GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld_(playerid) == 0)
			{

			    // maquinas de equipamentos //
			    foreach(new m:Iter_Maquinas)
				{
					if(Maquina[m][m_Existe] == 1)
					{
					    if(IsPlayerInRangeOfPoint(playerid, 1.2, Maquina[m][m_X], Maquina[m][m_Y], Maquina[m][m_Z]))
						{
						new mgz = Maquina[m][m_GZ];
						if(mgz == -1 || TR[mgz][tr_Existe] == 0 || TR[mgz][tr_Dono] == -1)
						    return MS(playerid, 0, "Esta maquina nao tem um territorio valido !");
						if(TR[mgz][tr_Dono] == OrgPlayer(playerid) || ModoAdmin[playerid] == 1)
							{
							    maquina(playerid, m);
							    return 1;
							}
							else return MS(playerid, 0, "Sua organizacao nao domina o territorio desta maquina !");
				    }
				}
			    }

        // concessionarias //
        for(new co; co<MAX_CONCE; co++)
        {
            if(Conce[co][con_Existe] == 1)
            {
                if(IsPlayerInRangeOfPoint(playerid, 1.5, Conce[co][con_X], Conce[co][con_Y], Conce[co][con_Z]))
                {
                    SetPVarInt(playerid, "conce", co);
                    if(ConceAberto[playerid] == 0) CriarFConcePlayer(playerid);
                    MostrarFConce(playerid);
                    ConceCat[playerid] = 0;
                    ConcePagina[playerid] = 0;
                    ConceSlot[playerid] = 0;
                    ConceCor[playerid] = 1;
                    C_AtualizarCatalogo(playerid);
                    C_AtualizarSelecionado(playerid);
                    return 1;
                }

                if(IsPlayerInRangeOfPoint(playerid, 1.5, Conce[co][con_g_X], Conce[co][con_g_Y], Conce[co][con_g_Z]))
                {
                    abrir_garagem_concessionaria(playerid, co);
                    return 1;
                }
            }
        }

			}

         	// ver se ta em portao //
	        foreach(new i:Iter_Portoes)
	        {
	            if(Portao[i][p_Existe] == 1)
	            {
	                if(IsPlayerInRangeOfPoint(playerid, 2.5, Portao[i][p_X1], Portao[i][p_Y1], Portao[i][p_Z1]))
	                {
	                    if(GetPlayerInterior(playerid) == Portao[i][p_Interior])
	                    {
	                        if(GetPlayerVirtualWorld_(playerid) == Portao[i][p_Mundo])
	                        {
	                            if(verificar_portao(playerid, i))
	                            {
	            					abrir_portao(playerid, i);
	            					return 1;
	            				}
	            			}
	            		}
	            	}
	            }
	        }


	        if(PlayerMedico(playerid) || PlayerCop(playerid))
	        {
				if(Conta[playerid][c_Morto] == 0)
				{
				foreach(new i:Player)
					{
					    if(i != playerid)
						{
					    	if(Online(i) && id[i] != -1)
							{
								if(Conta[i][c_Morto] > 0)
								{
									if(GetPlayerVirtualWorld_(i) == GetPlayerVirtualWorld_(playerid))
									{
										if(GetPlayerInterior(i) == GetPlayerInterior(playerid))
										{
											GetPlayerPos(i, p[0], p[1], p[2]);
											if(IsPlayerInRangeOfPoint(playerid, 1.2, p[0], p[1], p[2]))
											{
												SetPVarInt(playerid, "morto", i);
												SetPVarInt(i, "salvando", playerid);
												SetPlayerToFacePos(playerid, p[0], p[1]);
												KillTimer(timer_morto[i]);
												new tempo = 200;
												Acao(playerid, 1, tempo, "SALVANDO JOGADOR", 1, "COP_AMBIENT", "COPBROWSE_LOOP", true);
												SetPlayerAttachedObject(playerid, 9, 11738, 6, 0.070000, 0.194999, -0.090999,   55.500000, -4.699998, 55.799983,   1.000000, 1.000000, 1.000000);
												return 1;
											}
										}
									}
								}
						    }
					    }
					}
			    }
		    }
	    }

		// verificar lanchonetes //
		if(GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld_(playerid) == 0)
		{
		    new Float:pos[3];
			foreach(new l:Iter_Lanchonetes)
			{
			    if(Lanche[l][la_Existe] == 1)
				{
                    pos[0] = Lanche[l][la_X], pos[1] = Lanche[l][la_Y], pos[2] = Lanche[l][la_Z], PegarFrente(pos[0], pos[1], Lanche[l][la_RZ]-90, 1.5);
					if(IsPlayerInRangeOfPoint(playerid, 2, pos[0], pos[1], pos[2]))
					{
						abrir_lanchonete(playerid, l);
						return 1;
					}
			    }
			}
		}

		// eletricista //
	    if(EmpregoPlayer(playerid) == 10 || PlayerCop(playerid))
	    {
	        // caixas //
		    foreach(new cc:Iter_CaixasEletronicos)
		    {
		        if(CaixaEletronico[cc][ce_Existe] == 1)
		        {
		            if(GetPlayerInterior(playerid) == CaixaEletronico[cc][ce_Interior] && GetPlayerVirtualWorld_(playerid) == CaixaEletronico[cc][ce_Mundo])
					{
		            	if(IsPlayerInRangeOfPoint(playerid, 2.0, CaixaEletronico[cc][ce_X], CaixaEletronico[cc][ce_Y], CaixaEletronico[cc][ce_Z] ))
		            	{
		                    if(CaixaEletronico[cc][ce_Quebrado] == 1)
		                    {
								if(eletricista_tipo[playerid] == -1)
								{
								    /*if(CaixaEletronico[cc][ce_TempoFogo] != 0) MS(playerid, 0, "Este caixa eletronico explodiu recentemente, tente concerta-lo mais tarde !");
									else */player_concertar(playerid, 0, cc);
								}
							    return 1;
							}
		                }

		                if(IsPlayerInRangeOfPoint(playerid, 1.0, CaixaEletronico[cc][cec_X], CaixaEletronico[cc][cec_Y], CaixaEletronico[cc][cec_Z] ))
		            	{
		            	    if(CaixaEletronico[cc][cec_Quebrado] == 1)
		                    {
		                        if(eletricista_tipo[playerid] == -1)
		                        {
		                            /*if(CaixaEletronico[cc][cec_TempoFogo] != 0) MS(playerid, 0, "Esta Camera explodiu recentemente, tente concerta-la mais tarde !");
		                            else*/ player_concertar(playerid, 3, cc);
		                        }
		                        return 1;
		            	    }
		            	}
		            }
		        }
		    }

		    // radares //
		    foreach(new rr:Iter_Radares)
		    {
		        if(Radar[rr][radar_Existe] == 1)
	            {
	                if(Radar[rr][radar_Ativado] == 0)
	                {
	                    if(IsPlayerInRangeOfPoint(playerid, 1.5, Radar[rr][radar_X], Radar[rr][radar_Y], Radar[rr][radar_Z]+3.5))
						{
						    if(eletricista_tipo[playerid] == -1)
	                        {
	                            player_concertar(playerid, 1, rr);
	                        }
	                        return 1;
						}
					}
				}
			}

			// cameras //
		    foreach(new ca:Iter_Cameras)
		    {
		        if(Camera[ca][cam_Existe] == 1)
		        {
		            if(IsPlayerInRangeOfPoint(playerid, 1.0, Camera[ca][cam_X], Camera[ca][cam_Y], Camera[ca][cam_Z]))
					{
		                if(Camera[ca][cam_Quebrada] == 1)
		                {
		                    if(eletricista_tipo[playerid] == -1)
	                        {
	                            player_concertar(playerid, 2, ca);
	                        }
	                        return 1;
		                }
		            }
		        }
		    }

	    }

	    // se tiver em um pickup //
		foreach(new i:Iter_Pickups)
		{
		    if(Pickup[i][pick_Existe] == 1)
		    {
		        if(Pickup[i][pick_Tipo] != 0)
		        {
		            if(GetPlayerInterior(playerid) == Pickup[i][pick_Interior])
		            {
		                if(GetPlayerVirtualWorld_(playerid) == Pickup[i][pick_Mundo])
		            	{
		                    if(IsPlayerInRangeOfPoint(playerid, 2, Pickup[i][pick_X], Pickup[i][pick_Y], Pickup[i][pick_Z]))
		                    {
	    						PlayerPickup(playerid, i);
	    						return 1;
	    					}
	    				}
	    			}
	    		}
	    	}
	    }

	    for(new g; g<MAX_GARAGEMS; g++)
	    {
	        if(Garagem[g][ga_Existe] == 1)
	        {
	            if(IsPlayerInRangeOfPoint(playerid, 1.8, Garagem[g][ga_X], Garagem[g][ga_Y], Garagem[g][ga_Z]))
	            {
	                ClearAnimations(playerid, 1);
					abrir_garagem(playerid, g);
					return 1;
	            }
	        }
	    }

	    // garagem da casa //
	    if(id[playerid] != -1)
	    {
	        foreach(new casaid:Iter_Casas)
	        {
	            if(Casa[casaid][casa_Garagem] == 1 && IsPlayerInRangeOfPoint(playerid, 2.0, Casa[casaid][casa_GarX], Casa[casaid][casa_GarY], Casa[casaid][casa_GarZ]))
	            {
	                if(Casa[casaid][casa_Dono] == id[playerid] || TemChaveCasa(playerid, casaid))
	                {
	                    abrir_garagem_casa(playerid, casaid);
	                    return 1;
	                }
	            }
	        }
	    }

	    // deposito de veiculos apreendidos //
	    if(IsPlayerInRangeOfPoint(playerid, 3.0, 1224.4751, -1475.8009, 13.5392))
	    {
	        abrir_deposito_veiculos(playerid);
	        return 1;
	    }

	    // porta malas dos veiculos //
	    new porta_malas = verificar_porta_malas(playerid);
		if(porta_malas != -1)
		{
			if(porta_malas == -4)
			{
				ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Porta Malas", "{FF0000}[ERRO] {A1A1A1}Apenas o Emprego deste veiculo tem acesso ao portamalas !", "Ok", "Fechar");
				return 1;
			}
			if(porta_malas == -3)
			{
				ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Porta Malas", "{FF0000}[ERRO] {A1A1A1}Apenas a Organizacao deste veiculo tem acesso ao portamalas !", "Ok", "Fechar");
				return 1;
			}
			if(porta_malas == -2)
			{
				MS(playerid, 0, "O veiculo esta travado, nao e possivel abrir o porta malas !");
				return 1;
			}

			new seg = segurando_player[playerid];
            new v = porta_malas;
            new i = Veiculo[v][v_ID];

			// se o veiculo nao for de um emprego //
			if(Veiculo[v][v_Emprego] == -1)
			{
			    new max_slots = slots_porta_malas(v);

			    // segurando  matole //
				if(seg == 4 )
				{
				    MS(playerid, 0, "Voce nao pode guardar um malote em um porta malas !");
				    return 1;
				}

			    // segurando //
				if(seg == 2 || seg == 3 || seg == 6 || seg == 7 || seg == 8 || seg == 9 || seg == 10 || seg == 11 )
				{
                    for(new po; po<max_slots; po++)
					{
					    if(PortaMalas[porta_malas][po][inv_ID] == 0)
						{
						PortaMalas[porta_malas][po][inv_ID] = itens_segurando[segurando_player[playerid]][seg_ID];
						PortaMalas[porta_malas][po][inv_Unidades] = segurando_unidades[playerid];
						PortaMalas[porta_malas][po][inv_Tipo] = segurando_tipo[playerid];
						PortaMalas[porta_malas][po][inv_Ativo] = segurando_ativo[playerid];
						PortaMalas[porta_malas][po][inv_Tempo] = segurando_tempo[playerid];
							format(string_prox, 300, "** '%s' guardou %s %s no porta malas do veiculo '%s' **", Nome(playerid), ConvertMoney(segurando_unidades[playerid]), NomeItem(itens_segurando[segurando_player[playerid]][seg_ID], segurando_tipo[playerid]), NomeVeiculo(Veiculo[porta_malas][v_Modelo]));
							ProxDetector(10.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
		                    SalvarInfo(porta_malas, 0, po);
		                    jogar(playerid);
		                    SetPlayerToFaceVehicle(playerid, Veiculo[porta_malas][v_ID]);
		                    ApplyAnimation(playerid, "BD_FIRE", "WASH_UP", 4.1, false, false, false, false, 0, 1);
		                    return 1;
						}
					}
					MS(playerid, 0, "O porta malas do veiculo esta lotado !");
					return 1;
				}

				// abrir porta malas //
				SetPVarInt(playerid, "id_info", porta_malas);
		    	ShowPlayerDialog(playerid, DIALOG_OPCAO_PORTA_MALAS, DIALOG_STYLE_LIST, NomeVeiculo(Veiculo[porta_malas][v_Modelo]), "Pegar Item\nGuardar Item", "Continuar", "Cancelar");
			}

			// se for veiculo de emprego //
			if(Veiculo[v][v_Emprego] != -1)
			{
			    // emprego do veiculo //
			    new e = Veiculo[v][v_Emprego];


			    // etregador de gas //
			    if(e == 0)
				{
				    // Segurando Botijao de Gas //
					if(seg == 0)
				{

		                if(botijao_veiculo[v] < 6)
		                {
		                    new str1[150];
		                    botijao_veiculo[v] ++;
							jogar(playerid);
							veiculo_acessorios(i);
							format(str1, 150, "Voce colocou 1 Botijao de Gas no Veiculo, agora ele tem %d/%d.", botijao_veiculo[v], 6);
							MS(playerid, 1, str1);
							ApplyAnimation(playerid, "BD_FIRE", "WASH_UP", 4.1, false, false, false, false, 0, 1);
							SetPlayerToFaceVehicle(playerid, i);
		                }
		                else MS(playerid, 0, "Este veiculo ja tem 5 Botijoes de Gas, nao e possivel adicionar mais 1.");
		                return 1;
					}
					else
					{
					    if(seg == -1)
						{
						    if(botijao_veiculo[v] > 0)
				        {
				            new str1[150];
				            botijao_veiculo[v] --;
				            segurar(playerid, 0, 1);
				            veiculo_acessorios(i);
								format(str1, 150, "Voce pegou um Botijao de Gas do Veiculo, agora ele tem %d/%d.", botijao_veiculo[v], 6);
								MS(playerid, 1, str1);
								ApplyAnimation(playerid, "BD_FIRE", "WASH_UP", 4.1, false, false, false, false, 0, 1);
								SetPlayerToFaceVehicle(playerid, i);
				        }
				        else MS(playerid, 0, "Este veiculo nao tem um Botijao de Gas.");
				        return 1;
					    }
					}
				}

				// motorista da uber //
			    if(e == 1)
				{
      				SetPVarInt(playerid, "id_info", porta_malas);
		    		ShowPlayerDialog(playerid, DIALOG_OPCAO_PORTA_MALAS, DIALOG_STYLE_LIST, NomeVeiculo(Veiculo[porta_malas][v_Modelo]), "Pegar Item\nGuardar Item", "Continuar", "Cancelar");
				return 1;
			    }

                // etregador da sedex //
			    if(e == 2)
				{
					// segurando caixa da sedex //
					if(seg == 1)
					{
		                if(sedex_veiculo[v] < 3)
		                {
		                    new str1[150];
		                    sedex_veiculo[v] ++;
							jogar(playerid);
							veiculo_acessorios(i);
							format(str1, 150, "Voce colocou 1 entrega na Van, agora ela tem %d/%d.", sedex_veiculo[v], 3);
							MS(playerid, 1, str1);
							ApplyAnimation(playerid, "BD_FIRE", "WASH_UP", 4.1, false, false, false, false, 0, 1);
							SetPlayerToFaceVehicle(playerid, i);
						}
						else MS(playerid, 0, "Esta Van ja tem 3 entregas, nao e possivel colocar mais uma caixa.");
						return 1;
					}
					else
					{
						if(seg == -1)
						{
						    if(sedex_veiculo[v] > 0)
		                    {
		                        new str1[150];
		                        sedex_veiculo[v] --;
		                        segurar(playerid, 1, 1);
		                        veiculo_acessorios(i);
								format(str1, 150, "Voce pegou uma Entrega da Van, agora ela tem %d/%d.", sedex_veiculo[v], 3);
								MS(playerid, 1, str1);
								ApplyAnimation(playerid, "BD_FIRE", "WASH_UP", 4.1, false, false, false, false, 0, 1);
								SetPlayerToFaceVehicle(playerid, i);
		                    }
		                    else MS(playerid, 0, "Esta Van nao tem uma entrega.");
		                    return 1;
						}
					}
				}

                // mecanico //
			    if(PlayerMecanicoOrg(playerid))
				{
      				SetPVarInt(playerid, "id_info", porta_malas);
		    		ShowPlayerDialog(playerid, DIALOG_OPCAO_PORTA_MALAS, DIALOG_STYLE_LIST, NomeVeiculo(Veiculo[porta_malas][v_Modelo]), "Pegar Item\nGuardar Item", "Continuar", "Cancelar");
				return 1;
			    }

                // lenhador //
			    if(e == 4)
				{
					// segurando madeira de lenhador //
					if(seg == 2)
					{
				    if(madeiras_veiculo[v] < 10)
					{
				        new str1[150];
				        madeiras_veiculo[v] ++;
							jogar(playerid);
							veiculo_acessorios(i);
							format(str1, 150, "Voce colocou 1 Madeira na Caminhonete, agora ela tem %d/%d.", madeiras_veiculo[v], 10);
							MS(playerid, 1, str1);
							ApplyAnimation(playerid, "BD_FIRE", "WASH_UP", 4.1, false, false, false, false, 0, 1);
							SetPlayerToFaceVehicle(playerid, i);
				    }
				    else MS(playerid, 0, "Esta Caminhonete ja tem 10 madeiras, nao e possivel colocar mais uma.");
				    return 1;
					}
					else
					{
						if(seg == -1)
						{
		                    if(madeiras_veiculo[v] > 0)
		                    {
		                        new str1[150];
		                        madeiras_veiculo[v] --;
		                        segurar(playerid, 2, 1);
		                        veiculo_acessorios(i);
								format(str1, 150, "Voce pegou uma Madeira da Caminhonete, agora ela tem %d/%d.", madeiras_veiculo[v], 10);
								MS(playerid, 1, str1);
								ApplyAnimation(playerid, "BD_FIRE", "WASH_UP", 4.1, false, false, false, false, 0, 1);
								SetPlayerToFaceVehicle(playerid, i);
		                    }
		                    else MS(playerid, 0, "Esta Caminhonete nao tem uma Madeira !");
		                    return 1;
						}
					}
				}

				// minerador //
			    if(e == 5)
				{
					// segurando pedra de minerador //
					if(seg == 3)
					{
				    if(pedras_veiculo[v] < 10)
					{
				        new str1[150];
				        pedras_veiculo[v] ++;
							jogar(playerid);
							veiculo_acessorios(i);
							format(str1, 150, "Voce colocou 1 Pedra na Caminhonete, agora ela tem %d/%d.", pedras_veiculo[v], 10);
							MS(playerid, 1, str1);
							ApplyAnimation(playerid, "BD_FIRE", "WASH_UP", 4.1, false, false, false, false, 0, 1);
							SetPlayerToFaceVehicle(playerid, i);
				    }
				    else MS(playerid, 0, "Esta Caminhonete ja tem 10 pedras, nao e possivel colocar mais uma.");
				    return 1;
					}
					else
					{
						if(seg == -1)
						{
		                    if(pedras_veiculo[v] > 0)
					  	{
		                        new str1[150];
		                        pedras_veiculo[v] --;
		                        segurar(playerid, 3, 1);
		                        veiculo_acessorios(i);
								format(str1, 150, "Voce pegou uma Pedra da Caminhonete, agora ela tem %d/%d.", pedras_veiculo[v], 10);
								MS(playerid, 1, str1);
								ApplyAnimation(playerid, "BD_FIRE", "WASH_UP", 4.1, false, false, false, false, 0, 1);
								SetPlayerToFaceVehicle(playerid, i);
		                    }
		                    else MS(playerid, 0, "Esta Caminhonete nao tem uma Pedra !");
		                    return 1;
						}
					}
				}

				// carro forte //
			    if(e == 6)
				{
					// segurando malote //
					if(seg == 4)
					{
					    if(carro_com_explosivo(i))
						{
                            MS(playerid, 0, "Este carro forte esta sendo assaltado, nao e possivel colocar o Malote !");
                            return 1;
					    }
		                if(malotes_veiculo[v] < 10)
		                {
		                    new str1[150];
		                    malotes_veiculo[v] += segurando_unidades[playerid];
		                    format(str1, 150, "Voce colocou %d Malote no Carro Forte, agora ele tem %d/%d.", segurando_unidades[playerid], malotes_veiculo[v], 10);
							jogar(playerid);
							veiculo_acessorios(i);
							MS(playerid, 1, str1);
							ApplyAnimation(playerid, "BD_FIRE", "WASH_UP", 4.1, false, false, false, false, 0, 1);
							SetPlayerToFaceVehicle(playerid, i);
							if(malotes_veiculo[v] >= 10)
							{
							    if(CF_Etapa[playerid] == 2)
								{
							    	MS(playerid, 2, "Entre no veiculo para iniciar uma rota.");
							    }
							}
		                }
		                else
						{
						    if(malotes_veiculo[v] >= 10)
							{
							    if(CF_Etapa[playerid] == 2)
								{
							    	jogar(playerid);
							    	MS(playerid, 2, "Entre no veiculo para iniciar uma rota.");
							    }
							}
							MS(playerid, 0, "Esta Caminhonete ja tem 10 malotes, nao e possivel colocar mais uma.");
						}
		                return 1;
					}
					else
					{
						if(seg == -1)
						{
						    if(carro_com_explosivo(i))
							{
	                            MS(playerid, 0, "Este carro forte esta sendo assaltado, nao e possivel pegar um Malote !");
	                            return 1;
						    }
		                    if(malotes_veiculo[v] > 0)
		                    {
		                        new str1[150];
		                        malotes_veiculo[v] --;
		                        segurar(playerid, 4, 1);
		                        veiculo_acessorios(i);
								format(str1, 150, "Voce pegou um Malote do Carro forte, agora ele tem %d/%d.", malotes_veiculo[v], 10);
								MS(playerid, 1, str1);
								ApplyAnimation(playerid, "BD_FIRE", "WASH_UP", 4.1, false, false, false, false, 0, 1);
								SetPlayerToFaceVehicle(playerid, i);
		                    }
		                    else MS(playerid, 0, "Este Carro forte nao tem nenhum malote !");
		                    return 1;
						}
					}
				}

                // entregador de encomendas //
			    if(e == 7)
				{
      				if(GetVehicleModel(i) == 530) MS(playerid, 0, "Este veiculo nao possui um porta malas !");
      				else
      				{
      				    SetPVarInt(playerid, "id_info", porta_malas);
		    			ShowPlayerDialog(playerid, DIALOG_OPCAO_PORTA_MALAS, DIALOG_STYLE_LIST, NomeVeiculo(Veiculo[porta_malas][v_Modelo]), "Pegar Item\nGuardar Item", "Continuar", "Cancelar");
      				}
				return 1;
			    }

			    // coleta de lixo //
			    if(e == 8)
				{
					// segurando lixo //
					if(seg == 5)
					{
				    if(lixo_veiculo[v] < 100)
					{
				        new str1[150];
				        lixo_veiculo[v] += segurando_unidades[playerid];
				        format(str1, 150, "Voce colocou %d Lixo no Caminhao, agora ele tem %d/%d.", segurando_unidades[playerid], lixo_veiculo[v], 100);
							jogar(playerid);
							veiculo_acessorios(i);
							MS(playerid, 1, str1);
							ApplyAnimation(playerid, "BD_FIRE", "WASH_UP", 4.1, false, false, false, false, 0, 1);
							SetPlayerToFaceVehicle(playerid, i);
							if(lixo_veiculo[v] >= 100)
							{
							    lixo_veiculo[v] = 100;
							    ms(playerid, 2, "O caminhao esta cheio, va ate a HQ do emprego para esvaziar o caminhao e receber seu pagamento.");
							}
				    }
				    else MS(playerid, 0, "Este Caminhao de lixo esta cheio, nao e possivel colocar mais.");
				    return 1;
					}
					else
					{
						if(seg == -1)
						{
		                    if(lixo_veiculo[v] > 0)
				        {
				            new str1[150];
				            lixo_veiculo[v] --;
				            segurar(playerid, 5, 1);
				            veiculo_acessorios(i);
								format(str1, 150, "Voce pegou uma Sacola de Lixo do Caminhao, agora ele tem %d/%d.", lixo_veiculo[v], 100);
								MS(playerid, 1, str1);
								ApplyAnimation(playerid, "BD_FIRE", "WASH_UP", 4.1, false, false, false, false, 0, 1);
								SetPlayerToFaceVehicle(playerid, i);
								Streamer_Update(playerid);
				        }
				        else MS(playerid, 0, "Este Caminhao nao tem nenhuma sacola de Lixo !");
				        return 1;
						}
					}
				}
			}

			return 1;
		}

		// se tiver segurando algo //
	    if(segurando_player[playerid] != -1)
	    {
	        new seg = segurando_player[playerid];

			// segurando algo //
			if(seg == 0 || seg == 1 || seg == 2 || seg == 3 || seg == 4 || seg == 5 || seg == 9 || seg == 10 || seg == 11)
			{
			    new segss[150];
			    new a = segurando_player[playerid];
			    format(segss, 150, "Voce largou o(a) %s no chao, aperte F ou ENTER para pegar.", itens_segurando[a][seg_Nome]);
			    largar(playerid);
				MS(playerid, 2, segss);
				return 1;
			}

			// caixa de armas //
			if(seg == 6)
			{
				foreach(new i:Iter_Orgs)
				{
				    if(Org[i][o_Existe] == 1)
					{
					if(IsPlayerInRangeOfPoint(playerid, 1.5, Org[i][o_X], Org[i][o_Y], Org[i][o_Z] ))
					{
					    new arma_id_org = id_armas_org(segurando_tipo[playerid]);
					    if(arma_id_org != -1)
						{
					        new str1[150];
					        Org[i][o_Armas][arma_id_org] += armas_org[arma_id_org][6];
					        format(str1, 150, "Voce colocou uma caixa com %d %s, na organizacao %s.", armas_org[arma_id_org][6], nome_arma(armas_org[arma_id_org][0]), Org[i][o_Nome]);
					        MS(playerid, 1, str1);
					        format(str1, 150, "%s colocou uma caixa com %d %s, na organizacao.", Nome(playerid), armas_org[arma_id_org][6], nome_arma(armas_org[arma_id_org][0]));
					        escrever_log(f("OrgsLog/Org_%d.txt", i), str1);
					        jogar(playerid);
					        salvar_org(i);
					    	return 1;
					    }
					}
				    }
				}
			    largar(playerid);
				MS(playerid, 2, "Voce largou a Caixa de Armas no chao, aperte F ou ENTER para pegar.");
				return 1;
			}

			// caixa de coletes //
			if(seg == 7)
			{
                foreach(new i:Iter_Orgs)
				{
				    if(Org[i][o_Existe] == 1)
					{
					if(IsPlayerInRangeOfPoint(playerid, 1.5, Org[i][o_X], Org[i][o_Y], Org[i][o_Z] ))
					{
				        new str1[150];
				        Org[i][o_Coletes] += coletes_org[0][6];
				        format(str1, 150, "Voce colocou uma caixa com %d Coletes, na organizacao %s.", coletes_org[0][6], Org[i][o_Nome]);
				        MS(playerid, 1, str1);
				        format(str1, 150, "%s colocou uma caixa com %d Coletes, na organizacao.", Nome(playerid), coletes_org[0][6]);
				        escrever_log(f("OrgsLog/Org_%d.txt", i), str1);
				        jogar(playerid);
				        salvar_org(i);
				    	return 1;
					}
				    }
				}
			    largar(playerid);
				MS(playerid, 2, "Voce largou a Caixa de Coletes no chao, aperte F ou ENTER para pegar.");
				return 1;
			}

			// caixa de municoes //
			if(seg == 8)
			{
			    foreach(new i:Iter_Orgs)
				{
				    if(Org[i][o_Existe] == 1)
					{
					if(IsPlayerInRangeOfPoint(playerid, 1.5, Org[i][o_X], Org[i][o_Y], Org[i][o_Z] ))
					{
				        new str1[150];
				        new a = segurando_tipo[playerid];
				        Org[i][o_Municoes][a] += municoes_org[a][6];
				        format(str1, 150, "Voce colocou uma caixa com %d %s, na organizacao %s.", municoes_org[a][6], nome_municao(segurando_tipo[playerid]), Org[i][o_Nome]);
				        MS(playerid, 1, str1);
				        format(str1, 150, "%s colocou uma caixa com %d %s, na organizacao.", Nome(playerid), municoes_org[a][6], nome_municao(segurando_tipo[playerid]));
				        escrever_log(f("OrgsLog/Org_%d.txt", i), str1);
				        jogar(playerid);
				        salvar_org(i);
				    	return 1;
					}
				    }
				}
			    largar(playerid);
				MS(playerid, 2, "Voce largou a Caixa de Municoes no chao, aperte F ou ENTER para pegar.");
				return 1;
			}

	    }
		else
		{
		    // emprego de coletor de lixo //
	        if(EmpregoPlayer(playerid) == 8)
	        {
	            if(GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld_(playerid) == 0)
	            {
		            foreach(new l:Iter_Lixeiros)
		            {
		                if(Lixeiro[l][li_Existe] == 1)
		                {
		                    if(IsPlayerInRangeOfPoint(playerid, 2, Lixeiro[l][li_X], Lixeiro[l][li_Y], Lixeiro[l][li_Z]))
		                    {
		                        if(Lixeiro[l][li_Lixos] > 0)
		                        {
									pegar_lixo(playerid, l);
								}
								else MS(playerid, 0, "Este Lixeiro esta vazio !");
								return 1;
		                    }
		                }
		            }
	            }
	        }
		}

	    // garagem dinamica - puxar veiculo de qualquer garagem normal //
		new garagem_perto = -1;
		for(new g; g<MAX_GARAGEMS; g++)
		{
		    if(Garagem[g][ga_Existe] == 1)
			{
			    if(Garagem[g][ga_Org] == -1 && Garagem[g][ga_Emprego] == -1)
				{
				    if(IsPlayerInRangeOfPoint(playerid, 5.0, Garagem[g][ga_X], Garagem[g][ga_Y], Garagem[g][ga_Z]) || IsPlayerInRangeOfPoint(playerid, 5.0, Garagem[g][ga_X2], Garagem[g][ga_Y2], Garagem[g][ga_Z2]))
					{
					    garagem_perto = g;
					    break;
					}
				}
			}
		}
		if(garagem_perto != -1)
		{
		    new cc = id[playerid];
		    if(cc != -1)
			{
			    SG[0] = EOS;
			    strcat(SG, "Nome\tPlaca\n");
			    new cont;
			    new sss[200];
			    foreach(new v:Iter_Veiculos)
				{
				    if(Veiculo[v][v_Existe] == 1 && Veiculo[v][v_Dono] == c && Veiculo[v][v_Garagem] == 1 && Veiculo[v][v_Conce] == 0)
					{
					    format(sss, 200, "{ffffff}%s\t{ffff00}%s\n", NomeVeiculo(Veiculo[v][v_Modelo]), PlacaVeiculo[v]);
					    strcat(SG, sss);
					    Lista2[playerid][cont] = v;
					    cont++;
					}
				}
				if(cont > 0)
				{
				    format(sss, 200, "{ffffff}Seus veiculos na Garagem [{ffff00}%d{ffffff}]", cont);
				    ShowPlayerDialog(playerid, DIALOG_GARAGEM_DINAMICA, DIALOG_STYLE_TABLIST_HEADERS, sss, SG, "Pegar", "Cancelar");
				    return 1;
				}
			}
		}
    }

    // tecla N //
    if(newkeys == KEY_NO)
	{
	    if(GetPlayerSpecialAction(playerid) == 2) return ms(playerid, 0, "Voce nao pode fazer isso enquanto estiver em um JetPack !");
     	else abrir_menu_player(playerid);
	}

	// tecla F ou ENTER //
	if(newkeys == KEY_SECONDARY_ATTACK)
	{

	    // abrir bau //
	    foreach(new b:Iter_Baus)
	    {
	        if(BauI[b][bau_Existe] == 1 && IsPlayerInRangeOfPoint(playerid, 2.0, BauI[b][bau_X], BauI[b][bau_Y], BauI[b][bau_Z])
	        && GetPlayerVirtualWorld_(playerid) == BauI[b][bau_Mundo] && GetPlayerInterior(playerid) == BauI[b][bau_Interior])
	        {
	            SetPVarInt(playerid, "bau_id", b);
	            if(strlen(BauI[b][bau_Senha]) > 0 && !Comparar(BauI[b][bau_Senha], "0"))
	            {
	                format(sttr, 300, "\n\n{ffffff}Digite a senha do bau para abri-lo:\n\n");
	                ShowPlayerDialog(playerid, DIALOG_BAU_SENHA, DIALOG_STYLE_INPUT, "{000000}.", sttr, "Abrir", "Fechar");
	            }
	            else ShowPlayerDialog(playerid, DIALOG_BAU_OPCOES, DIALOG_STYLE_LIST, "{ffffff}Bau", "Abrir Bau\nGuardar Item", "Selecionar", "Fechar");
	            return 1;
	        }
	    }

	    // sair do veiculo de inv //
	    if(RC[playerid] != -1)
	    {
			if(GetVehicleModel(RC[playerid]) != 0)
			{
		        if(IsPlayerInVehicle(playerid, RC[playerid]))
		        {
		            DestroyVehicle_(RC[playerid]);
		            RC[playerid] = -1;
		            MS(playerid, 2, "Voce nao estava mais no RC e ele foi guardado !");
					return 1;
		        }
			}
	    }
	    for(new i; i < sizeof(LocaisSpawns); i++)
	    {
	        if(ISP(playerid, 5.0, LocaisSpawns[i][0], LocaisSpawns[i][1], LocaisSpawns[i][2]))
	        {
	            ShowPlayerDialog(playerid, DIALOG_ALUGUELB, DIALOG_STYLE_MSGBOX, "Deseja alugar bike?", "{FFDC33}Voce Deseja alugar uma bike?\n{BEBEBE}Valor de Aluguel da Bike: {00FF00}R$20\n{FFFFFF}Aperte em Alugar para adquirir a sua!\n\ndevolva usando {00FFFF}/eveh", "Alugar", "X");
	        }
	    }

		// barra de acao em andamento //
	    if(Barra[playerid][b_Acao] != 0)
	    {
	        ms(playerid, 2, "Acao cancelada !");
	        Carregando(playerid, 2);
			return 1;
	    }

	    // tunando na oficina //
	    if(tunando[playerid] == 1)
	    {
	        menu_tuning(playerid);
	        return 1;
	    }

	    // olhando cameras de caixa ou de seguranca //
	    if(olhando_camera[playerid] != -1)
	    {
            menu_cameras(playerid);
	        return 1;
	    }

		// jbl //
		foreach(new a:Iter_JBL)
		{
		    if(JBL[a][jbl_Existe] == 1)
		    {
		        if(IsPlayerInRangeOfPoint(playerid, 1.5, JBL[a][jbl_X], JBL[a][jbl_Y], JBL[a][jbl_Z]))
		        {
		            ClearAnimations(playerid, 1);
		            abrir_jbl(playerid, a);
					return 1;
		        }
		    }
		}

	    // elevadores //
	    new Float:p[4];
	    foreach(new e:Iter_Elevadores)
	    {
	        if(Elevador[e][ele_Existe] == 1)
	        {
	            for(new a; a<MAX_ANDARES; a++)
	            {
		            if(Elevador[e][ele_a_Existe][a] == 1)
		            {
		                p[0] = Elevador[e][ele_a_X][a];
		                p[1] = Elevador[e][ele_a_Y][a];
		                p[2] = Elevador[e][ele_a_Z][a];
		                p[3] = Elevador[e][ele_a_A][a];
		                PegarFrente(p[0], p[1], p[3], -2);
						p[3] += 90.0;
						if(p[3] > 360.0) p[3] -= 360.0;
						PegarFrente(p[0], p[1], p[3], 2);
						if(IsPlayerInRangeOfPoint(playerid, 2, p[0], p[1], p[2]))
						{
						    ClearAnimations(playerid, 1);
						    player_elevador(playerid, e, a);
						    return 1;
						}
		            }
	            }
	        }
	    }

	    // casas //
		foreach(new casa:Iter_Casas)
	    {
	        if(Casa[casa][casa_Existe] == 1)
	        {
	            if(IsPlayerInRangeOfPoint(playerid, 1.2, Casa[casa][casa_X1], Casa[casa][casa_Y1], Casa[casa][casa_Z1]))
	           	{
	            	if(GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld_(playerid) == 0)
	            	{
	                    if(c != Casa[casa][casa_Dono] )
	                    {
	                        // se tiver a venda //
	                        if(Casa[casa][casa_Venda] == 0 && Casa[casa][casa_Dono] == -1) Casa[casa][casa_Venda] = 1;
	                        if(Casa[casa][casa_Venda] == 1)
	                        {
	                            mostrar_entrar_casa(playerid, casa);
	                            return 1;
	                        }
	                        else if(Casa[casa][casa_Chave] == 1 && Casa[casa][casa_Dono] != -1)
	                        {
	                            if(id[playerid] == Casa[casa][casa_Dono] || TemChaveCasa(playerid, casa))
	                            {
	                                SetPlayerPos_(playerid, Casa[casa][casa_X2]+0.1, Casa[casa][casa_Y2]+0.1, Casa[casa][casa_Z2]+0.1);
									SetPlayerInterior(playerid, Casa[casa][casa_Interior]);
									SetPlayerVirtualWorld_(playerid, Casa[casa][casa_Mundo]);
									OnPlayerInteriorChange(playerid, Casa[casa][casa_Interior], 0);
	                            }
	                            else
	                            {
	                                GameTextForPlayer(playerid, "~r~~h~CASA TRANCADA", 1500, 3);
	                                ms(playerid, 0, "Esta casa esta trancada !");
	                            }
	                            return 1;
	                        }
	                        else
	                        {
	                            SetPlayerPos_(playerid, Casa[casa][casa_X2]+0.1, Casa[casa][casa_Y2]+0.1, Casa[casa][casa_Z2]+0.1);
								SetPlayerInterior(playerid, Casa[casa][casa_Interior]);
								SetPlayerVirtualWorld_(playerid, Casa[casa][casa_Mundo]);
								OnPlayerInteriorChange(playerid, Casa[casa][casa_Interior], 0);
								return 1;
	                        }
	                    }
	                    else
	                    {
		                    SetPlayerPos_(playerid, Casa[casa][casa_X2]+0.1, Casa[casa][casa_Y2]+0.1, Casa[casa][casa_Z2]+0.1);
							SetPlayerInterior(playerid, Casa[casa][casa_Interior]);
							SetPlayerVirtualWorld_(playerid, Casa[casa][casa_Mundo]);
							OnPlayerInteriorChange(playerid, Casa[casa][casa_Interior], 0);
							return 1;
						}
	                }
	            }

				if(GetPlayerInterior(playerid) == Casa[casa][casa_Interior] && GetPlayerVirtualWorld_(playerid) == Casa[casa][casa_Mundo])
            	{
		            if(IsPlayerInRangeOfPoint(playerid, 1.2, Casa[casa][casa_X2], Casa[casa][casa_Y2], Casa[casa][casa_Z2]))
		           	{
	           			SetPlayerPos_(playerid, Casa[casa][casa_X1]+0.1, Casa[casa][casa_Y1]+0.1, Casa[casa][casa_Z1]+0.1);
						SetPlayerInterior(playerid, 0);
						SetPlayerVirtualWorld_(playerid, 0);
						OnPlayerInteriorChange(playerid, 0, Casa[casa][casa_Interior]);
						return 1;
	           	    }
	           	}
	        }
    	}

    	// empresas //
    	if(GetPVarInt(playerid, "flood_teleporte") < gettime())
    	{
    	    foreach(new i:Iter_Empresas)
			{
    	        if(Empresa[i][em_Existe] == 1)
    	        {
                    // cofre //
                    if(Empresa[i][em_Tipo] == 1)
                    {
	           			if(IsPlayerInRangeOfPoint(playerid, 1.5, Empresa[i][em_X3], Empresa[i][em_Y3], Empresa[i][em_Z3]))
					{
							SetPlayerPos_(playerid, 2145.6587, 1597.5542, 999.7676);
				        SetPlayerInterior(playerid, 1);
				        SetPlayerVirtualWorld_(playerid, i);
				        OnPlayerInteriorChange(playerid, GetPlayerInterior(playerid), GetPlayerInterior(playerid));
				        MS(playerid, 1, "Voce entrou no Cofre da Empresa.");
				        debug_mundo(playerid);
					}
				}

				// entrada //
           			if(IsPlayerInRangeOfPoint(playerid, 1.5, Empresa[i][em_X], Empresa[i][em_Y], Empresa[i][em_Z]))
				{
				    if(GetPlayerInterior(playerid) == 0)
					{
				        if(GetPlayerVirtualWorld_(playerid) == 0)
				    	{
				    	    if(Empresa[i][em_Tipo] == 0)
				    	    {
				    	        // com interior //
					    	    ClearAnimations(playerid, 1);
					    	    dialog_empresa(playerid, i);
					    	    SetPVarInt(playerid, "flood_teleporte", gettime()+1);
				    	    }
				    	    else
				    	    {
				    	        // sem interior //
				    	        if(Empresa[i][em_Dono] == -1)
									{
									    if(GranaPlayer(playerid) >= Empresa[i][em_Valor])
										{
										continuar_comprar_empresa(playerid, i);
									    }
									    else
										{
										new sss[150];
										format(sss, 150, "Voce nao possue R$ %s em maos, para comprar esta Empresa !", ConvertMoney(Empresa[i][em_Valor]));
											MS(playerid, 0, sss);
									    }
									}
				    	    }
				    	    return 1;
				    	}
				    }
    	            }

					// saida //
					if(Empresa[i][em_Tipo] == 0)
					{
	    	            if(IsPlayerInRangeOfPoint(playerid, 1.5, Empresa[i][em_X2], Empresa[i][em_Y2], Empresa[i][em_Z2]))
					{
					    if(GetPlayerInterior(playerid) == Empresa[i][em_Interior])
						{
					        if(GetPlayerVirtualWorld_(playerid) == i)
					    	{
					    	    SetPlayerPos_(playerid, Empresa[i][em_X]+0.1, Empresa[i][em_Y]+0.1, Empresa[i][em_Z]+0.1);
	                                SetPlayerInterior(playerid, 0);
	                                SetPlayerVirtualWorld_(playerid, 0);
	                                SetPVarInt(playerid, "flood_teleporte", gettime()+2);
	                                OnPlayerInteriorChange(playerid, GetPlayerInterior(playerid), GetPlayerInterior(playerid));
	                                debug_mundo(playerid);
	                                return 1;
								}
							}
						}
					}
    	        }
    	    }
    	}

		// teleportes //
		if(GetPVarInt(playerid, "flood_teleporte") < gettime())
		{
			foreach(new t:Iter_Teleportes)
			{
			    if(Teleporte[t][t_Existe] == 1)
				{
				// entrada //
           			if(IsPlayerInRangeOfPoint(playerid, 1.5, Teleporte[t][t_X1], Teleporte[t][t_Y1], Teleporte[t][t_Z1]))
				{
				    if(GetPlayerInterior(playerid) == Teleporte[t][t_Interior1])
					{
				        if(GetPlayerVirtualWorld_(playerid) == Teleporte[t][t_Mundo1])
				    	{
				    	    if(Teleporte[t][t_X2] != 0 && Teleporte[t][t_Y2] != 0 && Teleporte[t][t_Z2] != 0)
				    	    {
				    	        SetPlayerPos_(playerid, Teleporte[t][t_X2]+0.1, Teleporte[t][t_Y2]+0.1, Teleporte[t][t_Z2]+0.1);
                                    SetPlayerInterior(playerid, Teleporte[t][t_Interior2]);
                                    SetPlayerVirtualWorld_(playerid, Teleporte[t][t_Mundo2]);
                                    SetPVarInt(playerid, "flood_teleporte", gettime()+2);
                                    OnPlayerInteriorChange(playerid, GetPlayerInterior(playerid), GetPlayerInterior(playerid));
				    	    }
				    	    else ms(playerid, 0, "Este teleporte ainda nao tem uma saida definida !");
				    	    return 1;
				        }
				    }
				}

				// saida //
				if(IsPlayerInRangeOfPoint(playerid, 1.5, Teleporte[t][t_X2], Teleporte[t][t_Y2], Teleporte[t][t_Z2]))
				{
				    if(GetPlayerInterior(playerid) == Teleporte[t][t_Interior2])
					{
				        if(GetPlayerVirtualWorld_(playerid) == Teleporte[t][t_Mundo2])
				    	{
				    	    if(Teleporte[t][t_X1] != 0 && Teleporte[t][t_Y1] != 0 && Teleporte[t][t_Z1] != 0)
				    	    {
				    	        SetPlayerPos_(playerid, Teleporte[t][t_X1]+0.1, Teleporte[t][t_Y1]+0.1, Teleporte[t][t_Z1]+0.1);
                                    SetPlayerInterior(playerid, Teleporte[t][t_Interior1]);
                                    SetPlayerVirtualWorld_(playerid, Teleporte[t][t_Mundo1]);
                                    SetPVarInt(playerid, "flood_teleporte", gettime()+2);
                                    OnPlayerInteriorChange(playerid, GetPlayerInterior(playerid), GetPlayerInterior(playerid));
				    	    }
				    	    else ms(playerid, 0, "Este teleporte ainda nao tem uma entrada definida !");
				    	    return 1;
				        }
				    }
				}
			    }
			}
		}

		// sair do cofre d empresa //
		if(IsPlayerInRangeOfPoint(playerid, 1.5, 2145.6587, 1597.5542, 999.7676))
		{
	        if(GetPlayerInterior(playerid) == 1)
	        {
	            new i = GetPlayerVirtualWorld_(playerid);
	            if(i >= 0 && i < MAX_EMPRESAS)
	            {
	                if(Empresa[i][em_Tipo] == 0)
	                {
				    SetPlayerPos_(playerid, Empresa[i][em_X]+0.1, Empresa[i][em_Y]+0.1, Empresa[i][em_Z]+0.1);
		                SetPlayerInterior(playerid, 0);
		                SetPlayerVirtualWorld_(playerid, 0);
		                OnPlayerInteriorChange(playerid, GetPlayerInterior(playerid), GetPlayerInterior(playerid));
		                MS(playerid, 1, "Voce saiu do Cofre !");
		                debug_mundo(playerid);
	                }
	                else
	                {
	                    SetPlayerPos_(playerid, Empresa[i][em_X3]+0.1, Empresa[i][em_Y3]+0.1, Empresa[i][em_Z3]+0.1);
		                SetPlayerInterior(playerid, 0);
		                SetPlayerVirtualWorld_(playerid, 0);
		                OnPlayerInteriorChange(playerid, GetPlayerInterior(playerid), GetPlayerInterior(playerid));
		                MS(playerid, 1, "Voce saiu do Cofre !");
		                debug_mundo(playerid);
	                }
	                return 1;
                }
			}
		}

	    // menu das orgs //
	    if(GetPlayerInterior(playerid) == 0 && GetPlayerVirtualWorld_(playerid) == 0)
	    {
	        foreach(new i:Iter_Orgs)
	        {
		    	if(Org[i][o_Existe] == 1)
				{
					if(IsPlayerInRangeOfPoint(playerid, 2, Org[i][o_X], Org[i][o_Y], Org[i][o_Z]))
					{
						abrir_org(playerid, i);
						return 1;
					}
				}
			}
	    }

	    // cancelar academia //
	    if(academia_player[playerid] != -1)
	    {
	        new i = academia_player[playerid];
            academia_player[playerid] = -1;
            ms(playerid, 1, "Voce saiu do aparelho de academia.");
			sair_academia(playerid, i);
	        return 1;
	    }

	    // caixa eletronico //
	    foreach(new i:Iter_CaixasEletronicos)
	    {
	        if(CaixaEletronico[i][ce_Existe] == 1)
	        {
	            if(IsPlayerInRangeOfPoint(playerid, 2, CaixaEletronico[i][ce_X], CaixaEletronico[i][ce_Y], CaixaEletronico[i][ce_Z] ))
	            {
					if(GetPlayerInterior(playerid) == CaixaEletronico[i][ce_Interior] && GetPlayerVirtualWorld_(playerid) == CaixaEletronico[i][ce_Mundo])
					{
	                    if(CaixaEletronico[i][ce_Quebrado] == 0)
	                    {
	                        if(Conta[playerid][c_Pix] < 1)
							{
								MS(playerid, 0, "Voce deve criar uma conta no banco para poder usar os caixas eletronicos !");
						    }
						    else
							{
							ClearAnimations(playerid, 1);
							SetPVarInt(playerid, "ce", i);
							AbrirBanco(playerid, 0);
						    }
						    return 1;
						}
	                }
	            }
	        }
	    }

		// quebrando arvore ou pedra //
    	if(craft_tipo[playerid] != 0)
	    {
			ms(playerid, 2, "Acao cancelada !");
	        craft_tipo[playerid] = 0;
	        ClearAnimations(playerid, 1);
	        for(new i; i<sizeof T_Craft; i++) TextDrawHideForPlayer(playerid, T_Craft[i]);
			return 1;
	    }

		// pegar item do chao //
		if(!IsPlayerInAnyVehicle(playerid))
		{
		    if(GetPVarInt(playerid, "flood_items") <= gettime())
		    {
		        SetPVarInt(playerid, "flood_items", gettime()+1);
			    foreach(new it:Iter_Itens)
				{
				if(Item[it][item_Existe] == 1)
				{
					if(IsPlayerInRangeOfPoint(playerid, 5.0, Item[it][item_X],Item[it][item_Y],Item[it][item_Z]))
						{
					    if(GetPlayerInterior(playerid) == Item[it][item_Interior])
						{
					        if(GetPlayerVirtualWorld_(playerid) == Item[it][item_Mundo])
							{
						        if(Item[it][item_ID] == 49)
									{
										if(Item[it][item_Tipo] == -1)
										{
											if(!alguem_pegando(it))
											{
								        	ApplyAnimation(playerid, "BOMBER", "BOM_PLANT_2IDLE", 4.1, false, false, false, false, 0, 0);
											recolherinv(playerid, it);
										}
											else continue;
										}
										else
										{
							        	ApplyAnimation(playerid, "BOMBER", "BOM_PLANT_2IDLE", 4.1, false, false, false, false, 0, 0);
										recolherinv(playerid, it);
									}
									}
									else
									{
						        	ApplyAnimation(playerid, "BOMBER", "BOM_PLANT_2IDLE", 4.1, false, false, false, false, 0, 0);
									recolherinv(playerid, it);
								}
								return 1;
						    }
					    }
				    }
		            }
			    }
			}
		}

		// fumando //
		if(fumando[playerid] == 1)
		{
			if(!IsPlayerInAnyVehicle(playerid) && em_anim[playerid] == 0 && ID_Dancando[playerid] == -1 && Barra[playerid][b_Acao] == 0 && olhando_camera[playerid] == -1 )
	        {
		        fumando[playerid] = 0;
		        ms(playerid, 3, "Voce jogou o cigarro aceso fora.");
		        ApplyAnimation(playerid, "SMOKING", "M_SMK_OUT", 4.1, false, false, false, false, 0, 1);
		        fumar(playerid);
		        return 1;
	        }
        }
	}


	if(newkeys == KEY_WALK)
	{

		// casas //
		foreach(new casa:Iter_Casas)
	    {
	        if(Casa[casa][casa_Existe] == 1)
	        {
	           	if(GetPlayerInterior(playerid) == Casa[casa][casa_Interior] && GetPlayerVirtualWorld_(playerid) == Casa[casa][casa_Mundo])
            	{
		            if(IsPlayerInRangeOfPoint(playerid, 1.2, Casa[casa][casa_X3], Casa[casa][casa_Y3], Casa[casa][casa_Z3]))
		           	{
						if(Casa[casa][casa_Dono] != c) MS(playerid, 0, "Voce nao e o Dono dessa Casa, nao pode usar o Bau !");
						else
						{
							// abrir porta malas //
							SetPVarInt(playerid, "id_bau", casa);
					    	ShowPlayerDialog(playerid, DIALOG_OPCAO_BAU, DIALOG_STYLE_LIST, f("{ffff00}Bau da Casa: {ffffff}%d", casa), "Pegar Item\nGuardar Item", "Continuar", "Cancelar");
						}
						return 1;
					}
				}
			}
		}	
	
	    // pe de maconha //
		new m = maconha_perto(playerid);
	    if(m != -1)
	    {

	        if(PlayerCop(playerid))
	        {
	            SetPlayerToFacePos(playerid, Maconha[m][mac_X], Maconha[m][mac_Y]);
	            format(string_prox, 300, "** '%s' destruiu um Pe de Maconha **", Nome(playerid));
				ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
				ApplyAnimation(playerid,"BOMBER", "BOM_PLANT_CROUCH_OUT", 4.1, false, false, false, false, 0, 1);
				Maconha[m][mac_Existe] = 0;
				new idd = Maconha[m][mac_Dono];
				if(idd != -1) msc(idd, 2, "Um policial destruiu seu Pe de Maconha !");
				atualizar_maconha(m);
				salvar_maconha(m);
	            return 1;
	        }

	        if(Maconha[m][mac_Existe] == 2)
	        {
             	SetPlayerToFacePos(playerid, Maconha[m][mac_X], Maconha[m][mac_Y]);
	            format(string_prox, 300, "** '%s' limpou um Pe de Maconha morto **", Nome(playerid));
				ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
				ApplyAnimation(playerid,"BOMBER", "BOM_PLANT_CROUCH_OUT", 4.1, false, false, false, false, 0, 1);
				Maconha[m][mac_Existe] = 0;
				atualizar_maconha(m);
				salvar_maconha(m);
				return 1;
	        }

	        if(Maconha[m][mac_Existe] == 1)
	        {
	            if(Maconha[m][mac_Status] == 5)
	            {
	                if(Maconha[m][mac_Dono] == id[playerid])
	                {
		                SetPVarInt(playerid, "mac", m);
		                SetPlayerToFacePos(playerid, Maconha[m][mac_X], Maconha[m][mac_Y]);
		       			Acao(playerid, 16, 400, "COLHENDO MACONHA", 1, "COP_AMBIENT",  "COPBROWSE_LOOP", true);
					}
					else ms(playerid, 0, "Voce nao e o dono dessa maconha !");
					return 1;
	            }
	        }
	    }

		// emprego de lenhador //
		if(EmpregoPlayer(playerid) == 4)
		{
		    if(GetPVarInt(playerid, "flood_craft") <= gettime())
		    {
		        SetPVarInt(playerid, "flood_craft", gettime()+1);
		    	foreach(new a:Iter_Arvores)
				{
				    if(Arvore[a][ar_Existe] == 1)
					{
					if(Arvore[a][ar_Vida] >= 0)
					{
					    if(IsPlayerInRangeOfPoint(playerid, 2, Arvore[a][ar_X], Arvore[a][ar_Y], Arvore[a][ar_Z]))
					    	{
							if(GetPlayerInterior(playerid) == Arvore[a][ar_Interior] && GetPlayerVirtualWorld_(playerid) == Arvore[a][ar_Mundo])
							{
								    if(GetPlayerWeapon(playerid) == 9)
									{
									    ClearAnimations(playerid, 1);
									    craft_arma[playerid] = GetPlayerWeapon(playerid);
									craft_tipo[playerid] = 1;
									craft_player[playerid] = 0;
									craft_id[playerid] = a;
									TextDrawShowForPlayer(playerid, T_Craft[0]);
									TextDrawShowForPlayer(playerid, T_Craft[10]);
									TextDrawShowForPlayer(playerid, T_Craft[11]);
									TextDrawShowForPlayer(playerid, T_Craft[12]);
									ApplyAnimation(playerid, "FLOWERS", "FLOWER_ATTACK_M", 4.1, true, true, true, false, 0, 1);
									SetPlayerAngleToPoint(playerid, Arvore[a][ar_X], Arvore[a][ar_Y]);
									return 1;
							    }
							    else
									{
										ms(playerid, 0, "Voce precisa de uma Moto Serra para fazer isso !");
										return 1;
									}
					        }
					    }
				    }
				}
			    }
		    }
	    }

	    // emprego de Minerador //
	    if(EmpregoPlayer(playerid) == 5)
		{
		    if(GetPVarInt(playerid, "flood_craft") <= gettime())
		    {
		        SetPVarInt(playerid, "flood_craft", gettime()+1);
			    foreach(new b:Iter_Pedras)
				{
				    if(Pedra[b][pe_Existe] == 1)
					{
					if(Pedra[b][pe_Vida] >= 0)
					{
					    if(IsPlayerInRangeOfPoint(playerid, 2, Pedra[b][pe_X], Pedra[b][pe_Y], Pedra[b][pe_Z]))
					    	{
							if(GetPlayerInterior(playerid) == Pedra[b][pe_Interior] && GetPlayerVirtualWorld_(playerid) == Pedra[b][pe_Mundo])
							{
								    if(GetPlayerWeapon(playerid) == 6)
									{
									    ClearAnimations(playerid, 1);
									    craft_arma[playerid] = GetPlayerWeapon(playerid);
									craft_tipo[playerid] = 2;
									craft_player[playerid] = 0;
									craft_id[playerid] = b;
									TextDrawShowForPlayer(playerid, T_Craft[0]);
									TextDrawShowForPlayer(playerid, T_Craft[10]);
									TextDrawShowForPlayer(playerid, T_Craft[11]);
									TextDrawShowForPlayer(playerid, T_Craft[12]);
									ApplyAnimation(playerid, "BASEBALL", "BAT_4", 4.1, true, true, true, false, 0, 1);
									SetPlayerAngleToPoint(playerid, Pedra[b][pe_X], Pedra[b][pe_Y]);
									return 1;
							    }
							    else
									{
										ms(playerid, 0, "Voce precisa de uma Pa para fazer isso !");
										return 1;
									}
					        }
					    }
				    }
				}
			    }
		    }
	    }

		// trabalho eletricista //
		new Float:pls[3];
		if(EmpregoPlayer(playerid) == 10)
		{
			foreach(new a:Vehicles)
			{
		        if(GetVehicleModel(a) != 0)
		        {
		            new inf = Info_Veiculo[a];
		            if(inf != -1)
		            {
		                if(Veiculo[inf][v_Emprego] == 10)
		                {
							GetVehiclePos(a, pls[0], pls[1], pls[2]);
		                    if(IsPlayerInRangeOfPoint(playerid, 5, pls[0], pls[1], pls[2]))
		                    {
		                        menu_escada(playerid, a);
		                        return 1;
		                    }
		                }
		            }
		        }
		    }
		}

		if(fumando[playerid] == 1)
	    {
	        if(GetPVarInt(playerid, "flood_trago") < gettime())
	        {
	            if(!IsPlayerInAnyVehicle(playerid) && em_anim[playerid] == 0 && ID_Dancando[playerid] == -1 && Barra[playerid][b_Acao] == 0 && olhando_camera[playerid] == -1 )
	            {
				ApplyAnimation(playerid, "SMOKING", "M_SMK_OUT", 4.1, false, false, false, false, 0, 1);
					SetPVarInt(playerid, "flood_trago", gettime()+2);
					fumar(playerid);
				return 1;
		        }
	        }
	    }

	}

	return -12345;
}

public OnPlayerUpdate(playerid)
{
    AFK[playerid] = gettime();
    if(logado[playerid] == 0) return 1;
    new conta = id[playerid];
	if(conta != -1)
	{
	    new armd = GetPlayerWeapon(playerid);
	    if(armd != Arma_Player[playerid])
		{
		    Arma_Player[playerid] = armd;
		    armas_costas(playerid);
		}
	    if(segurando_player[playerid] != -1 || player_rendido[playerid] == 1 || player_arrastado[playerid] != -1 || player_algemado[playerid] == 1 || player_amarrado[playerid] == 1)
	    {
	        if(armd != 0)
	        {
	        	SetPlayerArmedWeapon(playerid, 0);
	        }
	    }
    }
	return 1;
}


// ============================================================
// BCG CEF BRIDGE - LOGIN / REGISTRO
// Interface Chromium Android -> ChatWindow nativo -> ZCMD -> GM
// ============================================================
CMD:bcgcef_login(playerid, params[])
{
    if(logado[playerid] == 1) return 1;
    new conta, senhaDigitada[32];
    if(sscanf(params, "ds[32]", conta, senhaDigitada)) return ms(playerid, 0, "CEF: dados de login invalidos."), 1;
    if(conta < 0 || !ContaValida(conta)) return ms(playerid, 0, "CEF: conta nao encontrada."), 1;
    if(strlen(senhaDigitada) < 4 || strlen(senhaDigitada) > 15) return ms(playerid, 0, "CEF: senha invalida."), 1;
    new senhaConta[40];
    format(senhaConta, sizeof senhaConta, "%s", GetContaString(conta, "c_Senha"));
    if(!Comparar(senhaDigitada, senhaConta)) return ms(playerid, 0, "CEF: senha incorreta."), 1;
    SetPVarInt(playerid, "conta", conta);
    if(Banido(playerid, conta))
    {
        new ipplayer[20]; GetPlayerIp(playerid, ipplayer, sizeof ipplayer);
        salvar_conta(conta, 2, "c_IP", ipplayer);
        return 1;
    }
    if(carregou_texts[playerid] == 0) CriarTextDrawsPlayer(playerid);
    contas[playerid] = conta;
    DeletePVar(playerid, "BCG_UI_AUTH");
    setar_lobby(playerid);
    ms(playerid, 5, "Login realizado com sucesso.");
    return 1;
}

CMD:bcgcef_findid(playerid, params[])
{
    if(logado[playerid] == 1) return 1;
    new nick[MAX_PLAYER_NAME];
    if(sscanf(params, "s[24]", nick)) return ms(playerid, 0, "BCG UI: informe o nick cadastrado."), 1;
    if(!VerificarNick(nick)) return ms(playerid, 0, "BCG UI: nick invalido."), 1;
    new achou = -1;
    for(new c = 0; c < MAX_CONTAS; c++)
    {
        if(!ContaValida(c)) continue;
        if(!strcmp(NomeConta(c), nick, true)) { achou = c; break; }
    }
    if(achou == -1) return ms(playerid, 0, "BCG UI: nenhuma conta encontrada com esse nick."), 1;
    new out[96];
    format(out, sizeof out, "BCG UI: seu ID de conta e %d.", achou);
    ms(playerid, 5, out);
    return 1;
}

CMD:bcgcef_status(playerid, params[])
{
    #pragma unused params
    new out[128];
    format(out, sizeof out, "BCG UI: auth=%d logado=%d conta=%d", GetPVarInt(playerid, "BCG_UI_AUTH"), logado[playerid], id[playerid]);
    ms(playerid, 5, out);
    return 1;
}

CMD:bcgcef_register(playerid, params[])
{
    if(logado[playerid] == 1) return 1;
    new sexo, idade, cidade, skin, nick[MAX_PLAYER_NAME], senhaNova[16];
    if(sscanf(params, "dddds[24]s[16]", sexo, idade, cidade, skin, nick, senhaNova)) return ms(playerid, 0, "CEF: dados de registro incompletos."), 1;
    if(sexo < 0 || sexo > 1) return ms(playerid, 0, "CEF: sexo invalido."), 1;
    if(idade < 18 || idade > 80) return ms(playerid, 0, "CEF: idade invalida."), 1;
    if(cidade < 0 || cidade > 2) return ms(playerid, 0, "CEF: cidade invalida."), 1;
    if(skin < 0 || skin > 4) return ms(playerid, 0, "CEF: skin invalida."), 1;
    if(strlen(senhaNova) < 5 || strlen(senhaNova) > 15) return ms(playerid, 0, "CEF: a senha deve ter entre 5 e 15 caracteres."), 1;
    if(!VerificarNick(nick)) return ms(playerid, 0, "CEF: nick invalido. Use o padrao Nome_Sobrenome."), 1;

    new cc = criar_conta(nick, cidade, sexo, idade, skin, senhaNova, -1);
    if(cc == -1) return ms(playerid, 0, "CEF: nao foi possivel criar a conta."), 1;
    if(carregou_texts[playerid] == 0) CriarTextDrawsPlayer(playerid);
    fechar_criar_conta_lobby(playerid);
    contas[playerid] = cc;
    SetPVarInt(playerid, "conta", cc);
    DeletePVar(playerid, "BCG_UI_AUTH");
    setar_lobby(playerid);
    new cefmsg[128];
    format(cefmsg, sizeof cefmsg, "Conta criada pelo BCG CEF. Seu ID e %d. Guarde este numero.", cc);
    ms(playerid, 5, cefmsg);
    return 1;
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
    new c = id[playerid];
    if(Player_AFK(playerid)) return 1;
	if(listitem < 0 ) listitem = 0;

	// BCG: editor de pickup por dialogs - evita decorar numeros/comandos
	if(dialogid == DIALOG_PICKUP_FUNCAO_ID)
	{
	    if(!response) return 1;
	    new pid = strval(inputtext);
	    if(pid < 0 || pid >= MAX_PICKUP || Pickup[pid][pick_Existe] == 0)
	        return ShowPlayerDialog(playerid, DIALOG_PICKUP_FUNCAO_ID, DIALOG_STYLE_INPUT, "{E53935}BCG | Funcao do Pickup", "{FFFFFF}Pickup invalido.\n\nDigite o {E53935}ID do pickup{FFFFFF} que deseja configurar:", "Continuar", "Cancelar");
	    SetPVarInt(playerid, "BCG_PickupEdit", pid);
	    new pinfo[420];
	    format(pinfo, sizeof pinfo, "Funcao\tDescricao\n{FFFFFF}Sem funcao\tRemove o ponto de funcao atual\n{E53935}Definir neste local\tUsa sua posicao atual como ponto de funcao");
	    ShowPlayerDialog(playerid, DIALOG_PICKUP_FUNCAO_LISTA, DIALOG_STYLE_TABLIST_HEADERS, "{E53935}BCG | Configurar Pickup", pinfo, "Aplicar", "Voltar");
	    return 1;
	}
	if(dialogid == DIALOG_PICKUP_FUNCAO_LISTA)
	{
	    if(!response)
	        return ShowPlayerDialog(playerid, DIALOG_PICKUP_FUNCAO_ID, DIALOG_STYLE_INPUT, "{E53935}BCG | Funcao do Pickup", "{FFFFFF}Digite o ID do pickup:", "Continuar", "Cancelar");
	    new pid = GetPVarInt(playerid, "BCG_PickupEdit");
	    if(pid < 0 || pid >= MAX_PICKUP || Pickup[pid][pick_Existe] == 0) return ms(playerid, 0, "Pickup invalido ou removido.");
	    if(listitem == 0)
	    {
	        Pickup[pid][pick_Funcao] = 0;
	        Pickup[pid][pick_X1] = 0.0; Pickup[pid][pick_Y1] = 0.0; Pickup[pid][pick_Z1] = 0.0;
	        salvar_pickup(pid);
	        DeletePVar(playerid, "BCG_PickupEdit");
	        return ms(playerid, 5, "Funcao do pickup removida com sucesso.");
	    }
	    Pickup[pid][pick_Funcao] = 1;
	    GetPlayerPos(playerid, Pickup[pid][pick_X1], Pickup[pid][pick_Y1], Pickup[pid][pick_Z1]);
	    salvar_pickup(pid);
	    DeletePVar(playerid, "BCG_PickupEdit");
	    return ms(playerid, 5, "Funcao do pickup definida na sua posicao atual.");
	}

	if(dialogid == DIALOG_INPUT)
	{
	    DI_Resposta(playerid, response, inputtext);
		return 1;
	}
	if(dialogid == DIALOG_FUNCOESRE){
		if(response){
			switch(listitem){
				case 0:
				{
					if(logado[playerid] != 1)
				{
				    tempo_login[playerid] = -1;
				    Login(playerid);
				}
				}
				case 1:
				{
					if(logado[playerid] != 1)
				{
				    tempo_login[playerid] = -1;
				    new ipplayer[20];
				    GetPlayerIp(playerid, ipplayer, 20);
				    new file[80];
				    format(file, 80, "IPS_Banidos/%s.txt", ipplayer);
				    if(DOF2_FileExists(file))
					{
				        format(str_ban[playerid], 1000, "\n\
				        \
				        {ff0000}ESTE IP ESTA BANIDO !\n\
				        \n\
				        {ffffff}Admin: {a1a1a1}%s\n\
				        {ffffff}Conta: {a1a1a1}%s\n\
				        \n\
				        {a1a1a1}Quando uma conta e banida, o IP logado tambem sera banido\n\
				        evitando a criacao de outra conta pelo mesmo IP, entre em contato com\n\
				        um admin para resolver isso.\
				        \
				        ", NomeConta(DOF2_GetInt(file, "c_Ban_Admin")),  NomeConta(DOF2_GetInt(file, "c_Ban_Conta")));
				        ShowPlayerDialog(playerid, DIALOG_IPBANIDO, DIALOG_STYLE_MSGBOX, "{000000}_", str_ban[playerid], "Ok", "Voltar");
				        return 1;
				    }
				    Registro(playerid);
				}
				}
				case 2: 
				{
					if(logado[playerid] != 1)
				{
				    tempo_login[playerid] = -1;
				    meuid(playerid);
				}
				}
			}
		}
		else{
			SSM(playerid, -1, "Voce nao tem esta opcao, volte em breve!");
			Kick(playerid);
		}
	}
	if(dialogid == DIALOG_ASSALTAR)
    {
        if(response)
        {
            new string[550];
            DarGrana(IDVenda[playerid], GranaPlayer(playerid));
            SetarGrana(playerid, 0);

            format(string, sizeof(string), "{BEBEBE}* O ID:[%d] assaltou o jogador ID:[%d].", id[IDVenda[playerid]], id[playerid]);
            ProxDetector(20.0, playerid, string, -1,-1,-1,-1,-1);

            GameTextForPlayer(IDVenda[playerid], "~w~Player ~g~assaltado!", 1200, 6);
            GameTextForPlayer(playerid, "~w~assaltado!", 1200, 4);
            // Tirando var
            IDVenda[playerid] = -1;
        }
        else
        {
            SSM(IDVenda[playerid], -1, "{FF0000}[SERVER]: O jogador recusou seu assalto..");
            IDVenda[playerid] = 0;
            SSM(playerid, -1, "{FF0000}[SERVER]: Voce recusou o assalto.");
        }
    }
	if(dialogid == DIALOG_ALUGUELB)
    {
        if(response)
        {
            for(new i; i < sizeof(LocaisSpawns); i++)
            {
                if(ISP(playerid, 5.0, LocaisSpawns[i][0], LocaisSpawns[i][1], LocaisSpawns[i][2]))
                {
                    if(BikeAlugada[playerid] == 0)
                    {
                        if(GranaPlayer(playerid) >= 20)
                        {
                            BikeAlugada[playerid] = 1;
                            VeiculoCivil[playerid] = CreateVehicle(481, LocaisSpawns[i][0], LocaisSpawns[i][1], LocaisSpawns[i][2], -180.0000, 1, 1, 24000000);
                            PutPlayerInVehicle(playerid, VeiculoCivil[playerid], 0);
                            SSM(playerid, -1, "{BEBEBE}[ALUGUEL BCG] Voce alugou uma bike pelo valor de: {00FF00}R$20,00");
                            DarGrana(playerid, -20);
                        }
                        else
                        {
                            SSM(playerid, -1, "{FF0000}* {E5EEFD}Voce nao tem dinheiro o suficiente.");
                        }
                    }
                    else
                    {
                        SSM(playerid, -1, "{FF0000}* {E5EEFD}Voce ja tem Bike Alugada.");
                    }
                }
            }
        }
    }

	if(dialogid == DIALOG_CUPOM_CRIAR)
	{
	    if(response)
	    {
	        if(strlen(inputtext) < 1) return ms(playerid, 0, "Digite um codigo !");
	        new i = GetPVarInt(playerid, "editando_cupom");
	        for(new cc; cc<MAX_CUPONS; cc++) if(Cupom[cc][cup_Existe] == 1 && !strcmp(Cupom[cc][cup_Codigo], inputtext, true)) return ms(playerid, 0, "Este codigo de cupom ja existe !");
	        format(Cupom[i][cup_Codigo], 30, inputtext);
	        SetPVarInt(playerid, "cupom_max", 0);
	        ShowPlayerDialog(playerid, DIALOG_CUPOM_PREMIOS, DIALOG_STYLE_INPUT, "{ffffff}Maximo de Usos", "{ffffff}Digite o numero maximo de usos para este cupom:", "Continuar", "Cancelar");
	    }
	    return 1;
	}

	if(dialogid == DIALOG_CUPOM_PREMIOS)
	{
	    if(response)
	    {
	        if(!IsNumeric(inputtext)) return ms(playerid, 0, "Digite apenas numeros !");
	        new max_uses = strval(inputtext);
	        if(max_uses < 1 || max_uses > 9999) return ms(playerid, 0, "Digite um valor entre 1 e 9999 !");
	        SetPVarInt(playerid, "cupom_max", max_uses);
	        SetPVarInt(playerid, "cupom_premio_idx", 0);
	        ShowPlayerDialog(playerid, DIALOG_CUPOM_PREMIO_TIPO, DIALOG_STYLE_LIST, "{ffffff}Tipo de Premio", "Cash (premium)\nDinheiro (banco)\nLevel\nVip (dias)\nNada (finalizar)", "Selecionar", "Cancelar");
	    }
	    return 1;
	}

    if(dialogid == DIALOG_CUPOM_PREMIO_TIPO)
	{
	    if(response)
	    {
	        new idx = GetPVarInt(playerid, "cupom_premio_idx");
	        if(idx >= MAX_PREMIOS_CUPOM) return ms(playerid, 0, "Limite de premios atingido !");
	        if(listitem < 4)
	        {
	            SetPVarInt(playerid, "cupom_premio_tipo", listitem + 1);
	            SetPVarInt(playerid, "cupom_premio_idx_temp", idx);
	            ShowPlayerDialog(playerid, DIALOG_CUPOM_PREMIO_VALOR, DIALOG_STYLE_INPUT, "{ffffff}Valor do Premio", "{ffffff}Digite o valor:\n\n{00ffff}Cash Premium: valor em Cash\n{00ffff}Dinheiro (banco): quantia em R$\n{00ffff}Level: quantidade de levels\n{00ffff}Vip: quantidade de dias", "Continuar", "Voltar");
	        }
	        else // Nada = finalizar
	        {
	            new i = GetPVarInt(playerid, "editando_cupom");
	            if(idx == 0) return ms(playerid, 0, "Adicione pelo menos um premio !");
	            Cupom[i][cup_Existe] = 1;
	            Cupom[i][cup_MaxUses] = GetPVarInt(playerid, "cupom_max");
	            Cupom[i][cup_CurrentUses] = 0;
	            for(new p; p<MAX_PREMIOS_CUPOM; p++) { Cupom[i][cup_PremioTipo][p] = GetPVarInt(playerid, f("cupom_tipo_%d", p)); Cupom[i][cup_PremioValor][p] = GetPVarInt(playerid, f("cupom_valor_%d", p)); }
	            salvar_cupom(i);
	            ms(playerid, 1, f("Cupom '%s' criado com sucesso com %d premio(s) !", Cupom[i][cup_Codigo], idx));
	        }
	    }
	    return 1;
	}

	if(dialogid == DIALOG_CUPOM_PREMIO_VALOR)
	{
	    if(response)
	    {
	        if(!IsNumeric(inputtext)) return ms(playerid, 0, "Digite apenas numeros !");
	        new val = strval(inputtext);
	        if(val < 1) return ms(playerid, 0, "Valor invalido !");
	        new idx = GetPVarInt(playerid, "cupom_premio_idx_temp");
	        new tipoo = GetPVarInt(playerid, "cupom_premio_tipo");
	        SetPVarInt(playerid, f("cupom_tipo_%d", idx), tipoo);
	        SetPVarInt(playerid, f("cupom_valor_%d", idx), val);
	        new tiponome[30];
	        if(tipoo == 1) format(tiponome, 30, "Cash");
	        else if(tipoo == 2) format(tiponome, 30, "Dinheiro");
	        else if(tipoo == 3) format(tiponome, 30, "Level");
	        else if(tipoo == 4) format(tiponome, 30, "Vip");
	        ms(playerid, 1, f("Premio %d: %s x %d adicionado !", idx+1, tiponome, val));
	        SetPVarInt(playerid, "cupom_premio_idx", idx + 1);
	        ShowPlayerDialog(playerid, DIALOG_CUPOM_PREMIO_TIPO, DIALOG_STYLE_LIST, "{ffffff}Tipo de Premio (proximo)", "Cash (premium)\nDinheiro (banco)\nLevel\nVip (dias)\nNada (finalizar)", "Selecionar", "Cancelar");
	    }
	    return 1;
	}

	if(dialogid == DIALOG_CUPOM_CONFIRMAR)
	{
	    if(response)
	    {
	        new i = GetPVarInt(playerid, "resgatando_cupom");
		if(Cupom[i][cup_Existe] == 0 || Cupom[i][cup_CurrentUses] >= Cupom[i][cup_MaxUses]) return ms(playerid, 0, "Este cupom nao esta mais disponivel !");
		new cc2 = id[playerid];
		new chave[40];
		if(cc2 != -1)
		{
			new usado[80];
			format(usado, 80, "CuponsUsados/%d.txt", cc2);
			format(chave, 40, "cupom_%s", Cupom[i][cup_Codigo]);
			if(DOF2_FileExists(usado) && DOF2_GetInt(usado, chave) == 1)
				return ms(playerid, 0, "Voce ja resgatou este cupom anteriormente !");
		}
		new ip_arquivo[80], ip_check[20];
		GetPlayerIp(playerid, ip_check, 20);
		for(new ii=0; ii<strlen(ip_check); ii++) if(ip_check[ii] == '.') ip_check[ii] = '_';
		format(ip_arquivo, 80, "CuponsIP/%s.txt", ip_check);
		format(chave, 40, "cupom_%s", Cupom[i][cup_Codigo]);
		if(DOF2_FileExists(ip_arquivo) && DOF2_GetInt(ip_arquivo, chave) == 1)
		    return ms(playerid, 0, "Este cupom ja foi resgatado neste IP !");
		new sss[300];
	        for(new p; p<MAX_PREMIOS_CUPOM; p++)
	        {
	            new tipo = Cupom[i][cup_PremioTipo][p];
	            new val = Cupom[i][cup_PremioValor][p];
	            if(tipo == 0) break;
	            if(tipo == 1) { DarCash(playerid, val); format(sss, 300, "Voce recebeu %s de Cash (premium) !", ConvertMoney(val)); ms(playerid, 1, sss); }
	            else if(tipo == 2) { DarBanco(playerid, val); format(sss, 300, "Voce recebeu R$ %s na conta bancaria !", ConvertMoney(val)); ms(playerid, 1, sss); }
	            else if(tipo == 3) { new niv = Conta[playerid][c_Nivel] + val; Conta[playerid][c_Nivel] = niv; salvar_conta(id[playerid], 0, "c_Nivel", sv_int(Conta[playerid][c_Nivel])); format(sss, 300, "Voce recebeu %d levels !", val); ms(playerid, 1, sss); }
	            else if(tipo == 4) { SetPVarInt(playerid, "vip_temp", gettime()+(val*86400)); format(sss, 300, "Voce recebeu %d dias de VIP !", val); ms(playerid, 1, sss); }
	        }
	        Cupom[i][cup_CurrentUses]++;
	        salvar_cupom(i);
			if(cc2 != -1)
			{
				new usado[80];
				format(usado, 80, "CuponsUsados/%d.txt", cc2);
				if(!DOF2_FileExists(usado)) DOF2_CreateFile(usado);
				format(chave, 40, "cupom_%s", Cupom[i][cup_Codigo]);
				DOF2_SetInt(usado, chave, 1);
				DOF2_SaveFile();
			}
			format(ip_arquivo, 80, "CuponsIP/%s.txt", ip_check);
			if(!DOF2_FileExists(ip_arquivo)) DOF2_CreateFile(ip_arquivo);
			format(chave, 40, "cupom_%s", Cupom[i][cup_Codigo]);
			DOF2_SetInt(ip_arquivo, chave, 1);
			DOF2_SaveFile();
	        ms(playerid, 1, "Cupom resgatado com sucesso !");
	    }
	    return 1;
	}

	// equipar arma com municao //
	if(dialogid == DIALOG_EQUIPAR_MUNICAO)
	{
	    if(response)
	    {
	        new ar = GetPVarInt(playerid, "equip_arma");
	        new slot = GetPVarInt(playerid, "equip_slot");
	        new maximo = GetPVarInt(playerid, "equip_max");
	        new tipo = GetPVarInt(playerid, "equip_tipo");
	        new val = strval(inputtext);
	        if(val < 2 || val > maximo) return ms(playerid, 0, "Quantidade invalida ! Minimo 2.");
	        new restante = val;
	        for(new o; o<MAX_SLOTS; o++)
	        {
	            if(restante <= 0) break;
	            if(Inventario[playerid][o][inv_ID] == 44 || Inventario[playerid][o][inv_ID] == 45 ||
	            Inventario[playerid][o][inv_ID] == 46 || Inventario[playerid][o][inv_ID] == 47 ||
	            Inventario[playerid][o][inv_ID] == 48)
	            {
	                if(tipo == Inventario[playerid][o][inv_Tipo])
	                {
	                    if(Inventario[playerid][o][inv_Unidades] <= restante)
	                    {
	                        restante -= Inventario[playerid][o][inv_Unidades];
	                        limpar_slot(playerid, o);
	                    }
	                    else
	                    {
	                        Inventario[playerid][o][inv_Unidades] -= restante;
	                        salvar_inventario(id[playerid], o);
	                        restante = 0;
	                    }
	                }
	            }
	        }
	        new weapons[13][2];
	        for(new w; w<13; w++) GetPlayerWeaponData(playerid, w, weapons[w][0], weapons[w][1]);
	        ResetPlayerWeapons_(playerid);
	        for(new w; w<13; w++)
	        {
	            if(w == slot_arma(ar)) GivePlayerWeapon_(playerid, ar, val);
	            else if(weapons[w][0] != 0) GivePlayerWeapon_(playerid, weapons[w][0], weapons[w][1]);
	        }
	        SetPlayerArmedWeapon(playerid, ar);
	        limpar_slot(playerid, slot);
	        new strg[200];
	        format(strg, 200, "Voce se equipou com um(a) '%s' com %s Municoes.", nome_arma(ar), ConvertMoney(val));
	        ms(playerid, 1, strg);
	        abrir_inv_novo(playerid);
	        salvar_inventario(id[playerid], slot);
	        salvar_conta(id[playerid], playerid, "c_Armas");
	    }
	    DeletePVar(playerid, "equip_aguardando");
	    DeletePVar(playerid, "equip_arma");
	    DeletePVar(playerid, "equip_slot");
	    DeletePVar(playerid, "equip_max");
	    DeletePVar(playerid, "equip_tipo");
	    return 1;
	}

	// pedagio //
	if(dialogid == DIALOG_PEDAGIO)
	{
	    if(response)
	    {
	        new a = GetPVarInt(playerid, "ped");
	        pagar_pedagio(playerid, a, 1);
	    }
	    return 1;
	}
	
	
	if(dialogid == DIALOG_CARGO_PORTAO)
	{
		if(response)
		{
			new i = GetPVarInt(playerid, "por");
			new cc = listitem+1;
			Portao[i][p_Cargo] = cc;
			new sss[300];
			format(sss, 300, "Voce definiu o Cargo '%s' no portao %d.", nome_cargo(cc, Portao[i][p_Org]), i);
			ms(playerid, 5, sss);
			salvar_portao(i);		
		}	
		return 1;
	}

	// editar ant xiter //
	if(dialogid == DIALOG_LISTA_ATC)
	{
	    new a = GetPVarInt(playerid, "atc");
	    if(response)
	    {
	        if(a == -1) mostrar_atc(playerid, listitem);
	        else
	        {
                if(listitem == 0)
	            {
	                if(ant_xiter_status[a][atc_Ligado] == 0) ant_xiter_status[a][atc_Ligado] = 1;
	                else ant_xiter_status[a][atc_Ligado] = 0;
	                EnableAntiCheat(a, ant_xiter_status[a][atc_Ligado]);
	                salvar_definicoes("Atc", a);
	                mostrar_atc(playerid, a);
	                return 1;
	            }

	            if(listitem == 1)
	            {
	                if(ant_xiter_status[a][atc_Kikar] == 0) ant_xiter_status[a][atc_Kikar] = 1;
	                else if(ant_xiter_status[a][atc_Kikar] == 1) ant_xiter_status[a][atc_Kikar] = 2;
	                else if(ant_xiter_status[a][atc_Kikar] == 2) ant_xiter_status[a][atc_Kikar] = 3;
	                else if(ant_xiter_status[a][atc_Kikar] == 3) ant_xiter_status[a][atc_Kikar] = 5;
	                else if(ant_xiter_status[a][atc_Kikar] == 5) ant_xiter_status[a][atc_Kikar] = 7;
	                else if(ant_xiter_status[a][atc_Kikar] == 7) ant_xiter_status[a][atc_Kikar] = 0;
	                salvar_definicoes("Atc", a);
	                mostrar_atc(playerid, a);
	                return 1;
	            }
	        }
	    }
	    else if(a != -1) mostrar_atc(playerid);
	    return 1;
	}

	//dialog salarios //
	if(dialogid == DIALOG_SALARIOS)
	{
	    if(response)
	    {
	        new i = Lista[playerid][listitem];
	        if(i != -1)
	        {
	            setar_salario(playerid, i);
			}
			else mostrar_salarios(playerid);
	    }
	    return 1;
	}

	// vender empresa //
	if(dialogid == DIALOG_VENDER_EMPRESA)
	{
	    new a = GetPVarInt(playerid, "empresa");
	    if(response)
        {
            new valor = (Empresa[a][em_Valor]/100)*80;
            MS(playerid, 1, f("Voce vendeu a empresa '%s' por R$ %s.", Empresa[a][em_Nome], ConvertMoney(valor)));
            Empresa[a][em_Dono] = -1;
            DarGrana(playerid, valor);
            atualizar_empresa(a);
            salvar_empresa(a);
        }
        else abrir_empresa(playerid, a);
	    return 1;
	}

	// MECHER NA EMPRESAS DO PLAYER //
	if(dialogid == DIALOG_MENU_EMPRESA)
	{
	    if(response)
        {
	        new a = GetPVarInt(playerid, "empresa");
	        if(Empresa[a][em_Existe] == 1)
	        {
	            // localizar //
	            if(listitem == 0)
	            {
                    Localizar_Player(playerid,Empresa[a][em_X],Empresa[a][em_Y],Empresa[a][em_Z], 76, a, Empresa[a][em_Nome]);
					MS(playerid, 2, "Siga ate a marca vermelha de seu mapa para encontrar a sua empresa.");
	            }

	            // valor entrada //
	            if(listitem == 1)
	            {
                    Input(playerid, DIALOG_ENTRADA_EMPRESA, "{ffff00}Valor da Entrada", "\n{ffffff}Escolha um valor entre 0 e 350 para quando alguem\nfor entrar em sua empresa precisar pagar:\n");
	            }

	            // pagar produtos //
	            if(listitem == 2)
	            {
                    Input(playerid, DIALOG_PAGAR_PORDS, "{ffff00}Pagar por Produto", f("\n{ffffff}Escolha um valor entre %d e %d para pagar\npor cada produto a algum caminhoneiro:\n", VALOR_PRODUTO, VALOR_PRODUTO*2));
	            }

	            // depositar //
	            if(listitem == 3)
	            {
					if(GetPlayerVirtualWorld_(playerid) == a)
					{
					    if(IsPlayerInRangeOfPoint(playerid, 10, pos_porta[0], pos_porta[1], pos_porta[2]))
						{
						Input(playerid, DIALOG_DEPOSITAR_EMPRESA, "{ffffff}Depositar no Cofre", f("\n{ffffff}Cofre: {4169E1}R$ %s\n\n{ffff00}[INFO] {a1a1a1}Escolha um valor entre 1 e 1.000.000 para\ncolocar no cofre:\n",ConvertMoney(Empresa[a][em_Cofre])));
					    }
					    else MS(playerid, 0, "Voce precisa estar proximo a porta do cofre para fazer isso !"), abrir_empresa(playerid, a);
					}
					else MS(playerid, 0, "Voce precisa estar proximo a porta do cofre para fazer isso !"), abrir_empresa(playerid, a);
	            }

	            // sacar //
	            if(listitem == 4)
	            {
                    if(GetPlayerVirtualWorld_(playerid) == a)
					{
					    if(IsPlayerInRangeOfPoint(playerid, 10, pos_porta[0], pos_porta[1], pos_porta[2]))
						{
						Input(playerid, DIALOG_SACAR_EMPRESA, "{ffffff}Sacar do Cofre", f("\n{ffffff}Cofre: {4169E1}R$ %s\n\n{ffff00}[INFO] {a1a1a1}Escolha um valor entre 1 e 1.000.000 para\nretirar do cofre:\n", ConvertMoney(Empresa[a][em_Cofre])));
					    }
					    else MS(playerid, 0, "Voce precisa estar proximo a porta do cofre para fazer isso !"), abrir_empresa(playerid, a);
					}
					else MS(playerid, 0, "Voce precisa estar proximo a porta do cofre para fazer isso !"), abrir_empresa(playerid, a);
	            }

	            // vender //
	            if(listitem == 5)
	            {
	                new sss[1000];
	                new valor = (Empresa[a][em_Valor]/100)*80;
	                format(sss, 1000, "\n\
					{ffffff}Empresa: {00ffff}%s\n\
					{ffffff}Local: {a1a1a1}%s\n\
					{ffffff}Valor: {4169E1}R$ %s\n\n\
					{ffff00}[INFO] {a1a1a1}Deseja realmente vender a sua Empresa ?", Empresa[a][em_Nome], cidade2(cidade_empresa(a)), ConvertMoney(valor));
					ShowPlayerDialog(playerid, DIALOG_VENDER_EMPRESA, DIALOG_STYLE_MSGBOX, "Vender Empresa", sss, "Vender", "Cancelar");
	            }
	        }
		}
		else mostrar_empresas(playerid);
		return 1;
	}

	// EMPRESAS DO PLAYER //
	if(dialogid == DIALOG_EMPRESAS_PLAYER)
	{
	    if(response)
        {
            new a = Lista[playerid][listitem];
            if(a != -1) abrir_empresa(playerid, a);
			else mostrar_empresas(playerid);
        }
        return 1;
	}


	// continuar vender prods //
	if(dialogid == DIALOG_VENDER_PRODS)
	{
	    if(response)
        {
            if(GetPVarInt(playerid, "flood_prods") > gettime()) return 1;
            new car = GetPVarInt(playerid, "car");
	    	new v = GetPVarInt(playerid, "v");
	    	new a = GetPVarInt(playerid, "a");
	    	new prods = GetPVarInt(playerid, "prods");
	    	new tot = prods*Empresa[a][em_ValorProdutos];
            if(Empresa[a][em_Existe] == 1)
            {
                if(IsPlayerInRangeOfPoint(playerid, 2, Empresa[a][em_X],Empresa[a][em_Y],Empresa[a][em_Z]))
                {
                    if(Empresa[a][em_Cofre] >= tot)
                    {
                        ms(playerid, 1, f("Voce recebeu R$ %s, por vender %s Produtos a esta Empresa !", ConvertMoney(tot), ConvertMoney(prods)));
	                    produtos_veiculo[v] -= prods;
	                    texto_caminhao(car, v);
	                    DarGrana(playerid, tot);
                        Empresa[a][em_Produtos] += prods;
                        Empresa[a][em_Cofre] -= tot;
						salvar_empresa(a);
	                    texto_empresa(a);
	                    if(produtos_veiculo[v] < 0) produtos_veiculo[v] = 0;
	                    SetPVarInt(playerid, "flood_prods", gettime()+3);
	                    MetaEmprego(playerid, prods);
                    }
                    else MS(playerid, 0, f("Esta empresa nao possue R$ %s para compretar a compra !", ConvertMoney(tot)));
                }
            }
        }
	    return 1;
	}


	// localizar empresas //
    if(dialogid == DIALOG_EMPRESAS)
    {
        if(response)
        {
			new a = Lista[playerid][listitem];
			if(a != -1)
			{
			    if(Empresa[a][em_Existe] == 1)
				{
            		Localizar_Player(playerid,Empresa[a][em_X],Empresa[a][em_Y],Empresa[a][em_Z], 76, a, Empresa[a][em_Nome]);
            	}
            }
            else lista_empresas(playerid);
        }
		return 1;
    }

	// continuar comprar prods //
    if(dialogid == DIALOG_COMPRAR_PRODS2)
    {
        new car = GetPVarInt(playerid, "car");
        if(response)
        {
   			new tot = GetPVarInt(playerid, "tot");
   			new numero = tot/VALOR_PRODUTO;
			if(GranaPlayer(playerid) >= tot)
			{
			    Acao(playerid, 25, 400, "COMPRANDO PRODUTOS", 0, "null", "null", false);
			}
			else continuar_comprar_prods(playerid, numero);
        }
        else mostrar_comprar_prods(playerid, car);
        return 1;
	}

	// configuracoes //
    if(dialogid == DIALOG_CONFIG_LISTA)
    {
        if(response)
        {
	        // velocimetro //
	        if(listitem == 0)
	        {
	            if(Conta[playerid][c_Velo] == 0) Conta[playerid][c_Velo] = 1;
	            else if(Conta[playerid][c_Velo] == 1) Conta[playerid][c_Velo] = 0;
                salvar_conta(c, 0, "c_Velo", sv_int(Conta[playerid][c_Velo]));
	            if(mostrando_velocimetro[playerid] == 1)
	            {
	                esconder_velocimetro(playerid);
                	mostrar_velocimetro(playerid);
	            }
	            else
	            {
	                if(IsPlayerInAnyVehicle(playerid))
					{
	                    mostrar_velocimetro(playerid);
	                }
				}
	        }
	        // dicas //
	        if(listitem == 1)
			{
	           	if(Conta[playerid][c_Dicas] == 0) Conta[playerid][c_Dicas] = 1;
	           	else Conta[playerid][c_Dicas] = 0;
	           	salvar_conta(c, 0, "c_Dicas", sv_int(Conta[playerid][c_Dicas]));
	        }
	        // chat noob //
	        if(listitem == 2)
			{
	           	if(Conta[playerid][c_Noob] == 0) Conta[playerid][c_Noob] = 1;
	           	else Conta[playerid][c_Noob] = 0;
	           	salvar_conta(c, 0, "c_Noob", sv_int(Conta[playerid][c_Noob]));
	        }
	        // whatsapp //
	        if(listitem == 3)
			{
	           	if(Conta[playerid][c_WP] == 0) Conta[playerid][c_WP] = 1;
	           	else Conta[playerid][c_WP] = 0;
	           	salvar_conta(c, 0, "c_WP", sv_int(Conta[playerid][c_WP]));
	        }
	        mostrar_config(playerid);
			return 1;
        }
        return 1;
    }

	// dialog opcao do movel //
	if(dialogid == DIALOG_EXCLUIR_MOVEL)
	{
	    new i = GetPVarInt(playerid, "casa");
	    new a = GetPVarInt(playerid, "movel");
	    new opc = GetPVarInt(playerid, "opc");
	    if(response)
		{

	        Casa[i][casa_m_Existe][a] = 0;
			atualizar_movel(i, a);
			salvar_casa(i);
			mostrar_moveis_na_casa(playerid, i, opc);
			MS(playerid, 1, "Movel excluido com sucesso !");
			return 1;
		}
		selecionou_movel(playerid, a, opc);
	    return 1;
	}

	// gerenciar chaves da casa //
	if(dialogid == DIALOG_CASA_CHAVES)
	{
	    if(response)
	    {
	        new i = GetPVarInt(playerid, "casa");
	        if(listitem == 0)
	        {
	            SetPVarInt(playerid, "casa_chave_acao", 0);
	            ShowPlayerDialog(playerid, DIALOG_CASA_CHAVES_INPUT, DIALOG_STYLE_INPUT, "Dar Chave", "Digite o ID da conta do jogador:", "Dar", "Voltar");
	        }
	        else
	        {
	            new sss[300];
	            new cont;
	            SG[0] = EOS;
	            zerar_lista(playerid);
	            for(new k; k<3; k++)
	            {
	                if(Casa[i][casa_Keys][k] != -1)
	                {
	                    format(sss, 100, "%d - %s\n", Casa[i][casa_Keys][k], NomeConta(Casa[i][casa_Keys][k]));
	                    strcat(SG, sss);
	                    Lista[playerid][cont] = k;
	                    cont++;
	                }
	            }
	            if(cont == 0) return ms(playerid, 0, "Nenhuma chave foi dada para esta casa!");
	            ShowPlayerDialog(playerid, DIALOG_CASA_CHAVES_REMOVER, DIALOG_STYLE_LIST, "Remover Chave", SG, "Remover", "Voltar");
	        }
	    }
	    return 1;
	}

	if(dialogid == DIALOG_CASA_CHAVES_INPUT)
	{
	    if(response)
	    {
	        new i = GetPVarInt(playerid, "casa");
	        new cc = strval(inputtext);
	        if(cc < 0 || cc >= MAX_CONTAS || ContaInvalida(cc)) return ms(playerid, 0, "Conta invalida!");
	        if(cc == id[playerid]) return ms(playerid, 0, "Voce ja e o dono da casa!");
	        for(new k; k<3; k++) if(Casa[i][casa_Keys][k] == cc) return ms(playerid, 0, "Este jogador ja possui uma chave desta casa!");
	        new slot = -1;
	        for(new k; k<3; k++) if(Casa[i][casa_Keys][k] == -1) { slot = k; break; }
	        if(slot == -1) return ms(playerid, 0, "Limite de 3 chaves atingido!");
	        Casa[i][casa_Keys][slot] = cc;
	        salvar_casa(i);
	        ms(playerid, 1, f("Voce deu uma chave da casa para '%s'!", NomeConta(cc)));
	        new player = ContaOnline(cc);
	        if(Online(player)) ms(player, 1, f("Voce recebeu uma chave da casa de '%s'!", Nome(playerid)));
	    }
	    return 1;
	}

	if(dialogid == DIALOG_CASA_CHAVES_REMOVER)
	{
	    if(response)
	    {
	        new i = GetPVarInt(playerid, "casa");
	        new slot = Lista[playerid][listitem];
	        if(Casa[i][casa_Keys][slot] != -1)
	        {
	            new nome[50];
	            format(nome, 50, NomeConta(Casa[i][casa_Keys][slot]));
	            Casa[i][casa_Keys][slot] = -1;
	            salvar_casa(i);
	            ms(playerid, 1, f("Chave removida de '%s'!", nome));
	        }
	    }
	    return 1;
	}

	// opcoes da casa para quem tem chave //
	if(dialogid == DIALOG_CASA_CHAVE_OPCOES)
	{
	    if(response)
	    {
	        new i = GetPVarInt(playerid, "casa_chave_id");
	        if(listitem == 0)
	        {
				new strloc[40];
				strcat(strloc, "CASA [");
				strcat(strloc, ConvertMoney(i));
				strcat(strloc, "]");
	            Localizar_Player(playerid, Casa[i][casa_X1], Casa[i][casa_Y1], Casa[i][casa_Z1], 64, i, strloc);
				MS(playerid, 2, "Siga ate a marca vermelha do seu radar.");
	        }
	        else if(listitem == 1)
	        {
				if(Casa[i][casa_Chave] == 0) Casa[i][casa_Chave] = 1;
				else Casa[i][casa_Chave] = 0;
				atualizar_casa(i);
				salvar_casa(i);
				ms(playerid, 1, (Casa[i][casa_Chave] == 0)? "Casa destrancada!":"Casa trancada!");
	        }
	        else if(listitem == 2)
	        {
	            abrir_bau_casa(playerid, i);
	        }
	    }
	    return 1;
	}

	// garagem da casa //
	if(dialogid == DIALOG_GARAGEM_CASA)
	{
	    if(response)
	    {
	        new casaid = GetPVarInt(playerid, "casa_garagem_id");
	        new v = Lista[playerid][listitem];
	        if(v < 0) return 1;
	        if(Lista2[playerid][listitem] == 1)
	        {
	            // guardar veiculo //
	            if(Veiculo[v][v_Dono] != id[playerid]) return ms(playerid, 0, "Este veiculo nao e seu!");
	            new car = Veiculo[v][v_ID];
	            if(GetVehicleModel(car) == 0) return ms(playerid, 0, "Veiculo invalido!");
	            new Float:x, Float:y, Float:z;
	            GetVehiclePos(car, x, y, z);
	            if(!IsPlayerInRangeOfPoint(playerid, 30, x, y, z)) return ms(playerid, 0, "Veiculo muito longe!");
	            if(Casa[casaid][casa_GarV] != -1) return ms(playerid, 0, "A garagem ja possui um veiculo!");
	            Casa[casaid][casa_GarV] = v;
	            Veiculo[v][v_Garagem] = -casaid;
	            DestroyVehicle(car);
	            SalvarInfo(v);
	            salvar_casa(casaid);
	            ms(playerid, 1, "Veiculo guardado na garagem da casa!");
	        }
	        else
	        {
	            // retirar veiculo //
	            if(Casa[casaid][casa_GarV] != v) return 1;
	            new Float:ang;
	            new model = Veiculo[v][v_Modelo];
	            new c1 = Veiculo[v][v_Cor1], c2 = Veiculo[v][v_Cor2];
	            new car = CreateVehicle(model, Casa[casaid][casa_GarX], Casa[casaid][casa_GarY], Casa[casaid][casa_GarZ]+1, ang, c1, c2, -1);
	            if(car == INVALID_VEHICLE_ID) return ms(playerid, 0, "Erro ao criar veiculo!");
	            LinkVehicleToInterior(car, Casa[casaid][casa_GarInterior]);
	            SetVehicleVirtualWorld(car, Casa[casaid][casa_GarMundo]);
	            Veiculo[v][v_ID] = car;
	            Veiculo[v][v_Garagem] = 0;
	            Casa[casaid][casa_GarV] = -1;
	            Info_Veiculo[car] = v;
	            PutPlayerInVehicle(playerid, car, 0);
	            SalvarInfo(v);
	            salvar_casa(casaid);
	            ms(playerid, 1, "Veiculo retirado da garagem!");
	        }
	    }
	    return 1;
	}

	// CASAS OPCOES MOVEL //
    if(dialogid == DIALOG_OPCOES_MOVEL)
    {
        new i = GetPVarInt(playerid, "casa");
        new opc = GetPVarInt(playerid, "opc");
        new a = GetPVarInt(playerid, "movel");
        if(response)
        {
            if(listitem == 0)
            {
				// guardar //
	            if(opc == 1)
	            {
	                if(GetPlayerInterior(playerid) != Casa[i][casa_Interior] || GetPlayerVirtualWorld_(playerid) != Casa[i][casa_Mundo] ||
					!IsPlayerInRangeOfPoint(playerid, 100, Casa[i][casa_X2], Casa[i][casa_Y2], Casa[i][casa_Z2]))
	                {
	                    MS(playerid, 0, "Voce precisa estar na casa para fazer isso !");
	                    selecionou_movel(playerid, a, opc);
	                    return 1;
	                }
					Casa[i][casa_m_Status][a] = 0;
					atualizar_movel(i, a);
					mostrar_moveis_na_casa(playerid, i, opc);
					salvar_casa(i);
					MS(playerid, 1, "Movel guardado com sucesso !");
	    			SetPVarInt(playerid, "aviso", C_LISTA);
	    			return 1;
	            }

	            // colocar //
	            if(opc == 0)
	            {
	                if(GetPlayerInterior(playerid) != Casa[i][casa_Interior] || GetPlayerVirtualWorld_(playerid) != Casa[i][casa_Mundo] ||
					!IsPlayerInRangeOfPoint(playerid, 100, Casa[i][casa_X2], Casa[i][casa_Y2], Casa[i][casa_Z2]))
	                {
	                    MS(playerid, 0, "Voce precisa estar na casa para fazer isso !");
	                    selecionou_movel(playerid, a, opc);
	                    return 1;
	                }

	                new Float:p[3];
	                GetPlayerPos(playerid, p[0], p[1], p[2]);
	                PegarFrentePlayer(playerid, p[0], p[1], 2);
	                Casa[i][casa_m_Existe][a] = 0;
					new mov = criar_movel(i, Casa[i][casa_m_ID][a], p[0], p[1], p[2]);
					if(mov != -1)
					{
						EditandoMovel[playerid] = mov;
						EditDynamicObject2(playerid, Casa[i][casa_m_Obj][mov]);
						MS(playerid, 2, "Movimente o objeto usando o editor, e salve a posicao.");
					}
	            }
	            return 1;
            }

            if(listitem == 1)
            {
                perguntar_excluir_movel(playerid);
                return 1;
            }

            if(listitem == 2)
            {
				if(GetPlayerInterior(playerid) != Casa[i][casa_Interior] || GetPlayerVirtualWorld_(playerid) != Casa[i][casa_Mundo] ||
				!IsPlayerInRangeOfPoint(playerid, 100, Casa[i][casa_X2], Casa[i][casa_Y2], Casa[i][casa_Z2]))
                {
                    MS(playerid, 0, "Voce precisa estar na casa para fazer isso !");
	               	selecionou_movel(playerid, a, opc);
                    return 1;
                }
	            EditandoMovel[playerid] = a;
				EditDynamicObject2(playerid, Casa[i][casa_m_Obj][a]);
				ms(playerid, 1, "Movimente o objeto usando o editor, e salve a posicao.");
				return 1;
            }
            return 1;
        }
        mostrar_moveis_na_casa(playerid, i, opc);
        return 1;
	}

	// CASAS EXCLUIR TODOS OS MOVEIS //
    if(dialogid == DIALOG_EXCLUIR_MOVEIS)
    {
        new i = GetPVarInt(playerid, "casa");
        if(response)
        {
	        for(new a; a<MAX_MOVEIS; a++)
			{
			    Casa[i][casa_m_Existe][a] = 0;
			    atualizar_movel(i, a);
			}
			salvar_casa(i);
            mostrar_moveis(playerid, i);
            MS(playerid, 2, "Todos os Moveis da casa foram Excluidos !");
    		return 1;
        }
        mostrar_moveis(playerid, i);
        return 1;
    }

	// CASAS MOVEIS //
    if(dialogid == DIALOG_MOVEIS_NO_LUGAR)
    {
        new i = GetPVarInt(playerid, "casa");
        if(response)
        {
            new a = Lista[playerid][listitem];
            if(a != -1)
			{
				selecionou_movel(playerid, a, 1);
				return 1;
			}
        }
        mostrar_moveis(playerid, i);
        return 1;
    }

    // CASAS MOVEIS //
    if(dialogid == DIALOG_MOVEIS_GUARDADOS)
    {
        new i = GetPVarInt(playerid, "casa");
        if(response)
        {
        	new a = Lista[playerid][listitem];
            if(a != -1)
			{
				selecionou_movel(playerid, a, 0);
				return 1;
			}
        }
        mostrar_moveis(playerid, i);
        return 1;
    }

	// CASAS MOVEIS //
    if(dialogid == DIALOG_CASAS_MOVEIS)
    {
        new i = GetPVarInt(playerid, "casa");
        if(response)
        {
            // moveis na casa //
	        if(listitem == 0)
	        {
				mostrar_moveis_na_casa(playerid, i, 1);
				return 1;
	        }

	        // moveis guardados //
	        if(listitem == 1)
	        {
                mostrar_moveis_na_casa(playerid, i, 0);
                return 1;
	        }

	        // guardar todos os moveis //
	        if(listitem == 2)
	        {
				for(new a; a<MAX_MOVEIS; a++)
				{
				    Casa[i][casa_m_Status][a] = 0;
				    atualizar_movel(i, a);
				}
				salvar_casa(i);
                mostrar_moveis(playerid, i);
                format(str_aviso[playerid], 300, "Todos os Moveis da casa foram Guardados !");
	    		SetPVarInt(playerid, "aviso", C_LISTA);
	    		celular(playerid, C_INFO);
	    		return 1;
	        }

	        // excluir todos os moveis //
	        if(listitem == 3)
	        {
	            perguntar_excluir_moveis(playerid, i);
         		return 1;
			}
            return 1;
		}
		abrir_casa(playerid, i);
        return 1;
    }

	// OPCOES CASA //
    if(dialogid == DIALOG_CASAS_OPCOES)
    {
        new i = GetPVarInt(playerid, "casa");
        if(response)
        {
            // localizar //
	        if(listitem == 0)
	        {
				new strloc[40];
				strcat(strloc, "CASA [");
				strcat(strloc, ConvertMoney(i));
				strcat(strloc, "]");
	            Localizar_Player(playerid, Casa[i][casa_X1], Casa[i][casa_Y1], Casa[i][casa_Z1], 64, i, strloc);
				MS(playerid, 2, "Siga ate a marca vermelha do seu radar para encontrar a sua casa.");
				return 1;
	        }

	        // chave //
	        if(listitem == 1)
	        {
				if(Casa[i][casa_Chave] == 0)
				{
				    Casa[i][casa_Chave] = 1;
				    GameTextForPlayer(playerid, "~g~~h~CASA ABERTA", 1500, 3);
				    atualizar_casa(i);
				    salvar_casa(i);
				    abrir_casa(playerid, i);
				}
				else
				{
				    Casa[i][casa_Chave] = 0;
				    GameTextForPlayer(playerid, "~r~~h~CASA TRACADA", 1500, 3);
				    salvar_casa(i);
				    atualizar_casa(i);
				    abrir_casa(playerid, i);
				}
				return 1;
	        }

	        // gerenciar chaves //
	        if(listitem == 2)
	        {
	            ShowPlayerDialog(playerid, DIALOG_CASA_CHAVES, DIALOG_STYLE_LIST, "Gerenciar Chaves", "Dar Chave\nRemover Chave", "Selecionar", "Voltar");
	            return 1;
	        }

	        // vender ou desistir de vender //
	        if(listitem == 3)
	        {
	            if(Casa[i][casa_Venda] == 1)
	            {
	                Casa[i][casa_Venda] = 0;
	                atualizar_casa(i);
				    salvar_casa(i);
				    abrir_casa(playerid, i);
				    MS(playerid, 2, "Voce cancelou a venda da casa !");
	            }
	            else mostrar_venda_casa(playerid, i);
	            return 1;
	        }

	        // vender para o servidor //
	        if(listitem == 4)
	        {
	            if(Casa[i][casa_Dono] != id[playerid]) return 1;
	            new valor = Casa[i][casa_Valor]/2;
	            if(valor < 1) return ms(playerid, 0, "Valor invalido para venda !");
	            DarGrana(playerid, valor);
	            Casa[i][casa_Dono] = -1;
	            Casa[i][casa_Venda] = 1;
	            Casa[i][casa_Keys][0] = -1; Casa[i][casa_Keys][1] = -1; Casa[i][casa_Keys][2] = -1;
	            salvar_casa(i);
	            atualizar_casa(i);
	            ms(playerid, 1, f("Voce vendeu a casa para o servidor por R$ %s !", ConvertMoney(valor)));
	            return 1;
	        }

	        // moveis da casa //
	        if(listitem == 5)
	        {
	            if(GetPlayerInterior(playerid) != Casa[i][casa_Interior] || GetPlayerVirtualWorld_(playerid) != Casa[i][casa_Mundo] ||
				!IsPlayerInRangeOfPoint(playerid, 100, Casa[i][casa_X2], Casa[i][casa_Y2], Casa[i][casa_Z2]))
                {
                    MS(playerid, 0, "Voce precisa estar na casa para fazer isso !");
                    return 1;
                }
    			mostrar_moveis(playerid, i);
    			return 1;
	        }
			return 1;
        }

        mostrar_casas(playerid);
		return 1;
    }

    // CASAS LISTA //
    if(dialogid == DIALOG_CASAS)
    {
        if(response)
        {
            new a = Lista[playerid][listitem];
            new is_key = Lista2[playerid][listitem];
			if(a == -1)
			{
				MS(playerid, 0, "Nenhuma casa encontrada !");
				mostrar_casas(playerid);
			    return 1;
			}
			if(is_key == 1)
			{
			    new Float:dist;
			    new Float:p[3];
			    new sss[300];
			    GetPlayerPos(playerid, p[0], p[1], p[2]);
			    GetDistance(dist, p[0], p[1], p[2], Casa[a][casa_X1], Casa[a][casa_Y1], Casa[a][casa_Z1]);
			    SG[0] = EOS;
			    format(sss, 150, "{ffffff}Localizar\t{a1a1a1}%.0f Metros\n", dist), strcat(SG, sss);
			    format(sss, 150, "{ffffff}Fechadura\t%s\n", (Casa[a][casa_Chave] == 0)? "{ffff00}ABERTA":"{ff0000}TRANCADA"), strcat(SG, sss);
			    format(sss, 150, "{ffffff}Bau da Casa\t{a1a1a1}Abrir\n"), strcat(SG, sss);
			    format(sss, 150, "{ffffff}Dono: {a1a1a1}%s", NomeConta(Casa[a][casa_Dono]));
			    ShowPlayerDialog(playerid, DIALOG_CASA_CHAVE_OPCOES, DIALOG_STYLE_TABLIST, "Casa (Chave)", SG, "Ok", "Voltar");
			    SetPVarInt(playerid, "casa_chave_id", a);
			    return 1;
			}
			abrir_casa(playerid, a);
			return 1;
        }
		return 1;
    }

	// excluir veiculo do player //
    if(dialogid == DIALOG_EXCLUIR_VEICULO)
	{
	    new v = GetPVarInt(playerid, "info");
	    new i = Veiculo[v][v_ID];
	    if(response)
	    {
	        if(Veiculo[v][v_Garagem] == 1)
	        {
	            DestruirInfo(v);
	            mostrar_veiculos(playerid);
	            MS(playerid, 2, "Voce excluiu este veiculo permanentemente !");
	        }
	        else if(GetVehicleModel(i) != 0)
	        {
	            DestruirVeiculo(i);
	        	mostrar_veiculos(playerid);
	            MS(playerid, 2,  "Voce excluiu este veiculo permanentemente !");
	        }
	        else
	        {
	        	mostrar_veiculos(playerid);
	            MS(playerid, 2,  "Erro ao excluir veiculo, tente mais tarde !");
	        }
	    }
	    else mostrar_veiculos(playerid, 1, v);
	    return 1;
	}

	// veiculos do player opcao //
	if(dialogid == DIALOG_VEI2)
	{
	    if(response)
		{
		    new v = GetPVarInt(playerid, "info");
		    new i = GetPVarInt(playerid, "veh");
		    if(v == -1) return 1;

		    if(listitem == 0) // localizar //
			{
			    if(Veiculo[v][v_Garagem] == 0 && GetVehicleModel(i) != 0)
				{
					new Float:p[3];
					GetVehiclePos(i, p[0], p[1], p[2]);
				    Localizar_Player(playerid, p[0], p[1], p[2], 0, i, "SEU VEICULO");
				    MS(playerid, 2, "Siga ate a marca vermelha do seu radar para encontrar o veiculo.");
				}
			    else
				{
				if(Veiculo[v][v_Conce] != 0)
				{
				    new co = Veiculo[v][v_ConceID];
				    Localizar_Player(playerid, Conce[co][con_g_X], Conce[co][con_g_Y], Conce[co][con_g_Z], 63, -1, "CONCESSIONARIA");
                        MS(playerid, 2, "Siga ate a marca vermelha do seu radar para encontrar a garagem da Concessionaria");
					}
					else if(Veiculo[v][v_Garagem_ID] != -1)
					{
					    new g = Veiculo[v][v_Garagem_ID];
					Localizar_Player(playerid, Garagem[g][ga_X], Garagem[g][ga_Y], Garagem[g][ga_Z], 0, i, "GARAGEM");
                        MS(playerid, 2,  "Siga ate a marca vermelha do seu radar para encontrar a garagem do seu veiculo.");
					}
					else
					{
					    Localizar_Player(playerid, Veiculo[v][v_X], Veiculo[v][v_Y], Veiculo[v][v_Z], 0, i, "VEICULO");
                        MS(playerid, 2, "Siga ate a marca vermelha do seu radar para encontrar o seu veiculo.");
					}
				}
			    return 1;
			}

            if(listitem == 1)
            {
                if(Veiculo[v][v_Trancado] == 1) Veiculo[v][v_Trancado] = 0;
                else Veiculo[v][v_Trancado] = 1;
				if(GetVehicleModel(i) == 0 || Veiculo[v][v_Garagem] == 1)
				{
				    Play_Som(1145, Veiculo[v][v_X],Veiculo[v][v_Y],Veiculo[v][v_Z], 0, 0);
				}
				else
				{
					new Float:pp[3];
					GetVehiclePos(i, pp[0],pp[1],pp[2]);
					Play_Som(1145, pp[0],pp[1],pp[2], 0, 0);
				}
				mostrar_veiculos(playerid, 1, v);
				return 1;
            }

			if(listitem == 2)
	        {
	            new sss[600];
	            new conta_nome[50];
	            SG[0] = EOS;
	            strcat(SG, "Jogador\n");
	            for(new k; k<3; k++)
				{
	                if(Veiculo[v][v_Keys][k] != -1)
	                {
	                    format(conta_nome, 50, NomeConta(Veiculo[v][v_Keys][k]));
	                    format(sss, 600, "%s\n", conta_nome);
	                    strcat(SG, sss);
	                }
	                else strcat(SG, "{a1a1a1}Vazio\n");
	            }
	            format(sss, 600, "{00ffff}Adicionar Chave\n{ff0000}Remover Chave");
	            strcat(SG, sss);
	            ShowPlayerDialog(playerid, DIALOG_CHAVES, DIALOG_STYLE_LIST, "{ffffff}Gerenciar Chaves", SG, "Ok", "Voltar");
	            return 1;
	        }
	        if(listitem == 3)
	        {
	            if(strlen(Veiculo[v][v_History]) > 0)
	            {
	                new hist[500];
	                format(hist, 500, "{ffffff}%s", Veiculo[v][v_History]);
	                ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{00ffff}Historico do Veiculo", hist, "Ok", "Fechar");
	            }
	            else ms(playerid, 0, "Nenhum historico encontrado para este veiculo !");
	            return 1;
	        }
			if(listitem == 4)
	        {
	            new sss[400];
	            new venda_valor = Veiculo[v][v_Compra] / 2;
	            if(venda_valor < 1) venda_valor = 1000;
	            format(sss, 400, "{ffffff}Veiculo: {ffff00}%s\n{ffffff}Placa: {ffff00}%s\n\n{ffffff}Valor de venda: {00ff00}R$ %s\n\n{ff0000}Deseja vender este veiculo para o servidor ?", NomeVeiculo(Veiculo[v][v_Modelo]), PlacaVeiculo[v], ConvertMoney(venda_valor));
	            ShowPlayerDialog(playerid, DIALOG_VENDER_SERVIDOR, DIALOG_STYLE_MSGBOX, "{00ff00}Vender ao Servidor", sss, "Vender", "Cancelar");
	            return 1;
	        }
		    return 1;
		}
	    if(GetPVarInt(playerid, "voltar_lista") == 1) mostrar_veiculos(playerid);
	    return 1;
	}

	if(dialogid == DIALOG_CHAVES)
	{
	    new sss[300];
	    new v = GetPVarInt(playerid, "info");
	    if(response)
	    {
	        new total_chaves;
	        for(new k; k<3; k++) if(Veiculo[v][v_Keys][k] != -1) total_chaves++;
	        if(listitem > 0 && listitem <= 3)
	        {
	            new idx = listitem - 1;
	            if(Veiculo[v][v_Keys][idx] != -1)
	            {
	                new nome[50];
	                format(nome, 50, NomeConta(Veiculo[v][v_Keys][idx]));
	                format(sss, 300, "{ffffff}Nome: {ffff00}%s\n\n{ff0000}Deseja remover a chave deste jogador ?", nome);
	                SetPVarInt(playerid, "remover_chave", idx);
	                ShowPlayerDialog(playerid, DIALOG_CHAVES2, DIALOG_STYLE_MSGBOX, "{ffffff}Remover Chave", sss, "Remover", "Cancelar");
	            }
	            else ms(playerid, 0, "Nenhum jogador com chave neste slot !");
	        }
	        else if(listitem == 4)
	        {
	            if(total_chaves >= 3) return ms(playerid, 0, "Limite maximo de 3 chaves atingido !");
	            ShowPlayerDialog(playerid, DIALOG_CHAVES3, DIALOG_STYLE_INPUT, "{ffffff}Adicionar Chave", "{ffffff}Digite o ID ou Nick do jogador:", "Adicionar", "Cancelar");
	        }
	        else if(listitem == 5)
	        {
	            if(total_chaves == 0) return ms(playerid, 0, "Nenhuma chave para remover !");
	            ShowPlayerDialog(playerid, DIALOG_CHAVES4, DIALOG_STYLE_INPUT, "{ffffff}Remover Chave", "{ffffff}Digite o ID ou Nick do jogador:", "Remover", "Cancelar");
	        }
	    }
	    else
	    {
	        new veh = GetPVarInt(playerid, "veh");
	        new tre = GetPVarInt(playerid, "info");
	        SetPVarInt(playerid, "veh", veh);
	        SetPVarInt(playerid, "info", tre);
	        mostrar_veiculos(playerid, 1, tre);
	    }
	    return 1;
	}

	if(dialogid == DIALOG_CHAVES2)
	{
	    new v = GetPVarInt(playerid, "info");
	    if(response)
	    {
	        new slot = GetPVarInt(playerid, "remover_chave");
	        if(slot >= 0 && slot < 3 && Veiculo[v][v_Keys][slot] != -1)
	        {
	            Veiculo[v][v_Keys][slot] = -1;
	            SalvarInfo(v);
	            ms(playerid, 1, "Chave removida com sucesso !");
	        }
	    }
	    mostrar_veiculos(playerid, 1, v);
	    return 1;
	}

	if(dialogid == DIALOG_CHAVES3)
	{
	    new sss[300];
	    new v = GetPVarInt(playerid, "info");
	    if(response)
	    {
	        if(strlen(inputtext) < 1) { ms(playerid, 0, "Digite um ID ou Nick valido !"); return 1; }
	        new alvo;
	        if(sscanf(inputtext, "u", alvo)) return ms(playerid, 0, "Jogador nao encontrado !");
	        if(!Online(alvo)) return ms(playerid, 0, "Jogador nao esta online !");
	        if(id[alvo] == -1) return ms(playerid, 0, "Jogador nao esta logado !");
	        if(Veiculo[v][v_Dono] == id[alvo]) return ms(playerid, 0, "O dono ja possui a chave do veiculo !");
	        for(new k; k<3; k++) if(Veiculo[v][v_Keys][k] == id[alvo]) return ms(playerid, 0, "Este jogador ja possui uma chave deste veiculo !");
	        new slot = -1;
	        for(new k; k<3; k++) if(Veiculo[v][v_Keys][k] == -1) { slot = k; break; }
	        if(slot == -1) return ms(playerid, 0, "Limite maximo de 3 chaves atingido !");
	        Veiculo[v][v_Keys][slot] = id[alvo];
	        SalvarInfo(v);
	        format(sss, 300, "Voce deu uma chave do veiculo para '%s' !", Nome(alvo));
	        ms(playerid, 1, sss);
	        format(sss, 300, "Voce recebeu uma chave do veiculo '%s' de '%s' !", NomeVeiculo(Veiculo[v][v_Modelo]), Nome(playerid));
	        ms(alvo, 1, sss);
	    }
	    mostrar_veiculos(playerid, 1, v);
	    return 1;
	}

	if(dialogid == DIALOG_CHAVES4)
	{
	    new sss[300];
	    new v = GetPVarInt(playerid, "info");
	    if(response)
	    {
	        if(strlen(inputtext) < 1) { ms(playerid, 0, "Digite um ID ou Nick valido !"); return 1; }
	        new alvo;
	        if(sscanf(inputtext, "u", alvo)) return ms(playerid, 0, "Jogador nao encontrado !");
	        if(!Online(alvo)) return ms(playerid, 0, "Jogador nao esta online !");
	        if(id[alvo] == -1) return ms(playerid, 0, "Jogador nao esta logado !");
	        new encontrou;
	        for(new k; k<3; k++)
	        {
	            if(Veiculo[v][v_Keys][k] == id[alvo])
	            {
	                Veiculo[v][v_Keys][k] = -1;
	                encontrou = 1;
	                SalvarInfo(v);
	                format(sss, 300, "Chave de '%s' removida do veiculo !", Nome(alvo));
	                ms(playerid, 1, sss);
	                break;
	            }
	        }
	        if(!encontrou) ms(playerid, 0, "Este jogador nao possui chave deste veiculo !");
	    }
	    mostrar_veiculos(playerid, 1, v);
	    return 1;
	}

	if(dialogid == DIALOG_VENDER_SERVIDOR)
	{
	    new sss[300];
	    new v = GetPVarInt(playerid, "info");
	    if(response)
	    {
	        if(Veiculo[v][v_Dono] != id[playerid]) return ms(playerid, 0, "Voce nao e o dono deste veiculo !");
	        new venda_valor = Veiculo[v][v_Compra] / 2;
	        if(venda_valor < 1) venda_valor = 1000;
	        DarGrana(playerid, venda_valor);
	        format(sss, 300, "Voce vendeu o veiculo '%s' por R$ %s.", NomeVeiculo(Veiculo[v][v_Modelo]), ConvertMoney(venda_valor));
	        ms(playerid, 1, sss);
	        if(Veiculo[v][v_ID] != 0) { DestroyVehicle_(Veiculo[v][v_ID]); Veiculo[v][v_ID] = 0; }
	        DestruirInfo(v);
	    }
	    else
	    {
	        new tre = GetPVarInt(playerid, "info");
	        mostrar_veiculos(playerid, 1, tre);
	    }
	    return 1;
	}

	//veiculos do player //
	if(dialogid == DIALOG_VEI)
	{
	    if(response)
		{
			new i = Lista[playerid][listitem];
		    if(i == -1)
		    {
		        MS(playerid, 0, "Voce nao tem um veiculo !");
    		    mostrar_veiculos(playerid, 0);
                return 1;
		    }
		    if(Veiculo[i][v_Dono] == id[playerid] && Veiculo[i][v_Emprego] == -1 && Veiculo[i][v_Org]  == -1) mostrar_veiculos(playerid, 1, i);
		}
	    return 1;
	}

	// comprar empresa //
	if(dialogid == DIALOG_COMPRAR_EMPRESA)
	{
	    if(response)
	    {
	        new sss[150];
	        if(id[playerid] == -1) return 1;
	        new i = GetPVarInt(playerid, "empre");
	        if(Empresa[i][em_Dono] != -1) MS(playerid, 0, "Esta empresa Ja tem um Dono !");
	        else if(GranaPlayer(playerid) >= Empresa[i][em_Valor])
    	    {
    	        if(Empresa[i][em_Tipo] == 0)
    	        {
    	            SetPlayerPos_(playerid, Empresa[i][em_X2]+0.1, Empresa[i][em_Y2]+0.1, Empresa[i][em_Z2]+0.1);
	                SetPlayerInterior(playerid, Empresa[i][em_Interior]);
	                SetPlayerVirtualWorld_(playerid, i);
	                SetPVarInt(playerid, "flood_teleporte", gettime()+2);
	                OnPlayerInteriorChange(playerid, GetPlayerInterior(playerid), GetPlayerInterior(playerid));
    	        }
        	    format(sss, 150, "Voce pagou R$ %s na empresa, use /emps para ter acesso a mais recurssos.", ConvertMoney(Empresa[i][em_Valor]));
				MS(playerid, 1, sss);
				ms(playerid, 1, sss);
				DarGrana(playerid, -Empresa[i][em_Valor]);
				ms(playerid, 2, "Se caso voce Venda sua empresa novamente, voce recebera 80 por cento do valor que comprou.");
				Empresa[i][em_Dono] = id[playerid];
				salvar_empresa(i);
				atualizar_empresa(i);
    	    }
    	    else
			{
			    format(sss, 150, "Voce nao tem R$ %s pra Comprar esta Empresa !", ConvertMoney(Empresa[i][em_Valor]));
				MS(playerid, 0, sss);
				continuar_comprar_empresa(playerid, i);
			}
	    }
	    return 1;
	}

	// entrada empresa //
	if(dialogid == DIALOG_ENTRAR_EMPRESA)
	{
	    if(response)
	    {
	        new sss[150];
	        new i = GetPVarInt(playerid, "empre");
	        if(listitem == 0)
	        {
                if(IsPlayerInRangeOfPoint(playerid, 1.5, Empresa[i][em_X], Empresa[i][em_Y], Empresa[i][em_Z]))
		        {
		            if(GetPlayerInterior(playerid) == 0)
		            {
		        	    if(Empresa[i][em_Dono] == id[playerid])
		        	    {
		        	        SetPlayerPos_(playerid, Empresa[i][em_X2]+0.1, Empresa[i][em_Y2]+0.1, Empresa[i][em_Z2]+0.1);
		                    SetPlayerInterior(playerid, Empresa[i][em_Interior]);
		                    SetPlayerVirtualWorld_(playerid, i);
		                    OnPlayerInteriorChange(playerid, GetPlayerInterior(playerid), GetPlayerInterior(playerid));
		                    SetPVarInt(playerid, "flood_teleporte", gettime()+2);
		                    debug_mundo(playerid);
		        	    }
		        	    else if(Empresa[i][em_Dono] == -1 || Empresa[i][em_Entrada] == 0)
		        	    {
		        	        SetPlayerPos_(playerid, Empresa[i][em_X2]+0.1, Empresa[i][em_Y2]+0.1, Empresa[i][em_Z2]+0.1);
		                    SetPlayerInterior(playerid, Empresa[i][em_Interior]);
		                    SetPlayerVirtualWorld_(playerid, i);
		                    OnPlayerInteriorChange(playerid, GetPlayerInterior(playerid), GetPlayerInterior(playerid));
		                    MS(playerid, 1, "Entrada Gratuita, Bem Vindo.");
							SetPVarInt(playerid, "flood_teleporte", gettime()+2);
							debug_mundo(playerid);
		        	    }
						else if(GranaPlayer(playerid) >= Empresa[i][em_Entrada])
		        	    {
		            	    SetPlayerPos_(playerid, Empresa[i][em_X2]+0.1, Empresa[i][em_Y2]+0.1, Empresa[i][em_Z2]+0.1);
		                    SetPlayerInterior(playerid, Empresa[i][em_Interior]);
		                    SetPlayerVirtualWorld_(playerid, i);
		                    SetPVarInt(playerid, "flood_teleporte", gettime()+2);
		                    OnPlayerInteriorChange(playerid, GetPlayerInterior(playerid), GetPlayerInterior(playerid));
		                    format(sss, 150, "Voce pagou R$ %s pra entrar neste Local, Bem Vindo.", ConvertMoney(Empresa[i][em_Entrada]));
							MS(playerid, 1, sss);
							Empresa[i][em_Cofre] += Empresa[i][em_Entrada];
							add_cp(Empresa[i][em_Entrada]);
							salvar_empresa(i);
							DarGrana(playerid, -Empresa[i][em_Entrada]);
							SetPVarInt(playerid, "flood_teleporte", gettime()+2);
							debug_mundo(playerid);
		        	    }
		        	    else
						{
						    format(sss, 150, "Voce nao tem R$ %s pra entrar neste Local.", ConvertMoney(Empresa[i][em_Entrada]));
							MS(playerid, 0, sss);
							dialog_empresa(playerid, i);
						}
					}
				}
	        }

	        if(listitem == 1)
	        {
                SetPlayerPos_(playerid, 2145.6587, 1597.5542, 999.7676);
                SetPlayerInterior(playerid, 1);
                SetPlayerVirtualWorld_(playerid, i);
                OnPlayerInteriorChange(playerid, GetPlayerInterior(playerid), GetPlayerInterior(playerid));
                MS(playerid, 1, "Voce entrou no Cofre da Empresa.");
                debug_mundo(playerid);
	        }

	        if(listitem == 2)
	        {
				if(Empresa[i][em_Dono] == -1)
				{
				    if(GranaPlayer(playerid) >= Empresa[i][em_Valor])
					{
					continuar_comprar_empresa(playerid, i);
				    }
				    else
					{
					format(sss, 150, "Voce nao possue R$ %s em maos, para comprar esta Empresa !", ConvertMoney(Empresa[i][em_Valor]));
						MS(playerid, 0, sss);
						dialog_empresa(playerid, i);
				    }
				}
	        }
	    }
	    return 1;
	}

	// local de spawn casa //
	if(dialogid == DIALOG_LOCAL2)
	{
	    if(response)
	    {
	        new sss[150];
	        new a = Lista[playerid][listitem];
	        if(a != -1)
	        {
	        	Conta[playerid][c_Local] = 2;
	        	Conta[playerid][c_LocalID] = a;
            	salvar_conta(c, 0, "c_Local", sv_int(2));
            	salvar_conta(c, 0, "c_LocalID", sv_int(a));
            	format(sss, 150, "Voce mudou seu Local de Spawn para 'Casa ID:%d'.", a);
            	ms(playerid, 1, sss);
            	mostrar_mudar_local(playerid);
	        }
	        else spawn_casa(playerid);
	    }
	    else mostrar_mudar_local(playerid);
	    return 1;
	}

	// local de spawn //
	if(dialogid == DIALOG_LOCAL)
	{
	    if(response)
	    {
	        if(listitem == 0)
	        {
                Conta[playerid][c_Local] = 0;
            	salvar_conta(c, 0, "c_Local", sv_int(0));
            	ms(playerid, 1, "Voce mudou seu Local de Spawn para 'Respawn civil'.");
            	mostrar_mudar_local(playerid);
	        }

	        if(listitem == 1)
	        {
	            new o = OrgPlayer(playerid);
	            if(o != -1)
	            {
	                Conta[playerid][c_Local] = 1;
	            	salvar_conta(c, 0, "c_Local", sv_int(1));
	            	salvar_conta(c, 0, "c_LocalID", sv_int(o));
	            	ms(playerid, 1, "Voce mudou seu Local de Spawn para 'Organizacao'.");
				}
				else ms(playerid, 0, "Voce nao faz parte de uma Organizacao !");
				mostrar_mudar_local(playerid);
			}

	        if(listitem == 2)
	        {
	            if(casas_conta(c) == 0)
	            {
	                ms(playerid, 0, "Voce nao tem uma casa !");
	                mostrar_mudar_local(playerid);
	            }
	            else spawn_casa(playerid);
	        }
	    }
	    return 1;
	}

	// trocar fichas //
	if(dialogid == DIALOG_TROCAR_FICHAS)
	{
	    new cc = contas[playerid];
	    if(cc != -1)
	    {
		    new fichas =  GetContaInt(cc, "c_Fichas");
		    new caixas = GetContaInt(cc, "c_Caixas");
		    if(response)
		    {
				if(fichas >= 65)
				{
                    fichas -= 65;
                    caixas += 1;
                    salvar_conta(cc, 0, "c_Fichas", sv_int(fichas));
                    salvar_conta(cc, 0, "c_Caixas", sv_int(caixas));
                    ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}_",
					"\n{4169E1}[INFO] {a1a1a1}Troca realizada com sucesso !\n\
					Voce pode abrir suas Caixas Misteriosas\n\
					diretamente de seu inventario, confira os\n\
					premios disponiveis antes de abrir !\n", "Informado", "Fechar");
					mostrar_premio(playerid);
				}
		    }
	    }
	    return 1;
	}

	// DIALOG CAIXA MISTERIOSA //
	if(dialogid == DIALOG_CAIXA_MISTERIOSA)
	{
	    if(response)
	    {
	        if(c == -1) return 1;
            new slot = GetPVarInt(playerid, "slot");
            diminuir_inv(c, slot);
            new sss[300];
	        new a = inv_vazio(playerid);
	        if(a == -1) MS(playerid, 0, "Seu Inventario esta Lotado !");
	        else
	        {
          		new sorteio = random(1000);
          		if(sorteio < 50)
	            {
	                // cash //
					new cas = 1+random(4);
					DarCash(playerid, cas);
					format(sss, 300, "Voce ganhou R$ %s de Cash, da Caixa Misteriosa !", ConvertMoney(cas));
	            }
	            else if(sorteio < 300)
	            {
	                // acessorio //
	                new ac = random(sizeof acessorios_aleatorios);
					new acc = acessorios_aleatorios[ac];
					new dias  = (1+random(3));
                	Inventario[playerid][a][inv_ID] = 55;
				Inventario[playerid][a][inv_Unidades] = 1;
				Inventario[playerid][a][inv_Tipo] = acc;
				Inventario[playerid][a][inv_Ativo] = 0;
					Inventario[playerid][a][inv_Tempo] = dias*UM_DIA;
					format(sss, 300, "Voce ganhou um '%s' por %d Dia%s, da Caixa Misteriosa !", Acessorios_Info[acc][acessorio_Nome], dias, (dias == 1)?"":"s");
	            }
				else
				{
		            new sort = 3000+random(10000);
					DarGrana(playerid, sort);
                    format(sss, 300, "Voce ganhou R$ %s em Grana, da Caixa Misteriosa !", ConvertMoney(sort));
				}
				ms(playerid, 1, sss);
				abrir_inv_novo(playerid);
			}

	    }
	    return 1;
	}

	// logs do server //
	if(dialogid == DIALOG_LOGS2)
	{
	    lostrar_lista_logs(playerid);
		return 1;
	}

	// logs do server //
	if(dialogid == DIALOG_LOGS)
	{
	    if(response)
	    {
	        if(listitem == 0) ler_logs("Log/Ban.txt"), ShowPlayerDialog(playerid, DIALOG_LOGS2, DIALOG_STYLE_MSGBOX, "Banimentos Recentes", SG, "Ok", "Voltar");
	        if(listitem == 1) ler_logs("Log/Desban.txt"), ShowPlayerDialog(playerid, DIALOG_LOGS2, DIALOG_STYLE_MSGBOX, "Desbans Recentes", SG, "Ok", "Voltar");
	        if(listitem == 2) ler_logs("Log/Kick.txt"), ShowPlayerDialog(playerid, DIALOG_LOGS2, DIALOG_STYLE_MSGBOX, "Kikados Recentes", SG, "Ok", "Voltar");
			if(listitem == 3) ler_logs("Log/DarGrana.txt"), ShowPlayerDialog(playerid, DIALOG_LOGS2, DIALOG_STYLE_MSGBOX, "Dar ou Setar Grana Recentes", SG, "Ok", "Voltar");
			if(listitem == 4) ler_logs("Log/DarBanco.txt"), ShowPlayerDialog(playerid, DIALOG_LOGS2, DIALOG_STYLE_MSGBOX, "Dar ou Setar Banco Recentes", SG, "Ok", "Voltar");
			if(listitem == 5) ler_logs("Log/DarCash.txt"), ShowPlayerDialog(playerid, DIALOG_LOGS2, DIALOG_STYLE_MSGBOX, "Dar ou Setar Cash Recentes", SG, "Ok", "Voltar");
	    	if(listitem == 6) ler_logs("Log/DarVip.txt"), ShowPlayerDialog(playerid, DIALOG_LOGS2, DIALOG_STYLE_MSGBOX, "Dar ou Remover VIP Recentes", SG, "Ok", "Voltar");
	    }
	    return 1;
	}

	// dialog editar locais //
	if(dialogid == DIALOG_EDITAR_LOCAIS)
	{
	    new cidadee = GetPVarInt(playerid, "cidade");
	    if(response)
	    {
			if(cidadee == -1) lista_editar_locais(playerid, listitem);
			else
			{
                opcoes_editar_local(playerid, cidadee, listitem);
	        }
	    }
	    else if(cidadee != -1) lista_editar_locais(playerid);
	}

	// dialog editar locais //
	if(dialogid == DIALOG_EDITAR_LOCAL)
	{
	    new cidadee = GetPVarInt(playerid, "cidade");
	    new a = GetPVarInt(playerid, "a");
	    if(response)
		{
			if(cidadee == 0) editar_opcao_cidade(playerid, cidadee, a, listitem, Local_LosSantos[a][local_Nome]);
			if(cidadee == 1) editar_opcao_cidade(playerid, cidadee, a, listitem, Local_SanFierro[a][local_Nome]);
			if(cidadee == 2) editar_opcao_cidade(playerid, cidadee, a, listitem, Local_LasVenturas[a][local_Nome]);
		}
	    else lista_editar_locais(playerid, cidadee);
	    return 1;
	}

	// dialog ajuda respawn civil //
	if(dialogid == DIALOG_COMECO)
	{
	    if(response)
	    {
	        if(pegar_cidade(playerid) == 0) Localizar_Player(playerid, pos_eletronicos[0][0],pos_eletronicos[0][1],pos_eletronicos[0][2], 777, -1, "LOJA DE ELETRONICOS");
	       	if(pegar_cidade(playerid) == 1) Localizar_Player(playerid, pos_eletronicos[1][0],pos_eletronicos[1][1],pos_eletronicos[1][2], 777, -1, "LOJA DE ELETRONICOS");
	       	if(pegar_cidade(playerid) == 2) Localizar_Player(playerid, pos_eletronicos[2][0],pos_eletronicos[2][1],pos_eletronicos[2][2], 777, -1, "LOJA DE ELETRONICOS");
	    }
	    return 1;
	}

	// org dona de uma gz //
	if(dialogid == DIALOG_DONO_GZ)
	{
	    if(response)
	    {
	     	new o = GetPVarInt(playerid, "idgzaa");
	        if(TR[o][tr_Existe] == 1)
			{
				if(TR[o][tr_EmGuerra] == 0)
				{
				    TR[o][tr_Dono] = listitem-1;
				    format(TR[o][tr_Data], 100, "%02d/%02d/%02d - %02d:%02d", DIA, MES, ANO, HORA, MINUTO);
				    new sssa[150];
					format(sssa, 150, "Voce setou o Dono da GZ ID: %d, para '%s'.", o, NomeOrg(listitem-1));
					ms(playerid, 5, sssa);
					atualizar_gz(o);
					salvar_gz(o);
			    }
			    else ms(playerid, 0, "Nao e possivel alterar o dono da GZ em guerra !");
			}
			else ms(playerid, 0, "Esta GZ nao existe mais !");
	    }
	    return 1;
	}

	// tipo de uma gz //
	if(dialogid == DIALOG_TIPO_GZ)
	{
	    if(response)
	    {
	        new o = GetPVarInt(playerid, "idgzaa");
	        if(TR[o][tr_Existe] == 1)
			{
			    if(TR[o][tr_EmGuerra] == 0)
				{
	                TR[o][tr_Tipo] = listitem;
	                new sssa[150];
					format(sssa, 150, "Voce setou o Tipo da GZ ID: %d, para '%s'.", o, tipo_gz[listitem]);
					ms(playerid, 5, sssa);
					atualizar_gz(o);
					salvar_gz(o);
				}
				else ms(playerid, 0, "Nao e possivel alterar o Tipo da GZ em guerra !");
			}
			else ms(playerid, 0, "Esta GZ nao existe mais !");
	    }
	    return 1;
	}

	// pagar multa veiculo //
	if(dialogid == DIALOG_MULTAS_VEICULO)
	{
    	if(response)
	    {
	        new a = GetPVarInt(playerid, "info");
	        new i = Lista[playerid][listitem];
	        if(i != -1)
	        {
	            new linha[150];
	            if(GranaPlayer(playerid) < Veiculo_Multa[a][i][mu_Valor])
	            {
	                format(linha, 150, "Voce nao tem R$ %s para pagar esta multa !", ConvertMoney(Veiculo_Multa[a][i][mu_Valor]));
	                MS(playerid, 0, linha);
					return 1;
	            }
	            format(linha, 150, "Voce pagou uma multa no valor de R$ %s.", ConvertMoney(Veiculo_Multa[a][i][mu_Valor]));
		        DarGrana(playerid, -Veiculo_Multa[a][i][mu_Valor]);
		        Veiculo_Multa[a][i][mu_Existe] = 0;
		        Veiculo_Multa[a][i][mu_Valor] = 0;
		        Veiculo_Multa[a][i][mu_Conta] = -1;
		        Veiculo_Multa[a][i][mu_Radar] = -1;
		        format(Veiculo_Multa[a][i][mu_Motivo], 100, "Nenhum");
		        format(Veiculo_Multa[a][i][mu_Data], 50, "Nada");
		        mostrar_multas_veiculo(playerid, a);
		        MS(playerid, 1, linha);
	            SalvarInfo(a, 51);
	        }
	        else
			{
			    MS(playerid, 0, "Este veiculo nao possue Multas !");
				mostrar_multas_veiculo(playerid, a);
			}
	    }
	    else consulta_placa(playerid);
	    return 1;
	}

	// cores de um veiculo //
	if(dialogid == DIALOG_CORES_VEICULO)
	{
	    if(response)
	    {
	        SetPVarInt(playerid, "cor", listitem);
	        mostrar_cores(playerid, 1);
	    }
	    return 1;
	}

	// comfirmar compra loja //
	if(dialogid == DIALOG_CONFIRMAR_LOJA)
	{
	    if(response)
	    {
	        new a = GetPVarInt(playerid, "aaaaaa");
	        realizar_compra(playerid, a);
	    }
	    return 1;
	}

	// DELETAR item LOJA //
	if(dialogid == DIALOG_EXCLUIR_ITEM_LOJA)
	{
	    new a = GetPVarInt(playerid, "item");
	    if(response)
	    {
	        deletar_lista_loja(a);
	        editar_loja(playerid);
	        ms(playerid, 1, "Item da lista deletado com sucesso !");
		}
		else editar_loja_item_opcoes(playerid, a);
	    return 1;
	}

	// DELETAR LISTA LOJA //
	if(dialogid == DIALOG_EXCLUIR_LISTA_LOJA)
	{
	    new a = GetPVarInt(playerid, "lista");
	    if(response)
	    {
	        deletar_lista_loja(a);
	        editar_loja(playerid);
	        ms(playerid, 1, "Lista deletada com sucesso !");
		}
		else editar_loja_lista_opcoes(playerid, a);
	    return 1;
	}

	// opcoes item da loja //
	if(dialogid == DIALOG_EDITAR_LOJA_ITEM_OPCOES)
	{
	    new a = GetPVarInt(playerid, "item");
		new aa = GetPVarInt(playerid, "lista");
	    if(response)
	    {
            if(listitem == 7)
            {
				deletar_item_loja_opc(playerid, a);
            }
            else editar_item_da_loja(playerid, a, listitem);
	    }
	    else editar_loja_lista(playerid, aa);
	    return 1;
	}

	// opcoes editar loja, lista //
	if(dialogid == DIALOG_EDITAR_LOJA_OPCOES)
	{
	    if(response)
	    {
	        new a = GetPVarInt(playerid, "lista");
	        if(Loja[a][loja_Existe] == 1)
	        {
	            if(listitem == 0)
	            {
					mudar_nome_loja_lista(playerid, a);
	            }
	            if(listitem == 1)
	            {
					editar_loja_lista(playerid, a);
	            }
	            if(listitem == 2)
	            {
					deletar_lista_loja_opc(playerid, a);
	            }
	        }
	        else editar_loja(playerid);
	    }
	    else editar_loja(playerid);
	    return 1;
	}

	// editar loja SERVIDOR //
	if(dialogid == DIALOG_EDITAR_LOJA)
	{
	    if(response)
	    {
			if(listitem == 0)
			{
			    new a = criar_lista_loja();
			    if(a == -1)
				{
				editar_loja(playerid);
				ms(playerid, 0, "Numero maximo de Listas da loja atingido !");
				return 1;
			    }
                editar_loja_lista_opcoes(playerid, a);
			}
			else
			{
			    new a = Lista[playerid][listitem-1];
			    if(a != -1)
				{
				if(Loja[a][loja_Existe] == 1)
				{
				    editar_loja_lista_opcoes(playerid, a);
				}
				else editar_loja(playerid);
			    }
			}
	    }
	    return 1;
	}

	// editar items loja fenix //
	if(dialogid == DIALOG_EDITAR_LOJA_ITENS)
	{
	    if(response)
	    {
	        new b = GetPVarInt(playerid, "lista");
            if(listitem == 0)
			{
				new a = criar_item_loja(b);
				if(a == -1)
				{
				    ms(playerid, 0, "Numero maximo de items para esta lista da loja atingido !");
				    return 1;
				}
				editar_loja_item_opcoes(playerid, a);
			}
			else
			{
			    new a = Lista[playerid][listitem-1];
			    if(a != -1)
				{
				if(Loja[b][loja_Existe] == 1)
				{
					if(Loja[a][loja_Existe] == 1)
					{
					    editar_loja_item_opcoes(playerid, a);
					}
					else editar_loja_lista(playerid, b);
				}
				else editar_loja(playerid);
			    }
			}
	    }
	    else editar_loja(playerid);
	    return 1;
	}

	// acessorio parte do corpo //
	if(dialogid == DIALOG_PARTE_DO_CORPO)
	{
	    new w = GetPVarInt(playerid, "id_ace");
    	if(response)
        {
            Acessorios[playerid][w][ac_Local] = listitem+1;
	    	acessorios_player(playerid);
	    	salvar_acessorios(playerid, c);
            EditandoAcessorio[playerid] = w;
			EditAttachedObject2(playerid, w, Acessorios_Info[Acessorios[playerid][w][ac_ID]][acessorio_Modelo], Acessorios[playerid][w][ac_Local]);
			ms(playerid, 2, "Movimente o acessorio, e quando tiver na cordedada desejada, salve a edicao.");
			ms(playerid, 2, "Se caso voce cancele a edicao, o acessorio ira para a posicao anterior.");
			ms(playerid, 2, "Voce pode ver seus acessorios anexados, Use /acessorios.");
        }
	    else mostrar_opcoes_acessorio(playerid, w);
	    return 1;
	}

	// acessorios //
	if(dialogid == DIALOG_ACESSORIOS)
	{
	    if(response)
	    {
	        new a = Lista[playerid][listitem];
	        if(a != -1)
	        {
				mostrar_opcoes_acessorio(playerid, a);
				return 1;
	        }
	        else MS(playerid, 0, "Nenhum Acessorio encontrado neste Slot !");
	        mostrar_acessorios(playerid);
	    }
	    return 1;
	}

	// opcoes acessorios //
	if(dialogid == DIALOG_ACESSORIOS1)
	{
	    new w = GetPVarInt(playerid, "id_ace");
	    if(response)
	    {

            if(Acessorios[playerid][w][ac_Usando] == 1)
            {
	            // se tiver usando //
	            if(listitem == 0)
            	{
            	    Acessorios[playerid][w][ac_Usando] = 0;
                    acessorios_player(playerid);
					salvar_acessorios(playerid, c);
                    mostrar_opcoes_acessorio(playerid, w);
					return 1;
                }
	        }
	        else
	        {
	            // se nao tiver usando //
	            if(listitem == 0)
            	{
            	    if(!PodeColocarAcessorios(playerid))
					{
					 	mostrar_opcoes_acessorio(playerid, w);
					 	return 1;
					}
                    Acessorios[playerid][w][ac_Usando] = 1;
                    acessorios_player(playerid);
					salvar_acessorios(playerid, c);
                    mostrar_opcoes_acessorio(playerid, w);
                    return 1;
                }
	        }

            // guardar no invetario //
            if(listitem == 1)
            {
                for(new s; s<MAX_SLOTS; s++)
				{
				    if(Inventario[playerid][s][inv_ID] == 0)
					{
					Inventario[playerid][s][inv_ID] = 55;
					Inventario[playerid][s][inv_Unidades] = 1;
					Inventario[playerid][s][inv_Tipo] = Acessorios[playerid][w][ac_ID];

					if(Acessorios[playerid][w][ac_Tempo] != 0)
					{
					    Inventario[playerid][s][inv_Ativo] = 1;
					    Inventario[playerid][s][inv_Tempo] = Acessorios[playerid][w][ac_Tempo];
					}
					else
					{
					    Inventario[playerid][s][inv_Ativo] = 0;
					    Inventario[playerid][s][inv_Tempo] = 0;
					}
					salvar_inventario(c, s);
					Acessorios[playerid][w][ac_Existe] = 0;
					Acessorios[playerid][w][ac_Usando] = 0;
					salvar_acessorios(playerid, c);
					mostrar_acessorios(playerid);
					acessorios_player(playerid);
						ms(playerid, 1, "Voce guardou o Acessoirio, e ele esta em seu Inventario !");
						return 1;
				    }
				}
                ms(playerid, 0, "Seu inventario esta Lotado !");
                mostrar_opcoes_acessorio(playerid, w);
                return 1;
            }


            if(Acessorios[playerid][w][ac_Usando] == 1)
            {
            	// editar local do acessorio //
	            if(listitem == 2)
	            {
	                parte_do_corpo(playerid);
	            }
	            // editar posicao acessorio //
	            if(listitem == 3)
	            {
	                EditandoAcessorio[playerid] = w;
					EditAttachedObject2(playerid, w, Acessorios_Info[Acessorios[playerid][w][ac_ID]][acessorio_Modelo], Acessorios[playerid][w][ac_Local]);
					ms(playerid, 2, "Movimente o acessorio, e quando tiver na cordedada desejada, salve a edicao.");
					ms(playerid, 2, "Se caso voce cancele a edicao, o acessorio ira para a posicao anterior.");
					ms(playerid, 2, "Voce pode ver seus acessorios anexados, Use /acessorios.");
	            }
	            if(listitem == 4)
	            {
	                if(CashPlayer(playerid) < 9)
	                {
	                    ms(playerid, 0, "Voce nao tem Cash Suficiente para renovar o acessorio !");
	                    mostrar_opcoes_acessorio(playerid, w);
	                }
	                else
	                {
	                    Acessorios[playerid][w][ac_Tempo] += 3*UM_DIA;
	                    salvar_acessorios(playerid, c);
	                    ms(playerid, 1, "Voce renovou +3 Dias desse Acessorio !");
	                    mostrar_opcoes_acessorio(playerid, w);
	                    DarCash(playerid, -9);
	                }
	            }
            }
            else
            {
                if(listitem == 2)
                {
                    if(CashPlayer(playerid) < 9)
	                {
                        ms(playerid, 0, "Voce nao tem Cash Suficiente para renovar o acessorio !");
	                    mostrar_opcoes_acessorio(playerid, w);
	                }
	                else
	                {
	                    Acessorios[playerid][w][ac_Tempo] += 3*UM_DIA;
	                    salvar_acessorios(playerid, c);
	                    ms(playerid, 1, "Voce renovou +3 Dias desse Acessorio !");
	                    mostrar_opcoes_acessorio(playerid, w);
	                    DarCash(playerid, -9);
	                }
                }
            }
	    }
	    else mostrar_acessorios(playerid);
	    return 1;
	}


	// minhas coisas //
	if(dialogid == DIALOG_MEU)
	{
	    if(response)
	    {
	        if(listitem == 0) mostrar_portoes(playerid);
	        if(listitem == 1) mostrar_acessorios(playerid);
	        if(listitem == 2) mostrar_maconhas(playerid);
	        if(listitem == 3) mostrar_titulos(playerid);
	        if(listitem == 4) mostrar_veiculos(playerid);
	        if(listitem == 5) mostrar_casas(playerid);
	        if(listitem == 6) mostrar_empresas(playerid);
	    }
	    return 1;
	}

	// titulos //
    if(dialogid == DIALOG_TITULOS)
	{
	    if(c == -1) return 1;
	    if(response)
	    {
	        if(listitem == 0)
			{
				ms(playerid, 1, "Voce removeu o titulo da sua cabeca !");
				Conta[playerid][c_Tag] = 0;
				salvar_conta(c, 0, "c_Tag", sv_int(0));
				mostrar_titulos(playerid);
			}

	        if(listitem == 1)
	        {
	            if(Conta[playerid][c_TagYT] == 0) ms(playerid, 0, "Voce nao possue a Tag de YouTuber !");
	            else
	            {
	                Conta[playerid][c_Tag] = 1;
	                ms(playerid, 1, "Agora voce esta usando o titulo de YouTuber !");
	                salvar_conta(c, 0, "c_Tag", sv_int(1));
	            }
	            mostrar_titulos(playerid);
	        }
	
			if(listitem == 2)
	        {
	            if(EmpregoPlayer(playerid) == -1) ms(playerid, 0, "Voce nao Tem um Emprego !");
	            else
	            {
	                Conta[playerid][c_Tag] = 2;
	                ms(playerid, 1, "Agora voce esta usando o titulo do Emprego !");
	                salvar_conta(c, 0, "c_Tag", sv_int(2));
	            }
	            mostrar_titulos(playerid);
	        }
	
			if(listitem == 3)
	        {
	            if(OrgPlayer(playerid) == -1) ms(playerid, 0, "Voce nao faz parte de uma Organizacao !");
	            else
	            {
	                Conta[playerid][c_Tag] = 3;
	                ms(playerid, 1, "Agora voce esta usando o titulo com Tag da Organizacao !");
	                salvar_conta(c, 0, "c_Tag", sv_int(3));
	            }
	            mostrar_titulos(playerid);
	        }
	    }
	    return 1;
	}

	// saber id de conta //
	if(dialogid == DIALOG_MEU_ID)
	{
	    if(response)
	    {
	        if(strlen(inputtext) < 3 || strlen(inputtext) > 30)
	        {
	            ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}_", "{ff0000}[ERRO] Nick Invalido !", "Ok", "Fechar");
	            return 1;
	        }
	        continuar_meu_id(playerid, inputtext);
	    }
	    else{
	    	mostrar_login(playerid);
	    }
	}


	// setar clima do servidor //
	if(dialogid == DIALOG_CLIMAS)
	{
	    if(response)
	    {
	        clima_server(listitem);
	        new sss[150];
	        format(sss, 150, "[CLIMA] O Administrador %s setou o Clima para: %s.", Nome(playerid), Clima[listitem][clima_Nome]);
    		foreach(new i:Player) if(Online(i)) ms(i, 4, sss);
	    }
	    return 1;
	}


	// dialogs DIALOG_DESBAN_IP //
	if(dialogid == DIALOG_DESBAN_IP)
	{
	    new con = conta_desban[playerid];
	    new mot[100], ipd[20];
	    format(mot, 100, motivo_desban[playerid]);
		format(ipd, 20, ip_desban[playerid]);
	    if(response)
	    {
	        new file[40];
	        format(file, 40, "IPS_Banidos/%s.txt", ipd);
	        if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
	        ms(playerid, 1, "Voce desbaniu o IP da conta com sucesso !");
	    }
	    new sss[150];
	    salvar_conta(con, 0, "c_Ban_Tempo", sv_int(0));
	    format(sss, 150, "[DESBAN] O admin '%s' desbaniu a conta [%d] '%s', pelo motivo: %s.", Nome(playerid), con, NomeConta(con), mot);
	    mst(0xF08080ff, sss);
	    return 1;
	}

	// setar fabricacao de certa municao //
	if(dialogid == DIALOG_FABRICACAO2)
	{
	    if(response)
	    {
            new mun = GetPVarInt(playerid, "municao");
            new sss[300];
	        SG[0] = EOS;
	        SetPVarInt(playerid, "material", listitem);
	        format(sss, 300, "Caixa de '%s'", nome_municao(mun));
	        if(listitem < 4) format(SG, 500, "\n{ffffff}Digite a quantidade necessaria\nde {a1a1a1}%s{ffffff} para fabricar uma\nCaixa de '%s':\n", materiais[listitem], nome_municao(mun));
	        else format(SG, 500, "\n{ffffff}Digite a producao final da Caixa de '%s':\n", nome_municao(mun));
            Input(playerid, DIALOG_FABRICACAO7, sss, SG);
	    }
	    else fabricacao(playerid, 3);
	    return 1;
	}

	// setar fabricacao de certa arma //
	if(dialogid == DIALOG_FABRICACAO3)
	{
	    if(response)
	    {
	        new arma = GetPVarInt(playerid, "arma");
            new sss[300];
