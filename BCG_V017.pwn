	SetPVarInt(playerid, "id_org", i);
	new sss[500];
	for(new a; a<10; a++)
	{
	    if(Org[i][o_Skins][a] != -1)
	    {
			strcat(sss, "{ffffff}");
			strcat(sss, "Skin ID: ");
			strcat(sss, ConvertMoney(Org[i][o_Skins][a]));
			strcat(sss, "\n");
