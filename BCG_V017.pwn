stock AttVelocimetro(playerid)
{
    new veh = GetPlayerVehicleID(playerid);
    if(!IsPlayerInAnyVehicle(playerid) || veh == 0)
    {
        return 1;
    }

    new model = GetVehicleModel(veh);
    if(model == 0) return 1;

    new v = Info_Veiculo[veh];
    new Float:vida_carro;
    GetVehicleHealth(veh, vida_carro);

    new Float:SpeedVeh = float(GetVehicleSpeed(veh));
    new Float:healthVal = vida_carro / 10.0;
    if(healthVal > 100.0) healthVal = 100.0;

    // Speed number
    new Str[50];
    format(Str, sizeof(Str), "%.0f", SpeedVeh);
    PlayerTextDrawSetString(playerid, TextdrawVelocimetro[playerid][0], Str);
    PlayerTextDrawShow(playerid, TextdrawVelocimetro[playerid][0]);

    // Health percentage
    format(Str, sizeof(Str), "%.0f%%", healthVal);
    PlayerTextDrawSetString(playerid, TextdrawVelocimetro[playerid][1], Str);
    PlayerTextDrawShow(playerid, TextdrawVelocimetro[playerid][1]);

    // Vehicle preview model and colors
    if(modelo_velo[playerid] != model)
    {
        modelo_velo[playerid] = model;
        PlayerTextDrawSetPreviewModel(playerid, TextdrawVelocimetro[playerid][2], model);
        PlayerTextDrawSetPreviewVehCol(playerid, TextdrawVelocimetro[playerid][2], Veiculo[v][v_Cor1], Veiculo[v][v_Cor2]);
        PlayerTextDrawSetPreviewRot(playerid, TextdrawVelocimetro[playerid][2], -16.000000, 0.000000, -25.000000, 1.000000);
        PlayerTextDrawShow(playerid, TextdrawVelocimetro[playerid][2]);
    }
    else if(cor_velo[playerid][0] != Veiculo[v][v_Cor1] || cor_velo[playerid][1] != Veiculo[v][v_Cor2])
    {
        cor_velo[playerid][0] = Veiculo[v][v_Cor1];
        cor_velo[playerid][1] = Veiculo[v][v_Cor2];
        PlayerTextDrawSetPreviewVehCol(playerid, TextdrawVelocimetro[playerid][2], Veiculo[v][v_Cor1], Veiculo[v][v_Cor2]);
    }

    // Speed pointer arc (bolinhas)
    new Float:currentSpeedMap = SpeedVeh + 130.0;
    if(currentSpeedMap < 130.0) currentSpeedMap = 130.0;
    if(currentSpeedMap > 340.0) currentSpeedMap = 340.0;

    if(floatabs(currentSpeedMap - LastSpeedRender[playerid]) > 5.0)
    {
        LastSpeedRender[playerid] = currentSpeedMap;
        new Float:angle = currentSpeedMap * 0.02;

        for(new i = 0; i < MAX_BOLINHAS; i++)
        {
            new Float:distancia = i * 2.2;
            new Float:X = 328.0 + distancia * floatcos(angle);
            new Float:Y = 386.0 + distancia * floatsin(angle);

            if(TextdrawVelocimetroPont[playerid][i] != PlayerText:INVALID_TEXT_DRAW)
                PlayerTextDrawDestroy(playerid, TextdrawVelocimetroPont[playerid][i]);

            TextdrawVelocimetroPont[playerid][i] = CreatePlayerTextDraw(playerid, X, Y, "~p~.");
            PlayerTextDrawFont(playerid, TextdrawVelocimetroPont[playerid][i], 1);
            PlayerTextDrawLetterSize(playerid, TextdrawVelocimetroPont[playerid][i], 0.350000, 1.450001);
            PlayerTextDrawSetShadow(playerid, TextdrawVelocimetroPont[playerid][i], 0);
            PlayerTextDrawSetProportional(playerid, TextdrawVelocimetroPont[playerid][i], 1);
            if(mostrando_velocimetro[playerid] == 1) PlayerTextDrawShow(playerid, TextdrawVelocimetroPont[playerid][i]);
        }
    }

    // Gas pointer (gasolina)
    new gasVal = 0;
    if(v != -1) gasVal = Veiculo[v][v_Gasolina];
    else gasVal = 100;
    if(gasVal < 0) gasVal = 0;
    if(gasVal > 100) gasVal = 100;

    new Float:currentFuel = 190.0 + float(gasVal) * 1.3;
    if(currentFuel < 190.0) currentFuel = 190.0;
    if(currentFuel > 320.0) currentFuel = 320.0;

    // Gas pointer - recreate only when fuel changes enough
    if(floatabs(currentFuel - LastFuelRender[playerid]) > 1.0)
    {
        LastFuelRender[playerid] = currentFuel;
        new Float:angleFuel = currentFuel * 0.02;
        for(new i = 0; i < MAX_BOLINHAS; i++)
        {
            new Float:distancia = i * 1.3;
            new Float:X = 373.0 + distancia * floatcos(angleFuel);
            new Float:Y = 401.0 + distancia * floatsin(angleFuel);

            PlayerTextDrawDestroy(playerid, TextdrawGasolinhaPont[playerid][i]);
            TextdrawGasolinhaPont[playerid][i] = CreatePlayerTextDraw(playerid, X, Y, "~p~.");
            PlayerTextDrawFont(playerid, TextdrawGasolinhaPont[playerid][i], 1);
            PlayerTextDrawLetterSize(playerid, TextdrawGasolinhaPont[playerid][i], 0.350000, 1.450001);
            PlayerTextDrawSetShadow(playerid, TextdrawGasolinhaPont[playerid][i], 0);
            PlayerTextDrawSetProportional(playerid, TextdrawGasolinhaPont[playerid][i], 1);
            PlayerTextDrawColor(playerid, TextdrawGasolinhaPont[playerid][i], 0xaa00ffff);
            PlayerTextDrawBackgroundColor(playerid, TextdrawGasolinhaPont[playerid][i], 0x00000000);
            if(mostrando_velocimetro[playerid] == 1) PlayerTextDrawShow(playerid, TextdrawGasolinhaPont[playerid][i]);
        }
    }

    return 1;
}

stock Velo_CreateTDs(playerid)
{
    LastSpeedRender[playerid] = 0.0;
    LastFuelRender[playerid] = 0.0;
    for(new i = 0; i < MAX_BOLINHAS; i++)
    {
        TextdrawVelocimetroPont[playerid][i] = PlayerText:INVALID_TEXT_DRAW;
        TextdrawGasolinhaPont[playerid][i] = PlayerText:INVALID_TEXT_DRAW;
    }

    TextdrawVelocimetro[playerid][0] = CreatePlayerTextDraw(playerid, 331.399902, 407.700165, "00");
    PlayerTextDrawFont(playerid, TextdrawVelocimetro[playerid][0], 1);
    PlayerTextDrawLetterSize(playerid, TextdrawVelocimetro[playerid][0], 0.223000, 1.080000);
    PlayerTextDrawTextSize(playerid, TextdrawVelocimetro[playerid][0], 1280.000000, 1280.000000);
    PlayerTextDrawSetOutline(playerid, TextdrawVelocimetro[playerid][0], 0);
    PlayerTextDrawSetShadow(playerid, TextdrawVelocimetro[playerid][0], 1);
    PlayerTextDrawAlignment(playerid, TextdrawVelocimetro[playerid][0], 2);
    PlayerTextDrawUseBox(playerid, TextdrawVelocimetro[playerid][0], 0);
    PlayerTextDrawColor(playerid, TextdrawVelocimetro[playerid][0], 0xffffffff);
    PlayerTextDrawBackgroundColor(playerid, TextdrawVelocimetro[playerid][0], 0x00000000);
    PlayerTextDrawBoxColor(playerid, TextdrawVelocimetro[playerid][0], 0x80808080);
    PlayerTextDrawSetProportional(playerid, TextdrawVelocimetro[playerid][0], 1);

    TextdrawVelocimetro[playerid][1] = CreatePlayerTextDraw(playerid, 286.000000, 378.099945, "100%");
    PlayerTextDrawFont(playerid, TextdrawVelocimetro[playerid][1], 2);
    PlayerTextDrawLetterSize(playerid, TextdrawVelocimetro[playerid][1], 0.114997, 0.769999);
    PlayerTextDrawTextSize(playerid, TextdrawVelocimetro[playerid][1], 1280.000000, 1280.000000);
    PlayerTextDrawSetOutline(playerid, TextdrawVelocimetro[playerid][1], 0);
    PlayerTextDrawSetShadow(playerid, TextdrawVelocimetro[playerid][1], 1);
    PlayerTextDrawAlignment(playerid, TextdrawVelocimetro[playerid][1], 3);
    PlayerTextDrawUseBox(playerid, TextdrawVelocimetro[playerid][1], 0);
    PlayerTextDrawColor(playerid, TextdrawVelocimetro[playerid][1], 0xffffff96);
    PlayerTextDrawBackgroundColor(playerid, TextdrawVelocimetro[playerid][1], 0x00000000);
