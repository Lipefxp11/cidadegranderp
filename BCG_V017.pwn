stock salvar_info_arma(i)
{
    new file[60];
    format(file, 60, "Info_Armas/Arma_%d.txt", i);
    if(!DOF2_FileExists(file)) DOF2_CreateFile(file);
    DOF2_SetInt(file, "a_ID", lista_armas[i][a_ID]);
    DOF2_SetInt(file, "a_Item", lista_armas[i][a_Item]);
    DOF2_SetInt(file, "a_Modelo", lista_armas[i][a_Modelo]);
    DOF2_SetInt(file, "a_Block", lista_armas[i][a_Block]);
    DOF2_SetInt(file, "a_Slot", lista_armas[i][a_Slot]);
    DOF2_SetInt(file, "a_Dano", lista_armas[i][a_Dano]);
	DOF2_SetString(file, "a_Nome", lista_armas[i][a_Nome]);
	DOF2_SaveFile();
}

stock mostrar_info_arma(playerid, i)
{
    new linha[500];
    strcat(linha, "{ffffff}Nome\t{a1a1a1}");
    strcat(linha, lista_armas[i][a_Nome]);
    strcat(linha, "\n");
    strcat(linha, "{ffffff}Dano\t{a1a1a1}");
    strcat(linha, ConvertMoney(lista_armas[i][a_Dano]));
    strcat(linha, "\n");
    strcat(linha, "{ffffff}Arma Valida\t{a1a1a1}");
    if(lista_armas[i][a_Block] == 0) strcat(linha, "{4169E1}SIM");
    else strcat(linha, "{ff0000}NAO");
    strcat(linha, "\n");
    ShowPlayerDialog(playerid, DIALOG_ARMAS2, DIALOG_STYLE_TABLIST, "Editar Arma", linha, "Continuar", "Fechar");
}

