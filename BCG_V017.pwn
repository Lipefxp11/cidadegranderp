	{
		new s[40];
		if(sscanf(params, "s[40]", s)) return ms(playerid, 2, "Use: /criarconce [ Nome ]");
		new Float:pos[3];
		if(GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld_(playerid) != 0) return ms(playerid, 0, "Voce nao pode criar uma concessionaria em um interior !");
		GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
		new c = criar_conce(pos[0], pos[1], pos[2], s);
		if(c == -1) return ms(playerid, 0, "Numero maximo de concessionarias do servidor atingido !");
		new sss[150];
