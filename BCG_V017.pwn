stock abrir_sos(playerid)
{
    new c = id[playerid];
	if(c != -1)
	{
	    if(GetPVarInt(playerid, "sos") > gettime())
	    {
	        format(str_aviso[playerid], 300, "Voce so pode acionar uma emergencia a cada 3 minutos !");
	    	SetPVarInt(playerid, "aviso", C_INICIO);
	    	celular(playerid, C_ERRO);
	    }
	    else if(player_chip(playerid) == -1)
   	    {
   	    	format(str_aviso[playerid], 300, "Voce ainda nao tem um numero cadastrado, compre um chip na 24/7 mais proxima.");
	    	SetPVarInt(playerid, "aviso", C_INICIO);
	    	celular(playerid, C_ERRO);
   	    }
	    else
	    {
			for(new a; a<sizeof soss; a++) format(Lista_DC[playerid][a][cel_Nome], 100, "%s", soss[a][sos_Nome]);
	        MAX_DC[playerid] = sizeof soss;
	        Item_DC[playerid] = 0;
	        format(Titulo_DC[playerid], 100, "~b~~h~ACIONAR EMERGENCIA");
			ID_DC[playerid] = SOS;
			Pagina_DC[playerid] = 0;
			celular(playerid, C_LISTA);
		}
	}
}

