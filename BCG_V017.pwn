BCG:: JogadorParado(playerid)
{
    if(JogadorCongelado[playerid] == 1){
        Controle(playerid, 0);
        GameTextForPlayer(playerid, "congelado", 1200, 1);
    }
    else{
        return KillTimer(TimerFicarParado[playerid]);
    }
    return 1;
}
BCG:: CarregandoLig(playerid)
{
    if(RecLig[playerid] != -1 && EmLigacao[playerid] == -1){
        // conexao 2
        SetPVarInt(playerid, "VOIP_Conectar", 1);
    	SetPVarInt(playerid, "VOIP_ConectarID", playerid+10);
        ms(playerid, 1, "Conexao estabelecida.");
        EmLigacao[playerid] = 1;
    }
    return 1;
}

BCG:: OnCheatDetected(playerid, const ip_address[], type, xiter)
{
    new Test_String[200];
    if(id[playerid] != -1) // 15 16 17 armas //
	{
		format(Test_String, sizeof(Test_String), "[ANT CHEATER] '%s' Conta: %d ( /tv [%d] ) suspeita de %s !", Nome(playerid), id[playerid], playerid, nome_xiter(xiter));
		print(Test_String);
		msa(0xFFA07Aff, Test_String);

		if(xiter == 15)
		{
			ResetPlayerWeapons_(playerid);
			salvar_conta(id[playerid], -1, "c_Armas");
			remocao_arma[playerid] = gettime()+3;
			ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}.", "\n{ff0000}ANT CHEATER\n\n{a1a1a1}Foi Detectado um possivel Cheater de armas, caso\nseja engano apenas ignore esta menssagem.\nSuas armas foram removidas por garantia.\n", "Ok", "Fechar");
		}

		if(ant_xiter_status[xiter][atc_Kikar] > 0)
	    {
	        ant_xiter_avisos[playerid][xiter] ++;
	        if(ant_xiter_avisos[playerid][xiter] >= ant_xiter_status[xiter][atc_Kikar])
	        {
	            ant_xiter_avisos[playerid][xiter] = 0;
	            format(Test_String, sizeof(Test_String), "[ANT CHEATER] Jogador '%s' ID %d foi kikado com %d avisos, suspeita de %s !", Nome(playerid), playerid, ant_xiter_status[xiter][atc_Kikar], nome_xiter(xiter));
                msa(0xFFA07Aff, Test_String);
                format(Test_String, sizeof(Test_String), "[ANT CHEATER] Voce foi Kikado do servidor por suspeita de %s !", nome_xiter(xiter));
                msc(id[playerid], 5, Test_String);
				Kick(playerid);
	        }
	    }
	}
	else
	{
	    format(Test_String, sizeof(Test_String), "[ANT CRASH] %s[%d] kikado por suspeita de %s !", Nome(playerid),  playerid, nome_xiter(xiter));
		print(Test_String);

	    if(ant_xiter_status[xiter][atc_Kikar] > 0)
	    {
	        if(xiter == 15) ResetPlayerWeapons_(playerid);
	        ant_xiter_avisos[playerid][xiter] ++;
	        if(ant_xiter_avisos[playerid][xiter] >= ant_xiter_status[xiter][atc_Kikar])
	        {
	            ant_xiter_avisos[playerid][xiter] = 0;
	            format(Test_String, sizeof(Test_String), "[ANT CHEATER] Voce foi Kikado do servidor por suspeita de %s !", nome_xiter(xiter));
				SSM(playerid, 0xaa00ffff, Test_String);
				Kick(playerid);
	        }
	    }
	}
	return 1;
}

// modulos

// inicio da gamemode
public OnGameModeInit()
{
    // hora
    gettime(HORA, MINUTO, SEGUNDO);
	getdate(ANO, MES, DIA);
    // definicoes
	Streamer_SetMaxItems(STREAMER_TYPE_OBJECT, 10000);
	Streamer_SetVisibleItems(STREAMER_TYPE_OBJECT, 1200); // BCG OPT: evita pico enorme de objetos por cliente
	Streamer_SetMaxItems(STREAMER_TYPE_PICKUP, 2000);
	Streamer_SetMaxItems(STREAMER_TYPE_3D_TEXT_LABEL, 5000);
	ManualVehicleEngineAndLights();
    DisableInteriorEnterExits();
    ShowNameTags(false);
    EnableStuntBonusForAll(false);
    UsePlayerPedAnims();
    ShowPlayerMarkers(false);
	SetGameModeText("Sao Paulo - SP");
	criar_painel_orgs_tds();
	SetTimer("alternar_hostname", 10000, true);
	SetTimer("LimparChatTimer", 120000, true);
	CreateDynamicPickup(1274, 1, 1224.4751, -1475.8009, 13.5392, 0, 0, -1, 10.0);
	CreateDynamic3DTextLabel("{ffff00}Deposito de Veiculos\n{ffffff}Aperte H para acessar", 0xffff00ff, 1224.4751, -1475.8009, 13.5392, 7.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0);
	GZ_PRETA = GZ_CriarGz(0, 0, 6500, 6500, 0, 0x000000ff);
	CreateDynamicObject(FLY_OBJ, 0.0+(3*FLY_X), -2.5, fly_altura+4.5, FLY_RX, 0.00000, 0.00000);
