		new Float:pos[3];
		new cont;
		if(sscanf(params, "d",  metros)) return ms(playerid, 2, "Use: /respawn [ metros ]."), ms(playerid, 2, "Usado para dar respawn nos veiculos desocupados a distancia definida.");
		if(metros < 1 || metros > 6000) return ms(playerid, 0, "Use de 1 - 6.000 metros !");
		foreach(new v:Vehicles)
		{
		    if(GetVehicleModel(v) != 0)
		    {
		        if(Info_Veiculo[v] != -1)
		        {
				    if(VeiculoDesocupado(v))
					{
						GetVehiclePos(v, pos[0], pos[1], pos[2]);
						if(IsPlayerInRangeOfPoint(playerid, float(metros), pos[0], pos[1], pos[2]))
						{
						    SetTimerEx("SpawnVeiculo", 1000, false, "d", v);
						    cont ++;
						}
					}
				}
			}
		}
		new sss[150];
		format(sss, 150, "Voce deu respawn em %d veiculos a %d metros de voce.", cont, metros);
		ms(playerid, 4, sss);
		return 1;
	}

	if(!strcmp(cmd, "/emplacar", true))
	{
	    if(AdminPlayer(playerid) < 5) return ms(playerid, 0, "Apenas admin level 5+!");
	    new i, arq[80];
	    if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /emplacar [ ID do Veiculo (dados) ]");
	    if(i < 0 || i >= MAX_VEICULOS || Veiculo[i][v_Existe] == 0) return ms(playerid, 0, "Veiculo invalido!");
	    Veiculo[i][v_Emplacar] = 1;
	    format(arq, 80, "Veiculos/Veiculo_%d.txt", i);
	    if(DOF2_FileExists(arq))
	    {
	        DOF2_SetInt(arq, "v_Emplacar", 1);
	        DOF2_SaveFile();
	    }
	    ms(playerid, 5, f("Veiculo %d emplacado!", i));
	    return 1;
	}

	if(!strcmp(cmd, "/respawnall", true))
	{
	    new cont;
		foreach(new v:Vehicles)
		{
		    if(GetVehicleModel(v) != 0)
		    {
		        if(Info_Veiculo[v] != -1)
		        {
				    if(VeiculoDesocupado(v))
					{
					    SetTimerEx("SpawnVeiculo", 1000, false, "d", v);
					    cont ++;
					}
				}
			}
		}
		ms(playerid, 4, f("Voce deu respawn em %d veiculos de todo o servidor!", cont));
		return 1;
	}

	if(!strcmp(cmd, "/fixveiculos", true))
	{
	    if(AdminPlayer(playerid) < 8) return ms(playerid, 0, "Apenas admin level 8+ !");
	    new cont, file[80];
	    for(new v; v<MAX_VEICULOS; v++)
	    {
	        if(Veiculo[v][v_Existe] == 1 && Veiculo[v][v_Dono] == -1 && (Veiculo[v][v_Emprego] != -1 || Veiculo[v][v_Org] != -1))
	        {
	            Veiculo[v][v_Garagem] = 0;
	            Veiculo[v][v_Contas] = 0;
	            Veiculo[v][v_IPVA] = 30;
	            format(file, 80, "Veiculos/%d.txt", v);
	            if(DOF2_FileExists(file))
	            {
	                DOF2_SetInt(file, "v_Garagem", 0);
	                DOF2_SetInt(file, "v_Contas", 0);
	                DOF2_SetInt(file, "v_IPVA", 30);
	                DOF2_SaveFile();
	            }
	            cont++;
	        }
	    }
	    ms(playerid, 5, f("%d veiculos de empregos/orgs foram restaurados do deposito!", cont));
	    return 1;
	}

	if(!strcmp(cmd, "/vips", true))
	{
	    SG[0] = EOS;
	    new linha[300];
	    new cont;
	    new vip;
	    new tempo;
	    strcat(SG, "ID  Conta\tNome\tVip\tTempo\n");
	    zerar_lista(playerid);
	    for(new a=sizeof nome_vip; a>0; a--)
	    {
		    foreach(new i:Player)
		    {
		        if(cont >= MAX_LISTA || cont > 75) break;
		        if(Online(i))
		        {
		            vip = VipPlayer(i);
		            if(vip == a)
		            {
		            	tempo = Conta[i][c_VipTempo];
		                format(linha, 300, "{ffff00}%d  {00ffff}%d\t{ffffff}%s\t{%06x}%s\t{a1a1a1}%s\n", i, id[i], Nome(i), cor_vip[a-1] >>> 8,  nome_vip[a-1], Validade(tempo));
						strcat(SG, linha);
						Lista[playerid][cont] = i;
						cont ++;
					}
		        }
		    }
	    }

	    format(linha, 300, "{ffffff}Vips e Socios Online {ffff00}[{ffffff}%d{ffff00}]", cont);
	    ShowPlayerDialog(playerid, DIALOG_VIPS, DIALOG_STYLE_TABLIST_HEADERS, linha, SG, "Ok", "Fechar");
		return 1;
	}

	if(!strcmp(cmd, "/admins", true))
	{
	    SG[0] = EOS;
	    new trampo[50];
	    new linha[300];
	    new cont;
	    strcat(SG, "ID     Nome\tAtendimentos\tFuncao  level\tModo\n");
	    zerar_lista(playerid);
	    foreach(new i:Player)
	    {
	        if(cont >= MAX_LISTA || cont > 50) break;
	        if(Online(i))
	        {
	            new niv = AdminPlayer(i);
	            if(niv > 0)
	            {
	                new ad = AdminID(i);
	                if(ModoAdmin[i] == 0) format(trampo, 50, "{ffff00}JOGO");
	                else format(trampo, 50, "{4169E1}TRABALHO");
	                format(linha, 300, "{ffff00}%03d    {ffffff}%s\t{a1a1a1}%d\t{ffffff}%s  {a1a1a1}[%d]\t%s\n",i, Nome(i), Admin[ad][adm_Atendimentos], Admin[ad][adm_Funcao], niv, trampo);
					strcat(SG, linha);
					Lista[playerid][cont] = i;
					cont ++;
				}
	        }
	    }
	    format(linha, 300, "{ffffff}Admins Online {ffff00}[{ffffff}%d{ffff00}]", cont);
	    ShowPlayerDialog(playerid, DIALOG_ADMINS, DIALOG_STYLE_TABLIST_HEADERS, linha, SG, "Continuar", "Fechar");
		return 1;
	}


	if(!strcmp(cmd, "/empresas", true))
	{
	    lista_empresas(playerid);
		return 1;
	}


	if(!strcmp(cmd, "/comandos", true))
	{
	    SG[0] = EOS;
	    strcat(SG, "{ffffff}Comandos Gerais\n");
	    if(EmpregoPlayer(playerid) != -1) strcat(SG, "{00ffff}Comandos do Emprego\n");
	    if(OrgPlayer(playerid) != -1) strcat(SG, "{ffff00}Comandos da Organizacao\n");
	    ShowPlayerDialog(playerid, DIALOG_COMANDOS, DIALOG_STYLE_LIST, "{ffff00}Comandos", SG, "Ver", "Fechar");
	    return 1;
	}


	if(!strcmp(cmd, "/ladmins", true))
	{
		mostrar_admins(playerid);
		return 1;
	}

    if(!strcmp(cmd, "/fix", true)||
	!strcmp(cmd, "/repararveiculo", true))
	{
	    new sss[150];
		if(!IsPlayerInAnyVehicle(playerid)) return ms(playerid, 0, "Voce nao esta em um veiculo !");
		new veic = GetPlayerVehicleID(playerid);
		new v = Info_Veiculo[veic];
		if(v == -1) return ms(playerid, 0, "Este veiculo nao pode ser reparado !");
		Veiculo[v][v_Gasolina] = 100;
		Veiculo[v][v_Bateria] = 100;
		Veiculo[v][v_Vida] = 1000.0;
		RepairVehicle(veic);
		SetVehicleHealth(veic, 1000.0);
		SalvarVeiculo(veic);
		format(sss, 150, "Este veiculo foi reparado totalmente.");
		ms(playerid, 4, sss);
		return 1;
	}

	if(!strcmp(cmd, "/velocidade", true))
	{
		new sss[150];
		new model;
		if(sscanf(params, "d",  model)) return ms(playerid, 2, "Use: /velocidade [ Velocidade Maxima ].");
		if(!IsPlayerInAnyVehicle(playerid)) return ms(playerid, 0, "Voce nao esta em um veiculo !");
		new veic = GetPlayerVehicleID(playerid);
		if(model < -1) return ms(playerid, 0, "Use -1 para automatico, ou defina a velocidade maxima !");
		SetVehicleMaxSpeed(veic, model);
		format(sss, 150, "Velocidade maxida do veiculo alterada para %d km/h.", model);
		ms(playerid, 5, sss);
		return 1;
	}

	if(!strcmp(cmd, "/editar", true))
	{
		new model, local;
		if(sscanf(params, "dd",  model, local)) return ms(playerid, 2, "Use: /editar [model] [local do corpo].");
		SetPlayerAttachedObject(playerid, 9, model, local, 0, 0,0, 0, 0, 0, 1, 1, 1);
		EditAttachedObject2(playerid, 9, model, local);
		return 1;
	}

	if(!strcmp(cmd, "/setarskin", true))
	{
		new skina, idd;
		if(sscanf(params, "dd", idd, skina)) return ms(playerid, 2, "Use: /setarskin [ ID da Conta ] [ 0 - 311 ]");
		if(ContaInvalida(idd)) return ms(playerid, 0, "Esta conta nao existe !");
		if(skina < 0 || skina > 311) return ms(playerid, 0, "Use uma skin de 0 - 311");
	  	SetarSkin(idd, skina);
		new sss[150];
		format(sss, 150, "Voce setou a Skin da conta %d '%s' para ID: %d", idd, NomeConta(idd), skina);
		ms(playerid, 5, sss);
		format(sss, 150, "O Administrador '%s' setou sua Skin para ID: %d", Nome(playerid), skina);
		msc(idd, 0xF08080ff, sss);
		return 1;
	}

	if(!strcmp(cmd, "/largaremprego", true))
	{
		new c = id[playerid];
		new d = EmpregoPlayer(playerid);
		if(c == -1) return MS(playerid, 0, "Voce nao esta em uma conta !");
		if(d == -1) return MS(playerid, 0, "Voce nao tem um Emprego !");
		new string[150];
		format(string, 150, "Voce largou o emprego '%s', e agora esta desempregado !", Emprego[d][e_Nome]);
		MS(playerid, 1, string);
		Conta[playerid][c_Emprego] = -1;
		salvar_conta(c, 0, "c_Emprego", sv_int(-1));
		return 1;
	}


	if(!strcmp(cmd, "/tp", true))
	{
		SetPVarInt(playerid, "destino", 1);
	    mostrar_cidades(playerid);
		return 1;
	}

	if(!strcmp(cmd, "/gmx", true))
	{
	    new sss[150];
		if(GMX == 1) return ms(playerid, 0, "O servidor ja esta reiniciando no momento !");
		gmx();
		format(sss, 150, "[GMX] O Administrador %s esta dando GMX no servidor.", Nome(playerid));
	    foreach(new i:Player) if(Online(i)) ms(i, 4, sss);
		return 1;
	}

	if(!strcmp(cmd, "/gmx2", true))
	{
		if(GMX == 1) return ms(playerid, 0, "O servidor ja esta reiniciando no momento !");
		gmx(1);
	 	ms(playerid, 0, "Voce deu GMX no servidor sem ninguem saber !");
		return 1;
	}

	if(!strcmp(cmd, "/setarnivel", true))
	{
		new sss[300], c, d;
		if(sscanf(params, "dd", c, d)) return ms(playerid, 0, "Use: /setarnivel [ ID da Conta ] [ Nivel ].");
		if(ContaInvalida(c)) return ms(playerid, 0, "Esta Conta nao Existe !");
		if(d < 1 || d > 500) return ms(playerid, 0, "Use um Nivel entre 1 - 500 !");
		new player = ContaOnline(c);
		if(Online(player))
		{
		    Conta[player][c_Nivel] = d;
	    	Conta[player][c_XP] = 0;
		    format(sss, 300, "O Admin %s lhe setou Nivel [%d].", Nome(playerid), d);
			ms(player, 0xF08080ff, sss);
			SetPlayerScore(player, d);
		}
		else
		{
		    salvar_conta(c, 0, "c_Nivel", sv_int(d));
		    salvar_conta(c, 0, "c_XP", sv_int(0));
		}
	    format(sss, 300, "Voce setou Nivel [%d] na conta %d '%s'.", d, c, NomeConta(c));
		ms(playerid, 5, sss);
		return 1;
	}


	if(!strcmp(cmd, "/hp", true))
	{
		new sss[300], c, d;
		if(sscanf(params, "dd", c, d)) return ms(playerid, 0, "Use: /hp [ ID da Conta ] [ Minutos ].");
		if(ContaInvalida(c)) return ms(playerid, 0, "Esta Conta nao Existe !");
		if(d < 0 || d > 500) return ms(playerid, 0, "Use um valor de minutos entre 0 - 500 !");
		new player = ContaOnline(c);
		if(Online(player))
		{
		    Conta[player][c_Morto] = 0;
		    if(GetPlayerInterior(player) != 0 || GetPlayerVirtualWorld_(player) != 0) Conta[player][c_Hospital2] = Conta[player][c_Cidade];
		    else Conta[player][c_Hospital2] = pegar_cidade(player);
			if(d == 0) Conta[player][c_Hospital] = 1;
		    else Conta[player][c_Hospital] = (d*60);
		    format(sss, 300, "O Admin %s lhe Hospitalizou por %s.", Nome(playerid), ConvertTime(d*60));
			ms(player, 0xF08080ff, sss);
			PlayerSpawn(player);
		}
		else
		{
		    salvar_conta(c, 0, "c_Morto", sv_int(0));
		    if(d == 0) salvar_conta(c, 0, "c_Hospital", sv_int(1));
		    else salvar_conta(c, 0, "c_Hospital", sv_int(d*60));
		}
	    format(sss, 300, "Voce Hospitalizou a conta %d '%s', por %s.", c, NomeConta(c), ConvertTime(d*60));
		ms(playerid, 5, sss);
		return 1;
	}
	if(!strcmp(cmd, "/pcam", true))
	{
		Conta[playerid][c_Emprego] = 11;
		SSM(playerid, -1, "{00FF00}OK");
		return 1;
	}
	if(!strcmp(cmd, "/setaremprego", true))
	{
		new sss[300], c, d;
		if(sscanf(params, "dd", c, d)) return ms(playerid, 0, "Use: /setaremprego [ ID da Conta ] [ ID do emprego ]"), ms(playerid, 2, "Se usar -1, o emprego sera removido !");
		if(ContaInvalida(c)) return ms(playerid, 0, "Esta Conta nao Existe !");
		if(d == -1)
		{
		    new player = ContaOnline(c);
			if(Online(player))
			{
	            Conta[player][c_Emprego] = d;
	            format(sss, 300, "O admin %s removeu o seu emprego.", Nome(playerid));
				ms(player, 0xF08080ff, sss);
			}
			else
			{
	            salvar_conta(c, 0, "c_Emprego", sv_int(d));
			}
		    format(sss, 300, "Voce removeu o emprego da conta %d '%s'.", c, NomeConta(c));
			ms(playerid, 5, sss);
		}
		else
		{
		    if(d < 0 || d > MAX_EMPREGOS)  return ms(playerid, 0, "Este emprego nao existe !");
		    if(Emprego[d][e_Existe] == 0)  return ms(playerid, 0, "Este emprego nao existe !");
		    new player = ContaOnline(c);
			if(Online(player))
			{
	            Conta[player][c_Emprego] = d;
	            format(sss, 300, "O Admin %s lhe setou no emprego %d '%s'.", Nome(playerid), d, Emprego[d][e_Nome]);
				ms(player, 0xF08080ff, sss);
			}
			else
			{
	            salvar_conta(c, 0, "c_Emprego", sv_int(d));
			}
		    format(sss, 300, "Voce setou o emprego '%s' na Conta %d '%s'.", Emprego[d][e_Nome], c, NomeConta(c));
			ms(playerid, 5, sss);
		}
		return 1;
	}

	if(!strcmp(cmd, "/guardarveiculos", true))
	{
	    new sss[300], idd;
		if(sscanf(params, "d", idd)) return ms(playerid, 0, "Use: /guardarveiculos [ ID da Conta ]");
		if(idd < 0 || idd >= MAX_CONTAS) return ms(playerid, 0, "ID de Conta Invalido !");
		if(ContaInvalida(idd)) return ms(playerid, 0, "Esta conta nao existe !");
		new cont;
		foreach(new a:Iter_Veiculos)
		{
		    if(Veiculo[a][v_Existe] == 1)
		    {
		        if(Veiculo[a][v_Dono] == idd)
		        {
		            if(Veiculo[a][v_ID] != -1)
		            {
		                if(GetVehicleModel(Veiculo[a][v_ID]) != 0)
		                {
		                	SpawnVeiculo(Veiculo[a][v_ID]);
		                	cont ++;
		                }
		            }
		        }
		    }
		}
		format(sss, 300, "Voce deu Spawn em %d veiculos da conta '%s' [%d].", cont, NomeConta(idd), idd);
		ms(playerid, 5, sss);
		return 1;
	}

	if(!strcmp(cmd, "/sc", true))
	{
		new sss[300], idd;
		if(sscanf(params, "d", idd)) return ms(playerid, 0, "Use: /sc [ ID da Conta ]");
		if(idd < 0 || idd >= MAX_CONTAS) return ms(playerid, 0, "ID de Conta Invalido !");
		if(ContaInvalida(idd)) return ms(playerid, 0, "Esta conta nao existe !");
		new player = ContaOnline(idd);
		if(Online(player))
		{
		    comando(playerid, "/spawnplayer", ConvertMoney(player));
		}
		else
		{
		    salvar_conta(idd, 1, "c_X", sv_float(0.0));
		    salvar_conta(idd, 1, "c_Y", sv_float(0.0));
		    salvar_conta(idd, 1, "c_Z", sv_float(0.0));
		    salvar_conta(idd, 1, "c_A", sv_float(0.0));
		}
		format(sss, 300, "Voce setou a Conta '%s' [%d], para seu local de spawn.", NomeConta(idd), idd);
		ms(playerid, 5, sss);
		format(sss, 300, "O Admin %s lhe setou em seu local de spawn.", Nome(playerid));
		msc(idd, 0xF08080ff, sss);
		return 1;
	}

	if(!strcmp(cmd, "/spawnplayer", true))
	{
		new sss[300], idd;
		if(sscanf(params, "u", idd)) return ms(playerid, 0, "Use: /PlayerSpawn [ ID/Nick ]");
		if(!Online(idd)) return ms(playerid, 0, "Este jogador nao esta Online.");
		if(id[idd] == -1) return ms(playerid, 0, "Este jogador nao esta em uma Conta !");
	    if(tv_player[idd] != -1 ) return ms(playerid, 0, "Este jogador esta de /tv em alguem !");
	    if(tunando[idd] != 0 ) return ms(playerid, 0, "Este jogador esta tunando um veiculo !");
		format(string_prox, 300, "** O Admin '%s' setou %s em seu local de spawn **", Nome(playerid), Nome(idd));
		ProxDetector(20.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
		SetarSpawn(idd);
		PlayerSpawn(idd);
		format(sss, 300, "O Admin %s lhe setou em seu local de spawn.", Nome(playerid));
		ms(idd, 0xF08080ff, sss);
		return 1;
	}

	if(!strcmp(cmd, "/setarcidade", true))
	{
		new c;
		if(sscanf(params, "d", c)) return ms(playerid, 2, "Use: /setarcidade [ ID da Conta ]");
		if(ContaInvalida(c)) return ms(playerid, 0, "Esta Conta nao Existe !");
		SetPVarInt(playerid, "id_conta", c);
		new sss[150];
		for(new i; i<3; i++)
		{
		    strcat(sss, "{a1a1a1}");
		    strcat(sss, cidade(i));
		    strcat(sss, "\n");
		}
		ShowPlayerDialog(playerid, DIALOG_SETAR_CIDADE, DIALOG_STYLE_LIST, NomeConta(c), sss, "Escolher", "Cancelar");
		return 1;
	}


	if(!strcmp(cmd, "/veh", true))
	{
		if(!IsPlayerInAnyVehicle(playerid)) return ms(playerid, 0, "Voce nao esta em um veiculo !");
		format(sttr, 300, "Veiculo Modelo: %d - ID: %d.", GetVehicleModel(GetPlayerVehicleID(playerid)), GetPlayerVehicleID(playerid));
		ms(playerid, 2, sttr);
		return 1;
	}

	if(!strcmp(cmd, "/sv", true))
	{
		new model;
		new text[200];
		new Float:ps[4];
		if(IsPlayerInAnyVehicle(playerid))
		{
		    GetVehiclePos(GetPlayerVehicleID(playerid), ps[0], ps[1], ps[2]);
			GetVehicleZAngle(GetPlayerVehicleID(playerid), ps[3]);
			model = GetVehicleModel(GetPlayerVehicleID(playerid));
			ms(playerid, 1, "Posicao do veiculo salva no banco de dados !");
			if(sscanf(params, "s[200]", text)) format(sttr, 300, "Veiculo - %d, %f, %f, %f, %f", model, ps[0], ps[1], ps[2], ps[3]);
			else format(sttr, 300, "Veiculo - %d, %f, %f, %f, %f   // %s", model, ps[0], ps[1], ps[2], ps[3], text);
		}
		else
		{
		    GetPlayerPos(playerid, ps[0], ps[1], ps[2]);
			GetPlayerFacingAngle(playerid, ps[3]);
			model = GetPlayerSkin_(playerid);
			ms(playerid, 1, "Posicao do player salva no banco de dados !");
			if(sscanf(params, "s[200]", text))  format(sttr, 300, "Player  - %d, %f, %f, %f, %f", model, ps[0], ps[1], ps[2], ps[3]);
			else format(sttr, 300, "Player  - %d, %f, %f, %f, %f   // %s", model, ps[0], ps[1], ps[2], ps[3], text);
		}

		fileLog("Pos", sttr);
		return 1;
	}

	if(!strcmp(cmd, "/avancar", true))
	{
		new Float:pos[3];
		GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
		PegarFrentePlayer(playerid, pos[0], pos[1], 2);
		SetPlayerPos_(playerid, pos[0], pos[1], pos[2]);
		ms(playerid, 5, "Voce avancou 2 metros !");
		return 1;
	}
	
	if(!strcmp(cmd, "/m", true))
	{
		new sss[300], avi[200];
		if(sscanf(params, "s[200]", avi)) return ms(playerid, 2, "Use: /m [ Menssagem ]");
		if(strlen(avi) > 198) return ms(playerid, 0, "Menssagem muito longa, tente novamente !");
		format(sss, 300, "** [MEGA FONE] %s[%d]: %s **", Nome(playerid), playerid, avi);
	    new Float:px, Float:py, Float:pz;
        GetPlayerPos(playerid, px, py, pz);
		foreach(new p:Player)
		{
			if(logado[p] == 0) continue;
			if(id[p] == -1) continue;
			if(GetPlayerInterior(playerid) != GetPlayerInterior(p)) continue;
			if(GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(p)) continue;
			if(IsPlayerInRangeOfPoint(p, MEGAPHONE_RANGE, px, py, pz)) SSM(p, 0xffff00ff, sss);
		}
		return 1;	
	}

