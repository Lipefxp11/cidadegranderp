	if(!strcmp(cmd, "/apreenderitems", true))
	{
		if(!PlayerCop(playerid)) return ms(playerid, 0, "Apenas policiais podem usar este comando !");
		new target;
		if(sscanf(params, "d", target)) return ms(playerid, 2, "Use: /apreenderitems [ ID da Conta ]");
		new player = ContaOnline(target);
		if(!Online(player)) return ms(playerid, 0, "Este jogador nao esta online !");
		if(player_algemado[player] == 0 && Conta[player][c_Morto] == 0) return ms(playerid, 0, "O jogador precisa estar algemado ou morto !");
		new Float:px, Float:py, Float:pz;
		GetPlayerPos(player, px, py, pz);
		if(!IsPlayerInRangeOfPoint(playerid, 5, px, py, pz)) return ms(playerid, 0, "Voce precisa estar proximo do jogador !");
		new cont;
		for(new s; s<MAX_SLOTS; s++)
		{
			new id_item = Inventario[player][s][inv_ID];
			if(id_item == 0) continue;
			if(id_item >= 18 && id_item <= 48) Inventario[player][s][inv_ID] = 0, Inventario[player][s][inv_Unidades] = 0, Inventario[player][s][inv_Tipo] = 0, Inventario[player][s][inv_Ativo] = 0, Inventario[player][s][inv_Tempo] = 0, cont++;
			else if(id_item == 75 || id_item == 76 || id_item == 79 || id_item == 80 || id_item == 81 || id_item == 82 || id_item == 83 || id_item == 84 || id_item == 85 || id_item == 86 || id_item == 91) Inventario[player][s][inv_ID] = 0, Inventario[player][s][inv_Unidades] = 0, Inventario[player][s][inv_Tipo] = 0, Inventario[player][s][inv_Ativo] = 0, Inventario[player][s][inv_Tempo] = 0, cont++;
		}
		if(cont > 0)
		{
			salvar_inventario(id[player], -1);
			abrir_inv_novo(player);
			ResetPlayerWeapons_(player);
			for(new i; i<13; i++) Conta[player][c_Arma][i] = 0, Conta[player][c_Municao][i] = 0;
			salvar_conta(id[player], -1, "c_Armas");
			ms(playerid, 1, f("Voce apreendeu %d itens ilegais de '%s'.", cont, Nome(player)));
			ms(player, 4, f("O policial '%s' apreendeu seus itens ilegais.", Nome(playerid)));
		}
		else ms(playerid, 0, "Este jogador nao possui itens ilegais !");
		return 1;
	}
	if(!strcmp(cmd, "/salvar", true))
	{
		if(PlayerMedico(playerid) || PlayerCop(playerid))
		{
			new Float:p[3];
			foreach(new i:Player)
			{
			    if(i != playerid)
				{
				    if(Online(i) && id[i] != -1)
					{
						if(Conta[i][c_Morto] > 0)
						{
							if(GetPlayerVirtualWorld_(i) == GetPlayerVirtualWorld_(playerid))
							{
								if(GetPlayerInterior(i) == GetPlayerInterior(playerid))
								{
									GetPlayerPos(i, p[0], p[1], p[2]);
									if(IsPlayerInRangeOfPoint(playerid, 1.1, p[0], p[1], p[2]))
									{
										SetPVarInt(playerid, "morto", i);
										SetPVarInt(i, "salvando", playerid);
										SetPlayerToFacePos(playerid, p[0], p[1]);
										KillTimer(timer_morto[i]);
										new tempo = 200;
										Acao(playerid, 1, tempo, "SALVANDO JOGADOR", 1, "COP_AMBIENT", "COPBROWSE_LOOP", true);
										SetPlayerAttachedObject(playerid, 9, 11738, 6, 0.070000, 0.194999, -0.090999,   55.500000, -4.699998, 55.799983,   1.000000, 1.000000, 1.000000);
										return 1;
									}
								}
							}
						}
				    }
			    }
			}
			ms(playerid, 0, "Voce nao esta proximo a alguem gravemente ferido !");
		}
		else ms(playerid, 0, "Voce nao e um medico !");
		return 1;
	}

	if(!strcmp(cmd, "/tratar", true))
	{
	    if(PlayerMedico(playerid) || PlayerCop(playerid))
