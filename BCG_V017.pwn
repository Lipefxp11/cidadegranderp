		strcat(SG, sss);
		format(sss, 200, "{ffffff}Notificacao do Celular\t%s\n", (Conta[playerid][c_WP] == 0)? "{ffffff}Ativado":"{a1a1a1}Desativado");
		strcat(SG, sss);
