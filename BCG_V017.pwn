stock tipo_combustivel(veic, tipo)
{
	new model = GetVehicleModel(veic);
	if(model != 0)
	{
	    if(info_veiculos[model-400][veh_Combustivel] == tipo)
	    {
	        return 1;
	    }
	}
	return 0;
}

stock abastecer_player(playerid, tipo)
{
    if(IsPlayerInAnyVehicle(playerid))
    {
        new sss[300];
        new veic = GetPlayerVehicleID(playerid);
        new v = Info_Veiculo[veic];
        if(v != -1)
        {

            // verificar tipo de combustivel //
            if(!tipo_combustivel(veic, tipo))
            {
                abrir_tabela_player(playerid);
                ms(playerid, 0, "Selecione o tipo de combustivel adequado para o veiculo !");
            }
            else
            {

	            new PL;
	            new tank = Veiculo[v][v_Gasolina];
	            new precisa = 100-tank;
                if(tipo == 0) PL = gov_preco_gasolina + (gov_preco_gasolina * gov_taxa / 100);
                if(tipo == 1) PL = gov_preco_alcool + (gov_preco_alcool * gov_taxa / 100);
                if(tipo == 2) PL = gov_preco_disel + (gov_preco_disel * gov_taxa / 100);
                if(tipo == 3) PL = gov_preco_gas + (gov_preco_gas * gov_taxa / 100);
	            new valor = precisa*PL;

	            // verificar se o tanq ta cheio //
	            if(tank >= 100) ms(playerid, 0, "Este veiculo ja esta com o tanque cheio !");
	            else
	            {

		            // verificar se tem grana pra fazer isso //
		            if(GranaPlayer(playerid) < valor)
		            {
		                format(sss, 300, "Voce nao tem R$ %s para completar o tanque do veiculo !", ConvertMoney(valor));
		                ms(playerid, 0, sss);
		            }
		            else
		            {
				    SetPVarInt(playerid, "valor", valor);
				    SetPVarInt(playerid, "veh", v);
				    SetPVarInt(playerid, "refuel_gas_start", Veiculo[v][v_Gasolina]);
				    Acao(playerid, 3, 200, "COMPLETANDO TANQUE", 0, "null", "null", false);
		            }
	            }
            }
    	}
    	else ms(playerid, 0, "Este veiculo nao pode ser abastecido !");
    }
    else ms(playerid, 0, "Voce nao esta em um Veiculo !");
}

stock abastecer_galao_player(playerid, tipo)
{
	if(Online(playerid))
	{
	    new sss[150];
	    new PL;
        if(tipo == 0) PL = gov_preco_gasolina + (gov_preco_gasolina * gov_taxa / 100);
        if(tipo == 1) PL = gov_preco_alcool + (gov_preco_alcool * gov_taxa / 100);
        if(tipo == 2) PL = gov_preco_disel + (gov_preco_disel * gov_taxa / 100);
        if(tipo == 3) PL = gov_preco_gas + (gov_preco_gas * gov_taxa / 100);
        new valor = 20*PL;

        // verificar se tem grana pra fazer isso //
        if(GranaPlayer(playerid) < valor)
        {
            format(sss, 150, "Voce nao tem R$ %s para completar o tanque do veiculo !", ConvertMoney(valor));
            ms(playerid, 0, sss);
        }
        else
        {
	        SetPVarInt(playerid, "tipo", tipo);
	        SetPVarInt(playerid, "valor", valor);
	        Acao(playerid, 6, 150, "ENCHENDO GALAO", 1, "BD_FIRE", "WASH_UP", true);
			SetPlayerAttachedObject(playerid, 9, 1650, 6, 0.262999, -0.047999, 0.079000,   40.500003, 17.699996, -19.100006,   1.000000, 1.000000, 1.000000);
		}
	}
}

stock diminuir_modelo(i)
{
	new num = 35;
	new model = GetVehicleModel(i);
	if(model != 0)
	{
	    model -= 400;
	    if(info_veiculos[model][veh_Combustivel] == 0) num = 25;
	    if(info_veiculos[model][veh_Combustivel] == 1) num = 30;
	    if(info_veiculos[model][veh_Combustivel] == 2) num = 45;
	    if(info_veiculos[model][veh_Combustivel] == 3) num = 60;
	}
	return num;
}


stock Player_AFK(playerid)
{
	if(IsPlayerConnected(playerid))
	{
	    if(gettime() > AFK[playerid]+1)
	    {
	        return (gettime() - AFK[playerid]);
	    }
	}
	return 0;
}

stock criar_empresa(Float:xx, Float:yy, Float:zz, valor, const nome[])
{
    for(new i; i<MAX_EMPRESAS; i++)
	{
	    if(Empresa[i][em_Existe] == 0)
	    {
	        Empresa[i][em_Existe] = 1;
		    format(Empresa[i][em_Nome], 100, nome);
		    Empresa[i][em_MapaID] = 56;
		    Empresa[i][em_Dono] = -1;
		    Empresa[i][em_Interior] = 12;
		    Empresa[i][em_Entrada] = 100;
		    Empresa[i][em_Produtos] = 0;
		    Empresa[i][em_ValorProdutos] = 250;
		    Empresa[i][em_Cofre] = 5000;
		    Empresa[i][em_Valor] = valor;
		    Empresa[i][em_X] = xx;
		    Empresa[i][em_Y] = yy;
		    Empresa[i][em_Z] = zz;
		    Empresa[i][em_X2] = 412.021972;
		    Empresa[i][em_Y2] = -52.649898;
		    Empresa[i][em_Z2] = 1001.898437;
	        atualizar_empresa(i);
	        salvar_empresa(i);
	        return i;
	    }
	}
	return -1;
}

stock criar_casa(Float:xx, Float:yy, Float:zz, Float:xxx, Float:yyy, Float:zzz, tipo, valor, interior, mundo, cash=0)
{
	for(new i; i<MAX_CASAS; i++)
	{
	    if(Casa[i][casa_Existe] == 0)
	    {
	        Casa[i][casa_Existe] = 1;
			Casa[i][casa_Cidade] = pegar_cidade(-1, xx, yy, zz);
	        Casa[i][casa_X1] = xx;
	        Casa[i][casa_Y1] = yy;
	        Casa[i][casa_Z1] = zz;
	        Casa[i][casa_X2] = xxx;
	        Casa[i][casa_Y2] = yyy;
	        Casa[i][casa_Z2] = zzz;
			Casa[i][casa_X3] = 0.0;
	        Casa[i][casa_Y3] = 0.0;
	        Casa[i][casa_Z3] = 0.0;
	        Casa[i][casa_Tipo] = tipo;
	        Casa[i][casa_Chave] = 0;
	        Casa[i][casa_Venda] = 1;
	        Casa[i][casa_Valor] = valor;
            Casa[i][casa_Interior] = interior;
	        if(mundo == -1) Casa[i][casa_Mundo] = i;
	        else Casa[i][casa_Mundo] = mundo;
	        Casa[i][casa_Dono] = -1;
	        Casa[i][casa_Contas] = 0;
	        Casa[i][casa_Keys][0] = -1;
	        Casa[i][casa_Keys][1] = -1;
	        Casa[i][casa_Keys][2] = -1;
	        Casa[i][casa_Cash] = cash;
	        Casa[i][casa_Garagem] = 0;
	        Casa[i][casa_GarV] = -1;
	        Casa[i][casa_Data] = 7;
	        atualizar_casa(i);
	        atualizar_moveis(i);
	        salvar_casa(i);
	        return i;
	    }
	}
	return -1;
}

stock salvar_compras(i)
{
    new file[80];
    new fil[80];
    if(i > -1 && i < MAX_CASAS)
    {
        if(Casa[i][casa_Existe] == 1)
        {
		    format(file, 80, "Casas/Casa_%d.txt", i);
		    if(DOF2_FileExists(file))
		    {
		        DOF2_SetInt(file, "com_Existe", Compras[i][com_Existe]);
		        DOF2_SetInt(file, "com_Tempo", Compras[i][com_Tempo]);
		        for(new aa; aa<MAX_COMPRAS; aa++)
				{
				    format(fil, 80, "com_Movel_%d", aa);
					DOF2_SetInt(file, fil, Compras[i][com_Movel][aa]);
		        }
			    DOF2_SaveFile();
		    }
	    }
    }
}


stock salvar_casa(i)
{
    new file[80];
	new lin[500];
	new fil[80];
	format(file, 80, "Casas/Casa_%d.txt", i);
	if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
	if(Casa[i][casa_Existe] == 1)
	{
	    DOF2_CreateFile(file);
    	DOF2_SetFloat(file, "casa_X1", Casa[i][casa_X1]);
        DOF2_SetFloat(file, "casa_Y1", Casa[i][casa_Y1]);
        DOF2_SetFloat(file, "casa_Z1", Casa[i][casa_Z1]);
        DOF2_SetFloat(file, "casa_X2", Casa[i][casa_X2]);
        DOF2_SetFloat(file, "casa_Y2", Casa[i][casa_Y2]);
        DOF2_SetFloat(file, "casa_Z2", Casa[i][casa_Z2]);
		DOF2_SetFloat(file, "casa_X3", Casa[i][casa_X3]);
        DOF2_SetFloat(file, "casa_Y3", Casa[i][casa_Y3]);
        DOF2_SetFloat(file, "casa_Z3", Casa[i][casa_Z3]);
        DOF2_SetInt(file, "casa_Tipo", Casa[i][casa_Tipo]);
        DOF2_SetInt(file, "casa_Chave", Casa[i][casa_Chave]);
        DOF2_SetInt(file, "casa_Venda", Casa[i][casa_Venda]);
        DOF2_SetInt(file, "casa_Valor", Casa[i][casa_Valor]);
        DOF2_SetInt(file, "casa_Interior", Casa[i][casa_Interior]);
        DOF2_SetInt(file, "casa_Mundo", Casa[i][casa_Mundo]);
        DOF2_SetInt(file, "casa_Dono", Casa[i][casa_Dono]);
        DOF2_SetInt(file, "casa_Contas", Casa[i][casa_Contas]);
        DOF2_SetInt(file, "casa_Data", Casa[i][casa_Data]);
        DOF2_SetInt(file, "casa_Cidade", Casa[i][casa_Cidade]);
        DOF2_SetInt(file, "casa_Key1", Casa[i][casa_Keys][0]);
        DOF2_SetInt(file, "casa_Key2", Casa[i][casa_Keys][1]);
        DOF2_SetInt(file, "casa_Cash", Casa[i][casa_Cash]);
        DOF2_SetInt(file, "casa_Key1", Casa[i][casa_Keys][0]);
        DOF2_SetInt(file, "casa_Key2", Casa[i][casa_Keys][1]);
        DOF2_SetInt(file, "casa_Key3", Casa[i][casa_Keys][2]);
        DOF2_SetInt(file, "casa_Garagem", Casa[i][casa_Garagem]);
        if(Casa[i][casa_Garagem] == 1)
        {
			DOF2_SetFloat(file, "casa_GarX", Casa[i][casa_GarX]);
			DOF2_SetFloat(file, "casa_GarY", Casa[i][casa_GarY]);
			DOF2_SetFloat(file, "casa_GarZ", Casa[i][casa_GarZ]);
			DOF2_SetInt(file, "casa_GarMundo", Casa[i][casa_GarMundo]);
			DOF2_SetInt(file, "casa_GarInterior", Casa[i][casa_GarInterior]);
			DOF2_SetInt(file, "casa_GarV", Casa[i][casa_GarV]);
        }
        for(new a; a<MAX_MOVEIS; a++)
	    {
	        format(fil, 80, "casa_Movel_%d", a);
            format(lin, 500, "%d|%d|%d|%f|%f|%f|%f|%f|%f|",
			Casa[i][casa_m_Existe][a], Casa[i][casa_m_Status][a], Casa[i][casa_m_ID][a],
            Casa[i][casa_m_X][a], Casa[i][casa_m_Y][a], Casa[i][casa_m_Z][a],
            Casa[i][casa_m_RX][a], Casa[i][casa_m_RY][a], Casa[i][casa_m_RZ][a]);
            DOF2_SetString(file, fil, lin);
	    }
	    DOF2_SaveFile();
	    salvar_compras(i);
	}
}


stock destruir_empresa(i)
{
	if(Empresa[i][em_Existe] == 1)
	{
        // tirar players de dentro da casa //
	    foreach(new p:Player)
	    {
	        if(GetPlayerInterior(p) == Empresa[i][em_Interior] && GetPlayerVirtualWorld_(p) == i)
	        {
				if(IsPlayerInRangeOfPoint(p, 250, Empresa[i][em_X2], Empresa[i][em_Y2], Empresa[i][em_Z2]))
				{
				    SetPlayerPos_(p, Empresa[i][em_X]+0.1, Empresa[i][em_Y]+0.1, Empresa[i][em_Z]+0.1);
					SetPlayerInterior(p, 0);
					SetPlayerVirtualWorld_(p, 0);
					ms(p, 2, "A empresa em que voce estava foi destruida !");
				}
	        }

	        if(GetPlayerInterior(p) == 1 && GetPlayerVirtualWorld_(p) == i)
	        {
				if(IsPlayerInRangeOfPoint(p, 250, 2145.6587, 1597.5542, 999.7676))
				{
				    SetPlayerPos_(p, Empresa[i][em_X]+0.1, Empresa[i][em_Y]+0.1, Empresa[i][em_Z]+0.1);
					SetPlayerInterior(p, 0);
					SetPlayerVirtualWorld_(p, 0);
					ms(p, 2, "A empresa em que voce estava foi destruida !");
				}
	        }
	    }

	    Empresa[i][em_Existe] = 0;
	    atualizar_empresa(i);
	    salvar_empresa(i);
	}
}

stock destruir_casa(i)
{
	if(Casa[i][casa_Existe] == 1)
	{
		// casa em interior //
	    if(Casa[i][casa_Tipo] == 0)
	    {
	        // tirar players de dentro da casa //
		    foreach(new p:Player)
		    {
		        if(GetPlayerInterior(p) == Casa[i][casa_Interior] && GetPlayerVirtualWorld_(p) == Casa[i][casa_Mundo])
		        {
					if(IsPlayerInRangeOfPoint(p, 500, Casa[i][casa_X2], Casa[i][casa_Y2], Casa[i][casa_Z2]))
					{
					    SetPlayerPos_(p, Casa[i][casa_X1]+0.1, Casa[i][casa_Y1]+0.1, Casa[i][casa_Z1]+0.1);
						SetPlayerInterior(p, 0);
						SetPlayerVirtualWorld_(p, 0);
					}
		        }
		    }
	    }

	    Casa[i][casa_Existe] = 0;
	    atualizar_casa(i);
	    atualizar_moveis(i);
	    salvar_casa(i);
	}
}

stock atualizar_moveis(i)
{
	for(new a; a<MAX_MOVEIS; a++) atualizar_movel(i, a);
}

stock moveis_casa(i, con=-1)
{
	new cont;
	if(con == -1)
	{
    	for(new a; a<MAX_MOVEIS; a++) if(Casa[i][casa_m_Existe][a] == 1) cont++;
    }
    if(con == 0)
    {
        for(new a; a<MAX_MOVEIS; a++) if(Casa[i][casa_m_Existe][a] == 1) if(Casa[i][casa_m_Status][a] == 0) cont++;
    }

    if(con == 1)
    {
        for(new a; a<MAX_MOVEIS; a++) if(Casa[i][casa_m_Existe][a] == 1) if(Casa[i][casa_m_Status][a] == 1) cont++;
    }
    return cont;
}

stock atualizar_movel(i, a)
{
    if(IsValidDynamic3DTextLabel(Casa[i][casa_m_3D][a])) DestroyDynamic3DTextLabel(Casa[i][casa_m_3D][a]);
	if(IsValidDynamicObject(Casa[i][casa_m_Obj][a])) DestroyDynamicObject_(Casa[i][casa_m_Obj][a]);
	Casa[i][casa_m_3D][a] = DynamicText3D:-1;
	if(Casa[i][casa_Existe] == 1)
	{
	    if(Casa[i][casa_m_Existe][a] == 1)
	    {
	        new idmovel = Casa[i][casa_m_ID][a];
	        if(Casa[i][casa_m_Status][a] == 1) Casa[i][casa_m_Obj][a] = CreateDynamicObject(moveis[idmovel][mov_Modelo], Casa[i][casa_m_X][a], Casa[i][casa_m_Y][a], Casa[i][casa_m_Z][a], Casa[i][casa_m_RX][a], Casa[i][casa_m_RY][a], Casa[i][casa_m_RZ][a], Casa[i][casa_Mundo], Casa[i][casa_Interior], -1, 35, 35, -1, 0);
			//Casa[i][casa_m_3D][a] = 0;
		}
	}
}

stock atualizar_casa(i)
{
	Iter_Remove(Iter_Casas, i);
	if(IsValidDynamic3DTextLabel(Casa[i][casa_3D1])) DestroyDynamic3DTextLabel(Casa[i][casa_3D1]);
	if(IsValidDynamic3DTextLabel(Casa[i][casa_3D2])) DestroyDynamic3DTextLabel(Casa[i][casa_3D2]);
	if(IsValidDynamic3DTextLabel(Casa[i][casa_3D3])) DestroyDynamic3DTextLabel(Casa[i][casa_3D3]);
	Casa[i][casa_3D1] = DynamicText3D:-1;
	Casa[i][casa_3D2] = DynamicText3D:-1;
	Casa[i][casa_3D3] = DynamicText3D:-1;
	if(IsValidDynamicPickup(Casa[i][casa_Pickup1])) DestroyDynamicPickup(Casa[i][casa_Pickup1]);
	if(IsValidDynamicPickup(Casa[i][casa_Pickup2])) DestroyDynamicPickup(Casa[i][casa_Pickup2]);
	if(IsValidDynamicPickup(Casa[i][casa_Pickup3])) DestroyDynamicPickup(Casa[i][casa_Pickup3]);
	if(IsValidDynamicMapIcon(Casa[i][casa_Mapa1])) DestroyDynamicMapIcon(Casa[i][casa_Mapa1]);
	if(IsValidDynamicMapIcon(Casa[i][casa_Mapa2])) DestroyDynamicMapIcon(Casa[i][casa_Mapa2]);
	if(IsValidDynamicPickup(Casa[i][casa_GarPickup])) DestroyDynamicPickup(Casa[i][casa_GarPickup]);
	if(IsValidDynamic3DTextLabel(Casa[i][casa_GarLabel])) DestroyDynamic3DTextLabel(Casa[i][casa_GarLabel]);
	Casa[i][casa_GarPickup] = 0;
	Casa[i][casa_GarLabel] = DynamicText3D:-1;
	if(Casa[i][casa_Existe] == 1)
	{
	    Iter_Add(Iter_Casas, i);
	    new sss[300];
	    new dono = Casa[i][casa_Dono];
	    new abertaa[30];
	    if(Casa[i][casa_Chave] == 0) format(abertaa, 30, "{ffff00}ABERTA");
	    else format(abertaa, 30, "{ff0000}TRANCADA");
	    if(dono != -1) format(sss, 300, "{00ffff}%s [%d]\n{ffffff}Dono: {a1a1a1}%s\n%s\n\n{a1a1a1}Aperte {FFFFFF}F {a1a1a1}para\nentrar", tipo_casa(i), i, NomeConta(dono), (Casa[i][casa_Venda] == 1)?"{ffff00}A VENDA !":abertaa);
	    else if(Casa[i][casa_Cash] == 1) format(sss, 300, "{00ffff}%s [%d]\n{ffff00}A VENDA !\n{ffff00}%s Cash\n\n{a1a1a1}Aperte {FFFFFF}F {a1a1a1}para\nentrar ou comprar",tipo_casa(i), i, ConvertMoney(Casa[i][casa_Valor]));
	    else format(sss, 300, "{00ffff}%s [%d]\n{ffff00}A VENDA !\n{4169E1}R$ %s\n\n{a1a1a1}Aperte {FFFFFF}F {a1a1a1}para\nentrar ou comprar",tipo_casa(i), i, ConvertMoney(Casa[i][casa_Valor]));
	    Casa[i][casa_3D1] = CreateDynamic3DTextLabel(sss, 0xffffff90, Casa[i][casa_X1], Casa[i][casa_Y1], Casa[i][casa_Z1], 5, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, 0, 0, -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
		Casa[i][casa_3D2] = CreateDynamic3DTextLabel("{ffff00}SAIDA\n{a1a1a1}Aperte {FFFFFF}F {a1a1a1}para\nsair", 0xffffff90, Casa[i][casa_X2], Casa[i][casa_Y2], Casa[i][casa_Z2], 5, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, Casa[i][casa_Mundo], Casa[i][casa_Interior], -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
        if(dono != -1) Casa[i][casa_Pickup1] = CreateDynamicPickup(1272, 1, Casa[i][casa_X1], Casa[i][casa_Y1], Casa[i][casa_Z1], 0, 0, -1, 20, -1, 0);
		else Casa[i][casa_Pickup1] = CreateDynamicPickup(1273, 1, Casa[i][casa_X1], Casa[i][casa_Y1], Casa[i][casa_Z1], 0, 0, -1, 20, -1, 0);
        Casa[i][casa_Pickup2] = CreateDynamicPickup(19134, 1, Casa[i][casa_X2], Casa[i][casa_Y2], Casa[i][casa_Z2], Casa[i][casa_Mundo], Casa[i][casa_Interior], -1, 20, -1, 0);
        if(dono != -1) Casa[i][casa_Mapa1] = CreateDynamicMapIcon(Casa[i][casa_X1], Casa[i][casa_Y1], Casa[i][casa_Z1], 32, 0xffffffff, 0, 0, -1, 100, MAPICON_LOCAL, -1, 0);
		else Casa[i][casa_Mapa1] = CreateDynamicMapIcon(Casa[i][casa_X1], Casa[i][casa_Y1], Casa[i][casa_Z1], 31, 0xffffffff, 0, 0, -1, STREAMER_MAP_ICON_SD, MAPICON_LOCAL, -1, 0);
	
		// nao tiver local do bau definido //
		if(Casa[i][casa_X3] == 0.0 && Casa[i][casa_Y3] == 0.0 && Casa[i][casa_Z3] == 0.0)
		{		
			if(Casa[i][casa_Tipo] == 0)
			{	
				new a = pegar_interior(i);
				Casa[i][casa_X3] = local_bau[a][0];
				Casa[i][casa_Y3] = local_bau[a][1];
				Casa[i][casa_Z3] = local_bau[a][2];
				salvar_casa(i);
			}	
			else
			{
				new Float:ang = GetAngleToPoint(Casa[i][casa_X1], Casa[i][casa_Y1], Casa[i][casa_X2], Casa[i][casa_Y2]);
				Casa[i][casa_X3] = Casa[i][casa_X2];
				Casa[i][casa_Y3] = Casa[i][casa_Y2];
				Casa[i][casa_Z3] = Casa[i][casa_Z2];
				PegarFrente(Casa[i][casa_X3], Casa[i][casa_Y3], ang, 5);
			}		
		}
		format(sss, 300, "{00ffff}Bau da Casa\n{a1a1a1}Aperte {ffffff}ALT {a1a1a1}para\nAcessar");
		Casa[i][casa_3D3] = CreateDynamic3DTextLabel(sss, 0xffffff90, Casa[i][casa_X3], Casa[i][casa_Y3], Casa[i][casa_Z3], 7, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, Casa[i][casa_Mundo], Casa[i][casa_Interior], -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
		CreateDynamicPickup(1272, 1, Casa[i][casa_X3], Casa[i][casa_Y3], Casa[i][casa_Z3], Casa[i][casa_Mundo], Casa[i][casa_Interior], -1, 15, -1, 0);

		if(Casa[i][casa_Garagem] == 1)
		{
		    new gsss[200];
		    format(gsss, 200, "{00ffff}Garagem da Casa\n{a1a1a1}Aperte {ffffff}H {a1a1a1}para\nAbrir");
		    Casa[i][casa_GarLabel] = CreateDynamic3DTextLabel(gsss, 0xffffff90, Casa[i][casa_GarX], Casa[i][casa_GarY], Casa[i][casa_GarZ]+0.5, 7, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, Casa[i][casa_GarMundo], Casa[i][casa_GarInterior], -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0);
		    Casa[i][casa_GarPickup] = CreateDynamicPickup(19131, 1, Casa[i][casa_GarX], Casa[i][casa_GarY], Casa[i][casa_GarZ], Casa[i][casa_GarMundo], Casa[i][casa_GarInterior], -1, 20, -1, 0);
		}
	}
}

stock pegar_interior(i)
{
	new a = 0;
	new Float:dis;
	for(new b; b<sizeof interiores; b++)
	{
		GetDistance(dis, Casa[i][casa_X3], Casa[i][casa_Y3], Casa[i][casa_Z3], interiores[b][0], interiores[b][1], interiores[b][2]);
		if(dis < 18.0)
		{
			a = b;
			break;
		}
	}
	return a;	
}

stock mostrar_entrar_casa(playerid, i)
{
    SetPVarInt(playerid, "casa", i);
	if(Casa[i][casa_Existe] == 1)
	{
	    if(Casa[i][casa_Venda] == 1 || TemChaveCasa(playerid, i))
	    {
			new sss[200];
			if(Casa[i][casa_Cash] == 1) format(sss, 200, "{ffffff}Casa ID [ {00ffff}%d {ffffff}] ~ Cash: {ffff00}%s", i, ConvertMoney(Casa[i][casa_Valor]));
			else format(sss, 200, "{ffffff}Casa ID [ {00ffff}%d {ffffff}] ~ R$ {4169E1}%s", i, ConvertMoney(Casa[i][casa_Valor]));
			if(Casa[i][casa_Venda] == 1)
			    ShowPlayerDialog(playerid, DIALOG_ENTRAR_CASA, DIALOG_STYLE_LIST, sss, "{ffffff}ENTRAR\n{4169E1}COMPRAR", "Continuar", "Fechar");
			else
			    ShowPlayerDialog(playerid, DIALOG_ENTRAR_CASA, DIALOG_STYLE_LIST, sss, "{ffffff}ENTRAR", "Continuar", "Fechar");
	    }
	}
}

BCG:: carregar_elevadores()
{
	new file[60];
	new lin[100];
	new cont;
	for(new i; i<MAX_ELEVADORES; i++)
	{
	    format(file, 60, "Elevadores/Elevador_%d.txt", i);
	    if(DOF2_FileExists(file))
	    {
	        Elevador[i][ele_Existe] = 1;
			Iter_Add(Iter_Elevadores, i);
	        for(new a; a<MAX_ANDARES; a++)
	        {
	            Elevador[i][ele_a_3D][a] = DynamicText3D:-1;
				format(lin, 100, "ele_a_Existe_%d", a);
				Elevador[i][ele_a_Existe][a] = DOF2_GetInt(file, lin);
		        format(lin, 100, "ele_a_X_%d", a);
		        Elevador[i][ele_a_X][a] = DOF2_GetFloat(file, lin);
		        format(lin, 100, "ele_a_Y_%d", a);
		        Elevador[i][ele_a_Y][a] = DOF2_GetFloat(file, lin);
		        format(lin, 100, "ele_a_Z_%d", a);
		        Elevador[i][ele_a_Z][a] = DOF2_GetFloat(file, lin);
		        format(lin, 100, "ele_a_A_%d", a);
		    	Elevador[i][ele_a_A][a] = DOF2_GetFloat(file, lin);
			}
			cont++;
			atualizar_elevador(i);
		}
	}
	printf("** %d elevadores carregadas.", cont);
}

stock salvar_elevador(i)
{
	new file[80];
	new lin[100];
	format(file, 80, "Elevadores/Elevador_%d.txt", i);
	if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
	if(Elevador[i][ele_Existe] == 1)
	{
	    DOF2_CreateFile(file);
	    for(new a; a<MAX_ANDARES; a++)
	    {
	        format(lin, 100, "ele_a_Existe_%d", a);
			DOF2_SetInt(file, lin, Elevador[i][ele_a_Existe][a]);
	        format(lin, 100, "ele_a_X_%d", a);
	        DOF2_SetFloat(file, lin, Elevador[i][ele_a_X][a]);
	        format(lin, 100, "ele_a_Y_%d", a);
	        DOF2_SetFloat(file, lin, Elevador[i][ele_a_Y][a]);
	        format(lin, 100, "ele_a_Z_%d", a);
	        DOF2_SetFloat(file, lin, Elevador[i][ele_a_Z][a]);
	        format(lin, 100, "ele_a_A_%d", a);
	    	DOF2_SetFloat(file, lin, Elevador[i][ele_a_A][a]);
	    }
	    DOF2_SaveFile();
	}
}

stock criar_elevador(Float:xx, Float:yy, Float:zz)
{
	for(new i; i<MAX_ELEVADORES; i++)
	{
	    if(Elevador[i][ele_Existe] == 0)
	    {
	        Elevador[i][ele_Existe] = 1;
	        Iter_Add(Iter_Elevadores, i);
	        Elevador[i][ele_Andar] = 0;
	        Elevador[i][ele_Status] = 0;
	        for(new a; a<MAX_ANDARES; a++)
	        {
	            if(a > 0)
	            {
	                Elevador[i][ele_a_Existe][a] = 0;
	                Elevador[i][ele_a_X][a] = 0;
	                Elevador[i][ele_a_Y][a] = 0;
	                Elevador[i][ele_a_Z][a] = 0;
	                Elevador[i][ele_a_A][a] = 0;
                }
                else
                {
                    Elevador[i][ele_a_Existe][a] = 1;
	                Elevador[i][ele_a_X][a] = xx;
	                Elevador[i][ele_a_Y][a] = yy;
	                Elevador[i][ele_a_Z][a] = zz;
	                Elevador[i][ele_a_A][a] = 0;
                }
	        }
	        atualizar_elevador(i);
	        salvar_elevador(i);
	        return i;
		}
	}
	return -1;
}

stock atualizar_elevador(i)
{
	if(IsValidDynamicObject(Elevador[i][ele_Obj])) DestroyDynamicObject_(Elevador[i][ele_Obj]);
	if(IsValidDynamicObject(Elevador[i][ele_pf1_Obj])) DestroyDynamicObject_(Elevador[i][ele_pf1_Obj]);
	if(IsValidDynamicObject(Elevador[i][ele_pf2_Obj])) DestroyDynamicObject_(Elevador[i][ele_pf2_Obj]);
	atualizar_portas_elevador(i);
}


stock texto_elevador(i)
{
	new sss[300];
	new Float:p[4];
	new testd[15];
    for(new a; a<MAX_ANDARES; a++)
	{
		p[0] = Elevador[i][ele_a_X][a];
		p[1] = Elevador[i][ele_a_Y][a];
		p[2] = Elevador[i][ele_a_Z][a];
		p[3] = Elevador[i][ele_a_A][a];
		PegarFrente(p[0], p[1], p[3], -2);
		p[3] += 90.0;
		if(p[3] > 360.0) p[3] -= 360.0;
		PegarFrente(p[0], p[1], p[3], 2);
	    if(IsValidDynamic3DTextLabel(Elevador[i][ele_a_3D][a])) DestroyDynamic3DTextLabel(Elevador[i][ele_a_3D][a]);
	    Elevador[i][ele_a_3D][a] = DynamicText3D:-1;
 	    if(Elevador[i][ele_a_Existe][a] == 1)
	    {
	        if(Elevador[i][ele_Status] == 0)
	        {
	            format(testd, 15, "Andar [%d]", Elevador[i][ele_Andar]);
	            if(Elevador[i][ele_Andar] != a) format(sss, 300, "{ffffff}ELEVADOR\n{00ffff}No %s\n\n{a1a1a1}Aperte {ffffff}F {a1a1a1}para\nchamar o elevador", (Elevador[i][ele_Andar] == 0)? "Terrio":testd);
				else format(sss, 300, "{ffffff}ELEVADOR\n{00ffff}LIVRE\n\n{a1a1a1}Aperte {ffffff}F {a1a1a1}para\nusar");
			}
	        else
	        {
	            format(testd, 15, "Andar [%d]", Elevador[i][ele_Proximo]);
	            if(Elevador[i][ele_Proximo] == a) format(sss, 300, "{ffffff}ELEVADOR\n{4169E1}CHEGANDO");
	            else format(sss, 300, "{ffffff}ELEVADOR\n{ff0000}Indo ao %s", (Elevador[i][ele_Proximo]== 0)? "Terrio":testd);
	        }
			Elevador[i][ele_a_3D][a] = CreateDynamic3DTextLabel( sss, 0xffffff90, p[0], p[1], p[2], 3, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0, -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
	    }
	}
}

stock atualizar_portas_elevador(i)
{
	for(new a; a<MAX_ANDARES; a++)
	{
	    if(IsValidDynamicObject(Elevador[i][ele_pa1_Obj][a])) DestroyDynamicObject_(Elevador[i][ele_pa1_Obj][a]);
	    if(IsValidDynamicObject(Elevador[i][ele_pa2_Obj][a])) DestroyDynamicObject_(Elevador[i][ele_pa2_Obj][a]);
	    if(Elevador[i][ele_Existe] == 1)
	    {
	        new andar = Elevador[i][ele_Andar];
	        if(Elevador[i][ele_a_Existe][a] == 1)
			{
			    new Float:p[4];
				p[0] = Elevador[i][ele_a_X][a];
				p[1] = Elevador[i][ele_a_Y][a];
				p[2] = Elevador[i][ele_a_Z][a];
				p[3] = Elevador[i][ele_a_A][a];
				p[3] += 90.0;
				if(p[3] > 360.0) p[3] -= 360.0;
				PegarFrente(p[0], p[1], p[3], 0.1);
				p[3] = Elevador[i][ele_a_A][a];
		        if(andar == a)
		        {
		        	Elevador[i][ele_Obj] = CreateDynamicObject(18755, Elevador[i][ele_a_X][a], Elevador[i][ele_a_Y][a], Elevador[i][ele_a_Z][a], 0, 0, Elevador[i][ele_a_A][a], 0, 0, -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
					PegarFrente(p[0], p[1], p[3], -1.7);
					Elevador[i][ele_pa1_Obj][a] = CreateDynamicObject(18756, p[0], p[1], p[2], 0, 0, p[3], 0, 0, -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
	                PegarFrente(p[0], p[1], p[3], 3.4);
					Elevador[i][ele_pa2_Obj][a] = CreateDynamicObject(18757, p[0], p[1], p[2], 0, 0, p[3], 0, 0, -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
				}
		        else
		        {
					Elevador[i][ele_pa1_Obj][a] = CreateDynamicObject(18756, p[0], p[1], p[2], 0, 0, p[3], 0, 0, -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
					Elevador[i][ele_pa2_Obj][a] = CreateDynamicObject(18757, p[0], p[1], p[2], 0, 0, p[3], 0, 0, -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
				}
			}
	    }
	}
	texto_elevador(i);
}

BCG:: mover_elevador(i, a, con)
{

	if(Elevador[i][ele_Existe] == 1)
	{
	    // movendo //
	    if(con == -1)
	    {
	        if(!IsDynamicObjectMoving(Elevador[i][ele_Obj]))
	        {
	            KillTimer(Elevador[i][ele_Timer]);
	            Elevador[i][ele_Timer] = SetTimerEx("mover_elevador", 2500, false, "ddd", i, a, 2);
	        }
	    }
	    else
	    {

		    // liberar //
		    if(con == -2)
		    {
		        KillTimer(Elevador[i][ele_Timer]);
		        Elevador[i][ele_Status] = 0;
		        texto_elevador(i);
		    }

			// fechar portas //
			if(con == 0)
			{
			    KillTimer(Elevador[i][ele_Timer]);
			    new andar = Elevador[i][ele_Andar];
			    new Float:p[4];
			    p[0] = Elevador[i][ele_a_X][andar];
				p[1] = Elevador[i][ele_a_Y][andar];
				p[2] = Elevador[i][ele_a_Z][andar];
				p[3] = Elevador[i][ele_a_A][andar];
				p[3] += 90.0;
				if(p[3] > 360.0) p[3] -=360.0;
				PegarFrente(p[0], p[1], p[3], 0.1);
				MoveDynamicObject(Elevador[i][ele_pa1_Obj][andar], p[0], p[1], p[2], 2.0, -1000.0, -1000.0, -1000.0);
				MoveDynamicObject(Elevador[i][ele_pa2_Obj][andar], p[0], p[1], p[2], 2.0, -1000.0, -1000.0, -1000.0);
				Elevador[i][ele_Proximo] = a;
				Elevador[i][ele_Status] = 1;
				Elevador[i][ele_Timer] = SetTimerEx("mover_elevador", 2500, false, "ddd", i, a, 1);
				texto_elevador(i);
			}

			// mover //
			if(con == 1)
			{
			    KillTimer(Elevador[i][ele_Timer]);
			    new andar = Elevador[i][ele_Andar];
			    new Float:p[4];
			    p[0] = Elevador[i][ele_a_X][andar];
				p[1] = Elevador[i][ele_a_Y][andar];
				p[2] = Elevador[i][ele_a_Z][andar];
				p[3] = Elevador[i][ele_a_A][andar];
	        	Elevador[i][ele_pf1_Obj] = CreateDynamicObject(18756, p[0], p[1], p[2], 0, 0, Elevador[i][ele_a_A][andar], 0, 0, -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
				Elevador[i][ele_pf2_Obj] = CreateDynamicObject(18757, p[0], p[1], p[2], 0, 0, Elevador[i][ele_a_A][andar], 0, 0, -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
				foreach(new pla:Player) if(Online(pla)) if(IsPlayerInRangeOfPoint(pla, 5, p[0], p[1], p[2])) Streamer_Update(pla);
	            p[0] = Elevador[i][ele_a_X][a];
				p[1] = Elevador[i][ele_a_Y][a];
				p[2] = Elevador[i][ele_a_Z][a];
				p[3] = Elevador[i][ele_a_A][a];
				MoveDynamicObject(Elevador[i][ele_Obj], Elevador[i][ele_a_X][a], Elevador[i][ele_a_Y][a], Elevador[i][ele_a_Z][a], 2.0, -1000.0, -1000.0, -1000.0);
				MoveDynamicObject(Elevador[i][ele_pf1_Obj], p[0], p[1], p[2], 2.0, -1000.0, -1000.0, -1000.0);
				MoveDynamicObject(Elevador[i][ele_pf2_Obj], p[0], p[1], p[2], 2.0, -1000.0, -1000.0, -1000.0);
	            Elevador[i][ele_Status] = 1;
	            Elevador[i][ele_Timer] = SetTimerEx("mover_elevador", 1000, true, "ddd", i, a, -1);
			}

			// abrir portas //
			if(con == 2)
			{

			    KillTimer(Elevador[i][ele_Timer]);
			 	new Float:p[4];
			    if(IsValidDynamicObject(Elevador[i][ele_pf1_Obj])) DestroyDynamicObject_(Elevador[i][ele_pf1_Obj]);
		    	if(IsValidDynamicObject(Elevador[i][ele_pf2_Obj])) DestroyDynamicObject_(Elevador[i][ele_pf2_Obj]);
			    p[0] = Elevador[i][ele_a_X][a];
				p[1] = Elevador[i][ele_a_Y][a];
				p[2] = Elevador[i][ele_a_Z][a];
				p[3] = Elevador[i][ele_a_A][a];
				p[3] += 90.0;
				if(p[3] > 360.0) p[3] -=360.0;
				PegarFrente(p[0], p[1], p[3], 0.1);
				p[3] = Elevador[i][ele_a_A][a];
				PegarFrente(p[0], p[1], p[3], -1.7);
	            MoveDynamicObject(Elevador[i][ele_pa1_Obj][a], p[0], p[1], p[2], 2.0, -1000.0, -1000.0, -1000.0);
				PegarFrente(p[0], p[1], p[3], 3.4);
				MoveDynamicObject(Elevador[i][ele_pa2_Obj][a], p[0], p[1], p[2], 2.0, -1000.0, -1000.0, -1000.0);
				Elevador[i][ele_Status] = 1;
				Elevador[i][ele_Andar] = a;
				Elevador[i][ele_Timer] = SetTimerEx("mover_elevador", 1000, true, "ddd", i, a, -2);
				Play_Som(6401, p[0], p[1], p[2], 0, 0);
			}
		}
	}
}

stock player_elevador(playerid, i, a)
{
	if(Elevador[i][ele_Existe] == 1)
	{
	    SetPVarInt(playerid, "elevador", i);
	    SetPVarInt(playerid, "andar", a);
	    if(Elevador[i][ele_Status] == 1) ms(playerid, 0, "O elevador esta em movimento, aguarde e tente novamente !");
	    else
	    {

		    if(Elevador[i][ele_Andar] != a)
		    {
		        mover_elevador(i, a, 0);
		        ms(playerid, 1, "Voce chamou o elevador, aguarde.");
		    }
		    else
		    {
			    SG[0] = EOS;
				for(new aa; aa<MAX_ANDARES; aa++)
				{
				if(Elevador[i][ele_a_Existe][aa] == 1)
				{
					if(Elevador[i][ele_Andar] == aa) strcat(SG, "{00ffff}");
					else strcat(SG, "{ffffff}");
					if(aa == 0) strcat(SG, "Terrio\n");
					else
						{
							strcat(SG, "Andar [ ");
							strcat(SG, ConvertMoney(aa));
							strcat(SG, " ]\n");
					}
				}
			    }
			    ShowPlayerDialog(playerid, DIALOG_ELEVADOR, DIALOG_STYLE_LIST, "{ffff00}ELEVADOR",  SG, "Ir", "Cancelar");
			}
		}
	}
}


stock tipo_casa(i)
{
	new tips[30];
	format(tips, 30, "Nenhum");
	if(Casa[i][casa_Existe] == 1)
	{
	    if(Casa[i][casa_Tipo] == 0) format(tips, 30, "Casa");
	    if(Casa[i][casa_Tipo] == 1) format(tips, 30, "Apartamento");
	}
	return tips;
}

stock tipo_casa2(i)
{
	new tips[30];
	format(tips, 30, "Nenhum");
	if(Casa[i][casa_Existe] == 1)
	{
	    if(Casa[i][casa_Tipo] == 0) format(tips, 30, "CASA");
	    if(Casa[i][casa_Tipo] == 1) format(tips, 30, "APARTAMENTO");
	}
	return tips;
}


stock tipo_movel(a)
{
	new nome[40];
	format(nome, 40, "Nenhum");
	if(a > -1 && a < sizeof moveis)
	{
	    if(moveis[a][mov_Tipo] == 0) format(nome, 40, "Sala");
	    if(moveis[a][mov_Tipo] == 1) format(nome, 40, "Quarto");
	    if(moveis[a][mov_Tipo] == 2) format(nome, 40, "Cozinha");
	    if(moveis[a][mov_Tipo] == 3) format(nome, 40, "Banheiro");
	    if(moveis[a][mov_Tipo] == 4) format(nome, 40, "Decorativo");
	}
	return nome;
}

stock tipo_movel2(a)
{
	new nome[40];
	format(nome, 40, "Nenhum");
    if(a == 0) format(nome, 40, "Sala");
    if(a == 1) format(nome, 40, "Quarto");
    if(a == 2) format(nome, 40, "Cozinha");
    if(a == 3) format(nome, 40, "Banheiro");
    if(a == 4) format(nome, 40, "Decorativo");
	return nome;
}

stock criar_movel(i, m, Float:xx, Float:yy, Float:zz )
{
	if(Casa[i][casa_Existe] == 1)
	{
		for(new a; a<MAX_MOVEIS; a++)
		{
			if(Casa[i][casa_m_Existe][a] == 0)
			{
			    Casa[i][casa_m_Existe][a] = 1;
			    Casa[i][casa_m_Status][a] = 1;
			    Casa[i][casa_m_ID][a] = m;
			    Casa[i][casa_m_X][a] = xx;
			    Casa[i][casa_m_Y][a] = yy;
			    Casa[i][casa_m_Z][a] = zz;
			    Casa[i][casa_m_RX][a] = 0;
			    Casa[i][casa_m_RY][a] = 0;
			    Casa[i][casa_m_RZ][a] = 0;
			    atualizar_movel(i, a);
			    salvar_casa(i);
			    return a;
			}
		}
	}
	return -1;
}



stock entregar_moveis(i)
{
    if(Casa[i][casa_Existe] == 1)
	{
		new cont;
		new movel[MAX_COMPRAS];
		for(new aa; aa<MAX_COMPRAS; aa++)
		{
		    if(Compras[i][com_Movel][aa] != -1)
		    {
		        movel[cont] = Compras[i][com_Movel][aa];
		        cont++;
		    }
		}

		new cont2;
	    for(new a; a<MAX_MOVEIS; a++)
	    {
	        if(cont2 < cont)
	        {
		        if(Casa[i][casa_m_Existe][a] == 0)
		        {
		            Casa[i][casa_m_Existe][a] = 1;
		            Casa[i][casa_m_Status][a] = 0;
		            Casa[i][casa_m_ID][a] = movel[cont2];
		            cont2++;
		        }
	        }
	    }

	    new sss[150];
	    Compras[i][com_Existe] = 0;
	    Compras[i][com_Tempo] = 0;
	    for(new aaa; aaa<MAX_COMPRAS; aaa++) Compras[i][com_Movel][aaa] = -1;
	    salvar_casa(i);
	    format(sss, 150, "%d Moveis chegaram da Loja ate o(a) %s [%d].", cont, tipo_casa(i), i);
	    if(Casa[i][casa_Dono] != -1) msc(Casa[i][casa_Dono], 5, sss);
	}
}

stock mostrar_compras(playerid, i)
{
    new c = id[playerid];
	if(c != -1)
	{
		if(Online(playerid))
	    {
		    if(Casa[i][casa_Existe] == 1)
		    {
		        if(Casa[i][casa_Dono] == c)
		        {
		            new sss1[150];
		            new sss[500];
		            if(comprando_moveis[playerid] == -1)
		            {
		                format(sss1, 150, "Voce escolheu o(a) %s [%d], va ate as Secoes da Loja para escolher os moveis por categorias.", tipo_casa(i), i);
				    ms(playerid, 2, sss1);
				    ms(playerid, 2, "Depois de escolher os moveis que quer comprar, volte ate aqui para pagar e finalizar a compra !");
	                    Compras[i][com_Existe] = 1;
		                Compras[i][com_Tempo] = 0;
		                salvar_compras(i);
		                comprando_moveis[playerid] = i;
					}
					else
					{
					    if(i == comprando_moveis[playerid])
						{
				        format(sss, 500, "\
							{4169E1}Pagar e Finalizar\n\
							{ffffff}Moveis no Carrinho [ {ffff00}%s {ffffff}]\n\
							{ff0000}Cancelar Tudo\n", ConvertMoney(moveis_no_carrinho(i)));
				        format(sss1, 150, "%s [%d] - Compras de Moveis", tipo_casa(i), i);
				        ShowPlayerDialog(playerid, DIALOG_CASAS_COMPRAS2, DIALOG_STYLE_LIST, sss1, sss, "Continuar", "Fechar");
						}
						else
						{
						    ms(playerid, 0, "Voce ja esta comprando moveis para uma residencia, finalize a compra ou cancele para escolher outra.");
						    mostrar_compras_casas(playerid);
						}
					}
				}
		        else mostrar_compras_casas(playerid);
		    }
		    else mostrar_compras_casas(playerid);
		}
	}
}


stock valor_moveis(i)
{
	new cont;
	new mov;
	if(Casa[i][casa_Existe] == 1)
	{
	    if(Compras[i][com_Existe] == 1)
	    {
	        for(new a; a<MAX_COMPRAS; a++)
	        {
	            mov = Compras[i][com_Movel][a];
		        if(mov != -1)
		        {
		            cont += moveis[mov][mov_Valor];
		        }
	        }
	    }
	}
	return cont;
}


stock moveis_no_carrinho(i)
{
	new cont;
	if(Casa[i][casa_Existe] == 1)
	{
	    if(Compras[i][com_Existe] == 1)
	    {
	        for(new a; a<MAX_COMPRAS; a++)
	        {
		        if(Compras[i][com_Movel][a] != -1)
		        {
		            cont++;
		        }
	        }
	    }
	}
	return cont;
}



stock mostrar_compras_casas(playerid)
{
    new c = id[playerid];
	if(c != -1)
	{
	    if(Online(playerid))
	    {
	        new sss[300];
	        new Float:dist;
	        new Float:p[3];
	        GetPlayerPos(playerid, p[0], p[1], p[2]);
	        new cont;
	        SG[0] = EOS;
	        Lista2[playerid][0] = -1;
	        strcat(SG, "ID\tTipo\tDistancia\n");
	        foreach(new i:Iter_Casas)
	        {
	            if(cont >= MAX_LISTA) break;
	            if(Casa[i][casa_Existe] == 1)
	            {
	                if(Casa[i][casa_Dono] == c)
	                {
						GetDistance(dist, p[0], p[1], p[2], Casa[i][casa_X1], Casa[i][casa_Y1], Casa[i][casa_Z1]);
	                    format(sss, 300, "{a1a1a1}%d\t{00ffff}%s\t{ffffff}%.0f Metros\n", i, tipo_casa(i), dist);
	                    strcat(SG, sss);
	                    Lista2[playerid][cont] = i;
	                    cont ++;
	                }
	            }
	        }
	        format(sss, 300, "{ffffff}Suas Casas [ {ffff00}%d {ffffff}]", cont);
	        ShowPlayerDialog(playerid, DIALOG_CASAS_COMPRAS, DIALOG_STYLE_TABLIST_HEADERS, sss, SG, "Continuar", "Fechar");
		}
	}
}

stock mostrar_carrinho_compras(playerid, i)
{

	new cont;
	new mov;
	new sss[200];
    SG[0] = EOS;
	strcat(SG, "Movel\tCategoria\tValor\n");
	for(new a; a<MAX_COMPRAS; a++)
	{
	    if(cont >= MAX_LISTA) break;
	    Lista2[playerid][cont] = -1;
	    if(Compras[i][com_Movel][a] != -1)
	    {
	        mov = Compras[i][com_Movel][a];
	        format(sss, 200, "{ffffff}%s\t{a1a1a1}%s\t{4169E1}R$ %s\n", moveis[mov][mov_Nome], tipo_movel(mov), ConvertMoney(moveis[mov][mov_Valor]));
			strcat(SG, sss);
			Lista2[playerid][cont] = a;
			cont ++;
	    }
	}
	format(sss, 150, "{ffffff}Valor Total {4169E1}R$ %s", ConvertMoney(valor_moveis(i)));
	ShowPlayerDialog(playerid, DIALOG_CASAS_COMPRAS4, DIALOG_STYLE_TABLIST_HEADERS, sss, SG, "Remover", "Voltar");
}

stock mostrar_lista_moveis(playerid, con)
{
    new cont;
	menu_id[playerid] = MENU_MOVEIS;
	format(nome_menu[playerid], 100, "Moveis - %s", tipo_movel2(con));
	format(botao_menu[playerid], 100, "ADICIONAR");
	for(new i; i<sizeof moveis; i++)
	{
	    if(cont <MAX_MENU)
	    {
			if(moveis[i][mov_Tipo] == con)
			{
			    Menu[playerid][cont][menu_ID] = i;
			    Menu[playerid][cont][menu_Unidades] = 1;
			    Menu[playerid][cont][menu_Tipo] = con;
			    Menu[playerid][cont][menu_Valor] = moveis[i][mov_Valor];
			    format(Menu[playerid][cont][menu_Nome], 200, "%d - %s", cont+1, moveis[i][mov_Nome]);
			    format(Menu[playerid][cont][menu_Info], 200, "~w~Categoria: ~y~%s~n~~w~Valor: ~g~~h~R$ %s", tipo_movel(i), ConvertMoney(moveis[i][mov_Valor]));
			    Menu[playerid][cont][menu_Modelo] = moveis[i][mov_Modelo];
			    cont++;
		    }
	    }
	}
	max_menu[playerid] = cont;
	if(cont != 0) escolhendo_menu[playerid] = 0;
	else escolhendo_menu[playerid] = -1;
	mostrar_menu(playerid, menu_id[playerid]);
}

stock pegar_local_funcao(playerid, pick)
{
    funcao_pos[playerid][0] = Pickup[pick][pick_X1];
    funcao_pos[playerid][1] = Pickup[pick][pick_Y1];
    funcao_pos[playerid][2] = Pickup[pick][pick_Z1];
}

stock funcao_liberada(playerid, pick)
{
	foreach(new i:Player)
	{
	    if(Online(i))
	    {
	        if(i != playerid)
	        {
				if(funcao_usando[i] == pick)
				{
				    if(IsPlayerInRangeOfPoint(i, 50, Pickup[pick][pick_X], Pickup[pick][pick_Y], Pickup[pick][pick_Z]))
					{
					return 0;
				}
				else funcao_usando[i] = -1;
				}
	       	}
	    }
	}
	return 1;
}

stock veiculo_na_funcao(pick)
{
	new Float:dis;
	new Float:pos[3];
	new veis;
	new vei = -1;
	foreach(new v:Vehicles)
	{
	    if(GetVehicleModel(v) != 0)
	    {
	        if(Info_Veiculo[v] != -1)
	        {
	            GetVehiclePos(v, pos[0], pos[1], pos[2]); //
	            GetDistance(dis, pos[0], pos[1], pos[2], Pickup[pick][pick_X1], Pickup[pick][pick_Y1], Pickup[pick][pick_Z1]);
	            if(dis <= 3.0)
	            {
	                veis ++;
	                vei = v;
	            }
	        }
		}
	}
	if(veis > 1) return -2;
	return vei;
}

stock veiculo_oficina(playerid)
{
	new veh = funcao_id[playerid];
	if(GetVehicleModel(veh) != 0)
	{
	    if(Info_Veiculo[veh] != -1)
	    {
	        if(funcao_usando[playerid] != -1)
	        {
	            new Float:dis;
                new Float:pos[3];
                GetVehiclePos(veh, pos[0], pos[1], pos[2]);
	            GetDistance(dis, pos[0], pos[1], pos[2], funcao_pos[playerid][0], funcao_pos[playerid][1], funcao_pos[playerid][2]);
	            if( dis <= 3.0 )
	            {
	                return 1;
                }
	        }
	    }
	}
	return 0;
}

stock tunagem(playerid, pick)
{
    new c = id[playerid];
	if(c != -1)
	{
	    pegar_local_funcao(playerid, pick);
        if(funcao_liberada(playerid, pick))
        {
            new veh = veiculo_na_funcao(pick);
            if(veh != -1)
            {
                if(veh == -2) ms(playerid, 0, "Ha mais de 1 veiculo no local de tunagem !");
                else
                {
	                if(GetVehicleModel(veh) != 0)
	                {
	                    new inf = Info_Veiculo[veh];
	                    if(inf != -1)
	                    {
	                        if(Veiculo[inf][v_Emprego] != -1 || Veiculo[inf][v_Org] != -1)
	                            return ms(playerid, 0, "Nao e possivel Tunar Veiculos de empregos ou corporacoes !");
							funcao_id[playerid] = veh;
	                        funcao_usando[playerid] = pick;
	                        SetVehicleParamsEx_(veh, 0, 0, 0, 0, 0, 0, 0);
	                        comecar_tunagem(playerid, veh);
	                        SetVehicleZAngle(veh, 0.0);
	                        GameTextForPlayer(playerid, "~W~APERTE ~Y~F ~w~OU ~Y~ENTER ~W~PARA~N~~B~~H~ABRIR O MENU", 2000, 3);
						}
					}
                }
            }
            else ms(playerid, 0, "Nenhum veiculo esta posicionado no local de tunagem !");
	   	}
	   	else ms(playerid, 0, "Algum mecanico esta um veiculo no momento, aguarde e tente novamente !");
	}
	return 1;
}

stock desmanche(playerid, pick)
{
    new c = id[playerid];
	if(c != -1)
	{
        pegar_local_funcao(playerid, pick);
        if(funcao_liberada(playerid, pick))
        {
            new veh = veiculo_na_funcao(pick);
            if(veh != -1)
            {
                if(veh == -2) ms(playerid, 0, "Ha mais de 1 veiculo no local de desmanche !");
                else
                {
				if(GetVehicleModel(veh) != 0)
				{
					new inf = Info_Veiculo[veh];
					if(inf != -1)
					{
					    if(Veiculo[inf][v_Existe] != 1)
					        return ms(playerid, 0, "Veiculo invalido para desmanche !");
					    if(Veiculo[inf][v_Emprego] != -1 || Veiculo[inf][v_Org] != -1)
						return ms(playerid, 0, "Nao e possivel Desmanchar Veiculos de empregos ou corporacoes !");
					    if(GetVehicleModel(veh) == 481)
						return ms(playerid, 0, "Nao e possivel Desmanchar veiculos alugados !");
	                    SetPVarInt(playerid, "pick", pick);
	          			desmanche_veiculo(playerid, veh);
	          			}
          			}
                }
            }
            else ms(playerid, 0, "Nenhum veiculo esta posicionado no local de desmanche !");
		}
		else ms(playerid, 0, "Alguem ja esta desmanchando um veiculo no momento, aguarde e tente mais tarde !");
	}
	return 1;
}

stock concerto_total(playerid, pick)
{
	new c = id[playerid];
	if(c != -1)
	{
	    pegar_local_funcao(playerid, pick);
        if(funcao_liberada(playerid, pick))
        {
            new veh = veiculo_na_funcao(pick);
            if(veh != -1)
            {
                if(veh == -2) ms(playerid, 0, "Ha mais de 1 veiculo no local de concerto !");
                else
                {
					if(GetVehicleModel(veh) != 0)
					{
						new inf = Info_Veiculo[veh];
						if(inf != -1)
						{
		                    SetPVarInt(playerid, "pick", pick);
		          			status_veiculo(playerid, veh);
	          			}
          			}
                }
            }
            else ms(playerid, 0, "Nenhum veiculo esta posicionado no local de concerto !");
	   	}
	   	else ms(playerid, 0, "Algum mecanico esta concertando um veiculo no momento, aguarde e tente novamente !");
	}
}

stock EmInterior(playerid)
{
    if(GetPlayerInterior(playerid) != 0) return 1;
	if(GetPlayerVirtualWorld_(playerid) != 0) return 1;
	return 0;
}

stock Procurado(playerid)
{
	if(Online(playerid))
	{
	    new c = id[playerid];
	    if(c != -1)
	    {
	        if(Conta[playerid][c_Procurado] > 0)
	        {
	            return 1;
	        }
	    }
	}
	return 0;
}

stock entrar_arena(playerid)
{
	if(Online(playerid))
	{
	    if(GetPVarInt(playerid, "vdp") > gettime())  ms(playerid, 0, "Voce nao pode entrar na arena, pois recebeu voz de prisao !!");
	    else if(EmCombate(playerid)) ms(playerid, 0, "Voce nao pode entrar na arena em combate !!");
		else
		{
			new c = id[playerid];
			if(c != -1)
			{
			    if(player_arena[playerid] == 0)
				{
					Conta[playerid][c_Interior] = GetPlayerInterior(playerid);
					Conta[playerid][c_Mundo] = GetPlayerVirtualWorld_(playerid);
				GetPlayerPos(playerid, Conta[playerid][c_X], Conta[playerid][c_Y], Conta[playerid][c_Z]);
				GetPlayerFacingAngle(playerid, Conta[playerid][c_A]);
				fechar_celular(playerid, 1);
					salvar_conta(c, -1, "c_Posicao");
					salvar_conta(conta, playerid, "c_Armas");
				    new rand = random(sizeof pos_arena);
					if(IsValidDynamicActor(actor_player[playerid])) DestroyDynamicActor(actor_player[playerid]);
	                actor_player[playerid] = CreateDynamicActor(GetPlayerSkin_(playerid), Conta[playerid][c_X], Conta[playerid][c_Y], Conta[playerid][c_Z], Conta[playerid][c_A], 0, 9999999.0, Conta[playerid][c_Mundo], Conta[playerid][c_Interior], -1, STREAMER_ACTOR_SD, -1, 0);
	                if(IsValidDynamic3DTextLabel(actor_player_3D[playerid])) DestroyDynamic3DTextLabel(actor_player_3D[playerid]);
					new str_nick[150];
					format(str_nick, 150, "{00ffff}%d {ffff00}%d\n{a1a1a1}JOGANDO ARENA", c, playerid);
					actor_player_3D[playerid] = CreateDynamic3DTextLabel( str_nick, 0xffffffff, Conta[playerid][c_X], Conta[playerid][c_Y], Conta[playerid][c_Z]+1.15, 15, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, Conta[playerid][c_Mundo], Conta[playerid][c_Interior], -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
					SetPlayerInterior(playerid, 10);
					SetPlayerVirtualWorld_(playerid, 5);
					SetarVida(playerid, 100);
					SetarColete(playerid, 100);
					ResetPlayerWeapons_(playerid);
					GivePlayerWeapon_(playerid, 24, 9999);
					SetPlayerArmedWeapon(playerid, 24);
					SetPlayerPos_(playerid, pos_arena[rand][0]+0.1, pos_arena[rand][1]+0.1, pos_arena[rand][2]+0.1);
					ms(playerid, 1, "Voce entrou na arena, use /arena se quiser  sair !");
					player_arena[playerid] = 1;
				}
			}
		}
	}
}

stock dialog_celular(playerid, IDL, response, listitem, numero=0, max_num=0)
{
	new c = id[playerid];
	if(c != -1)
	{

	    // LISTA DE MULTAS APK //
		if(IDL == FINALIZAR_MULTA)
		{
		    new v = GetPVarInt(playerid, "info");
		    new a = GetPVarInt(playerid, "multa");
		    new cc = Veiculo[v][v_Dono];
		    if(response == 1)
		    {
		        if(listitem == 0)
		        {
					// finalizar //
					new multou = Multar(cc, tipo_multa[a][tm_Valor], id[playerid], -1, tipo_multa[a][tm_Nome], -1, v);
					new sss[300];
					if(multou == 2)
					{
					    format(str_aviso[playerid], 300, "~r~~h~MULTA NAO APLICADA~n~~n~~w~Este veiculo atingiu o Limite de multas possiveis, recomendamos que seja apreendido o mais rapido possivel !");
		    			SetPVarInt(playerid, "aviso", C_LISTA);
		    			celular(playerid, C_ERRO);
		    			format(sss, 300, "[DETRAN] Seu veiculo de Placa: %s, esta com excesso de multas, procure o Detran imediatamente.", PlacaVeiculo[v]);
						msc(cc, 2, sss);
		    			return 1;
					}
					format(sss, 300, "Voce multou o veiculo de Placa: %s, valor da Multa: R$ %s.", PlacaVeiculo[v], ConvertMoney(tipo_multa[a][tm_Valor]));
					ms(playerid, 0x00ffffff, sss);
					format(sss, 300, "Motivo: %s.", tipo_multa[a][tm_Nome]);
					ms(playerid, 0x00ffffff, sss);
					format(str_aviso[playerid], 300, "\
					~g~~h~MULTA APLICADA~n~~n~\
					~y~~h~Placa: ~b~~h~%s~n~\
					~y~~h~Valor: ~g~~h~R$ %s~n~\
					~y~~h~Motivo: ~w~%s~n~~n~\
					~p~~h~Detran Estadual~n~\
					Multa Online", PlacaVeiculo[v], ConvertMoney(tipo_multa[a][tm_Valor]), tipo_multa[a][tm_Nome]);
		    		SetPVarInt(playerid, "aviso", C_DETRAN);
		    		celular(playerid, C_INFO);
		            return 1;
		        }

		        if(listitem == 1)
		        {
                    // vizualizar //
                    format(str_aviso[playerid], 300, "\
					~p~~h~APLICANDO MULTA~n~~n~\
					~y~~h~Policial: ~w~%s~n~\
					~y~~h~Placa: ~b~~h~%s~n~\
					~y~~h~Valor: ~g~~h~R$ %s~n~\
					~y~~h~Motivo: ~w~%s~n~~n~\
					~p~~h~Detran Estadual~n~\
					Multa Online", Nome(playerid), PlacaVeiculo[v], ConvertMoney(tipo_multa[a][tm_Valor]), tipo_multa[a][tm_Nome]);
		    		SetPVarInt(playerid, "aviso", C_LISTA);
		    		celular(playerid, C_INFO);
		            return 1;
		        }

		        if(listitem == 2)
		        {
                    // alterar motivo //
                    mostrar_lista_multas(playerid, v);
		            return 1;
		        }

		        if(listitem == 3)
		        {
                    // cancelar //
					celular(playerid, C_DETRAN);
		            return 1;
		        }

		        return 1;
		    }
		    multar_apk(playerid, v);
		    return 1;
		}

		// LISTA DE MULTAS APK //
		if(IDL == LISTA_MULTAS)
		{
		    if(response == 1)
		    {
		        finalizar_multa(playerid, listitem);
		        return 1;
		    }
		    multar_apk(playerid);
		    return 1;
		}

	    // MULTAR PELA PLACA //
		if(IDL == MULTAR_PLACA)
		{
		    if(response == 1)
		    {
		        if(max_num != 4)
		        {
		            format(str_aviso[playerid], 300, "Digite corretamente os 4 numeros do final da placa do veiculo !");
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        new placa_numero[10];
		        format(placa_numero, 10, "%04d", numero);
		        new veiculo_encontrado = -1;
		        foreach(new a:Iter_Veiculos)
		        {
		            if(Veiculo[a][v_Existe] == 1 && Veiculo[a][v_Emplacar] == 0)
		            {
		                if(strfind(PlacaVeiculo[a], placa_numero) != -1)
		                {
		                    veiculo_encontrado = a;
		                    break;
		                }
		            }
		        }

		        if(veiculo_encontrado == -1)
		        {
		            format(str_aviso[playerid], 300, "Esta placa nao esta cadastrada no banco de dados, veiculo nao encontrado, verifique o campo digitado mais uma vez !");
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        if(Veiculo[veiculo_encontrado][v_Dono] == -1)
		        {
		            format(str_aviso[playerid], 300, "Este veiculo nao possue um Dono, so e possivel aplicar multas em veiculos pessoais !");
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

	            multar_apk(playerid, veiculo_encontrado);
		    }
			else celular(playerid, C_DETRAN);
		    return 1;
		}

		// CNSULTAR PLACA //
		if(IDL == CONSULTAR_PLACA)
		{
		    if(response == 1)
		    {
		        if(max_num != 4)
		        {
		            format(str_aviso[playerid], 300, "Digite corretamente os 4 numeros do final da placa do veiculo !");
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        new placa_numero[10];
		        format(placa_numero, 10, "%04d", numero);
		        new veiculo_encontrado = -1;
		        foreach(new a:Iter_Veiculos)
		        {
		            if(Veiculo[a][v_Existe] == 1 && Veiculo[a][v_Emplacar] == 0)
		            {
		                if(strfind(PlacaVeiculo[a], placa_numero) != -1)
		                {
		                    veiculo_encontrado = a;
		                    break;
		                }
		            }
		        }

		        if(veiculo_encontrado == -1)
		        {
		            format(str_aviso[playerid], 300, "Esta placa nao esta cadastrada no banco de dados, veiculo nao encontrado, verifique sua pesquisa !");
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        if(Veiculo[veiculo_encontrado][v_Dono] == -1)
		        {
		            format(str_aviso[playerid], 300, "Este veiculo nao possue um Dono, so e possivel ver informacoes de veiculos pessoais !");
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

	            consultar_placa_apk(playerid, veiculo_encontrado);
		    }
		    else celular(playerid, C_DETRAN);
		    return 1;
		}

        // CAIXA LOTERICA - MULTAS //
		if(IDL == CAIXA_LOTERICA_MULTAS)
		{
		    if(response == 1)
		    {
                if(listitem == -1) return 1;
                new a = Lista_DC[playerid][listitem][cel_ID];
                new v = Lista_DC[playerid][listitem][cel_Unidades];
                if(Lista_DC[playerid][listitem][cel_Tipo] == 0 && Multas[playerid][a][mu_Existe] == 1)
                {
                    if(Conta[playerid][c_Banco] < Multas[playerid][a][mu_Valor])
					{
					    format(str_aviso[playerid], 300,  "Voce nao tem R$ %s para pagar esta Multa ! Va ate um caixa eletronico ou ao Banco da Cidade para efetuar um Deposito.", ConvertMoney(Multas[playerid][a][mu_Valor]));
					    SetPVarInt(playerid, "aviso", C_LISTA);
		    			celular(playerid, C_ERRO);
		                return 1;
					}
					format(str_aviso[playerid], 300, "Voce pagou uma multa pessoal no valor de R$ %s.", ConvertMoney(Multas[playerid][a][mu_Valor]));
                    DarBanco(playerid, -Multas[playerid][a][mu_Valor]);
					Multas[playerid][a][mu_Existe] = 0;
					Multas[playerid][a][mu_Valor] = 0;
					Multas[playerid][a][mu_Conta] = -1;
					Multas[playerid][a][mu_Radar] = -1;
					format(Multas[playerid][a][mu_Motivo], 100, "_");
					format(Multas[playerid][a][mu_Data], 50, "_");
					salvar_multas(c);
					resposta_apk_caixa(playerid, 2);
					SetPVarInt(playerid, "aviso", C_LISTA);
    				celular(playerid, C_INFO);
					return 1;
				}
				if(Lista_DC[playerid][listitem][cel_Tipo] == 1 && v != -1 && Veiculo_Multa[v][a][mu_Existe] == 1)
				{
				    if(Conta[playerid][c_Banco] < Veiculo_Multa[v][a][mu_Valor])
					{
					    format(str_aviso[playerid], 300,  "Voce nao tem R$ %s para pagar esta Multa ! Va ate um caixa eletronico ou ao Banco da Cidade para efetuar um Deposito.", ConvertMoney(Veiculo_Multa[v][a][mu_Valor]));
					    SetPVarInt(playerid, "aviso", C_LISTA);
		    			celular(playerid, C_ERRO);
		                return 1;
					}
					format(str_aviso[playerid], 300, "Voce pagou uma multa de veiculo no valor de R$ %s.", ConvertMoney(Veiculo_Multa[v][a][mu_Valor]));
                    DarBanco(playerid, -Veiculo_Multa[v][a][mu_Valor]);
					Veiculo_Multa[v][a][mu_Existe] = 0;
					Veiculo_Multa[v][a][mu_Valor] = 0;
					Veiculo_Multa[v][a][mu_Conta] = -1;
					Veiculo_Multa[v][a][mu_Radar] = -1;
					format(Veiculo_Multa[v][a][mu_Motivo], 100, "Nenhum");
					format(Veiculo_Multa[v][a][mu_Data], 50, "Nada");
					SalvarInfo(v, 51);
					resposta_apk_caixa(playerid, 2);
					SetPVarInt(playerid, "aviso", C_LISTA);
    				celular(playerid, C_INFO);
					return 1;
				}
		        resposta_apk_caixa(playerid, 2);
		        return 1;
		    }
		    celular(playerid, C_CAIXA);
		    return 1;
		}


        // CAIXA LOTERICA - APOSTA //
		if(IDL == CAIXA_LOTERICA_APOSTA)
		{
		    if(response == 1)
		    {

		        // comprar bilhete //
				if(listitem == 0)
				{
				    new bb = bilhete_player(playerid);
                    if(bb != -1)
				{
				    format(str_aviso[playerid], 300, "Voce ja possui um bilhete para o proximo sorteio ! Numero: %05d.", bilhetes[bb][1]);
	    				SetPVarInt(playerid, "aviso", C_LISTA);
	    				celular(playerid, C_ERRO);
				    return 1;
		        	}
		        	if(Conta[playerid][c_Banco] < BILHETE)
				{
				    format(str_aviso[playerid], 300, "Voce nao tem R$ %s na sua Conta Bancaria para comprar um Bilhete ! Va ate um caixa eletronico ou ao Banco da Cidade para efetuar um Deposito.", ConvertMoney(BILHETE));
				    SetPVarInt(playerid, "aviso", C_LISTA);
	    				celular(playerid, C_ERRO);
		                return 1;
				}
				new b = comprar_bilhete();
				if(b == -1)
				{
						format(str_aviso[playerid], 300, "Os Bilhetes desse sorteio se esgotaram ! Tente Na Prtoxima vez.");
						SetPVarInt(playerid, "aviso", C_LISTA);
	    				celular(playerid, C_ERRO);
		                return 1;
				}

				new num = random(100000);
				Conta[playerid][c_Loteria] = payday_server;
				salvar_conta(c, 0, "c_Loteria", sv_int(payday_server));
				bilhetes[b][0] = c;
					bilhetes[b][1] = num;
				new sorteio[50];
				if(HORA == 23) format(sorteio, 50, "00:00");
				else format(sorteio, 50, "%02d:00", HORA+1);
				premio_loteria += BILHETE;
					format(str_aviso[playerid], 300, "~p~BILHETE COMPRADO~n~~n~~w~Voce pagou R$ %s em um bilhete da Loteria! Numero: ~g~~h~%05d~w~, O sorteio do premio de R$ %s sera as %s.", ConvertMoney(BILHETE), num, ConvertMoney(premio_loteria), sorteio);
					DarBanco(playerid, -BILHETE);
				salvar_definicoes("Loteria");
		            SetPVarInt(playerid, "aviso", C_LISTA);
	    			celular(playerid, C_INFO);
				    return 1;
				}

				// ver premio //
				if(listitem == 1)
				{
				    new sorteio[50];
				if(HORA == 23) format(sorteio, 50, "00:00");
				else format(sorteio, 50, "%02d:00", HORA+1);
					format(str_aviso[playerid], 300, "~p~PREMIO ACUMULADO~n~~n~~w~O sorteio do premio de R$ %s sera as %s.", ConvertMoney(premio_loteria), sorteio);
                    SetPVarInt(playerid, "aviso", C_LISTA);
	    			celular(playerid, C_INFO);
				    return 1;
				}

				// ver bilhete do player //
				if(listitem == 2)
				{
				    new b = bilhete_player(playerid);
				    if(b == -1)
				{
				    format(str_aviso[playerid], 300, "Voce nao tem um bilhete para o proximo sorteio ! Compre um por apenas R$ %s antes do sorteio comecar.", ConvertMoney(BILHETE));
	    				SetPVarInt(playerid, "aviso", C_LISTA);
	    				celular(playerid, C_ERRO);
				    return 1;
		        	}
		        	new num = bilhetes[b][1];
		        	new sorteio[50];
				if(HORA == 23) format(sorteio, 50, "00:00");
				else format(sorteio, 50, "%02d:00", HORA+1);
                    format(str_aviso[playerid], 300, "~p~SEU BILHETE~n~~n~~w~Voce esta concorrendo ao sorteio do premio de ~g~~h~R$ %s ~w~que sera as ~y~~h~%s~w~.~n~~w~Numero do Bilhete: ~b~~h~%05d.", ConvertMoney(premio_loteria), sorteio, num);
                    SetPVarInt(playerid, "aviso", C_LISTA);
	    			celular(playerid, C_INFO);
				    return 1;
				}

		        return 1;
		    }
		    celular(playerid, C_CAIXA);
		    return 1;
		}

		// CAIXA LOTERICA - IPTU //
		if(IDL == CAIXA_LOTERICA_IPTU)
		{
		    if(response == 1)
		    {
		        if(listitem == -1) return 1;
		        new a = Lista_DC[playerid][listitem][cel_ID];
		        if(Casa[a][casa_Existe] == 1)
		        {
		            if(Casa[a][casa_Contas] == 0)
		            {
				    format(str_aviso[playerid], 300, "O IPTU d%s %s ja foi pago recentemente !", (Casa[a][casa_Tipo] == 0)? "a":"o", tipo_casa(a));
	    				SetPVarInt(playerid, "aviso", C_LISTA);
	    				celular(playerid, C_ERRO);
	    				return 1;
		            }

		            if(Conta[playerid][c_Banco] < Casa[a][casa_Contas])
		            {
				    format(str_aviso[playerid], 300, "Voce nao tem R$ %s na sua Conta Bancaria para pagar o IPTU ! Va ate um caixa eletronico ou ao Banco da Cidade para efetuar um Deposito.", ConvertMoney(Casa[a][casa_Contas]));
	    				SetPVarInt(playerid, "aviso", C_LISTA);
	    				celular(playerid, C_ERRO);
	    				return 1;
		            }

				DarBanco(playerid, -Casa[a][casa_Contas]);
				add_cp(Casa[a][casa_Contas]);
				format(str_aviso[playerid], 300, "Voce pagou R$ %s de IPTU d%s %s ID: %d.", ConvertMoney(Casa[a][casa_Contas]), (Casa[a][casa_Tipo] == 0)? "a":"o", tipo_casa(a), a);
				Casa[a][casa_Contas] = 0;
				Casa[a][casa_Data] = 7;
				salvar_casa(a);
				resposta_apk_caixa(playerid, 1);
				SetPVarInt(playerid, "aviso", C_LISTA);
    				celular(playerid, C_INFO);
    				return 1;
		        }
		        resposta_apk_caixa(playerid, 1);
		        return 1;
		    }
		    celular(playerid, C_CAIXA);
		    return 1;
		}

		// CAIXA LOTERICA - IPVA //
		if(IDL == CAIXA_LOTERICA_IPVA)
		{
		    if(response == 1)
		    {
		        if(listitem == -1) return 1;
		        new a = Lista_DC[playerid][listitem][cel_ID];
		        if(Veiculo[a][v_Existe] == 1)
		        {
		            if(Veiculo[a][v_Contas] == 0)
		            {
				    format(str_aviso[playerid], 300, "O IPVA deste veiculo ja foi pago recentemente !");
	    				SetPVarInt(playerid, "aviso", C_LISTA);
	    				celular(playerid, C_ERRO);
	    				return 1;
		            }

		            if(Conta[playerid][c_Banco] < Veiculo[a][v_Contas])
		            {
				    format(str_aviso[playerid], 300, "Voce nao tem R$ %s na sua Conta Bancaria para pagar o IPTU ! Va ate um caixa eletronico ou ao Banco da Cidade para efetuar um Deposito.", ConvertMoney(Veiculo[a][v_Contas]));
	    				SetPVarInt(playerid, "aviso", C_LISTA);
	    				celular(playerid, C_ERRO);
	    				return 1;
		            }

				DarBanco(playerid, -Veiculo[a][v_Contas]);
				add_cp(Veiculo[a][v_Contas]);
				format(str_aviso[playerid], 300, "Voce pagou R$ %s de IPVA do veiculo '%s' info: %d - Placa: %s.", ConvertMoney(Veiculo[a][v_Contas]), NomeVeiculo(Veiculo[a][v_Modelo]), a, PlacaVeiculo[a]);
				Veiculo[a][v_Contas] = 0;
				Veiculo[a][v_IPVA] = 15;
				SalvarInfo(a);
				resposta_apk_caixa(playerid, 0);
				SetPVarInt(playerid, "aviso", C_LISTA);
    				celular(playerid, C_INFO);
	                return 1;
		        }
		        resposta_apk_caixa(playerid, 0);
		        return 1;
		    }
		    celular(playerid, C_CAIXA);
			return 1;
		}

	    // DEPOSICO BLAZE //
		if(IDL == DEPOSITO_BLAZE)
		{
		    if(response == 1)
		    {
		        if(max_num == 0)
		        {
		            format(str_aviso[playerid], 300, "O campo esta Vazio !");
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        if(numero < 1 || numero > 50000)
		        {
		            format(str_aviso[playerid], 300, "Escolha um valor entre 1 e 50.000 !");
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        if(numero > Conta[playerid][c_Banco])
		        {
		            format(str_aviso[playerid], 300, "Voce nao tem R$ %s em sua conta bancaria !", ConvertMoney(numero));
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        DarBanco(playerid, -numero);
		        blaze_player[playerid][bz_Saldo] += numero;
		        salvar_conta(c, 0, "c_Blaze", sv_int(blaze_player[playerid][bz_Saldo]));
                format(str_aviso[playerid], 300, "Voce depositou R$ %s em sua conta da blaze, confira seu saldo no APK !", ConvertMoney(numero));
	    		SetPVarInt(playerid, "aviso", C_BLAZE);
	    		celular(playerid, C_INFO);
		        return 1;
		    }

		    celular(playerid, C_BLAZE);
		    return 1;
		}

		// SAQUE BLAZE //
		if(IDL == SAQUE_BLAZE)
		{
		    if(response == 1)
		    {
		        if(max_num == 0)
		        {
		            format(str_aviso[playerid], 300, "O campo esta Vazio !");
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        if(numero < 1 || numero > 50000)
		        {
		            format(str_aviso[playerid], 300, "Escolha um valor entre 1 e 50.000 !");
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        if(numero > blaze_player[playerid][bz_Saldo])
		        {
		            format(str_aviso[playerid], 300, "Voce nao tem R$ %s em sua conta da Blaze !", ConvertMoney(numero));
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        DarBanco(playerid, numero);
		        blaze_player[playerid][bz_Saldo] -= numero;
		        salvar_conta(c, 0, "c_Blaze", sv_int(blaze_player[playerid][bz_Saldo]));
                format(str_aviso[playerid], 300, "Voce sacou R$ %s de sua conta da blaze, confira seu saldo no APK !", ConvertMoney(numero));
	    		SetPVarInt(playerid, "aviso", C_BLAZE);
	    		celular(playerid, C_INFO);
		        return 1;
		    }

		    celular(playerid, C_BLAZE);
		    return 1;
		}


	    // emergencia //
        if(IDL == SOS)
	    {
	        if(response)
	        {
                if(listitem == -1) return 1;
				new sss[300];
				format(sss, 300, "[SOS] '%s' acionou uma Emergencia: %s. Telefone: (%d).", Nome(playerid), soss[listitem][sos_Nome], player_chip(playerid));
				foreach(new i:Player)
				{
				    if(i != playerid)
					{
					    if(OrgPlayer(i) != -1)
						{
						    if(Org[OrgPlayer(i)][o_Tipo] == soss[listitem][sos_Org][0] || Org[OrgPlayer(i)][o_Tipo] == soss[listitem][sos_Org][1] || Org[OrgPlayer(i)][o_Tipo] == soss[listitem][sos_Org][2] )
							{
							ms(i, 0x00ffffff, sss);
						    }
					    }
				    }
				}
				format(str_aviso[playerid], 300, "~r~( ~y~SOS ~r~)~n~~p~~h~'%s'~n~~n~Sua emergencia foi acionada e informada as autoridades, alguem pode entrar em contato com seu numero, fique atento.", soss[listitem][sos_Nome]);
				SetPVarInt(playerid, "aviso", C_INICIO);
				celular(playerid, C_INFO);
				if(AdminPlayer(playerid) < 1) SetPVarInt(playerid, "sos", gettime()+(3*60));
				return 1;
			}
	        celular(playerid, C_INICIO);
	        return 1;
	    }



	    // DOCUMENTOS PLAYERS //
	    if(IDL == DOCUMENTOS_PLAYERS)
	    {
	        if(response)
	        {
	            if(listitem == -1) return 1;
	            new Float:p[3];
	            new v = Lista_DC[playerid][listitem][cel_ID];
	            if(Online(v))
	            {
	                new i = GetPVarInt(playerid, "opcao");
	        		new inf = GetPVarInt(playerid, "inf");
	                GetPlayerPos(v, p[0], p[1], p[2]);
					if(IsPlayerInRangeOfPoint(playerid, 10, p[0], p[1], p[2]))
					{
					    if(GetPlayerInterior(v) == GetPlayerInterior(playerid) && GetPlayerVirtualWorld_(v) == GetPlayerVirtualWorld_(playerid))
						{
                            if(i == 0) mostrar_rg(v, id[playerid]);
							if(i == 1) mostrar_cpf(v, id[playerid]);
							if(i == 2) mostrar_habilitacao(v, id[playerid]);
							if(i == 3) mostrar_porte(v, id[playerid]);
							if(i == 4) mostrar_documento_veiculo(v, inf);
							if(i == 5) mostrar_documento_casa(v, inf);
                            format(str_aviso[playerid], 300, "Voce mostrou seu documento para '%s' !", Nome(v));
					    	SetPVarInt(playerid, "aviso", C_LISTA);
					    	celular(playerid, C_INFO);
							return 1;
		                }
					}
	            }
	            players_perto_documentos(playerid);
	            format(str_aviso[playerid], 300, "Houve um erro ao tentar mostrar o documento, talvez o player nao esteja tao proximo o sufuciente !");
		    	SetPVarInt(playerid, "aviso", C_LISTA);
		    	celular(playerid, C_ERRO);
	            return 1;
	        }
	        ver_mostrar(playerid, GetPVarInt(playerid, "opcao"));
	        return 1;
	    }

	    // DOCUMENTOS CASAS //
	    if(IDL == DOCUMENTOS_CASAS)
	    {
	        if(response)
	        {
                if(listitem == -1) return 1;
				new i = Lista_DC[playerid][listitem][cel_ID];
				SetPVarInt(playerid, "opcao", 5);
				SetPVarInt(playerid, "inf", i);
				ver_mostrar(playerid, 5);
	            return 1;
	        }

	        carteira_player(playerid);
	        return 1;
		}

		// DOCUMENTOS VEICULOS //
	    if(IDL == DOCUMENTOS_VEICULOS)
	    {
	        if(response)
	        {
	            if(listitem == -1) return 1;
				new i = Lista_DC[playerid][listitem][cel_ID];
				SetPVarInt(playerid, "opcao", 4);
				SetPVarInt(playerid, "inf", i);
				ver_mostrar(playerid, 4);
	            return 1;
	        }

	        carteira_player(playerid);
	        return 1;
		}

	    // opcao DOCUMENTOS //
	    if(IDL == DOCUMENTOS_OPCAO)
	    {
	        new i = GetPVarInt(playerid, "opcao");
	        new inf = GetPVarInt(playerid, "inf");
	        if(response)
	        {
	            // ver //
	            if(listitem == 0)
	            {
					if(i == 0) mostrar_rg(playerid, id[playerid]);
					if(i == 1) mostrar_cpf(playerid, id[playerid]);
					if(i == 2) mostrar_habilitacao(playerid, id[playerid]);
					if(i == 3) mostrar_porte(playerid, id[playerid]);
					if(i == 4) mostrar_documento_veiculo(playerid, inf);
					if(i == 5) mostrar_documento_casa(playerid, inf);
					return 1;
	            }

	            // mostrar //
	            if(listitem == 1)
	            {
					players_perto_documentos(playerid);
	            }
	            return 1;
	        }
	        carteira_player(playerid);
	        return 1;
	    }

	    // DOCUMENTOS //
	    if(IDL == DOCUMENTOS)
	    {
	        if(response)
	        {
	            // rg //
	            if(listitem == 0)
	            {
	                if(PlayerRG(playerid) == 0)
		            {
		                format(str_aviso[playerid], 300, "Voce nao tem o documento RG !");
				    	SetPVarInt(playerid, "aviso", C_LISTA);
				    	celular(playerid, C_ERRO);
		                return 1;
		            }
	                SetPVarInt(playerid, "opcao", listitem);
	                ver_mostrar(playerid, listitem);
	                return 1;
	            }

	            // cpf //
	            if(listitem == 1)
	            {
	                if(PlayerRG(playerid) == 0)
		            {
		                format(str_aviso[playerid], 300, "Voce nao tem o documento CPF !");
				    	SetPVarInt(playerid, "aviso", C_LISTA);
				    	celular(playerid, C_ERRO);
		                return 1;
		            }
	                SetPVarInt(playerid, "opcao", listitem);
	                ver_mostrar(playerid, listitem);
	                return 1;
	            }

	            // habilitacao //
	            if(listitem == 2)
	            {
	                if(!TemHabilitacao(playerid))
		            {
		                format(str_aviso[playerid], 300, "Voce nao tem uma Habilitacao !");
				    	SetPVarInt(playerid, "aviso", C_LISTA);
				    	celular(playerid, C_ERRO);
		                return 1;
		            }
	                SetPVarInt(playerid, "opcao", listitem);
	                ver_mostrar(playerid, listitem);
	                return 1;
	            }

	            // porte de armas //
	            if(listitem == 3)
	            {
	                if(!TemPorte(playerid))
		            {
		                format(str_aviso[playerid], 300, "Voce nao tem um Porte de Armas !");
				    	SetPVarInt(playerid, "aviso", C_LISTA);
				    	celular(playerid, C_ERRO);
		                return 1;
		            }
	                SetPVarInt(playerid, "opcao", listitem);
	                ver_mostrar(playerid, listitem);
	                return 1;
	            }

	            // veiculos
	            if(listitem == 4)
	            {
                    if(!TemVeiculo(playerid))
		            {
		                format(str_aviso[playerid], 300, "Voce nao tem um veiculo pessoal !");
				    	SetPVarInt(playerid, "aviso", C_LISTA);
				    	celular(playerid, C_ERRO);
                  		return 1;
		            }
					mostrar_documentos_veiculos(playerid);
					return 1;
	            }

	            // casas //
	            if(listitem == 5)
	            {
                    if(!TemCasa(playerid))
		            {
		                format(str_aviso[playerid], 300, "Voce nao tem uma Casa ou Apartamento !");
				    	SetPVarInt(playerid, "aviso", C_LISTA);
				    	celular(playerid, C_ERRO);
		                return 1;
		            }
		          	mostrar_documentos_casas(playerid);
                    return 1;
	            }
	            return 1;
	        }

	        celular(playerid, C_INICIO);
	        return 1;
	    }

	    // blutuf dispositivos //
		if(IDL == DISPOSITIVOS_PROXIMOS)
		{
	        if(response)
		    {
		        if(listitem == -1)
		        {
		            format(str_aviso[playerid], 300, "Nenhuma JBL ou veiculo com o bluetooth ligado !");
	    			SetPVarInt(playerid, "aviso", C_LISTA);
	    			celular(playerid, C_ERRO);
	    			return 1;
		        }

				new tipo = Lista2[playerid][listitem];
				new idd = Lista[playerid][listitem];

		        // veiculo //
		        if(tipo == 0)
		        {
                    if(conectar_veiculo(idd, playerid))
					{
						format(str_aviso[playerid], 300, "Conectado no Veiculo com sucesso !");
	    				SetPVarInt(playerid, "aviso", C_RADIO);
	    				celular(playerid, C_INFO);
					}
					else
					{
					    format(str_aviso[playerid], 300, "Este Veiculo ja conectou com outro dispositivo, ou nao esta mais com o bluetooth ligado !");
	    				SetPVarInt(playerid, "aviso", C_LISTA);
	    				celular(playerid, C_ERRO);
					}
		        }

		        // jbl //
		        if(tipo == 1)
		        {
					if(conectar_jbl(idd, playerid))
					{
                        format(str_aviso[playerid], 300, "Conectado na JBL com sucesso !");
	    				SetPVarInt(playerid, "aviso", C_RADIO);
	    				celular(playerid, C_INFO);
					}
					else
					{
					    format(str_aviso[playerid], 300, "Esta JBL ja conectou com outro dispositivo, ou nao esta mais com o bluetooth ligado !");
	    				SetPVarInt(playerid, "aviso", C_LISTA);
	    				celular(playerid, C_ERRO);
					}
		        }
	            return 1;
	        }
	        celular(playerid, C_BLU_APK);
	    	return 1;
	    }

		// categorias OLX //
		if(IDL == OLX_ANUNCIOS_CATEGORIAS)
		{
		    if(response)
		    {
		        if(listitem != -1) ver_anuncios(playerid, listitem);
		        return 1;
		    }
		    celular(playerid, C_OLX);
		    return 1;
		}

		// OLX TERMINAR anuncio //
		if(IDL == OLX_CRIAR_TERMINAR)
		{
		    if(response)
		    {
		        // menssagem //
		        if(listitem == 0)
		        {
		            digitar_menssagem(playerid);
		            return 1;
		        }

		        // vizualizar //
		        if(listitem == 1)
		        {
		            new data_h[50];
		            format(data_h, 50, "%02d/%02d/%02d  %02d:%02d", DIA, MES, ANO, HORA, MINUTO);
		            // anuncio simples //
					if(player_anuncio[playerid][an_Tipo] == 0)
					{
					    format(str_aviso[playerid], 300, "\
					    ~w~~h~%s~n~\
						~y~~h~%s ~w~(%d)~n~\
						~p~~h~%s~n~\
						~n~\
						~w~%s.",  data_h, Nome(playerid), Conta[playerid][c_Chip], player_anuncio[playerid][an_Titulo], player_anuncio[playerid][an_Menssagem]);
					    SetPVarInt(playerid, "aviso", C_LISTA);
		    			celular(playerid, C_INFO);
					}

					// anuncio veiculo //
					if(player_anuncio[playerid][an_Tipo] == 1)
					{
					    format(str_aviso[playerid], 300, "\
					    ~w~~h~%s~n~\
						~y~~h~%s ~w~(%d)~n~\
						~p~~h~Veiculo: ~w~%s~n~\
						~g~R$ %s~n~\
						~n~\
						~w~%s.",  data_h, Nome(playerid), Conta[playerid][c_Chip], NomeVeiculo(player_anuncio[playerid][an_ID]), ConvertMoney(player_anuncio[playerid][an_Valor]), player_anuncio[playerid][an_Menssagem]);
					    SetPVarInt(playerid, "aviso", C_LISTA);
		    			celular(playerid, C_INFO);
					}

					// anuncio casa //
					if(player_anuncio[playerid][an_Tipo] == 2)
					{
					    format(str_aviso[playerid], 300, "\
					    ~w~~h~%s~n~\
						~y~~h~%s ~w~(%d)~n~\
						~p~~h~Casa: ~w~(ID %d)~n~\
						~g~R$ %s~n~\
						~n~\
						~w~%s.",  data_h, Nome(playerid), Conta[playerid][c_Chip], player_anuncio[playerid][an_ID], ConvertMoney(player_anuncio[playerid][an_Valor]), player_anuncio[playerid][an_Menssagem]);
					    SetPVarInt(playerid, "aviso", C_LISTA);
		    			celular(playerid, C_INFO);
					}
		            return 1;
		        }

		        // cancelar //
		        if(listitem == 2)
		        {
		            celular(playerid, C_OLX);
		            return 1;
		        }

		        // postar //
		        if(listitem == 3)
		        {
		            if(Comparar(player_anuncio[playerid][an_Menssagem], "-"))
		            {
		                format(str_aviso[playerid], 300, "Voce ainda nao setou a menssagem !");
		    			SetPVarInt(playerid, "aviso", C_LISTA);
		    			celular(playerid, C_ERRO);
		                return 1;
		            }
					postar_anuncio(playerid);
		            return 1;
		        }

		        return 1;
		    }

		    if(player_anuncio[playerid][an_Tipo] == 0) escolher_servico(playerid);
		    if(player_anuncio[playerid][an_Tipo] == 1) valor_anuncio(playerid);
		    if(player_anuncio[playerid][an_Tipo] == 2) valor_anuncio(playerid);
		    return 1;
		}

		// OLX CRIAR NOVO ANUNCIO VALOR //
		if(IDL == OLX_CRIAR_CASA)
		{
		    if(response)
		    {
		        if(numero < 0 || numero >= MAX_CASAS)
		        {
	            	format(str_aviso[playerid], 300, "Digite um ID de casa valido !");
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        if(Casa[numero][casa_Existe] == 0)
		        {
	            	format(str_aviso[playerid], 300, "Esta casa nao existe !");
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        if(Casa[numero][casa_Dono] != c)
		        {
	            	format(str_aviso[playerid], 300, "Voce nao e dono desta casa !");
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }
		        player_anuncio[playerid][an_ID] = numero;
		        valor_anuncio(playerid);
		        return 1;
		    }

		    return 1;
		}

		// OLX CRIAR NOVO ANUNCIO VALOR //
		if(IDL == OLX_CRIAR_VALOR)
		{
		    if(response)
		    {
		        if(numero <= 0)
		        {
	            	format(str_aviso[playerid], 300, "Digite um valor maior que 0 !");
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }
		        player_anuncio[playerid][an_Valor] = numero;
		        format(player_anuncio[playerid][an_Menssagem], 150, "-");
		        finalizar_anuncio(playerid);
		        return 1;
		    }

		    if(player_anuncio[playerid][an_Tipo] == 1) escolher_veiculo(playerid);
		    if(player_anuncio[playerid][an_Tipo] == 2) escolher_casa(playerid);
		    return 1;
		}


		// OLX CRIAR NOVO ANUNCIO VEICULO //
		if(IDL == OLX_CRIAR_VEICULO)
		{
		    if(response)
		    {
		        if(listitem == -1) return 1;
		        player_anuncio[playerid][an_ID] = 400+listitem;
		        valor_anuncio(playerid);
				return 1;
		    }

		    anunciar(playerid);
		    return 1;
		}

		// OLX CRIAR NOVO ANUNCIO SERVICO //
		if(IDL == OLX_CRIAR_SERVICO)
		{
		    if(response)
		    {
		        if(listitem > -1)
		        {
				format(player_anuncio[playerid][an_Titulo], 30, tipos_anuncios[listitem]);
				format(player_anuncio[playerid][an_Menssagem], 150, "-");
				player_anuncio[playerid][an_ID] = listitem;
				finalizar_anuncio(playerid);
		        }
		        return 1;
		    }
		    anunciar(playerid);
		    return 1;
		}

		// OLX CRIAR NOVO ANUNCIOS //
		if(IDL == OLX_CRIAR_TIPO)
		{
		    if(response)
		    {
		        // anuncio comunicativo //
		        if(listitem == 0)
		        {
		            player_anuncio[playerid][an_Tipo] = 0;
		            escolher_servico(playerid);
		        }

		        // venda de carro //
		        if(listitem == 1)
		        {
		            player_anuncio[playerid][an_Tipo] = 1;
		            escolher_veiculo(playerid);
		        }

		        // venda de casa //
		        if(listitem == 2)
		        {
	                player_anuncio[playerid][an_Tipo] = 2;
	                escolher_casa(playerid);
		        }

				return 1;
		    }

		    celular(playerid, C_OLX);
		    return 1;
		}

		// OLX OPCOES ANUNCIOS //
		if(IDL == OLX_OPCOES)
		{
		    new i = GetPVarInt(playerid, "anuncio");
		    new cc = Anuncios[i][an_Dono];
		    if(response)
		    {
		        // mandar menssagem //
		        if(listitem == 0)
		        {
		            if(cc == c)
		            {
		                format(str_aviso[playerid], 300, "O anuncio e seu, voce nao pode mandar uma menssagem a si mesmo !");
			    		SetPVarInt(playerid, "aviso", C_LISTA);
			    		celular(playerid, C_ERRO);
		                return 1;
		            }

		            new con = tem_converssa(c, cc);
					if(con != -1)
					{
					    abrir_converssa(playerid, con);
					    escrever_menssagem(playerid);
					}
					else
					{
	        			id_converssa[playerid] = -1;
	        			conta_converssa[playerid] = cc;
					    celular(playerid, C_WP_APK);
					    escrever_menssagem(playerid);
					}
		            return 1;
		        }

		        // adicionar contato menssagem //
		        if(listitem == 1)
		        {
		            if(cc == c)
		            {
		                format(str_aviso[playerid], 300, "O anuncio e seu, voce nao pode mandar menssagem para si mesmo !");
			    		SetPVarInt(playerid, "aviso", C_LISTA);
			    		celular(playerid, C_ERRO);
		                return 1;
		            }
		            adicionar_novo_contato(playerid, cc);
		            return 1;
		        }

		        // apagar anuncio //
		        if(listitem == 2)
		        {
		            Anuncios[i][an_Existe] = 0;
		            ver_anuncios(playerid, tipo_an[playerid]);
		            format(str_aviso[playerid], 300, "Voce apagou seu anuncio com sucesso !");
		    		SetPVarInt(playerid, "aviso", C_LISTA);
		    		celular(playerid, C_INFO);
		            return 1;
		        }
		        return 1;
		    }

		    ver_anuncios(playerid, tipo_an[playerid]);
		    return 1;
		}

		// OLX VER ANUNCIOS //
		if(IDL == OLX_ANUNCIOS)
		{
		    if(response)
		    {

		        if(listitem == -1)
		        {
		            ver_anuncios(playerid, tipo_an[playerid]);
		            format(str_aviso[playerid], 300, "Nenhum anuncio encontrado ainda !");
		    		SetPVarInt(playerid, "aviso", C_LISTA);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        new i = Lista_DC[playerid][listitem][cel_ID];
				if(Anuncios[i][an_Existe] == 0)
				{
				    ver_anuncios(playerid, tipo_an[playerid]);
		            format(str_aviso[playerid], 300, "Este anuncio nao existe mais !");
		    		SetPVarInt(playerid, "aviso", C_LISTA);
		    		celular(playerid, C_ERRO);
				    return 1;
				}
				opcoes_anuncio(playerid, i);

				// anuncio simples //
				if(Anuncios[i][an_Tipo] == 0)
				{
				    format(str_aviso[playerid], 300, "\
				    ~w~~h~%s~n~\
					~y~~h~%s ~w~(%d)~n~\
					~p~~h~%s~n~\
					~n~\
					~w~%s.",  Anuncios[i][an_Data], NomeConta(Anuncios[i][an_Dono]), GetContaInt(Anuncios[i][an_Dono], "c_Chip"), Anuncios[i][an_Titulo], Anuncios[i][an_Menssagem]);
				    SetPVarInt(playerid, "aviso", C_LISTA);
	    			celular(playerid, C_INFO);
				}

				// anuncio veiculo //
				if(Anuncios[i][an_Tipo] == 1)
				{
				    format(str_aviso[playerid], 300, "\
				    ~w~~h~%s~n~\
					~y~~h~%s ~w~(%d)~n~\
					~p~~h~Veiculo: ~w~%s~n~\
					~g~R$ %s~n~\
					~n~\
					~w~%s.",  Anuncios[i][an_Data], NomeConta(Anuncios[i][an_Dono]), GetContaInt(Anuncios[i][an_Dono], "c_Chip"), NomeVeiculo(Anuncios[i][an_ID]), ConvertMoney(Anuncios[i][an_Valor]), Anuncios[i][an_Menssagem]);
				    SetPVarInt(playerid, "aviso", C_LISTA);
	    			celular(playerid, C_INFO);
				}

				// anuncio casa //
				if(Anuncios[i][an_Tipo] == 2)
				{
				    format(str_aviso[playerid], 300, "\
				    ~w~~h~%s~n~\
					~y~~h~%s ~w~(%d)~n~\
					~p~~h~Casa: ~w~(ID %d)~n~\
					~g~R$ %s~n~\
					~n~\
					~w~%s.",  Anuncios[i][an_Data], NomeConta(Anuncios[i][an_Dono]), GetContaInt(Anuncios[i][an_Dono], "c_Chip"), Anuncios[i][an_ID], ConvertMoney(Anuncios[i][an_Valor]), Anuncios[i][an_Menssagem]);
				    SetPVarInt(playerid, "aviso", C_LISTA);
	    			celular(playerid, C_INFO);
				}

		        return 1;
		    }

		    ver_anuncios(playerid);
			return 1;
		}

		// WHATSAPP novo CONTATOS //
		if(IDL == WHATSAPP_NOVO_CONTATO)
		{
		    if(response)
		    {
		        // adicionar //
		        if(listitem == 0)
		        {
		            adicionar_novo_contato(playerid, conta_converssa[playerid]);
		        }

		        // localizacao //
		        if(listitem == 1)
		        {
	                loc_player(playerid, conta_converssa[playerid]);
		        }

		        // informacoes //
		        if(listitem == 2)
		        {
					format(str_aviso[playerid], 300, "~n~Nome: %s~n~Numero: %d~n~", NomeConta(conta_converssa[playerid]), GetContaInt(conta_converssa[playerid], "c_Chip"));
		    		SetPVarInt(playerid, "aviso", C_LISTA);
		    		celular(playerid, C_INFO);
		        }

		        // ligar //
		        if(listitem == 3)
		        {
		            ligar_para_contato(playerid, conta_converssa[playerid]);
		        }
		        return 1;
		    }
		    celular(playerid, C_WP);
		    return 1;
		}

		// WHATSAPP opcoes CONTATOS //
		if(IDL == WHATSAPP_OPCOES_CONTATO)
		{
		    if(response)
		    {
		        new i = GetPVarInt(playerid, "id_contato");

		        // mandar menssagem //
		        if(listitem == -1) return 1;
				if(listitem == 0)
				{
				    new con = tem_converssa(c, Contatos[playerid][i]);
					if(con != -1)
					{
					    abrir_converssa(playerid, con);
					    escrever_menssagem(playerid);
					}
					else
					{
					    id_converssa[playerid] = -1;
	        			conta_converssa[playerid] = Contatos[playerid][i];
					    celular(playerid, C_WP_APK);
					    escrever_menssagem(playerid);
					}
				}

				// ligar //
				if(listitem == 1)
				{
	                ligar_para_contato(playerid, Contatos[playerid][i]);
				}

				// licalizacao //
				if(listitem == 2)
				{
	                loc_player(playerid, Contatos[playerid][i]);
				}

				// informacoes //
				if(listitem == 3)
				{
	                format(str_aviso[playerid], 300, "~n~Nome: %s~n~Numero: %d~n~", NomeConta(Contatos[playerid][i]), GetContaInt(Contatos[playerid][i], "c_Chip"));
		    		SetPVarInt(playerid, "aviso", C_LISTA);
		    		celular(playerid, C_INFO);
				}

				// apagar //
				if(listitem == 4) apagar_contato(playerid);
		        return 1;
		    }

		    contatos_whatsapp(playerid);
		    return 1;
		}

		// WHATSAPP adicionar CONTATOS //
		if(IDL == WHATSAPP_ADICIONAR_CONTATO)
		{
		    if(response)
		    {
		        new cont = chip_conta(numero);
	            if(cont == -1)
		        {
		            format(str_aviso[playerid], 300, "Esse numero nao esta cadastrado !");
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        if(ContaInvalida(cont))
		        {
		            format(str_aviso[playerid], 300, "Esse numero nao esta cadastrado !");
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        if(cont == c)
		        {
		            format(str_aviso[playerid], 300, "Este e seu numero, voce nao pode adiciona-lo !");
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        if(tem_contato(playerid, cont))
		        {
		            format(str_aviso[playerid], 300, "Voce ja tem este contato adicionado !");
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        adicionar_novo_contato(playerid, cont);
		        return 1;
		    }

		    contatos_whatsapp(playerid);
		    return 1;
		}

		// WHATSAPP APAGAR CONTATOS //
		if(IDL == WHATSAPP_APAGAR_CONTATO)
		{
		    new con = GetPVarInt(playerid, "id_contato");
		    if(response)
		    {
				// APAGAR //
				if(listitem == -1) return 1;
				if(listitem == 0)
				{
				    new contf = Contatos[playerid][con];
				    new idcon = tem_converssa(c, contf);
				    if(idcon != -1)
					{
					apagar_converssa(idcon);
				    }
					Contatos[playerid][con] = -1;
					salvar_whatsapp(playerid, c);
					contatos_whatsapp(playerid);
					format(str_aviso[playerid], 300, "Contato apagado com sucesso !");
		    		SetPVarInt(playerid, "aviso", C_LISTA);
		    		celular(playerid, C_ERRO);
				}

				// CANCELAR //
				if(listitem == 1)
				{
				    opcoes_contato(playerid, con);
				}
		        return 1;
		    }
		    opcoes_contato(playerid, con);
		    return 1;
		}

		// WHATSAPP CONTATOS //
		if(IDL == WHATSAPP_CONTATOS)
		{
		    if(response)
		    {
		        if(listitem == -1) return 1;
		        if(listitem == 0)
		        {
					for(new d; d<MAX_CONTATOS; d++)
		            {
		                if(Contatos[playerid][d] == -1)
		                {
		                    adicionar_contato(playerid);
		                    return 1;
		                }
		            }

		            format(str_aviso[playerid], 300, "Lista de contatos Lotada !");
		    		SetPVarInt(playerid, "aviso", C_LISTA);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }


		        // id do contato do player //
		    	new i = Lista_DC[playerid][listitem][cel_ID];
		    	if(i > -1) opcoes_contato(playerid, i);
		        return 1;
		    }
		    abrir_whatsapp(playerid);
		    return 1;
		}

		// WHATSAPP CHAMADAS //
		if(IDL == WHATSAPP_CHAMADAS)
		{
		    if(response)
		    {
		        if(listitem == -1)
		        {
		            format(str_aviso[playerid], 300, "Nenhuma chamada registrada no momento, ligue para algum contato e tente novamente !");
		    		SetPVarInt(playerid, "aviso", C_LISTA);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        // id da chamada do player //
		    	new i = Lista_DC[playerid][listitem][cel_ID];
		        abrir_chamada(playerid, i);
		        return 1;
		    }
		    abrir_whatsapp(playerid);
		    return 1;
		}


		// WHATSAPP CONVERSSAS //
		if(IDL == WHATSAPP_CONVERSSAS)
		{
		    if(response)
		    {
	            if(listitem == -1)
		        {
		            format(str_aviso[playerid], 300, "Nenhuma converssa no momento, inicie uma converssa com algum contato e tente novamente !");
		    		SetPVarInt(playerid, "aviso", C_LISTA);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        // id da converssa do player //
		    	new i = Lista_DC[playerid][listitem][cel_ID];
		        if(!abrir_converssa(playerid, i))
		        {
		            abrir_whatsapp(playerid);
		            format(str_aviso[playerid], 300, "Esta converssa foi apagada, ou esta temporariamente indisponivel !");
		    		SetPVarInt(playerid, "aviso", C_LISTA);
		    		celular(playerid, C_ERRO);
		        }
		        return 1;
		    }
		    abrir_whatsapp(playerid);
		    return 1;
		}

		// WHATSAPP INICIO //
		if(IDL == WHATSAPP_INICIO)
		{
		    if(response)
		    {
		        if(listitem == 0)
				{
				    if(VipPlayer(playerid) <= 0)
					{
					format(str_aviso[playerid], 300, "~w~Apenas jogadores VIP ou SOCIO podem usar essa Converssa, seja um colaborador, use /loja e confira os valores dos beneficios !");
			    		SetPVarInt(playerid, "aviso", C_LISTA);
			    		celular(playerid, C_ERRO);
				    }
					else grupo_vip_wp(playerid);
				}
		        if(listitem == 1) converssas_whatsapp(playerid);
		        if(listitem == 2) chamadas_whatsapp(playerid);
		        if(listitem == 3) contatos_whatsapp(playerid);
		        if(listitem == 4)
		        {
		            format(str_aviso[playerid], 300, "~w~Seu numero: ~y~%d ~w~!", player_chip(playerid));
		    		SetPVarInt(playerid, "aviso", C_LISTA);
		    		celular(playerid, C_INFO);
		        }
		        return 1;
		    }
		    celular(playerid, C_INICIO);
		    return 1;
		}


		// escolher casa uber //
		if(IDL == UBER_CASA)
		{
		    if(response == 1)
		    {
		        if(numero < 0 || numero >= MAX_CASAS)
		        {
		            format(str_aviso[playerid], 300, "ID de Casa Invalido, tente novamente !");
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        if(Casa[numero][casa_Existe] == 0)
		        {
		            format(str_aviso[playerid], 300, "Esta Casa nao existe !");
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		       	new i = numero;
		        SetPVarInt(playerid, "uber_gps", 2);
			    Uber[playerid][uber_Cidade] = cidade_casa(i);
			    Uber[playerid][uber_Destino] = i;
			}

		    celular(playerid, C_UBER_CLIENTE);
		    return 1;
		}

		// escolher casa gps //
		if(IDL == GPS_CASA)
		{
		    if(response == 1)
		    {
		        if(numero < 0 || numero >= MAX_CASAS)
		        {
		            format(str_aviso[playerid], 300, "ID de Casa Invalido, tente novamente !");
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        if(Casa[numero][casa_Existe] == 0)
		        {
		            format(str_aviso[playerid], 300, "Esta Casa nao existe !");
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        new i = numero;
	            SetPVarInt(playerid, "local_gps", 2);
	            GPS[playerid][gps_Cidade] = cidade_casa(i);
		     	GPS[playerid][gps_Destino] = i;
		    }

		    celular(playerid, C_GPS);
		    return 1;
		}

		// aceitar corrida uber //
		if(IDL == ACEITAR_CORRIDA)
		{
		    if(response == 1)
		    {
		        if(listitem == -1)
		        {
		            format(str_aviso[playerid], 300, "Nenhum pedido no momento !");
		    		SetPVarInt(playerid, "aviso", C_LISTA);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		    	new i = Lista_DC[playerid][listitem][cel_ID];
		        if(i == -1)
		        {
		            format(str_aviso[playerid], 300, "Nenhuma viagem encontrada !");
		    		SetPVarInt(playerid, "aviso", C_LISTA);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        if(!Online(i))
		        {
		            format(str_aviso[playerid], 300, "Este cliente nao esta mais online, atualize a lista de pedidos !");
		    		SetPVarInt(playerid, "aviso", C_LISTA);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        if(Uber[i][uber_Status] == 0)
		        {
		            format(str_aviso[playerid], 300, "Este cliente cancelou o pedido de viagem ! Atualize a lista de pedidos !");
		    		SetPVarInt(playerid, "aviso", C_LISTA);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        if(Uber[i][uber_Status] == 2)
		        {
		            format(str_aviso[playerid], 300, "Algum motorista ja aceitou esta viagem ! Atualize a lista de pedidos !");
		    		SetPVarInt(playerid, "aviso", C_LISTA);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        if(!IsPlayerInAnyVehicle(playerid))
		        {
		            format(str_aviso[playerid], 300, "Voce nao esta em um veiculo da empresa Uber !");
		    		SetPVarInt(playerid, "aviso", C_LISTA);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
		        {
		            format(str_aviso[playerid], 300, "Voce precisa ser o motorista do veiculo !");
		    		SetPVarInt(playerid, "aviso", C_LISTA);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        new veic = GetPlayerVehicleID(playerid);
				if(GetVehicleModel(veic) != 0)
				{
					new vv = Info_Veiculo[veic];
				if(vv == -1)
				{
				    format(str_aviso[playerid], 300, "Voce nao esta em um veiculo da empresa Uber !");
			    		SetPVarInt(playerid, "aviso", C_LISTA);
			    		celular(playerid, C_ERRO);
				    return 1;
				}

				if(Veiculo[vv][v_Emprego] != 1)
				{
				    format(str_aviso[playerid], 300, "Voce nao esta em um veiculo da empresa Uber !");
			    		SetPVarInt(playerid, "aviso", C_LISTA);
			    		celular(playerid, C_ERRO);
				    return 1;
				}

				Uber[i][uber_Veiculo] = veic;
				Uber[i][uber_Motorista] = playerid;
				Uber[i][uber_Status] = 2;
				format(str_aviso[playerid], 300, "Voce aceitou a corrida de '%s', dirija ate a marca vermelha do mini mapa, apos o cliente entrar no veiculo, a corrida sera iniciada.", Nome(i));
		    		SetPVarInt(playerid, "aviso", C_UBER_VIAGEM);
		    		celular(playerid, C_INFO);
				Localizar_Player(playerid,Uber[i][uber_X], Uber[i][uber_Y], Uber[i][uber_Z], 555, i, Nome(i));

					if(celular_aberto[i] != -1)
					{
					    format(str_aviso[i], 300, "O motorista '%s' aceitou seu pedido, permaneca no local onde chamou o uber !", Nome(playerid));
			    		SetPVarInt(i, "aviso", C_UBER_CLIENTE);
			    		celular(i, C_INFO);
					}
					else
					{
					    new sss[150];
					    format(sss, 150, "O motorista '%s' aceitou seu pedido, permaneca no local onde chamou o uber !", Nome(playerid));
					    ms(i, 2, sss);
					}
				return 1;
				}
			}


			celular(playerid, C_UBER_MOTORISTA);
			return 1;
		}

		// TERMINAR pix //
		if(IDL == TERMINAR_PIX)
		{
		    if(response == 1)
		    {
		        new cc = GetPVarInt(playerid, "id_pix");
		        if(numero <= 0)
		        {
		            format(str_aviso[playerid], 300, "Digite um valor maior que 0 !");
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
					return 1;
		        }

		        if(numero > Conta[playerid][c_Banco])
		        {
		            format(str_aviso[playerid], 300, "Voce nao tem R$ %s em sua conta bancaria !", ConvertMoney(numero));
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
					return 1;
		        }

		        new sss[300];
		        format(sss, 300, "ITAU - '%s' lhe enviou um PIX no valor de R$ %s.", Nome(playerid), ConvertMoney(numero));
				new player = ContaOnline(cc);
				if(Online(player))
		        {
		            DarBanco(player, numero);
					ms(player, 1, sss);
		        }
		        else
		        {
		            new gran = GetContaInt(cc, "c_Banco");
		            salvar_conta(cc, 0, "c_Banco", sv_int(gran+numero));
		            msc(cc, 1, sss);
		        }

		        DarBanco(playerid, -numero);
		        format(str_aviso[playerid], 300, "~g~~h~PIX REALIZADO~n~~n~~w~Voce enviou um PIX no valor de ~g~R$ %s ~w~para '~y~%s~w~' com sucesso !", ConvertMoney(numero), NomeConta(cc));
	    		SetPVarInt(playerid, "aviso", C_ITAU);
	    		celular(playerid, C_INFO);
		        return 1;
		    }

		    fazer_pix(playerid);
		    return 1;
		}


		// fazer pix //
		if(IDL == FAZER_PIX)
		{
		    if(response == 1)
		    {
		        if(max_num == 0)
		        {
		            format(str_aviso[playerid], 300, "O campo esta Vazio !");
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
		            return 1;
		        }

		        new filee[80];
		        format(filee, 80, "PIX/%d.txt", numero);
		        if(!DOF2_FileExists(filee))
		        {
		            format(str_aviso[playerid], 300, "Chave PIX nao encontrada, ou nao existe !~n~~n~Verifique os numeros digitados e tente novamente.");
		    		SetPVarInt(playerid, "aviso", C_NUMERO);
		    		celular(playerid, C_ERRO);
		    		return 1;
		        }
		        else
		        {
		            if(Conta[playerid][c_Pix] == numero)
					{
					    format(str_aviso[playerid], 300, "Voce nao pode enviar dinheiro pra sua propria chave PIX !~n~~n~Tente novamente.");
			    		SetPVarInt(playerid, "aviso", C_NUMERO);
			    		celular(playerid, C_ERRO);
			    		return 1;
					}

					new fff = DOF2_GetInt(filee, "ID_Conta");
					if(!ContaInvalida(fff))
					{
					    new player = ContaOnline(fff);
					    if(Online(player))
					{
					    if(Conta[player][c_Pix] != 0 && Conta[player][c_Pix] == numero)
							{
								SetPVarInt(playerid, "id_pix", fff);
								terminar_pix(playerid, fff);
								return 1;
					    }
					}
					else
						{
							if(GetContaInt(fff, "c_Pix") == numero)
						{
								SetPVarInt(playerid, "id_pix", fff);
								terminar_pix(playerid, fff);
								return 1;
					    }
						}
					}
		        }
		        return 1;
		    }

		    celular(playerid, C_ITAU);
		    return 1;
		}

		// radio online //
		if(IDL == ESTACOES_RADIO_ONLINE)
		{
		    if(response == 1)
		    {
		        if(listitem < 0)
				{
					format(str_aviso[playerid], 300, "Estacao de radio nao escolhida ainda !");
		    		SetPVarInt(playerid, "aviso", C_LISTA);
		    		celular(playerid, C_ERRO);
		    		return 1;
				}

				if(listitem == 0)
				{
					colocar_link(playerid);
				    return 1;
				}

				listitem --;
		        Ouvindo_Radio[playerid] = listitem;
		        if(Status_Radio[playerid] == 1) play_stop_radio(playerid);
		        celular(playerid, C_RADIO);
		        return 1;
		    }

		    celular(playerid, C_RADIO);
		    return 1;
		}

		// escolher destino GPS //
		if(IDL == GPS_LOCAL)
		{
		    if(response == 1)
		    {
		        if(listitem == -1)
		        {
		            format(str_aviso[playerid], 300, "Destino nao selecionado !");
		    		SetPVarInt(playerid, "aviso", C_LISTA);
		    		celular(playerid, C_ERRO);
		    		return 1;
		        }

		        if(GPS[playerid][gps_Cidade] < 3)
		        {
		        	SetPVarInt(playerid, "local_gps", 0);
				    GPS[playerid][gps_Destino] = listitem;
			    }
			    else
				{
		            // caixas eletronicos //
				new i = Lista_DC[playerid][listitem][cel_ID];
				SetPVarInt(playerid, "local_gps", 1);
				    GPS[playerid][gps_Cidade] = CaixaEletronico[i][ce_Cidade];
			     	GPS[playerid][gps_Destino] = i;
			    }

			    celular(playerid, C_GPS);
		        return 1;
		    }

		    celular(playerid, C_GPS);
		    return 1;
		}

		// escolher destino uber //
		if(IDL == DESTINO_LOCAL)
		{
		    if(response == 1)
		    {
		        if(listitem == -1)
		        {
		            format(str_aviso[playerid], 300, "Destino nao selecionado !");
		    		SetPVarInt(playerid, "aviso", C_LISTA);
		    		celular(playerid, C_ERRO);
		    		return 1;
		        }

		        if(Uber[playerid][uber_Cidade] < 3)
		        {
		        	SetPVarInt(playerid, "uber_gps", 0);
				    Uber[playerid][uber_Destino] = listitem;
			    }
			    else
				{
				new i = Lista_DC[playerid][listitem][cel_ID];
				SetPVarInt(playerid, "uber_gps", 1);
				    Uber[playerid][uber_Cidade] = CaixaEletronico[i][ce_Cidade];
				    Uber[playerid][uber_Destino] = i;
			    }

			    celular(playerid, C_UBER_CLIENTE);
		        return 1;
		    }

		    alterar_destino(playerid);
		    return 1;
		}


		// escolher local uber //
		if(IDL == DESTINO_CIDADE)
		{
		    if(response == 1)
		    {
		        if(listitem == -1)
		        {
		            format(str_aviso[playerid], 300, "Cidade nao selecionada !");
		    		SetPVarInt(playerid, "aviso", C_LISTA);
		    		celular(playerid, C_ERRO);
		    		return 1;
		        }

			    if(IDL == DESTINO_CIDADE)
				{
					Uber[playerid][uber_Cidade] = listitem;
					ID_DC[playerid] = DESTINO_LOCAL;
				}
				else
				{
				    GPS[playerid][gps_Cidade] = listitem;
					ID_DC[playerid] = GPS_LOCAL;
				}

			// Zona Leste //
			if(listitem == 0)
			{
				for(new i; i<sizeof Local_LosSantos; i++)
				{
					format(Lista_DC[playerid][i][cel_Nome], 100, Local_LosSantos[i][local_Nome]);
				format(Titulo_DC[playerid], 100, "ZONA LESTE");
			    }
			    MAX_DC[playerid] = sizeof Local_LosSantos;
			    Item_DC[playerid] = 0;
			    Pagina_DC[playerid] = 0;
			}
			celular(playerid, C_LISTA);

			// Zona Sul //
			if(listitem == 1)
			{
				for(new i; i<sizeof Local_SanFierro; i++)
				{
				    format(Lista_DC[playerid][i][cel_Nome], 100, Local_SanFierro[i][local_Nome]);
				    format(Titulo_DC[playerid], 100, "ZONA SUL");
				    MAX_DC[playerid] = sizeof Local_SanFierro;
				    Item_DC[playerid] = 0;
				    Pagina_DC[playerid] = 0;
				}
				celular(playerid, C_LISTA);
			}

			// Zona Oeste //
			if(listitem == 2)
			{
				for(new i; i<sizeof Local_LasVenturas; i++)
				{
				    format(Lista_DC[playerid][i][cel_Nome], 100, Local_LasVenturas[i][local_Nome]);
				    format(Titulo_DC[playerid], 100, "ZONA OESTE");
					MAX_DC[playerid] = sizeof Local_LasVenturas;
					Item_DC[playerid] = 0;
					Pagina_DC[playerid] = 0;
				}
				celular(playerid, C_LISTA);
			}

				// CAIXAS ELETRONICOS //
			if(listitem == 3)
			{
			    new Float:p[3];
			    GetPlayerPos(playerid, p[0],p[1],p[2]);
			    new cep = -1;
			    new Float:disf1 = 999999999.0;
			    new Float:disf;
			    foreach(new ii:Iter_CaixasEletronicos)
				{
				    if(CaixaEletronico[ii][ce_Existe] == 1)
					{
					if(CaixaEletronico[ii][ce_Quebrado] == 0)
					{
					    GetDistance(disf, p[0],p[1],p[2],  CaixaEletronico[ii][ce_X],  CaixaEletronico[ii][ce_Y], CaixaEletronico[ii][ce_Z]);
						    if(disf < disf1)
							{
							disf1 = disf;
							cep = ii;
						    }
					}
				    }
				}

			    new cont;
			    foreach(new i:Iter_CaixasEletronicos)
				{
				if(CaixaEletronico[i][ce_Existe] == 1)
				{
				    if(CaixaEletronico[i][ce_Quebrado] == 0)
						{
						if(i != cep) format(Lista_DC[playerid][cont][cel_Nome], 100, "~w~Caixa Eletronico (%d)", i);
						else format(Lista_DC[playerid][cont][cel_Nome], 100, "~y~CAIXA MAIS PROXIMO (%d)", i);
					    }

				    if(CaixaEletronico[i][ce_Quebrado] == 1)
						{
						if(i != cep) format(Lista_DC[playerid][cont][cel_Nome], 100, "~r~Caixa Eletronico (%d)", i);
						else format(Lista_DC[playerid][cont][cel_Nome], 100, "~y~CAIXA MAIS PROXIMO (%d)", i);
					    }
				    Lista_DC[playerid][cont][cel_ID] = i;
				    cont++;
				    }
			    }

			    if(cont == 0) Item_DC[playerid] = -1;
			    else Item_DC[playerid] = 0;
			    MAX_DC[playerid] = cont;
			    Pagina_DC[playerid] = 0;
			    format(Titulo_DC[playerid], 100, "CAIXAS ELETRONICOS");
			    celular(playerid, C_LISTA);
			}

			// casas //
			if(listitem == 4)
			{
				escolher_casa_uber(playerid);
			}

		    return 1;
		}

		    celular(playerid, C_UBER_CLIENTE);
		    return 1;
		}

		// escolher local gps //
		if(IDL == GPS_CIDADE)
		{
		    if(response == 1)
		    {
		        if(listitem == -1)
		        {
		            format(str_aviso[playerid], 300, "Cidade nao selecionada !");
		    		SetPVarInt(playerid, "aviso", C_LISTA);
		    		celular(playerid, C_ERRO);
		    		return 1;
		        }

			    if(IDL == DESTINO_CIDADE)
				{
					Uber[playerid][uber_Cidade] = listitem;
					ID_DC[playerid] = DESTINO_LOCAL;
				}
				else
				{
				    GPS[playerid][gps_Cidade] = listitem;
					ID_DC[playerid] = GPS_LOCAL;
				}

				// Zona Leste //
				if(listitem == 0)
				{
					for(new i; i<sizeof Local_LosSantos; i++)
					{
						format(Lista_DC[playerid][i][cel_Nome], 100, Local_LosSantos[i][local_Nome]);
					format(Titulo_DC[playerid], 100, "ZONA LESTE");
					MAX_DC[playerid] = sizeof Local_LosSantos;
					Item_DC[playerid] = -1;
					Pagina_DC[playerid] = 0;
				    }
				    celular(playerid, C_LISTA);
				}

				// Zona Sul //
				if(listitem == 1)
				{
					for(new i; i<sizeof Local_SanFierro; i++)
					{
						format(Lista_DC[playerid][i][cel_Nome], 100, Local_SanFierro[i][local_Nome]);
					format(Titulo_DC[playerid], 100, "ZONA SUL");
					MAX_DC[playerid] = sizeof Local_SanFierro;
					Item_DC[playerid] = -1;
					Pagina_DC[playerid] = 0;
				    }
				    celular(playerid, C_LISTA);
				}

				// Zona Oeste //
				if(listitem == 2)
				{
					for(new i; i<sizeof Local_LasVenturas; i++)
					{
						format(Lista_DC[playerid][i][cel_Nome], 100, Local_LasVenturas[i][local_Nome]);
					format(Titulo_DC[playerid], 100, "ZONA OESTE");
					MAX_DC[playerid] = sizeof Local_LasVenturas;
					Item_DC[playerid] = -1;
					Pagina_DC[playerid] = 0;
				    }
				    celular(playerid, C_LISTA);
				}

				// CAIXAS ELETRONICOS //
				if(listitem == 3)
				{
				    new Float:p[3];
				    GetPlayerPos(playerid, p[0],p[1],p[2]);
				    new cep = -1;
				    new Float:disf1 = 999999999.0;
				    new Float:disf;
				    foreach(new ii:Iter_CaixasEletronicos)
					{
					if(CaixaEletronico[ii][ce_Existe] == 1)
					{
					    if(CaixaEletronico[ii][ce_Quebrado] == 0)
						{
					        GetDistance(disf, p[0],p[1],p[2],  CaixaEletronico[ii][ce_X],  CaixaEletronico[ii][ce_Y], CaixaEletronico[ii][ce_Z]);
					        if(disf < disf1)
					        {
					            disf1 = disf;
					            cep = ii;
					        }
					    }
					}
				    }

				    new cont;
				    foreach(new i:Iter_CaixasEletronicos)
					{
					if(CaixaEletronico[i][ce_Existe] == 1)
					{
					    if(CaixaEletronico[i][ce_Quebrado] == 0)
						{
					        if(i != cep) format(Lista_DC[playerid][cont][cel_Nome], 100, "~w~Caixa Eletronico (%d)", i);
					        else format(Lista_DC[playerid][cont][cel_Nome], 100, "~y~CAIXA MAIS PROXIMO (%d)", i);
					    }

					    if(CaixaEletronico[i][ce_Quebrado] == 1)
						{
					        if(i != cep) format(Lista_DC[playerid][cont][cel_Nome], 100, "~r~Caixa Eletronico (%d)", i);
					        else format(Lista_DC[playerid][cont][cel_Nome], 100, "~y~CAIXA MAIS PROXIMO (%d)", i);
					    }
					    Lista_DC[playerid][cont][cel_ID] = i;
					    cont++;
					}
				    }

				    MAX_DC[playerid] = cont;
				    Pagina_DC[playerid] = 0;
				    format(Titulo_DC[playerid], 100, "CAIXAS ELETRONICOS");
				    Item_DC[playerid] = -1;
				    celular(playerid, C_LISTA);
				}

				// casas //
				if(listitem == 4)
				{
				    escolher_casa_gps(playerid);
				}

		        return 1;
		    }

		    celular(playerid, C_GPS);
		    return 1;
		}

	}
	return 1;
}

stock menu_auto_escola(playerid)
{
    max_menu[playerid] = sizeof(Info_Teste);
	menu_id[playerid] = AUTO_ESCOLA;
	format(nome_menu[playerid], 100, "Teste Pratico da Auto Escola");
	format(botao_menu[playerid], 100, "COMECAR");
	for(new i; i<max_menu[playerid]; i++)
	{
	    if(i < MAX_MENU)
	    {
		    Menu[playerid][i][menu_ID] = i;
		    Menu[playerid][i][menu_Unidades] = 1;
		    Menu[playerid][i][menu_Tipo] = 0;
		    Menu[playerid][i][menu_Valor] = strval(Info_Teste[i][1]);
		    format(Menu[playerid][i][menu_Nome], 200, "%d - %s", i+1, Info_Teste[i][0]);
		    format(Menu[playerid][i][menu_Info], 200, "~n~~w~%s~n~~g~R$ %s", Info_Teste[i][0], ConvertMoney(strval(Info_Teste[i][1])));
		    Menu[playerid][i][menu_Modelo] = veiculos_teste[i];
	    }
	}
	escolhendo_menu[playerid] = 0;
	mostrar_menu(playerid, menu_id[playerid]);
}

stock tem_habilitacao(playerid, tipo)
{
	if(Online(playerid))
	{
	    new c = id[playerid];
	    if(c != -1)
	    {
	        if(Conta[playerid][c_H][tipo] == 1) return 1;
		}
	}
	return 0;
}

stock renovar_auto_escola(playerid, con=-1)
{
	new c = id[playerid];
	if(c != -1)
	{
		if(Online(playerid))
		{
			if(TemHabilitacao(playerid))
			{
				new temph = (Conta[playerid][c_HV]-gettime())/UM_DIA;
			    if(temph > 20)  ms(playerid, 0, "Sua Habilitacao ainda tem mais de 20 dias de validade !");
			    else
				{
					new habs[50];
				new valor_total;
					new cont;
					for(new z; z<4; z++)
					{
						if(Conta[playerid][c_H][z] == 1)
						{
						    strcat(habs, "   ");
						    strcat(habs, Sigla[z]);
						    valor_total += 250;
						    cont++;
						}
					}
					valor_total += (Conta[playerid][c_HP]*125);
				    new sss[1300];

				    if(con == 1)
					{
					format(sss, 150, "Voce renovou %d categorias de sua habilitacao e removeu %d pontos, por R$ %s.", cont, Conta[playerid][c_HP], ConvertMoney(valor_total) );
						ms(playerid, 1, sss);
						Conta[playerid][c_HP] = 0;
						Conta[playerid][c_HV] = gettime()+(30*UM_DIA);
						salvar_conta(c, -1, "c_Habilitacao");
						mostrar_habilitacao(playerid, playerid);
				    }
				    else
					{
						format(sss, 1300,
						"\n\
						RENOVAR HABILITACAO\n\n\
						\
						{ffffff}Ola {00ffff}%s{ffffff}, o valor por categoria e {4169E1}R$ 250{ffffff}, mais um\n\
						valor de {4169E1}R$ 125 {ffffff}por cada {ffff00}ponto {ffffff}na carteira, apos o pagamento da \n\
						renovacao, sua habilitacao tera {ffff00}30 {ffffff}dias de validade novamente, e\n\
						os pontos serao zerados.\n\n\
						\
						{00ffff}[INFO]{a1a1a1} A renovacao nao livra voce de suas multas de transito, as multas pessoais \n\
						devem ser pagas em uma loterica, e as multas de seus veiculos devem ser pagas no DETRAN, caso\n\
						tenha multas pessoais pendentes, nao sera possivel realizar a renovacao da sua CNH.\n\n\n\
						\
						\
						{ffffff}Categorias: [{a1a1a1}%s  {ffffff}]\n\
						{ffffff}Pontos: [ {ff0000}%d {ffffff}]\n\n\
						\
						Valor Total: {4169E1}R$ %s\n", Nome(playerid), habs, Conta[playerid][c_HP], ConvertMoney(valor_total));
						SetPVarInt(playerid, "valor_total", valor_total);
				    ShowPlayerDialog(playerid, DIALOG_AUTO_ESCOLA2, DIALOG_STYLE_MSGBOX, "{000000}_", sss, "Pagar", "Cancelar");
					}
				}

			}
			else MS(playerid, 0, "Voce nao possue uma habilitacao !");
		}
	}
}


stock menu_mercado_negro(playerid, con=-1, itee=-1)
{
	if(Online(playerid))
	{
	    new c = id[playerid];
	    if(c == -1) return 1;
	    {
		    // confirmar //
			new sss[300];
		    if(con == -2)
		    {
		        new i = itee;
		        if(GranaPlayer(playerid) < Mercado_Negro[i][3])
				{
				 	ms(playerid, 0, "Voce nao tem grana para comprar esta mercadoria !");
					menu_mercado_negro(playerid, -1, i);
				 	return 1;
				}

				for(new o; o<20; o++)
				{
				    if(Deposito[playerid][o] == -1)
					{
					Deposito[playerid][o] = i;
					DarGrana(playerid, -Mercado_Negro[i][3]);
					salvar_deposito(c);
						format(sss, 150, "Voce comprou %d %s por R$ %s, a mercadoria esta no deposito pronto para retirada.", Mercado_Negro[i][1], NomeItem(Mercado_Negro[i][0], Mercado_Negro[i][2]), ConvertMoney(Mercado_Negro[i][3]));
						ms(playerid, 2, sss);
						Localizar_Player(playerid, 198.3503,-231.0375,1.7786, 65, -1, "DEPOSITO");
						ms(playerid, 2, "Siga ate a marca vermelha do seu radar para encontrar o deposito.");
						menu_mercado_negro(playerid, -1);
						return 1;
				    }
				}

				ms(playerid, 0, "Voce precisa tirar suas mercadorias do deposito para comprar mais !");
				return 1;
		    }

		    // menu //
		    if(con == -1)
		    {

				SG[0] = EOS;
				strcat(SG, "Mercadoria\tUnidades\tValor\n");
		        for(new i; i<sizeof Mercado_Negro; i++)
		        {
		            format(sss, 150, "{ffffff}%s\t{a1a1a1}%s\t{4169E1}R$ %s\n", NomeItem(Mercado_Negro[i][0], Mercado_Negro[i][2]), ConvertMoney(Mercado_Negro[i][1]), ConvertMoney(Mercado_Negro[i][3]));
	                strcat(SG, sss);
				}
				format(sss, 150, "{ffffff}Items Disponiveis [{ffff00}%d{ffffff}]", sizeof Mercado_Negro);
				ShowPlayerDialog(playerid, DIALOG_MN, DIALOG_STYLE_TABLIST_HEADERS, sss, SG, "Continuar", "Fechar");
				return 1;
		    }

		    SetPVarInt(playerid, "id_mn", con);
		    format(sss, 150, "\n{ffffff}Mercadoria: {ffff00}%s\n{ffffff}Unidades: {a1a1a1}%s\n{ffffff}Valor: R$ %s\n\n{00ffff}[INFO] {a1a1a1}Deseja realizar esta compra ?\n", NomeItem(Mercado_Negro[con][0], Mercado_Negro[con][2]), ConvertMoney(Mercado_Negro[con][1]), ConvertMoney(Mercado_Negro[con][3]));
			ShowPlayerDialog(playerid, DIALOG_MN2, DIALOG_STYLE_MSGBOX, "Mercado Negro", sss, "Comprar", "Voltar");
		}
	}
	return 1;
}

stock abrir_deposito(playerid)
{
	if(Online(playerid))
	{
	    {
		    new d;
		    new c = id[playerid];
		    if(c == -1) return 1;
		    new sss[300];
			SG[0] = EOS;
			new cont;
			strcat(SG, "Mercadoria\tUnidades\n");
			zerar_lista(playerid);
			for(new i; i<20; i++)
			{
			    d = Deposito[playerid][i];
			    if( d != -1 )
				{
				format(sss, 300, "{ffffff}%s\t{00ffff}%s\n", NomeItem(Mercado_Negro[d][0], Mercado_Negro[d][2]), ConvertMoney(Mercado_Negro[d][1]));
				strcat(SG, sss);
				Lista[playerid][cont] = i;
				cont ++;
			    }
			}
			format(sss, 300, "{ffffff}Suas Mercadorias [{00ffff}%d{ffffff}]", cont);
			ShowPlayerDialog(playerid, DIALOG_DEPOSITO, DIALOG_STYLE_TABLIST_HEADERS, sss, SG, "Retirar", "Cancelar");
		}
	}
	return 1;
}

stock retirar_mercado_negro(playerid, i)
{
	if(Online(playerid))
	{
	    new c = id[playerid];
	    if(c == -1) return 1;
	    if(Deposito[playerid][i] != -1)
	    {
	        new a = Mercado_Negro[Deposito[playerid][i]][0];
	        new u = Mercado_Negro[Deposito[playerid][i]][1];
	        new t = Mercado_Negro[Deposito[playerid][i]][2];
	        new Float:pos[3];
		    GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
		    PegarFrente(pos[0], pos[1], random(360), random(8)*0.3);
		    criar_item(a, pos[0], pos[1], pos[2], u, GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), t);
			Deposito[playerid][i] = -1;
		    salvar_deposito(c);
		    ms(playerid, 1, "Voce retirou o item, pegue-o do chao !");
		    abrir_deposito(playerid);
	    }
	}
	return 1;
}

stock carregar_deposito(playerid, c)
{
    new file[80];
	format(file, 80, "Deposito/%d.txt", c);
    if(DOF2_FileExists(file)) for(new i; i<20; i++) Deposito[playerid][i] = DOF2_GetInt(file, ConvertMoney(i));
    else for(new i; i<20; i++) Deposito[playerid][i] = -1;
	return 1;
}

stock salvar_deposito(c)
{
	new player = ContaOnline(c);
	if(Online(player))
	{
		new file[80];
		format(file, 80, "Deposito/%d.txt", c);
		if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
		if(!ContaInvalida(c))
		{
	        DOF2_CreateFile(file);
			for(new i; i<20; i++) DOF2_SetInt(file, ConvertMoney(i), Deposito[player][i]);
	        DOF2_SaveFile();
		}
	}
}

stock Multar(c, valor, conta, radar, const motivo[], veh, inf=-1)
{
	if(inf != -1)
	{
        for(new a; a<MAX_MULTAS; a++)
		{
            if(Veiculo_Multa[inf][a][mu_Existe] == 0)
            {
                new info = inf;
                Veiculo_Multa[info][a][mu_Existe] = 1;
                Veiculo_Multa[info][a][mu_Valor] = valor;
			    Veiculo_Multa[info][a][mu_Conta] = conta;
		     	Veiculo_Multa[info][a][mu_Radar] = radar;
     	        format(Veiculo_Multa[info][a][mu_Motivo], 100, "%s - %s", motivo, PlacaVeiculo[info]);
	    		format(Veiculo_Multa[info][a][mu_Data], 50, "%02d/%02d/%02d - %02d:%02d", DIA, MES, ANO, HORA, MINUTO);
				if(c != -1)
				{
					new sss[150];
				    if(conta == -123) format(sss, 150, "[RADAR] O veiculo de placa: %s, foi multado no valor de R$ %s.", PlacaVeiculo[info], ConvertMoney(valor));
				    else format(sss, 150, "[MULTA] O veiculo de placa: %s, foi multado por '%s' R$ %s.", PlacaVeiculo[info], NomeConta(conta), ConvertMoney(valor));
				    msc(c, 0xFFFF00ff, sss);
				    format(sss, 150, "Motivo: %s.", motivo);
				    msc(c, 0xFFFF00ff, sss);
			    }
			    SalvarInfo(info, 51);
                return 1;
            }
        }
        return 2;
	}
	else
	{
		new playerid = ContaOnline(c);
		if(Online(playerid))
		{
		    if(GetVehicleModel(veh) != 0)
		    {
		        new info = Info_Veiculo[veh];
		        if(info != -1)
		        {
		            for(new a; a<MAX_MULTAS; a++)
					{
		                if(Veiculo_Multa[info][a][mu_Existe] == 0)
		                {
		                    Veiculo_Multa[info][a][mu_Existe] = 1;
		                    Veiculo_Multa[info][a][mu_Valor] = valor;
						    Veiculo_Multa[info][a][mu_Conta] = conta;
					     	Veiculo_Multa[info][a][mu_Radar] = radar;
			     	        format(Veiculo_Multa[info][a][mu_Motivo], 100, motivo);
				    		format(Veiculo_Multa[info][a][mu_Data], 50, "%02d/%02d/%02d - %02d:%02d", DIA, MES, ANO, HORA, MINUTO);
							if(c != -1)
							{
								new sss[150];
							    if(conta == -123) format(sss, 150, "[RADAR] O veiculo recebeu uma multa no valor de R$ %s.", ConvertMoney(valor));
							    else format(sss, 150, "[MULTA] O veiculo recebeu uma multa de '%s' R$ %s.", NomeConta(conta), ConvertMoney(valor));
							    msc(c, 0xFFFF00ff, sss);
							    format(sss, 150, "Motivo: %s.", motivo);
							    msc(c, 0xFFFF00ff, sss);
						    }
						    SalvarInfo(info, 51);
		                    return 1;
		                }
		            }
		            return 2;
		        }
		    }

			for(new i; i<MAX_MULTAS; i++)
			{
			    if(Multas[playerid][i][mu_Existe] == 0)
				{
				    Multas[playerid][i][mu_Existe] = 1;
				    Multas[playerid][i][mu_Valor] = valor;
				    Multas[playerid][i][mu_Conta] = conta;
			     	Multas[playerid][i][mu_Radar] = radar;
				    format(Multas[playerid][i][mu_Motivo], 100, motivo);
				    format(Multas[playerid][i][mu_Data], 50, "%02d/%02d/%02d - %02d:%02d", DIA, MES, ANO, HORA, MINUTO);
				    new sss[150];
				    if(conta == -123) format(sss, 150, "[RADAR] Voce recebeu uma multa no valor de R$ %s.", ConvertMoney(valor));
				    else format(sss, 150, "[MULTA] Voce recebeu uma multa de '%s' no valor de R$ %s.", NomeConta(conta), ConvertMoney(valor));
				    msc(c, 0xFFFF00ff, sss);
				    format(sss, 150, "Motivo: %s.", motivo);
				    msc(c, 0xFFFF00ff, sss);
				    salvar_multas(c);
				    return 3;
			    }
		    }
	    }
	}
	return 3;
}

stock destruir_radar(i)
{
    if(Radar[i][radar_Existe] == 1) Radar[i][radar_Existe] = 0;
    atualizar_radar(i);
	salvar_radar(i);
	return 1;
}

stock criar_radar(Float:xx, Float:yy, Float:zz, velo, valor)
{
	for(new i; i<MAX_RADARES; i++)
	{
	    if(Radar[i][radar_Existe] == 0)
	    {
	        Radar[i][radar_Existe] = 1;
	        Radar[i][radar_Valor] = valor,
	        Radar[i][radar_Velocidade] = velo;
	        Radar[i][radar_Ativado] = 1;
	        Radar[i][radar_X] = xx;
	        Radar[i][radar_Y] = yy;
	        Radar[i][radar_Z] = zz;
			Radar[i][radar_RX] = 0.0;
	        Radar[i][radar_RY] = 0.0;
	        Radar[i][radar_RZ] = 0.0;
			atualizar_radar(i);
			return i;
	    }
	}
	return -1;
}

stock atualizar_radar(i)
{
	Iter_Remove(Iter_Radares, i);
    if(IsValidDynamicObject(Radar[i][radar_Obj])) DestroyDynamicObject_(Radar[i][radar_Obj]);
	if(Radar[i][radar_Existe] == 1)
	{
	    Iter_Add(Iter_Radares, i);
		Radar[i][radar_Obj] = CreateDynamicObject( 18880, Radar[i][radar_X], Radar[i][radar_Y], Radar[i][radar_Z], Radar[i][radar_RX], Radar[i][radar_RY], Radar[i][radar_RZ], -1, -1, -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
	}
	texto_radar(i);
	return 1;
}

stock texto_radar(i)
{
    if(IsValidDynamic3DTextLabel(Radar[i][radar_3D])) DestroyDynamic3DTextLabel(Radar[i][radar_3D]);
    Radar[i][radar_3D] = DynamicText3D:-1;
    if(Radar[i][radar_Existe] == 1)
	{
	    new sss[150];
	    if(Radar[i][radar_Ativado] == 1) format(sss, 150, "{ffffff}RADAR ID: %d\n{00ffff}%d KM/H", i, Radar[i][radar_Velocidade]);
		else format(sss, 150, "{ffffff}RADAR ID: %d\n{a1a1a1}QUEBRADO", i);
		Radar[i][radar_3D] = CreateDynamic3DTextLabel( sss, 0xffffff99, Radar[i][radar_X], Radar[i][radar_Y], Radar[i][radar_Z]+5.0, 40, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0,  -1, -1, -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
	}
	return 1;
}

stock dialog_criar_conta(playerid, con=0)
{
	SG[0] = EOS;
	new sss[150];
	strcat(SG, "Opcao\tStatus\n");
	if(con == 1)
	{
		format(CriarConta[playerid][cc_Nick], MAX_PLAYER_NAME, Nome(-1));
		CriarConta[playerid][cc_Cidade] = 0;
		CriarConta[playerid][cc_Idade] = 18;
		CriarConta[playerid][cc_Sexo] = 0;
	}

	format(sss, 150, "{ffffff}Nick\t{a1a1a1}%s\n", CriarConta[playerid][cc_Nick]);
	strcat(SG, sss);
	format(sss, 150, "{ffffff}Cidade\t{00ffff}%s\n", cidade(CriarConta[playerid][cc_Cidade]));
	strcat(SG, sss);
	format(sss, 150, "{ffffff}Sexo\t{a1a1a1}%s\n", sexo(CriarConta[playerid][cc_Sexo]));
	strcat(SG, sss);
	format(sss, 150, "{ffffff}Idade\t{a1a1a1}%d\n", CriarConta[playerid][cc_Idade]);
	strcat(SG, sss);
	strcat(SG, "{000000}.\t{000000}.\n");
	strcat(SG, "{4169E1}CRIAR\t{000000}.\n");

	ShowPlayerDialog(playerid, DIALOG_CC, DIALOG_STYLE_TABLIST_HEADERS, "Criar Conta", SG, "Continuar", "Fechar");
	return 1;
}

