	{
	    new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /cargoportao [ ID do PORTAO ]");
		if(i < 0 || i >= MAX_PORTOES) return ms(playerid, 0, "ID de portao Invalido !");
		if(Portao[i][p_Existe] == 0) return ms(playerid, 0, "Este portao nao existe !");
	    if(Portao[i][p_Org] == -1) return ms(playerid, 0, "Este portao nao e de uma Org !");
		mostrar_cargos_portao(playerid, i);
		return 1;
	}

