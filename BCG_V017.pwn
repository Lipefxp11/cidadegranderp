	    if(!response) mostrar_info_arma(playerid, i);
	    else
	    {
		    new opc = GetPVarInt(playerid, "opcao_editar");
		    // nome //
		    if(opc == 0)
		    {
		        if(strlen(inputtext) < 3)
		        {
		            ms(playerid, 0, "Nome Muito pequeno, tente novamente !");
		            OnDialogResponse(playerid, DIALOG_ARMAS2, 1, opc, "");
		            return 1;
		        }

		        format(lista_armas[i][a_Nome], 40, inputtext);
		        ms(playerid, 1, "O Nome da arma foi alterado com sicesso !");
		        salvar_info_arma(i);
		        mostrar_info_arma(playerid, i);
		        return 1;
		    }

		    // dano //
		    if(opc == 1)
		    {
		        if(!IsNumeric(inputtext))
		        {
		            ms(playerid, 0, "Digite Apenas numeros !");
		            OnDialogResponse(playerid, DIALOG_ARMAS2, 1, opc, "");
		            return 1;
		        }

		        new num = strval(inputtext);
		        if(num < 0 || num > 300)
		        {
		            ms(playerid, 0, "Use um numero de 0 a 300 !");
		            OnDialogResponse(playerid, DIALOG_ARMAS2, 1, opc, "");
		            return 1;
		        }

		        lista_armas[i][a_Dano] = num;
		        ms(playerid, 1, "O Dano da arma foi alterado com sicesso !");
		        salvar_info_arma(i);
		        mostrar_info_arma(playerid, i);
		        return 1;
		    }
	    }
	    return 1;
	}

	// dialog de setar info das armas //
	if(dialogid == DIALOG_ARMAS2)
