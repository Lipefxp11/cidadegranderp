	    fac_estoque = val;
	    salvar_definicoes("Cofre", cofre_publico);
	    ms(playerid, 1, f("Estoque de faccao definido para %d.", val));
	    return 1;
	}

    if(!strcmp(cmd, "/convidarorg", true))
	{
	    new org = OrgPlayer(playerid);
	    if(org == -1) return ms(playerid, 0, "Voce nao pertence a uma organizacao !");
	    if(Conta[playerid][c_Cargo] < 5) return ms(playerid, 0, "Apenas lider ou sub-lider pode convidar !");
	    SetPVarInt(playerid, "convidar_org", org);
	    ShowPlayerDialog(playerid, DIALOG_CONVIDAR_ORG, DIALOG_STYLE_INPUT, Org[org][o_Nome], "\n{4169E1}[INFO] {a1a1a1}Digite o ID da Conta que deseja convidar:\n\n", "Convidar", "Cancelar");
	    return 1;
