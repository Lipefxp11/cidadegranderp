	if(!strcmp(cmd, "/youtuber", true))
	{
		new sss[300], c, valor;
		if(sscanf(params, "dd", c, valor)) return ms(playerid, 0, "Use: /youtuber [ ID da conta ] [ 0 ou 1 ]");
		if(ContaInvalida(c)) return ms(playerid, 0, "Esta conta nao existe !");
		if(valor != 0 && valor != 1) return ms(playerid, 0, "Use 0 ou 1 para a tag de YouTuber !");
	    new pla = ContaOnline(c);
	    if(valor == 0)
	    {
	        if(!youtuber(c)) return ms(playerid, 0, "Esta Conta nao tem Tag de YouTube setada !");
	        format(sss, 300, "O Admin %s retirou sua Tag de Youtuber.", Nome(playerid));
	        if(Online(pla))
	        {
				Conta[pla][c_TagYT] = 0;
	            salvar_conta(c, 0, "c_TagYT", sv_int(0));
	            ms(playerid, 5, sss);
	        }
	        else
	        {
	            salvar_conta(c, 0, "c_TagYT", sv_int(0));
	            msc(c, 0xF08080ff, sss);
	        }
	        format(sss, 300, "Voce retirou a Tag de Youtuber de %s[%d].", NomeConta(c), c);
	        ms(playerid, 5, sss);
	    }
	    else
	    {
	        if(youtuber(c)) return ms(playerid, 0, "Esta Conta ja tem Tag de YouTube setada !");
	        format(sss, 300, "O Admin %s retirou sua Tag de Youtuber.", Nome(playerid));
	        if(Online(pla))
	        {
				Conta[pla][c_TagYT] = 1;
	            salvar_conta(c, 0, "c_TagYT", sv_int(1));
	            ms(playerid, 5, sss);
	        }
	        else
	        {
	            salvar_conta(c, 0, "c_TagYT", sv_int(1));
	            msc(c, 0xF08080ff, sss);
	        }
	        format(sss, 300, "Voce retirou a Tag de Youtuber de %s[%d].", NomeConta(c), c);
	        ms(playerid, 5, sss);
	    }
