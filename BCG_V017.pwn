stock SalvarArmas(playerid)
{
    new Arq[5000], str[5000], wid, wammo;
    format(Arq, sizeof(Arq), PASTA_ARMAS, Nome(playerid));
    if(!DOF2_FileExists(Arq))
    {
        DOF2_CreateFile(Arq);
    }
    for(new i = 0; i < 13; i++)
    {
        GetPlayerWeaponData(playerid, i, wid, wammo);
        format(str, sizeof(str), "Arma%d", i);
        DOF2_SetInt(Arq, str, wid);
        format(str, sizeof(str), "Municao%d", i);
        DOF2_SetInt(Arq, str, wammo);
    }
    DOF2_SaveFile();
    return 1;
}

stock CarregarArmas(playerid)
{
    new Arq[5000], str[5000], wid, wammo;
    format(Arq, sizeof(Arq), PASTA_ARMAS, Nome(playerid));
    if(DOF2_FileExists(Arq))
    {
        for(new i = 0; i < 13; i++)
        {
            format(str, sizeof(str), "Arma%d", i);
            wid = DOF2_GetInt(Arq, str);
            format(str, sizeof(str), "Municao%d", i);
            wammo = DOF2_GetInt(Arq, str);
            GivePlayerWeapon(playerid, wid, wammo);
        }
    }
    return 1;
}
stock ContaOnline(c)
{
	new player = -1;
	if(c > -1 && c < MAX_CONTAS)
	{
		new a = player_conta[c];
		if(a != -1)
		{
			if(Online(a))
			{
			    if(logado[a] == 1)
				{
				player = a;
			    }
			}
		}
	}
	return player;
}

stock SetarSkin(c, skinx)
{
	new playerid = ContaOnline(c);
	if(Online(playerid))
	{
	    SetPlayerSkinFix(playerid, skinx);
	    Conta[playerid][c_Skin] = skinx;
	}
	salvar_conta(c, 0, "c_Skin", sv_int(skinx));
}

stock ContaInvalida(c)
{
	if(c < 0 || c >= MAX_CONTAS) return 1;
	if(conta_existe[c] == 0) return 1;
	return 0;
}

stock Dano(playerid, damagedid, amount, weaponid)
{
    new dado;
	if(dano_arma(weaponid, dado)) amount = dado;
	new dano_inicial = amount;

    ////  atirou ///
    if(Online(playerid))
    {
        new cc = id[playerid];
		if(cc != -1)
		{
			if(weaponid == 0)
			{
		        amount += (Conta[playerid][c_Forca]/15);
			}
		}
		if(dano_causado_player[playerid] == damagedid)
		{
		    dano_causado[playerid] += dano_inicial;
		    dano_causado_arma[playerid] = weaponid;
		}
		else
		{
		    dano_causado[playerid] = dano_inicial;
		    dano_causado_player[playerid] = damagedid;
		    dano_causado_arma[playerid] = weaponid;
		}
	    mostrar_dano(playerid);
	    KillTimer(timer_dano[playerid]);
		timer_dano[playerid] = SetTimerEx("resetar_dano", 6000, false, "d", playerid);
	}

	//// levou tiro ////
	if(dano_sofrido_player[damagedid] == playerid)
	{
	    dano_sofrido[damagedid] += dano_inicial;
	    dano_sofrido_arma[damagedid] = weaponid;
	}
	else
	{
	    dano_sofrido[damagedid] = dano_inicial;
	    dano_sofrido_player[damagedid] = playerid;
	    dano_sofrido_arma[damagedid] = weaponid;
	}

	mostrar_dano(damagedid);
	KillTimer(timer_dano[damagedid]);
    timer_dano[damagedid] = SetTimerEx("resetar_dano", 6000, false, "d", damagedid);


    if(Conta[damagedid][c_Colete] > 0)
    {
        if(Conta[damagedid][c_Colete] >= amount)
		{
			Conta[damagedid][c_Colete] -= amount;
			SetarColete(damagedid, Conta[damagedid][c_Colete]);
			return 1;
		}
        else
		{
		    amount -= Conta[damagedid][c_Colete];
		    SetarColete(damagedid, 0);
		}
    }
    if(amount > 0)
    {
	    if(Conta[damagedid][c_Vida] > amount)
		{
			Conta[damagedid][c_Vida] -= amount;
			SetarVida(damagedid, Conta[damagedid][c_Vida]);
		}
		else
		{
		    SetarVida(damagedid, 5);
			OnPlayerDeath2(damagedid, playerid, weaponid);
		}
	}
	return 1;
}

public OnPlayerTakeDamage(playerid, issuerid, Float:amount, weaponid, bodypart)
{
    if(logado[playerid] == 0) return 1;
    // playerid recebe dano //
    new dano = floatround(amount);
	new conta = id[playerid];
	if(conta != -1)
	{
	    SetarVida(playerid, Conta[playerid][c_Vida]);
	    SetarColete(playerid, Conta[playerid][c_Colete]);
	}
	if(issuerid > -1 && issuerid < MAX_PLAYERS)
	{
		if(ModoAdmin[issuerid] == 1) return 1;
		if(AreaNeutra(playerid) || AreaNeutra(issuerid))
		{
		    BloquearDano(issuerid);
		    return 1;
		}
	}
	if(ModoAdmin[playerid] == 1) return 1;
	if(weaponid == 51) return 1;
	if(conta == -1) return 1;
	if(Conta[issuerid][c_Morto] > 0) return 1;
	if(Conta[playerid][c_Morto] > 0) return 1;
	if(Conta[issuerid][c_Cadeia] != -1) return 1;
	if(Conta[playerid][c_Cadeia] != -1) return 1;
	if(player_algemado[issuerid] == 1) return 1;
	if(player_algemado[playerid] == 1) return 1;
	if(player_amarrado[issuerid] == 1) return 1;
	if(player_amarrado[playerid] == 1) return 1;
    CheckMarcado[playerid] = 0;
	

	// incendio - molotov - moto serra //
	if(weaponid == 18 || weaponid == 37 || weaponid == 9 )
	{
		if(GetPVarInt(playerid, "flood_arma_apelona") > gettime()) return 1;
		SetPVarInt(playerid, "flood_arma_apelona", gettime()+1);
	}

	if(!Online(issuerid))
	{
	    //// levou tiro ////
		if(dano_sofrido_player[playerid] == -1)
		{
		    dano_sofrido[playerid] += dano;
		    dano_sofrido_arma[playerid] = weaponid;
		}
		else
		{
		    dano_sofrido[playerid] = dano;
		    dano_sofrido_player[playerid] = -1;
		    dano_sofrido_arma[playerid] = weaponid;
		}
		mostrar_dano(playerid);
		KillTimer(timer_dano[playerid]);
	    timer_dano[playerid] = SetTimerEx("resetar_dano", 6000, false, "d", playerid);
	}

	if(issuerid == INVALID_PLAYER_ID || issuerid == -1) Dano(-1, playerid, dano, weaponid);
	return 1;
}

