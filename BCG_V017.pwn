		case 159: format(nameColor, 15, "Preto");
		case 160: format(nameColor, 15, "Verde Escuro");
		default: format(nameColor, 15, "Nenhuma");
	}
	return nameColor;
}

stock transferencia_casas(playerid)
{
    SG[0] = EOS;
	new linha[150];
    new cont;
    new conta = id[playerid];
    Lista2[playerid][0] = -1;
    strcat(SG, "ID\tTipo\tLocal\n");
    foreach(new i:Iter_Casas)
	{
	    if(cont >= MAX_LISTA) break;
  		if(Casa[i][casa_Existe] == 1)
	    {
	        if(Casa[i][casa_Dono] != -1)
	        {
				if(Casa[i][casa_Dono] == conta)
				{
				    format(linha, 150, "{a1a1a1}%d\t{00ffff}%s\t{ffffff}%s\n", i, tipo_casa(i), cidade(Casa[i][casa_Cidade]));
                    Lista2[playerid][cont] = i;
                	cont ++;
                	strcat(SG, linha);
				}
			}
		}
	}

	format(linha, 150, "{ffffff}Casas {a1a1a1}[{00ffff}%d{a1a1a1}]", cont);
 	ShowPlayerDialog(playerid, DIALOG_TRANSFERIR_CASA, DIALOG_STYLE_TABLIST_HEADERS, linha, SG, "Continuar", "Fechar");
}

stock transferencia_veiculos(playerid)
{
	SG[0] = EOS;
	new linha[150];
    new cont;
    new idcarro[50];
    new conta = id[playerid];
    Lista2[playerid][0] = -1;
    strcat(SG, "Info\tID\tModelo\tPlaca\n");
    foreach(new i:Iter_Veiculos)
	{
  		if(Veiculo[i][v_Existe] == 1)
	    {
	        if(Veiculo[i][v_Dono] != -1)
	        {
				if(Veiculo[i][v_Dono] == conta)
				{
				    if(Veiculo[i][v_Garagem] == 1 || GetVehicleModel(Veiculo[i][v_ID]) == 0) format(idcarro, 50, "{ff0000}G");
				    else format(idcarro, 50, "{ffff00}%d", Veiculo[i][v_ID]);
				    format(linha, 150, "{a1a1a1}%d\t%s\t{00ffff}%s\t{ffff00}GARAGEM\n", i, idcarro, NomeVeiculo(Veiculo[i][v_Modelo]));
                    Lista2[playerid][cont] = i;
                	cont ++;
                	strcat(SG, linha);
				}
			}
		}
	}

	format(linha, 150, "{ffffff}Veiculos {a1a1a1}[{00ffff}%d{a1a1a1}]", cont);
 	ShowPlayerDialog(playerid, DIALOG_TRANSFERIR_VEICULO, DIALOG_STYLE_TABLIST_HEADERS, linha, SG, "Continuar", "Fechar");
}

stock transferencia_casa(playerid, i)
{
	new linha[150];
	SetPVarInt(playerid, "id_info2", i);
    SG[0] = EOS;
    strcat(SG, "\n\n");
    format(linha, 150, "{ffffff}ID: {00ffff}%d\n", i);
    strcat(SG, linha);
    format(linha, 150, "{ffffff}Tipo: {ffff00}%s\n", tipo_casa(i));
    strcat(SG, linha);
    format(linha, 150, "{ffffff}Cidade: {a1a1a1}%s\n", cidade(Casa[i][casa_Cidade]));
    strcat(SG, linha);
    strcat(SG, "\n\n");
    strcat(SG, "{4169E1}INFO: {ffffff}Digite a baixo o valor que deseja vender a casa/apartamento, e em\nseguida selecione o jogador que ira compra-lo:");
    strcat(SG, "\n\n\n");
	ShowPlayerDialog(playerid, DIALOG_TRANSFERIR_CASA2, DIALOG_STYLE_INPUT, "Transferir Propiedade", SG, "Continuar", "Fechar");
}


stock transferencia_veiculo(playerid, i)
{
	new linha[150];
	SetPVarInt(playerid, "id_info2", i);
    SG[0] = EOS;
    strcat(SG, "\n\n");
    format(linha, 150, "{ffffff}Modelo: {00ffff}%s\n", NomeVeiculo(Veiculo[i][v_Modelo]));
    strcat(SG, linha);
    format(linha, 150, "{ffffff}Placa: {ffff00}%s\n", PlacaVeiculo[i]);
    strcat(SG, linha);
    format(linha, 150, "{ffffff}Chasi: {a1a1a1}%s\n", Veiculo[i][v_Chasi]);
    strcat(SG, linha);
    format(linha, 150, "{ffffff}Cor Predominante: {a1a1a1}%s\n", NomeCor(Veiculo[i][v_Cor1]));
    strcat(SG, linha);
    strcat(SG, "\n\n");
    strcat(SG, "{4169E1}INFO: {ffffff}Digite a baixo o valor que deseja vender o veiculo, e em\nseguida selecione o jogador que ira compra-lo:");
    strcat(SG, "\n\n\n");
	ShowPlayerDialog(playerid, DIALOG_TRANSFERIR_VEICULO2, DIALOG_STYLE_INPUT, "Transferir Veiculo", SG, "Continuar", "Fechar");
}


stock venda_casa(playerid, i, v)
{
	new c = id[playerid];
	if(c != -1)
	{
		if(Casa[v][casa_Existe] == 0)  ms(playerid, 0, "Esta casa/apartamento nao existe mais !");
		else if(Casa[v][casa_Dono] != c)  ms(playerid, 0, "Esta casa/apartamento nao lhe pertence mais !");
	    else
		{
			tempo_venda[playerid] = 60;
		    vendendo_para[playerid] = i;
		    comprando_de[i] = playerid;
		    KillTimer(timer_venda[playerid]);
		    SetPVarInt(playerid, "negociacao", 1);
		    SetPVarInt(i, "negociacao", 1);
		    timer_venda[playerid] = SetTimerEx("vendendo_casa", 1000, true, "ddd", playerid, i, 555);
	    }
    }
}

BCG:: vendendo_casa(playerid, p, cond)
{
    new linha[150];
    new i = GetPVarInt(playerid, "id_info2");
    new valor = GetPVarInt(playerid, "valor_casa");

    if(id[playerid] == -1)
    {
        KillTimer(timer_venda[playerid]);
        vendendo_casa(playerid, p, 1000);
    }
    else if(id[p] == -1)
    {
        KillTimer(timer_venda[playerid]);
        vendendo_casa(playerid, p, 2000);
    }
    else
    {
	    // aceitou a compra //
	    if(cond == 1)
	    {
	        KillTimer(timer_venda[playerid]);
	        vendendo_para[playerid] = -1;
			comprando_de[playerid] = -1;
			vendendo_para[p] = -1;
			comprando_de[p] = -1;

			if(GranaPlayer(p) >= valor)
			{
			    DarGrana(p, -valor);
			    DarGrana(playerid, valor);
			    Casa[i][casa_Dono] = id[p];
				salvar_casa(i);
				atualizar_casa(i);
	            format(string_prox, 300, "** '%s' transferiu o(a) %s ID: %d, para '%s' **", Nome(playerid), tipo_casa(i), i, Nome(p));
				ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
	            mostrar_documento_casa(p, i);
	            ms(p, 1, "Compra realizada com sucesso !");
	            ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Transferencia Realizada", "{4169E1}INFO {a1a1a1}Venda realizada com sucesso !", "Ok", "Fechar");
			}
			else
			{
			    ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Vendendo Casa", "\n\n{a1a1a1}O comprador nao tem dinheiro suficiente ! !\n\n", "Ok", "Fechar");
				ShowPlayerDialog(p, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Comprando Casa", "\n\n{a1a1a1}Voce nao tem dinheiro suficiente !\n\n", "Ok", "Fechar");
			}
	    }

	    // vendedor cancelou //
	    if(cond == 333)
	    {
	        KillTimer(timer_venda[playerid]);
	        ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Vendendo Casa", "\n\n{a1a1a1}Voce cancelou a negociacao !\n\n", "Ok", "Fechar");
			ShowPlayerDialog(p, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Comprando Casa", "\n\n{a1a1a1}O Vendedor cancelou a negociacao !\n\n", "Ok", "Fechar");
			vendendo_para[playerid] = -1;
			comprando_de[playerid] = -1;
			vendendo_para[p] = -1;
			comprando_de[p] = -1;
		}

		// comprador cancelou //
	    if(cond == 222)
	    {
	        KillTimer(timer_venda[playerid]);
	        ShowPlayerDialog(p, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Comprando Casa", "\n\n{a1a1a1}Voce recusou a oferta da Propriedade !\n\n", "Ok", "Fechar");
			ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Vendendo Casa", "\n\n{a1a1a1}O Comprador recusou a sua oferta !\n\n", "Ok", "Fechar");
			vendendo_para[playerid] = -1;
			comprando_de[playerid] = -1;
			vendendo_para[p] = -1;
			comprando_de[p] = -1;
		}

	    // vendedor quitou //
		if(cond == 1000)
		{
		    KillTimer(timer_venda[playerid]);
	        ShowPlayerDialog(p, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Comprando Casa", "\n\n{a1a1a1}O Vendedor acabou desconectando, a compra foi cancelada !\n\n", "Ok", "Fechar");
			vendendo_para[playerid] = -1;
			comprando_de[playerid] = -1;
			vendendo_para[p] = -1;
			comprando_de[p] = -1;
		}

		// comprador quitou //
		if(cond == 2000)
		{
		    KillTimer(timer_venda[playerid]);
	        ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Vendendo Casa", "\n\n{a1a1a1}O Comprador acabou desconectando, a venda foi cancelada !\n\n", "Ok", "Fechar");
	        vendendo_para[playerid] = -1;
			comprando_de[playerid] = -1;
			vendendo_para[p] = -1;
			comprando_de[p] = -1;
		}


		if(cond == 555)
		{
		    tempo_venda[playerid] --;
		    if(tempo_venda[playerid] == 0)
		    {
		        KillTimer(timer_venda[playerid]);
		        ShowPlayerDialog(p, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Comprando Casa", "\n\n{a1a1a1}O tempo acabou, a Compra foi cancelada !\n\n", "Ok", "Fechar");
				ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Vendendo Casa", "\n\n{a1a1a1}O tempo acabou, a Venda foi cancelada !\n\n", "Ok", "Fechar");
				vendendo_para[playerid] = -1;
				comprando_de[playerid] = -1;
				vendendo_para[p] = -1;
				comprando_de[p] = -1;
		    }
		    else
		    {

				SG[0] = EOS;
				strcat(SG, "\n\n");
				format(linha, 150, "{ffffff}ID: {00ffff}%d\n", i);
				strcat(SG, linha);
				format(linha, 150, "{ffffff}Tipo: {ffff00}%s\n", tipo_casa(i));
				strcat(SG, linha);
				format(linha, 150, "{ffffff}Cidade: {a1a1a1}%s\n", cidade(Casa[i][casa_Cidade]));
				strcat(SG, linha);

				strcat(SG, "\n");
				format(linha, 150, "{ffffff}Comprador: {a1a1a1}%s\n", Nome(p));
				strcat(SG, linha);
				format(linha, 150, "{ffffff}Valor: {4169E1}R$ %s\n", ConvertMoney(valor));
				strcat(SG, linha);
				strcat(SG, "\n");
				strcat(SG, "{ffffff}Aguardando Resposta ...");
				strcat(SG, "\n\n");
				format(linha, 150, "{ffffff}Vendendo Casa - [ {ffff00}%d {ffffff}]", tempo_venda[playerid]);
				ShowPlayerDialog(playerid, DIALOG_VENDENDO_CASA, DIALOG_STYLE_MSGBOX, linha, SG, "Aguardar", "Cancelar");



				SG[0] = EOS;
				strcat(SG, "\n\n");
				format(linha, 150, "{ffffff}ID: {00ffff}%d\n", i);
				strcat(SG, linha);
				format(linha, 150, "{ffffff}Tipo: {ffff00}%s\n", tipo_casa(i));
				strcat(SG, linha);
				format(linha, 150, "{ffffff}Cidade: {a1a1a1}%s\n", cidade(Casa[i][casa_Cidade]));
				strcat(SG, linha);

				format(linha, 150, "{ffffff}Vendedor: {a1a1a1}%s\n", Nome(playerid));
				strcat(SG, linha);
				format(linha, 150, "{ffffff}Valor: {4169E1}R$ %s\n", ConvertMoney(valor));
				strcat(SG, linha);
				strcat(SG, "\n");
				strcat(SG, "{4169E1}INFO: {ffffff}Deseja comprar esta Casa/Apartamento ?");
				strcat(SG, "\n\n");
				format(linha, 150, "{ffffff}Comprando %s - [ {ffff00}%d {ffffff}]", tipo_casa(i), tempo_venda[playerid]);
				ShowPlayerDialog(p, DIALOG_COMPRANDO_CASA, DIALOG_STYLE_MSGBOX, linha, SG, "Comprar", "Negar");
			}
		}
	}
}


stock venda_veiculo(playerid, i, v)
{
	new c = id[playerid];
	if(c != -1)
	{
		if(Veiculo[v][v_Existe] == 0)  ms(playerid, 0, "Este veiculo nao existe mais !");
		else if(Veiculo[v][v_Dono] != c)  ms(playerid, 0, "Este veiculo nao lhe pertence mais !");
	    else
		{
			tempo_venda[playerid] = 60;
		    vendendo_para[playerid] = i;
		    comprando_de[i] = playerid;
		    KillTimer(timer_venda[playerid]);
		    SetPVarInt(playerid, "negociacao", 0);
		    SetPVarInt(i, "negociacao", 0);
		    timer_venda[playerid] = SetTimerEx("vendendo_veiculo", 1000, true, "ddd", playerid, i, 555);
	    }
    }
}


BCG:: vendendo_veiculo(playerid, p, cond)
{
    new linha[150];
    new i = GetPVarInt(playerid, "id_info2");
    new valor = GetPVarInt(playerid, "valor_veiculo");

    if(id[playerid] == -1)
    {
        KillTimer(timer_venda[playerid]);
        vendendo_veiculo(playerid, p, 1000);
    }
    else if(id[p] == -1)
    {
        KillTimer(timer_venda[playerid]);
        vendendo_veiculo(playerid, p, 2000);
    }
    else
    {


		if(cond == 1)
	    {
	        KillTimer(timer_venda[playerid]);
	        vendendo_para[playerid] = -1;
			comprando_de[playerid] = -1;
			vendendo_para[p] = -1;
			comprando_de[p] = -1;

			if(GranaPlayer(p) >= valor)
			{
			    DarGrana(p, -valor);
			    DarGrana(playerid, valor);
			    Veiculo[i][v_Dono] = id[p];
			    Veiculo[i][v_Compra] = valor;
			    new hist_add[100];
			    format(hist_add, 100, "\n{ffff00}%s {ffffff}vendeu para {00ffff}%s", Nome(playerid), Nome(p));
			    strcat(Veiculo[i][v_History], hist_add, 300);
				SalvarInfo(i);
				texto_garagem(i);
	            format(string_prox, 300, "** '%s' transferiu o veiculo de placa %s para '%s' **", Nome(playerid), PlacaVeiculo[i], Nome(p));
				ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
	            mostrar_documento_veiculo(p, i);
	            ms(p, 1, "Compra realizada com sucesso !");
	            ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Transferencia Realizada", "{4169E1}INFO {a1a1a1}Venda realizada com sucesso !", "Ok", "Fechar");
			}
			else
			{
			    ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Vendendo Veiculo", "\n\n{a1a1a1}O comprador nao tem dinheiro suficiente ! !\n\n", "Ok", "Fechar");
				ShowPlayerDialog(p, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Comprando Veiculo", "\n\n{a1a1a1}Voce nao tem dinheiro suficiente !\n\n", "Ok", "Fechar");

			}
	    }

	    // vendedor cancelou //
	    if(cond == 333)
	    {
	        KillTimer(timer_venda[playerid]);
	        ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Vendendo Veiculo", "\n\n{a1a1a1}Voce cancelou a negociacao !\n\n", "Ok", "Fechar");
			ShowPlayerDialog(p, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Comprando Veiculo", "\n\n{a1a1a1}O Vendedor cancelou a negociacao !\n\n", "Ok", "Fechar");
			vendendo_para[playerid] = -1;
			comprando_de[playerid] = -1;
			vendendo_para[p] = -1;
			comprando_de[p] = -1;
		}

		// comprador cancelou //
	    if(cond == 222)
	    {
	        KillTimer(timer_venda[playerid]);
	        ShowPlayerDialog(p, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Comprando Veiculo", "\n\n{a1a1a1}Voce recusou a oferta do veiculo !\n\n", "Ok", "Fechar");
			ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Vendendo Veiculo", "\n\n{a1a1a1}O Comprador recusou a sua oferta !\n\n", "Ok", "Fechar");
			vendendo_para[playerid] = -1;
			comprando_de[playerid] = -1;
			vendendo_para[p] = -1;
			comprando_de[p] = -1;
		}

	    // vendedor quitou //
		if(cond == 1000)
		{
		    KillTimer(timer_venda[playerid]);
	        ShowPlayerDialog(p, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Comprando Veiculo", "\n\n{a1a1a1}O Vendedor acabou desconectando, a compra foi cancelada !\n\n", "Ok", "Fechar");
			vendendo_para[playerid] = -1;
			comprando_de[playerid] = -1;
			vendendo_para[p] = -1;
			comprando_de[p] = -1;
		}

		// comprador quitou //
		if(cond == 2000)
		{
		    KillTimer(timer_venda[playerid]);
	        ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Vendendo Veiculo", "\n\n{a1a1a1}O Comprador acabou desconectando, a venda foi cancelada !\n\n", "Ok", "Fechar");
	        vendendo_para[playerid] = -1;
			comprando_de[playerid] = -1;
			vendendo_para[p] = -1;
			comprando_de[p] = -1;
		}


		if(cond == 555)
		{
		    tempo_venda[playerid] --;
		    if(tempo_venda[playerid] == 0)
		    {
		        KillTimer(timer_venda[playerid]);
		        ShowPlayerDialog(p, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Comprando Veiculo", "\n\n{a1a1a1}O tempo acabou, a Compra foi cancelada !\n\n", "Ok", "Fechar");
				ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Vendendo Veiculo", "\n\n{a1a1a1}O tempo acabou, a Venda foi cancelada !\n\n", "Ok", "Fechar");
				vendendo_para[playerid] = -1;
				comprando_de[playerid] = -1;
				vendendo_para[p] = -1;
				comprando_de[p] = -1;
		    }
		    else
		    {

				SG[0] = EOS;
				strcat(SG, "\n\n");
				format(linha, 150, "{ffffff}Modelo: {00ffff}%s\n", NomeVeiculo(Veiculo[i][v_Modelo]));
				strcat(SG, linha);
				format(linha, 150, "{ffffff}Placa: {ffff00}%s\n", PlacaVeiculo[i]);
				strcat(SG, linha);
				format(linha, 150, "{ffffff}Chasi: {a1a1a1}%s\n", Veiculo[i][v_Chasi]);
				strcat(SG, linha);
				format(linha, 150, "{ffffff}Cor Predominante: {a1a1a1}%s\n", NomeCor(Veiculo[i][v_Cor1]));
				strcat(SG, linha);
				strcat(SG, "\n");
				format(linha, 150, "{ffffff}Comprador: {a1a1a1}%s\n", Nome(p));
				strcat(SG, linha);
				format(linha, 150, "{ffffff}Valor: {4169E1}R$ %s\n", ConvertMoney(valor));
				strcat(SG, linha);
				strcat(SG, "\n");
				strcat(SG, "{ffffff}Aguardando Resposta ...");
				strcat(SG, "\n\n");
				format(linha, 150, "{ffffff}Vendendo Veiculo - [ {ffff00}%d {ffffff}]", tempo_venda[playerid]);
				ShowPlayerDialog(playerid, DIALOG_VENDENDO_VEICULO, DIALOG_STYLE_MSGBOX, linha, SG, "Aguardar", "Cancelar");

				SG[0] = EOS;
				strcat(SG, "\n\n");
				format(linha, 150, "{ffffff}Modelo: {00ffff}%s\n", NomeVeiculo(Veiculo[i][v_Modelo]));
				strcat(SG, linha);
				format(linha, 150, "{ffffff}Placa: {ffff00}%s\n", PlacaVeiculo[i]);
				strcat(SG, linha);
				format(linha, 150, "{ffffff}Chasi: {a1a1a1}%s\n", Veiculo[i][v_Chasi]);
				strcat(SG, linha);
				format(linha, 150, "{ffffff}Cor Predominante: {a1a1a1}%s\n", NomeCor(Veiculo[i][v_Cor1]));
				strcat(SG, linha);
				strcat(SG, "\n");
				format(linha, 150, "{ffffff}Vendedor: {a1a1a1}%s\n", Nome(playerid));
				strcat(SG, linha);
				format(linha, 150, "{ffffff}Valor: {4169E1}R$ %s\n", ConvertMoney(valor));
				strcat(SG, linha);
				strcat(SG, "\n");
				strcat(SG, "{4169E1}INFO: {ffffff}Deseja comprar este veiculo ?");
				strcat(SG, "\n\n");
				format(linha, 150, "{ffffff}Comprando Veiculo - [ {ffff00}%d {ffffff}]", tempo_venda[playerid]);
				ShowPlayerDialog(p, DIALOG_COMPRANDO_VEICULO, DIALOG_STYLE_MSGBOX, linha, SG, "Comprar", "Negar");
		    }
		}

	}
}


stock NomeItem(i, unidades=-1, ativo=0, tempo=0)
{
	new namee[100];
	format(namee, 100, Itens[i][item_Nome]);

	// galao cheio //
	if(i == 51)
	{
	    if(unidades == 0) format(namee, 100, "Galao de Gasolina cheio");
	    if(unidades == 1) format(namee, 100, "Galao de Alcool cheio");
		if(unidades == 2) format(namee, 100, "Galao de Oleo Disel cheio");
		if(unidades == 3) format(namee, 100, "Galao de Agua cheio");
	}

	// chip //
	if(i == 77)
	{
	    if(unidades != -1)
	    {
	    	if(unidades == 1) format(namee, 100, "Chip da Claro");
	    	if(unidades == 2) format(namee, 100, "Chip da Tim");
	    }
	}

	// colete a prova de balas //
	if(i == 73)
	{
	    if(unidades != -1)
	    {
	    	format(namee, 100, "Colete: %d", unidades);
	    }
	}

	// dinheiro sujo //
	if(i == 49)
	{
	    if(unidades == -1)
	    {
	    	format(namee, 100, "Dinheiro Sujo");
	    }
	}

	// acessorio //
	if(i == 55)
	{
	    if(unidades != -1)
	    {
	    	format(namee, 100, "%s", Acessorios_Info[unidades][acessorio_Nome]);
	    }
	}

	// veiculo de inv //
	if(i == 56)
	{
	    if(unidades != -1)
	    {
	    	format(namee, 100, "%s", NomeVeiculo(unidades));
	    }
	}

 	// Skin //
	if(i == 57)
	{
	    if(unidades != -1)
	    {
	    	format(namee, 100, "Skin: %d", unidades);
	    }
	}


	// caixa de armas //
	if(i == 67)
	{
	    if(unidades != -1)
	    {
	    	format(namee, 100, "Caixa de %s", nome_arma(unidades));
	    }
	}

	// caixa de municoes //
	if(i == 69)
	{
	    if(unidades != -1)
	    {
	    	format(namee, 100, "Caixa de %s", nome_municao(unidades));
	    }
	}


	// armas //
	if(i > 0 && i < 44)
	{
	    format(namee, 100, nome_arma(Itens[i][item_Modelo]));
	}

	if(tempo != 0)
	{
	    if(ativo == 0)
		{
			strcat(namee, " - Novo: ");
			strcat(namee, Validade2(tempo));
		}
	    else
		{
			strcat(namee, " - Validade: ");
			strcat(namee, Validade(tempo));
		}

	}

	return namee;
}

stock n_t(num)
{
	new strf[100];
	format(strf, 100, "%d", num);
	return strf;
}

stock acessorios_player(playerid)
{
	new c = id[playerid];
	if(c != -1)
	{
		for(new w; w<MAX_ACESSORIOS; w++)
		{
		    RemovePlayerAttachedObject(playerid, w);
			if(Acessorios[playerid][w][ac_Existe] == 1)
			{
			    if(Acessorios[playerid][w][ac_Usando] == 1)
				{
				c = playerid;
				editar_SetPlayerAttachedObject(playerid, w, Acessorios_Info[Acessorios[c][w][ac_ID]][acessorio_Modelo],
					Acessorios[c][w][ac_Local], Acessorios[c][w][ac_X], Acessorios[c][w][ac_Y], Acessorios[c][w][ac_Z],
					Acessorios[c][w][ac_RX], Acessorios[c][w][ac_RY], Acessorios[c][w][ac_RZ], Acessorios[c][w][ac_TX],
					Acessorios[c][w][ac_TY], Acessorios[c][w][ac_TZ]);
			    }
	        }
		}
	}
}

stock ParteDoCorpo(parte)
{
	new partee[40];
	format(partee, 40, "Nenhuma");
	if(parte == 1)	format(partee, 40, "Coluna vertebral");
	if(parte == 2)	format(partee, 40, "Cabeca");
	if(parte == 3)	format(partee, 40, "Braco esquerdo");
	if(parte == 4)	format(partee, 40, "Braco direito");
	if(parte == 5)	format(partee, 40, "Mao esquerda");
	if(parte == 6)	format(partee, 40, "Mao direita");
	if(parte == 7)	format(partee, 40, "Coxa esquerda");
	if(parte == 8)	format(partee, 40, "Coxa direita");
	if(parte == 9)	format(partee, 40, "Pe esquerdo");
	if(parte == 10)	format(partee, 40, "Pe direito");
	if(parte == 11)	format(partee, 40, "Panturrilha direita");
	if(parte == 12)	format(partee, 40, "Panturrilha esquerda");
	if(parte == 13)	format(partee, 40, "Antebraco esquerdo");
	if(parte == 14)	format(partee, 40, "Antebraco direito");
	if(parte == 15)	format(partee, 40, "Ombro esquerdo");
	if(parte == 16)	format(partee, 40, "Ombro direito");
	if(parte == 17)	format(partee, 40, "Pescoco");
	if(parte == 18)	format(partee, 40, "Mandibula");
	return partee;
}

stock DestruirPedra(i)
{
    if(Pedra[i][pe_Existe] == 1)
	{
	    Pedra[i][pe_Existe] = 0;
	    AtualizarPedra(i);
	    salvar_pedra(i);
	}
}

stock DestruirArvore(i)
{
    if(Arvore[i][ar_Existe] == 1)
	{
	    Arvore[i][ar_Existe] = 0;
	    AtualizarArvore(i);
	    salvar_arvore(i);
	}
}

stock CriarArvore(Float:x, Float:y, Float:z, Float:a, inter, mund, salv=0)
{
	for(new i; i<MAX_ARVORES; i++)
	{
	    if(Arvore[i][ar_Existe] == 0)
	    {
	        Arvore[i][ar_Existe] = 1;
            Arvore[i][ar_X] = x;
            Arvore[i][ar_Y] = y;
            Arvore[i][ar_Z] = z;
            Arvore[i][ar_A] = a;
            Arvore[i][ar_Interior] = inter;
            Arvore[i][ar_Mundo] = mund;
	        Arvore[i][ar_Vida] = 50;
            Arvore[i][ar_Player] = -1;
			AtualizarArvore(i);
			if(salv == 0) salvar_arvore(i);
			return i;
	    }
	}
	return -1;
}

stock CriarPedra(Float:x, Float:y, Float:z, Float:a, inter, mund)
{
	for(new i; i<MAX_PEDRAS; i++)
	{
	    if(Pedra[i][pe_Existe] == 0)
	    {
	        Pedra[i][pe_Existe] = 1;
            Pedra[i][pe_X] = x;
            Pedra[i][pe_Y] = y;
            Pedra[i][pe_Z] = z;
            Pedra[i][pe_A] = a;
            Pedra[i][pe_Interior] = inter;
            Pedra[i][pe_Mundo] = mund;
	        Pedra[i][pe_Vida] = 50;
            Pedra[i][pe_Player] = -1;
			AtualizarPedra(i);
			salvar_pedra(i);
			return i;
	    }
	}
	return -1;
}

stock AtualizarArvore(i)
{
	Iter_Remove(Iter_Arvores, i);
	DestroyDynamicObject_(Arvore[i][ar_Obj]);
	DestroyDynamic3DTextLabel(Arvore[i][ar_3D]);
	Arvore[i][ar_3D] = DynamicText3D:-1;
    if(Arvore[i][ar_Existe] == 1)
	{
        Iter_Add(Iter_Arvores, i);
        Arvore[i][ar_Obj] = CreateDynamicObject(657, Arvore[i][ar_X], Arvore[i][ar_Y], Arvore[i][ar_Z], 0, 0, Arvore[i][ar_A], Arvore[i][ar_Mundo], Arvore[i][ar_Interior]);
        Arvore[i][ar_3D] = CreateDynamic3DTextLabel( "- ARVORE -\naperte ALT para\nconseguir madeiras", 0xffffff99, Arvore[i][ar_X], Arvore[i][ar_Y], Arvore[i][ar_Z]+0.8, 7, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, Arvore[i][ar_Mundo], Arvore[i][ar_Interior], -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0);
	}
}

stock AtualizarPedra(i)
{
	Iter_Remove(Iter_Pedras, i);
    DestroyDynamicObject_(Pedra[i][pe_Obj]);
    DestroyDynamic3DTextLabel(Pedra[i][pe_3D]);
    Pedra[i][pe_3D] = DynamicText3D:-1;
    if(Pedra[i][pe_Existe] == 1)
	{
	    Iter_Add(Iter_Pedras, i);
        Pedra[i][pe_Obj] = CreateDynamicObject(747, Pedra[i][pe_X], Pedra[i][pe_Y], Pedra[i][pe_Z], 0, 0, Pedra[i][pe_A], Pedra[i][pe_Mundo], Pedra[i][pe_Interior]);
        Pedra[i][pe_3D] = CreateDynamic3DTextLabel( "- PEDRA -\naperte ALT para\nconseguir fragmentos", 0xffffff99, Pedra[i][pe_X], Pedra[i][pe_Y], Pedra[i][pe_Z]+0.4, 7, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, Pedra[i][pe_Mundo], Pedra[i][pe_Interior], -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0);
	}
}


stock RespawnArvores()
{
    foreach(new a:Iter_Arvores)
	{
	    if(Arvore[a][ar_Existe] == 1)
	    {
	        Arvore[a][ar_Vida]= 50;
	        AtualizarArvore(a);
		}
	}
}

stock RespawnPedras()
{
    foreach(new a:Iter_Pedras)
	{
	    if(Pedra[a][pe_Existe] == 1)
	    {
	        Pedra[a][pe_Vida]= 50;
	        AtualizarPedra(a);
		}
	}
}


BCG:: carregar_arvores()
{
	new file[60];
	new cont;
	for(new i; i<MAX_ARVORES; i++)
	{
	    Arvore[i][ar_3D] = DynamicText3D:-1;
	    format(file, 60, "Arvores/Arvore_%d.txt", i);
	    if(DOF2_FileExists(file))
	    {
	        cont++;
	        CriarArvore(DOF2_GetFloat(file, "x"), DOF2_GetFloat(file, "y"), DOF2_GetFloat(file, "z"), DOF2_GetFloat(file, "a"), DOF2_GetInt(file, "inter"), DOF2_GetInt(file, "mund"), 1);
	    }
	}
	printf("** %d arvores carregadas.", cont);
}

stock salvar_arvore(i)
{
	new file[60];
    format(file, 60, "Arvores/Arvore_%d.txt", i);
    if(Arvore[i][ar_Existe] == 1)
    {
        if(!DOF2_FileExists(file)) DOF2_CreateFile(file);
        DOF2_SetFloat(file, "x", Arvore[i][ar_X]);
        DOF2_SetFloat(file, "y", Arvore[i][ar_Y]);
        DOF2_SetFloat(file, "z", Arvore[i][ar_Z]);
        DOF2_SetFloat(file, "a", Arvore[i][ar_A]);
        DOF2_SetInt(file, "mund", Arvore[i][ar_Mundo]);
        DOF2_SetInt(file, "inter", Arvore[i][ar_Interior]);
        DOF2_SaveFile();
    }
    else if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
}


BCG:: carregar_pedras()
{
	new file[60];
	new cont;
	for(new i; i<MAX_PEDRAS; i++)
	{
	    Pedra[i][pe_3D] = DynamicText3D:-1;
	    format(file, 60, "Pedras/Pedra_%d.txt", i);
	    if(DOF2_FileExists(file))
	    {
	        cont++;
	        CriarPedra(DOF2_GetFloat(file, "x"), DOF2_GetFloat(file, "y"), DOF2_GetFloat(file, "z"), DOF2_GetFloat(file, "a"), DOF2_GetInt(file, "inter"), DOF2_GetInt(file, "mund"));
	    }
	}
	printf("** %d pedras carregadas.", cont);
}


stock salvar_pedra(i)
{
	new file[60];
    format(file, 60, "Pedras/Pedra_%d.txt", i);
    if(Pedra[i][pe_Existe] == 1)
    {
        if(!DOF2_FileExists(file)) DOF2_CreateFile(file);
        DOF2_SetFloat(file, "x", Pedra[i][pe_X]);
        DOF2_SetFloat(file, "y", Pedra[i][pe_Y]);
        DOF2_SetFloat(file, "z", Pedra[i][pe_Z]);
        DOF2_SetFloat(file, "a", Pedra[i][pe_A]);
        DOF2_SetInt(file, "mund", Pedra[i][pe_Mundo]);
        DOF2_SetInt(file, "inter", Pedra[i][pe_Interior]);
        DOF2_SaveFile();
    }
    else if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
}

stock terminar_craft(playerid)
{
	if(craft_tipo[playerid] == 1) // madeiras
	{
		new p = craft_id[playerid];
        Arvore[p][ar_Vida] -= 7;
        if(Arvore[p][ar_Vida] <= 0)
		{
			DeitarArvore(p);
		}
		else
		{
		    new Float:pos[3];
		    pos[0] = Arvore[p][ar_X];
		    pos[1] = Arvore[p][ar_Y];
		    pos[2] = Arvore[p][ar_Z];
		    PegarFrente(pos[0], pos[1], random(360), 1+(random(8)*0.3));
            criar_item(58, pos[0], pos[1], pos[2], 1, GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), 0);
		    ms(playerid, 3, "Foi dropado 1 Madeira, aperte F ou ENTER para pegar, e leve para o veiculo.");
		}
	}

	if(craft_tipo[playerid] == 2) // pedras
	{
		new p = craft_id[playerid];
        Pedra[p][pe_Vida] -= 7;
        if(Pedra[p][pe_Vida] <= 0)
		{
			DeitarPedra(p);
		}
		else
		{
		    new Float:pos[3];
		    pos[0] = Pedra[p][pe_X];
		    pos[1] = Pedra[p][pe_Y];
		    pos[2] = Pedra[p][pe_Z];
		    PegarFrente(pos[0], pos[1], random(360), 1+(random(8)*0.3));
            criar_item(59, pos[0], pos[1], pos[2], 1, GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), 0);
		    ms(playerid, 3, "Foi dropado 1 fragmento de pedra, aperte F ou ENTER para pegar, e leve para o veiculo.");
		}
	}
	ClearAnimations(playerid, 1);
	for(new i; i<sizeof T_Craft; i++) TextDrawHideForPlayer(playerid, T_Craft[i]);
}

stock DeitarArvore(i)
{
	if(Arvore[i][ar_Existe] == 1)
	{
        if(Arvore[i][ar_Vida] != -123)
        {
			Arvore[i][ar_Vida] = -123;
			DestroyDynamicObject_(Arvore[i][ar_Obj]);
			DestroyDynamic3DTextLabel(Arvore[i][ar_3D]);
			Arvore[i][ar_3D] = DynamicText3D:-1;
			Arvore[i][ar_Obj] = CreateDynamicObject(657, Arvore[i][ar_X], Arvore[i][ar_Y], Arvore[i][ar_Z]+0.2, -90, 0, Arvore[i][ar_A], Arvore[i][ar_Mundo], Arvore[i][ar_Interior]);
            foreach(new a:Player)
			{
			    if(Online(a))
				{
				    if(IsPlayerInRangeOfPoint(a, 5, Arvore[i][ar_X], Arvore[i][ar_Y], Arvore[i][ar_Z]))
			    	{
					if(GetPlayerInterior(a) == Arvore[i][ar_Interior] && GetPlayerVirtualWorld_(a) == Arvore[i][ar_Mundo])
					{
							Streamer_Update(a);
					    }
					}
				}
			}
		}
	}
}

stock DeitarPedra(i)
{
	if(Pedra[i][pe_Existe] == 1)
	{
        if(Pedra[i][pe_Vida] != -123)
        {
			Pedra[i][pe_Vida] = -123;
			DestroyDynamicObject_(Pedra[i][pe_Obj]);
			DestroyDynamic3DTextLabel(Pedra[i][pe_3D]);
			Pedra[i][pe_3D] = DynamicText3D:-1;
			foreach(new a:Player)
			{
			    if(Online(a))
				{
				    if(IsPlayerInRangeOfPoint(a, 5, Pedra[i][pe_X], Pedra[i][pe_Y], Pedra[i][pe_Z]))
			    	{
					if(GetPlayerInterior(a) == Pedra[i][pe_Interior] && GetPlayerVirtualWorld_(a) == Pedra[i][pe_Mundo])
					{
							Streamer_Update(a);
					    }
					}
				}
			}
		}
	}
}

BCG:: carregar_cameras()
{
	new file[60];
	new cont;
	for(new i; i<MAX_CAMERAS; i++)
	{
	    format(file, 60, "Cameras/Camera_%d.txt", i);
	    if(DOF2_FileExists(file))
	    {
	        cont++;
			Camera[i][cam_Existe] = 1;
			format(Camera[i][cam_Nome], 100, "%s", DOF2_GetString(file, "cam_Nome"));
			Camera[i][cam_Quebrada] = DOF2_GetInt(file, "cam_Quebrada");
			Camera[i][cam_Vida] = DOF2_GetInt(file, "cam_Vida");
			Camera[i][cam_Mundo] = DOF2_GetInt(file, "cam_Mundo");
			Camera[i][cam_Interior] = DOF2_GetInt(file, "cam_Interior");
            Camera[i][cam_X] = DOF2_GetFloat(file, "cam_X");
            Camera[i][cam_Y] = DOF2_GetFloat(file, "cam_Y");
            Camera[i][cam_Z] = DOF2_GetFloat(file, "cam_Z");
            Camera[i][cam_RX] = DOF2_GetFloat(file, "cam_RX");
            Camera[i][cam_RY] = DOF2_GetFloat(file, "cam_RY");
            Camera[i][cam_RZ] = DOF2_GetFloat(file, "cam_RZ");
			Camera[i][cam_FX] = DOF2_GetFloat(file, "cam_FX");
            Camera[i][cam_FY] = DOF2_GetFloat(file, "cam_FY");
            Camera[i][cam_FZ] = DOF2_GetFloat(file, "cam_FZ");
			atualizar_camera(i);
		}
	}
	printf("** %d Cameras carregadas.", cont);
}

stock salvar_camera(i)
{
    new file[60];
    format(file, 60, "Cameras/Camera_%d.txt", i);
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
    if(Camera[i][cam_Existe] == 1)
    {
    	DOF2_CreateFile(file);
    	DOF2_SetString(file, "cam_Nome", Camera[i][cam_Nome]);
		DOF2_SetInt(file, "cam_Quebrada", Camera[i][cam_Quebrada]);
		DOF2_SetInt(file, "cam_Vida", Camera[i][cam_Vida]);
		DOF2_SetInt(file, "cam_Mundo", Camera[i][cam_Mundo]);
		DOF2_SetInt(file, "cam_Interior", Camera[i][cam_Interior]);
        DOF2_SetFloat(file, "cam_X", Camera[i][cam_X]);
        DOF2_SetFloat(file, "cam_Y", Camera[i][cam_Y]);
        DOF2_SetFloat(file, "cam_Z", Camera[i][cam_Z]);
        DOF2_SetFloat(file, "cam_RX", Camera[i][cam_RX]);
        DOF2_SetFloat(file, "cam_RY", Camera[i][cam_RY]);
        DOF2_SetFloat(file, "cam_RZ", Camera[i][cam_RZ]);
		DOF2_SetFloat(file, "cam_FX", Camera[i][cam_FX]);
        DOF2_SetFloat(file, "cam_FY", Camera[i][cam_FY]);
        DOF2_SetFloat(file, "cam_FZ", Camera[i][cam_FZ]);
    	DOF2_SaveFile();
    }
}

stock atualizar_camera(i, con=0)
{
	Iter_Remove(Iter_Cameras, i);
	if(Camera[i][cam_Existe] == 1) Iter_Add(Iter_Cameras, i);

	if(con == 1)
	{
	    if(IsValidDynamicObject(Camera[i][cam_Obj2])) DestroyDynamicObject_(Camera[i][cam_Obj2]);
	    Camera[i][cam_Obj2] = CreateDynamicObject(18703, Camera[i][cam_X], Camera[i][cam_Y], Camera[i][cam_Z]-1.3, 0, 0, 0, Camera[i][cam_Mundo], Camera[i][cam_Interior], -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
	}
	else
	{
	    if(IsValidDynamicObject(Camera[i][cam_Obj])) DestroyDynamicObject_(Camera[i][cam_Obj]);
	    if(IsValidDynamicObject(Camera[i][cam_Obj2])) DestroyDynamicObject_(Camera[i][cam_Obj2]);
		if(Camera[i][cam_Existe] == 1)
		{
		    Camera[i][cam_Obj] = CreateDynamicObject(1616, Camera[i][cam_X], Camera[i][cam_Y], Camera[i][cam_Z], Camera[i][cam_RX], Camera[i][cam_RY], Camera[i][cam_RZ], Camera[i][cam_Mundo], Camera[i][cam_Interior], -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
		    if(Camera[i][cam_Quebrada] == 0)
		    {
		        foreach(new a:Player)
				{
				    if(Online(a))
					{
					if(olhando_camera[a] == 0)
					{
					    if(olhando_camera_id[a] == i)
						{
		             			ver_camera(a, i);
					    }
					}
				    }
				}
		    }
		    else
		    {
		        Camera[i][cam_Obj2] = CreateDynamicObject(18703, Camera[i][cam_X], Camera[i][cam_Y], Camera[i][cam_Z]-1.3, 0, 0, 0, Camera[i][cam_Mundo], Camera[i][cam_Interior], -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
		        foreach(new a:Player)
				{
				    if(Online(a))
					{
					if(olhando_camera[a] == 0)
					{
					    if(olhando_camera_id[a] == i)
						{
		             			sair_camera(a);
					    }
					}
				    }
				}
		    }
		}
		else
		{
		    foreach(new aa:Player)
			{
			    if(Online(aa))
				{
				if(olhando_camera[aa] == 0)
				{
				    if(olhando_camera_id[aa] == i)
					{
							sair_camera(aa);
				    }
				}
			    }
			}
		}
	}
}

stock criar_camera(const nomec[], Float:xx, Float:yy, Float:zz, mund, inter)
{
	for(new i; i<MAX_CAMERAS; i++)
	{
	    if(Camera[i][cam_Existe] == 0)
	    {
	        Camera[i][cam_Existe] = 1;

			format(Camera[i][cam_Nome], 100, nomec);
			Camera[i][cam_Quebrada] = 0;
			Camera[i][cam_Vida] = 100;
			Camera[i][cam_Mundo] = mund;
			Camera[i][cam_Interior] = inter;
            Camera[i][cam_X] = xx;
            Camera[i][cam_Y] = yy;
            Camera[i][cam_Z] = zz;
            Camera[i][cam_RX] = 0;
            Camera[i][cam_RY] = 0;
            Camera[i][cam_RZ] = 0;
			Camera[i][cam_FX] = xx;
            Camera[i][cam_FY] = yy;
            Camera[i][cam_FZ] = zz;
			atualizar_camera(i);
			salvar_camera(i);
			return i;
	    }
	}
	return -1;
}

stock destruir_camera(i)
{
    if(Camera[i][cam_Existe] == 1) Camera[i][cam_Existe] = 0;
    atualizar_camera(i);
	salvar_camera(i);
}

BCG:: carregar_radares()
{
	new file[60];
	new cont;
	for(new i; i<MAX_RADARES; i++)
	{
	    Radar[i][radar_3D] = DynamicText3D:-1;
	    format(file, 60, "Radares/Radar_%d.txt", i);
	    if(DOF2_FileExists(file))
	    {
	        cont++;
			Radar[i][radar_Existe] = 1;
			Radar[i][radar_Velocidade] = DOF2_GetInt(file, "radar_Velocidade");
			Radar[i][radar_Ativado] = DOF2_GetInt(file, "radar_Ativado");
			Radar[i][radar_Valor] = DOF2_GetInt(file, "radar_Valor");
			Radar[i][radar_X] = DOF2_GetFloat(file, "radar_X");
			Radar[i][radar_Y] = DOF2_GetFloat(file, "radar_Y");
			Radar[i][radar_Z] = DOF2_GetFloat(file, "radar_Z");
			Radar[i][radar_RX] = DOF2_GetFloat(file, "radar_RX");
			Radar[i][radar_RY] = DOF2_GetFloat(file, "radar_RY");
			Radar[i][radar_RZ] = DOF2_GetFloat(file, "radar_RZ");
			atualizar_radar(i);
		}
	}
	printf("** %d radares carregadas.", cont);
}

stock salvar_radar(i)
{
    new file[60];
    format(file, 60, "Radares/Radar_%d.txt", i);
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
    if(Radar[i][radar_Existe] == 1)
    {
    	DOF2_CreateFile(file);
    	DOF2_SetInt(file, "radar_Velocidade", Radar[i][radar_Velocidade] );
		DOF2_SetInt(file, "radar_Ativado", Radar[i][radar_Ativado] );
		DOF2_SetInt(file, "radar_Valor", Radar[i][radar_Valor] );
		DOF2_SetFloat(file, "radar_X", Radar[i][radar_X] );
		DOF2_SetFloat(file, "radar_Y", Radar[i][radar_Y] );
		DOF2_SetFloat(file, "radar_Z", Radar[i][radar_Z] );
		DOF2_SetFloat(file, "radar_RX", Radar[i][radar_RX] );
		DOF2_SetFloat(file, "radar_RY", Radar[i][radar_RY] );
		DOF2_SetFloat(file, "radar_RZ", Radar[i][radar_RZ] );
    	DOF2_SaveFile();
    }
}
