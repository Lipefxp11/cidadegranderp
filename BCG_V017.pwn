stock criar_conta(const nick[], cidade, sexo, idade, skin=-1, const senha[]="nada123", id_forcado=-1)
{
	new start = 0;
	new limite = MAX_CONTAS;
	if(id_forcado >= 0 && id_forcado < MAX_CONTAS) start = id_forcado, limite = id_forcado + 1;
	for(new i = start; i < limite; i++)
	{
	    if(conta_existe[i] == 0)
	    {
	        new file[80];
	        format(file, 80, "Contas/%d.txt", i);
	        if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
	        DOF2_CreateFile(file);

	        DOF2_SetFloat(file, "c_X", 0.0);
	        DOF2_SetFloat(file, "c_Y", 0.0);
	        DOF2_SetFloat(file, "c_Z", 0.0);
	        DOF2_SetFloat(file, "c_A", 0.0);

	        DOF2_SetString(file, "c_Nick", nick);
	        DOF2_SetString(file, "c_Senha", senha);
	        DOF2_SetString(file, "c_HD", "NADA");
	        DOF2_SetString(file, "c_Pai", Nome(-1));
	        DOF2_SetString(file, "c_Mae", Nome(-1));

            DOF2_SetInt(file, "c_UltimoLogin", getdate());
