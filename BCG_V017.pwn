     		}
    	 	else
    	 	{
    			SSM(playerid, -1, "{FF0000}[SERVER]: Voce so pode Colocar 5 Cones no Maximo, Utilize: '/rcones'");
    	 	}
     	}
     	else
     	{
    		SSM(playerid, -1, "{FF0000}[SERVER]: Voce nao e um Policial");
     	}
        return 1;
    }
