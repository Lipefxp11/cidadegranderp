stock DarVida(playerid, vida)
{
	if(Online(playerid))
	{
		new c = id[playerid];
		if(c != -1)
		{
		    Conta[playerid][c_Vida] += vida;
		    if(Conta[playerid][c_Vida] > 100) Conta[playerid][c_Vida] = 100;
		    if(Conta[playerid][c_Vida] < 1 )
			{
				Conta[playerid][c_Vida] = 1;
				OnPlayerDeath2(playerid, INVALID_PLAYER_ID, -555);
			}
			SetPlayerHealth(playerid, Conta[playerid][c_Vida]);
		}
	}
}

