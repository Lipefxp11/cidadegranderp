stock mostrar_interiores(playerid)
{
	SG[0] = EOS;
	for(new i; i<sizeof interiores; i++)
	{
	    strcat(SG, "Interior ");
	    strcat(SG, ConvertMoney(i+1));
	    strcat(SG, "\n");
	}
	ShowPlayerDialog(playerid, DIALOG_INTERIORES, DIALOG_STYLE_LIST, "Interiores de casas", SG, "Setar", "Cancelar");
