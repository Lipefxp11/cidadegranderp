	if(!strcmp(cmd, "/criaremprego", true))
	{
		new nome[80], salario, nivel;
		if(sscanf(params, "dds[80]", salario, nivel, nome)) return ms(playerid, 2, "Use: /criaremprego [ Salario ] [ Nivel ] [ Nome ].");
		for(new i; i<MAX_EMPREGOS; i++)
		{
		    if(Emprego[i][e_Existe] == 0)
		    {
		        Emprego[i][e_Existe] = 1;
		        Emprego[i][e_Salario] = salario;
		        Emprego[i][e_Nivel] = nivel;
		        format(Emprego[i][e_Nome], 80, nome);
		        salvar_emprego(i);
		        new sss[150];
		        format(sss, 150, "Voce criou um novo emprego: %s [%d].", nome, i);
		        ms(playerid, 5, sss);
		        return 1;
		    }
		}

		ms(playerid, 0, "Numero maximo de empregos criados !");
		return 1;
	}
	if(!strcmp(cmd, "/eveh", true)){
		if(BikeAlugada[playerid] == 1)
        {
            BikeAlugada[playerid] = 0;
            DestroyVehicle(VeiculoCivil[playerid]);
            SSM(playerid, -1, "{E5EEFD}[Deletar Veiculos] Voce entregou sua bike alugada.");
        }
        return 1;
	}
	
	if(!strcmp(cmd, "/pmala", true))
	{
		new idds, Float:p1, Float:p2, Float:p3, m;
		if(logado[playerid] == 0) return 1;
		if(PlayerCop(playerid) || PlayerFac(playerid) || PlayerMafia(playerid) || PlayerTerrorista(playerid))
	    {
	 		if(sscanf(params, "i", idds))
	 		{
	 			return ms(playerid, 0, "Utilize: /pmala [ID da conta]");
	 		}
	 		m = ContaOnline(idds);
			GetPlayerPos(m, Float:p1, Float:p2, Float:p3);
			if(!ISP(playerid, 40.0, p1, p2, p3))
			{
				return  ms(playerid, 0, "Voce esta muito longe deste jogador.");
			}
			if(!IsPlayerInAnyVehicle(playerid))
			{
				return  ms(playerid, 0, "Voce nao esta em um veiculo.");
			}
			if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
			{
				return  ms(playerid, 0, "Voce nao esta dirigindo.");
			}
			else
			{
	            new carid = GetPlayerVehicleID(playerid);
				if(Colocado[m] == false)
				{
					Colocado[m] = true;
					new string[150];
					format(string,sizeof(string), "{FF0000}[INFORMACAO] {BEBEBE}Voce colocou o jogador ID[%d] No Porta Malas", idds);
					SSM(playerid, -1, string);

					SSM(playerid, -1, "{00FF00}[INFO] {BEBEBE}Guarde essa informacao, voce precisara para usar o /rmala");
					GameTextForPlayer(playerid, "Guarde a informacao do id para usar no /rmala", 3000, 4);

	                TogglePlayerSpectating(m, 1);
				    PlayerSpectatePlayer(m, playerid);
				    PlayerSpectateVehicle(m, carid);
	                GameTextForPlayer(m, "~w~Colocado No ~r~Porta Malas!", 3000, 3);

	               	format(string, sizeof(string), "* Policial ID:[%d] colocou o jogador ID:[%d] No Porta Malas.", id[playerid], idds);
					ProxDetector(20.0, playerid, string, -1,-1,-1,-1,-1);
				}
			}
		}
		else
		{
			ms(playerid, 0, "{FF0000}[SERVER]: Voce nao tem permissao");
		}
		return 1;
	}
	if(!strcmp(cmd, "/rmala", true))
	{
		new idds, String[220], m;
		if(logado[playerid] == 0) return 1;
		if(PlayerCop(playerid) || PlayerFac(playerid) || PlayerMafia(playerid) || PlayerTerrorista(playerid))
		{
			if(sscanf(params, "i", idds)) return ms(playerid, 0, "Utilize: /rmala [ID da conta]");
			{
				if(ContaInvalida(idds)) return ms(playerid, 0, "Conta informada, Nao existe !");
				m = ContaOnline(idds);
				if(logado[m] == 0) return 1;
	            if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
				{
					return ms(playerid, 0, "Voce nao esta dirigindo.");
				}
	            if(GetPlayerVehicleID(m) == GetPlayerVehicleID(playerid))
	            {
	                ms(playerid, 0, "Este Jogador nao esta em seu Veiculo!");
	            }
	            else
	            {
	            	new Float:XV, Float:YV, Float:ZV;
	                GetPlayerPos(playerid, XV, YV, ZV);
	                if(Colocado[m] == true)
					{
	                    Colocado[m] = false;
	                    TogglePlayerSpectating(m, 0);
						SetPlayerSpecialAction(m, SPECIAL_ACTION_NONE);
						JogadorCongelado[m] = 0;
						KillTimer(TimerFicarParado[m]);
						Controle(m, 1);
	                    GameTextForPlayer(m, "~w~Voce retirado(a) do ~r~Porta Malas", 3000, 6);
					format(String,sizeof(String),"{00FF00}[FUNCAO] {BEBEBE}Voce Ejetou o Player: %s de um Veiculo",Nome(m));
					SSM(playerid,-1,String);
	                    SetTimerEx("Mala_Check", 1000, 0, "ii", playerid, m);
	            	}
				}
			}
		}
		else
		{
		    ms(playerid, 0, "Voce nao esta autorizado a usar este comando");
		}
		return 1;
	}
