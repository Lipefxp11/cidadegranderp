stock abrir_skins_org(playerid, i)
{
    if(Org[i][o_Existe] == 1)
	{
        if(Online(playerid))
	    {
	        new cont;
			menu_id[playerid] = MENU_SKINS_ORG;
			format(nome_menu[playerid], 100, "Skins da [ %s ]", Org[i][o_Tag]);
			format(botao_menu[playerid], 100, "VESTIR SKIN");
			for(new a; a<10; a++)
			{
			    if(Org[i][o_Skins][a] != -1)
				{
				    Menu[playerid][cont][menu_ID] = 57;
				    Menu[playerid][cont][menu_Unidades] = 1;
				    Menu[playerid][cont][menu_Tipo] = Org[i][o_Skins][a];
				    Menu[playerid][cont][menu_Valor] = 500;
				    format(Menu[playerid][cont][menu_Nome], 200, "%d - Skin ID: %d", cont+1, Org[i][o_Skins][a]);
				    format(Menu[playerid][cont][menu_Info], 200, "%s", Org[i][o_Nome]);
				    Menu[playerid][cont][menu_Modelo] = Org[i][o_Skins][a];
				    cont ++;
			    }
			}
			max_menu[playerid] = cont;
			escolhendo_menu[playerid] = 0;
			if(cont > 0) mostrar_menu(playerid, menu_id[playerid]);
			else
			{
			    ms(playerid, 0, "A Organizacao nao tem Skins !");
				abrir_org(playerid, i);
			}
	    }
	}
}

