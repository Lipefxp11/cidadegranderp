new g_hostname_idx = 0;

forward alternar_hostname();
public alternar_hostname()
{
	new file[80], linha[256];
	g_hostname_idx = (g_hostname_idx % 5) + 1;
	format(file, 80, "hostname_%d.txt", g_hostname_idx);
	if(fexist(file))
	{
		new File:arq = fopen(file, io_read);
		if(arq)
		{
			fread(arq, linha, sizeof linha);
			fclose(arq);
			if(strlen(linha) > 2 && strfind(linha, "null", true) == -1) {
				new cmd[512];
				format(cmd, 512, "name %s", linha);
				SendRconCommand(cmd);
			}
		}
	}
}

forward atualizar_fake_online();
public atualizar_fake_online()
{
	new total;
	switch(HORA)
	{
		case 0..5:   total = 5 + random(6);
		case 6..9:   total = 10 + random(11);
		case 10..13: total = 20 + random(11);
		case 14..17: total = 30 + random(11);
		case 18..21: total = 40 + random(6);
		case 22..23: total = 15 + random(11);
	}
	FO_SetValue(total);
}



stock diminuir_inv(c, a)
{
	new playerid = ContaOnline(c);
	if(Online(playerid))
	{
	    Inventario[playerid][a][inv_Unidades] --;
	    if(Inventario[playerid][a][inv_Unidades] == 0)
	    {
	        Inventario[playerid][a][inv_ID] = 0;
		    Inventario[playerid][a][inv_Unidades] = 0;
		    Inventario[playerid][a][inv_Tipo] = 0;
		    Inventario[playerid][a][inv_Ativo] = 0;
		    Inventario[playerid][a][inv_Tempo] = 0;
		}
		salvar_inventario(c, a);
	}
}

stock add_inv(c, idd, unid, tipo=-555, ativo=0, tempo=0, co=0)
{
	new playerid = ContaOnline(c);
	if(Online(playerid))
	{
		if(idd < 0 || idd >= sizeof Itens) return 0;
		if(tipo == -555) tipo = Itens[idd][item_Tipo];
		new vazio = -1;
		for(new a; a<MAX_SLOTS; a++)
		{
		    if(Inventario[playerid][a][inv_ID] == 0 && vazio == -1) vazio = a;
		    if(co == 0)
		    {
		    	if(Itens[idd][item_Combinavel] == 1)
				{
					if(Inventario[playerid][a][inv_ID] == idd)
					{
					    if(Inventario[playerid][a][inv_Tipo] == tipo)
						{
						Inventario[playerid][a][inv_Unidades] += unid;
						if(idd >= 44 && idd <= 48 && Inventario[playerid][a][inv_Unidades] > 2000)
						    Inventario[playerid][a][inv_Unidades] = 2000;
						salvar_inventario(c, a);
						return 1;
					    }
				    }
				}
			}
		}
		if(vazio != -1)
		{
		    Inventario[playerid][vazio][inv_ID] = idd;
		    if(idd >= 44 && idd <= 48 && unid > 2000) unid = 2000;
		    Inventario[playerid][vazio][inv_Unidades] = unid;
		    Inventario[playerid][vazio][inv_Tipo] = tipo;
		    Inventario[playerid][vazio][inv_Ativo] = ativo;
		    Inventario[playerid][vazio][inv_Tempo] = tempo;
		    salvar_inventario(c, vazio);
		    return 1;
		}
	}
	return 0;
}

stock atualizar_jbl(a)
{
    if(IsValidDynamicObject(JBL[a][jbl_Obj])) DestroyDynamicObject_(JBL[a][jbl_Obj]);
    Iter_Remove(Iter_JBL, a);
	if(JBL[a][jbl_Existe] == 1)
	{
	    Iter_Add(Iter_JBL, a);
		JBL[a][jbl_Obj] = CreateDynamicObject( 2226, JBL[a][jbl_X], JBL[a][jbl_Y], JBL[a][jbl_Z], 0, 0, JBL[a][jbl_A], JBL[a][jbl_Mundo], JBL[a][jbl_Interior], -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD, -1, 0);
	}
	texto_jbl(a);
}

stock texto_jbl(a)
{
    if(IsValidDynamic3DTextLabel(JBL[a][jbl_3D])) DestroyDynamic3DTextLabel(JBL[a][jbl_3D]);
    JBL[a][jbl_3D] = DynamicText3D:-1;
    if(JBL[a][jbl_Existe] == 1)
	{
	    new sss[150];
	    if(JBL[a][jbl_Blu] == -1) format(sss, 150, "{ffffff}JBL de %s\n{FF0000}BLUETOOTH", NomeConta(JBL[a][jbl_Dono]));
		else if(JBL[a][jbl_Blu] == -2) format(sss, 150, "{ffffff}JBL de %s\n{4169E1}BLUETOOTH", NomeConta(JBL[a][jbl_Dono]));
		else
		{
			if(JBL[a][jbl_Link] == -1) format(sss, 150, "{ffffff}JBL de %s\n{ffffff}[ {00ffff}%s {ffffff}]\n{a1a1a1}Sem Musica", NomeConta(JBL[a][jbl_Dono]), NomeConta(JBL[a][jbl_Blu]));
			else if(JBL[a][jbl_Link] > -1) format(sss, 150, "{ffffff}JBL de %s\n{ffffff}[ {00ffff}%s {ffffff}]\n{a1a1a1}%s", NomeConta(JBL[a][jbl_Dono]), NomeConta(JBL[a][jbl_Blu]), Estacoes[JBL[a][jbl_Link]][0]);
            else format(sss, 150, "{ffffff}JBL de %s\n{ffffff}[ {00ffff}%s {ffffff}]\n{a1a1a1}%s", NomeConta(JBL[a][jbl_Dono]), NomeConta(JBL[a][jbl_Blu]), "Streamer");
		}
		JBL[a][jbl_3D] = CreateDynamic3DTextLabel( sss, 0xffffff99, JBL[a][jbl_X], JBL[a][jbl_Y], JBL[a][jbl_Z], 7, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0,  JBL[a][jbl_Mundo], JBL[a][jbl_Interior], -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
	}
}

stock criar_jbl(Float:xxx, Float:yyy, Float:zzz, Float:aaa, inte, mund, dono)
{
	for(new a; a<MAX_JBL; a++)
	{
		if(JBL[a][jbl_Existe] == 0)
		{
		    JBL[a][jbl_Existe] = 1;
		    JBL[a][jbl_X] = xxx;
		    JBL[a][jbl_Y] = yyy;
		    JBL[a][jbl_Z] = zzz;
		    JBL[a][jbl_A] = aaa;
		    JBL[a][jbl_Mundo] = mund;
		    JBL[a][jbl_Interior] = inte;
		    JBL[a][jbl_Dono] = dono;
		    JBL[a][jbl_Blu] = -1;
		    JBL[a][jbl_Link] = -1;
		    atualizar_jbl(a);
		    return a;
		}
	}
	return -1;
}

stock abrir_jbl(playerid, a)
{
	new c = id[playerid];
	if(c != -1)
	{
	    SetPVarInt(playerid, "jbl", a);
	    if(JBL[a][jbl_Existe] == 1)
	    {
	        if(JBL[a][jbl_Dono] == c)
	        {
	            if(JBL[a][jbl_Blu] == -1) ShowPlayerDialog(playerid, DIALOG_JBL, DIALOG_STYLE_LIST, "JBL", "{00ffff}Ligar Bluetooth\n{ffff00}Guardar", "Continuar", "Fechar");
	            else if(JBL[a][jbl_Blu] == -2)ShowPlayerDialog(playerid, DIALOG_JBL, DIALOG_STYLE_LIST, "JBL", "{ffff00}Desligar Bluetooth\n{ffff00}Guardar", "Continuar", "Fechar");
	            else ShowPlayerDialog(playerid, DIALOG_JBL, DIALOG_STYLE_LIST, "JBL", "{a1a1a1}Desconectar\n{ffff00}Guardar", "Continuar", "Fechar");
	        }
	        else ms(playerid, 0, "Voce nao e o dono desta jbl !");
	    }
	}
}

stock player_jbl(playerid)
{
    foreach(new a:Iter_JBL)
	{
		if(JBL[a][jbl_Existe] == 1)
		{
		    if(JBL[a][jbl_Dono] == id[playerid])
	        {
	            return a;
	        }
		}
	}
	return -1;
}

stock conectar_veiculo(v, playerid)
{
	new c = id[playerid];
	if(c == -1) return 0;
    if(GetVehicleModel(v) != 0)
	{
		if(Blutuf_Veiculo[v] == -2)
		{
		    Blutuf_Veiculo[v] = c;
		    Blutuf_Veiculo_Link[v] = -1;
		    Blutuf_ID[playerid] = v;
			Blutuf_Tipo[playerid] = 0;
			new Float:p[3];
			GetPlayerPos(playerid, p[0], p[1], p[2]);
			Play_Som(1139, p[0], p[1], p[2], GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid));
		    return 1;
		}
	}
	return 0;
}

stock desconectar_veiculo(v)
{
	if(Info_Veiculo[v] != -1)
	{
		new idd = Blutuf_Veiculo[v];
		if(idd > -1)
		{
			new pla = ContaOnline(idd);
			if(Online(pla))
			{
				Blutuf_Tipo[pla] = -1;
				Blutuf_ID[pla] = -1;
			}
		}
		Blutuf_Veiculo[v] = -2;
		Blutuf_Veiculo_Link[v] = -1;
		atualizar_ouvinte(0, v, -1);
	}
}

stock conectar_jbl(a, playerid)
{
	new c = id[playerid];
	if(c == -1) return 0;
    if(JBL[a][jbl_Existe] == 1)
	{
		if(JBL[a][jbl_Blu] == -2)
		{
		    JBL[a][jbl_Blu] = c;
		    JBL[a][jbl_Link] = -1;
		    Blutuf_ID[playerid] = a;
			Blutuf_Tipo[playerid] = 1;
			new Float:p[3];
			GetPlayerPos(playerid, p[0], p[1], p[2]);
			Play_Som(1139, p[0], p[1], p[2], GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid));
			texto_jbl(a);
		    return 1;
		}
	}
	return 0;
}

stock desconectar_jbl(a)
{
    if(JBL[a][jbl_Existe] == 1)
    {
		new c = JBL[a][jbl_Blu];
		if(c > -1)
		{
			new idd = ContaOnline(c);
			if(Online(idd))
			{
			    Blutuf_ID[idd] = -1;
				Blutuf_Tipo[idd] = -1;
			    JBL[a][jbl_Blu] = -2;
			    texto_jbl(a);
			}
		}
	}
	atualizar_ouvinte(1, a, -1);
	JBL[a][jbl_Blu] = -1;
	JBL[a][jbl_Link] = -1;
}

stock aparelhos_proximos(playerid)
{
	new c = id[playerid];
	if(c != -1)
	{
        new cont;
        zerar_lista(playerid, 1);
		foreach(new a:Iter_JBL)
		{
		    if(cont >= MAX_LISTA) break;
			if(JBL[a][jbl_Existe] == 1)
			{
			    if(JBL[a][jbl_Blu] == -2)
				{
				    if(IsPlayerInRangeOfPoint(playerid, 20, JBL[a][jbl_X], JBL[a][jbl_Y], JBL[a][jbl_Z]))
					{
						Lista2[playerid][cont] = 1;
	        			Lista[playerid][cont] = a;
					    format(Lista_DC[playerid][cont][cel_Nome], 100, "JBL - %s", NomeConta(JBL[a][jbl_Dono]));
	                    Lista_DC[playerid][cont][cel_ID] = a;
	                    cont++;
					}
				}
			}
		}
		new Float:p[3];
		foreach(new v:Vehicles)
		{
		    if(cont >= MAX_LISTA) break;
		    if(GetVehicleModel(v) != 0)
		    {
		        if(Blutuf_Veiculo[v] == -2)
		        {
					GetVehiclePos(v, p[0], p[1], p[2]);
		            if(IsPlayerInRangeOfPoint(playerid, alcance_blu_veiculo(v), p[0], p[1], p[2]))
			      	{
                        Lista2[playerid][cont] = 0;
	        			Lista[playerid][cont] = v;
					    format(Lista_DC[playerid][cont][cel_Nome], 100, "Veiculo - %s", NomeVeiculo(GetVehicleModel(v)));
	                    Lista_DC[playerid][cont][cel_ID] = v;
	                    cont++;
		            }
		        }
		    }
		}

        if(cont != 0) Item_DC[playerid] = 0;
		else Item_DC[playerid] = -1;
		format(Titulo_DC[playerid], 100, "DISPOSITIVOS PROXIMOS");
		MAX_DC[playerid] = cont;
		ID_DC[playerid] = DISPOSITIVOS_PROXIMOS;
		Pagina_DC[playerid] = 0;
		celular(playerid, C_LISTA);
	}
}

stock desconectar_blu(playerid)
{
	if(Online(playerid))
	{
		// veiculo //
		if(Blutuf_Tipo[playerid] == 0)
		{
		    new v = Blutuf_ID[playerid];
		    desconectar_veiculo(v);
		    if(celular_aberto[playerid] == C_BLU_APK) celular(playerid, C_BLU_APK);
		}
		// jbl //
		if(Blutuf_Tipo[playerid] == 1)
		{
		    new a = Blutuf_ID[playerid];
		    desconectar_jbl(a);
		    if(celular_aberto[playerid] == C_BLU_APK) celular(playerid, C_BLU_APK);
		}
		Status_Radio[playerid] = 0;
	}
}

stock atualizar_ouvinte(tipo, i, opc, link_som[]="invalido")
{
	foreach(new p:Player)
	{
	    if(Online(p))
	    {
			if(player_ouvindo[p] == tipo)
			{
			    if(player_ouvindo_id[p] == i)
				{
					if(opc == -1)
				{
				    player_ouvindo[p] = -1;
				    player_ouvindo_id[p] = -1;
				    StopAudioStreamForPlayer(p);
				}
				else
				{
				    if(opc > 0) PlayAudioStreamForPlayer(p, Estacoes[opc][1]);
				    else PlayAudioStreamForPlayer(p, link_som);
				}
			    }
			}
		}
	}
}

stock pode_jbl(playerid, con=-1)
{
	foreach(new a:Iter_JBL)
	{
	    if(JBL[a][jbl_Existe] == 1)
	    {
	        if(a != con)
	        {
		        if(IsPlayerInRangeOfPoint(playerid, 50, JBL[a][jbl_X], JBL[a][jbl_Y], JBL[a][jbl_Z]))
		        {
		            if(GetPlayerInterior(playerid) == JBL[a][jbl_Interior] && GetPlayerVirtualWorld_(playerid) == JBL[a][jbl_Mundo])
		            {
		                return 0;
		            }
		        }
	        }
	    }
	}

	new Float:p[3];
	foreach(new v:Vehicles)
	{
	    if(GetVehicleModel(v) != 0)
	    {
	        if(v != con)
	        {
		        if(Blutuf_Veiculo[v] != -1)
		        {
					GetVehiclePos(v, p[0], p[1], p[2]);
					if(IsPlayerInRangeOfPoint(playerid, 50, p[0], p[1], p[2]))
					{
					    return 0;
					}
		        }
	        }
	    }
	}

	return 1;
}

stock items_conta(c)
{
	new playerid = ContaOnline(c);
	new cont;
	if(Online(playerid))
	{
		for(new a; a<MAX_SLOTS; a++)
		{
		    if(Inventario[playerid][a][inv_ID] != 0)
		    {
		        cont++;
		    }
		}
	}
	return cont;
}

stock inv_usar(playerid, conta, slot)
{
	if(Online(playerid) && conta != -1)
	{
	    if(slot > -1)
	    {
	        new retornar;
		    new idd = Inventario[playerid][slot][inv_ID];
			new tipo = Inventario[playerid][slot][inv_Tipo];
			new sss[300];

			// verificar se venceu //
			if(Inventario[playerid][slot][inv_Ativo] == 1 && Inventario[playerid][slot][inv_Tempo] != 0)
            {
                if(Inventario[playerid][slot][inv_Tempo] <= gettime())
                {
                    format(sss, 300, "O Item '%s' foi excluido do seu inventario, por vencimento !", NomeItem(idd, tipo));
					ms(playerid, 2, sss);
					limpar_slot(playerid, slot);
					fechar_caixinha(playerid);
					retornar = 1;
				}
            }

            if(retornar == 0)
            {

				///////////   caixa misteriosa   /////////////
				if(idd == 89)
				{
				    if(id[playerid] != -1)
					{
					SetPVarInt(playerid, "slot", slot);
                        ShowPlayerDialog(playerid, DIALOG_CAIXA_MISTERIOSA, DIALOG_STYLE_MSGBOX, "{000000}_", texto_caixa_misteriosa, "Abrir", "Cancelar");
				    }
				}


				///////////   portao eletrico   /////////////
				if(idd == 88)
				{
				    if(id[playerid] != -1)
					{
					    if(PodeColocarPortao(playerid))
						{
						new Float:p[4];
							GetPlayerFacingAngle(playerid, p[3]);
						GetPlayerPos(playerid, p[0], p[1], p[2]);
						PegarFrentePlayer(playerid, p[0], p[1], 2);
						new a = CriarPortao(p[0], p[1], p[2], 0, 0, p[3], tipo, id[playerid]);
					    	if(a == -1) ms(playerid, 0, "Numero maximo de portoes no servidor atingido !");
					    	else
					    	{
					    	    if(Inventario[playerid][slot][inv_Tempo] != 0)
					    	    {
					    	        if(Inventario[playerid][slot][inv_Ativo] == 0)
					    	        {
					    	            Inventario[playerid][slot][inv_Ativo] = 1;
					    	            Inventario[playerid][slot][inv_Tempo] += gettime();

					    	        }
					    	    }
					    	    Portao[a][p_Tempo] = Inventario[playerid][slot][inv_Tempo];
					    	    limpar_slot(playerid, slot);
					    	    salvar_portao(a);
					    	    fechar_inv_novo(playerid);
					    	    ms(playerid, 1, "Voce usou um portao do inventario, voce pode ver seus portoes usando /portoes.");
					    	    ms(playerid, 1, "Movimente o portao usando o editor de objeto e salve a posicao dele fechado.");
					    	    Streamer_Update(playerid);
								EditandoPortao[playerid] = a;
								SetPVarInt(playerid, "editando_portao", 0);
								EditDynamicObject2(playerid, Portao[a][p_Obj]);
					    	}
						}
					}
				}

				///////////   celular digital   /////////////
				if(idd == 87)
				{
				    fechar_inv_novo(playerid);
				    SetTimerEx("abrir_agora", 350, false, "dd", playerid, 0);
				}

				///////////   radio comunicador   /////////////
				if(idd == 86)
				{
				    fechar_inv_novo(playerid);
				    SetTimerEx("abrir_agora", 350, false, "dd", playerid, 3);
				}

				///////////   lookpick   /////////////
				if(idd == 85)
				{
					{
					new car = -1;
						foreach(new a:Vehicles)
						{
					    if(GetVehicleModel(a) != 0)
						{
					        new i = Info_Veiculo[a];
					        if(i != -1)
							{
							    new Float:p[3];
									GetVehiclePos(a, p[0], p[1], p[2]);
									if(IsPlayerInRangeOfPoint(playerid, 1.7, p[0], p[1], p[2]))
									{
									    if(GetPlayerVirtualWorld_(playerid) == GetVehicleVirtualWorld(a))
										{
										car = a;
										if(Travado(a))
										{
											if(Veiculo[i][v_Dono] != -1)
											{
											    if(Veiculo[i][v_Dono] != id[playerid])
												{
											        fechar_inv_novo(playerid);
											        diminuir_inv(conta, slot);
														iniciar_lockpick(playerid, 0, a);
														ms(playerid, 2, "Acerte pelomenos 4 tentativas para conseguir destrancar o veiculo !");
									            }
									            else ms(playerid, 0, "Voce nao pode arrombar seu proprio veiculo !");
											}
											else ms(playerid, 0, "Voce so pode destrancar veiculos pessoais !");
										}
										else ms(playerid, 0, "Este veiculo nao esta trancado, nao e possivel arrombar !");
									    }
									}
							}
					    }
					}
					if(car == -1) ms(playerid, 0, "Voce nao esta proximo a um veiculo pessoal !");
				}
				}

				///////////   squeiro   /////////////
				if(idd == 84)
				{
				    MS(playerid, 0, "Este item nao e usado diretamente do Inventario !");
				}

				///////////   cigarro   /////////////
				if(idd == 83)
				{
				    if(tem_item(playerid, 84) != -1)
					{
					if(fumando[playerid] == 0)
					{
					    fumando[playerid] = 1;
					    fechar_inv_novo(playerid);
						diminuir_inv(conta, slot);
						format(string_prox, 300, "** '%s' acendeu um cigarro **", Nome(playerid));
							ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
							ms(playerid, 2, "Use a tecla ALT para dar um trago, use F ou ENTER para jogar o cigarro fora.");
	                        ApplyAnimation(playerid, "SMOKING", "M_SMK_IN", 4.1, false, false, false, false, 0, 1);
	                        fumar(playerid);
					}
					else ms(playerid, 0, "Voce ja esta fumando !");
				    }
				    else ms(playerid, 0, "Voce nao tem um Isqueiro, compre um em um mercado 24/7 !");
				}

				///////////   fertiizante   /////////////
				if(idd == 82)
				{
					{
					    new taa;
				    foreach(new m:Iter_Maconhas)
					{
				        if(Maconha[m][mac_Existe] == 1)
				        {
				            if(IsPlayerInRangeOfPoint(playerid, 2, Maconha[m][mac_X], Maconha[m][mac_Y], Maconha[m][mac_Z]))
				            {
				                taa = 1;
				                if(Maconha[m][mac_Fertilizante] == 0)
				                {
				                    SetPVarInt(playerid, "slot", slot);
				                    SetPVarInt(playerid, "mac", m);
		                   				fechar_inv_novo(playerid);
		                   				if(Barra[playerid][b_Acao] == 0)
										{
										    SetPlayerToFacePos(playerid, Maconha[m][mac_X], Maconha[m][mac_Y]);
											Acao(playerid, 22, 150, "COLOCANDO FERTILIZANTE", 1, "BD_FIRE", "WASH_UP", true);
											SetPlayerAttachedObject(playerid, 9, 19565, 5, 0.085999, 0.289999, 0.043000, 93.500106, 5.699995, 89.100006, 1.000000, 1.000000, 1.000000);
										}
				                }
				                else ms(playerid, 0, "Este pe de maconha ja esta com fertilizante !");
				                break;
				            }
				        }
				    }
				    if(taa == 0) ms(playerid, 0, "Use este item em alguma plantacao para acelerar seu crecimento !");
		            }
				}

				///////////   corda   /////////////
				if(idd == 81)
				{
					{
					    if(PlayerFac(playerid) || PlayerMafia(playerid) || PlayerTerrorista(playerid))
						{
		                	comando(playerid, "/amarrar", "");
		                	fechar_inv_novo(playerid);
		                }
		                else ms(playerid, 0, "Apenas Criminosos podem usar este item !");
	                }
				}

				///////////   pacote de maconha   /////////////
				if(idd == 80)
				{
				    fechar_inv_novo(playerid);
				    segurar(playerid, 11, Inventario[playerid][slot][inv_Unidades], Inventario[playerid][slot][inv_Tipo]);
				    Inventario[playerid][slot][inv_ID] = 0;
				    Inventario[playerid][slot][inv_Unidades] = 0;
				    Inventario[playerid][slot][inv_Tipo] = 0;
				    salvar_inventario(conta, slot);
				}

				///////////   semente de maconha   /////////////
				if(idd == 79)
				{
					{
					    if(IsPlayerInAnyVehicle(playerid))
						{
						ms(playerid, 0, "Voce nao pode usar este item dentro de um veiculo !");
					    }
					    else if(maconha_perto(playerid) != -1)
						{
							ms(playerid, 0, "Ja tem um Pe de Maconha muito proximo a este local !");
						}
						else if(maconhas_player(playerid) >= MAX_MACONHA_PLAYER)
						{
							ms(playerid, 0, "Voce ja tem o maximo de pes de maconha plantados !");
					    }
					    else if(GetPlayerVirtualWorld_(playerid) != 0 || GetPlayerInterior(playerid) != 0)
						{
					    	ms(playerid, 0, "Voce Voce nao pode plantar maconha em interiores !");
					    }
					    else
						{
						SetPVarInt(playerid, "slot", slot);
							fechar_inv_novo(playerid);
							format(string_prox, 300, "** O jogador '%s' esta plantando Maconha **", Nome(playerid));
							ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
							Acao(playerid, 15, 150, "PLANTANDO SEMENTE", 1, "COP_AMBIENT",  "COPBROWSE_LOOP", true);
							SetPlayerAttachedObject(playerid, 9, 2039, 5, 0.103000, 0.056999, -0.008999, 4.099993, 92.200004, 9.199993, 1.000000, 1.000000, 1.000000);
					    }
				    }
				}

				///////////   jbl   /////////////
				if(idd == 78)
				{
				    if(IsPlayerInAnyVehicle(playerid))
					{
					ms(playerid, 0, "Voce nao pode usar este item dentro de um veiculo !");
				    }
				    else if(player_jbl(playerid) != -1)
					{
					ms(playerid, 0, "Voce ja colocou uma JBL, nao pode colocar outra !");
				    }
					else
					{
					    new Float:p[4];
					    GetPlayerPos(playerid, p[0], p[1], p[2]);
					    GetPlayerFacingAngle(playerid, p[3]);
					    PegarFrentePlayer(playerid, p[0], p[1], 0.5);
					    p[2] -= 0.9;
					    if(!pode_jbl(playerid))
						{
							ms(playerid, 0, "Ja tem um dispositivo conectado muito proximo desse local !");
						}
					    else
						{
							new a = criar_jbl(p[0], p[1], p[2], p[3], GetPlayerInterior(playerid), GetPlayerVirtualWorld_(playerid), conta);
						    if(a != -1)
							{
							    fechar_inv_novo(playerid);
								diminuir_inv(conta, slot);
								format(string_prox, 300, "** '%s' colocou sua JBL no local **", Nome(playerid));
								ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
							    ms(playerid, 1, "Use a tecla F proximo a sua JBL para guardar ou ligar o bluetooth.");
							    ApplyAnimation(playerid,"BOMBER", "BOM_PLANT_IN", 4.1, false, false, false, false, 0, 1);
							}
							else
							{
							ms(playerid, 0, "Numero maximo de JBLs do servidor atingido, tente mais tarde !");
				    		}
						}
					}
				}


	///////////   bag ifood   /////////////
					if(idd == 92)
					{
					    if(IsPlayerInAnyVehicle(playerid))
					        return ms(playerid, 0, "Voce nao pode usar este item dentro de um veiculo!");
					    new pode;
					    for(new w; w<MAX_ACESSORIOS; w++)
					    {
					        if(Acessorios[playerid][w][ac_Existe] == 0)
					        {
					            pode = 1;
					            if(PodeColocarAcessorios(playerid))
					            {
					                Acessorios[playerid][w][ac_Existe] = 1;
					                Acessorios[playerid][w][ac_Local] = 1;
					                Acessorios[playerid][w][ac_Usando] = 1;
					                Acessorios[playerid][w][ac_X] = 0.0;
					                Acessorios[playerid][w][ac_Y] = 0.0;
					                Acessorios[playerid][w][ac_Z] = 0.5;
					                Acessorios[playerid][w][ac_RX] = 0.0;
					                Acessorios[playerid][w][ac_RY] = 0.0;
					                Acessorios[playerid][w][ac_RZ] = 0.0;
					                Acessorios[playerid][w][ac_TX] = 1.5;
					                Acessorios[playerid][w][ac_TY] = 1.5;
					                Acessorios[playerid][w][ac_TZ] = 1.5;
					                Acessorios[playerid][w][ac_ID] = 217;
					                Acessorios[playerid][w][ac_Tempo] = 0;
					                Inventario[playerid][slot][inv_ID] = 0;
					                Inventario[playerid][slot][inv_Unidades] = 0;
					                Inventario[playerid][slot][inv_Tipo] = 0;
					                Inventario[playerid][slot][inv_Ativo] = 0;
					                Inventario[playerid][slot][inv_Tempo] = 0;
					                fechar_inv_novo(playerid);
					                acessorios_player(playerid);
					                salvar_inventario(conta, slot);
					                salvar_acessorios(playerid, conta);
					                SetPVarInt(playerid, "id_ace", w);
					                parte_do_corpo(playerid);
					            }
					            break;
					        }
					    }
					    if(!pode) ms(playerid, 0, "Voce ja esta usando o maximo de /acessorios permitidos!");
					    return 1;
					}

	///////////   chip   /////////////
					if(idd == 77)
				{
				    if(tem_item(playerid, 87) == -1) MS(playerid, 0, "Voce nao possue um aparelho Celular, compre um em uma loja de eletronicos !");
				    else
					{
					    if(player_chip(playerid) != -1)
						{
							ms(playerid, 0,  "Voce ja tem um Numero em seu CPF, pode ve-lo pelo o apk do whatsapp pelo celular.");
						}
					    else
						{
						if(PlayerCPF(playerid) != 0)
						{
						    if(criar_chip(playerid, tipo))
							{
									Inventario[playerid][slot][inv_ID] = 0;
								    Inventario[playerid][slot][inv_Unidades] = 0;
								    Inventario[playerid][slot][inv_Tipo] = 0;
								    abrir_inv_novo(playerid);
								    salvar_inventario(conta, slot);
							    }
							}
							else ms(playerid, 0, "Voce ainda nao tem seu CPF, para cadastrar um numero isso deve ser feito antes !");
					    }
				    }
				}

				///////////   dinheiro sujo   /////////////
				if(idd == 76)
				{
					ms(playerid, 0, "Este item so pode ser usado no mercado negro, ou com algum mafioso !");
				}

				///////////   explosivo c4   /////////////
				if(idd == 75)
				{
					{
					    if(IsPlayerInAnyVehicle(playerid))
						{
						ms(playerid, 0, "Voce nao pode usar este item dentro de um veiculo !");
					    }
					    else if(ModoAdmin[playerid] == 0)
						{
						    if(Conta[playerid][c_C4] == payday_server)
							{
								ms(playerid, 0, "Voce so pode usar um C4 a cada PayDay !");
							}
						    else if(cops_on() < 1)
							{
								ms(playerid, 0, "Nao ha policias no servidor no momento, tente mais tarde");
							}
						    else
							{
								fechar_inv_novo(playerid);
								usar_explosivo(playerid, slot);
							}
					    }
						else
						{
							fechar_inv_novo(playerid);
							usar_explosivo(playerid, slot);
						}
					}
				}

				///////////   contrato hospitalar   /////////////
				if(idd == 74)
				{
					ms(playerid, 0, "Este item e usado em um Hospital, para tratar sua vida no local designado !");
				}

				///////////   KIT MEDICO   /////////////
				if(idd == 52)
				{
				    if(IsPlayerInAnyVehicle(playerid))
					{
					ms(playerid, 0, "Voce nao pode usar este item dentro de um veiculo !");
				    }
				    else if(EmCombate(playerid))
					{
					    ms(playerid, 0, "Voce nao pode usar este item em combate !");
					}
				    else
					{
						SetPVarInt(playerid, "slot", slot);
						fechar_inv_novo(playerid);
						format(string_prox, 300, "** O jogador '%s' esta usando um Kit Medico **", Nome(playerid));
						ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
						Acao(playerid, 8, 150, "USANDO KIT MEDICO", 1, "COP_AMBIENT",  "COPBROWSE_LOOP", true);
						SetPlayerAttachedObject(playerid, 9, 11738, 6,0.103999, 0.221000, -0.040999, -102.099975, -175.699996, 96.599990, 1.000000, 1.000000, 1.000000);
				    }
				}

				///////////   DROGAS   /////////////
				if(idd == 91)
				{
					if(IsPlayerInAnyVehicle(playerid))
					{
					ms(playerid, 0, "Voce nao pode usar este item dentro de um veiculo !");
				    }
				    else if(EmCombate(playerid))
					{
					    ms(playerid, 0, "Voce nao pode fumar em combate !");
					}
				    else
					{
					SetPVarInt(playerid, "slot", slot);
						format(string_prox, 300, "** O jogador '%s' esta gerando uma coca prontinha e fresca **", Nome(playerid));
						ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
						Acao(playerid, 28, 150, "FAZENDO A COCA", 1, "CRACK",  "crckdeth2", true);
						fechar_inv_novo(playerid);
				    }
				}

				///////////   COLETE   /////////////
				if(idd == 73)
				{
					if(EmCombate(playerid))
					{
					    ms(playerid, 0, "Voce nao pode usar este item em combate !");
					}
				    else
					{
					new teem;
						new col = Inventario[playerid][slot][inv_Tipo];
						if(Conta[playerid][c_Colete] > 0)
						{
							teem = 1;
							Inventario[playerid][slot][inv_Tipo] = Conta[playerid][c_Colete];
						}
						else limpar_slot(playerid, slot);
						SetarColete(playerid, col);
					format(string_prox, 300, "** '%s' usou um colete a prova de balas **", Nome(playerid));
						ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
						salvar_inventario(conta, slot);
						fechar_caixinha(playerid);
						if(teem == 1)
						{
							ms(playerid, 2, "Seu colete que estava equipado foi quardado em seu inventario");
		    			}
				    }
				}


			    //   JETPACK    //
				if(idd == 70)
				{
				    if(IsPlayerInAnyVehicle(playerid))
					{
					ms(playerid, 0, "Voce nao pode usar este item dentro de um veiculo !");
				    }
				    else
					{
					if(Inventario[playerid][slot][inv_Tempo] != 0)
			    	    {
			    	        if(Inventario[playerid][slot][inv_Ativo] == 0)
			    	        {
			    	            Inventario[playerid][slot][inv_Ativo] = 1;
			    	            Inventario[playerid][slot][inv_Tempo] += gettime();
								salvar_inventario(conta, slot);
			    	        }
			    	    }
					    fechar_inv_novo(playerid);
						format(string_prox, 300, "** '%s' pegou seu JetPack **", Nome(playerid));
						ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
						SetPlayerSpecialAction(playerid, 2);
						MS(playerid, 2, "Aperte F para guardar seu JetPack.");
					}
				}

			// comida //
			if(tipo == -999)
			{
				DarVida(playerid, 2);
				Conta[playerid][c_Fome] += diminuir_lanche(idd);
				if(Conta[playerid][c_Fome] > 100) Conta[playerid][c_Fome] = 100;
				atualizar_fome(playerid);
				format(string_prox, 300, "** '%s' comeu %d %s **", Nome(playerid), 1, Itens[idd][item_Nome]);
				ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
				diminuir_inv(conta, slot);
				fechar_caixinha(playerid);
			}

			// bebida //
			if(tipo == -888)
			{
				DarVida(playerid, 2);
			    Conta[playerid][c_Sede] += diminuir_lanche(idd);
			    if(Conta[playerid][c_Sede] > 100) Conta[playerid][c_Sede] = 100;
			    atualizar_sede(playerid);
				format(string_prox, 300, "** '%s' bebeu %d %s **", Nome(playerid), 1, Itens[idd][item_Nome]);
				ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
				diminuir_inv(conta, slot);
				fechar_caixinha(playerid);
			}

			//   SKINS    //
			if(idd == 57)
				{
					new skinx = Inventario[playerid][slot][inv_Tipo];
				    Inventario[playerid][slot][inv_Tipo] = Conta[playerid][c_Skin];
				SetarSkin(conta, skinx);
				format(string_prox, 300, "** '%s' trocou de roupa **", Nome(playerid));
					ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
					salvar_inventario(conta, slot);
					fechar_caixinha(playerid);
				}

			//   VEICULO DE INVENTARIO   //
			if(idd == 56)
			{
					if(GetVehicleModel(RC[playerid]) != 0)
					{
					    Veiculo_RC[RC[playerid]] = -1;
					    DestroyVehicle_(RC[playerid]);
					    RC[playerid] = -1;
					}
					if(GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld_(playerid) != 0)
					{
					    ms(playerid, 0, "Voce nao pode usar esse veiculo em interiores !");
					}
					else
					{
					    if(Inventario[playerid][slot][inv_Tempo] != 0)
						{
						if(Inventario[playerid][slot][inv_Ativo] == 0)
						{
						    Inventario[playerid][slot][inv_Ativo] = 1;
						    Inventario[playerid][slot][inv_Tempo] += gettime();
						    salvar_inventario(conta, slot);
						}
					    }

						flood_rc[playerid] = gettime()+2;
						new Float:pos[4];
						GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
						GetPlayerFacingAngle(playerid, pos[3]);
						RC[playerid] = CreateVehicle_(Inventario[playerid][slot][inv_Tipo], pos[0], pos[1], pos[2], pos[3], 0, 0, -1, 0);
						Veiculo_RC[RC[playerid]] = playerid;
						Info_Veiculo[RC[playerid]] = -1;
						fechar_inv_novo(playerid);
						SetVehicleParamsEx_(RC[playerid], 1, 1, 0, 0, 0, 0, 0);
						PutPlayerInVehicle(playerid, RC[playerid], 0);
						MS(playerid, 2, "Voce pegou seu veiculo de Inventario, Use F ou ENTER para guarda-lo.");
						format(string_prox, 300, "** '%s' pegou seu '%s' de inventario **", Nome(playerid), NomeVeiculo(Inventario[playerid][slot][inv_Tipo]));
						ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
				    }
				}

				//   Acessorios   //
				if(idd == 55)
				{
					if(tipo > -1 && tipo < sizeof Acessorios_Info)
					{

					    if(IsPlayerInAnyVehicle(playerid))
						{
						ms(playerid, 0, "Voce nao pode usar este item dentro de um veiculo !");
					    }
					    else
						{
						new pode;
							for(new w; w<MAX_ACESSORIOS; w++)
							{
							    if(Acessorios[playerid][w][ac_Existe] == 0)
								{
								pode = 1;
								if(PodeColocarAcessorios(playerid))
								{
								    if(Inventario[playerid][slot][inv_Tempo] != 0)
									{
								        if(Inventario[playerid][slot][inv_Ativo] == 0)
								        {
								            Inventario[playerid][slot][inv_Tempo] += gettime();
								        }
								    }
								    Acessorios[playerid][w][ac_Existe] = 1;
								    Acessorios[playerid][w][ac_Local] = 1;
								    Acessorios[playerid][w][ac_Usando] = 1;
								    Acessorios[playerid][w][ac_X] = 0;
								    Acessorios[playerid][w][ac_Y] = 0;
								    Acessorios[playerid][w][ac_Z] = 0;
								    Acessorios[playerid][w][ac_RX] = 0;
								    Acessorios[playerid][w][ac_RY] = 0;
								    Acessorios[playerid][w][ac_RZ] = 0;
								    Acessorios[playerid][w][ac_TX] = 1;
								    Acessorios[playerid][w][ac_TY] = 1;
								    Acessorios[playerid][w][ac_TZ] = 1;
								    Acessorios[playerid][w][ac_ID] = tipo;
								    Acessorios[playerid][w][ac_Tempo] = Inventario[playerid][slot][inv_Tempo];
								    Inventario[playerid][slot][inv_ID] = 0;
								    Inventario[playerid][slot][inv_Unidades] = 0;
								    Inventario[playerid][slot][inv_Tipo] = 0;
									Inventario[playerid][slot][inv_Ativo] = 0;
									Inventario[playerid][slot][inv_Tempo] = 0;
									fechar_inv_novo(playerid);
									acessorios_player(playerid);
									salvar_inventario(conta, slot);
									salvar_acessorios(playerid, conta);
									SetPVarInt(playerid, "id_ace", w);
									parte_do_corpo(playerid);
									}
									break;
							    }
							}
							if(pode == 0)
							{
							    ms(playerid, 0, "Voce ja esta usando o maximo de /acessocios permitidos !");
							}
						}
					}
				}

				/////////// galao de gasolina cheio /////////////
				if(idd == 51)
				{
				    if(IsPlayerInAnyVehicle(playerid))
					{
					ms(playerid, 0, "Voce nao pode usar este item dentro de um veiculo !");
				    }
				    else
					{
					if(tipo == 3)
					{
					    new taa;
					    foreach(new m:Iter_Maconhas)
						{
					        if(Maconha[m][mac_Existe] == 1)
					        {
					            if(IsPlayerInRangeOfPoint(playerid, 2, Maconha[m][mac_X], Maconha[m][mac_Y], Maconha[m][mac_Z]))
					            {
					                taa = 1;
					                if(Maconha[m][mac_Agua] < 98)
					                {
					                    SetPVarInt(playerid, "slot", slot);
					                    SetPVarInt(playerid, "mac", m);
				           				fechar_inv_novo(playerid);
				           				if(Barra[playerid][b_Acao] == 0)
											{
											    SetPlayerToFacePos(playerid, Maconha[m][mac_X], Maconha[m][mac_Y]);
												format(string_prox, 300, "** O jogador '%s' esta regando uma plantacao **", Nome(playerid));
												ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
												Acao(playerid, 18, 150, "REGANDO MACONHA", 1, "BD_FIRE", "WASH_UP", true);
												SetPlayerAttachedObject(playerid, 9, 1650, 6, 0.262999, -0.047999, 0.079000,   40.500003, 17.699996, -19.100006,   1.000000, 1.000000, 1.000000);
											}
					                }
					                else ms(playerid, 0, "Este pe de maconha ja esta bem regado !");
					                break;
					            }
					        }
					    }
					    if(taa == 0) ms(playerid, 0, "Use este item para regar alguma plantacao !");
					}
					else
					{

						    new ta;
							foreach(new v:Vehicles)
							{
							    if(GetVehicleModel(v) != 0)
								{
									if(tanque_veiculo(playerid, v))
									{
									    ta = 1;
									    new veh = Info_Veiculo[v];
									    if(veh != -1)
										{
										if(!tipo_combustivel(v, Inventario[playerid][slot][inv_Tipo]))
											{
											    ms(playerid, 0, "Este veiculo nao suporta este tipo de combustivel !");
											}
										else
										{

											    if(Veiculo[veh][v_Gasolina] >= 100)
												{
												    ms(playerid, 0, "Este veiculo ja esta com tanque cheio.");
												}
											    else
												{
													SetPVarInt(playerid, "veiculo", veh);
												    SetPVarInt(playerid, "slot", slot);
				           						fechar_inv_novo(playerid);

											    if(Barra[playerid][b_Acao] == 0)
													{
														format(string_prox, 300, "** O jogador '%s' esta abastecendo um veiculo **", Nome(playerid));
														ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
														Acao(playerid, 2, 150, "ABASTECENDO VEICULO", 1, "BD_FIRE", "WASH_UP", true);
														SetPlayerAttachedObject(playerid, 9, 1650, 6, 0.262999, -0.047999, 0.079000,   40.500003, 17.699996, -19.100006,   1.000000, 1.000000, 1.000000);
													}
												}
											}
										}
										else
										{
										    ms(playerid, 0, "Este veiculo nao pode ser abastecido !");
										}
								    break;
								}
							    }
							}
						if(ta == 0)
							{
							    ms(playerid, 0, "Use este galao proximo ao tanque de um veiculo para abastece-lo.");
							}
						}
					}
				}


			    // galao vazio  //
				if(idd == 50)
				{
				    if(IsPlayerInAnyVehicle(playerid))
					{
					ms(playerid, 0, "Voce nao pode usar este item dentro de um veiculo !");
				    }
				    else
					{
					    new ta;

					    if(Agua(playerid))
						{
						ta = 1;
					    	SetPVarInt(playerid, "slot", slot);
		              		fechar_inv_novo(playerid);
		              		if(Barra[playerid][b_Acao] == 0)
							{
								format(string_prox, 300, "** O jogador '%s' esta pegando agua **", Nome(playerid));
								ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
								Acao(playerid, 17, 150, "PEGANDO AGUA", 1, "COP_AMBIENT", "COPBROWSE_LOOP", true);
								SetPlayerAttachedObject(playerid, 9, 1650, 6, 0.262999, -0.047999, 0.079000,   40.500003, 17.699996, -19.100006,   1.000000, 1.000000, 1.000000);
							}
					    }// voltaraaa
					    else
						{
							foreach(new i:Iter_Pickups)
							{
								if(Pickup[i][pick_Existe] == 1)
								{
								    if(Pickup[i][pick_Tipo] == 7)
									{
									    if(IsPlayerInRangeOfPoint(playerid, 1, Pickup[i][pick_X],Pickup[i][pick_Y],Pickup[i][pick_Z]))
										{
										if(GetPlayerInterior(playerid) == Pickup[i][pick_Interior])
										{
										    if(GetPlayerVirtualWorld_(playerid) == Pickup[i][pick_Mundo])
											{
										        ta = 1;
										        fechar_inv_novo(playerid);
										        SetPVarInt(playerid, "slot", slot);
													abrir_tabela_player(playerid, 1);
													break;
												}
											}
										}
									}
								}
							}
						}
						if(ta == 0)
						{
						    ms(playerid, 0, "Use este item em um posto de gasolina para encher com algum combustivel !");
						    ms(playerid, 0, "Voce tambem pode usar este galao perto de agua para enche-lo !");
						}
					}
				}


				// DINHEIRO //
				if(idd == 49)
				{
				    format(sss, 300, "Voce pegou R$ %s do seu inventario.", ConvertMoney(Inventario[playerid][slot][inv_Unidades]));
				    DarGrana(playerid, Inventario[playerid][slot][inv_Unidades]);
				    limpar_slot(playerid, slot);
				    abrir_inv_novo(playerid);
				    ms(playerid, 1, sss);
				}

				// KIT REPARO //
				if(idd == 90)
				{
				    if(IsPlayerInAnyVehicle(playerid))
					{
					    new veic = GetPlayerVehicleID(playerid);
					    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
					    {
					        new tempo_restante = GetPVarInt(playerid, "kit_reparo") - gettime();
					        if(tempo_restante > 0) return ms(playerid, 0, f("Aguarde %d segundos para usar outro Kit Reparo !", tempo_restante));
					        RepairVehicle(veic);
					        SetVehicleHealth(veic, 1000.0);
					        limpar_slot(playerid, slot);
					        fechar_inv_novo(playerid);
					        SetPVarInt(playerid, "kit_reparo", gettime() + (30*60));
					        ms(playerid, 1, "Voce usou um Kit Reparo e seu veiculo foi totalmente reparado !");
					    }
					    else ms(playerid, 0, "Voce precisa estar como motorista do veiculo !");
					}
					else ms(playerid, 0, "Voce precisa estar dentro de um veiculo para usar o Kit Reparo !");
				}

				// ARMAS //
				if(idd > 0 && idd < 44)
				{
					{
					    new weapons[13][2];
					    new foi;
						new ar = Itens[idd][item_Tipo];

						{
							if(slot_arma(ar) == 2 && Taser(playerid)) ms(playerid, 0, "Voce nao pode equipar uma pistola enquanto usa o /taser !");
						    else
							{
								for(new w; w<13; w++) GetPlayerWeaponData(playerid, w, weapons[w][0], weapons[w][1]);
								ResetPlayerWeapons_(playerid);
								if(slot_arma(ar) == 8 || slot_arma(ar) == 7) // rifle/shotgun
								{
									for(new www; www<13; www++)
						    		{
						    		    if(www == slot_arma(ar))
							            {
							                new qtd = 1;
							                if(Inventario[playerid][slot][inv_Unidades] > 1)
							                {
							                    qtd = 1;
							                    Inventario[playerid][slot][inv_Unidades] -= 1;
							                    salvar_inventario(conta, slot);
							                }
							                else qtd = Inventario[playerid][slot][inv_Unidades];
							                GivePlayerWeapon_(playerid, ar, qtd);
							                if(Inventario[playerid][slot][inv_Unidades] <= 0) limpar_slot(playerid, slot);
							                if(weapons[www][0] == ar)
							                {
							                    GivePlayerWeapon_(playerid, weapons[www][0], weapons[www][1]);
							                }
							            }
										else GivePlayerWeapon_(playerid, weapons[www][0], weapons[www][1]);
								    }
								    SetPlayerArmedWeapon(playerid, ar);
									abrir_inv_novo(playerid);
									salvar_inventario(conta, slot);
									salvar_conta(conta, playerid, "c_Armas");
								}
								else if(slot_arma(ar) == 10 || slot_arma(ar) == 11) // armas sem municao //
								{
									for(new www; www<13; www++)
						    		{
						    		    if(www == slot_arma(ar)) // slot arma branca //
							        {
							            GivePlayerWeapon_(playerid, ar, Inventario[playerid][slot][inv_Unidades]);
							            if(weapons[www][0] != 0 && weapons[www][1] > 0)
							            {
							                Inventario[playerid][slot][inv_ID] = arma_id(weapons[www][0]);
							            }
							            else limpar_slot(playerid, slot);
										}
										else GivePlayerWeapon_(playerid, weapons[www][0], weapons[www][1]);
								    }
								    SetPlayerArmedWeapon(playerid, ar);
									abrir_inv_novo(playerid);
									salvar_inventario(conta, slot);
									salvar_conta(conta, playerid, "c_Armas");
								}
								else if(slot_arma(ar) == 1 ) // arma branca //
								{
									for(new www; www<13; www++)
						    		{
						    		    if(www == slot_arma(ar)) // slot arma branca //
							        {
							            if(weapons[www][0] != 0 && weapons[www][1] > 0)
							            {
							                Inventario[playerid][slot][inv_ID] = arma_id(weapons[www][0]);
							                GivePlayerWeapon_(playerid, ar, Inventario[playerid][slot][inv_Unidades]);
							            }
							            else
							            {
							                if(contar_armas(playerid) >= 3)
												{
												    ms(playerid, 0, "Voce so pode ter 3 Armas equipadas, use N para ver suas Armas equipadas.");
												}
												else
												{
												    GivePlayerWeapon_(playerid, ar, Inventario[playerid][slot][inv_Unidades]);
								                limpar_slot(playerid, slot);
							                }
							            }
										}
										else GivePlayerWeapon_(playerid, weapons[www][0], weapons[www][1]);
								    }
								    SetPlayerArmedWeapon(playerid, ar);
									abrir_inv_novo(playerid);
									salvar_inventario(conta, slot);
									salvar_conta(conta, playerid, "c_Armas");
								}
								else
								{

								for(new ww; ww<13; ww++)
								{
								    if(slot_arma(ar) == ww)
									{
								        if(weapons[ww][0] != 0)
								        {
								            GivePlayerWeapon_(playerid, ar, weapons[ww][1]);
								            Inventario[playerid][slot][inv_ID] = arma_id(weapons[ww][0]);
								        }
								        else
								        {
								            if(contar_armas(playerid) >= 3)
												{
												    ms(playerid, 0, "Voce so pode ter 3 Armas equipadas, use N para ver suas Armas equipadas.");
												}
												else
												{
												    new tem;
									            for(new o; o<MAX_SLOTS; o++)
									            {
									                if(Inventario[playerid][o][inv_ID] == 44 || Inventario[playerid][o][inv_ID] == 45 ||
														Inventario[playerid][o][inv_ID] == 46 || Inventario[playerid][o][inv_ID] == 47 ||
														Inventario[playerid][o][inv_ID] == 48 )
									                {
									                    if(slot_arma(ar) == Inventario[playerid][o][inv_Tipo])
									                    {
									                        tem += Inventario[playerid][o][inv_Unidades];
									                    }
									                }
									            }
													if(tem < 2) ms(playerid, 0, "Voce precisa de pelo menos 2 municoes para equipar esta arma !");
									    		else
													{
													    SetPVarInt(playerid, "equip_aguardando", 1);
													    SetPVarInt(playerid, "equip_arma", ar);
													    SetPVarInt(playerid, "equip_slot", slot);
													    SetPVarInt(playerid, "equip_max", tem);
													    SetPVarInt(playerid, "equip_tipo", slot_arma(ar));
													    new str_mun[300];
													    format(str_mun, 300, "Quantas municoes deseja colocar?\nDisponivel: %s\nMinimo: 2", ConvertMoney(tem));
													    ShowPlayerDialog(playerid, DIALOG_EQUIPAR_MUNICAO, DIALOG_STYLE_INPUT, "Equipar Arma", str_mun, "Equipar", "Cancelar");
													}
												}
											}
								    }
								    else
									{
								        GivePlayerWeapon_(playerid, weapons[ww][0], weapons[ww][1]);
								    }
								}
							}
								if(foi == 1) SetPlayerArmedWeapon(playerid, ar);
								if(GetPVarInt(playerid, "equip_aguardando") == 0)
								{
									abrir_inv_novo(playerid);
									salvar_inventario(conta, slot);
									salvar_conta(conta, playerid, "c_Armas");
								}
							}
						}
					}
				}

				/////////////  municoes  ///////////////
				if(idd == 44 || idd == 45 || idd == 46 || idd == 47 || idd == 48)
				{
					{
					    if(idd == 44 && Taser(playerid)) ms(playerid, 0, "Voce nao pode equipar esta municao enquanto usa o /taser !");
					    else
						{
						    new weapon[13][2];
							for(new w; w<13; w++) GetPlayerWeaponData(playerid, w, weapon[w][0], weapon[w][1]);
							if(weapon[Itens[idd][item_Tipo]][0] != 0)
							{
								GivePlayerWeapon_(playerid, weapon[Itens[idd][item_Tipo]][0], Inventario[playerid][slot][inv_Unidades]);
							    limpar_slot(playerid, slot);
						    abrir_inv_novo(playerid);
						    salvar_conta(conta, playerid, "c_Armas");
							}
							else ms(playerid, 0, "Esteja equipado com uma Arma que precise dessa municao !");
						}
					}
				}
			}
		}
	}
    return 1;
}


stock dropar_inv(playerid, i)
{
	new conta = id[playerid];
	if(conta != -1)
	{
		if(i > -1 && i < MAX_SLOTS)
		{
		    if(Inventario[playerid][i][inv_ID] > -1)
		    {
				new Float:pos[3];
				GetPlayerPos(playerid, pos[0],pos[1],pos[2]);
				PegarFrente(pos[0],pos[1], random(360), random(8)*0.3);
				criar_item(Inventario[playerid][i][inv_ID], pos[0],pos[1],pos[2], Inventario[playerid][i][inv_Unidades], GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), Inventario[playerid][i][inv_Tipo], -1, Inventario[playerid][i][inv_Ativo], Inventario[playerid][i][inv_Tempo]);
				Inventario[playerid][i][inv_ID] = 0;
				Inventario[playerid][i][inv_Unidades] = 0;
				Inventario[playerid][i][inv_Tipo] = 0;
				abrir_inv_novo(playerid);
				salvar_inventario(conta, i);
			}
		}
	}
}

stock carteira_player(playerid)
