	if(c != -1)
	{
        for(new z; z<4; z++)
		{
		    if(Conta[playerid][c_H][z] != 0)
		    {
		        return 1;
		    }
	    }
	}
	return 0;
}

stock TemHabilitacaoConta(c)
{
	if(c != -1)
	{
	    new player = ContaOnline(c);
        if(Online(player))
        {
            for(new a; a<4; a++)
            {
                if(Conta[player][c_H][a] != 0)
                {
                    return 1;
                }
            }
        }
        else
        {
		    if(GetContaInt(c, "c_H1") != 0) return 1;
		    if(GetContaInt(c, "c_H2") != 0) return 1;
		    if(GetContaInt(c, "c_H3") != 0) return 1;
		    if(GetContaInt(c, "c_H4") != 0) return 1;
	    }
	}
	return 0;
}

stock mostrar_habilitacao(playerid, c)
{
	new string[300];
	if(c != -1)
	{
	    new player = ContaOnline(c);
	    if(Online(player))
		{
		    new habs[50];
		    new valid[100];
			new cont;
			for(new z; z<4; z++)
			{
				if(Conta[player][c_H][z] == 1)
				{
				    strcat(habs, "  ");
				    strcat(habs, Sigla[z]);
				    cont++;
				}
			}

 			if(cont > 0)
		    {
		        new diash = (Conta[player][c_HV]-gettime())/(UM_DIA);
		        if(diash < 1) format(valid, 100, "{FFFF00}VENCE HOJE");
		        else if(diash == 1) format(valid, 100, "{AFAFAF}%d DIA", diash);
				else format(valid, 100, "{AFAFAF}%d DIAS", diash);
			    SG[0] = EOS;
			    strcat(SG, "\n\n");
			    strcat(SG, 			"{FFFFFF}        REPUBLICA FEDERATIVA DO BRASIL\n");
			    strcat(SG, 			"{FFFFFF}             MINISTERIO DAS CIDADES\n");
		     	strcat(SG, 			"{FFFFFF}     DEPARTAMENTO NACIONAL DE TRANSITO\n");
			    strcat(SG, 			"{FFFFFF}      CARTEIRA NACIONAL DE HABILITACAO\n\n");
			    format(string, sizeof(string), 	"  {FFFFFF}Nome:   {FF6347}%s\n", NomeConta(c));
			    strcat(SG, string);
			    format(string, sizeof(string), 	"  {FFFFFF}Data de Emissao:   {AFAFAF}%s\n", Conta[player][c_HD]);
			    strcat(SG, string);
			    format(string, sizeof(string), 	"  {FFFFFF}Validade:   %s\n", valid);
			    strcat(SG, string);
			    format(string, sizeof(string), 	"  {FFFFFF}Pontos:   {AFAFAF}%d\n\n", Conta[player][c_HP]);
			    strcat(SG, string);
			    format(string, sizeof(string), 	"  {FFFFFF}Categorias:  {AFAFAF}%s", habs);
			    strcat(SG, string);
			    strcat(SG, "\n\n");
			    ShowPlayerDialog(playerid, DIALOG_HABILITACAO, DIALOG_STYLE_MSGBOX, "Carteira de Habilitacao", SG, "Ok", "Informado");
				format(string, sizeof(string), 	"Categorias: %s.", habs);
				ms(playerid, 4, string);
			}
		}
    }
}


