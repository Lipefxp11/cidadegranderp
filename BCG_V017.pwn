stock mostrar_casas(playerid)
{
    new idd = id[playerid];
    if(idd != -1)
    {
	    new cont;
	    new sss[150];
	    new total;
		SG[0] = EOS;
		zerar_lista(playerid);
		strcat(SG, "ID\tTipo\tCidade\n");
		foreach(new i:Iter_Casas)
		{
            if(Casa[i][casa_Existe] == 1)
            {
                if(Casa[i][casa_Dono] == idd || TemChaveCasa(playerid, i))
                {
                    if(Casa[i][casa_Dono] == idd) format(sss, 150, "{ffffff}%d\t{00ff88}%s\t{ffff00}%s\n", i, tipo_casa(i), cidade2(cidade_casa(i)));
                    else format(sss, 150, "{ffffff}%d\t{ff8888}%s (Chave)\t{ffff00}%s\n", i, tipo_casa(i), cidade2(cidade_casa(i)));
                    strcat(SG, sss);
                    Lista[playerid][cont] = i;
                    if(Casa[i][casa_Dono] == idd) Lista2[playerid][cont] = 0;
                    else Lista2[playerid][cont] = 1;
					cont++;
					total++;
                }
            }
        }
        format(sss, 150, "{ffffff}Suas Casas[{ffff00}%d{ffffff}]", total );
		ShowPlayerDialog(playerid, DIALOG_CASAS, DIALOG_STYLE_TABLIST_HEADERS, sss, SG, "Ok", "Fechar");
	}
}

