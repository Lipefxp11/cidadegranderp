stock DestruirFConcePlayer(playerid)
{
    for(new i; i<14; i++)
    {
        PlayerTextDrawDestroy(playerid, FConceP[playerid][i]);
        FConceP[playerid][i] = PlayerText:INVALID_TEXT_DRAW;
    }
}

stock MostrarFConce(playerid)
{
    if(FConceP[playerid][0] == PlayerText:INVALID_TEXT_DRAW) CriarFConcePlayer(playerid);
    ConceAberto[playerid] = 1;
    for(new i; i<41; i++) TextDrawShowForPlayer(playerid, FConce[i]);
    for(new i; i<14; i++) PlayerTextDrawShow(playerid, FConceP[playerid][i]);
    SelectTextDraw(playerid, 0x00000001);
}

stock EsconderFConce(playerid)
{
    ConceAberto[playerid] = 0;
    for(new i; i<41; i++) TextDrawHideForPlayer(playerid, FConce[i]);
    for(new i; i<14; i++)
    {
        PlayerTextDrawDestroy(playerid, FConceP[playerid][i]);
        FConceP[playerid][i] = PlayerText:INVALID_TEXT_DRAW;
    }
    CancelSelectTextDraw(playerid);
}

stock C_AtualizarCatalogo(playerid)
{
    new cat = ConceCat[playerid];
    new page = ConcePagina[playerid];
    for(new i; i<MAX_CONCE_VEHS_PER_PAGE; i++)
    {
        new idx = page * MAX_CONCE_VEHS_PER_PAGE + i;
        new td = 3 + i;
        if(ConceVeh[cat][idx][cActive])
        {
            PlayerTextDrawSetPreviewModel(playerid, FConceP[playerid][td], ConceVeh[cat][idx][cModel]);
            PlayerTextDrawSetPreviewVehCol(playerid, FConceP[playerid][td], ConceCor[playerid], ConceCor[playerid]);
        }
        else PlayerTextDrawSetPreviewModel(playerid, FConceP[playerid][td], 19300);
        PlayerTextDrawShow(playerid, FConceP[playerid][td]);
    }
}

stock C_AtualizarSelecionado(playerid)
{
    new cat = ConceCat[playerid];
    new idx = ConcePagina[playerid] * MAX_CONCE_VEHS_PER_PAGE + ConceSlot[playerid];
    if(ConceVeh[cat][idx][cActive])
    {
        new mod = ConceVeh[cat][idx][cModel];
        new vi = mod - 400;
        new nStr[32];
        // Nome: usa info_veiculos se disponivel
        if(vi >= 0 && vi < 212) format(nStr, 32, "%s", info_veiculos[vi][veh_Nome]);
        else format(nStr, 32, "%s", ConceVeh[cat][idx][cName]);
        PlayerTextDrawSetString(playerid, FConceP[playerid][0], nStr);
        PlayerTextDrawSetString(playerid, FConceP[playerid][1], ConceVeh[cat][idx][cBrand]);
        PlayerTextDrawSetPreviewModel(playerid, FConceP[playerid][2], mod);
        PlayerTextDrawSetPreviewVehCol(playerid, FConceP[playerid][2], ConceCor[playerid], ConceCor[playerid]);
        // Velocidade: info_veiculos
        new velo = (vi >= 0 && vi < 212) ? info_veiculos[vi][veh_Velocidade] : 120;
        if(velo <= 0) velo = 120;
        format(nStr, 32, "%d km/h", velo);
        PlayerTextDrawSetString(playerid, FConceP[playerid][8], nStr);
        // Slots: info_veiculos
        new slots = (vi >= 0 && vi < 212) ? info_veiculos[vi][veh_PortaMalas] : 4;
        if(slots <= 0) slots = 4;
        format(nStr, 32, "%d Slots", slots);
        PlayerTextDrawSetString(playerid, FConceP[playerid][9], nStr);
        // Tanque: info_veiculos
        new tanq = (vi >= 0 && vi < 212) ? info_veiculos[vi][veh_Capacidade] : 50;
        if(tanq <= 0) tanq = 50;
        format(nStr, 32, "%d L", tanq);
        PlayerTextDrawSetString(playerid, FConceP[playerid][11], nStr);
        // Preco e estoque: do array ConceVeh
        format(nStr, 32, "R$%s", ConvertMoney(ConceVeh[cat][idx][cPrice]));
        PlayerTextDrawSetString(playerid, FConceP[playerid][12], nStr);
        format(nStr, 32, "ESTOQUE: %d", ConceVeh[cat][idx][cStock]);
        PlayerTextDrawSetString(playerid, FConceP[playerid][13], nStr);
    }
    else
    {
        PlayerTextDrawSetString(playerid, FConceP[playerid][0], "Vazio");
        PlayerTextDrawSetString(playerid, FConceP[playerid][1], "N/A");
        PlayerTextDrawSetPreviewModel(playerid, FConceP[playerid][2], 19300);
        PlayerTextDrawSetString(playerid, FConceP[playerid][8], "0 km/h");
        PlayerTextDrawSetString(playerid, FConceP[playerid][9], "0 Slots");
        PlayerTextDrawSetString(playerid, FConceP[playerid][11], "0L");
        PlayerTextDrawSetString(playerid, FConceP[playerid][12], "$0");
        PlayerTextDrawSetString(playerid, FConceP[playerid][13], "ESTOQUE: 0");
    }
    PlayerTextDrawShow(playerid, FConceP[playerid][0]);
    PlayerTextDrawShow(playerid, FConceP[playerid][1]);
    PlayerTextDrawShow(playerid, FConceP[playerid][2]);
    PlayerTextDrawShow(playerid, FConceP[playerid][8]);
    PlayerTextDrawShow(playerid, FConceP[playerid][9]);
    PlayerTextDrawShow(playerid, FConceP[playerid][11]);
    PlayerTextDrawShow(playerid, FConceP[playerid][12]);
    PlayerTextDrawShow(playerid, FConceP[playerid][13]);
}

stock SalvarConceVeh(cat, idx)
{
    new file[80];
    format(file, 80, "ConceVeh_%d_%d.txt", cat, idx);
    if(!DOF2_FileExists(file)) DOF2_CreateFile(file);
    DOF2_SetInt(file, "Active", ConceVeh[cat][idx][cActive]);
    if(ConceVeh[cat][idx][cActive])
    {
        DOF2_SetInt(file, "Model", ConceVeh[cat][idx][cModel]);
        DOF2_SetInt(file, "Price", ConceVeh[cat][idx][cPrice]);
        DOF2_SetInt(file, "Stock", ConceVeh[cat][idx][cStock]);
        DOF2_SetString(file, "Name", ConceVeh[cat][idx][cName]);
        DOF2_SetString(file, "CustomName", ConceVeh[cat][idx][cCustomName]);
        DOF2_SetString(file, "Brand", ConceVeh[cat][idx][cBrand]);
        DOF2_SetString(file, "Speed", ConceVeh[cat][idx][cSpeed]);
        DOF2_SetString(file, "Slots", ConceVeh[cat][idx][cSlots]);
        DOF2_SetString(file, "Gas", ConceVeh[cat][idx][cGas]);
    }
    DOF2_SaveFile();
}

stock MigrarConceParaVeh()
{
    // Migra veiculos do sistema antigo Conce[] para o novo ConceVeh[][]
    // Distribui entre as 4 categorias em round-robin
    new cont[4];
    for(new i; i<MAX_CONCE; i++)
    {
        if(Conce[i][con_Existe] == 1)
        {
            for(new a; a<MAX_VEICULOS_CONCE; a++)
            {
                if(Conce[i][con_v_Existe][a] == 1)
                {
                    new cat = i % MAX_CONCE_CAT;
                    if(cont[cat] >= MAX_CONCE_VEHS) cat = 0;
                    if(cont[cat] < MAX_CONCE_VEHS)
                    {
                        ConceVeh[cat][cont[cat]][cActive] = true;
                        ConceVeh[cat][cont[cat]][cModel] = Conce[i][con_v_Modelo][a];
                        ConceVeh[cat][cont[cat]][cPrice] = Conce[i][con_v_Valor][a];
                        ConceVeh[cat][cont[cat]][cStock] = Conce[i][con_v_Stock][a];
                        format(ConceVeh[cat][cont[cat]][cName], 32, NomeVeiculo(Conce[i][con_v_Modelo][a]));
                        format(ConceVeh[cat][cont[cat]][cBrand], 32, "Conce %d", i);
                        format(ConceVeh[cat][cont[cat]][cSpeed], 16, "120 km/h");
                        format(ConceVeh[cat][cont[cat]][cSlots], 16, "4 Slots");
                        format(ConceVeh[cat][cont[cat]][cGas], 16, "50L");
                        format(ConceVeh[cat][cont[cat]][cCustomName], 32, "");
                        SalvarConceVeh(cat, cont[cat]);
                        cont[cat]++;
                    }
                }
            }
        }
    }
    printf("[CONCE] Migrados: Populares=%d Esportivos=%d Motos=%d Premium=%d", cont[0], cont[1], cont[2], cont[3]);
}

stock CarregarConceVeh()
{
    new file[80];
    for(new cat; cat<MAX_CONCE_CAT; cat++)
    {
        for(new idx; idx<MAX_CONCE_VEHS; idx++)
        {
            format(file, 80, "ConceVeh_%d_%d.txt", cat, idx);
            if(DOF2_FileExists(file))
            {
                if(DOF2_GetInt(file, "Active") == 1)
                {
                    ConceVeh[cat][idx][cActive] = true;
                    ConceVeh[cat][idx][cModel] = DOF2_GetInt(file, "Model");
                    ConceVeh[cat][idx][cPrice] = DOF2_GetInt(file, "Price");
                    ConceVeh[cat][idx][cStock] = DOF2_GetInt(file, "Stock");
                    format(ConceVeh[cat][idx][cName], 32, "%s", DOF2_GetString(file, "Name"));
                    format(ConceVeh[cat][idx][cCustomName], 32, "%s", DOF2_GetString(file, "CustomName"));
                    format(ConceVeh[cat][idx][cBrand], 32, "%s", DOF2_GetString(file, "Brand"));
                    format(ConceVeh[cat][idx][cSpeed], 16, "%s", DOF2_GetString(file, "Speed"));
                    format(ConceVeh[cat][idx][cSlots], 16, "%s", DOF2_GetString(file, "Slots"));
                    format(ConceVeh[cat][idx][cGas], 16, "%s", DOF2_GetString(file, "Gas"));
                }
            }
        }
    }
}

stock C_ClickGlobal(playerid, Text:clickedid)
{
    if(clickedid == FConce[9]) { EsconderFConce(playerid); return 1; }
    if(clickedid == FConce[14]) { ConceCat[playerid] = 0; ConcePagina[playerid] = 0; ConceSlot[playerid] = 0; C_AtualizarCatalogo(playerid); C_AtualizarSelecionado(playerid); return 1; }
    if(clickedid == FConce[15]) { ConceCat[playerid] = 1; ConcePagina[playerid] = 0; ConceSlot[playerid] = 0; C_AtualizarCatalogo(playerid); C_AtualizarSelecionado(playerid); return 1; }
    if(clickedid == FConce[16]) { ConceCat[playerid] = 2; ConcePagina[playerid] = 0; ConceSlot[playerid] = 0; C_AtualizarCatalogo(playerid); C_AtualizarSelecionado(playerid); return 1; }
    if(clickedid == FConce[17]) { ConceCat[playerid] = 3; ConcePagina[playerid] = 0; ConceSlot[playerid] = 0; C_AtualizarCatalogo(playerid); C_AtualizarSelecionado(playerid); return 1; }
    if(clickedid == FConce[18]) { if(ConcePagina[playerid] > 0) { ConcePagina[playerid]--; C_AtualizarCatalogo(playerid); C_AtualizarSelecionado(playerid); } return 1; }
    if(clickedid == FConce[19]) { if(ConcePagina[playerid] < (MAX_CONCE_PAGES-1)) { ConcePagina[playerid]++; C_AtualizarCatalogo(playerid); C_AtualizarSelecionado(playerid); } return 1; }
    if(clickedid == FConce[21]) { ConceCor[playerid] = 1; C_AtualizarCatalogo(playerid); C_AtualizarSelecionado(playerid); return 1; }
    if(clickedid == FConce[22]) { ConceCor[playerid] = 3; C_AtualizarCatalogo(playerid); C_AtualizarSelecionado(playerid); return 1; }
    if(clickedid == FConce[23]) { ConceCor[playerid] = 9; C_AtualizarCatalogo(playerid); C_AtualizarSelecionado(playerid); return 1; }
    if(clickedid == FConce[24]) { ConceCor[playerid] = 86; C_AtualizarCatalogo(playerid); C_AtualizarSelecionado(playerid); return 1; }
    if(clickedid == FConce[25]) { ConceCor[playerid] = 6; C_AtualizarCatalogo(playerid); C_AtualizarSelecionado(playerid); return 1; }
    if(clickedid == FConce[26]) { ConceCor[playerid] = 128; C_AtualizarCatalogo(playerid); C_AtualizarSelecionado(playerid); return 1; }
    if(clickedid == FConce[27]) { ConceCor[playerid] = 79; C_AtualizarCatalogo(playerid); C_AtualizarSelecionado(playerid); return 1; }
    if(clickedid == FConce[39]) {
        new cat = ConceCat[playerid];
        new idx = ConcePagina[playerid] * MAX_CONCE_VEHS_PER_PAGE + ConceSlot[playerid];
        if(!ConceVeh[cat][idx][cActive]) return ms(playerid, 0, "Veiculo invalido!");
        if(ConceVeh[cat][idx][cStock] <= 0) return ms(playerid, 0, "Fora de estoque!");
        if(GranaPlayer(playerid) < ConceVeh[cat][idx][cPrice]) return ms(playerid, 0, "Dinheiro insuficiente!");
        new c = id[playerid];
        if(c == -1) return 1;
        new idv = CriarVeiculo(0, 0, ConceVeh[cat][idx][cModel], 0, 0, 0, 0, 1, 1, c);
        if(idv == -1) return ms(playerid, 0, "Limite de veiculos atingido!");
        Veiculo[idv][v_Conce] = 1;
        Veiculo[idv][v_ConceID] = 0;
        Veiculo[idv][v_Garagem] = 1;
        Veiculo[idv][v_Cor1] = ConceCor[playerid];
        Veiculo[idv][v_Cor2] = ConceCor[playerid];
        Veiculo[idv][v_Compra] = ConceVeh[cat][idx][cPrice];
        SalvarInfo(idv);
        DarGrana(playerid, -ConceVeh[cat][idx][cPrice]);
        ConceVeh[cat][idx][cStock]--;
        SalvarConceVeh(cat, idx);
        ms(playerid, 1, f("Veiculo %s comprado! Esta na garagem da concessionaria.", ConceVeh[cat][idx][cName]));
        EsconderFConce(playerid);
        return 1;
    }
    if(clickedid == FConce[40]) {
        new cat = ConceCat[playerid];
        new idx = ConcePagina[playerid] * MAX_CONCE_VEHS_PER_PAGE + ConceSlot[playerid];
        if(!ConceVeh[cat][idx][cActive]) return ms(playerid, 0, "Selecione um veiculo valido!");
        EsconderFConce(playerid);
        SetPlayerPos(playerid, 427.1511, 2500.5996, 16.1759);
        SetPlayerFacingAngle(playerid, 86.6883);
        SetPlayerVirtualWorld_(playerid, 0);
        SetPlayerInterior(playerid, 0);
        new tdveh = CreateVehicle(ConceVeh[cat][idx][cModel], 427.1511, 2500.5996, 16.1759, 86.6883, ConceCor[playerid], ConceCor[playerid], -1);
        PutPlayerInVehicle(playerid, tdveh, 0);
        SetTimerEx("Conce_EndTestDrive", 30000, false, "d", playerid);
        ms(playerid, 0, "Test drive iniciado! 30 segundos.");
        return 1;
    }
    return 0;
}

forward Conce_EndTestDrive(playerid);
public Conce_EndTestDrive(playerid)
{
    if(IsPlayerInAnyVehicle(playerid))
    {
        new veh = GetPlayerVehicleID(playerid);
        RemovePlayerFromVehicle(playerid);
        DestroyVehicle(veh);
    }
    SetPlayerPos(playerid, CONCE_PICKUP_X, CONCE_PICKUP_Y, CONCE_PICKUP_Z);
    ms(playerid, 0, "Test drive encerrado!");
}

stock C_ClickPlayer(playerid, PlayerText:text)
{
    for(new i; i<MAX_CONCE_VEHS_PER_PAGE; i++)
    {
        if(text == FConceP[playerid][3+i])
        {
            new cat = ConceCat[playerid];
            new idx = ConcePagina[playerid] * MAX_CONCE_VEHS_PER_PAGE + i;
            // Admin pode clicar em slot vazio pra adicionar veiculo
            if(!ConceVeh[cat][idx][cActive] && AdminPlayer(playerid) >= 8 && ModoAdmin[playerid] == 1)
            {
                ConceSlot[playerid] = i;
                ShowPlayerDialog(playerid, DIALOG_CONCE_MODELO, DIALOG_STYLE_INPUT, "Adicionar Veiculo", "Digite o ID do modelo (400-611):\nUse 0 para remover.", "Salvar", "Cancelar");
                return 1;
            }
            ConceSlot[playerid] = i;
            C_AtualizarSelecionado(playerid);
            return 1;
        }
    }
    // Admin editing (level 8+ em modo trabalho)
    if(AdminPlayer(playerid) >= 8 && ModoAdmin[playerid] == 1)
    {
        if(text == FConceP[playerid][0]) { ShowPlayerDialog(playerid, DIALOG_CONCE_NOME, DIALOG_STYLE_INPUT, "Editar Nome", "Digite o novo nome:", "Salvar", "Cancelar"); return 1; }
        if(text == FConceP[playerid][1]) { ShowPlayerDialog(playerid, DIALOG_CONCE_MARCA, DIALOG_STYLE_INPUT, "Editar Marca", "Digite a nova marca:", "Salvar", "Cancelar"); return 1; }
        if(text == FConceP[playerid][2]) { ShowPlayerDialog(playerid, DIALOG_CONCE_MODELO, DIALOG_STYLE_INPUT, "Editar Modelo", "Digite o ID do modelo (400-611):\nUse 0 para remover o veiculo.", "Salvar", "Cancelar"); return 1; }
        if(text == FConceP[playerid][8]) { ShowPlayerDialog(playerid, DIALOG_CONCE_VELO, DIALOG_STYLE_INPUT, "Editar Velocidade", "Ex: 150 km/h:", "Salvar", "Cancelar"); return 1; }
        if(text == FConceP[playerid][9]) { ShowPlayerDialog(playerid, DIALOG_CONCE_SLOTS, DIALOG_STYLE_INPUT, "Editar Slots", "Ex: 4 Slots:", "Salvar", "Cancelar"); return 1; }
        if(text == FConceP[playerid][11]) { ShowPlayerDialog(playerid, DIALOG_CONCE_GAS, DIALOG_STYLE_INPUT, "Editar Tanque", "Ex: 60L:", "Salvar", "Cancelar"); return 1; }
        if(text == FConceP[playerid][12]) { ShowPlayerDialog(playerid, DIALOG_CONCE_PRECO, DIALOG_STYLE_INPUT, "Editar Preco", "Digite o valor:", "Salvar", "Cancelar"); return 1; }
        if(text == FConceP[playerid][13]) { ShowPlayerDialog(playerid, DIALOG_CONCE_ESTOQUE, DIALOG_STYLE_INPUT, "Editar Estoque", "Digite a quantidade:", "Salvar", "Cancelar"); return 1; }
    }
    return 0;
}

