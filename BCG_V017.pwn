	if(!strcmp(cmd, "/corveiculo", true))
	{
		if(!IsPlayerInAnyVehicle(playerid)) return ms(playerid, 0, "Voce nao esta em um veiculo !");
		new i = GetPlayerVehicleID(playerid);
		new v = Info_Veiculo[i];
		if(v != -1) SetarCorVeiculo(playerid, i, v);
		else ms(playerid, 0, "Voce nao pode alterar a cor deste veiculo, pois ele nao tem ID de Info !");
		return 1;
	}

	if(!strcmp(cmd, "/copiarveiculo", true))
	{
		new i;
		new sss[150];
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /copiarveiculo [ ID do Veiculo ].");
		if(i < 0 || i >= MAX_VEHICLES) return ms(playerid, 0, "Este veiculo nao existe !");
		if(GetVehicleModel(i) == 0) return ms(playerid, 0, "Este veiculo nao existe !");
		new v = Info_Veiculo[i];
		new Float:pos[4];
		GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
		GetPlayerFacingAngle(playerid, pos[3]);
		if(v != -1)
		{
		    new idv = CriarVeiculo(1,1, GetVehicleModel(i), pos[0], pos[1], pos[2], pos[3], Veiculo[v][v_Cor1], Veiculo[v][v_Cor2], -1);
		    if(idv == -1) return ms(playerid, 0, "Numero maximo de veiculos do servidor atingido !");
		    new veh = Veiculo[idv][v_ID];
		    Veiculo[idv][v_Dono] = Veiculo[v][v_Dono];
		    Veiculo[idv][v_Org] = Veiculo[v][v_Org];
		    Veiculo[idv][v_Emprego] = Veiculo[v][v_Emprego];
		    Veiculo[idv][v_Garagem_ID] = Veiculo[v][v_Garagem_ID];
		    PutPlayerInVehicle(playerid, veh, 0);
		    SalvarVeiculo(veh);
		    format(sss, 300, "Voce criou o veiculo [%d], Info: %d.", veh, idv);
		    ms(playerid, 5, sss);
		}
		else ms(playerid, 0, "Voce nao pode copiar este veiculo, pois ele nao tem ID de Info !");
		return 1;
	}


	if(!strcmp(cmd, "/donoveiculo", true))
	{
		new i, d;
		new sss[150];
		if(sscanf(params, "dd", i, d)) return ms(playerid, 2, "Use: /donoveiculo [ ID do Veiculo ] [ ID da Conta].");
		if(i < 0 || i >= MAX_VEHICLES) return ms(playerid, 0, "Este veiculo nao existe !");
		if(GetVehicleModel(i) == 0) return ms(playerid, 0, "Este veiculo nao existe !");
		new v = Info_Veiculo[i];
		if(v != -1)
		{
		    if(d == -1)
		    {
		        Veiculo[v][v_Dono] = d;
		        SalvarVeiculo(i);
		        ms(playerid, 5, "Voce removeu o Dono deste veiculo !");
		        return 1;
		    }
			if(ContaInvalida(d)) return ms(playerid, 0, "ID de Conta invalida !");
		    Veiculo[v][v_Dono] = d;
		    format(sss, 150, "Voce alterou o Dono deste veiculo para a conta '%s' [%d].", NomeConta(d), d);
	     	ms(playerid, 5, sss);
	     	SalvarVeiculo(i);
		}
		else ms(playerid, 0, "Voce nao pode alterar o Dono deste veiculo !");
		return 1;
	}

	if(!strcmp(cmd, "/garageminfo", true))
	{
	    new i, v;
		if(sscanf(params, "dd", v, i)) return ms(playerid, 2, "Use: /garageminfo [ INFO do veiculo] [ID da Garagem].");
		if(v != -1)
		{
		    if(v < 0 || v >= MAX_VEICULOS) return ms(playerid, 0, "ID de INFO do leiculo Invalido ! Use um ID valido.");
		    if(Veiculo[v][v_Existe] == 0) return ms(playerid, 0, "Esta Info de Veiculo nao existe");
		    if(i < -1 || i >= MAX_GARAGEMS) return ms(playerid, 0, "ID de garagem Invalido ! Use um ID valido ou -1 para nenhuma.");
		    if(i != -1 && Garagem[i][ga_Existe] == 0) return ms(playerid, 0, "Esta Garagem nao existe");
		    Veiculo[v][v_Garagem_ID] = i;
		    SalvarInfo(v);
		    if(Veiculo[v][v_Garagem] == 0)
			{
				new veh = Veiculo[v][v_ID];
				if(GetVehicleModel(veh) != 0)
				{
				    if(Info_Veiculo[veh] == v)
					{
						SetVehicleToRespawn(veh);
					}
				}
			}
			else
			{
			    texto_garagem(v);
			}
	        new sss[200];
	        format(sss, 150, "Voce setou o veiculo de INFO: %d, na garagem [%d].", v, i);
	     	ms(playerid, 5, sss);
		}
		else ms(playerid, 2, "Use: /garageminfo [ INFO do veiculo] [ID da Garagem].");
		return 1;
	}


	if(!strcmp(cmd, "/garagemveiculo", true))
	{
	    new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /garagemveiculo [ID da Garagem].");
		if(IsPlayerInAnyVehicle(playerid))
		{
		    new veh = GetPlayerVehicleID(playerid);
		    if(GetVehicleModel(veh) != 0)
		    {
	        	new v = Info_Veiculo[veh];
	        	if(v != -1)
				{
				    if(i < -1 || i >= MAX_GARAGEMS) return ms(playerid, 0, "ID de garagem Invalido ! Use um ID valido ou -1 para nenhuma.");
				    if(i != -1 && Garagem[i][ga_Existe] == 0) return ms(playerid, 0, "Esta Garagem nao existe");
				    Veiculo[v][v_Garagem_ID] = i;
				    SalvarInfo(v);
				    if(Veiculo[v][v_Garagem] == 0) SetVehicleToRespawn(veh);
					else
					{
					    Veiculo[v][v_Garagem] = 0;
					    spawn_veiculo(v);
					}
		            new sss[200];
		            format(sss, 150, "Voce setou este veiculo na garagem [%d].",  i);
			     	ms(playerid, 5, sss);
				}
				else ms(playerid, 0, "Este veiculo nao tem um ID de informacao !");
			}
			else ms(playerid, 0, "Voce nao esta em um veiculo !");
		}
		else
		{
			foreach(new a:Iter_Veiculos)
			{
			    if(Veiculo[a][v_Existe] == 1)
				{
				if(Veiculo[a][v_Garagem_ID] == -1)
			    	{
					if(IsPlayerInRangeOfPoint(playerid, 2, Veiculo[a][v_X],  Veiculo[a][v_Y],  Veiculo[a][v_Z]))
					{
					    new coman[100];
					    format(coman, 100, "%d %d", a, i);
					    comando(playerid, "/garageminfo", coman);
					    return 1;
					}
				}
			    }
			}
		}
		ms(playerid, 0, "Voce nao esta em um veiculo, ou no Pickup da Info de um veiculo !");
		return 1;
	}

	if(!strcmp(cmd, "/orgveiculo", true))
	{
		new i, d;
		new sss[150];
		if(sscanf(params, "dd", i, d)) return ms(playerid, 2, "Use: /orgveiculo [ ID do Veiculo ] [ ID da Org].");
		if(i < 0 || i >= MAX_VEHICLES) return ms(playerid, 0, "Este veiculo nao existe !");
		if(GetVehicleModel(i) == 0) return ms(playerid, 0, "Este veiculo nao existe !");
		new v = Info_Veiculo[i];
		if(v != -1)
		{
		    if(d == -1)
		    {
		        Veiculo[v][v_Org] = d;
		        Veiculo[v][v_Cargo] = 1;
		        SalvarVeiculo(i);
		        ms(playerid, 5, "Voce removeu a Organizacao deste veiculo !");
		        return 1;
		    }
			if(d < 0 || d >= MAX_ORGS) return ms(playerid, 0, "ID de Organizacao invalido !");
			if(Org[d][o_Existe] == 0) return ms(playerid, 0, "Esta Organizacao nao existe !");
		    Veiculo[v][v_Org] = d;
		    Veiculo[v][v_Cargo] = 1;
		    format(sss, 150, "Voce alterou a Organizacao deste veiculo para: %s [%d].", Org[d][o_Nome], d);
	     	ms(playerid, 5, sss);
	     	SalvarVeiculo(i);
		}
		else ms(playerid, 0, "Voce nao pode alterar a Organizacao deste veiculo !");
		return 1;
	}

	if(!strcmp(cmd, "/empregoveiculo", true))
	{
		new i, d;
		new sss[150];
		if(sscanf(params, "dd", i, d)) return ms(playerid, 2, "Use: /empregoveiculo [ ID do Veiculo ] [ ID do Emprego].");
		if(i < 0 || i >= MAX_VEHICLES) return ms(playerid, 0, "Este veiculo nao existe !");
		if(GetVehicleModel(i) == 0) return ms(playerid, 0, "Este veiculo nao existe !");
		new v = Info_Veiculo[i];
		if(v != -1)
		{
		    if(d == -1)
		    {
		        Veiculo[v][v_Emprego] = d;
		        SalvarVeiculo(i);
		        ms(playerid, 5, "Voce removeu o Emprego deste veiculo !");
		        return 1;
		    }
			if(d < 0 || d >= MAX_EMPREGOS) return ms(playerid, 0, "ID de emprego invalido !");
			if(Emprego[d][e_Existe] == 0) return ms(playerid, 0, "Este emprego nao existe !");
		    Veiculo[v][v_Emprego] = d;
		    format(sss, 150, "Voce alterou o Emprego deste veiculo para: %s [%d].", Emprego[d][e_Nome], d);
	     	ms(playerid, 5, sss);
	     	SalvarVeiculo(i);
		}
		else ms(playerid, 0, "Voce nao pode alterar o Emprego deste veiculo !");
		return 1;
	}


	if(!strcmp(cmd, "/salvarveiculo", true))
	{
		if(IsPlayerInAnyVehicle(playerid))
		{
		    new i = GetPlayerVehicleID(playerid);
		    if(i != INVALID_VEHICLE_ID)
		    {
			    if(Info_Veiculo[i] != -1)
				{
					new idv = Info_Veiculo[i];
					GetVehiclePos(i, Veiculo[idv][v_X], Veiculo[idv][v_Y], Veiculo[idv][v_Z]);
					GetVehicleZAngle(i, Veiculo[idv][v_A]);
					Veiculo[idv][v_Conce] = 0;
					SalvarInfo(idv);
					Info_Veiculo[i] = -1;
					DestroyVehicle_(i);
					i = CreateVehicle_(Veiculo[idv][v_Modelo], Veiculo[idv][v_X], Veiculo[idv][v_Y], Veiculo[idv][v_Z], Veiculo[idv][v_A], Veiculo[idv][v_Cor1], Veiculo[idv][v_Cor2], -1, 0);
					Info_Veiculo[i] = idv;
	                Veiculo[idv][v_ID] = i;
	                SetVehicleHealth(i, Veiculo[idv][v_Vida]);
	                ms(playerid, 5, "Voce estacionou este veiculo ! Novo local de Spawn salvo.");
	                PutPlayerInVehicle(playerid, i, 0);
			    }
			    else
				{
					for(new c; c<MAX_CONCE; c++)
					{
					    if(Conce[c][con_Existe] == 1)
						{
						for(new a; a<MAX_VEICULOS_CONCE; a++)
						{
						    if(Conce[c][con_v_Existe][a] == 1)
							{
						        if(Conce[c][con_v_Veiculo][a] == i)
						        {
						            GetVehiclePos(i, Conce[c][con_v_X][a], Conce[c][con_v_Y][a], Conce[c][con_v_Z][a]);
										GetVehicleZAngle(i, Conce[c][con_v_A][a]);
										ms(playerid, 5, "Voce estacionou este veiculo ! Novo local de Spawn salvo.");
										atualizar_veiculo_conce(c, a);
										salvar_concessionaria(c);
										return 1;
						        }
						    }
						}
					    }
					}
	                ms(playerid, 0, "Voce nao pode salvar a posicao deste veiculo !");
				}

		    }
		    else ms(playerid, 0, "Voce nao pode salvar a posicao deste veiculo !");
		}
		else ms(playerid, 0, "Voce nao esta em um veiculo !");
		return 1;
	}



	if(!strcmp(cmd, "/modeloveiculo", true))
	{
		if(IsPlayerInAnyVehicle(playerid))
		{
		    new model;
		    if(sscanf(params, "d", model)) return ms(playerid, 0, "Use: /modeloveiculo [ 400 - 611 ].");
		    new i = GetPlayerVehicleID(playerid);
		    if(i != INVALID_VEHICLE_ID)
		    {
		        if(model < 400 || model > 611) return ms(playerid, 0, "Use um Modelo de 400 a 611 !");
			    if(Info_Veiculo[i] != -1)
				{
					new idv = Info_Veiculo[i];
					GetVehiclePos(i, Veiculo[idv][v_X], Veiculo[idv][v_Y], Veiculo[idv][v_Z]);
					GetVehicleZAngle(i, Veiculo[idv][v_A]);
					Veiculo[idv][v_Modelo] = model;
					Veiculo[idv][v_Conce] = 0;
					SalvarInfo(idv);
					Info_Veiculo[i] = -1;
					DestroyVehicle_(i);
					i = CreateVehicle_(Veiculo[idv][v_Modelo], Veiculo[idv][v_X], Veiculo[idv][v_Y], Veiculo[idv][v_Z], Veiculo[idv][v_A], Veiculo[idv][v_Cor1], Veiculo[idv][v_Cor2], -1, 0);
					Info_Veiculo[i] = idv;
	                Veiculo[idv][v_ID] = i;
	                SetVehicleHealth(i, Veiculo[idv][v_Vida]);
	                new sss[150];
	                format(sss, 150, "Voce alterou o modelo deste veiculo para [%d]!.", model);
	                ms(playerid, 5, sss);
	                PutPlayerInVehicle(playerid, i, 0);
			    }
			    else
				{
					for(new c; c<MAX_CONCE; c++)
					{
					    if(Conce[c][con_Existe] == 1)
						{
						for(new a; a<MAX_VEICULOS_CONCE; a++)
						{
						    if(Conce[c][con_v_Existe][a] == 1)
							{
						        if(Conce[c][con_v_Veiculo][a] == i)
						        {
						            new sss[150];
						            GetVehiclePos(i, Conce[c][con_v_X][a], Conce[c][con_v_Y][a], Conce[c][con_v_Z][a]);
										GetVehicleZAngle(i, Conce[c][con_v_A][a]);
										format(sss, 150, "Voce alterou o modelo deste veiculo da Conce, para [%d]!.", model);
	                					ms(playerid, 5, sss);
										atualizar_veiculo_conce(c, a);
										salvar_concessionaria(c);
										return 1;
						        }
						    }
						}
					    }
					}
	                ms(playerid, 0, "Voce nao pode alterar o modelo deste veiculo !");
				}

		    }
		    else ms(playerid, 0, "Voce nao pode alterar o modelo deste veiculo !");
		}
		else ms(playerid, 0, "Voce nao esta em um veiculo !");
		return 1;
	}



	if(!strcmp(cmd, "/trazerveiculo", true))
	{
		new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /trazerveiculo [ID do Veiculo].");
		if(i < 0 || i >= MAX_VEHICLES) return ms(playerid, 0, "Este veiculo nao existe !");
		if(GetVehicleModel(i) == 0) return ms(playerid, 0, "Este veiculo nao existe !");
	    format(string_prox, 300, "** O Admin '%s' puxou o veiculo ID: %d '%s' **", Nome(playerid), i, NomeVeiculo(GetVehicleModel(i)));
		ProxDetector(20.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
		new Float:p[4];
		GetPlayerPos(playerid, p[0], p[1], p[2]);
		GetPlayerFacingAngle(playerid, p[3]);
		PegarFrente(p[0], p[1], p[3], 3);
		SetVehiclePos(i, p[0], p[1], p[2]);
		SetVehicleZAngle(i, p[3]+90.0);
		return 1;
	}

	if(!strcmp(cmd, "/irveiculo", true))
	{
		new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /irveiculo [ID do Veiculo].");
		if(i < 0 || i >= MAX_VEHICLES) return ms(playerid, 0, "Este veiculo nao existe !");
		if(GetVehicleModel(i) == 0) return ms(playerid, 0, "Este veiculo nao existe !");
	    format(string_prox, 300, "** O Admin '%s' foi ate o veiculo ID: %d '%s' **", Nome(playerid), i, NomeVeiculo(GetVehicleModel(i)));
		ProxDetector(20.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
		new Float:p[4];
		GetVehiclePos(i, p[0], p[1], p[2]);
		GetVehicleZAngle(i, p[3]);
		PegarFrente(p[0], p[1], p[3], 2);
		SetPlayerPos_(playerid, p[0], p[1], p[2]);
		return 1;
	}

	if(!strcmp(cmd, "/destruirveiculo", true))
	{
		new i;
	    if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /destruirveiculo [ ID ].");
		if(GetVehicleModel(i) == 0) return ms(playerid, 0, "Este veiculo nao existe.");
	    if(DestruirVeiculo(i)) ms(playerid, 5, "Voce destruiu este veiculo.");
	    else ms(playerid, 0, "Voce nao pode destruir esse ID de veiculo !");
		return 1;
	}

	if(!strcmp(cmd, "/criarveiculo", true))
	{
		new dono;
		new sss[300];
		new model;
		new c1,c2;
		new Float:pos[4];
		GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
		GetPlayerFacingAngle(playerid, pos[3]);
		if(sscanf(params, "dddd", model, dono, c1, c2)) return ms(playerid, 2, "Use: /criarveiculo [ modelo ] [ ID da Conta ] [ cor 1 ] [ cor 2 ]");
	    if(model < 400 || model > 611) return ms(playerid, 0, "Use um modelo de 400 - 611 !");

		if(dono == -1)
		{
		    new idv = CriarVeiculo(1,1, model, pos[0], pos[1], pos[2], pos[3], c1, c2, dono);
		    if(idv == -1) return ms(playerid, 0, "Numero maximo de veiculos do servidor atingido !");
		    new veh = Veiculo[idv][v_ID];
		    PutPlayerInVehicle(playerid, veh, 0);
		    SalvarVeiculo(veh);
		    format(sss, 300, "Voce criou o veiculo [%d], Info: %d.", veh, idv);
		    ms(playerid, 5, sss);
		    return 1;
		}

		if(ContaInvalida(dono)) return ms(playerid, 0, "Esta conta nao existe !");
		new idv = CriarVeiculo(1, 1, model, pos[0], pos[1], pos[2], pos[3], c1, c2, dono);
		if(idv == -1) return ms(playerid, 0, "Numero maximo de veiculos do servidor atingido !");
		new veh = Veiculo[idv][v_ID];
	    format(sss, 300, "Voce criou o veiculo [%d], Info: %d.", veh, idv);
		ms(playerid, 5, sss);
	    PutPlayerInVehicle(playerid, veh, 0);
	    SalvarVeiculo(veh);
		return 1;
	}

	if(!strcmp(cmd, "/ajudaorgs", true))
	{
		SG[0] = EOS;
		strcat(SG, "\n");
		strcat(SG, "\n");
		strcat(SG, "{ffffff}/criarorg {a1a1a1}Para criar uma nova Org.\n");
		strcat(SG, "{ffffff}/limparcofreorg {a1a1a1}limpar limpar a grana do cofre da Organizacao.\n");
		strcat(SG, "{ffffff}/limparmembrosorg {a1a1a1}limpar os membros ( menos o lider ).\n");
		strcat(SG, "{ffffff}/limpararmasorg {a1a1a1}limpar as Armas da Organizacao.\n");
		strcat(SG, "{ffffff}/destruirorg {a1a1a1}Para destruir uma Org que ja existe.\n");
		strcat(SG, "{ffffff}/tipoorg {a1a1a1}Para setar o tipo de uma Org.\n");
		strcat(SG, "{ffffff}/irorg {a1a1a1}Para ir ate uma Org.\n");
		strcat(SG, "{ffffff}/nomeorg {a1a1a1}Para definir o Nome de uma Org.\n");
		strcat(SG, "{ffffff}/tagorg {a1a1a1}Para definir a Tag de uma Org.\n");
		strcat(SG, "{ffffff}/setarliderorg {a1a1a1}Para setar o lider uma Org (ID da conta).\n");
		strcat(SG, "{ffffff}/limparliderorg {a1a1a1}Para Limpar a vaga do lider uma Org.\n");
		strcat(SG, "{ffffff}/verlogorg {a1a1a1}Para ver os Logs de uma Org.\n");
		strcat(SG, "{ffffff}/trazerorg {a1a1a1}Para mudar o local de uma Org.\n");
		strcat(SG, "{ffffff}/localorg {a1a1a1}Para mudar a localizacao da Org do /orgs.\n");
		strcat(SG, "{ffffff}/skinsorg {a1a1a1}Para setar as skins de uma Org.\n");
		strcat(SG, "{ffffff}/cororg {a1a1a1}Para setar a cor de uma Org.\n");
		strcat(SG, "{ffffff}/mapaorg {a1a1a1}Para setar icone do mapa da Org.\n");
		strcat(SG, "\n");
		strcat(SG, "\n");
		ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{00ffff}AJUDA COM ORGANIZACOES", SG, "Ok", "Fechar");
		return 1;
	}

	if(!strcmp(cmd, "/nomeorg", true))
	{
	    new i, d[40];
		if(sscanf(params, "ds[40]", i, d)) return ms(playerid, 2, "Use: /nomeorg [ ID da org ] [ Nome ].");
		if(i < 0 || i >= MAX_ORGS) return ms(playerid, 0, "ID de organizacao invalido !");
		if(Org[i][o_Existe] == 0) return ms(playerid, 0, "Esta Org nao existe !");
		format( Org[i][o_Nome], 60, d);
		new sss[100];
		format(sss, 100, "Voce definiu o nome da org [%d] para '%s'.", i, Org[i][o_Nome]);
		ms(playerid, 5, sss);
		atualizar_org(i);
		salvar_org(i);
		return 1;
	}
	
	if(!strcmp(cmd, "/limparcofreorg", true))
	{
	    new i;
		if(sscanf(params, "d", i)) return ms(playerid, 2, "Use: /limparcofreorg [ ID da org ].");
		if(i < 0 || i >= MAX_ORGS) return ms(playerid, 0, "ID de organizacao invalido !");
		if(Org[i][o_Existe] == 0) return ms(playerid, 0, "Esta Org nao existe !");
		new sss[300];
		Org[i][o_Cofre] = 0;
		format(sss, 100, "Voce Limpou o cofre da org [%d] '%s'.", i, Org[i][o_Nome]);
		ms(playerid, 5, sss);
		atualizar_org(i);
		format(sss, 300, "O admin '%s' Limpou o cofre da Organizacao.", Nome(playerid));
		escrever_log(f("OrgsLog/Org_%d.txt", i), sss);
		salvar_org(i);
		return 1;
	}

	if(!strcmp(cmd, "/tagorg", true))
	{
	    new i, d[40];
		if(sscanf(params, "ds[40]", i, d)) return ms(playerid, 2, "Use: /tagorg [ ID da org ] [ Tag ].");
		if(i < 0 || i >= MAX_ORGS) return ms(playerid, 0, "ID de organizacao invalido !");
		if(Org[i][o_Existe] == 0) return ms(playerid, 0, "Esta Org nao existe !");
		format( Org[i][o_Tag], 10, d);
		new sss[100];
		format(sss, 100, "Voce definiu a Tag da org [%d] para '%s'.", i, Org[i][o_Tag]);
