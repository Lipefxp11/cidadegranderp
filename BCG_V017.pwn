	        new Float:p[4];
   			GetPlayerPos(playerid, p[0], p[1], p[2]);

			if(cidade_gas[playerid] == 0)
	        {
			    new r = random(sizeof EntregasLosSantos);
				entrega_gas[playerid] = r; // ID do local
				GetDistance(p[3], p[0],p[1],p[2], EntregasLosSantos[r][0], EntregasLosSantos[r][1], EntregasLosSantos[r][2]);
				distancia_gas[playerid] = floatround(p[3]);
				ms(playerid, 1, "Voce pegou uma nova entrega, ao concluir voce ganha R$ 50 e a taxa de entrega dependendo da distancia.");
				Localizar_Player(playerid, EntregasLosSantos[r][0], EntregasLosSantos[r][1], EntregasLosSantos[r][2], 100, -1, "LOCAL DE ENTREGA");
	        }

	        if(cidade_gas[playerid] == 1)
	        {
			    new r = random(sizeof EntregasSanFierro);
				entrega_gas[playerid] = r; // ID do local
				GetDistance(p[3], p[0],p[1],p[2], EntregasSanFierro[r][0], EntregasSanFierro[r][1], EntregasSanFierro[r][2]);
				distancia_gas[playerid] = floatround(p[3]);
