stock MostrarTuning(playerid, veh, cat)
{
	new cont2 = 0;
	new componentid;
	for(new i; i<MAX_VEHICLES_COMPONENTS; i++)
	{
	    componentid = i+1000;
	    if(VeiculoComponente(veh, componentid))
		{
			if(CategoriasComponentes[i] == Categorias[cat][cat_ID]) cont2 = 1;
		}
	}
	if(cont2 == 0) ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}_", "{a1a1a1}Nao ha componentes nessa categoria para este veiculo !\n", "Ok", "Fechar");
	else
	{
		menu_id[playerid] = MENU_TUNING17;
		pagina_menu[playerid] = 0;
		escolhendo_menu[playerid] = 0;
		format(nome_menu[playerid], 100, Categorias[cat][cat_Nome]);
		format(botao_menu[playerid], 100, "Instalar");
		new cont;
	    for(new i; i<MAX_VEHICLES_COMPONENTS; i++)
		{
		    componentid = i+1000;
		    if(VeiculoComponente(veh, componentid))
	        {
	            if(CategoriasComponentes[i] != Categorias[cat][cat_ID]) continue;
			    Menu[playerid][cont][menu_ID] = componentid;
			    Menu[playerid][cont][menu_Unidades] = 1;
			    Menu[playerid][cont][menu_Tipo] = cat;
			    Menu[playerid][cont][menu_Valor] = cont;
			    format(Menu[playerid][cont][menu_Nome], 200, "%d - %s", i, gVehicleComponentName[i]);
			    format(Menu[playerid][cont][menu_Info], 200, "Use 'INSTALAR' para colocar o Componente no veiculo.");
			    Menu[playerid][cont][menu_Modelo] = componentid;
			    cont ++;
		    }
		}
		max_menu[playerid] = cont;
		mostrar_menu(playerid, menu_id[playerid]);
	}
}


