				SetPlayerInterior(playerid, CaixaEletronico[i][ce_Interior]);
				SetPlayerVirtualWorld_(playerid, CaixaEletronico[i][ce_Mundo]);
				ms(playerid, 5, "[CAMERAS] Voce entrou no sistema da camera, aperte F ou ENTER para sair ou trocar de camera.");
				GameTextForPlayer(playerid, "~W~APERTE ~Y~F ~w~OU ~Y~ENTER ~W~PARA~N~~B~~H~ABRIR O MENU", 2000, 3);
	            return 1;
	        }

	        Conta[playerid][c_Interior] = GetPlayerInterior(playerid);
			Conta[playerid][c_Mundo] = GetPlayerVirtualWorld_(playerid);
	        GetPlayerPos(playerid, Conta[playerid][c_X], Conta[playerid][c_Y], Conta[playerid][c_Z]);
	        GetPlayerFacingAngle(playerid, Conta[playerid][c_A]);
			salvar_conta(c, -1, "c_Posicao");
			salvar_conta(c, playerid, "c_Armas");
	        if(IsValidDynamicActor(actor_player[playerid])) DestroyDynamicActor(actor_player[playerid]);
            if(IsValidDynamic3DTextLabel(actor_player_3D[playerid])) DestroyDynamic3DTextLabel(actor_player_3D[playerid]);
			actor_player[playerid] = CreateDynamicActor(GetPlayerSkin_(playerid), Conta[playerid][c_X], Conta[playerid][c_Y], Conta[playerid][c_Z], Conta[playerid][c_A], 0, 9999999.0, Conta[playerid][c_Mundo], Conta[playerid][c_Interior], -1, STREAMER_ACTOR_SD, -1, 0);
            new str_nick[150];
			format(str_nick, 150, "{00ffff}%d {ffff00}%d\n{a1a1a1}OLHANDO CAMERA", c, playerid);
			actor_player_3D[playerid] = CreateDynamic3DTextLabel( str_nick, 0xffffffff, Conta[playerid][c_X], Conta[playerid][c_Y], Conta[playerid][c_Z]+1.15, 15, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, Conta[playerid][c_Mundo], Conta[playerid][c_Interior], -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
			TogglePlayerSpectating(playerid, true);
			olhando_camera[playerid] = 1;
			olhando_camera_id[playerid] = i;
			InterpolateCameraPos(playerid, CaixaEletronico[i][cec_X],CaixaEletronico[i][cec_Y],CaixaEletronico[i][cec_Z], CaixaEletronico[i][cec_X],CaixaEletronico[i][cec_Y],CaixaEletronico[i][cec_Z], 1000, CAMERA_CUT);
			InterpolateCameraLookAt(playerid, CaixaEletronico[i][ce_X],CaixaEletronico[i][ce_Y],CaixaEletronico[i][ce_Z], CaixaEletronico[i][ce_X],CaixaEletronico[i][ce_Y],CaixaEletronico[i][ce_Z], 1000, CAMERA_CUT);
			SetPlayerInterior(playerid, CaixaEletronico[i][ce_Interior]);
			SetPlayerVirtualWorld_(playerid, CaixaEletronico[i][ce_Mundo]);
			ms(playerid, 5, "[CAMERAS] Voce entrou no sistema da camera, aperte F ou ENTER para sair ou trocar de camera.");
			GameTextForPlayer(playerid, "~W~APERTE ~Y~F ~w~OU ~Y~ENTER ~W~PARA~N~~B~~H~ABRIR O MENU", 2000, 3);
			return 1;
		}
	}
	return 0;
}

stock mostrar_cameras_caixas(playerid)
{
    SG[0] = EOS;
	new cont;
	zerar_lista(playerid);
	foreach(new i:Iter_CaixasEletronicos)
	{
	    if(cont >= MAX_LISTA) break;
	    if(CaixaEletronico[i][ce_Existe] == 1)
	    {
			if(CaixaEletronico[i][cec_Quebrado] == 0) strcat(SG, "{ffffff}Caixa Eletronico[ ");
			else strcat(SG, "{ff0000}Caixa Eletronico[ ");
			strcat(SG, ConvertMoney(i));
			strcat(SG, " ]\n");
			Lista[playerid][cont] = i;
			cont++;
	    }
	}
	ShowPlayerDialog(playerid, DIALOG_CAMERAS2, DIALOG_STYLE_LIST, "Cameras dos Caixas Eletronicos", SG, "Continuar", "Fechar");
}


stock sair_camera(playerid)
{
    new c = id[playerid];
	if(c == -1) return 1;
    if(IsValidDynamicActor(actor_player[playerid])) DestroyDynamicActor(actor_player[playerid]);
	if(IsValidDynamic3DTextLabel(actor_player_3D[playerid])) DestroyDynamic3DTextLabel(actor_player_3D[playerid]);
	actor_player_3D[playerid] = DynamicText3D:-1;
	actor_player[playerid] = -1;
	olhando_camera[playerid] = -1;
	olhando_camera_id[playerid] = -1;
	atualizar_conta(c);
	limpar_chat[playerid] = 1;
	TogglePlayerSpectating(playerid, false);
	PlayerSpawn(playerid);
	carregar_mapa(playerid);
	ms(playerid, 1, "Voce saiu do Sistema de Cameras !");
	return 1;
}

stock mostrar_atendimentos(playerid)
{
	SG[0] = EOS;
	new linha[150];
	new cont;
	strcat(SG, "ID Atendimento\tConta          Jogador\tPrioridade\tEspera\n");
	for(new i; i<MAX_ATENDIMENTOS; i++)
	{
	    if(Atendimento[i][at_Existe] == 1)
	    {
	        format(linha, 150, "{a1a1a1}%d\t{00ffff}%d     {ffffff}%s\t%s\t{a1a1a1}%s\n", i, Atendimento[i][at_Player], NomeConta(Atendimento[i][at_Player]), prioridade(Atendimento[i][at_Prioridade]), ConvertTime(gettime()-Atendimento[i][at_Iniciado]));
			strcat(SG, linha);
			atendimentos_player[playerid][cont] = i;
			cont++;
	    }
	}
	format(linha, 150, "{ffffff}Atendimentos em Espera {a1a1a1}[%d]", cont);
	ShowPlayerDialog(playerid, DIALOG_ATENDIMENTOS, DIALOG_STYLE_TABLIST_HEADERS, linha, SG, "Atender", "Fechar");
	return 1;
}

stock prioridade(att)
{
	new sss[100];
	if(att == 0) format(sss, 100, "{4169E1}Baixa");
	if(att == 1) format(sss, 100, "{ffff00}Media");
	if(att == 2) format(sss, 100, "{ff0000}Alta");
	return sss;
}

stock prioridade2(att)
{
	new sss[100];
	if(att == 0) format(sss, 100, "Baixa");
	if(att == 1) format(sss, 100, "Media");
	if(att == 2) format(sss, 100, "Alta");
	return sss;
}

stock criar_atendimento(playerid, priori)
{
	new c = id[playerid];
	if(c == -1) return 1;
	for(new i; i<MAX_ATENDIMENTOS; i++)
	{
	    if(Atendimento[i][at_Existe] == 0)
	    {
	        Atendimento[i][at_Existe] = 1;
	        Atendimento[i][at_Prioridade] = priori;
	        Atendimento[i][at_Player] = c;
	        Atendimento[i][at_Admin] = -1;
	        Atendimento[i][at_Iniciado] = gettime();
	        Atendimento[i][at_Atendido] = 0;
	        Atendimento[i][at_Finalizado] = 0;
			new str[150];
			format(str, 150, "[ATENDIMENTOS] O jogador %s [%d] solicitou um adentimento de prioridade: %s, use /atender %d.", Nome(playerid), playerid, prioridade2(priori), i);
	        foreach(new a:Player) if(Online(a)) if(AdminPlayer(a) > 0) ms(a, 5, str);
	        return 1;
	    }
	}
	return 0;
}

stock destruir_atendimento(i)
{
	Atendimento[i][at_Existe] = 0;
    Atendimento[i][at_Prioridade] = 0;
    Atendimento[i][at_Player] = -1;
    Atendimento[i][at_Admin] = -1;
    Atendimento[i][at_Iniciado] = 0;
    Atendimento[i][at_Atendido] = 0;
    Atendimento[i][at_Finalizado] = 0;
	return 1;
}

stock spawn_veiculo_desocupado(i, con, tempo)
{
	if(GetVehicleModel(i) != 0)
	{
		new inf = Info_Veiculo[i];
		if(inf != -1)
		{
		    new sss[150];
		    new Float:pos[3];
		    GetVehiclePos(i, pos[0], pos[1], pos[2]);
		    if(con == 0)
			{
				printf("O veiculo '%s' do emprego %s, passou %d minutos desocupado e foi Respawnado.", NomeVeiculo(GetVehicleModel(i)), NomeEmprego(Veiculo[inf][v_Emprego]), tempo/60);
				format(sss, 150, "O veiculo '%s' do emprego %s, passou %d minutos desocupado e foi Respawnado.", NomeVeiculo(GetVehicleModel(i)), NomeEmprego(Veiculo[inf][v_Emprego]), tempo/60);
			}
			else
			{
				printf("O veiculo Publico '%s', passou %d minutos desocupado e foi Respawnado.", NomeVeiculo(GetVehicleModel(i)), tempo/60);
				format(sss, 150, "O veiculo Publico '%s', passou %d minutos desocupado e foi Respawnado.", NomeVeiculo(GetVehicleModel(i)), tempo/60);
			}
			foreach(new a:Player)
			{
			    if(Online(a))
				{
				if(IsPlayerInRangeOfPoint(a, 50, pos[0], pos[1], pos[2]))
				{
				    if(id[a] != -1)
					{
				        ms(a, 5, sss);
				    }
				}
			    }
			}
			Veiculo[inf][v_Gasolina] = 100;
			Veiculo[inf][v_Bateria] = 100;
			Veiculo[inf][v_Vida] = 1000.0;
			SalvarVeiculo(i);
            SpawnVeiculo(i);
		}
	}
	return 1;
}

stock revistar(playerid, i)
{
	new cc = id[i];
	if(cc == -1) return 1;
	if(player_rendido[i] == 0) return ms(playerid, 0, "Este jogador precisa usar /render primeiro !");
	new Float:pos[4];
	GetPlayerPos(i, pos[0], pos[1], pos[2]);
	GetPlayerFacingAngle(i, pos[3]);
	if(!IsPlayerInRangeOfPoint(playerid, 5, pos[0], pos[1], pos[2])) return ms(playerid, 0, "Jogador muito distante tente novamente !");
	PegarFrente(pos[0], pos[1], pos[3], -1.1);
	SetPlayerPos_(playerid, pos[0], pos[1], pos[2]);
	SetPlayerFacingAngle(playerid, pos[3]);
	revistando[playerid] = i;
	Acao(playerid, 10, 150, "REVISTANDO", 1, "BD_FIRE", "WASH_UP", true);
	format(string_prox, 300, "** '%s' esta revistando '%s' **", Nome(playerid), Nome(i));
	ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
	return 1;
}

stock terminar_revista(playerid, i)
{
    new cc = id[i];
	if(cc == -1) return 1;
	new cont;
	new cont2;
	new sss[150];
	SG[0] = EOS;


	strcat(SG, "\n{00ffff}DINHEIRO EM MAOS:\n");
	format(sss, 150, "{4169E1}R$ %s\n", ConvertMoney(GranaPlayer(i)));
	strcat(SG, sss);

	strcat(SG, "\n{00ffff}DINHEIRO SUJO:\n");
	new grana;
	for(new a; a<MAX_SLOTS; a++) if(Inventario[i][a][inv_ID] == 76) grana += Inventario[i][a][inv_Unidades];
	format(sss, 150, "{FF8C00}R$ %s\n", ConvertMoney(grana));
	strcat(SG, sss);


	strcat(SG, "\n{00ffff}ARMAS EM MAOS:\n");
	new weapon[13][2];
	for(new w; w<13; w++)
	{
		GetPlayerWeaponData(i, w, weapon[w][0], weapon[w][1]);
		if(weapon[w][0] != 0)
		{
			cont ++;
			format(sss, 150, "{ffffff}%s {a1a1a1}%s Municoes\n", nome_arma(weapon[w][0]), ConvertMoney(weapon[w][1]));
            strcat(SG, sss);
		}
	}
	if(cont == 0) strcat(SG, "{a1a1a1}Nenhuma\n\n{00ffff}ARMAS NO INVENTARIO:\n");
	else strcat(SG, "\n\n{00ffff}ARMAS NO INVENTARIO:\n");


	for(new a; a<MAX_SLOTS; a++)
	{
	    if(Inventario[i][a][inv_ID] > 0 && Inventario[i][a][inv_ID] < 49)
	    {
	        cont2++;
	        format(sss, 150, "{ffffff}%s {a1a1a1}%s Unidades\n", NomeItem(Inventario[i][a][inv_ID]), ConvertMoney(Inventario[i][a][inv_Unidades]));
            strcat(SG, sss);
	    }
	}
	if(cont2 == 0) strcat(SG, "{a1a1a1}Nenhuma{00ffff}\n\n");
	else strcat(SG, "\n\n{00ffff}");

	strcat(SG, "\n");
	ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, NomeConta(cc), SG, "Ok", "Fechar");
	return 1;
}

stock criar_explosao(Float:xx, Float:yy, Float:zz, range, tipo, inter, mund)
{
	foreach(new i:Player)
	{
		if(IsPlayerConnected(i))
		{
		    if(IsPlayerInRangeOfPoint(i, range, xx, yy, zz))
		    {
				if(GetPlayerInterior(i) == inter )
				{
				if(GetPlayerVirtualWorld_(i) == mund)
				{
		        		CreateExplosionForPlayer(i, xx, yy, zz, tipo, range);
		            }
		        }
		    }
		}
	}
	return 1;
}

stock quebrar_camera(playerid, i, con)
{
	new c = id[playerid];
	if(c == -1) return 1;
	new sss[150];
	if(Online(playerid))
	{
	    // camera da cidade //
		if(con == 0)
		{
		    criar_explosao(Camera[i][cam_X], Camera[i][cam_Y], Camera[i][cam_Z], 300, 12, Camera[i][cam_Interior], Camera[i][cam_Mundo]);
		    Camera[i][cam_Quebrada] = 1;
		    ms(playerid, 2, "Voce destruiu uma camera, e a policia foi avisada !");
		    aplicar_su(playerid, -1, 17);
	        format(sss, 150, "O jogador '%s' destruiu a Camera de Seguranca '%s' [%d].", Nome(playerid), Camera[i][cam_Nome], i);
	        foreach(new aa:Player)
			{
			    if(Online(aa))
				{
				if(olhando_camera[aa] == 0)
				{
				    if(olhando_camera_id[aa] == i)
					{
							sair_camera(aa);
				    }
				}
			    }
			}
			atualizar_camera(i, 1);
			salvar_camera(i);
		}

        // caixas eletronicos //
		if(con == 1)
		{
		    criar_explosao(CaixaEletronico[i][cec_X], CaixaEletronico[i][cec_Y], CaixaEletronico[i][cec_Z], 300, 12, CaixaEletronico[i][ce_Interior], CaixaEletronico[i][ce_Mundo]);
            CaixaEletronico[i][cec_Quebrado] = 1;
            //CaixaEletronico[i][cec_TempoFogo] = gettime()+(30*60);
            ms(playerid, 2, "Voce destruiu uma camera, e a policia foi avisada !");
            aplicar_su(playerid, -1, 17);
            format(sss, 150, "O jogador '%s' destruiu a Camera de Seguranca do Caixa Eletronico [%d].", Nome(playerid), i);
            foreach(new aa:Player)
			{
			    if(Online(aa))
				{
				if(olhando_camera[aa] == 1)
				{
				    if(olhando_camera_id[aa] == i)
					{
							sair_camera(aa);
				    }
				}
			    }
			}
			atualizar_caixa_eletronico(i, 1);
			salvar_caixa_eletronico(i);
		}

		mscop(sss);
	}
	return 1;
}

stock usar_explosivo(playerid, a)
{
	new c = id[playerid];
	if(c == -1) return 1;
	if(Online(playerid))
	{
	    zerar_lista(playerid, 1);
	    SetPVarInt(playerid, "slot", a);
		foreach(new i:Iter_CaixasEletronicos)
		{
		    if(CaixaEletronico[i][ce_Existe] == 1)
	        {
	            if(CaixaEletronico[i][ce_Quebrado] == 0)
	            {
	                if(IsPlayerInRangeOfPoint(playerid, 2, CaixaEletronico[i][ce_X], CaixaEletronico[i][ce_Y], CaixaEletronico[i][ce_Z]))
	                {
	                    if(GetPlayerInterior(playerid) == CaixaEletronico[i][ce_Interior])
	                    {
	                        if(GetPlayerVirtualWorld_(playerid) == CaixaEletronico[i][ce_Mundo])
	                        {
	                            Lista[playerid][0] =  i;
		    					Lista2[playerid][0] = 0;
		    					continuar_explosivo(playerid, 0);
		    					return 1;
	                        }
	                    }
	                }
		        }
		    }
		}

		new Float:pos[4];
		foreach(new v:Vehicles)
		{
		    if(GetVehicleModel(v) != 0)
		    {
		        new d = Info_Veiculo[v];
		        if(d != -1)
		        {
		            if(Veiculo[d][v_Emprego] == 6)
			       	{
					GetVehiclePos(v, pos[0], pos[1], pos[2]);
						GetVehicleZAngle(v, pos[3]);
						PegarFrente(pos[0], pos[1], pos[3], -3.5);
						if(IsPlayerInRangeOfPoint(playerid, 2.2, pos[0], pos[1], pos[2]))
						{
                            Lista[playerid][0] =  v;
	    					Lista2[playerid][0] = 1;
	    					continuar_explosivo(playerid, 0);
	    					return 1;
						}
				}
		        }
			}
		}

		new i = GetPlayerVirtualWorld_(playerid);
		if(i > -1 && i < MAX_EMPRESAS)
		{
      		if(IsPlayerInRangeOfPoint(playerid, 1.5, pos_cofre[0], pos_cofre[1], pos_cofre[2]))
		    {
				if(Cofre[i][cofre_Status] == 0)
				{
				    if(!PlayerMafia(playerid) && !PlayerFac(playerid) && !PlayerTerrorista(playerid))
                        return ms(playerid, 0, "Apenas organizacoes criminosas podem explodir cofres!");
                    Lista[playerid][0] =  i;
					Lista2[playerid][0] = 2;
					continuar_explosivo(playerid, 0);
	    			return 1;
				}
		    }
		    if(IsPlayerInRangeOfPoint(playerid, 2.5, pos_porta[0], pos_porta[1], pos_porta[2]))
		    {
                if(Cofre[i][cofre_Status2] == 0)
				{
				    if(!PlayerMafia(playerid) && !PlayerFac(playerid) && !PlayerTerrorista(playerid))
                        return ms(playerid, 0, "Apenas organizacoes criminosas podem explodir portas de cofre!");
                    Lista[playerid][0] =  i;
					Lista2[playerid][0] = 3;
					continuar_explosivo(playerid, 0);
	    			return 1;
				}
		    }
		}
		continuar_explosivo(playerid, 0);
	}
	return 1;
}

stock continuar_explosivo(playerid, listitem)
{
    new slot = GetPVarInt(playerid, "slot");
    new idd = Lista[playerid][listitem];
    new tipo = Lista2[playerid][listitem];

    // plantar em caixa eletronico //
    if(tipo == 0)
    {
        if(CaixaEletronico[idd][ce_Dinheiro] < 1500)
        {
            usar_explosivo(playerid, slot);
            ms(playerid, 0, "Este caixa eletronico tem pouco dinheiro !");
            return 1;
		}
        if(explosivo_proximo(playerid))
        {
            usar_explosivo(playerid, slot);
            ms(playerid, 0, "Ja tem um Explosivo plantado muito proximo a este local !");
            return 1;
        }
        if(plantando_explosivo_caixa(player_c4_id[playerid], playerid))
        {
            usar_explosivo(playerid, slot);
            ms(playerid, 0, "Alguem ja esta plantando um Explosivo neste caixa eletronico !");
            return 1;
        }
        if(caixa_com_explosivo(player_c4_id[playerid]))
        {
            usar_explosivo(playerid, slot);
            ms(playerid, 0, "Ja tem um explosivo plantado neste caixa eletronico !");
            return 1;
        }
        player_c4[playerid] = tipo;
    	player_c4_id[playerid] = idd;
        SetPlayerToFacePos(playerid, CaixaEletronico[idd][ce_X], CaixaEletronico[idd][ce_Y]);
        Acao(playerid, 11, 200, "PLANTANDO EXPLOSIVO", 1, "COP_AMBIENT", "COPBROWSE_LOOP", true);
        SetPlayerAttachedObject(playerid, 9, 1654, 6, 0.103999, 0.221000, -0.040999, -102.099975, -175.699996, 96.599990, 1.000000, 1.000000, 1.000000);
		return 1;
	}

    // plantar em caixa eletronico //
    if(tipo == 1)
    {
        if(malotes_veiculo[Info_Veiculo[idd]] < 1)
        {
            usar_explosivo(playerid, slot);
            ms(playerid, 0, "Este carro forte esta sem malotes de grana !");
            return 1;
        }
        if(explosivo_proximo(playerid))
        {
            usar_explosivo(playerid, slot);
            ms(playerid, 0, "Ja tem um Explosivo plantado muito proximo a este local !");
            return 1;
        }
        if(plantando_explosivo_carro(player_c4_id[playerid], playerid))
        {
            usar_explosivo(playerid, slot);
            ms(playerid, 0, "Alguem ja esta plantando um Explosivo neste carro forte !");
            return 1;
        }
        if(carro_com_explosivo(player_c4_id[playerid]))
        {
            usar_explosivo(playerid, slot);
            ms(playerid, 0, "Ja tem um explosivo plantado neste carro forte !");
            return 1;
        }
        player_c4[playerid] = tipo;
    	player_c4_id[playerid] = idd;
    	new Float:pos[3];
    	GetVehiclePos(idd, pos[0], pos[1], pos[2]);
    	SetPlayerToFacePos(playerid, pos[0], pos[1]);
        Acao(playerid, 11, 200, "PLANTANDO EXPLOSIVO", 1, "COP_AMBIENT", "COPBROWSE_LOOP", true);
        SetPlayerAttachedObject(playerid, 9, 1654, 6, 0.103999, 0.221000, -0.040999, -102.099975, -175.699996, 96.599990, 1.000000, 1.000000, 1.000000);
		return 1;
	}

	// plantar em cofre de empresa //
    if(tipo == 2)
    {
        if(explosivo_proximo(playerid))
        {
            usar_explosivo(playerid, slot);
            ms(playerid, 0, "Ja tem um Explosivo plantado muito proximo a este local !");
            return 1;
        }
        if(plantando_explosivo_cofre(player_c4_id[playerid], playerid))
        {
            usar_explosivo(playerid, slot);
            ms(playerid, 0, "Alguem ja esta plantando um Explosivo neste Cofre !");
            return 1;
        }
        if(cofre_com_explosivo(player_c4_id[playerid]))
        {
            usar_explosivo(playerid, slot);
            ms(playerid, 0, "Ja tem um explosivo plantado neste Cofre !");
            return 1;
        }
        player_c4[playerid] = tipo;
    	player_c4_id[playerid] = idd;
        SetPlayerToFacePos(playerid, pos_cofre[0], pos_cofre[1]);
        Acao(playerid, 11, 200, "PLANTANDO EXPLOSIVO", 1, "COP_AMBIENT", "COPBROWSE_LOOP", true);
        SetPlayerAttachedObject(playerid, 9, 1654, 6, 0.103999, 0.221000, -0.040999, -102.099975, -175.699996, 96.599990, 1.000000, 1.000000, 1.000000);
		return 1;
    }

    // plantar em porta de cofre de empresa //
    if(tipo == 3)
    {
        if(explosivo_proximo(playerid))
        {
            usar_explosivo(playerid, slot);
            ms(playerid, 0, "Ja tem um Explosivo plantado muito proximo a este local !");
            return 1;
        }
        if(plantando_explosivo_porta_cofre(player_c4_id[playerid], playerid))
        {
            usar_explosivo(playerid, slot);
            ms(playerid, 0, "Alguem ja esta plantando um Explosivo neste Cofre !");
            return 1;
        }
        if(porta_cofre_com_explosivo(player_c4_id[playerid]))
        {
            usar_explosivo(playerid, slot);
            ms(playerid, 0, "Ja tem um explosivo plantado neste Cofre !");
            return 1;
        }
        player_c4[playerid] = tipo;
    	player_c4_id[playerid] = idd;
        SetPlayerToFacePos(playerid, pos_cofre[0], pos_cofre[1]);
        Acao(playerid, 11, 200, "PLANTANDO EXPLOSIVO", 1, "COP_AMBIENT", "COPBROWSE_LOOP", true);
        SetPlayerAttachedObject(playerid, 9, 1654, 6, 0.103999, 0.221000, -0.040999, -102.099975, -175.699996, 96.599990, 1.000000, 1.000000, 1.000000);
		return 1;
    }

    MS(playerid, 0, "Voce deve estar proximo a um Caixa eletronico, Porta de Cofre, Cofre ou atraz de um carro forte !");
    return 1;
}

stock explosivo_proximo(playerid)
{
	if(Online(playerid))
	{
	    for(new i; i<MAX_EXPLOSIVOS; i++)
	    {
	        if(Explosivo[i][explosivo_Existe] == 1)
	        {
	            if(IsPlayerInRangeOfPoint(playerid, 50, Explosivo[i][explosivo_X], Explosivo[i][explosivo_Y], Explosivo[i][explosivo_Z] ))
	            {
	                if(GetPlayerInterior(playerid) == Explosivo[i][explosivo_Interior])
	                {
	                    if(GetPlayerVirtualWorld_(playerid) == Explosivo[i][explosivo_Mundo])
	                	{
	                	    return 1;
	                	}
	                }
	            }
	        }
	    }
	}
    return 0;
}

stock plantando_explosivo_carro(i, playerid=-1)
{
    foreach(new a:Player)
    {
        if(playerid != a)
        {
	        if(Online(a))
	        {
	            if(player_c4[a] == 1)
	            {
	                if(player_c4_id[a] == i)
	                {
	                    return 1;
	                }
	            }
			}
		}
    }
	return 0;
}

stock plantando_explosivo_caixa(i, playerid=-1)
{
    foreach(new a:Player)
    {
        if(playerid != a)
        {
	        if(Online(a))
	        {
	            if(player_c4[a] == 0)
	            {
	                if(player_c4_id[a] == i)
	                {
	                    return 1;
	                }
	            }
			}
		}
    }
	return 0;
}


