				DOF2_SetInt(file, "c_Cargo", Conta[player][c_Cargo]);
				DOF2_SetInt(file, "c_Sexo", Conta[player][c_Sexo]);
				DOF2_SetInt(file, "c_Cidade", Conta[player][c_Cidade]);
				DOF2_SetInt(file, "c_Idade", Conta[player][c_Idade]);
				DOF2_SetInt(file, "c_Dia", Conta[player][c_Dia]);
				DOF2_SetInt(file, "c_Mes", Conta[player][c_Mes]);
				DOF2_SetInt(file, "c_Ano", Conta[player][c_Ano]);
				DOF2_SetInt(file, "c_Hora", Conta[player][c_Hora]);
				DOF2_SetInt(file, "c_Minuto", Conta[player][c_Minuto]);
				DOF2_SetInt(file, "c_Segundo", Conta[player][c_Segundo]);
				DOF2_SetInt(file, "c_Dia2", Conta[player][c_Dia2]);
				DOF2_SetInt(file, "c_Mes2", Conta[player][c_Mes2]);
				DOF2_SetInt(file, "c_Ano2", Conta[player][c_Ano2]);
				DOF2_SetInt(file, "c_Hora2", Conta[player][c_Hora2]);
				DOF2_SetInt(file, "c_Minuto2", Conta[player][c_Minuto2]);
				DOF2_SetInt(file, "c_Segundo2", Conta[player][c_Segundo2]);

				// nivel emprego //
				new linh[500];
				for(new e; e<MAX_EMPREGOS; e++)
				{
					strcat(linh, ConvertMoney(Conta[player][c_NivelEmprego][e]));
					strcat(linh, "|");
				}
				DOF2_SetString(file, "c_NivelEmprego", linh);

				// metas empregos //
				new linh2[500];
				for(new e; e<MAX_EMPREGOS; e++)
				{
					strcat(linh2, ConvertMoney(Conta[player][c_MetaEmprego][e]));
					strcat(linh2, "|");
				}
				DOF2_SetString(file, "c_MetaEmprego", linh2);
				DOF2_SetInt(file, "c_MetaHora", Conta[player][c_MetaHora]);
		        DOF2_SetInt(file, "c_Vida", Conta[player][c_Vida]);
		    	DOF2_SetInt(file, "c_Colete", Conta[player][c_Colete]);

		    	Conta[player][c_Interior] = GetPlayerInterior(player);
		    	Conta[player][c_Mundo] = GetPlayerVirtualWorld_(player);
		    	GetPlayerPos(player, Conta[player][c_X], Conta[player][c_Y], Conta[player][c_Z]);
		    	GetPlayerFacingAngle(player, Conta[player][c_A]);

		    	DOF2_SetInt(file, "c_Interior", Conta[player][c_Interior]);
		    	DOF2_SetInt(file, "c_Mundo", Conta[player][c_Mundo]);
		    	DOF2_SetFloat(file, "c_X", Conta[player][c_X]);
			    DOF2_SetFloat(file, "c_Y", Conta[player][c_Y]);
			    DOF2_SetFloat(file, "c_Z", Conta[player][c_Z]);
			    DOF2_SetFloat(file, "c_A", Conta[player][c_A]);

			    new sss1[40], sss2[40];
				for(new a; a<13; a++)
				{
				format(sss1, 40, "Arma_%d", a);
				format(sss2, 40, "Municao_%d", a);
				GetPlayerWeaponData(player, a, Conta[player][c_Arma][a], Conta[player][c_Municao][a]);
				DOF2_SetInt(file, sss1, Conta[player][c_Arma][a]);
				DOF2_SetInt(file, sss2, Conta[player][c_Municao][a]);
			    }
			    DOF2_SaveFile();
		    }
		}

	}
	else if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
}

stock carregar_chat(player, i)
{
    new file[80];
    new sss1[40];
	new aaa;
    format(file, 80, "ChatOff/%d.txt", i);
    if(DOF2_FileExists(file))
    {
	    for(new w; w<50; w++)
	    {
	        format(sss1, 40, "linha_tipo_%d", w);
	        aaa = DOF2_GetInt(file, sss1);
	        if(aaa != -1)
	        {
		        format(sss1, 40, "linha_%d", w);
		        menssagem_player(player, aaa, DOF2_GetString(file, sss1));
	        }
	    }
	    DOF2_RemoveFile(file);
    }
}

stock salvar_acessorios(playerid, i)
{
    new file[80];
    new sss1[40];
    // acessorios //
    format(file, 80, "Acessorios/%d.txt", i);
    if(!DOF2_FileExists(file)) DOF2_CreateFile(file);
    for(new w; w<MAX_ACESSORIOS; w++)
    {
        format(sss1, 40, "ac_Existe_%d", w);
        DOF2_SetInt(file, sss1, Acessorios[playerid][w][ac_Existe]);
        format(sss1, 40, "ac_Tempo_%d", w);
        DOF2_SetInt(file, sss1, Acessorios[playerid][w][ac_Tempo]);
        format(sss1, 40, "ac_Usando_%d", w);
        DOF2_SetInt(file, sss1, Acessorios[playerid][w][ac_Usando]);
        format(sss1, 40, "ac_ID_%d", w);
        DOF2_SetInt(file, sss1, Acessorios[playerid][w][ac_ID]);
        format(sss1, 40, "ac_Local_%d", w);
        DOF2_SetInt(file, sss1, Acessorios[playerid][w][ac_Local]);
        format(sss1, 40, "ac_X_%d", w);
  		DOF2_SetFloat(file, sss1, Acessorios[playerid][w][ac_X]);
  		format(sss1, 40, "ac_Y_%d", w);
  		DOF2_SetFloat(file, sss1, Acessorios[playerid][w][ac_Y]);
  		format(sss1, 40, "ac_Z_%d", w);
  		DOF2_SetFloat(file, sss1, Acessorios[playerid][w][ac_Z]);
  		format(sss1, 40, "ac_RX_%d", w);
  		DOF2_SetFloat(file, sss1, Acessorios[playerid][w][ac_RX]);
  		format(sss1, 40, "ac_RY_%d", w);
  		DOF2_SetFloat(file, sss1, Acessorios[playerid][w][ac_RY]);
  		format(sss1, 40, "ac_RZ_%d", w);
  		DOF2_SetFloat(file, sss1, Acessorios[playerid][w][ac_RZ]);
  		format(sss1, 40, "ac_TX_%d", w);
  		DOF2_SetFloat(file, sss1, Acessorios[playerid][w][ac_TX]);
  		format(sss1, 40, "ac_TY_%d", w);
  		DOF2_SetFloat(file, sss1, Acessorios[playerid][w][ac_TY]);
  		format(sss1, 40, "ac_TZ_%d", w);
  		DOF2_SetFloat(file, sss1, Acessorios[playerid][w][ac_TZ]);
	}
	DOF2_SaveFile();
}


