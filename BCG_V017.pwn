stock mostrar_armas_novo(playerid, con=-1)
{
    new conta = id[playerid];
    if(conta != -1)
    {
        new cont, a1, a2;
		if(con == -1)
		{
		    mostrando_armas[playerid] = 1;
	        for(new a; a<sizeof T_Armas; a++) TextDrawShowForPlayer(playerid, T_Armas[a]);
		    for(new i; i<13; i++)
		    {
		        ListaArmas[playerid][i] = -1;
		        GetPlayerWeaponData(playerid, i, a1, a2);
		        if(a1 != 0)
		        {
		            ListaArmas[playerid][cont] = i;
	                cont++;
		        }
		    }
		    if(cont == 0) id_arma[playerid] = -1;
		    else id_arma[playerid] = 0;
		    SetPVarInt(playerid, "cont_armas", cont);
		    if(cont < 2)
		    {
		        TextDrawHideForPlayer(playerid, T_Armas[4]);
		        TextDrawHideForPlayer(playerid, T_Armas[5]);
		    }
		}
		if(id_arma[playerid] == -1)
		{
			// se naotiver arma //
			PlayerTextDrawSetString(playerid, T_Armas_p[playerid][2], "Nenhuma Arma Equipada");
			PlayerTextDrawSetString(playerid, T_Armas_p[playerid][1], "_");
            PlayerTextDrawSetPreviewModel(playerid, T_Armas_p[playerid][0], 3045);
            PlayerTextDrawColor(playerid, T_Armas_p[playerid][0], 0x00000000);
		}
		else
		{
		    // se tiver arma //
		    new sss[150];
		    new i = -1;
		    if(id_arma[playerid] > -1) i = ListaArmas[playerid][id_arma[playerid]];
		    if(i != -1)
		    {
			    GetPlayerWeaponData(playerid, i, a1, a2);
			    new model = arma_id(a1, 1);
			    if(i == 2 && Taser(playerid)) format(sss, 150, "~w~%s~n~~y~%s ~g~~h~Muinicoes", "TASER", ConvertMoney(999));
	   			else format(sss, 150, "~w~%s~n~~y~%s ~g~~h~Muinicoes", nome_arma(a1), ConvertMoney(a2));
				PlayerTextDrawColor(playerid, T_Armas_p[playerid][0], 0xffffffff);
				PlayerTextDrawSetString(playerid, T_Armas_p[playerid][1], sss);
				PlayerTextDrawSetString(playerid, T_Armas_p[playerid][2], f("%d / %d", id_arma[playerid]+1, GetPVarInt(playerid, "cont_armas")));
			    PlayerTextDrawSetPreviewModel(playerid, T_Armas_p[playerid][0], model);
				PlayerTextDrawSetPreviewRot(playerid, T_Armas_p[playerid][0], zoom_armas[i][0], zoom_armas[i][1], zoom_armas[i][2], zoom_armas[i][3]);
			}
		}
        for(new a; a<3; a++) PlayerTextDrawShow(playerid, T_Armas_p[playerid][a]);
	}
	flood_arma[playerid] = 0;
}

BCG:: VerificarArmas(playerid)
{
    new conta = id[playerid];
	if(conta != -1)
	{
	    if(Novato(playerid))
	    {
	        // armas equipadas //
	        new armss[13][2];
	        new rem;
	        for(new a; a<13; a++)
			{
				GetPlayerWeaponData(playerid, a, armss[a][0], armss[a][1]);
				if(armss[a][0] != 0 && armss[a][0] != 6 && armss[a][0] != 9)
				{
				    rem = 1;
				}
	        }
	        if(rem == 1)
			{
				ResetPlayerWeapons_(playerid);
				ms(playerid, 2, "Suas Armas foram removidas, pois Novatos nao podem ter armas !");
				Arma_Player[playerid] = -2;
			}

	        // inventario //
	        for(new i; i<MAX_SLOTS; i++)
	        {
	            if(Inventario[playerid][i][inv_ID] != 0)
	            {
	                new idd = Inventario[playerid][i][inv_ID];
	                if(idd > 0 && idd < 44)
	                {
                        limpar_slot(playerid, i);
                        if(inv_novo_aberto[playerid] == 1) abrir_inv_novo(playerid);
                        ms(playerid, 2, "Uma arma foi removida de seu Inventario, pois voce e Novato e nao pode ter armas !");
	                }
	                if(idd > 43 && idd < 49)
	                {
                        limpar_slot(playerid, i);
                        if(inv_novo_aberto[playerid] == 1) abrir_inv_novo(playerid);
                        ms(playerid, 2, "Uma municao foi removida de seu Inventario, pois voce e Novato e nao pode ter armas !");
	                }
	            }
	        }

	        // cop em servico //
	        if(Taser(playerid))
	        {
	            if(!EmServico(playerid))
	            {
	                new c = id[playerid];
	                Conta[playerid][c_Taser][0] = 0;
				new arms[13][2];
				for(new a; a<13; a++) GetPlayerWeaponData(playerid, a, arms[a][0],arms[a][1]);
	                ResetPlayerWeapons_(playerid);
				for(new a; a<13; a++) if(a != 2) GivePlayerWeapon_(playerid, arms[a][0], arms[a][1]);
				GivePlayerWeapon_(playerid, Conta[playerid][c_Taser][1], Conta[playerid][c_Taser][2]);
		            Conta[playerid][c_Taser][1] = 0;
		            Conta[playerid][c_Taser][2] = 0;
		            salvar_conta(c, 0, "c_Taser_0", sv_int(Conta[playerid][c_Taser][0]));
				salvar_conta(c, 0, "c_Taser_1", sv_int(Conta[playerid][c_Taser][1]));
				salvar_conta(c, 0, "c_Taser_2", sv_int(Conta[playerid][c_Taser][2]));
				salvar_conta(c, 0, "c_Taser_3", sv_int(Conta[playerid][c_Taser][3]));
				ms(playerid, 2, "Seu Taser foi guardado, pois voce nao esta em servico !");
				format(string_prox, 300, "** Policial '%s' guardou seu Taser **", Nome(playerid));
					ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
	            }
	        }
	    }
	}
	return 1;
}

BCG:: PlayerUppp(playerid)
{
	new conta = id[playerid];
	if(conta != -1)
	{
		// verificar arma na mao //
		new armd = GetPlayerWeapon(playerid);
		if(armd != 0)
		{
			if(lista_armas[armd][a_Block] == 1)
			{
			    new art[13][2];
				for(new i; i<13; i++) GetPlayerWeaponData(playerid, i, art[i][0], art[i][1]);
				ResetPlayerWeapons_(playerid);
	            for(new i; i<13; i++)
	            {
	                if(art[i][0] == armd && art[i][0] != 0) continue;
	                else GivePlayerWeapon_(playerid, art[i][0], art[i][1]);
	            }
	            ms(playerid, 5, "Uma arma proibida foi indentificada e removida altomaticamente !");
	            SetPlayerArmedWeapon(playerid, 0);
	            Arma_Player[playerid] = -1;
	            armas_costas(playerid);
			}
			else
			{
			    if(player_arena[playerid] == 0)
				{
				    if(!TemPorte(playerid))
					{
					if(ArmaPorte(armd))
					{
							tirar_armas_de_fogo(playerid);
							Arma_Player[playerid] = -2;
		    				armas_costas(playerid);
					}
				    }
				}
			}
		}

		// forcar tirar armas //
		if(remocao_arma[playerid] >= gettime())
		{
		    ResetPlayerWeapons_(playerid);
		    Arma_Player[playerid] = -2;
		    armas_costas(playerid);
		}

		// sistema de /tv //
		tmp_telando(playerid);
	}
	return 1;
}

stock destruir_fly()
{
    if(id_evento == 0)
	{
	    id_evento = -1;
	    for(new a; a<MAX_PLATAFORMAS; a++)
		{
		    if(IsValidDynamicObject(fly_obj[a])) DestroyDynamicObject(fly_obj[a]);
		    fly_existe[a] = 0;
		}
	}
}

stock criar_fly(premio)
{
	if(id_evento == -1)
	{
	    id_evento = 0;
	    new xx;
	    new yy;
	    new Float:pos[2];
	    pos[0] = 0.0;
	    pos[1] = 0.0;
	    KillTimer(fly_timer);
	    fly_id = -1;
	    for(new a; a<MAX_PLATAFORMAS; a++)
		{
		    if(IsValidDynamicObject(fly_obj[a])) DestroyDynamicObject(fly_obj[a]);
		    fly_existe[a] = 1;
            pos[0] = 0.0+(FLY_X*xx);
	    	pos[1] = 0.0+(FLY_Y*yy);
		    fly_obj[a] = CreateDynamicObject(FLY_OBJ, pos[0], pos[1], fly_altura, FLY_RX, 0.00000, 0.00000);
		    fly_pos[a][0] = pos[0];
		    fly_pos[a][1] = pos[1];
		    xx ++;
		    if(xx == 6)
		    {
		        xx = 0;
		        yy ++;
		    }
		}
		evento_premio = premio;
		contagem_fly = FLY_CONTAGEM;
		fly_timer = SetTimer("cont_fly", 1000, true);
		return 1;
	}
	return 0;
}

BCG:: random_fly()
{
    if(id_evento == 0)
	{
	    if(fly_id == -1)
	    {
			new placas[MAX_PLATAFORMAS];
			new cont;
	        for(new a; a<MAX_PLATAFORMAS; a++)
	        {
	            if(fly_existe[a] == 1)
	            {
	                placas[cont] = a;
	                cont ++;
	            }
	        }
	        if(cont > 1)
	        {
	            iniciar_placa(placas[random(cont)]);
			}
	        else
	        {
	            new cont2;
                foreach(new a:Player)
				{
				if(IsPlayerConnected(a))
				{
				    if(evento_player[a] == 0)
					{
				        vencedores[cont2] = a;
				        cont2 ++;
				        cont_vencedores = cont2;
				    }
				}
			    }
	        }
		}
	}
}

stock iniciar_placa(a)
{
    fly_id = a;
    placat(0);
}

BCG:: placat(st)
{
	new obj = fly_obj[fly_id];
	new a = fly_id;
    if(st == 0)
    {
        KillTimer(fly_timer);
        MoveDynamicObject(obj, fly_pos[a][0], fly_pos[a][1], fly_altura, 2, FLY_RX, 10.0, 0.0);
        fly_timer = SetTimerEx("placat", 400, false, "d", 1);
        fly_existe[a] = 0;
    }
    else if(st == 1)
    {
        KillTimer(fly_timer);
        MoveDynamicObject(obj, fly_pos[a][0], fly_pos[a][1], fly_altura, 2, FLY_RX, -10.0, 0.0);
        fly_timer = SetTimerEx("placat", 400, false, "d", 2);
    }
    else if(st == 2)
    {
        KillTimer(fly_timer);
        MoveDynamicObject(obj, fly_pos[a][0], fly_pos[a][1], fly_altura, 2, FLY_RX, 10.0, 0.0);
        fly_timer = SetTimerEx("placat", 400, false, "d", 3);
    }
    else if(st == 3)
    {
        KillTimer(fly_timer);
        MoveDynamicObject(obj, fly_pos[a][0], fly_pos[a][1], fly_altura, 2, FLY_RX, -10.0, 0.0);
        fly_timer = SetTimerEx("placat", 400, false, "d", 4);
    }
    else if(st == 4)
    {
        KillTimer(fly_timer);
        MoveDynamicObject(obj, fly_pos[a][0], fly_pos[a][1], fly_altura-70, 10, FLY_RX, 0.0, 0.0);
        fly_timer = SetTimerEx("placat", 2000, false, "d", 5);
    }
    else if(st == 5)
    {
        KillTimer(fly_timer);
        fly_id = -1;
        fly_timer = SetTimer("random_fly", 5000, false);
    }
}

BCG:: cont_fly()
{
	if(contagem_fly == 0)
	{
	    KillTimer(fly_timer);
	    foreach(new a:Player)
	    {
	        if(IsPlayerConnected(a))
	        {
	            if(evento_player[a] == 0)
	            {
	                GameTextForPlayer(a, "~y~Fly iniciado !", 3000, 3);
	            }
	        }
	    }
	    random_fly();
	}
	else
	{
	    contagem_fly --;
	    foreach(new a:Player)
	    {
	        if(IsPlayerConnected(a))
	        {
	            if(evento_player[a] == 0)
	            {
	                GameTextForPlayer(a, f("~w~Contagem ~g~~h~%d", contagem_fly), 1500, 3);
	            }
	        }
	    }
	}
}

stock finalizar_fly()
{
	new novo_premio;
	if(cont_vencedores > 0)
	{
		if(cont_vencedores == 1)
		{
		    novo_premio = evento_premio;
		    DarGrana(vencedores[0], novo_premio);
		    mst(0xF08080ff, f("[EVENTO] '%s' venceu sozinho e ganhou o premio de R$ %s.", Nome(vencedores[0]), ConvertMoney(novo_premio)));
		}
		else
		{
		    novo_premio = evento_premio/cont_vencedores;
			for(new a; a<cont_vencedores; a++) DarGrana(vencedores[a], novo_premio);
		    mst(0xF08080ff, f("[EVENTO] '%d pessoas' venceram e ganharam o premio de R$ %s cada um.", Nome(vencedores[0]), ConvertMoney(novo_premio)));
		}
	}
	else
	{
	    mst(0xF08080ff, "Ninguem Venceu o evento !");
	}
	destruir_fly();
}

stock PlayerSaqueado(playerid)
{
	new conta = id[playerid];
	if(conta != -1) if(Conta[playerid][c_Saqueado] > gettime()) return 1;
	return 0;
}

stock Saqueado(playerid, con)
{
	new conta = id[playerid];
	if(conta != -1)
	{
	    if(con == 0) Conta[playerid][c_Saqueado] = 0;
	    else Conta[playerid][c_Saqueado] = gettime()+(30*60);
	    salvar_conta(conta, 0, "c_Saqueado", sv_int(Conta[playerid][c_Saqueado]));
	}
}


stock saquear(playerid, morto)
{
	if(Online(playerid))
	{
	    if(Online(morto))
		{
      		if(!PlayerSaqueado(morto))
		    {
		        if(alguem_saqueando(morto)) ms(playerid, 0, "O jogador jogador ja esta sendo Saqueado !");
		        else
		        {
				new Float:ps[3];
				saqueando_player[playerid] = morto;
				Acao(playerid, 27, 120, "SAQUEANDO", 1, "BOMBER", "BOM_PLANT_LOOP", true);
				GetPlayerPos(morto, ps[0], ps[1], ps[2]);
	                SetPlayerToFacePos(playerid, ps[0], ps[1]);
	                format(string_prox, 300, "** '%s' esta saqueando os pertences de '%s' **", Nome(playerid), Nome(morto));
					ProxDetector(30.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
                }
		    }
		    else ms(playerid, 0, f("O jogador '%s' so pode ser saqueado novamente em %s !", Nome(morto), ConvertTime(Conta[morto][c_Saqueado]-gettime())));
		}
	}
}

stock alguem_saqueando(playerid)
{
	foreach(new i:Player)
	{
	    if(Online(i))
	    {
	        if(Barra[i][b_Acao] == 27)
	        {
	            if(saqueando_player[i] == playerid)
	            {
	                return 1;
	            }
	        }
		 }
	}
	return 0;
}

BCG:: esconder_online()
{
    KillTimer(timer_online_socio);
	TextDrawHideForAll(T_Online_Socio[0]);
	TextDrawHideForAll(T_Online_Socio[1]);
	TextDrawHideForAll(T_Online_Socio[2]);
	mostrando_on = 0;
}

stock mostrar_online(playerid, on)
{
	mostrando_on = 1;
	if(on == 1)
	{
	    TextDrawSetString(T_Online_Socio[1], "ONLINE");
	    TextDrawColor(T_Online_Socio[1], 0x00ff0080);
	}
	else
	{
	    TextDrawSetString(T_Online_Socio[1], "OFFLINE");
	    TextDrawColor(T_Online_Socio[1], 0xff000080);
	}
	TextDrawSetString(T_Online_Socio[2], Nome(playerid));
	KillTimer(timer_online_socio);
	timer_online_socio = SetTimer("esconder_online", 5000, false);
	foreach(new i:Player)
	{
	    if(Online(i))
	    {
            if(mostrando_hud[i] == 1)
            {
                if(Conta[i][c_Cadeia] == -1)
                {
                    if(Conta[i][c_TempoCadeia] == 0)
                    {
						if(Conta[i][c_CA_Tempo] == 0)
						{
				        TextDrawShowForPlayer(i, T_Online_Socio[0]);
							TextDrawShowForPlayer(i, T_Online_Socio[1]);
							TextDrawShowForPlayer(i, T_Online_Socio[2]);
						}
					}
				}
            }
	    }
	}
}

