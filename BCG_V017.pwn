							}
							new Float:p[3];
							new vv = Veiculo[v][v_ID];
							if(vv == -1)
							{
							    fechar_menu(playerid);
								ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Porta Malas", "{FF0000}[ERRO] {A1A1A1}O veiculo provavelmente foi guardado ou destruido !", "Ok", "Fechar");
							    return 1;
