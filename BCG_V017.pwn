stock TipoGov(i)
{
	for(new a; a<sizeof governamentais; a++) if(i == governamentais[a]) return 1;
	return 0;
}

stock OrgGov(i)
{
	if(i < 0 || i >= MAX_ORGS) return 0;
	if(Org[i][o_Existe] != 1) return 0;
	for(new a; a<sizeof governamentais; a++) if(Org[i][o_Tipo] == governamentais[a]) return 1;
	return 0;
}

stock nome_xiter(xiter)
{
	new sss[100];
	format(sss, 100, "Nenhum");
	if(xiter >= 0 && xiter < sizeof ant_xiter_status) format(sss, 100, ant_xiter_status[xiter][atc_Nome]);
	return sss;
}

stock mostrar_atc(playerid, con=-1)
{
	SG[0] = EOS;
	SetPVarInt(playerid, "atc", con);
	new kikaar[150];
	new ligado[150];
	if(con == -1)
	{
	    strcat(SG, "Ant Xiter\tStatus\tAuto Kick\n");
	    for(new a; a<sizeof ant_xiter_status; a++)
	    {
	        if(ant_xiter_status[a][atc_Ligado] == 1) format(ligado, 150, "\t{4169E1}LIGADO\t{a1a1a1}");
	        else format(ligado, 150, "\t{ff0000}DESLIGADO\t{a1a1a1}");
	        if(ant_xiter_status[a][atc_Kikar] > 0) format(kikaar, 150, "Kikar com %d avisos\n", ant_xiter_status[a][atc_Kikar]);
	        else format(kikaar, 150, "Apenas avisar aos Admins\n");
	        strcat(SG, "{ffffff}"), strcat(SG, ant_xiter_status[a][atc_Nome]), strcat(SG, ligado), strcat(SG, kikaar);
	    }
	    ShowPlayerDialog(playerid, DIALOG_LISTA_ATC, DIALOG_STYLE_TABLIST_HEADERS, "Ant Xiter", SG, "Continuar", "Fechar");
	}
	else
	{
	    new a = con;
	    strcat(SG, "Status\tAtual\n");
	    if(ant_xiter_status[a][atc_Ligado] == 1) format(ligado, 150, "{ffffff}Status\t{4169E1}LIGADO\n{ffffff}Auto Kick\t");
	   	else format(ligado, 150, "{ffffff}Status\t{ff0000}DESLIGADO\n{ffffff}Auto Kick\t");
		strcat(SG, ligado);
		if(ant_xiter_status[a][atc_Kikar] == 0) format(kikaar, 150, "{a1a1a1}Apenas avisar aos Admins\n");
		else format(kikaar, 150, "{a1a1a1}Kikar com %d avisos\n", ant_xiter_status[a][atc_Kikar]);
	   	strcat(SG, kikaar);
	   	ShowPlayerDialog(playerid, DIALOG_LISTA_ATC, DIALOG_STYLE_TABLIST_HEADERS, ant_xiter_status[a][atc_Nome], SG, "Setar", "Fechar");
	}
}


stock ligar_ac()
{
    for(new a; a<sizeof ant_xiter_status; a++)
	{
	    EnableAntiCheat(a, ant_xiter_status[a][atc_Ligado]);
	}
}

stock mostrar_cargos_portao(playerid, i)
{
	SetPVarInt(playerid, "por", i);		
	new sss[500];
	for(new a=1; a<7; a++) strcat(sss, f("%s%s\n", (Portao[i][p_Cargo] == a)?"{00ffff}":"{a1a1a1}", nome_cargo(a, Portao[i][p_Org])));
	ShowPlayerDialog(playerid, DIALOG_CARGO_PORTAO, DIALOG_STYLE_LIST, f("{ffff00}Portao ID: {a1a1a1}%d {ffffff}%s", i, NomeOrg(Portao[i][p_Org])), sss, "Escolher", "Cancelar");
}

stock ResetPlayerWeapons_(playerid)
{
	ResetPlayerWeapons(playerid);
	for(new a; a<47; a++) 
	{
		if(a == 19 || a == 20 || a == 21) continue;
		SetPlayerAmmo(playerid, a, 0);				
	}		
}

stock limpar_armas_player(playerid, cc)
{
	if(Online(playerid))
	{
		ResetPlayerWeapons_(playerid);
		for(new s; s<MAX_SLOTS; s++)
		{
			if(Inventario[playerid][s][inv_ID] != 0)
			{
				for(new w; w<sizeof lista_armas; w++)
				{
					if(lista_armas[w][a_Item] == Inventario[playerid][s][inv_ID])
					{
						limpar_slot(playerid, s);
						break;
					}
				}
			}
		}
		for(new i; i<13; i++)
		{
			Conta[playerid][c_Arma][i] = 0;
			Conta[playerid][c_Municao][i] = 0;
		}
	}
	salvar_conta(cc, -1, "c_Armas");
}

stock membros_on(a)
{
	new cont;
	if(a != -1)
	{
		foreach(new p:Player)
		{
			if(Online(p))
			{
				if(OrgPlayer(p) == a)
				{
					cont ++;
				}
			}
		}		
	}
	return cont;
}

stock SetPlayerSkinFix(playerid, skinid)
{
    if (!IsPlayerConnected(playerid))
    {
        return 0;
    }

    // If the skinid is invalid, less than 0 or more than 311 or is equal to 74 (invalid skin), then do nothing
    if (0 > skinid > 311 || skinid == 74)
    {
        return 0;
    }

    new
        Float:tmpPos[4],
        vehicleid = GetPlayerVehicleID(playerid),
        seatid = GetPlayerVehicleSeat(playerid);

    GetPlayerPos(playerid, tmpPos[0], tmpPos[1], tmpPos[2]);
    GetPlayerFacingAngle(playerid, tmpPos[3]);

    if (GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_DUCK)
    {
        SetPlayerPos(playerid, tmpPos[0], tmpPos[1], tmpPos[2]);
        SetPlayerFacingAngle(playerid, tmpPos[3]);
        Controle(playerid, true); // preventing any freeze - optional
		skin_player[playerid] = skinid;
        return SetPlayerSkin(playerid, skinid);
    }
    else if (IsPlayerInAnyVehicle(playerid))
    {
        new
            tmp;

        RemovePlayerFromVehicle(playerid);
        SetPlayerPos(playerid, tmpPos[0], tmpPos[1], tmpPos[2]);
        SetPlayerFacingAngle(playerid, tmpPos[3]);
        Controle(playerid, true); // preventing any freeze - important! because of doing animations of exiting vehicle
        tmp = SetPlayerSkin(playerid, skinid);
		skin_player[playerid] = skinid;
        PutPlayerInVehicle(playerid, vehicleid, (seatid == 128) ? 0 : seatid);
        return tmp;
    }
    else
    {	
		skin_player[playerid] = skinid;
        return SetPlayerSkin(playerid, skinid);
    }
}

stock salvar_bau(c, slot=-1)
{
	new file[100];
	format(file, 100, "Baus/%d.txt", c);
	if(!DOF2_FileExists(file)) DOF2_CreateFile(file);
	new string[100];
	new str[300];
	if(slot != -1)
	{
	    format(string, 100, "slot_%d", slot);
	    format(str, 300, "%d|%d|%d|%d|%d|", 
		Bau[c][slot][inv_ID],
		Bau[c][slot][inv_Unidades], 
		Bau[c][slot][inv_Tipo],
		Bau[c][slot][inv_Ativo], 
		Bau[c][slot][inv_Tempo]);
		DOF2_SetString(file, string, str);
		DOF2_SaveFile();
	}
	else
	{
		for(new i; i<MAX_BAU; i++)
		{
		    format(string, 100, "slot_%d", i);
		    format(str, 300, "%d|%d|%d|%d|%d|", 
			Bau[c][i][inv_ID],
			Bau[c][i][inv_Unidades], 
			Bau[c][i][inv_Tipo],
			Bau[c][i][inv_Ativo], 
			Bau[c][i][inv_Tempo]);
			DOF2_SetString(file, string, str);
		}
		DOF2_SaveFile();
	}
}

stock carregar_bau(i)
{
	new file[80];
	format(file, 80, "Baus/%d.txt", i);
	if(DOF2_FileExists(file))
	{
		for(new ii; ii<MAX_BAU; ii++)
	    {
	        Bau[i][ii][inv_ID] = 0;
	        Bau[i][ii][inv_Tipo] = 0;
	        Bau[i][ii][inv_Unidades] = 0;
	        Bau[i][ii][inv_Ativo] = 0;
	        Bau[i][ii][inv_Tempo] = 0;
	    }
		new string[80];
		new str[350];
		for(new ii; ii<MAX_BAU; ii++)
		{
			format(string, 80, "slot_%d", ii);
			format(str, 300, "%s", DOF2_GetString(file, string));
			split_linha(str, strlen(str));
			Bau[i][ii][inv_ID] = strval(split[0]);
			Bau[i][ii][inv_Unidades] = strval(split[1]);
			Bau[i][ii][inv_Tipo] = strval(split[2]);
			Bau[i][ii][inv_Ativo] = strval(split[3]);
			Bau[i][ii][inv_Tempo] = strval(split[4]);
		}		
	}
}

stock abrir_bau_casa(playerid, v)
{
	new c = id[playerid];
	if(c != -1 && v != -1)
	{
		if(Casa[v][casa_Existe] == 1)
		{
			mostrando_bau[playerid] = v;
			// abre o inventario visual com o Bau da Casa no lado direito
			inv_modo[playerid] = INV_MODO_BAU;
			inv_bau_alvo[playerid] = v;
			abrir_inv_novo(playerid);
		}
	}
}


stock atualizar_bau_item(i)
{
	if(BauI[i][bau_Existe] == 1)
	{
		if(IsValidDynamicObject(BauI[i][bau_Obj])) DestroyDynamicObject_(BauI[i][bau_Obj]);
		if(IsValidDynamic3DTextLabel(BauI[i][bau_3D])) DestroyDynamic3DTextLabel(BauI[i][bau_3D]);
		new str[100];
		format(str, 100, "{ffff00}Bau [%d]\n{00ffff}Dono: %s\n{a1a1a1}Aperte F para abrir", i, NomeConta(BauI[i][bau_Dono]));
		BauI[i][bau_3D] = CreateDynamic3DTextLabel(str, 0xffffff99, BauI[i][bau_X], BauI[i][bau_Y], BauI[i][bau_Z]+0.5, 10, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, BauI[i][bau_Mundo], BauI[i][bau_Interior], -1, 30.0, -1, 0);
		BauI[i][bau_Obj] = CreateDynamicObject(1271, BauI[i][bau_X], BauI[i][bau_Y], BauI[i][bau_Z], 0, 0, 0, BauI[i][bau_Mundo], BauI[i][bau_Interior], -1, 300.0, 300.0);
	}
}

stock salvar_bau_item(i)
{
	if(i < 0 || i >= MAX_BAUS) return;
	new file[80];
	format(file, 80, "Baus/Bau_%d.txt", i);
	if(BauI[i][bau_Existe] == 1)
	{
		if(!DOF2_FileExists(file)) DOF2_CreateFile(file);
		DOF2_SetInt(file, "bau_Existe", BauI[i][bau_Existe]);
		DOF2_SetInt(file, "bau_Dono", BauI[i][bau_Dono]);
		DOF2_SetString(file, "bau_Senha", BauI[i][bau_Senha]);
		DOF2_SetInt(file, "bau_Slots", BauI[i][bau_Slots]);
		DOF2_SetFloat(file, "bau_X", BauI[i][bau_X]);
		DOF2_SetFloat(file, "bau_Y", BauI[i][bau_Y]);
		DOF2_SetFloat(file, "bau_Z", BauI[i][bau_Z]);
		DOF2_SetInt(file, "bau_Mundo", BauI[i][bau_Mundo]);
		DOF2_SetInt(file, "bau_Interior", BauI[i][bau_Interior]);
		for(new s; s<BauI[i][bau_Slots]; s++)
		{
			new linh[80], val[500];
			format(linh, 80, "bau_Item_%d", s);
			format(val, 500, "%d|%d|%d|%d|%d|", BauI_Itens[i][s][inv_ID], BauI_Itens[i][s][inv_Unidades], BauI_Itens[i][s][inv_Tipo], BauI_Itens[i][s][inv_Ativo], BauI_Itens[i][s][inv_Tempo]);
			DOF2_SetString(file, linh, val);
		}
		DOF2_SaveFile();
	}
	else { if(DOF2_FileExists(file)) DOF2_RemoveFile(file); }
}

stock abrir_bau_item(playerid, i)
{
	if(BauI[i][bau_Existe] != 1) return;
	mostrando_bau2[playerid] = i;
	// abre o inventario visual com o BauI no lado direito
	inv_modo[playerid] = INV_MODO_BAU_I;
	inv_bau_i_alvo[playerid] = i;
	abrir_inv_novo(playerid);
}

stock abrir_bau_guardar(playerid, bid)
{
	mostrando_bau2[playerid] = bid;
	// abre o inventario visual com o BauI como destino (lado direito)
	inv_modo[playerid] = INV_MODO_BAU_I;
	inv_bau_i_alvo[playerid] = bid;
	abrir_inv_novo(playerid);
}

stock abrir_inventario_bau(playerid, bid)
{
	new sss[800];
	SG[0] = EOS;
	strcat(SG, "Slot\tItem\tQuantidade\n");
	new cont;
	for(new s; s<MAX_SLOTS; s++)
	{
	    if(Inventario[playerid][s][inv_ID] > 0)
	    {
	        format(sss, 800, "{ffffff}%d\t{ffff00}%s\t{4169E1}%d\n", s, NomeItem(Inventario[playerid][s][inv_ID], Inventario[playerid][s][inv_Tipo]), Inventario[playerid][s][inv_Unidades]);
	        strcat(SG, sss);
	        cont++;
	    }
	}
	if(cont == 0) { ms(playerid, 0, "Seu inventario esta vazio!"); abrir_bau_item(playerid, bid); }
	else ShowPlayerDialog(playerid, DIALOG_BAU_GUARDAR, DIALOG_STYLE_TABLIST_HEADERS, "Seu Inventario - Escolha um item", SG, "Guardar", "Voltar");
}

// ========== DEPOSITO DE VEICULOS APREENDIDOS ==========

stock abrir_deposito_veiculos(playerid)
{
	new sss[800];
	SG[0] = EOS;
	strcat(SG, "Veiculo\tPlaca\tDivida\tPreco\n");
	new cont;
	for(new v; v<MAX_VEICULOS; v++)
	{
		if(Veiculo[v][v_Existe] == 1 && Veiculo[v][v_Dono] == -1 && Veiculo[v][v_IPVA] <= 0 && Veiculo[v][v_Emprego] == -1 && Veiculo[v][v_Org] == -1)
		{
			format(sss, 800, "{ffffff}%s\t{ffff00}%s\t{FF0000}R$ %s\t{00FF00}R$ %s\n", NomeVeiculo(Veiculo[v][v_Modelo]), PlacaVeiculo[v], ConvertMoney(Veiculo[v][v_Contas]), ConvertMoney(Veiculo[v][v_Contas] * 2));
			strcat(SG, sss);
			Lista[playerid][cont] = v;
			cont++;
		}
	}
	if(cont == 0) return ms(playerid, 0, "Nenhum veiculo disponivel no deposito no momento.");
	SetPVarInt(playerid, "dep_cont", cont);
	ShowPlayerDialog(playerid, DIALOG_DEPOSITO_LISTA, DIALOG_STYLE_TABLIST_HEADERS, "Deposito de Veiculos", SG, "Selecionar", "Fechar");
	return 1;
}

// handler no dialog principal
stock mostrar_info_deposito(playerid, v)
{
	new sss[600];
	format(sss, 600, "{FFFFFF}Veiculo: {FFFF00}%s\n\
{FFFFFF}Placa: {FFFF00}%s\n\
{FFFFFF}Modelo: {FFFF00}%d\n\
{FFFFFF}Valor Original: {FFFF00}R$ %s\n\
{FFFFFF}Divida (IPVA): {FF0000}R$ %s\n\
{FFFFFF}Valor para Comprar: {00FF00}R$ %s\n\
{FFFFFF}Valor para Recuperar{00FFFF}R$ %s\n\n\
{A1A1A1}Ex-dono pode recuperar por preco menor.\n\
{FFFF00}Pague com dinheiro em maos.",
	NomeVeiculo(Veiculo[v][v_Modelo]),
	PlacaVeiculo[v],
	Veiculo[v][v_Modelo],
	ConvertMoney(Veiculo[v][v_Compra]),
	ConvertMoney(Veiculo[v][v_Contas]),
	ConvertMoney(Veiculo[v][v_Contas] * 2),
	ConvertMoney(Veiculo[v][v_Contas] + (Veiculo[v][v_Contas] / 2)));
	SetPVarInt(playerid, "dep_veiculo", v);
	ShowPlayerDialog(playerid, DIALOG_DEPOSITO_INFO, DIALOG_STYLE_MSGBOX, "Informacoes do Veiculo", sss, "Comprar", "Voltar");
}

