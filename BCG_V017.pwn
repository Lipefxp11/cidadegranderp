BCG:: PlayerSpawnAgora(playerid)
{
    KillTimer(timer_spawn_player[playerid]);
	TogglePlayerSpectating(playerid, false);
	SpawnPlayer(playerid);
	return 1;
}


stock mostrar_login(playerid)
{
    // BCG UI/CEF: login visual e registro ficam exclusivamente no cliente BCG.
    // Nao abrir dialogs/textdraws antigos aqui: eles conflitam com foco/touch da UI.
    if(!IsPlayerConnected(playerid)) return 0;
    SetPlayerInterior(playerid, 0);
    SetPlayerVirtualWorld_(playerid, playerid+100);
    TogglePlayerControllable(playerid, false);
    SetPVarInt(playerid, "BCG_UI_AUTH", 1);
    return 1;
}

forward mostrar_login_public(playerid);
public mostrar_login_public(playerid)
{
    if(IsPlayerConnected(playerid)) mostrar_login(playerid);
}

stock Online(playerid)
{
    if(playerid < 0 || playerid >= MAX_PLAYERS) return 0;
	if(IsPlayerConnected(playerid)) if(logado[playerid] == 1) return 1;
	return 0;
}

stock msa(cor, const mens[])
{
	new cont;
	foreach(new i:Player)
	{
	    if(Online(i))
	    {
	        if(AdminPlayer(i) > 0)
	        {
	            if(ModoAdmin[i] == 1)
	            {
	                cont++;
	            	menssagem_player(i, cor, mens);
	            }
	        }
	    }
	}
	return cont;
}


stock msa2(cor, const mens[])
{
	new cont;
	foreach(new i:Player)
	{
	    if(Online(i))
	    {
	        if(id[i] != -1)
	        {
            	cont++;
        		menssagem_player(i, cor, mens);
        	}
	    }
	}
	return cont;
}


BCG:: kick(playerid)
{
	Kick(playerid);
}

stock kikar(playerid)
{
    TextDrawShowForPlayer(playerid, Text_Saiu[0]);
    TextDrawShowForPlayer(playerid, Text_Saiu[1]);
    TextDrawShowForPlayer(playerid, Text_Saiu[2]);
	SetTimerEx("kick", 500, false, "d", playerid);
}

stock banir(playerid)
{
	if(Online(playerid))
	{
	    TextDrawShowForPlayer(playerid, Text_Saiu[0]);
	    TextDrawShowForPlayer(playerid, Text_Saiu[3]);
	    TextDrawShowForPlayer(playerid, Text_Saiu[4]);
		SetTimerEx("kick", 500, false, "d", playerid);
	}
}

stock msc(c, tipo, const menssag[])
{
	if(c != -1)
	{
	    if(!ContaInvalida(c))
	    {
	        new playerid = ContaOnline(c);
	        if(Online(playerid)) ms(playerid, tipo, menssag);
			else menssagem_conta(c, tipo, menssag);
			return 1;
		}
	}
	return -555;
}

stock mst(tipo, const mens[])
{
    foreach(new i:Player) if(Online(i)) ms(i, tipo, mens);
}

stock mso(o, const menssag[], player=-1, cor=-1)
{
	foreach(new i:Player)
	{
	    if(Online(i))
	    {
	        if(i != player)
	        {
		        if(OrgPlayer(i) == o)
		        {
		            if(cor == -1) menssagem_player(i, 3, menssag);
		            else menssagem_player(i, cor, menssag);
		        }
	        }
	    }
	}
}

stock ms(playerid, tipo, const menssag[])
{
	if(IsPlayerConnected(playerid))
	{
		menssagem_player(playerid, tipo, menssag);
	}
	return -555;
}

stock Comparar(const params1[], const params[])
{
    if(strcmp(params, params1, false) == 0) return 1;
    else return 0;
}

stock Comparar2(const params1[], const params[])
{
    if(strcmp(params, params1, true) == 0) return 1;
    else return 0;
}

stock NOME(playerid)
{
    new nameplayer[MAX_PLAYER_NAME];
	GetPlayerName(playerid, nameplayer, MAX_PLAYER_NAME);
	return nameplayer;
}



stock Nome(playerid)
{
    new nameplayer[MAX_PLAYER_NAME];
    format(nameplayer, MAX_PLAYER_NAME, "Ninguem");
	if(playerid >= 0 && playerid < MAX_PLAYERS)
	{
		if(IsPlayerConnected(playerid))
		{
		    GetPlayerName(playerid, nameplayer, MAX_PLAYER_NAME);
		    if(id[playerid] != -1) format(nameplayer, MAX_PLAYER_NAME, NomeConta(id[playerid]));
	    }
    }
	return nameplayer;
}

stock ContaValida(c)
{
	new file[80];
	if(c < 0 || c >= MAX_CONTAS) return 0;
	format(file, 80, "Contas/%d.txt", c);
	if(DOF2_FileExists(file)) return 1;
	else return 0;
}

stock Senha(playerid)
{
	new c = GetPVarInt(playerid, "conta");
    format(sttr, 500, "\n\n\
	{ffffff}Conta: {ffff00}%d\n\
	{ffffff}Nick: {00ffff}%s\n\n\
	\
	{4169E1}[INFO] {a1a1a1}Digite a senha da conta corretamente:\n\n", c, NomeConta(c));
	Input(playerid, DIALOG_SENHA, "{BEBEBE}Cidade Grande{4169E1}[RP]", sttr, 1);
