		Veiculo[idv][v_Keys][2] = -1;
		Veiculo[idv][v_History][0] = EOS;
		Veiculo[idv][v_Emprego] = -1;
		Veiculo[idv][v_X] = 0;
		Veiculo[idv][v_Y] = 0;
		Veiculo[idv][v_Z] = 0;
		Veiculo[idv][v_A] = 0;
		Veiculo[idv][v_Pneu][0] = 0;
		Veiculo[idv][v_Pneu][1] = 0;
		Veiculo[idv][v_Pneu][2] = 0;
		Veiculo[idv][v_Pneu][3] = 0;
		Veiculo[idv][v_Farol][0] = 0;
		Veiculo[idv][v_Farol][1] = 0;
		Veiculo[idv][v_Farol][2] = 0;
		Veiculo[idv][v_Porta][0] = 0;
		Veiculo[idv][v_Porta][1] = 0;
		Veiculo[idv][v_Porta][2] = 0;
		Veiculo[idv][v_Porta][3] = 0;
		Veiculo[idv][v_Painel][0] = 0;
		Veiculo[idv][v_Painel][1] = 0;
		Veiculo[idv][v_Painel][2] = 0;
		Veiculo[idv][v_Painel][3] = 0;
		Veiculo[idv][v_Painel][4] = 0;
		Veiculo[idv][v_Painel][5] = 0;
		Veiculo[idv][v_Painel][6] = 0;


		for(new t; t<18; t++) TuningVeiculo[idv][t] = -1;
		for(new po; po<MAX_PORTA_MALAS; po++)
	    {
	        PortaMalas[idv][po][inv_ID] = 0;
			PortaMalas[idv][po][inv_Unidades] = 0;
			PortaMalas[idv][po][inv_Tipo] = 0;
	    }

        if(rebocando_moto[idv] != -1) SetVehicleToRespawn(rebocando_moto[idv]);
	    rebocando_moto[idv] = -1;
		texto_garagem(idv);
	    sedex_veiculo[idv] = 0;
	    botijao_veiculo[idv] = 0;
	    sedex_veiculo[idv] = 0;
	    botijao_veiculo[idv] = 0;
	    malotes_veiculo[idv] = 0;
	    madeiras_veiculo[idv] = 0;
	    emp_veiculo[idv] = 0;
	    lixo_veiculo[idv] = 0;
	    pedras_veiculo[idv] = 0;
	}
}

stock CriarVeiculo(placa, cria, modelo, Float:x, Float:y, Float:z, Float:aaa, c1=1, c2=1, dono, gasolina=100, bateria=100, lataria=1000, trancado=0, emprego=-1, org=-1, p1=0, p2=0, p3=0, p4=0)
{
	new idv = -1;
 	for(new v; v<MAX_VEICULOS; v++)
	{
	    if(Veiculo[v][v_Existe] == 0)
	    {
	        idv  = v;
	        Veiculo[v][v_Existe] = 1;
	        Iter_Add(Iter_Veiculos, v);
	        if(cria == 1)
	        {
	        	new veh = CreateVehicle_(modelo, x, y, z, aaa, c1,c2, -1, 0);
	        	Info_Veiculo[veh] = v;
				Veiculo[v][v_ID] = veh;
			}
			if(placa == 0)
			{
				Veiculo[v][v_Emplacar] = 1;
				format(PlacaVeiculo[v], 20, "SEM PLACA");
			}
			else 
			{
				Veiculo[v][v_Emplacar] = 0;
				gerar_placa(PlacaVeiculo[v], 20);
			}
			Veiculo[v][v_IPVA] = 15;
			XenonVeiculo[v][0] = 0;
			XenonVeiculo[v][1] = 0;
			NeonVeiculo[v][0] = 0;
			NeonVeiculo[v][1] = 0;
			Veiculo[v][v_Conce] = 0;
			Veiculo[v][v_ConceID] = -1;
			Veiculo[v][v_Contas] = 150;
			Veiculo[v][v_Dono] = dono;
			Veiculo[v][v_Vida] = 1000.0;
			Veiculo[v][v_Modelo] = modelo;
			Veiculo[v][v_Gasolina] = gasolina;
			Veiculo[v][v_Bateria] = bateria;
			Veiculo[v][v_Lataria] = lataria;
			Veiculo[v][v_Trancado] = trancado;
			Veiculo[v][v_Cor1] = c1;
			Veiculo[v][v_Cor2] = c2;
			Veiculo[v][v_Org] = org;
			Veiculo[v][v_Cargo] = 0;
			Veiculo[v][v_Garagem_ID] = -1;
			Veiculo[v][v_Emprego] = emprego;
			Veiculo[v][v_X] = x;
			Veiculo[v][v_Y] = y;
			Veiculo[v][v_Z] = z;
			Veiculo[v][v_A] = aaa;
			Veiculo[v][v_Pneu][0] = p1;
			Veiculo[v][v_Pneu][1] = p2;
			Veiculo[v][v_Pneu][2] = p3;
			Veiculo[v][v_Pneu][3] = p4;
			Veiculo[v][v_Farol][0] = 0;
			Veiculo[v][v_Farol][1] = 0;
			Veiculo[v][v_Farol][2] = 0;
			Veiculo[v][v_Porta][0] = 0;
			Veiculo[v][v_Porta][1] = 0;
			Veiculo[v][v_Porta][2] = 0;
			Veiculo[v][v_Porta][3] = 0;
			Veiculo[v][v_Painel][0] = 0;
			Veiculo[v][v_Painel][1] = 0;
			Veiculo[v][v_Painel][2] = 0;
			Veiculo[v][v_Painel][3] = 0;
			Veiculo[v][v_Painel][4] = 0;
			Veiculo[v][v_Painel][5] = 0;
			Veiculo[v][v_Painel][6] = 0;

			// porta malas //
		    for(new po; po<MAX_PORTA_MALAS; po++)
		    {
		        PortaMalas[v][po][inv_ID] = 0;
		        PortaMalas[v][po][inv_Unidades] = 0;
		        PortaMalas[v][po][inv_Tipo] = 0;
		        PortaMalas[v][po][inv_Ativo] = 0;
		        PortaMalas[v][po][inv_Tempo] = 0;
		    }

			// tunings //
		    for(new a; a<18; a++) TuningVeiculo[v][a] = -1;

		    // multas //
		    for(new a; a<MAX_MULTAS; a++)
		    {
		        Veiculo_Multa[v][a][mu_Existe] = 0;
                Veiculo_Multa[v][a][mu_Valor] = 0;
				Veiculo_Multa[v][a][mu_Conta] = -1;
				Veiculo_Multa[v][a][mu_Radar] = -1;
				format(Veiculo_Multa[v][a][mu_Motivo], 100, "Nenhum");
				format(Veiculo_Multa[v][a][mu_Data], 50, "Nada");
		    }

			format(Veiculo[v][v_Data], 100, "%02d/%02d/%04d", DIA, MES, ANO);
			GerarChasi(v);
			break;
		}
	}

	return idv;
}

stock randomPlaca()
{
	static c[2];
	format(c, 2, "%c", random(26) + 'A');
	return c;
}

stock GerarChasi(v)
{
    new numeros[13], letras[4][3];
	new file[80];
	new tem;

	for(new d; d<10; d++)
	{
	    numeros[0] = random(9);
		numeros[1] = random(9);
		numeros[2] = random(9);
		numeros[3] = random(9);
		numeros[4] = random(9);
		numeros[5] = random(9);
		numeros[6] = random(9);
		numeros[7] = random(9);
		numeros[8] = random(9);
		numeros[9] = random(9);
		numeros[10] = random(9);
		numeros[11] = random(9);
		numeros[12] = random(9);
		format(letras[0], 3, randomPlaca());
		format(letras[1], 3, randomPlaca());
		format(letras[2], 3, randomPlaca());
		format(letras[3], 3, randomPlaca());
		format(file, 80, "%d%s%d%s%s%d%d%d%d%s%d%d%d%d%d%d%d", numeros[0], letras[0], numeros[1], letras[1], letras[2], numeros[2], numeros[3],numeros[4], numeros[5], letras[3], numeros[6], numeros[7], numeros[8], numeros[9], numeros[10], numeros[11], numeros[12]);
		foreach(new a:Iter_Veiculos)
		{
		    if(Veiculo[a][v_Existe] == 1)
		    {
		        if(Veiculo[a][v_TemChasi] == 1)
		        {
		            if(Comparar(Veiculo[a][v_Chasi], file))
		            {
		                tem = 1;
		            }
				}
			}
		}
		if(tem == 0)
		{
		    format(Veiculo[v][v_Data], 100, "%02d/%02d/%04d", DIA, MES, ANO);
			format(Veiculo[v][v_Chasi], 50, file);
			Veiculo[v][v_TemChasi] = 1;
		    break;
		}
	}
}


stock casas_conta(c)
{
	new cont;
	foreach(new i:Iter_Casas)
	{
	    if(Casa[i][casa_Existe] == 1)
	    {
	        if(Casa[i][casa_Dono] != -1)
	        {
				if(Casa[i][casa_Dono] == c)
				{
				    cont ++;
				}
			}
	    }
	}
	return cont;
}


stock veiculos_conta(c)
{
	new cont;
	foreach(new i:Iter_Veiculos)
	{
	    if(Veiculo[i][v_Existe] == 1)
	    {
	        if(Veiculo[i][v_Dono] != -1)
	        {
				if(Veiculo[i][v_Dono] == c)
				{
				    cont ++;
				}
			}
	    }
	}
	return cont;
}

stock GetDistance(&Float:distt, Float:x1, Float:y1, Float:z1, Float:x2, Float:y2, Float:z2 )
{
	distt = VectorSize(x1-x2, y1-y2, z1-z2);
}



stock Localizar_Player(playerid, Float:xxx,Float:yyy,Float:zzz, i, idd=-1, const destt[]="Destino", salvar=0)
{
	if(i == -1)
	{
	    if(IsValidDynamic3DTextLabel(Localizando_3D[playerid])) DestroyDynamic3DTextLabel(Localizando_3D[playerid]);
	    Localizando_3D[playerid] = DynamicText3D:-1;
	    DisablePlayerCheckpoint(playerid);
	    Localizando[playerid] = -1;
	    Localizando_ID[playerid] = -1;
	    Localizando2[playerid] = -1;
	    Localizando_ID2[playerid] = -1;
	}
	else if(i == 99999)
	{
	    if(Localizando[playerid] == 564545)
		{
			if(Localizando2[playerid] != -1) 
			{
			    Localizar_Player(playerid, Localizando_Pos2[playerid][0], Localizando_Pos2[playerid][1], Localizando_Pos2[playerid][2],
				Localizando2[playerid], Localizando_ID2[playerid], Localizando_Destino2[playerid]);
			}
			else lipar_check(playerid);
		}

		if(Localizando[playerid] == 76)
		{
		    new sss[150];
	        format(sss, 150, "Voce chegou ate o Local da Empresa.");
	        MS(playerid, 1, sss);
	        lipar_check(playerid);
		}

		if(Localizando[playerid] == 75)
		{
		    new sss[150];
	        format(sss, 150, "Voce chegou ate o Local do Territorio.");
	        MS(playerid, 1, sss);
	        lipar_check(playerid);
		}

		if(Localizando[playerid] == 74)
		{
		    new sss[150];
	        format(sss, 150, "Voce chegou ate o Local da Organizacao.");
	        MS(playerid, 1, sss);
	        lipar_check(playerid);
		}


	    if(Localizando[playerid] == 73)
	    {
	        new sss[150];
	        format(sss, 150, "Voce chegou ate o seu Portao.");
	        MS(playerid, 1, sss);
	        lipar_check(playerid);
	    }

	    if(Localizando[playerid] == 72)
	    {
	        new sss[150];
	        format(sss, 150, "Voce chegou ate o seu Pe de Maconha.");
	        MS(playerid, 1, sss);
	        lipar_check(playerid);
	    }

	    if(Localizando[playerid] == 71)
	    {
	        new sss[150];
	        format(sss, 150, "Voce chegou ate o Jogador, ja pode comecar o socorro medico.");
	        MS(playerid, 1, sss);
	        lipar_check(playerid);
	    }

	    if(Localizando[playerid] == 66)
	    {
	        new sss[150];
	        format(sss, 150, "Voce chegou ate o Caixa Eletronico, ja pode comecar o concerto.");
	        MS(playerid, 1, sss);
	        lipar_check(playerid);
	    }

	    if(Localizando[playerid] == 67)
	    {
	        new sss[150];
	        format(sss, 150, "Voce chegou ate o Radar de Velocidade, ja pode comecar o concerto.");
	        MS(playerid, 1, sss);
	        lipar_check(playerid);
	    }
	    if(Localizando[playerid] == 68)
	    {
	        new sss[150];
	        format(sss, 150, "Voce chegou ate a Camera de Seguranca, ja pode comecar o concerto.");
	        MS(playerid, 1, sss);
	        lipar_check(playerid);
	    }
	    if(Localizando[playerid] == 69)
	    {
	        new sss[150];
	        format(sss, 150, "Voce chegou ate a Camera do Caixa, ja pode comecar o concerto.");
	        MS(playerid, 1, sss);
	        lipar_check(playerid);
	    }

	    // achar o deposito do Mercado negro //
	    if(Localizando[playerid] == 65)
		{
			MS(playerid, 1, "Voce chegou ate o deposito do Mercado Negro !");
        	lipar_check(playerid);
        }

	    // achar CASA do player //
	    if(Localizando[playerid] == 64)
		{
			MS(playerid, 1, "Voce chegou ate a sua Casa !");
			lipar_check(playerid);
		}

	    // achar garagem conce //
	    if(Localizando[playerid] == 63)
		{
			MS(playerid, 1, "Voce chegou ate a garagem da concessionaria !");
			lipar_check(playerid);
		}

	    // achar cadeia //
	    if(Localizando[playerid] == 62)
		{
			MS(playerid, 1, "Voce chegou ate a cadeia !");
			lipar_check(playerid);
		}

	    // achar lixeiro //
	    if(Localizando[playerid] == 61)
		{
			if(EmpregoPlayer(playerid) == 8)
			{
				ms(playerid, 2, "Aperte H proximo ao Lixeiro para pegar uma sacola."), MS(playerid, 2, "Apos pegar a sacola, aperte H atras do Caminhao de Lixo.");
                lipar_check(playerid);
			}
		}

	    // descarregar lixeiro //
	    if(Localizando[playerid] == 59)
		{
			if(EmpregoPlayer(playerid) == 8)
			{
				MS(playerid, 2, "Va ate a area de descarregar o caminhao e buzine para receber o pagamento.");
				lipar_check(playerid);
			}
		}

	    // terminar entrega de caminhao //
	    if(Localizando[playerid] == 60)
	    {
	        if(EmpregoPlayer(playerid) == 7)
	        {
	            if(IsPlayerInAnyVehicle(playerid))
	            {
	                if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	                {
	                    new car = GetPlayerVehicleID(playerid);
	                    new info = Info_Veiculo[car];
	                    if(info != -1)
	                    {
	                        if(Veiculo[info][v_Emprego] == 7)
	                        {
	                            new e = Localizando_ID[playerid];
	                            if(NotaPlayer(playerid) != -1)
	                            {
		                            if(emp_veiculo[info] == entregas[e][ec_Tipo] && NotaPlayer(playerid) == e)
		                            {
		                                if(emp_m_veiculo[info] >= entregas[e][ec_Quantidade])
		                                {
		                                    finalizar_entrega(playerid, car, info, e);
		                                    lipar_check(playerid);
    									}
		                                else MS(playerid, 0, "A mercadoria do caminhao nao bate com a Quantidade do pedido da /nota !");
		                            }
		                            else MS(playerid, 0, "A mercadoria nao bate com a da nota da encomenda, verifique sua /nota !");
								}
								else MS(playerid, 0, "Voce nao tem mais a nota fiscal dessa entrega !");
							}
	                        else MS(playerid, 0, "Voce nao esta no caminhao de entrega !");
	                    }
	                    else MS(playerid, 0, "Voce nao esta no caminhao de entrega !");
	                }
	            }
	        }
	    }

     	// terminar servico carro forte //
	    if(Localizando[playerid] == 53)
	    {
	        if(CF_Etapa[playerid] == 4)
	        {
		        new grana = 10*300;
		        new sss[300];
		        format(sss, 300, "Voce recebeu R$ %s pelas 10 rotas, mais R$ %s pela distancia percorrida", ConvertMoney(grana), ConvertMoney(CF_Distancia[playerid]/10));
		        grana += (CF_Distancia[playerid]/10);
		        DarGrana(playerid, grana);
		        zerar_cf(playerid);
		        MS(playerid, 1, sss);
		        MetaEmprego(playerid);
		        lipar_check(playerid);
	        }
	    }

	    // entregar malote carro forte //
	    if(Localizando[playerid] == 52)
	    {
	        if(CF_Etapa[playerid] == 3)
	        {
		        if(segurando_player[playerid] != 4) ms(playerid, 0, "Voce precisa pegar um Malote do carro forte, aperte H atras dele e volte ao checkpoint.");
				else
		        {
		            new ca = GetPVarInt(playerid, "id_caixa_e");
		            jogar(playerid);
                    CF_Progresso[playerid] ++;
                    new Float:pos;
                    pos = GetPlayerDistanceFromPoint(playerid, CF_Pos[playerid][0], CF_Pos[playerid][1], CF_Pos[playerid][2]);
                    CF_Distancia[playerid] += floatround(pos);
                    CaixaEletronico[ca][ce_Dinheiro] += 5000;
                    texto_caixa_eletronico(ca);
                    salvar_caixa_eletronico(ca);
                    if(CF_Progresso[playerid] == 10)
                    {
                        ms(playerid, 1, "Voce finalizou as 10 rotas !");
                        MS(playerid, 1, "Volte ao veiculo e va ate a HQ do emprego para receber sua recompenssa.");
                        CF_Etapa[playerid] = 4;
                        Localizar_Player(playerid, 2254.098144, 2045.226318, 11.174606, 53, -1, "HQ CARROS FORTE");
                    }
                    else
                    {
                        CF_Etapa[playerid] = 2;
                        MS(playerid, 2, "Volte para o carro forte para localizar a proxima rota.");
                        lipar_check(playerid);
                    }
		        }
	        }
	    }

	    // chegando ao banco de carro forte //
	    if(Localizando[playerid] == 51)
	    {
	        MS(playerid, 2, "Aperte H para pegar os malotes, e leve ate a trazeira do veiculo.");
	        ms(playerid, 2, "Para guardar os malotes no veiculo, use a tecla H atras dele.");
	        ms(playerid, 2, "Complete com 10 malotes para iniciar a proxima etapa.");
    		CF_Etapa[playerid] = 2;
	        lipar_check(playerid);
	    }

	    // chegando ao banco de carro forte //
	    if(Localizando[playerid] == 50)
	    {
	        new cid = CF_Cidade[playerid];
	        if(cid != -1)
	        {
	            ms(playerid, 1, "Voce chegou ate o local de carregamento dos malotes !");
	            MS(playerid, 1, "Siga a pe ate o proximo checkpoint, leve os malotes pro carro ate completar 10.");
	            Localizar_Player(playerid, bancos[cid][1][0], bancos[cid][1][1], bancos[cid][1][2], 51, -1, "MALOTES");
	            CF_Etapa[playerid] = 1;
	            lipar_check(playerid);
	        }
	    }

	    // entregando botijao de gas //
	    if(Localizando[playerid] == 100)
	    {
	        if(segurando_player[playerid] != 0) MS(playerid, 0, "Voce precisa pegar um Botijao de Gas do Veiculo, aperte H atras dele e volte ao checkpoint.");
	        else
	        {
		        new conta = id[playerid];
		        if(conta != -1)
		        {
				new sss[300];
				new taxa = ((distancia_gas[playerid]/500)*7);
				format(sss, 300, "\n{4169E1}[INFO] {ffffff}Voce finalizou a entrega e recebeu R$ %s + %s da taxa.\n\n\
					{a1a1a1}Deseja pegar a proxima entrega ?\nVerifique se o Veiculo ainda tem um Botijao de gas\n\n", ConvertMoney(VALOR_ENTREGA_GAS), ConvertMoney(taxa));
			    	DarGrana(playerid, VALOR_ENTREGA_GAS+taxa);
			    	jogar(playerid);
			    	entrega_gas[playerid] = -1;
			    	distancia_gas[playerid] = -1;
			    	MetaEmprego(playerid);
			    	ShowPlayerDialog(playerid, DIALOG_ENTREGA_GAS, DIALOG_STYLE_MSGBOX, "Entrega Concluida", sss, "Continuar", "Nao");
                    lipar_check(playerid);
				}
	    	}
	    }

	    // entregando caixa da sedex //
	    if(Localizando[playerid] == 101)
	    {
	        if(segurando_player[playerid] != 1) MS(playerid, 0, "Voce precisa pegar a Caixa de Entrega, aperte H atras da Van e volte ao checkpoint.");
	        else
	        {
		        new conta = id[playerid];
		        if(conta != -1)
		        {
				new sss[300];
				format(sss, 300, "\n{4169E1}[INFO] {ffffff}Voce finalizou a entrega e recebeu R$ %s.\n\n\
					{a1a1a1}Deseja pegar a proxima entrega ?\nVerifique se a Van ainda tem alguma entrega.\n\n", ConvertMoney(VALOR_ENTREGA_SEDEX));
			    	DarGrana(playerid, VALOR_ENTREGA_SEDEX);
			    	jogar(playerid);
			    	entrega_sedex[playerid] = -1;
			    	MetaEmprego(playerid);
			    	ShowPlayerDialog(playerid, DIALOG_ENTREGA_SEDEX, DIALOG_STYLE_MSGBOX, "Entrega Concluida", sss, "Continuar", "Nao");
                    lipar_check(playerid);
				}
	    	}
	    }

	    // restante das localizacoes //
     	if(Localizando[playerid] == 555)
		{
			MS(playerid, 1, "Voce chegou ate o local do pedido de viagem.");
			if(Online(Localizando_ID[playerid]))
			{
			    if(id[Localizando_ID[playerid]] != -1)
				{
				ms(Localizando_ID[playerid], 3, "O motorista chegou ate o local onde voce pediu a viagem !");
				MS(Localizando_ID[playerid], 3, "Entre como passageiro no veiculo para iniciar a corrida.");
			    }
			}
			lipar_check(playerid);
		}

		// motorista chegou ao destino //
		if(Localizando[playerid] == 666)
		{
			new player = Localizando_ID[playerid];
			new grana = Uber[player][uber_Valor];
			new veic = Uber[player][uber_Veiculo];
			if(GetVehicleModel(veic) != 0)
			{
				new vv = Info_Veiculo[veic];
				finalizar_corrida(player, playerid, grana, vv);
				cancelar_uber(player, 1);
				lipar_check(playerid);
			}
		}

     	if(Localizando[playerid] == 777)
		{
			MS(playerid, 1, "Voce chegou ao destino, o gps foi desligado.");
			cancelar_gps(playerid);
			if(celular_aberto[playerid] == C_GPS) celular(playerid, C_GPS);
			lipar_check(playerid);
		}

		// chegou ate o escritorio do emprego //
     	if(Localizando[playerid] == 200)
		{
			MS(playerid, 1, "Voce encontrou o escritorio do emprego.");
		    lipar_check(playerid);
		}

     	// chegou ate o veiculo //
     	if(Localizando[playerid] == 0)
		{
			MS(playerid, 1, "Voce encontrou o seu Veiculo.");
			lipar_check(playerid);
		}
	}
	else
	{

		if(salvar == 1)
		{
		    if(Localizando[playerid] != -1 && Localizando[playerid] != 564545)
	        {
	            format(Localizando_Destino2[playerid], 100, Localizando_Destino[playerid]);
				Localizando_Pos2[playerid][0] = Localizando_Pos[playerid][0];
				Localizando_Pos2[playerid][1] = Localizando_Pos[playerid][1];
				Localizando_Pos2[playerid][2] = Localizando_Pos[playerid][2];
				Localizando2[playerid] = Localizando[playerid];
				Localizando_ID2[playerid] = Localizando_ID[playerid];
	        }
		}

		format(Localizando_Destino[playerid], 100, destt);
	    Localizando_Pos[playerid][0] = xxx;
	    Localizando_Pos[playerid][1] = yyy;
	    Localizando_Pos[playerid][2] = zzz;
		Localizando[playerid] = i;
	    Localizando_ID[playerid] = idd;
		SetPlayerCheckpoint(playerid, xxx, yyy, zzz, 3);
		PlayerPlaySound(playerid,1058,0.0,0.0,0.0);
		new strloc[300];
		new Float:distt;
		distt = GetPlayerDistanceFromPoint(playerid, xxx, yyy, zzz);
		format(strloc, 300, "%s\n%.0f Metros", destt, distt);
		if(IsValidDynamic3DTextLabel(Localizando_3D[playerid])) DestroyDynamic3DTextLabel(Localizando_3D[playerid]);
		Localizando_3D[playerid] = CreateDynamic3DTextLabel( strloc, 0xaa00ffff, xxx, yyy, zzz, 6000, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0,  -1, -1, playerid, 6000, -1, 0 );

	    if(Localizando[playerid] == 50) MS(playerid, 2, "Chegando ao local marcado no mapa, siga as proximas instrucoes.");
		if(Localizando[playerid] == 777) MS(playerid, 2, "GPS ativado, Siga ate a marca vermelha do mapa para localizar o destino.");
		if(Localizando[playerid] == 555) MS(playerid, 2, "Siga ate a marca vermelha do mapa para localizar o cliente.");
		if(Localizando[playerid] == 200) MS(playerid, 2, "Siga ate a marca vermelha do mapa para localizar o escritorio do emprego.");
		if(Localizando[playerid] == 100) MS(playerid, 2, "Siga ate a marca vermelha do mapa para realizar a entrega.");
		if(Localizando[playerid] == 101) MS(playerid, 2, "Siga ate a marca vermelha do mapa para realizar a entrega.");
		if(Localizando[playerid] == 0) MS(playerid, 2, "Siga ate a marca vermelha do mapa para encontrar o seu Veiculo.");
	}
}

stock lipar_check(playerid)
{
    Localizando_ID[playerid] = -1;
    Localizando[playerid] = -1;
    DisablePlayerCheckpoint(playerid);
    if(IsValidDynamic3DTextLabel(Localizando_3D[playerid])) DestroyDynamic3DTextLabel(Localizando_3D[playerid]);
    Localizando_3D[playerid] = DynamicText3D:-1;
    PlayerPlaySound(playerid,1150,0.0,0.0,0.0);
}


stock GranaPlayer(playerid)
{
    new conta = id[playerid];
	if(conta != -1)
	{
		return Conta[playerid][c_Grana];
	}
	return 0;
}

stock CashPlayer(playerid)
{
    new conta = id[playerid];
	if(conta != -1)
	{
		return Conta[playerid][c_Cash];
	}
	return 0;
}

stock DarCash(playerid, grana)
{
	new conta = id[playerid];
	if(conta != -1)
	{
	    Conta[playerid][c_Cash] += grana;
	    salvar_conta(conta, 0, "c_Cash", sv_int(Conta[playerid][c_Cash]));
		if(grana > 0) PlayerPlaySound(playerid, 1052, 0, 0, 0);
		if(grana < 0) PlayerPlaySound(playerid, 1053, 0, 0, 0);

	}
}

stock DarGrana(playerid, grana)
{
	new conta = id[playerid];
	if(conta != -1)
	{
	    Conta[playerid][c_Grana] += grana;
	    salvar_conta(conta, 0, "c_Grana", sv_int(Conta[playerid][c_Grana]));
		if(grana > 0) PlayerPlaySound(playerid, 1052, 0, 0, 0);
		if(grana < 0) PlayerPlaySound(playerid, 1053, 0, 0, 0);

	}
}

stock DarBanco(playerid, grana)
{
	new conta = id[playerid];
	if(conta != -1)
	{
	    Conta[playerid][c_Banco] += grana;
	    salvar_conta(conta, 0, "c_Banco", sv_int(Conta[playerid][c_Banco]));

	}
}

stock SetarCash(playerid, grana)
{
    new conta = id[playerid];
	if(conta != -1)
	{
	    Conta[playerid][c_Cash] = grana;
	    if(Conta[playerid][c_Cash] < 0) Conta[playerid][c_Cash] = 0;
	    salvar_conta(conta, 0, "c_Cash", sv_int(Conta[playerid][c_Cash]));
	}
}

stock SetarGrana(playerid, grana)
{
    new conta = id[playerid];
	if(conta != -1)
	{
	    Conta[playerid][c_Grana] = grana;
	    if(Conta[playerid][c_Grana] < 0) Conta[playerid][c_Grana] = 0;
	    salvar_conta(conta, 0, "c_Grana", sv_int(Conta[playerid][c_Grana]));
	}
}

stock SetarBanco(playerid, grana)
{
    new conta = id[playerid];
	if(conta != -1)
	{

	    Conta[playerid][c_Banco] = grana;
	    if(Conta[playerid][c_Banco] < 0) Conta[playerid][c_Banco] = 0;
	    salvar_conta(conta, 0, "c_Banco", sv_int(Conta[playerid][c_Banco]));
	}
}

stock Acao(playerid, acao, barra, nome[], anim, nom1[], nom2[], bool:lop)
{
	KillTimer(Barra[playerid][b_Timer]);
    Barra[playerid][b_Acao] = acao;
    Barra[playerid][b_Barra] = barra;
	format(Barra[playerid][b_Nome], 100, "%s", nome);
	Barra[playerid][b_Anim] = anim;
	format(Barra[playerid][b_Anim1], 100, "%s", nom1);
	format(Barra[playerid][b_Anim2], 100, "%s", nom2);
	Barra[playerid][b_Lop] = lop;
	Carregando(playerid, 0);
	if(anim != 0) ApplyAnimation(playerid, nom1, nom2, 4.1, lop, false, false, false, 0, 1);
}



BCG:: Carregando(playerid, con)
{
	new sss[300];
    if(con == 3) // resposta //
	{
		new ID_ACAO = Barra[playerid][b_Acao];
		Barra[playerid][b_Acao] = 0;
		new conta = id[playerid];
		if(conta != -1)
		{
			if(ID_ACAO == 28) // usando droga
			{
				new slot = GetPVarInt(playerid, "slot");
				if(Inventario[playerid][slot][inv_Unidades] < 2)return SSM(playerid, -1, "{FF0000}[SERVER]: Voce nao tem no minimo 2g de drogas.");
				new Float:vida, Float:coletep, possibilidade = 0 + random(2), string[550];
			    GetPlayerArmour(playerid, Float:coletep);
			    GetPlayerHealth(playerid, Float:vida);
			    if(vida < 100 || coletep < 100)
				{
				new Float:VidaPP[MAX_PLAYERS], Float:ColetePP[MAX_PLAYERS];
				if(possibilidade == 0){
				    format(string, sizeof(string), "* O ID:[%d] fumou 2g de Maconha.", playerid);
					ProxDetector(5.0, playerid, string, -1,-1-1,-1,-1,-1);
				    VidaPP[playerid] = vida;
				    VidaPP[playerid] += 50;
				    ColetePP[playerid] = coletep;
				    ColetePP[playerid] += 15;
				    GameTextForPlayer(playerid, "~w~Fumou.", 1200, 6);
				    SetPlayerDrunkLevel(playerid, GetPlayerDrunkLevel(playerid) + 8000);
				    SetTimerEx("RetirarCamera", 30000, false, "d", playerid);
				}
				else if(possibilidade == 1){
				    format(string, sizeof(string), "* O ID:[%d] fumou 2g de Crack.", playerid);
					ProxDetector(5.0, playerid, string, -1,-1-1,-1,-1,-1);
				    VidaPP[playerid] = vida;
				    VidaPP[playerid] += 15;
				    ColetePP[playerid] = coletep;
				    ColetePP[playerid] += 50;
				    GameTextForPlayer(playerid, "~w~Fumou.", 1200, 6);
				    SetPlayerDrunkLevel(playerid, GetPlayerDrunkLevel(playerid) + 8000);
				    SetTimerEx("RetirarCamera", 30000, false, "d", playerid);
				}
				else if(possibilidade == 2){
				    format(string, sizeof(string), "* O ID:[%d] fumou 2g de Cocaina.", playerid);
					ProxDetector(5.0, playerid, string, -1,-1-1,-1,-1,-1);
				    VidaPP[playerid] = vida;
				    VidaPP[playerid] += 15;
				    ColetePP[playerid] = coletep;
				    ColetePP[playerid] += 15;
				    GameTextForPlayer(playerid, "~w~Saciado.", 1200, 6);
				    SetPlayerDrunkLevel(playerid, GetPlayerDrunkLevel(playerid) + 8000);
				    SetTimerEx("RetirarCamera", 30000, false, "d", playerid);
				}
				SetPlayerHealth(playerid, VidaPP[playerid]);
				SetPlayerArmour(playerid, ColetePP[playerid]);
				ApplyAnimation(playerid, "CRACK", "crckdeth2", 4.0, 1, 0, 0, 0, 0);
				SetTimerEx("DCANIM", 5000, false, "d", playerid);
				// 10x
				DiminuirInv(slot, playerid), DiminuirInv(slot, playerid);
			    }
			    else{
				SSM(playerid, -1, "{FF0000}* {E5EEFD}Voce ja esta louco, nao pode mais usar isso.");
			    }
			}
            if(ID_ACAO == 27)  // saqueando //
		    {
		        // dropar armas  equipadas //
		        new morto = saqueando_player[playerid];
		        if(Online(morto))
		        {
				new antes = playerid;
				playerid = morto;
	                Saqueado(playerid, 1);
				    new artt[13][2];
					new Float:ps[3];
					GetPlayerPos(playerid, ps[0], ps[1], ps[2]);
					ps[0] += RandomFloat2[random(sizeof RandomFloat2)];
					ps[1] += RandomFloat2[random(sizeof RandomFloat2)];
					for(new i; i<13; i++)
					{
						GetPlayerWeaponData(playerid, i, artt[i][0], artt[i][1] );
						if(artt[i][0] != 0)
						{
						    if(i == 2)
							{
							if(Taser(playerid))
							{
							    artt[i][0] = Conta[playerid][c_Taser][1];
							    artt[i][1] = Conta[playerid][c_Taser][2];
							    Conta[playerid][c_Taser][0] = 0;
							    Conta[playerid][c_Taser][1] = 0;
							    Conta[playerid][c_Taser][2] = 0;
							}
						    }

						    GetPlayerPos(playerid, ps[0], ps[1], ps[2]);
							ps[0] += RandomFloat2[random(sizeof RandomFloat2)];
							ps[1] += RandomFloat2[random(sizeof RandomFloat2)];
							if(i == 7 || i == 8) criar_item(arma_id(artt[i][0]), ps[0], ps[1], ps[2], artt[i][1], GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), i);
							else
							{
							    GetPlayerPos(playerid, ps[0], ps[1], ps[2]);
								ps[0] += RandomFloat2[random(sizeof RandomFloat2)];
								ps[1] += RandomFloat2[random(sizeof RandomFloat2)];
							    criar_item(arma_id(artt[i][0]), ps[0], ps[1], ps[2], 1, GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), i);
								if(artt[i][1] > 0)
								{
									for(new cc=44; cc<49; cc++)
									{
										if(Itens[cc][item_Tipo] == i)
										{
										    GetPlayerPos(playerid, ps[0], ps[1], ps[2]);
											ps[0] += RandomFloat2[random(sizeof RandomFloat2)];
											ps[1] += RandomFloat2[random(sizeof RandomFloat2)];
											if(cc != 6 && cc != 9) criar_item(cc, ps[0], ps[1], ps[2], artt[i][1], GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), i);
										}
									}
								}
							}
				  		}
				    }

				    // dropar colete //
				    if(Conta[playerid][c_Colete] > 0)
					{
					GetPlayerPos(playerid, ps[0], ps[1], ps[2]);
						ps[0] += RandomFloat2[random(sizeof RandomFloat2)];
						ps[1] += RandomFloat2[random(sizeof RandomFloat2)];
				    	criar_item(73, ps[0], ps[1], ps[2], 1, GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), Conta[playerid][c_Colete]);
				    }

				    // dropar grana //
				    new granS = GranaPlayer(playerid);
				    if(granS > 0)
					{
				    	criar_item(49, ps[0], ps[1], ps[2], granS, GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), 1);
						DarGrana(playerid, -granS);
				    }

				    // dropar inventario todo //
				    for(new slot; slot<MAX_SLOTS; slot++)
				    {
				        if(Inventario[playerid][slot][inv_ID] > 0)
				        {
				            GetPlayerPos(playerid, ps[0], ps[1], ps[2]);
				            ps[0] += RandomFloat2[random(sizeof RandomFloat2)];
				            ps[1] += RandomFloat2[random(sizeof RandomFloat2)];
				            criar_item(Inventario[playerid][slot][inv_ID], ps[0], ps[1], ps[2], Inventario[playerid][slot][inv_Unidades], GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), Inventario[playerid][slot][inv_Tipo], -1, Inventario[playerid][slot][inv_Ativo], Inventario[playerid][slot][inv_Tempo]);
				            limpar_slot(playerid, slot);
				        }
				    }

					ResetPlayerWeapons_(playerid);
					for(new i; i<13; i++)
					{
					    Conta[playerid][c_Arma][i] = 0;
					    Conta[playerid][c_Municao][i] = 0;
					}
					SetarColete(playerid, 0);
					salvar_conta(conta, -1, "c_Armas");
         			remocao_arma[playerid] = gettime()+5;
					playerid = antes;
					ms(playerid, 2, f("Voce saqueou os pertences de '%s', recloha-os do chao !", Nome(morto)));
					ms(morto, 2, f("O Jogador '%s'saqueou seus pertences !", Nome(playerid)));
		        }
		    }

		    if(ID_ACAO == 26)  // CONTA BANCARIA //
		    {
                if(Banco(playerid, 0) == 2)
                {
                    MS(playerid, 0, "Nao conseguimos criar sua Conta Bancaria, Tente novamente !");
                }
		    }

		    if(ID_ACAO == 25)  // comprando produtos //
		    {
		        new car = GetPVarInt(playerid, "car");
		        new tot = GetPVarInt(playerid, "tot");
	   			new numero = tot/VALOR_PRODUTO;
	   			new v = Info_Veiculo[car];
	   			if(GetVehicleModel(car) != 0)
	   			{
	   			    if(v != -1)
	   				{
						if(GranaPlayer(playerid) >= tot)
						{
							produtos_veiculo[v] += numero;
							DarGrana(playerid, -tot);
							format(sss, 200, "Voce comprou %d produtos por R$ %s, use /empresas para localizar os locais de venda.", numero, ConvertMoney(tot));
							ms(playerid, 1, sss);
							format(sss, 200, "Compra realizada, Foram colocados %d produtos no caminhao.", numero);
							MS(playerid, 1, sss);
							texto_caminhao(car, v);
						}
					}
				}
		    }

            if(ID_ACAO == 24)  // emplacando veiculo //
		    {
		        new i = GetPVarInt(playerid, "info");
		        new v = GetPVarInt(playerid, "veh");
		        if(i == -1 || v == -1) return 1;
		        if(Veiculo[i][v_Existe] == 1)
				{
				    if(Veiculo[i][v_Emplacar] == 1)
					{
					    if(GranaPlayer(playerid) >= TAXA_PLACA)
						{
                            gerar_placa(PlacaVeiculo[i], 20);
                            Veiculo[i][v_Emplacar] = 0;
                            if(GetVehicleModel(v) != 0)
							{
							    if(Info_Veiculo[v] == i)
								{
									SetVehicleNumberPlate(v, PlacaVeiculo[i]);
								}
							}
                            SalvarInfo(i);
                            if(Veiculo[i][v_PlacaLabel] != DynamicText3D:-1)
							{
							    DestroyDynamic3DTextLabel(Veiculo[i][v_PlacaLabel]);
							    Veiculo[i][v_PlacaLabel] = DynamicText3D:-1;
							}
							new placa_str[64];
							format(placa_str, 64, "{AA00FF}%s{FFFFFF}\n| {FFFFFF}%s |", NomeVeiculo(Veiculo[i][v_Modelo]), PlacaVeiculo[i]);
							Veiculo[i][v_PlacaLabel] = CreateDynamic3DTextLabel(placa_str, 0xffffffff, 0.0, -2.0, 0.2, 20.0, INVALID_PLAYER_ID, v, 0, -1, -1, -1, 100.0);
                            DarGrana(playerid, -TAXA_PLACA);
                            MS(playerid, 1, "Emplacamento concluido com sucesso !");
                            format(sss, 300, "Voce pagou R$ %s pelo emplacamento, Nova placa: %s.", ConvertMoney(TAXA_PLACA), PlacaVeiculo[i]);
							ms(playerid, 1, sss);
						}
					}
		        }
		    }

		    if(ID_ACAO == 23)  // desmanche //
		    {
	    		new v = funcao_id[playerid];
	    		if(GetVehicleModel(v) != 0)
		      	{
				new i = Info_Veiculo[v];
				if(i != -1)
				{
					new tip = GetPVarInt(playerid, "tip");
					new a = GetPVarInt(playerid, "a");
					if(tip == 0) SetVehicleHealth(v, 300.0);
					else if(tip == 5) Veiculo[i][v_Bateria] = 0;
					else if(tip == 2) Veiculo[i][v_Farol][a] = 1, update_danos_veiculo(v, i);
					else if(tip == 1) Veiculo[i][v_Painel][a] = 3, update_danos_veiculo(v, i);
					else if(tip == 3) Veiculo[i][v_Porta][a] = 4, update_danos_veiculo(v, i);

					SalvarVeiculo(v);
				new valor_peca = Veiculo[i][v_Compra] / 13;
					DarGrana(playerid, valor_peca);

					if(tip == 0) ms(playerid, 1, f("Motor removido! +R$ %s.", ConvertMoney(valor_peca)));
					if(tip == 5) ms(playerid, 1, f("Bateria removida! +R$ %s.", ConvertMoney(valor_peca)));
					if(tip == 2) ms(playerid, 1, f("Farol removido! +R$ %s.", ConvertMoney(valor_peca)));
					if(tip == 3) ms(playerid, 1, f("Peca removida! +R$ %s.", ConvertMoney(valor_peca)));
					if(tip == 1) ms(playerid, 1, f("Peca removida! +R$ %s.", ConvertMoney(valor_peca)));

					new Float:vh;
					GetVehicleHealth(v, vh);
					if(Veiculo[i][v_Bateria] == 0 && vh <= 300.0 &&
					   Veiculo[i][v_Painel][5] >= 3 && Veiculo[i][v_Painel][6] >= 3 &&
					   Veiculo[i][v_Porta][0] >= 4 && Veiculo[i][v_Porta][1] >= 4 &&
					   Veiculo[i][v_Porta][2] >= 4 && Veiculo[i][v_Porta][3] >= 4 &&
					   Veiculo[i][v_Farol][0] >= 1 && Veiculo[i][v_Farol][1] >= 1 && Veiculo[i][v_Farol][2] >= 1)
					{
					    new dono = Veiculo[i][v_Dono];
					    new org_log = OrgPlayer(playerid);
					    if(org_log != -1)
					        escrever_log(f("OrgsLog/Org_%d.txt", org_log), f("Membro '%s' desmanchou %s %s.", Nome(playerid), NomeVeiculo(GetVehicleModel(v)), (dono != -1) ? f("de '%s'", NomeConta(dono)) : "sem dono"));
					    ms(playerid, 2, "Veiculo completamente desmanchado e destruido!");
					    if(dono != -1)
					    {
					        new dono_online = ContaOnline(dono);
					        if(dono_online != -1)
					            ms(dono_online, 0, "Seu veiculo foi totalmente desmanchado e destruido!");
					    }
					    DestroyVehicle_(v);
					    DestruirInfo(i);
					}
					else
					{
					    desmanche_veiculo(playerid, v);
					}
		            }
		        }
		        funcao_usando[playerid] = -1;
			}


		    if(ID_ACAO == 22)  // usando fertilizante //
		    {
		        new slot = GetPVarInt(playerid, "slot");
		        if(slot != -1)
		        {
				new m = GetPVarInt(playerid, "mac");
				if(m  != -1)
				{
					Maconha[m][mac_Fertilizante] = 10;
					diminuir_inv(conta, slot);
					ms(playerid, 1, "Voce colocou fertilizante nesta plantacao, e o processo de crecimento foi acelerado temporariamente.");
						texto_maconha(m);
						salvar_maconha(m);
						salvar_inventario(conta, slot);
					}
				}
			}

		    if(ID_ACAO == 21)  // LAVANDO DINHEIRO NA ORG //
		    {
				new i = GetPVarInt(playerid, "id_org");
				if(i != -1)
				{
				new grana;
					for(new a; a<MAX_SLOTS; a++)
					{
						if(Inventario[playerid][a][inv_ID] == 76)
						{
						    grana += Inventario[playerid][a][inv_Unidades];
							limpar_slot(playerid, a);
						}
					}
					Org[i][o_Cofre] += grana;
					salvar_org(i);
					format(sss, 300, "Lavagem de Dinheiro concluida, R$ %s foi colocado no Cofre da Org !", ConvertMoney(grana));
					ms(playerid, 2, sss);
					escrever_log(f("OrgsLog/Org_%d.txt", i), f("'%s' lavou R$ %s de Grana suja.", Nome(playerid), ConvertMoney(grana)));
				}
		    }

		    if(ID_ACAO == 20)  // TRATANDO JOGADOR //
		    {
		        new sss1[150];
		        new Float:pp[3];
				new idd = GetPVarInt(playerid, "morto");
				if(!Online(idd)) ms(playerid, 0, "O jogador nao esta mais online !");
				else if(id[idd] == -1) ms(playerid, 0, "O jogador nao esta mais online !");
				else if(Conta[idd][c_Hospital] <= 0) ms(playerid, 0, "O jogador nao esta mais Hospitalizado !");
				else
				{
					GetPlayerPos(idd, pp[0],pp[1],pp[2]);
					if(!IsPlayerInRangeOfPoint(playerid, 2, pp[0],pp[1],pp[2])) ms(playerid, 0, "Voce esta muito longe do Jogador !");
					else
					{
					Conta[idd][c_Hospital] -= 500;
					if(Conta[idd][c_Hospital] < 0) Conta[idd][c_Hospital] = 0;
					format(sss1, 150, "Voce tratou o jogador %s.", Nome(idd));
					ms(playerid, 1, sss1);
					format(sss1, 150, "Voce foi tratado pelo Medico %s.", Nome(playerid));
					ms(idd, 3, sss1);
					MetaEmprego(playerid, 1);
				}
		        }
		    }

		    if(ID_ACAO == 19)  // vendendo maconha //
		    {
                if(segurando_player[playerid] == 11)
   				{
		            jogar(playerid);
		            ms(playerid, 1, "Voce vendeu 500 gramas de maconha por R$ 2.500.");
		            DarGrana(playerid, 2500);
		        }
		        else ms(playerid, 0, "Voce precisa estar com a maconha em maos para vender !");
		    }

		    if(ID_ACAO == 18)  // regando pe de maconha //
		    {
		        new slot = GetPVarInt(playerid, "slot");
		        if(slot != -1)
		        {
				new m = GetPVarInt(playerid, "mac");
				if(m != -1)
				{
					Inventario[playerid][slot][inv_ID] = 50;
					Inventario[playerid][slot][inv_Tipo] = 0;
					salvar_inventario(conta, slot);
					Maconha[m][mac_Agua] = 100;
					atualizar_maconha(m);
					salvar_maconha(m);
					ms(playerid, 1, "Voce regou o pe de maconha, e o galao ficou vazio !");
				}
      			}
		    }

		    if(ID_ACAO == 17)  // enchendo galao de agua //
		    {
		        new slot = GetPVarInt(playerid, "slot");
		        if(slot != -1)
		        {
				Inventario[playerid][slot][inv_ID] = 51;
				Inventario[playerid][slot][inv_Tipo] = 3;
				salvar_inventario(conta, slot);
				ms(playerid, 1, "Voce encheu o galao de agua, confira o inventario !");
		        }
		    }

		    if(ID_ACAO == 16)  // colhendo maconha //
		    {
		        new m = GetPVarInt(playerid, "mac"), marcr = 5 + random(20), sds[550];
		        if(m != -1)
		        {
				if(Maconha[m][mac_Existe] == 1 && Maconha[m][mac_Status] == 5)
				{
				    Maconha[m][mac_Existe] = 0;
				    atualizar_maconha(m);
				    salvar_maconha(m);
				    criar_maconha_amarrada(playerid);
                        add_inv(id[playerid], 90, marcr, 0, 0, 0);
                        format(sds, sizeof(sds), "{00FF00}[COLHEITA]: Voce acaba de colher %dg de maconha, use o item para fumar.", marcr);
                        SSM(playerid, -1, sds);
                        SSM(playerid, -1, "{FF0000}[MACONHA] A plantacao que esta em tuas costas, voce pode continuar a rota.");
				}
				else ms(playerid, 0, "Alguem ja colheu o pe de maconha !");
		        }
		    }

		    if(ID_ACAO == 15)  // plantando maconha //
		    {
		        new slot = GetPVarInt(playerid, "slot");
		        if(slot != -1)
		        {
				new Float:pos[4];
					GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
					PegarFrentePlayer(playerid, pos[0], pos[1], 0.4);
					new m = criar_maconha(pos[0], pos[1], pos[2], id[playerid]);
					if(m != -1)
					{
					ms(playerid, 2, "Voce plantou um pe de maconha neste local, nao esqueca de rega-lo, use um galao com agua para fazer isso.");
					ms(playerid, 2, "O pe de maconha deve estar Hidratado para que possa crecer, se nao tiver os cuidados necessarios, ele morre.");
					ms(playerid, 2, "Verifique seu pe de maconha, quando o crecimento total for atingido, voce podera colher as gramas de maconha.");
						ms(playerid, 2, "Use /maconhas para localizar seus pes de maconha !");
						diminuir_inv(conta, slot);
					}
					else ms(playerid, 0, "Numero maximo de pes de maconha no servidor foi atingido !");
				}
			}

			if(ID_ACAO == 14)  // eletricista //
		    {
		        new ca = eletricista_ID[playerid];
				new tipo = eletricista_tipo[playerid];

		        // caixa eletronico //
		        if(tipo == 0)
		        {
		            if(ca != -1)
		            {
		                CaixaEletronico[ca][ce_Quebrado] = 0;
					    atualizar_caixa_eletronico(ca);
					    salvar_caixa_eletronico(ca);
					    DarGrana(playerid, 250);
						ms(playerid, 1, "Voce recebeu R$ 250 pelo concerto do caixa eletronico.");
					}
		        }

		        // radar //
		        if(tipo == 1)
		        {
		            if(ca != -1)
		            {
		                Radar[ca][radar_Ativado] = 1;
						texto_radar(ca);
						salvar_radar(ca);
					    DarGrana(playerid, 550);
						ms(playerid, 1, "Voce recebeu R$ 550 pelo concerto do caixa eletronico.");
					}
		        }

		        // CAMERA //
		        if(tipo == 2)
		        {
		            if(ca != -1)
		            {
		                Camera[ca][cam_Quebrada] = 0;
						atualizar_camera(ca);
						salvar_camera(ca);
					    DarGrana(playerid, 300);
						ms(playerid, 1, "Voce recebeu R$ 300 pelo concerto da Camera de Seguranca.");
					}
		        }

		        // CAMERA caixa //
		        if(tipo == 3)
		        {
		            if(ca != -1)
		            {
	                	CaixaEletronico[ca][cec_Quebrado] = 0;
						atualizar_caixa_eletronico(ca);
					    salvar_caixa_eletronico(ca);
					    DarGrana(playerid, 300);
						ms(playerid, 1, "Voce recebeu R$ 300 pelo concerto da Camera de Seguranca.");
					}
		        }

		        eletricista_tipo[playerid] = -1;
				eletricista_ID[playerid] = -1;
				MetaEmprego(playerid);
		    }

			if(ID_ACAO == 13)  // lavar dinheiro sujo //
		    {
		        new grana;
				for(new a; a<MAX_SLOTS; a++)
				{
					if(Inventario[playerid][a][inv_ID] == 76)
					{
					    grana += Inventario[playerid][a][inv_Unidades];
						limpar_slot(playerid, a);
					}
				}
				DarGrana(playerid, grana/2);
				format(sss, 300, "[MERCADO NEGRO] Lavagem de Dinheiro concluida, voce recebeu R$ %s !", ConvertMoney(grana/2));
				ms(playerid, 5, sss);
		    }

			if(ID_ACAO == 12)  // pegar grana suja //
		    {
		        if(EmServico(playerid)) return ms(playerid, 0, "Policiais em servico nao podem pegar dinheiro sujo !");
		        new idd = pegando_grana[playerid];
		        if(idd != -1)
		        {
					new slo = inv_vazio(playerid);
			     	if(slo != -1)
					{
					    add_inv(id[playerid], 76, Item[idd][item_Unidades], 0, 0, 0);
	                    destruiritem(idd);
	                    ms(playerid, 1, "Dinheiro sujo recolhido, confira seu Inventario.");
					}
					else ms(playerid, 0, "Seu Inventario esta cheio !");
				}
				pegando_grana[playerid] = -1;
		    }

			if(ID_ACAO == 11)  // explosivo //
		    {
		        new slot = GetPVarInt(playerid, "slot");
		        if(slot != -1) criar_explosivo(playerid, slot);
		    }


	        if(ID_ACAO == 10)  // revistando //
		    {
		        new i = revistando[playerid];
		        terminar_revista(playerid, i);
		    }

	        if(ID_ACAO == 9)  // usando contrato hospitalar //
		    {
		        new slot = GetPVarInt(playerid, "slot");
		        if(slot != -1)
		        {
				diminuir_inv(conta, slot);
				DarVida(playerid, 100);
				salvar_conta(conta, 0, "c_Vida", sv_int(Conta[playerid][c_Vida]));
				format(string_prox, 300, "** '%s' usou um Contrato Hospitalar **", Nome(playerid));
					ProxDetector(15.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
					ms(playerid, 1, "Voce recebeu os cuidados medicos necessarios e foi totalmente curado.");
				}
		    }

	        if(ID_ACAO == 8)  // usando kit medico //
		    {
		        new slot = GetPVarInt(playerid, "slot");
		        if(slot != -1)
		        {
				diminuir_inv(conta, slot);
				DarVida(playerid, VidaPlayer(playerid)+15);
				ms(playerid, 1, "Voce recuperou 15 de vida por usar um Kit Medico.");
		        }
		    }

			if(ID_ACAO == 7)  // concertando na oficina //
		    {
	    		new v = funcao_id[playerid];
	    		if(GetVehicleModel(v) != 0)
		      	{
				new i = Info_Veiculo[v];
				if(i != -1)
				{
					new tip = GetPVarInt(playerid, "tip");
					new a = GetPVarInt(playerid, "a");
					if(tip == 0) SetVehicleHealth(v, 1000.0), status_veiculo(playerid, v);
					else if(tip == 5) Veiculo[i][v_Bateria] = 100, status_veiculo(playerid, v);
						else if(tip == 2) Veiculo[i][v_Farol][a] = 0, update_danos_veiculo(v, i), status_veiculo(playerid, v);
					else if(tip == 4) Veiculo[i][v_Pneu][a] = 0, update_danos_veiculo(v, i), status_veiculo(playerid, v);
					else if(tip == 1)
						{
							Veiculo[i][v_Painel][a] = 3;
							Veiculo[i][v_Painel][0] = 3;
							Veiculo[i][v_Painel][1] = 3;
							Veiculo[i][v_Painel][2] = 3;
							Veiculo[i][v_Painel][3] = 3;
							update_danos_veiculo(v, i);
							Veiculo[i][v_Painel][a] = 0;
							Veiculo[i][v_Painel][0] = 0;
							Veiculo[i][v_Painel][1] = 0;
							Veiculo[i][v_Painel][2] = 0;
							Veiculo[i][v_Painel][3] = 0;
							update_danos_veiculo(v, i);
							SetVehicleVirtualWorld(v, 20);
							update_danos_veiculo(v, i);
							SetTimerEx("voltar_veiculo", 700, false, "d", v);
							status_veiculo(playerid, v);
						}
						else if(tip == 3)
						{
							Veiculo[i][v_Porta][a] = 3;
							Veiculo[i][v_Porta][a] = 0;
							update_danos_veiculo(v, i);
							SetVehicleVirtualWorld(v, 20);
							update_danos_veiculo(v, i);
							SetTimerEx("voltar_veiculo", 700, false, "d", v);
							status_veiculo(playerid, v);
						}
						SalvarVeiculo(v);
						if(tip == 0) ms(playerid, 1, "O Motor do veiculo foi concertado !");
						if(tip == 5) ms(playerid, 1, "A Bateria do veiculo foi carregada !");
						if(tip == 4) ms(playerid, 1, "O Pneu furado do veiculo foi trocado !");
						if(tip == 2) ms(playerid, 1, "O Farol quebrado do veiculo foi trocado !");
						if(tip == 3) ms(playerid, 1, "A peca do veiculo quebrada foi trocada !");
						if(tip == 1) ms(playerid, 1, "A peca do veiculo quebrada foi trocada !");
						MetaEmprego(playerid);
		            }
		        }
		        funcao_usando[playerid] = -1;
			}

			if(ID_ACAO == 6)  // enchendo galao //
		    {
		        new slot = GetPVarInt(playerid, "slot");
		        if(slot != -1)
		        {
				new valor = GetPVarInt(playerid, "valor");
					new tipo = GetPVarInt(playerid, "tipo");
				if(tipo == 0) format(sss, 300, "Voce pagou R$ %s por 20 litros de Gasolina.", ConvertMoney(valor));
					if(tipo == 1) format(sss, 300, "Voce pagou R$ %s por 20 litros de Alcool.", ConvertMoney(valor));
					if(tipo == 2) format(sss, 300, "Voce pagou R$ %s por 20 litros de Oleo Disel.", ConvertMoney(valor));
					DarGrana(playerid, -valor);
				    Inventario[playerid][slot][inv_ID] = 51;
				    Inventario[playerid][slot][inv_Unidades] = 1;
				    Inventario[playerid][slot][inv_Tipo] = tipo;
				    ms(playerid, 1, sss);
				    salvar_inventario(conta, slot);
				    add_cp(valor);
			    }
		    }

			if(ID_ACAO == 5)  // TIRANDO RG //
		    {
		        if(conta != -1)
		        {
		            new fez = criar_rg(conta);
			      	if(fez == 0) ms(playerid, 0, "Voce ainda nao tem um CPF ! Tire seu CPF antes de tirar seu RG.");
			      	else if(fez == -1) ms(playerid, 0, "Ja encontramos um RG com suas informacoes em seu banco de dados, use tecla N > Celular > Carteira para ver ou mostrar a alguem !");
					else if(fez == 2) ms(playerid, 0, "Houve um erro ao criar seu RG, tete novamente !");
					else
					{
						ms(playerid, 1, "Seu RG foi tirado com sucesso, use tecla N > Celular > Carteira a qualquer momento para ver seus documentos.");
						mostrar_rg(playerid, conta);
						add_cp(5000);
					}
		        }
		    }

		    if(ID_ACAO == 4)  // TIRANDO CPF //
		    {
		        if(conta != -1)
		        {
			      	if(criar_cpf(conta) == 0) ms(playerid, 0, "Ja encontramos um CPF com suas informacoes em seu banco de dados, use tecla N > Celular > Carteira para ver ou mostrar a alguem !");
	                else if(criar_cpf(conta) == 2) ms(playerid, 0, "Houve um erro ao criar seu CPF, tente novamente !");
	                else
					{
						ms(playerid, 1, "Seu CPF foi tirado com sucesso, use tecla N > Celular > Carteira a qualquer momento para ver seus documentos.");
	                	mostrar_cpf(playerid, conta);
	                	add_cp(5000);
					}
		        }
		    }

		    if(ID_ACAO == 3)  // ABASTECENDO VEICULO NO POSTO //
		    {
		        if(conta != -1)
		        {
			      	new valor = GetPVarInt(playerid, "valor");
			      	new v = GetPVarInt(playerid, "veh");
			      	if(v != -1)
			      	{
					DarGrana(playerid, -valor);
					add_cp(valor);
					Veiculo[v][v_Gasolina] = 100;
					format(sss, 150, "Veiculo '%s' totalmente abastecido por R$ %s.", NomeVeiculo(Veiculo[v][v_Modelo]), ConvertMoney(valor));
					ms(playerid, 1, sss);
				}
		        }
		    }

		    if(ID_ACAO == 2)  // ABASTECENDO VEICULO COM GALAO //
		    {
		        if(conta != -1)
		        {
			      	new slot = GetPVarInt(playerid, "slot");
			      	if(slot != -1)
			      	{
				      	new veh = GetPVarInt(playerid, "veiculo");
				      	if(veh != -1)
				      	{
						Inventario[playerid][slot][inv_ID] = 50;
						format(sss, 150, "Veiculo '%s' abastecido com 20 Litros.", NomeVeiculo(Veiculo[veh][v_Modelo]));
						ms(playerid, 1, sss);
						Veiculo[veh][v_Gasolina] += 20;
						if(Veiculo[veh][v_Gasolina] > 100) Veiculo[veh][v_Gasolina] = 100;
					}
				}
		        }
		    }

		    if(ID_ACAO == 1)  // SALVADO JOGADOR //
		    {
		        new sss1[150];
		        new Float:pp[3];
				new idd = GetPVarInt(playerid, "morto");
				if(!Online(idd)) ms(playerid, 0, "O jogador nao esta mais online !");
				else if(id[idd] == -1) ms(playerid, 0, "O jogador nao esta mais online !");
				else if(Conta[idd][c_Morto] == 0) ms(playerid, 0, "O jogador nao esta mais gravimente ferido !");
				else
				{
					GetPlayerPos(idd, pp[0],pp[1],pp[2]);
					if(!IsPlayerInRangeOfPoint(playerid, 2, pp[0],pp[1],pp[2])) ms(playerid, 0, "Voce esta muito longe do Jogador !");
					else
					{
					if(PlayerMedico(playerid) || PlayerCop(playerid))
						{
						Conta[idd][c_Morto] = -1;
					    	MetaEmprego(playerid, 1);
						if(GranaPlayer(idd) >= 750)
						{
						    DarGrana(playerid, 750);
							DarGrana(idd, -750);
							format(sss1, 150, "Voce salvou o jogador %s, e recebeu R$ 750.", Nome(idd));
							ms(playerid, 1, sss1);
							format(sss1, 150, "Voce foi salvo pelo jogador %s, o custo foi de R$ 750.", Nome(playerid));
							ms(idd, 3, sss1);
						}
						else
						{
						    format(sss1, 150, "Voce salvou o jogador %s, mais ele nao tem R$ 750 em maos.", Nome(idd));
							ms(playerid, 1, sss1);
							format(sss1, 150, "Voce foi salvo pelo jogador %s, voce nao pode pagar R$ 750 do custo.", Nome(playerid));
							ms(idd, 3, sss1);
						}
						Morreu(idd);
					    }
				}
		        }
		    }
	    }
	}

	if(con == 0)
	{
	    Barra[playerid][b_Adicionar] = 0;
	    KillTimer(Barra[playerid][b_Timer]);
	    Barra[playerid][b_Timer] = SetTimerEx("Carregando", 250, true, "dd", playerid, 1 );
	    PlayerTextDrawSetString(playerid, TextBarra_p[playerid][1], "_");
		for(new i; i < sizeof TextBarra; i++) TextDrawShowForPlayer(playerid, TextBarra[i]);
		if(Barra[playerid][b_Anim] == 0) Congelar(playerid);
	}


	if(con == 1)
	{
	    // atualizar barrinha de carregamento //
	    Barra[playerid][b_Adicionar] += 5;
	    new Float:unid = (402.000000 - 235.651458)/ Barra[playerid][b_Barra];
	    new Float:bar = 235.651458 + (unid*floatround(Barra[playerid][b_Adicionar]));
	    PlayerTextDrawTextSize(playerid, TextBarra_p[playerid][0],  bar, 5.0);
	    PlayerTextDrawShow(playerid, TextBarra_p[playerid][0]);
	    PlayerTextDrawSetString(playerid, TextBarra_p[playerid][1], Barra[playerid][b_Nome]);
	    PlayerTextDrawShow(playerid, TextBarra_p[playerid][1]);
	    PlayerTextDrawShow(playerid, TextBarra_p[playerid][2]);

	    // gasolina gradual durante abastecimento //
	    if(Barra[playerid][b_Acao] == 3)
	    {
	        new v = GetPVarInt(playerid, "veh");
	        if(v != -1)
	        {
	            new start_gas = GetPVarInt(playerid, "refuel_gas_start");
	            if(start_gas > 0)
	            {
	                new Float:progress = float(Barra[playerid][b_Adicionar]) / float(Barra[playerid][b_Barra]);
	                if(progress > 1.0) progress = 1.0;
	                Veiculo[v][v_Gasolina] = start_gas + floatround(float(100 - start_gas) * progress);
	                if(Veiculo[v][v_Gasolina] > 100) Veiculo[v][v_Gasolina] = 100;
	            }
	        }
	    }

	    if(Barra[playerid][b_Adicionar] >= Barra[playerid][b_Barra])
	    {
	        KillTimer(Barra[playerid][b_Timer]);
	        Carregando(playerid, 4);
	    }
	}

	if(con == 2)
	{
        for(new i; i < sizeof TextBarra; i++) TextDrawHideForPlayer(playerid, TextBarra[i]);
        PlayerTextDrawHide(playerid, TextBarra_p[playerid][0]);
        PlayerTextDrawHide(playerid, TextBarra_p[playerid][1]);
        PlayerTextDrawHide(playerid, TextBarra_p[playerid][2]);
        KillTimer(Barra[playerid][b_Timer]);
        if(Barra[playerid][b_Anim] != 0) ClearAnimations(playerid, 1);
		else Descongelar(playerid);
		if(IsPlayerAttachedObjectSlotUsed(playerid, 9)) RemovePlayerAttachedObject(playerid, 9);

		// eletricista //
		if(Barra[playerid][b_Acao] == 14)
		{
		    eletricista_tipo[playerid] = -1;
		    eletricista_ID[playerid] = -1;
		}

		// concertando na oficina //
		if(Barra[playerid][b_Acao] == 7)
		{
		    funcao_usando[playerid] = -1;
		}

		// grana suja no chao //
		if(Barra[playerid][b_Acao] == 12)
		{
			pegando_grana[playerid] = -1;
		}

		// salvando jogador //
		if(Barra[playerid][b_Acao] == 1)
		{
		    new idd = GetPVarInt(playerid, "morto");
		    if(Online(idd))
		    {
		    	KillTimer(timer_morto[idd]);
		    	timer_morto[idd] = SetTimerEx("Morrendo", 1000, true, "d", idd);
		    }
		}

        Barra[playerid][b_Acao] = 0;
	}

	if(con == 4)
	{
	    for(new i; i < sizeof TextBarra; i++) TextDrawHideForPlayer(playerid, TextBarra[i]);
        PlayerTextDrawHide(playerid, TextBarra_p[playerid][0]);
        PlayerTextDrawHide(playerid, TextBarra_p[playerid][1]);
        PlayerTextDrawHide(playerid, TextBarra_p[playerid][2]);
        KillTimer(Barra[playerid][b_Timer]);
        if(Barra[playerid][b_Anim] != 0) ClearAnimations(playerid, 1);
		else Descongelar(playerid);
		if(IsPlayerAttachedObjectSlotUsed(playerid, 9))RemovePlayerAttachedObject(playerid, 9);
        Carregando(playerid, 3);
	}
	return 1;
}

stock DiminuirInv(slot, playerid)
{
    if(Inventario[playerid][slot][inv_Unidades] > 1) return Inventario[playerid][slot][inv_Unidades] --;
    if(Inventario[playerid][slot][inv_Unidades] == 1)
    {
        Inventario[playerid][slot][inv_Unidades] = 0;
        Inventario[playerid][slot][inv_ID] = 0;
    }
    return 1;
}

stock tem_item(playerid, item)
{
	if(Online(playerid))
	{
	    new conta = id[playerid];
	    if(conta != -1)
	    {
			for(new i; i<MAX_SLOTS; i++)
			{
			    if(Inventario[playerid][i][inv_ID] == item)
				{
					return i;
			    }
			}
		}
	}
	return -1;
}


stock Morreu(playerid)
{
	if(Online(playerid))
	{
	    new c = id[playerid];
        if(c != -1)
        {
			if(Conta[playerid][c_Morto] == -1)
		    {
		        KillTimer(timer_morto[playerid]);
		        Conta[playerid][c_Morto] = 0;
		        ClearAnimations(playerid, 1);
		        TextDrawHideForPlayer(playerid, TextMorreu[0]);
	            TextDrawHideForPlayer(playerid, TextMorreu[1]);
	            TextDrawHideForPlayer(playerid, TextMorreu[2]);
	            TextDrawHideForPlayer(playerid, TextMorreu[3]);
	            TextDrawHideForPlayer(playerid, TextMorreu[4]);
	            TextDrawHideForPlayer(playerid, TextMorreu[5]);
	            TextDrawHideForPlayer(playerid, TextMorreu[6]);
	            PlayerTextDrawHide(playerid, TextMorreu_p[playerid][0]);
	            SetarVida(playerid, 30);
	            ApplyAnimation(playerid, "CAMERA", "CAMCRCH_TO_CAMSTND", 4.1, false, false, false, false, 0, 1);
	            CancelSelectTextDraw(playerid);
		    }
			else if(Conta[playerid][c_Morto] == 0)
		    {
		        Descongelar(playerid);
		        player_rendido[playerid] = 0;
		        player_algemado[playerid] = 0;
		        player_amarrado[playerid] = 0;
		        player_arrastado[playerid] = -1;
		        SetPlayerSpecialAction(playerid, 0);
				Conta[playerid][c_Morto] = (10*60);
				Conta[playerid][c_Morto2] = gettime()+120;
				ApplyAnimation(playerid, "CRACK", "CRCKIDLE1", 4.1, true, false, false, false, 0, 1);
				KillTimer(timer_morto[playerid]);
	            timer_morto[playerid] = SetTimerEx("Morrendo", 1000, true, "d", playerid);
	            TextDrawShowForPlayer(playerid, TextMorreu[0]);
	            TextDrawShowForPlayer(playerid, TextMorreu[1]);
	            TextDrawShowForPlayer(playerid, TextMorreu[2]);
	            TextDrawShowForPlayer(playerid, TextMorreu[3]);
	            TextDrawShowForPlayer(playerid, TextMorreu[4]);
	            TextDrawShowForPlayer(playerid, TextMorreu[5]);
	            TextDrawShowForPlayer(playerid, TextMorreu[6]);
	            PlayerTextDrawTextSize(playerid, TextMorreu_p[playerid][0], 416.376983, 0.000000);
	            PlayerTextDrawShow(playerid, TextMorreu_p[playerid][0]);
	            SelectTextDraw(playerid, 0xffff00ff);
	            timer_kitar[playerid] = gettime()+120;
				SetarVida(playerid, 30);
			}
			else
			{
			    ApplyAnimation(playerid, "CRACK", "CRCKIDLE1", 4.1, true, false, false, false, 0, 1);
				KillTimer(timer_morto[playerid]);
	            timer_morto[playerid] = SetTimerEx("Morrendo", 1000, true, "d", playerid);
	            TextDrawShowForPlayer(playerid, TextMorreu[0]);
	            TextDrawShowForPlayer(playerid, TextMorreu[1]);
	            TextDrawShowForPlayer(playerid, TextMorreu[2]);
	            TextDrawShowForPlayer(playerid, TextMorreu[3]);
	            TextDrawShowForPlayer(playerid, TextMorreu[4]);
	            TextDrawShowForPlayer(playerid, TextMorreu[5]);
	            TextDrawShowForPlayer(playerid, TextMorreu[6]);
	            PlayerTextDrawTextSize(playerid, TextMorreu_p[playerid][0], 416.376983, 0.000000);
	            PlayerTextDrawShow(playerid, TextMorreu_p[playerid][0]);
	            SelectTextDraw(playerid, 0xffff00ff);
				SetarVida(playerid, 30);
			}
		}
	}
}

BCG:: RetirarCamera(playerid){
    if(GetPlayerDrunkLevel(playerid) != 0){
        SetPlayerDrunkLevel(playerid, 0);
    }
    return 1;
}

BCG:: Morrendo(playerid)
{

	if(!Online(playerid))
	{
	 	if(playerid > -1 && playerid < MAX_PLAYERS)
		{
			KillTimer(timer_morto[playerid]);
		}
	}
	else
	{
		new conta = id[playerid];
		if(conta != -1)
		{
			Conta[playerid][c_Morto] -= 1;
			new Float:BARR = 476.889892-46.763366;
			new Float:unid = BARR/(10*60);
			PlayerTextDrawTextSize(playerid, TextMorreu_p[playerid][0], 46.763366+(unid*floatround(Conta[playerid][c_Morto])), 0.000000);
		 	PlayerTextDrawShow(playerid, TextMorreu_p[playerid][0]);
		 	ApplyAnimation(playerid, "CRACK", "CRCKIDLE1", 4.1, true, false, false, false, 0, 1);

			if(!IsPlayerInRangeOfPoint(playerid, 15, Conta[playerid][c_X], Conta[playerid][c_Y], Conta[playerid][c_Z]))
			{
			    SetPlayerPos_(playerid, Conta[playerid][c_X]+0.1, Conta[playerid][c_Y]+0.1, Conta[playerid][c_Z]+0.1);
			    SetPlayerFacingAngle(playerid, Conta[playerid][c_A]);
			    SetPlayerInterior(playerid, Conta[playerid][c_Interior]);
				SetPlayerVirtualWorld_(playerid, Conta[playerid][c_Mundo]);
			}
			else
			{
			    GetPlayerPos(playerid, Conta[playerid][c_X], Conta[playerid][c_Y], Conta[playerid][c_Z]);
		        GetPlayerFacingAngle(playerid, Conta[playerid][c_A]);
		        Conta[playerid][c_Interior] = GetPlayerInterior(playerid);
				Conta[playerid][c_Mundo] = GetPlayerVirtualWorld_(playerid);
			}

			if(Conta[playerid][c_Morto] <= 0)
			{
			    // dropar armas equipadas //
			    new artt[13][2];
				new Float:ps[3];
				GetPlayerPos(playerid, ps[0], ps[1], ps[2]);
				ps[0] += RandomFloat2[random(sizeof RandomFloat2)];
				ps[1] += RandomFloat2[random(sizeof RandomFloat2)];
				for(new i; i<13; i++)
				{
					GetPlayerWeaponData(playerid, i, artt[i][0], artt[i][1] );
					if(artt[i][0] != 0)
					{
					    if(i == 2)
						{
						if(Taser(playerid))
						{
						    artt[i][0] = Conta[playerid][c_Taser][1];
						    artt[i][1] = Conta[playerid][c_Taser][2];
						    Conta[playerid][c_Taser][0] = 0;
						    Conta[playerid][c_Taser][1] = 0;
						    Conta[playerid][c_Taser][2] = 0;
						}
					    }

					    GetPlayerPos(playerid, ps[0], ps[1], ps[2]);
						ps[0] += RandomFloat2[random(sizeof RandomFloat2)];
						ps[1] += RandomFloat2[random(sizeof RandomFloat2)];
						if(i == 7 || i == 8) criar_item(arma_id(artt[i][0]), ps[0], ps[1], ps[2], artt[i][1], GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), i);
						else
						{
						    GetPlayerPos(playerid, ps[0], ps[1], ps[2]);
							ps[0] += RandomFloat2[random(sizeof RandomFloat2)];
							ps[1] += RandomFloat2[random(sizeof RandomFloat2)];
						    criar_item(arma_id(artt[i][0]), ps[0], ps[1], ps[2], 1, GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), i);
							if(artt[i][1] > 0)
							{
								for(new cc=44; cc<49; cc++)
								{
									if(Itens[cc][item_Tipo] == i)
									{
									    GetPlayerPos(playerid, ps[0], ps[1], ps[2]);
										ps[0] += RandomFloat2[random(sizeof RandomFloat2)];
										ps[1] += RandomFloat2[random(sizeof RandomFloat2)];
										if(cc != 6 && cc != 9) criar_item(cc, ps[0], ps[1], ps[2], artt[i][1], GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), i);
									}
								}
							}
						}
			  		}
			    }

			    // dropar colete //
			    if(Conta[playerid][c_Colete] > 0)
				{
				GetPlayerPos(playerid, ps[0], ps[1], ps[2]);
					ps[0] += RandomFloat2[random(sizeof RandomFloat2)];
					ps[1] += RandomFloat2[random(sizeof RandomFloat2)];
			    	criar_item(73, ps[0], ps[1], ps[2], 1, GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), Conta[playerid][c_Colete]);
			    }

			    // dropar grana //
			    new granS = GranaPlayer(playerid);
			    if(granS > 1000)
				{
				new porcentagem = (granS/100)*10;
			    	criar_item(49, ps[0], ps[1], ps[2], porcentagem, GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), 1);
					DarGrana(playerid, -porcentagem);
			    }

				ResetPlayerWeapons_(playerid);
				for(new i; i<13; i++)
				{
				    Conta[playerid][c_Arma][i] = 0;
				    Conta[playerid][c_Municao][i] = 0;
				}
				SetarColete(playerid, 0);
				salvar_conta(conta, -1, "c_Armas");
				new ckl = Conta[playerid][c_Killer];
			    if(ckl > -1 && ckl < MAX_CONTAS)
				{
				if(ckl != conta)
				{
				    new sss[150];
				    format(sss, 150, "O jogador '%s' nao resistiu aos seus ferimentos e morreu.", Nome(playerid));
				    msc(ckl, 3, sss);
				    format(sss, 150, "Voce nao resistiu aos ferimentos de '%s' e acabou morrendo.", NomeConta(ckl));
						ms(playerid, 3, sss);

						new pla = ContaOnline(ckl);
						if(Online(pla))
						{
							Conta[pla][c_Matou] += 1;
							salvar_conta(ckl, 0, "c_Matou", sv_int(Conta[pla][c_Matou]));
						}
						else
						{
						    new gran = GetContaInt(ckl, "c_Matou");
						    salvar_conta(ckl, 0, "c_Matou", sv_int(gran+1));
						}
				}
			    }

			    Conta[playerid][c_Morto] = 0;
			    if(morte_aceita[playerid] == 1)
				{
				morte_aceita[playerid] = 0;
				Conta[playerid][c_Hospital] = 500;
				if(VipPlayer(playerid) == 2) Conta[playerid][c_Hospital] = 340;
				if(VipPlayer(playerid) == 3) Conta[playerid][c_Hospital] = 90;
			    }
			    else
				{
					Conta[playerid][c_Hospital] = 120;
					if(VipPlayer(playerid) == 2) Conta[playerid][c_Hospital] = 60;
				if(VipPlayer(playerid) == 3) Conta[playerid][c_Hospital] = 15;
				}
			    if(GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld_(playerid) != 0) Conta[playerid][c_Hospital2] = Conta[playerid][c_Cidade];
			    else
				{
		            if(IsPlayerInRangeOfPoint(playerid, 2000.0, 1595.6250,-1383.3032,28.5859)) Conta[playerid][c_Hospital2] = 0;
					else if(IsPlayerInRangeOfPoint(playerid, 2000.0, -1894.0000,930.5249,35.0156)) Conta[playerid][c_Hospital2] = 1;
					else if(IsPlayerInRangeOfPoint(playerid, 2000.0, 1235.6665,1906.5494,6.8378)) Conta[playerid][c_Hospital2] = 2;
					else Conta[playerid][c_Hospital2] = random(3);
				}
				CancelSelectTextDraw(playerid);
				Conta[playerid][c_Vida] = 100;
			    Conta[playerid][c_Killer] = -1;
			    Conta[playerid][c_Morreu] ++;
			    KillTimer(timer_morto[playerid]);
			    SetarVida(playerid, 100);
			    Conta[playerid][c_X] = 0.0;
				Conta[playerid][c_Y] = 0.0;
				Conta[playerid][c_Z] = 0.0;
				Conta[playerid][c_A] = 0.0;
			    TextDrawHideForPlayer(playerid, TextMorreu[0]);
		        TextDrawHideForPlayer(playerid, TextMorreu[1]);
		        TextDrawHideForPlayer(playerid, TextMorreu[2]);
		        TextDrawHideForPlayer(playerid, TextMorreu[3]);
		        TextDrawHideForPlayer(playerid, TextMorreu[4]);
		        TextDrawHideForPlayer(playerid, TextMorreu[5]);
		        TextDrawHideForPlayer(playerid, TextMorreu[6]);
		        PlayerTextDrawHide(playerid, TextMorreu_p[playerid][0]);
				PlayerSpawn(playerid);
			}
		}
	}
}

stock PlayerConta(conta)
{
	if(conta != -1)
	{
	    foreach(new i:Player)
	    {
	        if(Online(i))
	        {
	            if(id[i] == conta)
	            {
	                return i;
	            }
	        }
	    }
	}
	return -1;
}

stock Cadeia_Staff(playerid)
{
	new c = id[playerid];
	if(c != -1)
	{
		Conta[playerid][c_Morto] = 0;
		Conta[playerid][c_Hospital] = 0;
	    Descongelar(playerid);
     	SetPlayerInterior(playerid, 5);
		SetPlayerVirtualWorld_(playerid, 0);
	    SetPlayerPos_(playerid, 322.197998,302.497985,999.148437);
	    if(mostrando_cadeia_staf[playerid] == 0)
        {
            mostrando_cadeia_staf[playerid] = 1;
            TextDrawShowForPlayer(playerid, T_Cadeia_Staff[0]);
            TextDrawShowForPlayer(playerid, T_Cadeia_Staff[1]);
            TextDrawShowForPlayer(playerid, T_Cadeia_Staff[2]);
            TextDrawShowForPlayer(playerid, T_Cadeia_Staff[3]);
            TextDrawShowForPlayer(playerid, T_Cadeia_Staff[4]);
            PlayerTextDrawSetString(playerid, T_Cadeia_Staff_p[playerid][0], "_");
            PlayerTextDrawSetString(playerid, T_Cadeia_Staff_p[playerid][1], "_");
			PlayerTextDrawShow(playerid, T_Cadeia_Staff_p[playerid][0]);
			PlayerTextDrawShow(playerid, T_Cadeia_Staff_p[playerid][1]);
        }
	}
}

stock Hospital(playerid)
{
	new c = id[playerid];
	if(c != -1)
	{
	    Conta[playerid][c_Morto] = 0;

	Descongelar(playerid);
	    new rand = random(sizeof(CamasHospital));
	    SetPVarInt(playerid, "cama", rand);
	    SetPlayerInterior(playerid, 0);
	    SetPlayerVirtualWorld_(playerid, 0);
	    SetPlayerPos_(playerid, CamasHospital[rand][0]+0.1, CamasHospital[rand][1]+0.1, CamasHospital[rand][2]+1);
	    SetPlayerFacingAngle(playerid, CamasHospital[rand][3]);
	    ApplyAnimation(playerid, "CRACK", "CRCKIDLE2", 4.1, true, false, false, false, 0, 1);

        if(mostrando_hospital[playerid] == 0)
        {
            mostrando_hospital[playerid] = 1;
            TextDrawShowForPlayer(playerid, T_Hospital[0]);
            PlayerTextDrawSetString(playerid, T_Hospital_p[playerid][0], "_");
			PlayerTextDrawShow(playerid, T_Hospital_p[playerid][0]);
        }
	}
}

stock tmp_territorios(playerid)
{
    // territorios //
	if(id[playerid] != -1)
	{
	    new g = em_gz[playerid];
	    if(g != -1)
	    {
	        if(EmTerritorio(playerid, g))
	        {
		        if(mostrando_gz[playerid] == 0) mostrar_gz_player(playerid, g);
		        else atualizar_gz_player(playerid, g);
	        }
	        else
	        {
	            esconder_gz_player(playerid);
	        }
	    }
	    else
	    {
	        new a = PegarTerritorio(playerid);
	        if(a != -1)
	        {
	         	mostrar_gz_player(playerid, a);
			}
			else if(mostrando_gz[playerid] == 1) esconder_gz_player(playerid);
	    }
	}
	else
	{
	    new g = em_gz[playerid];
	    if(g != -1)
	    {
	     	esconder_gz_player(playerid);
	    }
	}
}

stock tmp_tuto(playerid)
{
    // tutorial //
    new sss[300];
	if(player_tutorial[playerid] != -1 && id[playerid] == -1)
	{
	    if(flood_limpar_chat[playerid] < gettime())
		{
		    for(new fd; fd<15; fd++)SSM(playerid, -1, "");
		    flood_limpar_chat[playerid] = gettime()+5;
		}

	    if(player_tutorial[playerid] == 0 && player_tutorial_tempo[playerid] == 0)
	    {
	        TogglePlayerSpectating(playerid, true);
	    }

	    // fim do tutorial //
	    if(player_tutorial[playerid] == sizeof tutorial)
	    {
	        if(player_tutorial_tempo[playerid] == 15)
	        {
	            finalizar_tutorial(playerid);
	        }
	        else player_tutorial_tempo[playerid] ++;
	    }
	    else
	    {
	        // setar cameras e texto //
	        if(player_tutorial_tempo[playerid] == 0)
	        {
	            new i = player_tutorial[playerid];
	            if(i != -1)
	            {
	                InterpolateCameraPos(playerid,  tutorial[i][tuto_CameraX1],tutorial[i][tuto_CameraY1], tutorial[i][tuto_CameraZ1], tutorial[i][tuto_CameraX2],tutorial[i][tuto_CameraY2], tutorial[i][tuto_CameraZ2], 10000, CAMERA_CUT);
	    			InterpolateCameraLookAt(playerid, tutorial[i][tuto_FocoX1],tutorial[i][tuto_FocoY1], tutorial[i][tuto_FocoZ1], tutorial[i][tuto_FocoX2],tutorial[i][tuto_FocoY2], tutorial[i][tuto_FocoZ2], 10000,  CAMERA_CUT);
					format(sss, 150, "~n~%s~n~", tutorial[i][tuto_Titulo]);
					PlayerTextDrawSetString(playerid, T_Tutorial_p[playerid][0], sss);
					PlayerTextDrawSetString(playerid, T_Tutorial_p[playerid][1], tutorial[i][tuto_Menssagem]);
					PlayerTextDrawShow(playerid, T_Tutorial_p[playerid][0]);
					PlayerTextDrawShow(playerid, T_Tutorial_p[playerid][1]);
				}
				player_tutorial_tempo[playerid] ++;
			}
	        else if(player_tutorial_tempo[playerid] == 15)
	        {
				// proseguir tutorial //
	            player_tutorial_tempo[playerid] = 0;
	            player_tutorial[playerid] ++;
	        }
			else player_tutorial_tempo[playerid] ++;
	    }
	}
}

stock tmp_jbl(playerid)
{
    // ouvindo jbl ou veiculo //
	if(id[playerid] == -1)
	{
	    if(Blutuf_Tipo[playerid] != -1)
	    {
	        desconectar_blu(playerid);
	    }

	    if(player_ouvindo[playerid] != -1)
	    {
	        player_ouvindo[playerid] = -1;
	        player_ouvindo_id[playerid] = -1;
	    }
	}
	item_proximo(playerid);
}

