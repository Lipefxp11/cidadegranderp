		    for(new b; b<sizeof T_Celular_SOS; b++) TextDrawShowForPlayer(playerid, T_Celular_SOS[b]);
			for(new a; a<sizeof T_Celular_CAIXA; a++) TextDrawShowForPlayer(playerid, T_Celular_CAIXA[a]);
			for(new c; c<sizeof T_Celular_CARTEIRA; c++) TextDrawShowForPlayer(playerid, T_Celular_CARTEIRA[c]);
			for(new d; d<sizeof T_Celular_DETRAN; d++) TextDrawShowForPlayer(playerid, T_Celular_DETRAN[d]);
	    }
	    if(pagina_barra[playerid] == 1)
	    {
	        // terceira pagina //
	        TextDrawShowForPlayer(playerid, T_Celular_Barra[3]);
            for(new b; b<sizeof T_Celular_Clima; b++) TextDrawShowForPlayer(playerid, T_Celular_Clima[b]);
