	        pegar_local_funcao(playerid, pick);
	        if(funcao_liberada(playerid, pick))
	        {
	            new veh = veiculo_na_funcao(pick);
	            if(veh != -1)
	            {
	                if(veh == -2) ms(playerid, 0, "Ha mais de 1 veiculo no local de desmanche !");
	                else
	                {
	                    if(GetVehicleModel(veh) != 0)
	                    {
	                        new inf = Info_Veiculo[veh];
	                        if(inf != -1)
	                        {
	                            new tip = Lista[playerid][listitem];
							new a = Lista2[playerid][listitem];
							if(tip == -1) desmanche_veiculo(playerid, veh);
							else
							{
					            funcao_id[playerid] = veh;
							    funcao_usando[playerid] = pick;
							    SetVehicleParamsEx_(veh, 0, 0, 0, 0, 0, 0, 0);
							    if(tip == 0) Acao(playerid, 23, 300, "REMOVENDO MOTOR", 0, "null", "null", false);
							    if(tip == 5) Acao(playerid, 23, 300, "REMOVENDO BATERIA", 0, "null", "null", false);
							    if(tip == 2) Acao(playerid, 23, 300, "REMOVENDO FAROL", 0, "null", "null", false);
							    if(tip == 3) Acao(playerid, 23, 300, "REMOVENDO PECA", 0, "null", "null", false);
							    if(tip == 1) Acao(playerid, 23, 300, "REMOVENDO PECA", 0, "null", "null", false);
									ms(playerid, 5, "[DESMANCHE] Removendo, aguarde ate a conclusao total ...");
									SetPVarInt(playerid, "tip", tip);
									SetPVarInt(playerid, "a", a);
