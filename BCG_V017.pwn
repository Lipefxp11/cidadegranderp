	for(new a; a<sizeof T_Teste_Auto_Escola_p[]; a++) PlayerTextDrawDestroy(playerid, T_Teste_Auto_Escola_p[playerid][a]);
	for(new a; a<sizeof HudFomeSedeP[]; a++) PlayerTextDrawDestroy(playerid, HudFomeSedeP[playerid][a]);
	for(new a; a<sizeof T_Celular_p[]; a++) PlayerTextDrawDestroy(playerid, T_Celular_p[playerid][a]);
