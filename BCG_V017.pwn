											{
											MS(playerid, 0, "Voce ja esta com algo nas maos, largue primeiro para fazer isso !");
											return 1;
										    }
										    segurar(playerid, s, PortaMalas[v][i][inv_Unidades], PortaMalas[v][i][inv_Tipo], PortaMalas[v][i][inv_Ativo], PortaMalas[v][i][inv_Tempo]);
										    PortaMalas[v][i][inv_ID] = 0;
							            PortaMalas[v][i][inv_Unidades] = 0;
							            PortaMalas[v][i][inv_Tipo] = 0;
							            PortaMalas[v][i][inv_Ativo] = 0;
							            PortaMalas[v][i][inv_Tempo] = 0;
							            GameTextForPlayer(playerid, "~g~~h~ITEM RECOLHIDO", 1000, 3);
							            fechar_menu(playerid);
							            foreach(new pla:Player) if(pm_player(pla) == v) abrir_portamalas(pla, v);
											SalvarInfo(v, 0, i);
											mostrando_portamalas[playerid] = -1;
											return 1;
										}
									}
							}

							for(new ii; ii<MAX_SLOTS; ii++)
							{
							    if(Inventario[playerid][ii][inv_ID] == 0)
