	else
	{
	    ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{00ffff}PLAYER NOVATO", "\n\
		{ff0000}[INFO] {a1a1a1}\
		Este Jogador um Novato no servidor, neste caso\n\
		ele nao pode sofrer e nem causar dano a \n\
		Ninguem. Qualquer player com nivel menor \n\
		que 3 e considerado um Novato !\n", "Ok", "Fechar");
