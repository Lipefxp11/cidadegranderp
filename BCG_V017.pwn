			ShowAnimsLib(playerid,GetAnimsLibFromId(listitem));
			anims_lastlib[playerid] = "\0";
			strcat(anims_lastlib[playerid], GetAnimsLibFromId(listitem));
		}
		else anims_lastlib[playerid] = "\0";
		return 1;
	}

	// dialog da include de animacoes //
	if(dialogid == DIALOG_ANIMS_INCLUDE2)
	{
	    if(response)
		{
			anims_String = "\0";//Reset the global string
			format(anims_String,sizeof(anims_String),"[SERVER] Running animation (Animations/%s/%s)",anims_lastlib[playerid],inputtext);
			ms(playerid, 1, anims_String);
			ApplyAnimation(playerid, n_animtrim(anims_lastlib[playerid]), n_animtrim(inputtext), 4.1, true, false, false, false, 0, 1);
		}
		else
		{
			anims_lastlib[playerid] = "\0";
			ShowAnimsDialog(playerid);
		}
		return 1;
	}

	// dialog criar item //
    if(dialogid == DIALOG_ITENS2)
	{
		if(response)
		{
		    new i = GetPVarInt(playerid, "iditem");
		    new Float:pos[3];
		    GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
		    PegarFrente(pos[0], pos[1], random(360), random(8)*0.3);

		    if(i == 69) // caixa de municao //
		    {
		   	 	criar_item(i, pos[0], pos[1], pos[2], 1, GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), listitem);
		        return 1;
		    }

		    if(i == 67) // caixa de armas //
		    {
		        new aida = armas_org[listitem][0];
		   	 	criar_item(i, pos[0], pos[1], pos[2], 1, GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), aida);
		        return 1;
		    }

            if(!IsNumeric(inputtext))
		    {
		        ms(playerid, 0, "Use apenas numeros !");
		        OnDialogResponse(playerid, DIALOG_ITENS, 1, GetPVarInt(playerid, "listitem"), "");
				return 1;
		    }

		    if(i == 57) // se for Skin //
		    {
			    if(strval(inputtext) < 0 || strval(inputtext) > 311)
				{
				ms(playerid, 0, "Use um numero de 0 a 311 !");
				OnDialogResponse(playerid, DIALOG_ITENS, 1, GetPVarInt(playerid, "listitem"), "");
					return 1;
			    }
		        criar_item(i, pos[0], pos[1], pos[2], 1, GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), strval(inputtext));
				return 1;
		    }

		    if(strval(inputtext) < 1)
		    {
		        ms(playerid, 0, "Use um numero maior que 1 de preferencia !");
		        OnDialogResponse(playerid, DIALOG_ITENS, 1, GetPVarInt(playerid, "listitem"), "");
				return 1;
		    }
		    item_opcao(playerid, i, strval(inputtext));
		}
		else mostrar_Item_DCs(playerid);
		return 1;
	}

    // dialog lista de acessorios do server //
	if(dialogid == DIALOG_LISTA_ACESSORIOS)
	{
	    if(response)
	    {
	        new cont = sizeof(Acessorios_Info);
			new pags;
		    new sobra;
		    new div;
		    if(cont <= 50)
		    {
				pags = 1;
		    }
		    else
		    {
		        pags = cont/50;
		        div = pags*50;
		        sobra = cont - (div);
		        if(sobra > 0) pags ++;
		    }

			if(pagina_dialog2[playerid]+1 == pags )
		    {
		        if(pags == 1)
		        {
		            if(listitem == sizeof(Acessorios_Info)) // avancar
					{
				    mostrar_lista_acessorios(playerid);
						return 1;
		        	}

		        	if(listitem == sizeof(Acessorios_Info)+1) // voltar
					{
				    mostrar_lista_acessorios(playerid);
						return 1;
		        	}
		        }
		        else
		        {
		            new sizeo = sizeof(Acessorios_Info)-((pags-1)*50);
		            if(listitem == sizeo)
		            {
		                mostrar_lista_acessorios(playerid);
						return 1;
		            }
		            if(listitem == sizeo+1)
		            {
		                if(pagina_dialog2[playerid] > 0) pagina_dialog2[playerid]--;
		                mostrar_lista_acessorios(playerid);
						return 1;
		            }
		        }
		    }


		    if(pags == 1)
	        {
	            if(listitem == cont)
	            {
	                mostrar_lista_acessorios(playerid);
	            }
				else if(listitem == cont+1)
	            {
	                mostrar_lista_acessorios(playerid);
	            }
	            else opcao_acessorio(playerid, listitem);
	            return 1;
	        }
	        else
	        {
		        if(listitem == 50)
		        {
		            if(pagina_dialog2[playerid]+1 < pags)
					{
		                pagina_dialog2[playerid]++;
					}
		            mostrar_lista_acessorios(playerid);
				    return 1;
		        }

		        if(listitem == 51)
		        {
	                if(pagina_dialog2[playerid] > 0) pagina_dialog2[playerid]--;
		            mostrar_lista_acessorios(playerid);
		            return 1;
		        }
			}
			SetPVarInt(playerid, "listitem", listitem);
			opcao_acessorio(playerid, (pagina_dialog2[playerid]*50) + listitem);
	    }
	    return 1;
	}

	// lista de cores //
	if(dialogid == DIALOG_CORES)
	{
	    if(response)
	    {
	        new cont = sizeof(Colors);
	        new pags;
		    new sobra;
		    new div;
		    if(cont <= 50)
		    {
				pags = 1;

		    }
		    else
		    {
		        pags = cont/50;
		        div = pags*50;
		        sobra = cont - (div);
		        if(sobra > 0) pags ++;
		    }

		    if(pagina_dialog4[playerid]+1 == pags )
		    {
		        if(pags == 1)
		        {
		            if(listitem == sizeof(Colors)) // avancar
					{
				    mostrar_cores(playerid);
						return 1;
		        	}

		        	if(listitem == sizeof(Colors)+1) // voltar
					{
				    mostrar_cores(playerid);
						return 1;
		        	}
		        }
		        else
		        {
		            new sizeo = sizeof(Colors)-((pags-1)*50);
		            if(listitem == sizeo)
		            {
		                mostrar_cores(playerid);
						return 1;
		            }
		            if(listitem == sizeo+1)
		            {
		                if(pagina_dialog4[playerid] > 0) pagina_dialog4[playerid]--;
		                mostrar_cores(playerid);
						return 1;
		            }
		        }
		    }


		    if(pags == 1)
	        {
	            if(listitem == cont)
	            {
	                mostrar_cores(playerid);
	            }
				else if(listitem == cont+1)
	            {
	                mostrar_cores(playerid);
	            }
	            else resposta_cor(playerid, listitem);
	            return 1;
	        }
	        else
	        {
		        if(listitem == 50)
		        {
		            if(pagina_dialog4[playerid]+1 < pags)
					{
		                pagina_dialog4[playerid]++;
					}
		            mostrar_cores(playerid);
				    return 1;
		        }

		        if(listitem == 51)
		        {
	                if(pagina_dialog4[playerid] > 0) pagina_dialog4[playerid]--;
		            mostrar_cores(playerid);
		            return 1;
		        }
			}
		    SetPVarInt(playerid, "listitem", listitem);
			resposta_cor(playerid, (pagina_dialog4[playerid]*50) + listitem);
	    }
	    return 1;
	}

	// dialog lista de itens do server //
	if(dialogid == DIALOG_ITENS)
	{
	    if(response)
	    {
	        new cont = sizeof(Itens);
			new pags;
		    new sobra;
		    new div;
		    if(cont <= 50)
		    {
				pags = 1;
		    }
		    else
		    {
		        pags = cont/50;
		        div = pags*50;
		        sobra = cont - (div);
		        if(sobra > 0) pags ++;
		    }

		    if(pagina_dialog[playerid]+1 == pags )
		    {
		        if(pags == 1)
		        {
		            if(listitem == sizeof(Itens)) // avancar
					{
				    mostrar_Item_DCs(playerid);
						return 1;
		        	}

		        	if(listitem == sizeof(Itens)+1) // voltar
					{
				    mostrar_Item_DCs(playerid);
						return 1;
		        	}
		        }
		        else
		        {
		            new sizeo = sizeof(Itens)-((pags-1)*50);
		            if(listitem == sizeo)
		            {
		                mostrar_Item_DCs(playerid);
						return 1;
		            }
		            if(listitem == sizeo+1)
		            {
		                if(pagina_dialog[playerid] > 0) pagina_dialog[playerid]--;
		                mostrar_Item_DCs(playerid);
						return 1;
		            }
		        }
		    }

		if(pags == 1)
	        {
	            if(listitem == cont)
	            {
	                mostrar_Item_DCs(playerid);
	            }
				else if(listitem == cont+1)
	            {
	                mostrar_Item_DCs(playerid);
	            }
	            else
	            {
	                if(GetPVarInt(playerid, "listaitens_modo") == 1)
	                    opcao_item_dar(playerid, listitem);
	                else
	                    opcao_item(playerid, listitem);
	            }
	            return 1;
	        }
	        else
	        {
		        if(listitem == 50)
		        {
		            if(pagina_dialog[playerid]+1 < pags)
					{
		                pagina_dialog[playerid]++;
					}
		            mostrar_Item_DCs(playerid);
				    return 1;
		        }

		        if(listitem == 51)
		        {
	                if(pagina_dialog[playerid] > 0) pagina_dialog[playerid]--;
		            mostrar_Item_DCs(playerid);
		            return 1;
		        }
			}
			SetPVarInt(playerid, "listitem", listitem);
			if(GetPVarInt(playerid, "listaitens_modo") == 1)
			    opcao_item_dar(playerid, (pagina_dialog[playerid]*50) + listitem);
			else
			    opcao_item(playerid, (pagina_dialog[playerid]*50) + listitem);
	    }
	    return 1;
	}

	// /listaitens: passo 1 - ID do jogador
	if(dialogid == DIALOG_LISTAITENS_PLAYER)
	{
	    if(response)
	    {
	        new idc = strval(inputtext);
	        if(!ContaInvalida(idc)) { SetPVarInt(playerid, "iditem_alvo", idc); }
	        else { ms(playerid, 0, "Conta invalida!"); mostrar_Item_DCs(playerid); return 1; }
	        new idd = GetPVarInt(playerid, "iditem_dar");
	        new sss[300];
	        format(sss, 300, "\n{00ffff}%s\n\n{4169E1}INFO: {ffffff}Digite a quantidade (1 a 9999):\n", NomeItem(idd));
	        ShowPlayerDialog(playerid, DIALOG_LISTAITENS_QTY, DIALOG_STYLE_INPUT, "Dar Item - Quantidade", sss, "Dar", "Cancelar");
	    }
	    else
	    {
	        DeletePVar(playerid, "iditem_dar");
	        DeletePVar(playerid, "iditem_alvo");
	    }
	    return 1;
	}

	// /listaitens: passo 2 - quantidade, dar item
	if(dialogid == DIALOG_LISTAITENS_QTY)
	{
	    if(response)
	    {
	        new qtd = strval(inputtext);
	        if(qtd < 1 || qtd > 9999)
	        {
	            ms(playerid, 0, "Quantidade invalida! Use 1 a 9999.");
	            mostrar_Item_DCs(playerid);
	            return 1;
	        }
	        new idd = GetPVarInt(playerid, "iditem_dar");
	        new idc = GetPVarInt(playerid, "iditem_alvo");
	        new targetAccount = idc;
	        if(targetAccount == -1) { ms(playerid, 0, "Conta nao existe!"); return 1; }
	        if(add_inv(targetAccount, idd, qtd, 0, 0, 0))
	        {
	            new pla = ContaOnline(targetAccount);
	            if(pla != -1) ms(pla, 0, f("Voce recebeu %dx %s de um administrador!", qtd, NomeItem(idd)));
	            ms(playerid, 0, f("Item %s (x%d) adicionado ao inventario da conta %d!", NomeItem(idd), qtd, idc));
	            // log para o discord
	            new logstr[300];
	            format(logstr, 300, "%s|%d|%s|%d|%d\n", Nome(playerid), idc, NomeConta(idc), idd, qtd);
	            new File:logFile = fopen("item_sync.txt", io_append);
	            if(logFile)
	            {
	                fwrite(logFile, logstr);
	                fclose(logFile);
	                printf("[ITEM] Log escrito: %s", logstr);
	            }
	            else printf("[ITEM] ERRO: nao conseguiu abrir item_sync.txt para escrita");
	        }
	        else ms(playerid, 0, "Falha ao adicionar item - inventario cheio?");
	        DeletePVar(playerid, "iditem_dar");
	        DeletePVar(playerid, "iditem_alvo");
	    }
	    return 1;
	}

	// Dialogos da Concessionaria (admin editing)
	if(dialogid >= DIALOG_CONCE_NOME && dialogid <= DIALOG_CONCE_ESTOQUE)
	{
	    if(!response) return 1;
	    if(AdminPlayer(playerid) < 8 || ModoAdmin[playerid] != 1) return 1;
	    new cat = ConceCat[playerid];
	    new idx = ConcePagina[playerid] * MAX_CONCE_VEHS_PER_PAGE + ConceSlot[playerid];
	    if(dialogid == DIALOG_CONCE_MODELO)
	    {
	        new m = strval(inputtext);
	        if(m == 0)
	        {
	            ConceVeh[cat][idx][cActive] = false;
	            SalvarConceVeh(cat, idx);
	            C_AtualizarCatalogo(playerid);
	            C_AtualizarSelecionado(playerid);
	            ms(playerid, 1, "Veiculo removido!");
	            return 1;
	        }
	        if(m < 400 || m > 611) { ms(playerid, 0, "Modelo invalido (400-611)!"); return 1; }
	        if(!ConceVeh[cat][idx][cActive])
	        {
	            ConceVeh[cat][idx][cActive] = true;
	            ConceVeh[cat][idx][cModel] = m;
	            ConceVeh[cat][idx][cPrice] = 10000;
	            ConceVeh[cat][idx][cStock] = 5;
	            format(ConceVeh[cat][idx][cName], 32, NomeVeiculo(m));
	            format(ConceVeh[cat][idx][cBrand], 32, "Generico");
	            format(ConceVeh[cat][idx][cSpeed], 16, "120 km/h");
	            format(ConceVeh[cat][idx][cSlots], 16, "4 Slots");
	            format(ConceVeh[cat][idx][cGas], 16, "50L");
	            format(ConceVeh[cat][idx][cCustomName], 32, "");
	            SalvarConceVeh(cat, idx);
	            C_AtualizarCatalogo(playerid);
	            C_AtualizarSelecionado(playerid);
	            ms(playerid, 1, "Veiculo adicionado!");
	            return 1;
	        }
	        ConceVeh[cat][idx][cModel] = m;
	        SalvarConceVeh(cat, idx);
	        C_AtualizarCatalogo(playerid);
	        C_AtualizarSelecionado(playerid);
	        ms(playerid, 1, "Modelo atualizado!");
	        return 1;
	    }
	    if(!ConceVeh[cat][idx][cActive]) return 1;
	    if(dialogid == DIALOG_CONCE_NOME)
	    {
	        format(ConceVeh[cat][idx][cName], 32, "%s", inputtext);
	        new mod = ConceVeh[cat][idx][cModel];
	        new vi = mod - 400;
	        if(vi >= 0 && vi < 212) { format(info_veiculos[vi][veh_Nome], 80, "%s", inputtext); salvar_info_veiculo(vi); }
	        SalvarConceVeh(cat, idx); C_AtualizarSelecionado(playerid); ms(playerid, 1, "Nome atualizado!"); return 1;
	    }
	    if(dialogid == DIALOG_CONCE_MARCA) { format(ConceVeh[cat][idx][cBrand], 32, "%s", inputtext); SalvarConceVeh(cat, idx); C_AtualizarSelecionado(playerid); ms(playerid, 1, "Marca atualizada!"); return 1; }
	    if(dialogid == DIALOG_CONCE_VELO)
	    {
	        new v = strval(inputtext);
	        if(v < 1 || v > 500) { ms(playerid, 0, "Velocidade invalida (1-500)!"); return 1; }
	        new mod = ConceVeh[cat][idx][cModel];
	        new vi = mod - 400;
	        if(vi >= 0 && vi < 212) { info_veiculos[vi][veh_Velocidade] = v; salvar_info_veiculo(vi); }
	        SalvarConceVeh(cat, idx); C_AtualizarSelecionado(playerid); ms(playerid, 1, "Velocidade atualizada!"); return 1;
	    }
	    if(dialogid == DIALOG_CONCE_SLOTS)
	    {
	        new s = strval(inputtext);
	        if(s < 0 || s > 25) { ms(playerid, 0, "Slots invalidos (0-25)!"); return 1; }
	        new mod = ConceVeh[cat][idx][cModel];
	        new vi = mod - 400;
	        if(vi >= 0 && vi < 212) { info_veiculos[vi][veh_PortaMalas] = s; salvar_info_veiculo(vi); }
	        SalvarConceVeh(cat, idx); C_AtualizarSelecionado(playerid); ms(playerid, 1, "Slots atualizados!"); return 1;
	    }
	    if(dialogid == DIALOG_CONCE_GAS)
	    {
	        new g = strval(inputtext);
	        if(g < 1 || g > 200) { ms(playerid, 0, "Tanque invalido (1-200)!"); return 1; }
	        new mod = ConceVeh[cat][idx][cModel];
	        new vi = mod - 400;
	        if(vi >= 0 && vi < 212) { info_veiculos[vi][veh_Capacidade] = g; salvar_info_veiculo(vi); }
	        SalvarConceVeh(cat, idx); C_AtualizarSelecionado(playerid); ms(playerid, 1, "Tanque atualizado!"); return 1;
	    }
	    if(dialogid == DIALOG_CONCE_PRECO) { new v = strval(inputtext); if(v < 0) { ms(playerid, 0, "Valor invalido!"); return 1; } ConceVeh[cat][idx][cPrice] = v; SalvarConceVeh(cat, idx); C_AtualizarSelecionado(playerid); ms(playerid, 1, "Preco atualizado!"); return 1; }
	    if(dialogid == DIALOG_CONCE_ESTOQUE) { new s = strval(inputtext); if(s < 0) { ms(playerid, 0, "Estoque invalido!"); return 1; } ConceVeh[cat][idx][cStock] = s; SalvarConceVeh(cat, idx); C_AtualizarSelecionado(playerid); ms(playerid, 1, "Estoque atualizado!"); return 1; }
	    return 1;
	}

	// Vendedor de Roupas - dialogo de venda
		if(dialogid == 15001)
		{
		    if(!response) { VR_Limpar(playerid); return 1; }
		    new escolha = strval(inputtext) - 1;
		    if(escolha < 0 || escolha > 4) { ms(playerid, 0, "Digite 1 a 5!"); VR_MostrarConv(playerid); return 1; }
		    VR_ProcessarResposta(playerid, escolha);
		    return 1;
		}

	return 1;
}

public OnPlayerClickPlayerTextDraw(playerid, PlayerText:playertextid)
{
	if(id_loop_lento[playerid] != -1)
	{
		SelectTextDraw(playerid, 0x0000ff90);
		return 1;
	}
    if(IsPlayerNPC(playerid)) return 1;
    if(Player_AFK(playerid)) return 1;
    new c = id[playerid];
    if(c == -1) return 1;

    // CONCESSIONARIA TEXTDRAW
    if(ConceAberto[playerid] == 1) { C_ClickPlayer(playerid, playertextid); SelectTextDraw(playerid, 0x00FF00FF); return 1; }

    // FUSION INVENTARIO
    if(inv_novo_aberto[playerid] == 1)
    {
        // slots 0-24: direto (slot = b)
        for(new b=0; b<25; b++)
        {
            if(playertextid == FusionInvP[playerid][b])
            {
                if(fusion_selecionado[playerid] != -1)
                {
                    new fromSlot = fusion_selecionado[playerid];
                    if(fromSlot == b)
                    {
                        fusion_selecionado[playerid] = -1;
                        abrir_inv_novo(playerid);
                        SelectTextDraw(playerid, 0xffff0080);
                        return 1;
                    }
                    if(Inventario[playerid][b][inv_ID] == 0)
                    {
                        Inventario[playerid][b][inv_ID] = Inventario[playerid][fromSlot][inv_ID];
                        Inventario[playerid][b][inv_Unidades] = Inventario[playerid][fromSlot][inv_Unidades];
                        Inventario[playerid][b][inv_Tipo] = Inventario[playerid][fromSlot][inv_Tipo];
                        limpar_slot(playerid, fromSlot);
                        if(c != -1) { salvar_inventario(c, b); salvar_inventario(c, fromSlot); }
                        fusion_selecionado[playerid] = -1;
                        abrir_inv_novo(playerid);
                        SelectTextDraw(playerid, 0xffff0080);
                        return 1;
                    }
                    if(Inventario[playerid][b][inv_ID] == Inventario[playerid][fromSlot][inv_ID])
                    {
                        Inventario[playerid][b][inv_Unidades] += Inventario[playerid][fromSlot][inv_Unidades];
                        limpar_slot(playerid, fromSlot);
                        if(c != -1) { salvar_inventario(c, b); salvar_inventario(c, fromSlot); }
                        fusion_selecionado[playerid] = -1;
                        abrir_inv_novo(playerid);
                        SelectTextDraw(playerid, 0xffff0080);
                        return 1;
                    }
                    new tmpID = Inventario[playerid][b][inv_ID];
                    new tmpUnid = Inventario[playerid][b][inv_Unidades];
                    new tmpTipo = Inventario[playerid][b][inv_Tipo];
                    Inventario[playerid][b][inv_ID] = Inventario[playerid][fromSlot][inv_ID];
                    Inventario[playerid][b][inv_Unidades] = Inventario[playerid][fromSlot][inv_Unidades];
                    Inventario[playerid][b][inv_Tipo] = Inventario[playerid][fromSlot][inv_Tipo];
                    Inventario[playerid][fromSlot][inv_ID] = tmpID;
                    Inventario[playerid][fromSlot][inv_Unidades] = tmpUnid;
                    Inventario[playerid][fromSlot][inv_Tipo] = tmpTipo;
                        if(c != -1) { salvar_inventario(c, b); salvar_inventario(c, fromSlot); }
                    fusion_selecionado[playerid] = -1;
                    abrir_inv_novo(playerid);
                    SelectTextDraw(playerid, 0xffff0080);
                    return 1;
                }
                if(Inventario[playerid][b][inv_ID] > 0)
                {
                    fusion_selecionado[playerid] = b;
                    abrir_inv_novo(playerid);
                    SelectTextDraw(playerid, 0xffff0080);
                }
                return 1;
            }
        }
        // slots 25-49: items do modo atual (chao / bau / PM)
        for(new b=25; b<50; b++)
        {
            if(playertextid == FusionInvP[playerid][b])
            {
                new fidx = b-25;

                // se tem item selecionado do INVENTARIO (lado esquerdo), coloca no destino
                if(fusion_selecionado[playerid] >= 0 && fusion_selecionado[playerid] < MAX_SLOTS)
                {
                    new slot = fusion_selecionado[playerid];
                    if(Inventario[playerid][slot][inv_ID] > 0)
                    {
                        // tenta colocar no destino dependendo do modo
                        new colocou = 0;
                        if(inv_modo[playerid] == INV_MODO_CHAO)
                        {
                            // dropar no chão
                            new qtd = inv_qty[playerid];
                            if(qtd > 0 && qtd < Inventario[playerid][slot][inv_Unidades])
                            {
                                new Float:ps[3];
                                GetPlayerPos(playerid, ps[0], ps[1], ps[2]);
                                PegarFrente(ps[0], ps[1], random(360), random(8)*0.3);
                                criar_item(Inventario[playerid][slot][inv_ID], ps[0], ps[1], ps[2], qtd, GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), Inventario[playerid][slot][inv_Tipo]);
                                Inventario[playerid][slot][inv_Unidades] -= qtd;
                                new cc = id[playerid];
                                if(cc != -1) salvar_inventario(cc, slot);
                            }
                            else dropar_inv(playerid, slot);
                            colocou = 1;
                        }
                        else if(inv_modo[playerid] == INV_MODO_BAU)
                        {
                            // guardar no bau de casa
                            new ba = inv_bau_alvo[playerid];
                            if(ba >= 0 && ba < MAX_CASAS && c != -1)
                            {
                                for(new a; a<MAX_BAU; a++)
                                {
                                    if(Bau[ba][a][inv_ID] == 0)
                                    {
                                        Bau[ba][a][inv_ID] = Inventario[playerid][slot][inv_ID];
                                        Bau[ba][a][inv_Unidades] = Inventario[playerid][slot][inv_Unidades];
                                        Bau[ba][a][inv_Tipo] = Inventario[playerid][slot][inv_Tipo];
                                        Bau[ba][a][inv_Ativo] = Inventario[playerid][slot][inv_Ativo];
                                        Bau[ba][a][inv_Tempo] = Inventario[playerid][slot][inv_Tempo];
                                        limpar_slot(playerid, slot);
                                        salvar_inventario(c, slot);
                                        salvar_bau(ba, a);
                                        ms(playerid, 0, "Item guardado no bau!");
                                        colocou = 1;
                                        break;
                                    }
                                }
                                if(!colocou) ms(playerid, 0, "Bau cheio!");
                            }
                        }
                        else if(inv_modo[playerid] == INV_MODO_BAU_I)
                        {
                            // guardar no BauI
                            new bid = inv_bau_i_alvo[playerid];
                            if(bid >= 0 && bid < MAX_BAUS)
                            {
                                for(new a; a<BauI[bid][bau_Slots]; a++)
                                {
                                    if(BauI_Itens[bid][a][inv_ID] == 0)
                                    {
                                        BauI_Itens[bid][a][inv_ID] = Inventario[playerid][slot][inv_ID];
                                        BauI_Itens[bid][a][inv_Unidades] = Inventario[playerid][slot][inv_Unidades];
                                        BauI_Itens[bid][a][inv_Tipo] = Inventario[playerid][slot][inv_Tipo];
                                        BauI_Itens[bid][a][inv_Ativo] = Inventario[playerid][slot][inv_Ativo];
                                        BauI_Itens[bid][a][inv_Tempo] = Inventario[playerid][slot][inv_Tempo];
                                        limpar_slot(playerid, slot);
                        if(c != -1) salvar_inventario(c, slot);
                                        salvar_bau_item(bid);
                                        ms(playerid, 0, "Item guardado no bau!");
                                        colocou = 1;
                                        break;
                                    }
                                }
                                if(!colocou) ms(playerid, 0, "Bau cheio!");
                            }
                        }
                        else if(inv_modo[playerid] == INV_MODO_PM)
                        {
                            // guardar no porta-malas
                            new v = inv_pm_alvo[playerid];
                            if(v >= 0 && v < MAX_VEICULOS)
                            {
                                new max_pm = slots_porta_malas(v);
                                if(max_pm <= 0) max_pm = MAX_PORTA_MALAS;
                                for(new a; a<max_pm; a++)
                                {
                                    if(PortaMalas[v][a][inv_ID] == 0)
                                    {
                                        PortaMalas[v][a][inv_ID] = Inventario[playerid][slot][inv_ID];
                                        PortaMalas[v][a][inv_Unidades] = Inventario[playerid][slot][inv_Unidades];
                                        PortaMalas[v][a][inv_Tipo] = Inventario[playerid][slot][inv_Tipo];
                                        PortaMalas[v][a][inv_Ativo] = Inventario[playerid][slot][inv_Ativo];
                                        PortaMalas[v][a][inv_Tempo] = Inventario[playerid][slot][inv_Tempo];
                                        limpar_slot(playerid, slot);
                        if(c != -1) salvar_inventario(c, slot);
                                        SalvarPortaMalas(v);
                                        ms(playerid, 0, "Item guardado no porta-malas!");
                                        colocou = 1;
                                        break;
                                    }
                                }
                                if(!colocou) ms(playerid, 0, "Porta-malas cheio!");
                            }
                        }
                        inv_qty[playerid] = 0;
                        fusion_selecionado[playerid] = -1;
                        abrir_inv_novo(playerid);
                        SelectTextDraw(playerid, 0xffff0080);
                    }
                    return 1;
                }

                // clique em um item do destino (lado direito) - pegar de volta pro inventario
                new idd = 0, tipo = 0, unid = 0;
                if(inv_modo[playerid] == INV_MODO_CHAO)
                {
                    new fid = floor_item_index[playerid][fidx];
                    if(fid != -1 && Item[fid][item_Existe] == 1)
                    {
                        idd = Item[fid][item_ID];
                        tipo = Item[fid][item_Tipo];
                        unid = Item[fid][item_Unidades];
                        if(c != -1)
                        {
                            for(new v; v<MAX_SLOTS; v++)
                            {
                                if(Inventario[playerid][v][inv_ID] == 0)
                                {
                                    Inventario[playerid][v][inv_ID] = idd;
                                    Inventario[playerid][v][inv_Unidades] = unid;
                                    Inventario[playerid][v][inv_Tipo] = tipo;
                                    Item[fid][item_Existe] = 0;
                                    if(IsValidDynamicObject(Item[fid][item_Obj])) DestroyDynamicObject(Item[fid][item_Obj]);
                                    if(IsValidDynamic3DTextLabel(Item[fid][item_3D])) DestroyDynamic3DTextLabel(Item[fid][item_3D]);
                                    salvar_inventario(c, v);
                                    floor_item_index[playerid][fidx] = -1;
                                    abrir_inv_novo(playerid);
                                    SelectTextDraw(playerid, 0xffff0080);
                                    return 1;
                                }
                            }
                            ms(playerid, 0, "Inventario cheio!");
                        }
                    }
                }
                else if(inv_modo[playerid] == INV_MODO_BAU)
                {
                    new ba = inv_bau_alvo[playerid];
                    if(ba >= 0 && ba < MAX_CASAS)
                    {
                        idd = Bau[ba][fidx][inv_ID];
                        tipo = Bau[ba][fidx][inv_Tipo];
                        unid = Bau[ba][fidx][inv_Unidades];
                        if(idd > 0)
                        {
                            if(c != -1)
                            {
                                for(new v; v<MAX_SLOTS; v++)
                                {
                                    if(Inventario[playerid][v][inv_ID] == 0)
                                    {
                                        Inventario[playerid][v][inv_ID] = idd;
                                        Inventario[playerid][v][inv_Unidades] = unid;
                                        Inventario[playerid][v][inv_Tipo] = tipo;
                                        Inventario[playerid][v][inv_Ativo] = Bau[ba][fidx][inv_Ativo];
                                        Inventario[playerid][v][inv_Tempo] = Bau[ba][fidx][inv_Tempo];
                                        Bau[ba][fidx][inv_ID] = 0;
                                        Bau[ba][fidx][inv_Unidades] = 0;
                                        Bau[ba][fidx][inv_Tipo] = 0;
                                        Bau[ba][fidx][inv_Ativo] = 0;
                                        Bau[ba][fidx][inv_Tempo] = 0;
                                        salvar_inventario(c, v);
                                        salvar_bau(ba, fidx);
                                        ms(playerid, 0, "Item pego do bau!");
                                        abrir_inv_novo(playerid);
                                        SelectTextDraw(playerid, 0xffff0080);
                                        return 1;
                                    }
                                }
                                ms(playerid, 0, "Inventario cheio!");
                            }
                        }
                    }
                }
                else if(inv_modo[playerid] == INV_MODO_BAU_I)
                {
                    new bid = inv_bau_i_alvo[playerid];
                    if(bid >= 0 && bid < MAX_BAUS)
                    {
                        idd = BauI_Itens[bid][fidx][inv_ID];
                        tipo = BauI_Itens[bid][fidx][inv_Tipo];
                        unid = BauI_Itens[bid][fidx][inv_Unidades];
                        if(idd > 0)
                        {
                            if(c != -1)
                            {
                                for(new v; v<MAX_SLOTS; v++)
                                {
                                    if(Inventario[playerid][v][inv_ID] == 0)
                                    {
                                        Inventario[playerid][v][inv_ID] = idd;
                                        Inventario[playerid][v][inv_Unidades] = unid;
                                        Inventario[playerid][v][inv_Tipo] = tipo;
                                        Inventario[playerid][v][inv_Ativo] = BauI_Itens[bid][fidx][inv_Ativo];
                                        Inventario[playerid][v][inv_Tempo] = BauI_Itens[bid][fidx][inv_Tempo];
                                        BauI_Itens[bid][fidx][inv_ID] = 0;
                                        BauI_Itens[bid][fidx][inv_Unidades] = 0;
                                        BauI_Itens[bid][fidx][inv_Tipo] = 0;
                                        BauI_Itens[bid][fidx][inv_Ativo] = 0;
                                        BauI_Itens[bid][fidx][inv_Tempo] = 0;
                                        salvar_inventario(c, v);
                                        salvar_bau_item(bid);
                                        ms(playerid, 0, "Item pego do bau!");
                                        abrir_inv_novo(playerid);
                                        SelectTextDraw(playerid, 0xffff0080);
                                        return 1;
                                    }
                                }
                                ms(playerid, 0, "Inventario cheio!");
                            }
                        }
                    }
                }
                else if(inv_modo[playerid] == INV_MODO_PM)
                {
                    new v = inv_pm_alvo[playerid];
                    if(v >= 0 && v < MAX_VEICULOS)
                    {
                        idd = PortaMalas[v][fidx][inv_ID];
                        tipo = PortaMalas[v][fidx][inv_Tipo];
                        unid = PortaMalas[v][fidx][inv_Unidades];
                        if(idd > 0)
                        {
                            if(c != -1)
                            {
                                for(new vi; vi<MAX_SLOTS; vi++)
                                {
                                    if(Inventario[playerid][vi][inv_ID] == 0)
                                    {
                                        Inventario[playerid][vi][inv_ID] = idd;
                                        Inventario[playerid][vi][inv_Unidades] = unid;
                                        Inventario[playerid][vi][inv_Tipo] = tipo;
                                        Inventario[playerid][vi][inv_Ativo] = PortaMalas[v][fidx][inv_Ativo];
                                        Inventario[playerid][vi][inv_Tempo] = PortaMalas[v][fidx][inv_Tempo];
                                        PortaMalas[v][fidx][inv_ID] = 0;
                                        PortaMalas[v][fidx][inv_Unidades] = 0;
                                        PortaMalas[v][fidx][inv_Tipo] = 0;
                                        PortaMalas[v][fidx][inv_Ativo] = 0;
                                        PortaMalas[v][fidx][inv_Tempo] = 0;
                                        salvar_inventario(c, vi);
                                        SalvarPortaMalas(v);
                                        ms(playerid, 0, "Item pego do porta-malas!");
                                        abrir_inv_novo(playerid);
                                        SelectTextDraw(playerid, 0xffff0080);
                                        return 1;
                                    }
                                }
                                ms(playerid, 0, "Inventario cheio!");
                            }
                        }
                    }
                }
                return 1;
            }
        }
        if(playertextid == FusionInvP[playerid][57])
        {
            fechar_inv_novo(playerid);
            return 1;
        }
        if(playertextid == FusionInvP[playerid][54])
        {
            ShowPlayerDialog(playerid, DIALOG_INV_QTY, DIALOG_STYLE_INPUT, "Quantidade", "Digite a quantidade que deseja usar/dropar/enviar:", "Confirmar", "Cancelar");
            return 1;
        }
        if(playertextid == FusionInvP[playerid][55])
        {
            new slot = fusion_selecionado[playerid];
            if(slot > -1)
            {
                new co = id[playerid];
                if(co != -1)
                {
                    new idd = Inventario[playerid][slot][inv_ID];
                    if(idd > 0 && idd < 44) // arma
                    {
                        if(Inventario[playerid][slot][inv_Unidades] > 1)
                        {
                            Inventario[playerid][slot][inv_Unidades] -= 1;
                            salvar_inventario(co, slot);
                            new tmpSlot = -1;
                            for(new v; v<MAX_SLOTS; v++)
                            {
                                if(Inventario[playerid][v][inv_ID] == 0) { tmpSlot = v; break; }
                            }
                            if(tmpSlot != -1)
                            {
                                Inventario[playerid][tmpSlot][inv_ID] = idd;
                                Inventario[playerid][tmpSlot][inv_Unidades] = 1;
                                Inventario[playerid][tmpSlot][inv_Tipo] = Inventario[playerid][slot][inv_Tipo];
                                salvar_inventario(co, tmpSlot);
                                inv_usar(playerid, co, tmpSlot);
                            }
                        }
                        else inv_usar(playerid, co, slot);
                    }
                    else inv_usar(playerid, co, slot);
                }
                SelectTextDraw(playerid, 0xffff0080);
            }
            return 1;
        }
        if(playertextid == FusionInvP[playerid][60])
        {
            new slota = -1;
            if(id_arma[playerid] != -1) slota = ListaArmas[playerid][id_arma[playerid]];
            if(slota == -1) return ms(playerid, 0, "Nenhuma arma selecionada!");
            if(slota == 2 && Taser(playerid)) return ms(playerid, 0, "Voce nao pode dropar uma arma de choque, use /taser!");
            new artt[13][2];
            new Float:ps[3];
            GetPlayerPos(playerid, ps[0], ps[1], ps[2]);
            for(new i; i<13; i++) GetPlayerWeaponData(playerid, i, artt[i][0], artt[i][1]);
            if(artt[slota][0] == 0) return ms(playerid, 0, "Slot de arma vazio!");
            criar_item(arma_id(artt[slota][0]), ps[0], ps[1], ps[2], 1, GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), slota);
            if(artt[slota][1] > 0)
            {
                for(new cc=44; cc<49; cc++)
                {
                    if(Itens[cc][item_Tipo] == slota)
                    {
                        criar_item(cc, ps[0], ps[1], ps[2], artt[slota][1], GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid));
                        break;
                    }
                }
            }
            ResetPlayerWeapons_(playerid);
            for(new ii; ii<13; ii++) if(ii != slota) GivePlayerWeapon_(playerid, artt[ii][0], artt[ii][1]);
            flood_arma[playerid] = 1;
            SetTimerEx("salvar_armas", 1500, false, "dd", playerid, 0);
            SetTimerEx("armas_costas", 1500, false, "d", playerid);
            fusion_selecionado[playerid] = -1;
            fechar_inv_novo(playerid);
            SetTimerEx("abrir_inv_novo", 100, false, "d", playerid);
            ms(playerid, 2, "Arma dropada!");
            return 1;
        }
        if(playertextid == FusionInvP[playerid][61])
        {
            new slota = -1;
            if(id_arma[playerid] != -1) slota = ListaArmas[playerid][id_arma[playerid]];
            if(slota == -1) return ms(playerid, 0, "Nenhuma arma selecionada!");
            new artt[13][2];
            for(new i; i<13; i++) GetPlayerWeaponData(playerid, i, artt[i][0], artt[i][1]);
            if(artt[slota][0] == 0) return ms(playerid, 0, "Slot de arma vazio!");
            new aid = arma_id(artt[slota][0]);
            if(aid > 0)
            {
                new added;
                for(new v; v<MAX_SLOTS; v++)
                {
                    if(Inventario[playerid][v][inv_ID] == aid)
                    {
                        Inventario[playerid][v][inv_Unidades] += 1;
                        if(c != -1) salvar_inventario(c, v);
                        added = 1;
                        break;
                    }
                    if(Inventario[playerid][v][inv_ID] == 0 && !added)
                    {
                        Inventario[playerid][v][inv_ID] = aid;
                        Inventario[playerid][v][inv_Unidades] = 1;
                        Inventario[playerid][v][inv_Tipo] = Itens[aid][item_Tipo];
                        if(c != -1) salvar_inventario(c, v);
                        added = 1;
                    }
                }
                if(artt[slota][1] > 0)
                {
                    for(new cc=44; cc<49; cc++)
                    {
                        if(Itens[cc][item_Tipo] == slota)
                        {
                            new added2;
                            for(new v; v<MAX_SLOTS; v++)
                            {
                                if(Inventario[playerid][v][inv_ID] == cc)
                                {
                                    Inventario[playerid][v][inv_Unidades] += artt[slota][1];
                        if(c != -1) salvar_inventario(c, v);
                                    added2 = 1;
                                    break;
                                }
                                if(Inventario[playerid][v][inv_ID] == 0 && !added2)
                                {
                                    Inventario[playerid][v][inv_ID] = cc;
                                    Inventario[playerid][v][inv_Unidades] = artt[slota][1];
                                    Inventario[playerid][v][inv_Tipo] = Itens[cc][item_Tipo];
                        if(c != -1) salvar_inventario(c, v);
                                    added2 = 1;
                                }
                            }
                            break;
                        }
                    }
                }
            }
            ResetPlayerWeapons_(playerid);
            for(new ii; ii<13; ii++) if(ii != slota) GivePlayerWeapon_(playerid, artt[ii][0], artt[ii][1]);
            flood_arma[playerid] = 1;
            SetTimerEx("salvar_armas", 1500, false, "dd", playerid, 0);
            SetTimerEx("armas_costas", 1500, false, "d", playerid);
            fusion_selecionado[playerid] = -1;
            fechar_inv_novo(playerid);
            SetTimerEx("abrir_inv_novo", 100, false, "d", playerid);
            ms(playerid, 2, "Arma guardada no inventario!");
            return 1;
        }
    }

    // inv novo //
    for(new i=1; i<5; i++)
	{
	    if(playertextid == T_InvNovo_p[playerid][i])
	    {
	        if(pagina_inv_novo[playerid] != i-1)
	        {
	        	pagina_inv_novo[playerid] = i-1;
	        	fechar_caixinha(playerid);
	        	abrir_inv_novo(playerid, 0);
	        }
	    }
	}
	for(new b=5; b<14; b++)
	{
	    if(playertextid == T_InvNovo_p[playerid][b])
	    {
	        new aa = b-5;
	        new pagdebug = pagina_inv_novo[playerid];
	        new i = aa+(pagdebug*9);
	        new slot = ListaInv[playerid][i];
	        if(slot > -1)
	        {
		        if(guardando[playerid] == 1)
	            {
	                if(Inventario[playerid][slot][inv_Tempo] != 0)
	                {
	                    ms(playerid, 0, "Items temporarios nao podem ser guardados em porta-malas !");
	                    return 1;
	                }

	                new v = GetPVarInt(playerid, "id_info");
	                if(v != -1)
	                {
		                new max_porta_malas = slots_porta_malas(v);
						for(new a; a<max_porta_malas; a++)
						{
						    if(PortaMalas[v][a][inv_ID] == 0)
							{
							format(string_prox, 300, "** '%s' guardou %s %s no porta malas do veiculo '%s' **", Nome(playerid), ConvertMoney(Inventario[playerid][slot][inv_Unidades]), NomeItem(Inventario[playerid][slot][inv_ID], Inventario[playerid][slot][inv_Tipo]), NomeVeiculo(Veiculo[v][v_Modelo]));
								ProxDetector(10.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);

								PortaMalas[v][a][inv_ID] = Inventario[playerid][slot][inv_ID];
							PortaMalas[v][a][inv_Unidades] = Inventario[playerid][slot][inv_Unidades];
							PortaMalas[v][a][inv_Tipo] = Inventario[playerid][slot][inv_Tipo];
							PortaMalas[v][a][inv_Ativo] = Inventario[playerid][slot][inv_Ativo];
							PortaMalas[v][a][inv_Tempo] = Inventario[playerid][slot][inv_Tempo];

							Inventario[playerid][slot][inv_ID] = 0;
				        	Inventario[playerid][slot][inv_Unidades] = 0;
				        	Inventario[playerid][slot][inv_Tipo] = 0;
				        	Inventario[playerid][slot][inv_Ativo] = 0;
				        	Inventario[playerid][slot][inv_Tempo] = 0;
				        	salvar_inventario(c, slot);
					    	SalvarInfo(v, 0, a);
					    	combinando[playerid] = -1;
					    	guardando[playerid] = 1;
					    	abrir_inv_novo(playerid);
					    	foreach(new pla:Player) if(pm_player(pla) == v) abrir_portamalas(pla, v);
							return 1;
						    }
						}
					}

	                ms(playerid, 0, "O porta malas do veiculo esta lotado !");
	                return 1;
	            }
	
				if(guardando_bau[playerid] == 1)
	            {
	                if(Inventario[playerid][slot][inv_Tempo] != 0)
	                {
	                    ms(playerid, 0, "Items temporarios nao podem ser guardados em Bau de Casas !");
	                    return 1;
	                }

	                new v = GetPVarInt(playerid, "id_bau");
	                if(v != -1)
	                {
						for(new a; a<MAX_BAU; a++)
						{
						    if(Bau[v][a][inv_ID] == 0)
							{
							format(string_prox, 300, "** '%s' guardou %s %s no Bau da Casa: %d **", Nome(playerid), ConvertMoney(Inventario[playerid][slot][inv_Unidades]), NomeItem(Inventario[playerid][slot][inv_ID], Inventario[playerid][slot][inv_Tipo]), v);
								ProxDetector(10.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
								Bau[v][a][inv_ID] = Inventario[playerid][slot][inv_ID];
							Bau[v][a][inv_Unidades] = Inventario[playerid][slot][inv_Unidades];
							Bau[v][a][inv_Tipo] = Inventario[playerid][slot][inv_Tipo];
							Bau[v][a][inv_Ativo] = Inventario[playerid][slot][inv_Ativo];
							Bau[v][a][inv_Tempo] = Inventario[playerid][slot][inv_Tempo];
							Inventario[playerid][slot][inv_ID] = 0;
				        	Inventario[playerid][slot][inv_Unidades] = 0;
				        	Inventario[playerid][slot][inv_Tipo] = 0;
				        	Inventario[playerid][slot][inv_Ativo] = 0;
				        	Inventario[playerid][slot][inv_Tempo] = 0;
				        	salvar_inventario(c, slot);
					    	salvar_bau(v, a);
					    	combinando[playerid] = -1;
					    	guardando_bau[playerid] = 1;
					    	abrir_inv_novo(playerid);
					    	foreach(new pla:Player) if(bau_player(pla) == v) abrir_bau_casa(pla, v);
							return 1;
						    }
						}
					}

	                ms(playerid, 0, "O Bau da Casa esta lotado !");
	                return 1;
	            }

		        if(combinando[playerid] != -1)
		        {
		            combinar(playerid, c, combinando[playerid], slot);
		            return 1;
		        }


	            if(Inventario[playerid][slot][inv_ID] > 0)
	            {
					selecionou_novo(playerid, slot, b);
					return 1;
				}

	        }
	        return 1;
		}
	}


	// carregar posicao //
	if(playertextid == T_UltimaPos_p[playerid][0])
 	{
 	    if(voltar_local[playerid] == 1)
 	    {
 	        //if(Conta[playerid][c_UltimaPos] > gettime()) ms(playerid, 0, "Voce ainda nao pode carregar suaa ultima Posicao !");
 	        //else ultima_pos(playerid);
 	        ultima_pos(playerid);
 	    }
		return 1;
	}

	// converssas whatsapp //
	for(new i; i<5; i++)
	{
	    if(playertextid == T_Celular_WP_APK_Converssa_p[playerid][i] || playertextid == T_Celular_WP_APK_Converssa_p[playerid][i+5])
     	{
	        new a = i+(5*pagina_converssa[playerid]);
	        if(player_converssa[playerid][a][cv_Existe] == 1 && player_converssa[playerid][a][cv_Conta] != -1)
	        {
		        if(grupo_vip[playerid] == 1) grupo_vip_abrir[playerid] = 1;
		        ver_mens(playerid, i+(5*pagina_converssa[playerid]));
		        return 1;
	        }
	    }
	}

	// trade //
	for(new a; a<3; a++)
	{
	    if(playertextid == T_Trade_p[playerid][a+4])
	    {
	        if(trade_aceitou[playerid] == 1)
	        {
	            ms(playerid, 0, "Cancele a troca antes de fazer alguma alteracao !");
	            return 1;
	        }
	        new i = a + (pagina_trade[playerid]*3);
	        new slot = ListaInv[playerid][i];
	        if(slot > -1)
	        {
	            trade_slot[playerid] = slot;
	            mostrar_trade(playerid, 1);
	            mostrar_trade(playerid, 3);
	            new pla = negociando[playerid];
	            if(Online(pla))
	            {
	                mostrar_trade(pla, 3);
	                if(trade_aceitou[pla] == 1)
	                {
	                    trade_aceitou[pla] = 0;
	                    mostrar_trade(playerid, 2);
						mostrar_trade(pla, 2);
	                }
	            }
	        }
	        else ms(playerid, 0, "Este slot esta vazio ! Escolha algum item existente.");
	        return 1;
	    }
	}

	// setar grana trade //
	if(playertextid == T_Trade_p[playerid][9])
	{
	    new sss[300];
    	if(trade_aceitou[playerid] == 1)
        {
            ms(playerid, 0, "Cancele a troca antes de fazer alguma alteracao !");
            return 1;
        }
        format(sss, 300, "{4169E1}OFERECER GRANA\n\n{ffffff}Grana: {4169E1}R$ %s\n{00ffff}[INFO] {a1a1a1}Digite quanto deseja oferecer na negociacao:\n", trade_grana[playerid]);
        Input(playerid, DIALOG_GRANA_TRADE, "{000000}.", sss);
	    return 1;
	}

	// setar cash trade //
	if(playertextid == T_Trade_p[playerid][11])
	{
	    new sss[300];
        if(trade_aceitou[playerid] == 1)
        {
            ms(playerid, 0, "Cancele a troca antes de fazer alguma alteracao !");
            return 1;
        }
        format(sss, 300, "{ffff00}OFERECER CASH\n\n{ffffff}Cash: {ffff00}$ %s\n{00ffff}[INFO] {a1a1a1}Digite quanto deseja oferecer na negociacao:\n", trade_cash[playerid]);
        Input(playerid, DIALOG_CASH_TRADE, "{000000}.", sss);
	    return 1;
	}

	// retirar item //
	if(playertextid == T_Trade_p[playerid][7])
	{
	    if(trade_slot[playerid] == -1) ms(playerid, 0, "Voce nao colocou nenhum item na negociacao !");
	    else
	    {
	        if(trade_aceitou[playerid] == 1)
	        {
	            ms(playerid, 0, "Cancele a troca antes de fazer alguma alteracao !");
	            return 1;
	        }

	        trade_slot[playerid] = -1;
	        mostrar_trade(playerid, 1);
	       	mostrar_trade(playerid, 3);

	        new pla = negociando[playerid];
	       	if(Online(pla))
            {
                mostrar_trade(pla, 3);
                if(trade_aceitou[pla] == 1)
                {
                    trade_aceitou[pla] = 0;
                    mostrar_trade(playerid, 2);
					mostrar_trade(pla, 2);
                }
            }
	    }
	    return 1;
	}


	// lista do celular //
	for(new a; a<10; a++)
	{
	    if(playertextid == T_Celular_Lista_p[playerid][a+1])
	    {
			a += Pagina_DC[playerid]*10;
	        if(Item_DC[playerid] == a) return 1;
	        else
	        {
	            Item_DC[playerid] = a;
				celular(playerid, C_LISTA);
	        }
	        return 1;
	    }
	}

    // menu //
    for(new m; m<7; m++)
    {
        if(playertextid == T_Menu_p[playerid][m+4])
        {
            new i = m+(pagina_menu[playerid]*7);
            if(escolhendo_menu[playerid] == i) return 1;
            escolhendo_menu[playerid] = i;
           	mostrar_menu(playerid, menu_id[playerid]);
           	return 1;
		}
    }

    // confirmar menu //
	if(playertextid == T_Menu_p[playerid][1])
	{
	    RespostaMenu(playerid, menu_id[playerid], 1, escolhendo_menu[playerid]);
	    return 1;
	}

    // fechar menu //
    if(playertextid == T_Menu_p[playerid][2] || playertextid == T_Menu_p[playerid][3])
        return 1;

    return 1;
}

stock EmCombate(playerid)
{
	if(GetPVarInt(playerid, "emcombate") > gettime()) return 1;
	return 0;
}

stock apertou_esc(playerid)
{
    // operador maquinas //
    if(OM_Consertando[playerid] == 1) { OM_Consertando[playerid] = 0; OM_DestruirTDP(playerid); for(new i; i<12; i++) TextDrawHideForPlayer(playerid, OM_TD[i]); CancelSelectTextDraw(playerid); mostrar_hud(playerid); return; }

    // concessionaria //
    if(ConceAberto[playerid] == 1) { EsconderFConce(playerid); return; }

    // inv novo //
    if(inv_novo_aberto[playerid] == 1)
    {
        if(combinando[playerid] != -1)
        {
            combinando[playerid] = -1;
            abrir_inv_novo(playerid);
            SelectTextDraw(playerid, 0xffff0080);
        }
        else if(selecionando_inv_novo[playerid] != -1)
        {
            fechar_caixinha(playerid);
            selecionando_inv_novo[playerid] = -1;
            selecionando_inv_novo2[playerid] = -1;
            abrir_inv_novo(playerid);
            SelectTextDraw(playerid, 0xffff0080);
        }
        else fechar_inv_novo(playerid);
    }

    if(voltar_local[playerid] == 1) fechar_pos(playerid);
    if(mostrando_trade[playerid] == 1) cancelar_trade(playerid);
    if(mostrando_vip[playerid] == 1) fechar_vip(playerid);
    if(mostrando_banco[playerid] == 1) fechar_banco(playerid);
    if(mostrando_menu[playerid] == 1) RespostaMenu(playerid, menu_id[playerid], 0, escolhendo_menu[playerid]);
    if(celular_aberto[playerid] != -1) fechar_celular(playerid);
	if(mostrando_radio[playerid] == 1) fechar_radio(playerid);
	if(imobilizado[playerid] == 1) SelectTextDraw(playerid, 0xffff00ff);
    if(id[playerid] == -1) SelectTextDraw(playerid, 0xffff00ff);
    if(logado[playerid] == 0) SelectTextDraw(playerid, 0xffff00ff);
    if(menu_vei_aberto[playerid] == 1) fechar_menu_vei(playerid);
    if(dando_tacada[playerid] == 1) SelectTextDraw(playerid, 0xffff00ff);
    if(id[playerid] != -1)
	{
	    if(Conta[playerid][c_Morto] > 0)
	    {
            SelectTextDraw(playerid, 0xffff00ff);
	    }
	}
	if(PainelOrgsAberto[playerid]) fechar_painel_orgs(playerid);
}

public OnPlayerClickTextDraw( playerid, Text:clickedid )
{
	new c = id[playerid];
    if(Player_AFK(playerid)) return 1;
    if(id_loop_lento[playerid] != -1)
	{
		SelectTextDraw(playerid, 0x0000ff90);
		return 1;
	}
    if(logado[playerid] == 0){
    	SelectTextDraw(playerid, 0xFFDC33FF);
    }

    ///// apertou esc //////
	if(clickedid == Text:INVALID_TEXT_DRAW)
	{
		apertou_esc(playerid);
        return 1;
    }

    // operador maquinas textdraw (sprites clicaveis)
	if(OM_Consertando[playerid] == 1)
	{
	    if(clickedid == OM_TD[2] && OM_ErroFiles[playerid] && OM_TimerP[playerid] == 0) { OM_CompAtual[playerid] = 0; OM_Progresso[playerid] = 10; PlayerTextDrawSetString(playerid, OM_TDP[playerid][4], "OPERANDO: FILES..."); OM_TimerP[playerid] = SetTimerEx("OM_Tick", 1000, true, "d", playerid); return 1; }
	    if(clickedid == OM_TD[4] && OM_ErroVelo[playerid] && OM_TimerP[playerid] == 0) { OM_CompAtual[playerid] = 1; OM_Progresso[playerid] = 10; PlayerTextDrawSetString(playerid, OM_TDP[playerid][4], "OPERANDO: VELOCIDADE..."); OM_TimerP[playerid] = SetTimerEx("OM_Tick", 1000, true, "d", playerid); return 1; }
	    if(clickedid == OM_TD[6] && OM_ErroIdle[playerid] && OM_TimerP[playerid] == 0) { OM_CompAtual[playerid] = 2; OM_Progresso[playerid] = 10; PlayerTextDrawSetString(playerid, OM_TDP[playerid][4], "OPERANDO: IDLE..."); OM_TimerP[playerid] = SetTimerEx("OM_Tick", 1000, true, "d", playerid); return 1; }
	    if(clickedid == OM_TD[8] && OM_ErroMaxV[playerid] && OM_TimerP[playerid] == 0) { OM_CompAtual[playerid] = 3; OM_Progresso[playerid] = 10; PlayerTextDrawSetString(playerid, OM_TDP[playerid][4], "OPERANDO: MAX VEL..."); OM_TimerP[playerid] = SetTimerEx("OM_Tick", 1000, true, "d", playerid); return 1; }
	    if(clickedid == OM_TD[10]) { // Reset
	        if(OM_TudoOk(playerid))
	        {
	            DarGrana(playerid, OM_PAGAMENTO); ms(playerid, 0, f("Maquina OK! +$%d", OM_PAGAMENTO));
	            OM_Problema[playerid] = 0; OM_Consertando[playerid] = 0; DisablePlayerCheckpoint(playerid); OM_Checkpoint[playerid] = 0;
	            OM_DestruirTDP(playerid); for(new i; i<12; i++) TextDrawHideForPlayer(playerid, OM_TD[i]); CancelSelectTextDraw(playerid); mostrar_hud(playerid);
	            KillTimer(OM_Timer[playerid]); OM_Timer[playerid] = SetTimerEx("OM_GerarProblema", OM_TEMPO_PROBLEMA, false, "d", playerid);
	        }
	        else { DarGrana(playerid, -OM_MULTA); ms(playerid, 0, f("Ainda com erros! Multa de $%d!", OM_MULTA)); }
	        return 1;
	    }
	    if(clickedid == OM_TD[0] || clickedid == OM_TD[1] || clickedid == OM_TD[3] || clickedid == OM_TD[5] || clickedid == OM_TD[7] || clickedid == OM_TD[9] || clickedid == OM_TD[11]) return 1; // labels nao clicaveis
	    return 1;
	}

    // concessionaria textdraw //
	if(ConceAberto[playerid] == 1)
	{
	    if(clickedid == Text:INVALID_TEXT_DRAW) { EsconderFConce(playerid); return 1; }
	    C_ClickGlobal(playerid, clickedid);
	    if(ConceAberto[playerid] == 1) SelectTextDraw(playerid, 0x00FF00FF);
	    return 1;
	}

    // fechar caixinha //
	if(clickedid == T_Caixinha[7])
	{
	    fechar_caixinha(playerid);
	}

	// usar //
	if(clickedid == T_Caixinha[2])
	{
	    if(c != -1)
	    {
		    new slot = selecionando_inv_novo[playerid];
		    if(slot > -1)
			{
				fechar_caixinha(playerid);
				inv_usar(playerid, c, slot);
			}
		    else
		    {
		        abrir_inv_novo(playerid);
	            SelectTextDraw(playerid, 0xffff0080);
	            MS(playerid, 0, "Ouve um erro ao acessar este slot, o inventario foi reaberto !");
		    }
	    }
	    return 1;
	}

	// combinar //
	if(clickedid == T_Caixinha[3])
	{
	    if(c != -1)
	    {
		    new slot = selecionando_inv_novo[playerid];
			if(slot > -1)
			{
			    new idd = Inventario[playerid][slot][inv_ID];
			    new tipo = Inventario[playerid][slot][inv_Tipo];
		        if(Itens[idd][item_Combinavel] == 0) return MS(playerid, 0, "Este Item nao e combinavel !");
		        if(!tem_outro(playerid, idd, slot)) return MS(playerid, 0, "Voce nao tem outro item igual para combinar !");
		        // verificar se venceu //
				if(Inventario[playerid][slot][inv_Ativo] == 1 && Inventario[playerid][slot][inv_Tempo] != 0)
	            {
	                if(Inventario[playerid][slot][inv_Tempo] <= gettime())
	                {
	                    new sss[300];
	                    format(sss, 300, "O Item '%s' foi excluido do seu inventario, por vencimento !", NomeItem(idd, tipo));
						ms(playerid, 2, sss);
						limpar_slot(playerid, slot);
						fechar_caixinha(playerid);
						return 1;
					}
	            }
	            fechar_caixinha(playerid);
				combinando[playerid] = slot;
				abrir_inv_novo(playerid);
				ms(playerid, 2, "Voce esta combinando o item, aperte ESC se quiser cancelar.");
			}
			else
			{
			    abrir_inv_novo(playerid);
	            SelectTextDraw(playerid, 0xffff0080);
	            MS(playerid, 0, "Ouve um erro ao acessar este slot, o inventario foi reaberto !");
			}
		}
	    return 1;
	}

	// separar //
	if(clickedid == T_Caixinha[4])
	{
	    new slot = selecionando_inv_novo[playerid];
	    if(slot > -1)
	    {
		    new idd = Inventario[playerid][slot][inv_ID];
			new tipo = Inventario[playerid][slot][inv_Tipo];
		    // verificar se venceu //
			if(Inventario[playerid][slot][inv_Ativo] == 1 && Inventario[playerid][slot][inv_Tempo] != 0)
	        {
	            if(Inventario[playerid][slot][inv_Tempo] <= gettime())
	            {
	                new sss[300];
	                format(sss, 300, "O Item '%s' foi excluido do seu inventario, por vencimento !", NomeItem(idd, tipo));
					ms(playerid, 2, sss);
					limpar_slot(playerid, slot);
					fechar_caixinha(playerid);
					return 1;
				}
	        }
	       	separar_item(playerid, slot);
        }
        else
        {
            abrir_inv_novo(playerid);
            SelectTextDraw(playerid, 0xffff0080);
            MS(playerid, 0, "Ouve um erro ao acessar este slot, o inventario foi reaberto !");
        }
	    return 1;
	}

	// dropar //
	if(clickedid == T_Caixinha[5])
	{
	    if(c != -1)
	    {
		    new slot = selecionando_inv_novo[playerid];
		    if(slot > -1)
		    {
			    new idd = Inventario[playerid][slot][inv_ID];
				new tipo = Inventario[playerid][slot][inv_Tipo];
		    	// verificar se venceu //
			    if(Inventario[playerid][slot][inv_Ativo] == 1 && Inventario[playerid][slot][inv_Tempo] != 0)
		        {
		            if(Inventario[playerid][slot][inv_Tempo] <= gettime())
		            {
		                new sss[300];
		                format(sss, 300, "O Item '%s' foi excluido do seu inventario, por vencimento !", NomeItem(idd, tipo));
						ms(playerid, 2, sss);
						limpar_slot(playerid, slot);
						fechar_caixinha(playerid);
						return 1;
					}
		        }
		        fechar_caixinha(playerid);
			    dropar_inv(playerid, slot);
		    }
		    else
		    {
		        abrir_inv_novo(playerid);
	            SelectTextDraw(playerid, 0xffff0080);
	            MS(playerid, 0, "Ouve um erro ao acessar este slot, o inventario foi reaberto !");
		    }
	    }
	    return 1;
	}


	// INV NOVO AQUI //
	if(clickedid == T_InvNovo[2]) // fechar //
	{
		fechar_inv_novo(playerid);
	    return 1;
	}

	// carregar posicao //
	if(clickedid == T_UltimaPos[2])
	{
	    if(voltar_local[playerid] == 1)
	    {
	    	fechar_pos(playerid);
	    }
	    return 1;
	}

	// meu e loja //
	for(new a=1; a<8; a++)
	{
		if(clickedid == T_Meu[a])
		{
            if(a == 1) mostrar_portoes(playerid);
	        if(a == 2) mostrar_acessorios(playerid);
	        if(a == 3) mostrar_maconhas(playerid);
	        if(a == 4) mostrar_titulos(playerid);
	        if(a == 5) mostrar_veiculos(playerid);
	        if(a == 6) mostrar_casas(playerid);
	        if(a == 7) mostrar_empresas(playerid);
	        fechar_inv_novo(playerid);
		    return 1;
		}
	}
	if(clickedid == T_Meu[8])
	{
	    fechar_inv_novo(playerid);
	    SetTimerEx("abrir_agora", 350, false, "dd", playerid, 4);
	    return 1;
	}

	// atalhos //
	if(clickedid == T_Atalhos[2])
	{
        if(tem_item(playerid, 87) == -1) return MS(playerid, 0, "Voce nao possue um aparelho Celular, compre um em uma loja de eletronicos !");
	    fechar_inv_novo(playerid);
	    SetTimerEx("abrir_agora", 350, false, "dd", playerid, 0);
	    return 1;
	}
	if(clickedid == T_Atalhos[3])
	{
        if(tem_item(playerid, 86) == -1) return MS(playerid, 0, "Voce nao possue um Radio Comunicador, compre um em uma loja de eletronicos !");
	    fechar_inv_novo(playerid);
	   	SetTimerEx("abrir_agora", 350, false, "dd", playerid, 3);
	    return 1;
	}

  	// ARMAS //
    if(clickedid == T_Armas[4])
	{
		if(UsouBotaoINV[playerid] != 0)return SSM(playerid, -1, "{FF0000}[SERVER]: Voce nao pode clicar mais de um botao de uma vez.");
		UsouBotaoINV[playerid] = 1;
        TimerFloodBotaoInv[playerid] = SetTimerEx("FloodBotaoInvT", 3000, false, "i", playerid);
		// voltar //
		id_arma[playerid] --;
		new maxa = GetPVarInt(playerid, "cont_armas");
        if(id_arma[playerid] == -1) id_arma[playerid] = maxa-1;
        mostrar_armas_novo(playerid, 1);
        return 1;
	}
	if(clickedid == T_Armas[5])
	{
		if(UsouBotaoINV[playerid] != 0)return SSM(playerid, -1, "{FF0000}[SERVER]: Voce nao pode clicar mais de um botao de uma vez.");
		UsouBotaoINV[playerid] = 1;
        TimerFloodBotaoInv[playerid] = SetTimerEx("FloodBotaoInvT", 3000, false, "i", playerid);
		// avancar //
        new maxa = GetPVarInt(playerid, "cont_armas");
        id_arma[playerid] ++;
        if(id_arma[playerid]+1 > maxa) id_arma[playerid] = 0;
        mostrar_armas_novo(playerid, 1);
        return 1;
	}
	if(clickedid == T_Armas[2])
	{
		if(UsouBotaoINV[playerid] != 0)return SSM(playerid, -1, "{FF0000}[SERVER]: Voce nao pode clicar mais de um botao de uma vez.");
		UsouBotaoINV[playerid] = 1;
        TimerFloodBotaoInv[playerid] = SetTimerEx("FloodBotaoInvT", 3000, false, "i", playerid);
		// guardar //
        if(IsPlayerInAnyVehicle(playerid))
	   	{
            ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}_", "\n{ff0000}[INFO] {a1a1a1}Voce nao pode fazer isso em um veiculo !\n", "Ok", "Fechar");
            return 1;
        }
        if(flood_arma[playerid] == 1) return 1;
        new slota = -1;
        if(id_arma[playerid] != -1) slota = ListaArmas[playerid][id_arma[playerid]];
		if(slota == -1) return 1;
        new art[13][2];
	    for(new i; i<13; i++) GetPlayerWeaponData(playerid, i, art[i][0], art[i][1]);

		// ferramentas de trampo //
		if(art[slota][0] == 6 && art[slota][0] == 9)
		{
		    ResetPlayerWeapons_(playerid);
		    for(new ii; ii<13; ii++) if(ii != slota) GivePlayerWeapon_(playerid, art[ii][0], art[ii][1]);
		    flood_arma[playerid] = 1;
	    	SetTimerEx("armas_costas", 1500, false, "d", playerid);
	    	SetTimerEx("salvar_armas", 1500, false, "dd", playerid, 0);
		    ms(playerid, 2, "Esta Arma foi escluida, pois nao pode ser Guardada !");
		    return 1;
		}
		if(Novato(playerid)) return ms(playerid, 2, "Novatos nao podem Guardar armas !");

		//ferificacao de slots //
		if(slota > 0 && slota < 11)
		{
		    // se tiver de taser //
		    new pode = 1;
		    if(slota == 2)
		    {
		        if(Taser(playerid))
		        {
                    pode = 0;
                    ms(playerid, 0, "Voce nao pode guardar uma arma de choque, use /taser !");
                    return 1;
		        }
		    }

		    if(pode == 1)
		    {
				new or = OrgPlayer(playerid);
				if(or != -1)
				{
				    if(IsPlayerInRangeOfPoint(playerid, 1.5, Org[or][o_X], Org[or][o_Y], Org[or][o_Z]))
					{
					new idd = id_armas_org(art[slota][0]);
					new idmun = municao(art[slota][0]);
						if(idd != -1)
						{
						    Org[or][o_Armas][idd] += 1;
						    if(idmun != -1) Org[or][o_Municoes][idmun] += art[slota][1];
						    ResetPlayerWeapons_(playerid);
							for(new ii; ii<13; ii++)
							{
							if(ii != slota)
							{
							    GivePlayerWeapon_(playerid, art[ii][0], art[ii][1]);
							}
						    }
						    salvar_org(or);
						    flood_arma[playerid] = 1;
					    	ms(playerid, 2, "Voce guardou a arma na Organizacao.");
					    	SetTimerEx("armas_costas", 1500, false, "d", playerid);
					    	SetTimerEx("salvar_armas", 1500, false, "dd", playerid, 0);
						}
						else
						{
							ms(playerid, 2, "Voce nao pode guardar esta arma na Organizacao !");
						}
						return 1;
				    }
				}
			}



			// no porta malas //
			new porta_malas = verificar_porta_malas(playerid);
			if(porta_malas != -1)
			{
			    // se tiver de taser //
			    pode = 1;
			    if(slota == 2)
				{
				if(Taser(playerid))
				{
	                    pode = 0;
	                    ms(playerid, 0, "Voce nao pode guardar uma arma de choque, use /taser !");
	                    return 1;
				}
			    }

			    if(pode == 1)
				{

					if(porta_malas == -4)
					{
					    ms(playerid, 2, "Apenas o Emprego deste veiculo tem acesso ao portamalas !");
						return 1;
					}
					if(porta_malas == -3)
					{
					    ms(playerid, 2, "Apenas a Organizacao deste veiculo tem acesso ao portamalas !");
						return 1;
					}
					if(porta_malas == -2)
					{
					    MS(playerid, 0, "O veiculo esta travado, nao e possivel abrir o porta malas !");
						return 1;
					}

					new v = porta_malas;
					new max_porta_malas = slots_porta_malas(v);
					if(slota == 8 || slota == 7)
					{
						for(new a; a<max_porta_malas; a++)
						{
						    if(PortaMalas[v][a][inv_ID] == 0)
							{
								PortaMalas[v][a][inv_ID] = arma_id(art[slota][0]);
							PortaMalas[v][a][inv_Unidades] = art[slota][1];
							PortaMalas[v][a][inv_Tipo] = Itens[arma_id(art[slota][0])][item_Tipo];
							PortaMalas[v][a][inv_Ativo] = 0;
							PortaMalas[v][a][inv_Tempo] = 0;
				        	ResetPlayerWeapons_(playerid);
								for(new ii; ii<13; ii++)
								{
								if(ii != slota)
								{
								    GivePlayerWeapon_(playerid, art[ii][0], art[ii][1]);
								}
							    }
							    flood_arma[playerid] = 1;
							    SalvarInfo(v, 0, a);
							    SetTimerEx("armas_costas", 1500, false, "d", playerid);
							    SetTimerEx("salvar_armas", 1500, false, "dd", playerid, 0);
							    ms(playerid, 1, "Voce guardou a arma no porta-malas do veiculo !");
							return 1;
						    }
						}
						ms(playerid, 0, "Porta malas do veiculo lotado !");
					    return 1;
					}

					new s1 = -1;
					new s2 = -1;

					for(new a; a<max_porta_malas; a++)
					{
					    if(PortaMalas[v][a][inv_ID] == 0)
						{
					    	if(s1 == -1) s1 = a;
						    else if(s2 == -1) s2 = a;
						    if(s1 != -1 && s2 != -1) break;
						}
					}

				    if(s1 != -1 && s2 != -1)
					{
					    PortaMalas[v][s1][inv_ID] = arma_id(art[slota][0]);
					    PortaMalas[v][s1][inv_Unidades] = 1;
					    PortaMalas[v][s1][inv_Tipo] = slota;
					    PortaMalas[v][s1][inv_Ativo] = 0;
					    PortaMalas[v][s1][inv_Tempo] = 0;
					    SalvarInfo(v, 0, s1);
					    if(art[slota][1] > 0)
						{
							for(new cc=44; cc<49; cc++)
							{
							if(Itens[cc][item_Tipo] == slota)
							{
								    PortaMalas[v][s2][inv_ID] = cc;
								    PortaMalas[v][s2][inv_Unidades] = art[slota][1];
								    PortaMalas[v][s2][inv_Tipo] = slota;
								    PortaMalas[v][s2][inv_Ativo] = 0;
					    			PortaMalas[v][s2][inv_Tempo] = 0;
					    			SalvarInfo(v, 0, s2);
								    break;
							    }
						    }
					    }
					    ResetPlayerWeapons_(playerid);
						for(new ii; ii<13; ii++)
						{
						if(ii != slota)
						{
						    GivePlayerWeapon_(playerid, art[ii][0], art[ii][1]);
						}
					    }
					    flood_arma[playerid] = 1;
					    SetTimerEx("salvar_armas", 1500, false, "dd", playerid, 0);
					    SetTimerEx("armas_costas", 1500, false, "d", playerid);
					    ms(playerid, 1, "Voce guardou a arma no porta-malas do veiculo !");
					    return 1;
					}
					ms(playerid, 0, "Porta malas do veiculo lotado !");
					return 1;
				}
			}

		}

	    if(slota == 8 || slota == 7)
		{
		    for(new v; v<MAX_SLOTS; v++)
		    {
		        if(Inventario[playerid][v][inv_ID] == 0)
		        {
		            Inventario[playerid][v][inv_ID] = arma_id(art[slota][0]);
				    Inventario[playerid][v][inv_Unidades] = art[slota][1];
				    Inventario[playerid][v][inv_Tipo] = Itens[arma_id(art[slota][0])][item_Tipo];
                    ResetPlayerWeapons_(playerid);
					for(new ii; ii<13; ii++)
					{
					if(ii != slota)
					{
					    GivePlayerWeapon_(playerid, art[ii][0], art[ii][1]);
					}
				    }
				    flood_arma[playerid] = 1;
				    SetTimerEx("salvar_armas", 1500, false, "dd", playerid, 0);
				    SetTimerEx("armas_costas", 1500, false, "d", playerid);
					salvar_inventario(c, v);
					abrir_inv_novo(playerid);
				    return 1;
		        }
		    }
		    ms(playerid, 0, "Seu inventario esta lotado !");
		    return 1;
		}

		// se tiver de taser //
		new podea = 1;
	    if(slota == 2)
	    {
	        if(Taser(playerid))
	        {
                podea = 0;
                ms(playerid, 0, "Voce nao pode guardar uma arma de choque, use /taser !");
                return 1;
	        }
	    }

	    if(podea == 1)
	    {
		    new s1 = -1;
			new s2 = -1;
		    for(new s; s<MAX_SLOTS; s++)
		    {
		        if(Inventario[playerid][s][inv_ID] == 0)
				{
				    if(s1 == -1) s1 = s;
				    else if(s2 == -1) s2 = s;
				    if(s1 != -1 && s2 != -1) break;
				}
		    }

		    if(s1 != -1 && s2 != -1)
		    {

			    Inventario[playerid][s1][inv_ID] = arma_id(art[slota][0]);
			    Inventario[playerid][s1][inv_Unidades] = 1;
			    Inventario[playerid][s1][inv_Tipo] = slota;
			    salvar_inventario(c, s1);

			    if(art[slota][1] > 0)
				{
					for(new cc=44; cc<49; cc++)
					{
					if(Itens[cc][item_Tipo] == slota)
					{
						    Inventario[playerid][s2][inv_ID] = cc;
						    Inventario[playerid][s2][inv_Unidades] = art[slota][1];
						    Inventario[playerid][s2][inv_Tipo] = slota;
						    salvar_inventario(c, s2);
						    break;
					    }
				    }
			    }

			    ResetPlayerWeapons_(playerid);
				for(new ii; ii<13; ii++)
				{
				if(ii != slota)
				{
				    GivePlayerWeapon_(playerid, art[ii][0], art[ii][1]);
				}
			    }
			    flood_arma[playerid] = 1;
			    SetTimerEx("salvar_armas", 1500, false, "dd", playerid, 0);
			    SetTimerEx("armas_costas", 1500, false, "d", playerid);
			    abrir_inv_novo(playerid);
			    return 1;
			}
			ms(playerid, 0, "Seu Inventario esta cheio !");
	    	return 1;
		}

        return 1;
	}
	if(clickedid == T_Armas[1])
	{
		if(UsouBotaoINV[playerid] != 0)return SSM(playerid, -1, "{FF0000}[SERVER]: Voce nao pode clicar mais de um botao de uma vez.");
		UsouBotaoINV[playerid] = 1;
        TimerFloodBotaoInv[playerid] = SetTimerEx("FloodBotaoInvT", 3000, false, "i", playerid);
		// drop //
		new slota = -1;
		if(id_arma[playerid] != -1) slota = ListaArmas[playerid][id_arma[playerid]];
		if(slota == -1) return 1;
	    new pode = 1;
	    if(slota == 2)
	    {
	        if(Taser(playerid))
	        {
                pode = 0;
                ms(playerid, 0, "Voce nao pode dropar uma arma de choque, use /taser !");
                return 1;
	        }
	    }
	    if(pode == 1)
	    {
            new artt[13][2];
			new Float:ps[3];
			GetPlayerPos(playerid, ps[0], ps[1], ps[2]);
		    for(new i; i<13; i++) GetPlayerWeaponData(playerid, i, artt[i][0], artt[i][1] );

		    // ferramentas de trampo //
			if(artt[slota][0] == 6 && artt[slota][0] == 9)
			{
			    ResetPlayerWeapons_(playerid);
				for(new ii; ii<13; ii++) if(ii != slota) GivePlayerWeapon_(playerid, artt[ii][0], artt[ii][1]);
			    flood_arma[playerid] = 1;
		    	SetTimerEx("armas_costas", 1500, false, "d", playerid);
		    	SetTimerEx("salvar_armas", 1500, false, "dd", playerid, 0);
			    ms(playerid, 2, "Esta Arma foi escluida, pois nao pode ser Dropada !");
			    return 1;
			}

			if(Novato(playerid)) return ms(playerid, 2, "Novatos nao podem dropar armas !");
			if(slota == 7 || slota == 8)
			{
			    criar_item(arma_id(artt[slota][0]), ps[0], ps[1], ps[2], artt[slota][1], GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), slota);
	            ResetPlayerWeapons_(playerid);
				for(new ii; ii<13; ii++)
				{
				if(ii != slota)
				{
				    GivePlayerWeapon_(playerid, artt[ii][0], artt[ii][1]);
				}
			    }
			    flood_arma[playerid] = 1;
		  		SetTimerEx("salvar_armas", 1500, false, "dd", playerid, 0);
		  		SetTimerEx("armas_costas", 1500, false, "d", playerid);
			    return 1;
			}

		    criar_item(arma_id(artt[slota][0]), ps[0], ps[1], ps[2], 1, GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), slota);
			if(artt[slota][1] > 0)
			{
				for(new cc=44; cc<49; cc++)
				{
				if(Itens[cc][item_Tipo] == slota)
				{
						criar_item(cc, ps[0], ps[1], ps[2], artt[slota][1], GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), slota);
					}
				}
			}

			ResetPlayerWeapons_(playerid);
		    for(new ii; ii<13; ii++)
		    {
		        if(ii != slota)
		        {
		            GivePlayerWeapon_(playerid, artt[ii][0], artt[ii][1]);
		        }
		    }
		    flood_arma[playerid] = 1;
	  		SetTimerEx("salvar_armas", 1500, false, "dd", playerid, 0);
	  		SetTimerEx("armas_costas", 1500, false, "d", playerid);
	  		return 1;
  		}
        return 1;
	}

	/////////////////////////////
	//////// criar conta ////////
	/////////////////////////////

	if(CriarConta[playerid][cc_Criando] == 1)
	{

	    // ver senha //
	    if(clickedid == T_CC_Senha[3])
	    {
			if(CriarConta[playerid][cc_MostrarSenha] == 0) CriarConta[playerid][cc_MostrarSenha] = 1;
			else CriarConta[playerid][cc_MostrarSenha] = 0;
			atualizar_criar_conta(playerid);
	        return 1;
	    }

	    // setar senha //
	    if(clickedid == T_CC_Senha[2])
	    {
	        definir_senha_lobby(playerid);
	        return 1;
	    }

	    // setar nick //
	    if(clickedid == T_CC_Nick[2])
	    {
	        definir_nick_lobby(playerid);
	        return 1;
	    }

	    // sexo masculino //
	    if(clickedid == T_CC_Sexo[1] || clickedid == T_CC_Sexo[5])
	    {
            CriarConta[playerid][cc_Sexo] = 0;
            atualizar_criar_conta(playerid);
	        return 1;
	    }

	    // sexo feminino //
	    if(clickedid == T_CC_Sexo[2] || clickedid == T_CC_Sexo[6])
	    {
            CriarConta[playerid][cc_Sexo] = 1;
            atualizar_criar_conta(playerid);
	        return 1;
	    }

	    // diminuir idade //
	    if(clickedid == T_CC_Idade[2])
	    {
            if(CriarConta[playerid][cc_Idade] > 18)
			{
				CriarConta[playerid][cc_Idade] --;
				atualizar_criar_conta(playerid);
			}
			return 1;
	    }

	    // aumentar idade //
	    if(clickedid == T_CC_Idade[3])
	    {
            if(CriarConta[playerid][cc_Idade] < 40)
			{
				CriarConta[playerid][cc_Idade] ++;
				atualizar_criar_conta(playerid);
			}
			return 1;
	    }

	    if(clickedid == T_CC_Skin[2]) // voltar skin //
	    {
			if(CriarConta[playerid][cc_Skin] > 0)
			{
				CriarConta[playerid][cc_Skin] --;
				atualizar_criar_conta(playerid);
			}
			return 1;
	    }

	    if(clickedid == T_CC_Skin[3]) // avancar skin //
	    {
            if(CriarConta[playerid][cc_Skin] < 4)
			{
				CriarConta[playerid][cc_Skin] ++;
				atualizar_criar_conta(playerid);
			}
            return 1;
	    }

	    if(clickedid == T_CC_Cidade[1]) // rio de janeiro //
	    {
	        CriarConta[playerid][cc_Cidade] = 0;
	        atualizar_criar_conta(playerid);
	        return 1;
	    }
	    if(clickedid == T_CC_Cidade[2]) // sao paulo //
	    {
	        CriarConta[playerid][cc_Cidade] = 1;
	        atualizar_criar_conta(playerid);
	        return 1;
	    }
        if(clickedid == T_CC_Cidade[3]) // minas gerais //
	    {
	        CriarConta[playerid][cc_Cidade] = 2;
	        atualizar_criar_conta(playerid);
	        return 1;
	    }

	    if(clickedid == T_CC[7]) // sair //
	    {
	        fechar_criar_conta_lobby(playerid);
	    	MostrarLogin(playerid);
	        return 1;
	    }

	    if(clickedid == T_CC[5]) // botao continuar //
	    {
	        if(CC_Etapa[playerid] == 0)
	        {
	            // escolher sexo //
	            if(CriarConta[playerid][cc_Sexo] != -1) atualizar_criar_conta(playerid, 1);
	            else ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}_", "\n{ff0000}[INFO] {a1a1a1}Voce ainda nao escolheu seu Sexo !\n", "Ok", "Fechar");
                return 1;
			}

	        if(CC_Etapa[playerid] == 1)
	        {
	            // escolher skin //
	            CriarConta[playerid][cc_Skin] = skins_contas[CriarConta[playerid][cc_Sexo]][CriarConta[playerid][cc_Skin]];
	            atualizar_criar_conta(playerid, 1);
                return 1;
			}

	        if(CC_Etapa[playerid] == 2)
	        {
	            // escolher idade //
	            atualizar_criar_conta(playerid, 1);
	            return 1;
	        }

	        if(CC_Etapa[playerid] == 3)
	        {
	            // cidade //
                if(CriarConta[playerid][cc_Cidade] != -1)
	            {
	                atualizar_criar_conta(playerid, 1);
	            }
                else ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}_", "\n{ff0000}[INFO] {a1a1a1}Voce ainda nao escolheu sua Cidade !\n", "Ok", "Fechar");
                return 1;
			}

	        if(CC_Etapa[playerid] == 4)
	        {
	            // escolher nick //
				if(!Comparar("nada", CriarConta[playerid][cc_Nick]))
				{
                    atualizar_criar_conta(playerid, 1);
				}
	            else ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}_", "\n{ff0000}[INFO] {a1a1a1}Voce ainda nao informou seu Nick !\n", "Ok", "Fechar");
                return 1;
			}

	        if(CC_Etapa[playerid] == 5)
	        {
	            // escolher senha //
				if(!Comparar("nada123", CriarConta[playerid][cc_Senha]))
				{
				    if(GetPVarInt(playerid, "flood_criar_conta") < gettime())
					{
						terminar_conta(playerid);
				    	SetPVarInt(playerid, "flood_criar_conta", gettime()+2);
				    }
				}
	            else ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}_", "\n{ff0000}[INFO] {a1a1a1}Voce ainda nao informou sua Senha !\n", "Ok", "Fechar");
                return 1;
			}

	        return 1;
	    }
    }

    /////////////////////////////
    /////////////////////////////
    /////////////////////////////


	// fichas //
	if(clickedid == T_Fichas[4])
	{
	    trocar_fichas(playerid);
	    return 1;
	}

    //  trade //
    if(clickedid == T_Trade[1])
    {
        // botao de fechar //
        cancelar_trade(playerid);
        return 1;
    }
    if(clickedid == T_Trade[2])
    {
        // confirmar //
        new pla = negociando[playerid];
        if(Online(pla))
        {
            if(trade_slot[pla] != -1)
            {
                new slot = inv_vazio(playerid);
                if(slot == -1)
                {
                    ms(playerid, 0, "O jogador esta oferecendo um Item de inventario, e o seu esta Lotado ! ");
                    return 1;
                }
            }
			if(trade_aceitou[playerid] == 0) trade_aceitou[playerid] = 1;
			mostrar_trade(playerid, 2);
			mostrar_trade(pla, 2);
		}
        return 1;
    }
    if(clickedid == T_Trade[3])
    {
        // cancelar //
        new pla = negociando[playerid];
        if(Online(pla))
        {
			if(trade_aceitou[playerid] == 1) trade_aceitou[playerid] = 0;
			mostrar_trade(playerid, 2);
			mostrar_trade(pla, 2);
		}
        return 1;
    }
    if(clickedid == T_Trade[4])
    {
        // voltar pagina //
        if(mostrando_trade[playerid] == 1)
        {
            if(pagina_trade[playerid] > 0)
            {
                pagina_trade[playerid] --;
                mostrar_trade(playerid, 1);
            }
        }
        return 1;
    }
    if(clickedid == T_Trade[5])
    {
        // avancar pagina //
        if(mostrando_trade[playerid] == 1)
        {
            new cont;
            for(new i; i<MAX_SLOTS; i++)
		    {
		        if(Inventario[playerid][i][inv_ID] > 0)
		        {
		            if(i != trade_slot[playerid])
		            {
		                cont++;
		            }
		        }
			}
			new pags = paginas(3, cont);
		    for(new d; d<5; d++)
		    {
		        if(pagina_trade[playerid]+1 > pags)
		    	{
		    	    pagina_trade[playerid] --;
		        }
		    }
		    if(pagina_trade[playerid]+1 < pags)
		    {
		        pagina_trade[playerid] ++;
			    mostrar_trade(playerid, 1);
            }
        }
        return 1;
    }


	// vip e socio //
	if(clickedid == T_Vip[3])
	{
	    fechar_vip(playerid);
	    return 1;
	}

	// tela do caixa eletronico //
	if(clickedid == T_CaixaEletronico[16])
	{
	    // fechar //
	    if(mostrando_banco[playerid] == 1)
	    {
	    	fechar_banco(playerid);
	    }
	    return 1;
	}
	if(clickedid == T_CaixaEletronico[9])
	{
	    // saque //
	    if(mostrando_banco[playerid] == 1)
	    {
    		AbrirBanco(playerid, 4);
	    }
	    return 1;
	}
	if(clickedid == T_CaixaEletronico[10])
	{
	    // deposito //
	    if(mostrando_banco[playerid] == 1)
	    {
            AbrirBanco(playerid, 3);
	    }
	    return 1;
	}
	if(clickedid == T_CaixaEletronico[11])
	{
	    // transferir //
	    if(mostrando_banco[playerid] == 1)
	    {
            opcao_transferir[playerid] = 0;
            AbrirBanco(playerid, 2);
	    }
	    return 1;
	}

    // menu veiculo //
    if(clickedid == T_Menu_Veiculo[1])
    {
        if(menu_vei_aberto[playerid] == 1)
        {
        	fechar_menu_vei(playerid);
        }
        return 1;
    }

    new _listitem = -1;
    if(clickedid == T_Menu_Veiculo[5] || clickedid == T_Menu_Veiculo[57]) _listitem = 1;      // capo
    else if(clickedid == T_Menu_Veiculo[36] || clickedid == T_Menu_Veiculo[58]) _listitem = 2; // travas
    else if(clickedid == T_Menu_Veiculo[2] || clickedid == T_Menu_Veiculo[54]) _listitem = 3;  // motor
    else if(clickedid == T_Menu_Veiculo[4] || clickedid == T_Menu_Veiculo[56]) _listitem = 4;  // farol
    else if(clickedid == T_Menu_Veiculo[45] || clickedid == T_Menu_Veiculo[59]) _listitem = 5; // bluetooth
    else if(clickedid == T_Menu_Veiculo[3] || clickedid == T_Menu_Veiculo[55]) _listitem = 6;  // malas

    if(_listitem != -1)
    {
        if(menu_vei_aberto[playerid] == 1)
        {
            if(GetPlayerVehicleID(playerid) != INVALID_VEHICLE_ID)
            {
                player_veiculo(playerid, GetPlayerVehicleID(playerid), _listitem);
                menu_vei(playerid, GetPlayerVehicleID(playerid), _listitem);
            }
        }
        return 1;
    }

    // radio //
	if(clickedid ==  T_Radio[7])
	{
        fechar_radio(playerid);
	    return 1;
	}

	// DETRAN //
	if(clickedid == T_Celular_DETRAN_APK[4])
	{
		// consultar placa //
		consultar_placa_apk(playerid);
	    return 1;
	}
	if(clickedid == T_Celular_DETRAN_APK[5])
	{
		// aplicar multa //
		multar_apk(playerid);
	    return 1;
	}

	// caixa //
	if(clickedid == T_Celular_CAIXA_APK[5])
	{
	    // ipva //
		resposta_apk_caixa(playerid, 0);
	    return 1;
	}
	if(clickedid == T_Celular_CAIXA_APK[6])
	{
	    // iptu //
        resposta_apk_caixa(playerid, 1);
	    return 1;
	}
	if(clickedid == T_Celular_CAIXA_APK[7])
	{
	    // multas //
        resposta_apk_caixa(playerid, 2);
	    return 1;
	}
	if(clickedid == T_Celular_CAIXA_APK[8])
	{
	    // aposta //
        resposta_apk_caixa(playerid, 3);
	    return 1;
	}


    // blaze //
    if(clickedid == T_Celular_Blaze_APK[19])
    {
        // depositar //
        if(blaze_player[playerid][bz_Status] == 0)
        {
			if(Conta[playerid][c_Pix] < 1)
			{
			    format(str_aviso[playerid], 300, "Voce nao tem uma conta bancaria, crie uma conta no Banco ITAU para poder depositar algum valor na Blaze !");
	    		SetPVarInt(playerid, "aviso", C_BLAZE);
	    		celular(playerid, C_ERRO);
			}
			else
			{
				depositar_blaze(playerid);
			}
        }
        else
        {
            format(str_aviso[playerid], 300, "Aguarde o Giro acabar para poder fazer um deposito !");
    		SetPVarInt(playerid, "aviso", C_BLAZE);
    		celular(playerid, C_ERRO);
        }
        return 1;
    }

    if(clickedid == T_Celular_Blaze_APK[20])
    {
        // saque //
        if(blaze_player[playerid][bz_Status] == 0)
        {
            if(Conta[playerid][c_Pix] < 1)
			{
			    format(str_aviso[playerid], 300, "Voce nao tem uma conta bancaria, crie uma conta no Banco ITAU para poder sacar algum valor da Blaze !");
	    		SetPVarInt(playerid, "aviso", C_BLAZE);
	    		celular(playerid, C_ERRO);
			}
			else
			{
				sacar_blaze(playerid);
			}
        }
        else
        {
            format(str_aviso[playerid], 300, "Aguarde o Giro acabar para poder fazer um saque !");
    		SetPVarInt(playerid, "aviso", C_BLAZE);
    		celular(playerid, C_ERRO);
        }
        return 1;
    }



	if(clickedid == T_Celular_Blaze_APK[10])
    {
        if(blaze_player[playerid][bz_Status] == 0 && blaze_status == -1)
        {
            blaze_player[playerid][bz_Cor] = 0;
			format_aposta(playerid);
        }
        return 1;
    }

    if(clickedid == T_Celular_Blaze_APK[11])
    {
        if(blaze_player[playerid][bz_Status] == 0 && blaze_status == -1)
        {
            blaze_player[playerid][bz_Cor] = 1;
			format_aposta(playerid);
        }
        return 1;
    }

    if(clickedid == T_Celular_Blaze_APK[12])
    {
        if(blaze_player[playerid][bz_Status] == 0 && blaze_status == -1)
        {
            blaze_player[playerid][bz_Cor] = 2;
			format_aposta(playerid);
        }
        return 1;
    }

    if(clickedid == T_Celular_Blaze_APK[13])
    {
        if(blaze_player[playerid][bz_Status] == 0 && blaze_status == -1)
        {
            if(blaze_player[playerid][bz_Valor] > 50)
            {
	            blaze_player[playerid][bz_Valor] -= 50;
				format_aposta(playerid);
			}
        }
    }

    if(clickedid == T_Celular_Blaze_APK[14])
    {
        if(blaze_player[playerid][bz_Status] == 0 && blaze_status == -1)
        {
            if(blaze_player[playerid][bz_Valor] < 750)
            {
	            blaze_player[playerid][bz_Valor] += 50;
				format_aposta(playerid);
			}
        }
    }

    if(clickedid == T_Celular_Blaze_APK[16])
    {
        if(blaze_player[playerid][bz_Status] == 0 && blaze_status == -1)
        {
            if(blaze_player[playerid][bz_Valor] <= blaze_player[playerid][bz_Saldo])
            {
	            blaze_player[playerid][bz_Saldo] -= blaze_player[playerid][bz_Valor];
	            new cc = id[playerid];
	            if(cc != -1) salvar_conta(cc, 0, "c_Blaze", sv_int(blaze_player[playerid][bz_Saldo]));
	            blaze_player[playerid][bz_Status] = 1;
				format_aposta(playerid);
				TextDrawHideForPlayer(playerid, T_Celular_Blaze_APK[16]);
				TextDrawShowForPlayer(playerid, T_Celular_Blaze_APK[21]);
			}
			else
	        {
	            format(str_aviso[playerid], 300, "Voce nao tem R$ %s em saldo na Blaze, deposite para poder apostar este valor !", ConvertMoney(blaze_player[playerid][bz_Valor]));
	    		SetPVarInt(playerid, "aviso", C_BLAZE);
	    		celular(playerid, C_ERRO);
	        }
        }
    }






    // parar //
	if(clickedid == T_LockPick[2])
	{
        parar_lockpick(playerid);
	    return 1;
	}

	// desistir //
	if(clickedid == T_LockPick[3])
	{
        terminar_lockpick(playerid, 0);
	    return 1;
	}

    // esquerda //
	if(clickedid == T_Tacada[0])
	{
		angulo_tacada[playerid] += 10.0;
		if(angulo_tacada[playerid] > 360.0) angulo_tacada[playerid] -= 360.0;
		agulo_tacada_player(playerid);
        return 1;
	}
	if(clickedid == T_Tacada[2])
	{
        angulo_tacada[playerid] += 0.5;
		if(angulo_tacada[playerid] > 360.0) angulo_tacada[playerid] -= 360.0;
		agulo_tacada_player(playerid);
        return 1;
	}

	// direita //
	if(clickedid == T_Tacada[1])
	{
        angulo_tacada[playerid] -= 10.0;
		if(angulo_tacada[playerid] < 0.0) angulo_tacada[playerid] += 360.0;
		agulo_tacada_player(playerid);
        return 1;
	}
	if(clickedid == T_Tacada[3])
	{
        angulo_tacada[playerid] -= 0.5;
		if(angulo_tacada[playerid] < 0.0) angulo_tacada[playerid] += 360.0;
		agulo_tacada_player(playerid);
        return 1;
	}

	// tacadas //
	if(clickedid == T_Tacada[4]) // fraco //
	{
	    if(GetPVarInt(playerid, "flood_tacada") > gettime()) return 1;
	    SetPVarInt(playerid, "flood_tacada", gettime()+2);
	    new i = player_cinuca[playerid];
	    if(i != -1)
	    {
		    KillTimer(Cinuca[i][ci_Timer]);
			for(new w; w<16; w++) Cinuca[i][ci_BolaUltima][w] = -1;
			Cinuca[i][ci_BolaDirecao][0] = angulo_tacada[playerid];
	        Cinuca[i][ci_BolaVelocidade][0] = 0.5;
	       	Cinuca[i][ci_Timer] = SetTimerEx("timer_cinuca", 50, true, "d", i);
       	}
       	fechar_tacada(playerid);
	    return 1;
	}

	if(clickedid == T_Tacada[5]) // medio //
	{
	    if(GetPVarInt(playerid, "flood_tacada") > gettime()) return 1;
	    SetPVarInt(playerid, "flood_tacada", gettime()+2);
	    new i = player_cinuca[playerid];
	    if(i != -1)
	    {
		    KillTimer(Cinuca[i][ci_Timer]);
			for(new w; w<16; w++) Cinuca[i][ci_BolaUltima][w] = -1;
			Cinuca[i][ci_BolaDirecao][0] = angulo_tacada[playerid];
	        Cinuca[i][ci_BolaVelocidade][0] = 1.0;
	       	Cinuca[i][ci_Timer] = SetTimerEx("timer_cinuca", 50, true, "d", i);
       	}
       	fechar_tacada(playerid);
	    return 1;
	}

	if(clickedid == T_Tacada[6]) // meio forte //
	{
	    if(GetPVarInt(playerid, "flood_tacada") > gettime()) return 1;
	    SetPVarInt(playerid, "flood_tacada", gettime()+2);
	    new i = player_cinuca[playerid];
	    if(i != -1)
	    {
		    KillTimer(Cinuca[i][ci_Timer]);
			for(new w; w<16; w++) Cinuca[i][ci_BolaUltima][w] = -1;
			Cinuca[i][ci_BolaDirecao][0] = angulo_tacada[playerid];
	        Cinuca[i][ci_BolaVelocidade][0] = 1.5;
	       	Cinuca[i][ci_Timer] = SetTimerEx("timer_cinuca", 50, true, "d", i);
       	}
       	fechar_tacada(playerid);
	    return 1;
	}

	if(clickedid == T_Tacada[7]) // forte //
	{
	    if(GetPVarInt(playerid, "flood_tacada") > gettime()) return 1;
	    SetPVarInt(playerid, "flood_tacada", gettime()+2);
	    new i = player_cinuca[playerid];
	    if(i != -1)
	    {
		    KillTimer(Cinuca[i][ci_Timer]);
			for(new w; w<16; w++) Cinuca[i][ci_BolaUltima][w] = -1;
			Cinuca[i][ci_BolaDirecao][0] = angulo_tacada[playerid];
	        Cinuca[i][ci_BolaVelocidade][0] = 2.0;
	       	Cinuca[i][ci_Timer] = SetTimerEx("timer_cinuca", 50, true, "d", i);
       	}
       	fechar_tacada(playerid);
	    return 1;
	}

    // morrendo //
    if(clickedid == TextMorreu[4])
	{
	    // chamar medico //
		chamar_medico(playerid);
	    return 1;
	}
	if(clickedid == TextMorreu[5])
	{
	    // desistir //
	    if(id[playerid] != -1)
	    {
	    	if(Conta[playerid][c_Morto2] > gettime())
		    {
				new sst[200];
				format(sst, 200, "Aguarde %s para poder aceitar a morte !", ConvertTime(Conta[playerid][c_Morto2] - gettime()));
				ms(playerid, 0, sst);
				return 1;
		    }
			morrer(playerid);
		}
	    return 1;
	}
    /////////////////////////////////////////
    /////////////////////////////////////////
    /////////////////////////////////////////


	// Numero do celular //
	for(new n; n<sizeof T_Celular_Numero; n++)
	{
		if(clickedid == T_Celular_Numero[n])
		{
		    // apagar //
			if(n == 10)
			{
	            if(Numero_MAX_DC[playerid] == 0) return 1;
	            else Numero_MAX_DC[playerid] --;
                if(Numero_MAX_DC[playerid] == 0) PlayerTextDrawSetString(playerid, T_Celular_Numero_p[playerid][1], "_");
				else
				{
				    new strnum[30];
					for(new i; i<Numero_MAX_DC[playerid]; i++)
					{
					strcat(strnum, ConvertMoney(Numeros_DC[playerid][i]));
				    }
				    Numero_DC[playerid] = strval(strnum);
				    PlayerTextDrawSetString(playerid, T_Celular_Numero_p[playerid][1], strnum);
				}
				return 1;
			}

			// continuar //
			if(n == 11)
			{
			    dialog_celular(playerid, ID_DC[playerid], 1, 0, Numero_DC[playerid], Numero_MAX_DC[playerid]);
				return 1;
			}

			// digitar //
			if(Numero_MAX_DC[playerid] < 10)
			{
			    Numeros_DC[playerid][Numero_MAX_DC[playerid]] = n;
			    Numero_MAX_DC[playerid] ++;
			    new strnum[30];
				for(new i; i<Numero_MAX_DC[playerid]; i++)
				{
				strcat(strnum, ConvertMoney(Numeros_DC[playerid][i]));
			    }
			    Numero_DC[playerid] = strval(strnum);
			    PlayerTextDrawSetString(playerid, T_Celular_Numero_p[playerid][1], strnum);
			}
			return 1;
		}
	}

    // ir para contato //
	if(clickedid == T_Celular_WP_APK_Converssa[0])
    {
	    ir_para_contato(playerid);
		return 1;
	}

	// digitar no whatsapp //
	if(clickedid == T_Celular_WP_APK_Converssa[1])
    {
	    if(grupo_vip[playerid] == 0) escrever_menssagem(playerid);
	    else escrever_menssagem_vip(playerid);
		return 1;
	}

	// aumentar pagina no whatsapp //
	if(clickedid == T_Celular_WP_APK_Converssa[3])
    {
	    new pagins = paginas_converssa(playerid);
	    if((pagina_converssa[playerid]+1) < pagins)
		{
			pagina_converssa[playerid] ++;
	    	mostrar_converssa(playerid);
	    }
	    return 1;
	}

	// aumentar pagina no whatsapp //
	if(clickedid == T_Celular_WP_APK_Converssa[4])
    {
	    if(pagina_converssa[playerid] > 0)
		{
			pagina_converssa[playerid] --;
	    	mostrar_converssa(playerid);
	    }
	    return 1;
	}

    // lista do celular //
    if(clickedid == T_Celular_Lista[0])
    {
        // continuar //
		dialog_celular(playerid, ID_DC[playerid], 1, Item_DC[playerid]);
        return 1;
    }

    if(clickedid == T_Celular_Lista[1])
    {
        // voltar pagina //
		if(Pagina_DC[playerid] == 0) return 1;
		else
		{
		    Pagina_DC[playerid] --;
		    celular(playerid, C_LISTA);
		}
        return 1;
    }

    if(clickedid == T_Celular_Lista[2])
    {
        // avancar pagina //
        new pags = paginas(10, MAX_DC[playerid]);
		if(Pagina_DC[playerid]+1 < pags)
		{
		    Pagina_DC[playerid] ++;
		    celular(playerid, C_LISTA);
	    }
        return 1;
    }

    // menu //
	if( clickedid == T_Menu[1])
	{
	    RespostaMenu(playerid, menu_id[playerid], 0, escolhendo_menu[playerid]);
	    return 1;
	}

	// voltar menu //
	if(clickedid == T_Menu[3])
	{
		if(pagina_menu[playerid] > 0)
		{
		    pagina_menu[playerid] --;
			mostrar_menu(playerid, menu_id[playerid]);
		}
		return 1;
	}

	// avancar menu //
	if(clickedid == T_Menu[4])
	{
	    if((pagina_menu[playerid]+1) < paginas(7, max_menu[playerid]))
	    {
	        pagina_menu[playerid] += 1;
	        mostrar_menu(playerid, menu_id[playerid]);
	    }
	    return 1;
	}

    ////////////////////////////////////////////////////////////////
    ////////////////////// sistema de celular //////////////////////
    ////////////////////////////////////////////////////////////////

	// paginas inicio //
	if(clickedid == T_Celular_Barra[0] || clickedid == T_Celular_Barra[2])
	{
	    // subir //
		if(pagina_barra[playerid] > 0)
		{
		    pagina_barra[playerid] --;
		    celular(playerid);
		}
	    return 1;
	}
	if(clickedid == T_Celular_Barra[1] || clickedid == T_Celular_Barra[3])
	{
	    // descer //
        if(pagina_barra[playerid] < 1)
		{
		    pagina_barra[playerid] ++;
		    celular(playerid);
		}
	    return 1;
	}

    // fechar celular //
    if(clickedid == T_Celular[11])
    {
        fechar_celular(playerid);
   		return 1;
    }

    // olx //
    if(clickedid == T_Celular_OLX_APK[4]) // ver anuncios //
    {
		ver_anuncios(playerid);
        return 1;
    }
    if(clickedid == T_Celular_OLX_APK[5]) // anunciar //
    {
        anunciar(playerid);
        return 1;
    }

    // apk blutuf //
    if(clickedid == T_Celular_Blu_APK[3])
    {
        aparelhos_proximos(playerid);
        return 1;
    }
    if(clickedid == T_Celular_Blu_APK[4])
    {
        desconectar_blu(playerid);
        return 1;
    }

    // apk itau //
    if(clickedid == T_Celular_Itau_APK[7]) // fazer pix //
    {
        fazer_pix(playerid);
        return 1;
    }

    // fechar //
    if(clickedid == T_Radio[17])
	{
        if(mostrando_radio[playerid] == 1)
		{
			fechar_radio(playerid);
        }
	    return 1;
	}

	// radio comunicador //
	if(mostrando_radio[playerid] == 1)
	{

	    if(clickedid == T_Radio[14]) // aumentar //
    	{
            if(radio_estacao_id[playerid] < 999)
			{
				radio_estacao_id[playerid] ++;
				mostrar_radio(playerid);
			}
    	    return 1;
    	}

    	if(clickedid == T_Radio[13]) // diminuir //
    	{
            if(radio_estacao_id[playerid] > 0)
			{
				radio_estacao_id[playerid] --;
				mostrar_radio(playerid);
			}
    	    return 1;
    	}

	    if(clickedid == T_Radio[18]) // entrar //
    	{
    	    if(GetPVarInt(playerid, "flood_radioc") > gettime()) return ms(playerid, 0, "Voce nao pode conectar em diferentes canais com muita frequencia !");
			new idd = radio_estacao_id[playerid];
            SetPVarInt(playerid, "VOIP_Conectar", 1);
			SetPVarInt(playerid, "VOIP_ConectarID", idd);
			KillTimer(timer_radio[playerid]);
			timer_radio[playerid] = SetTimerEx("mostrar_radio", 1000, false, "d", playerid);
			SetPVarInt(playerid, "flood_radioc", gettime()+3);
    	    return 1;
    	}

    	if(clickedid == T_Radio[19]) // sair //
    	{
    	    if(GetPVarInt(playerid, "flood_radioc") > gettime()) return ms(playerid, 0, "Voce nao pode conectar em diferentes canais com muita frequencia !");
    	    if(GetPVarInt(playerid, "VOIP_Desconectar") == 0) SetPVarInt(playerid, "VOIP_Desconectar", 1);
            KillTimer(timer_radio[playerid]);
			timer_radio[playerid] = SetTimerEx("mostrar_radio", 1000, false, "d", playerid);
            SetPVarInt(playerid, "flood_radioc", gettime()+3);
    	    return 1;
    	}
	}

    // apk radio //
    if(clickedid == T_Celular_Radio_APK[4]) // PLAY NA RADIO //
    {
        if(Status_Radio[playerid] == 0)
        {
            if(Ouvindo_Radio[playerid] == -1)
            {
                format(str_aviso[playerid], 300, "Voce ainda nao escolheu a estacao de radio que deseja ouvir.");
		    	SetPVarInt(playerid, "aviso", C_RADIO);
		    	celular(playerid, C_ERRO);
                return 1;
            }
            Status_Radio[playerid] = 1;
            if(Ouvindo_Radio[playerid] > 0) play_stop_radio(playerid);
            else play_stop_radio(playerid, Ouvindo_Radio_Link[playerid]);
            if(celular_aberto[playerid] == C_RADIO) celular(playerid, C_RADIO);
        }
        return 1;
    }

    if(clickedid == T_Celular_Radio_APK[5]) // STOP NA RADIO //
    {
        if(Status_Radio[playerid] == 1)
        {
            Status_Radio[playerid] = 0;
            play_stop_radio(playerid);
            if(celular_aberto[playerid] == C_RADIO) celular(playerid, C_RADIO);
        }
        return 1;
    }

    if(clickedid == T_Celular_Radio_APK[6]) // MUDAR ESTACAO DA RADIO //
    {
        mostrar_estacoes(playerid);
        return 1;
    }


    // apk gps //
    if(clickedid == T_Celular_GPS_APK[3]) // escolher local
    {
        alterar_local(playerid);
        return 1;
    }

    if(clickedid == T_Celular_GPS_APK[4]) // ligar o gps
    {
        if(GPS[playerid][gps_Status] == 0)
        {
            if(GPS[playerid][gps_Destino] == -1 || GPS[playerid][gps_Cidade] == -1)
            {
                format(str_aviso[playerid], 300, "Voce ainda nao escolheu o destino, isso deve ser feito antes de ativar o gps.");
		    	SetPVarInt(playerid, "aviso", C_GPS);
		    	celular(playerid, C_ERRO);
                return 1;
            }
            GPS[playerid][gps_Status] = 1;
            Localizar_Player(playerid, GPS[playerid][gps_DX], GPS[playerid][gps_DY], GPS[playerid][gps_DZ], 777, -1, "DESTINO");
			celular(playerid, C_GPS);
        }
        return 1;
    }
    if(clickedid == T_Celular_GPS_APK[5]) // desligar gps
    {
        if(GPS[playerid][gps_Status] == 1)
        {
            Localizar_Player(playerid, 0.0,0.0,0.0,-1);
            cancelar_gps(playerid);
			if(celular_aberto[playerid] == C_GPS) celular(playerid, C_GPS);
			ms(playerid, 3, "Voce desligou o GPS e a localizacao foi interronpida.");
        }
        return 1;
    }



    // APK uber //
    if(clickedid == T_Celular_Uber[0])
   	{
   	    celular(playerid, C_UBER_ABRINDO);
        return 1;
    }

    if( clickedid == T_Celular_Uber_Cliente[4]) // alterar destino
	{
		alterar_destino(playerid);
	    return 1;
	}

	if( clickedid == T_Celular_Uber_Cliente[3]) // chamar o uber
	{
	    corrida_uber(playerid);
	    return 1;
	}

	if( clickedid == T_Celular_Uber_Cliente[5]) // cancelar corrida
	{
		foreach(new p:Player)
		{
		    if(Online(p))
		    {
		        if(p != playerid)
		        {
				if(Uber[p][uber_Motorista] == playerid)
				{
				    if(Uber[p][uber_Status] == 2 || Uber[p][uber_Status] == 3)
					{
			    			cancelar_corrida(playerid, 2, p);
			    		}
						return 1;
			    	}
		    	}
		    }
		}
	    cancelar_corrida(playerid, 1);
	    return 1;
	}

	if(clickedid == T_Celular_Uber_Opcoes[5]) // area do cliente uber //
    {
		celular(playerid, C_UBER_CLIENTE);
        return 1;
    }

    if(clickedid == T_Celular_Uber_Motorista[5]) // ver pedidos de clientes //
    {
        if(!IsPlayerInAnyVehicle(playerid))
        {
            ms(playerid, 0, "Voce nao esta em um veiculo da empresa Uber !");
            return 1;
        }

        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
        {
            ms(playerid, 0, "Voce precisa ser o motorista do veiculo !");
            return 1;
        }

        new veic = GetPlayerVehicleID(playerid);
		if(veic != INVALID_VEHICLE_ID)
		{
			new vi = Info_Veiculo[veic];
	        if(vi == -1)
	        {
	            ms(playerid, 0, "Voce nao esta em um veiculo da empresa Uber !");
	            return 1;
	        }
        }

        new vv = Info_Veiculo[veic];
        if(Veiculo[vv][v_Emprego] != 1)
        {
            ms(playerid, 0, "Voce nao esta em um veiculo da empresa Uber !");
            return 1;
        }

        lista_de_clientes(playerid);
        return 1;
    }

    if(clickedid == T_Celular_Uber_Opcoes[6])
    {
		// motorista //
		if(EmpregoPlayer(playerid) != 1)
		{
		    // nao e motorista da uber //
		    format(str_aviso[playerid], 300, "Voce nao e motorista da uber, voce pode fazer parte dessa familia pegando o emprego de Uber, na agencia de empregos.");
		    SetPVarInt(playerid, "aviso", C_UBER);
		    celular(playerid, C_ERRO);
		    return 1;
		}

		celular(playerid, C_UBER_MOTORISTA);
        return 1;
    }

	// inventario //
    if(clickedid == T_Celular_SOS[0])
   	{
   	    celular(playerid, C_INV);
        return 1;
    }

    // ARMAS //
    if(clickedid == T_Celular_CAIXA[0])
   	{
   	    celular(playerid, C_CAIXA_ABRINDO);
        return 1;
    }

    // DETRAN //
    if(clickedid == T_Celular_DETRAN[0])
   	{
   	    celular(playerid, C_DETRAN_ABRINDO);
        return 1;
    }

    // CARTEIRA //
    if(clickedid == T_Celular_CARTEIRA[0])
   	{
   	    celular(playerid, C_CARTEIRA);
        return 1;
    }

    // blutuf //
    if(clickedid == T_Celular_Blu[0])
   	{
   	    celular(playerid, C_BLU_ABRINDO);
        return 1;
    }

    // abrir gps //
    if(clickedid == T_Celular_GPS[0])
   	{
   	    celular(playerid, C_GPS_ABRINDO);
        return 1;
    }

    // abrir ITAU //
    if(clickedid == T_Celular_Itau[0])
   	{
   	    celular(playerid, C_ITAU_ABRINDO);
        return 1;
    }

    // abrir SPOTFY //
    if(clickedid == T_Celular_Radio[0])
   	{
   	    celular(playerid, C_RADIO_ABRINDO);
        return 1;
    }

    // abrir blaze //
    if(clickedid == T_Celular_Blaze[0])
   	{
   	    celular(playerid, C_BLAZE_ABRINDO);
        return 1;
    }

    // abrir whatsapp //
    if(clickedid == T_Celular_WP[0])
   	{
   	    if(player_chip(playerid) == -1)
   	    {
   	    	format(str_aviso[playerid], 300, "Voce ainda nao tem um numero cadastrado, compre um chip na 24/7 mais proxima.");
	    	SetPVarInt(playerid, "aviso", C_INICIO);
	    	celular(playerid, C_ERRO);
   	        return 1;
   	    }
   	    celular(playerid, C_WP_ABRINDO);
        return 1;
    }

    // abrir olx //
    if(clickedid == T_Celular_OLX[0])
   	{
   	    if(player_chip(playerid) == -1)
   	    {
   	    	format(str_aviso[playerid], 300, "Voce ainda nao tem um chip cadastrado, compre um chip na 24/7 mais proxima.");
	    	SetPVarInt(playerid, "aviso", C_INICIO);
	    	celular(playerid, C_ERRO);
   	        return 1;
   	    }
   	    celular(playerid, C_OLX_ABRINDO);
        return 1;
    }
    ////////////////////////////////////////////////////////////////
    ///////////////////////// fim celular //////////////////////////
    ////////////////////////////////////////////////////////////////


    // entrar na conta //
    if(clickedid == T_Lobby[38])
    {
		if(GetPVarInt(playerid, "flod_entrar_conta") > gettime()) return 1;
        new cc = contas[playerid];
        if(cc > -1 && cc < MAX_CONTAS)
        {
	        new slot_ocupado = player_conta[contas[playerid]];
	        if(slot_ocupado != -1)
	        {
	        	if(Online(slot_ocupado) && id[slot_ocupado] == contas[playerid])
		        {
					ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}_", "\n{FF0000}[ERRO] {A1A1A1}Alguem ja esta nesta conta no momento !\n", "Ok", "Fechar");
	            	SetPVarInt(playerid, "flod_entrar_conta", gettime()+2);
					return 1;
		        }
		        player_conta[contas[playerid]] = -1;
	        }

	        if(GetContaInt(contas[playerid], "c_Tuto") == 0)
	        {
	            perguntar_tutorial(playerid);
	            SetPVarInt(playerid, "flod_entrar_conta", gettime()+2);
	            return 1;
	        }

			// entrar na conta //
            SetPVarInt(playerid, "flod_entrar_conta", gettime()+2);
	        carregar_conta_player(playerid, cc);
	        AddPlayerClass(Conta[playerid][c_Skin], 1154.2063,-1767.5226,16.5938, 90.0000, 0, 0, 0, 0, 0, 0);
			spawn_conta(playerid);
		}
        return 1;
    }

    // sair da conta //
    if(clickedid == T_Lobby[40])
    {
        id[playerid] = -1;
        logado[playerid] = 0;
        esconder_contas(playerid);
        PlayerSpawn(playerid);
		return 1;
    }

    // trocar senha //
    if(clickedid == T_Lobby[45])
    {
        abrir_trocar_senha(playerid, contas[playerid], 0);
    }

    // trocar fichas //
    if(clickedid == T_Lobby[27])
    {
        trocar_fichas(playerid);
        return 1;
    }

    // PLATAFORMA TEXTDRAW - CELULAR //
    if(clickedid == PlataformaTD[12])
    {
		CancelSelectTextDraw(playerid);
		for(new i; i < 27; i++) TextDrawHideForPlayer(playerid, PlataformaTD[i]);
		SetPVarInt(playerid, "NotAndroid", 0);
		if(logado[playerid] == 0)
		{
			KillTimer(timer_spawn_player[playerid]);
			timer_spawn_player[playerid] = SetTimerEx("PlayerSpawnAgora", 100, false, "d", playerid);
		}
        return 1;
    }

    // PLATAFORMA TEXTDRAW - COMPUTADOR //
    if(clickedid == PlataformaTD[13])
    {
		CancelSelectTextDraw(playerid);
		for(new i; i < 27; i++) TextDrawHideForPlayer(playerid, PlataformaTD[i]);
		SetPVarInt(playerid, "NotAndroid", 1);
		if(logado[playerid] == 0)
		{
			KillTimer(timer_spawn_player[playerid]);
			timer_spawn_player[playerid] = SetTimerEx("PlayerSpawnAgora", 100, false, "d", playerid);
		}
        return 1;
    }

    // PAINEL ORGS //
    if(PainelOrgsAberto[playerid])
    {
        if(clickedid == PainelOrgs[8])
        {
            fechar_painel_orgs(playerid);
            return 1;
        }
        if(clickedid == PainelOrgs[9])
        {
            CancelSelectTextDraw(playerid);
            comando(playerid, "/membros", "");
            fechar_painel_orgs(playerid);
            return 1;
        }
        if(clickedid == PainelOrgs[10])
        {
            CancelSelectTextDraw(playerid);
            comando(playerid, "/convidarorg", "");
            fechar_painel_orgs(playerid);
            return 1;
        }
        if(clickedid == PainelOrgs[11])
        {
            new orgg = OrgPlayer(playerid);
            if(orgg == -1) return 1;
            if(Conta[playerid][c_Cargo] < 6) return MS(playerid, 0, "Apenas o lider pode definir a skin da org !");
            fechar_painel_orgs(playerid);
            ShowPlayerDialog(playerid, DIALOG_SETAR_SKIN_ORG2, DIALOG_STYLE_INPUT, "{ffff00}Definir Skin da Org", "\n{ffffff}Digite o {00ffff}ID {ffffff}da {ffff00}skin {ffffff}que todos os membros usarao:\n", "Definir", "Cancelar");
            SetPVarInt(playerid, "definindo_skin_org", orgg);
            return 1;
        }
        if(clickedid == PainelOrgs[12])
        {
            CancelSelectTextDraw(playerid);
            comando(playerid, "/logsorg", "");
            fechar_painel_orgs(playerid);
            return 1;
        }
        if(clickedid == PainelOrgs[25])
        {
            new orgg = OrgPlayer(playerid);
            if(orgg == -1) return 1;
            if(Conta[playerid][c_Cargo] < 1) return MS(playerid, 0, "Voce nao tem cargo para usar a skin da org !");
            new skin_id = Org[orgg][o_Skins][Conta[playerid][c_Cargo]];
            if(skin_id < 0 || skin_id > 311) skin_id = Org[orgg][o_Skins][6];
            if(skin_id < 0 || skin_id > 311) return MS(playerid, 0, "Nenhuma skin definida para sua organizacao !");
            SetPlayerSkin(playerid, skin_id);
            Conta[playerid][c_Skin] = skin_id;
            salvar_conta(id[playerid], 0, "c_Skin", sv_int(skin_id));
            MS(playerid, 1, "Voce vestiu a skin da organizacao !");
            return 1;
        }
        if(clickedid == PainelOrgs[28])
        {
            CancelSelectTextDraw(playerid);
            comando(playerid, "/sairorg", "");
            fechar_painel_orgs(playerid);
            return 1;
        }
        if(clickedid == PainelOrgs[32])
        {
            new orgg = OrgPlayer(playerid);
            if(orgg == -1) return 1;
            new sss[800], titulo[100], count;
            strcat(sss, "\n");
            for(new a; a<MAX_TERRITORIOS; a++)
            {
                if(TR[a][tr_Existe] == 1 && TR[a][tr_Dono] == orgg)
                {
                    format(titulo, 100, "{ffffff}%s\n", TR[a][tr_Nome]);
                    strcat(sss, titulo);
                    count++;
                }
            }
            if(count == 0) MS(playerid, 0, "Sua organizacao nao possui territorios !");
            else ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{ffff00}Territorios da Organizacao", sss, "Ok", "Fechar");
            return 1;
        }
    }

	// FusionInv setas de armas //
	if(clickedid == FusionInv[67])
	{
		if(id_arma[playerid] != -1)
		{
			new maxa = GetPVarInt(playerid, "cont_armas");
			if(maxa > 0)
			{
				id_arma[playerid] --;
				if(id_arma[playerid] < 0) id_arma[playerid] = maxa-1;
				if(inv_novo_aberto[playerid] == 1) abrir_inv_novo(playerid);
				SelectTextDraw(playerid, 0xffff0080);
			}
		}
		return 1;
	}
	if(clickedid == FusionInv[66])
	{
		if(id_arma[playerid] != -1)
		{
			new maxa = GetPVarInt(playerid, "cont_armas");
			if(maxa > 0)
			{
				id_arma[playerid] ++;
				if(id_arma[playerid] >= maxa) id_arma[playerid] = 0;
				if(inv_novo_aberto[playerid] == 1) abrir_inv_novo(playerid);
				SelectTextDraw(playerid, 0xffff0080);
			}
		}
		return 1;
	}

	return 1;
}


public OnPlayerEditDynamicObject(playerid, objectid, response, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz)
{
    if(logado[playerid] == 0) return 1;
    editando[playerid] = 0;
    if(response == 1)
	{

	    // editando movel de uma casa //
	    if(EditandoMovel[playerid] != -1)
	    {
	        new i = GetPVarInt(playerid, "casa");
	        new a = EditandoMovel[playerid];
	        if(IsValidDynamicObject(objectid))
            {
                Casa[i][casa_m_X][a] = x;
                Casa[i][casa_m_Y][a] = y;
                Casa[i][casa_m_Z][a] = z;
                Casa[i][casa_m_RX][a] = rx;
                Casa[i][casa_m_RY][a] = ry;
                Casa[i][casa_m_RZ][a] = rz;
                atualizar_movel(i, a);
                salvar_casa(i);
                ms(playerid, 1, "A posicao do Movel foi salva com sucesso !");
                EditandoMovel[playerid] = -1;
                mostrar_moveis_na_casa(playerid, i, 1);
	        }
	        return 1;
	    }

	    // editando maquina de equipamentos //
	    if(EditandoMaquina[playerid] != -1)
	    {
	        new i = EditandoMaquina[playerid];
	        if(IsValidDynamicObject(objectid))
            {
                Maquina[i][m_X] = x;
	            Maquina[i][m_Y] = y;
	            Maquina[i][m_Z] = z;
	            Maquina[i][m_RX] = rx;
	            Maquina[i][m_RY] = ry;
	            Maquina[i][m_RZ] = rz;
                atualizar_maquina(i);
                salvar_maquina(i);
				ms(playerid, 1, "A posicao da Maquina de armamentos foi salva com sucesso !");
                EditandoMaquina[playerid] = -1;
            }
	        return 1;
	    }

	    // editando elevador //
	    if(EditandoElevador[playerid] != -1)
	    {
	        new i = EditandoElevador[playerid];
	        if(IsValidDynamicObject(objectid))
            {
                new a = andar_elevador[playerid];
                Elevador[i][ele_a_X][a] = x;
                Elevador[i][ele_a_Y][a] = y;
                Elevador[i][ele_a_Z][a] = z;
                Elevador[i][ele_a_A][a] = rz;
                atualizar_elevador(i);
                salvar_elevador(i);
				ms(playerid, 1, "A posicao do Elevador foi salva com sucesso !");
                EditandoElevador[playerid] = -1;
            }
	        return 1;
	    }

	    // editando cinuca //
		if(EditandoCinuca[playerid] != -1)
	    {
	        new i = EditandoCinuca[playerid];
	        if(IsValidDynamicObject(objectid))
            {
                Cinuca[i][ci_X] = x;
	            Cinuca[i][ci_Y] = y;
	            Cinuca[i][ci_Z] = z;
                atualizar_cinuca(i);
                salvar_cinuca(i);
				ms(playerid, 1, "A posicao da sinuca foi salva com sucesso !");
                EditandoCinuca[playerid] = -1;
            }
	        return 1;
	    }

	    // editando bau //
	    if(GetPVarInt(playerid, "edit_bau") >= 0)
	    {
	        new i = GetPVarInt(playerid, "edit_bau");
	        if(IsValidDynamicObject(objectid) && response == 1)
	        {
	            BauI[i][bau_X] = x;
	            BauI[i][bau_Y] = y;
	            BauI[i][bau_Z] = z;
	            atualizar_bau_item(i);
	            salvar_bau_item(i);
	            ms(playerid, 1, "Posicao do bau salva!");
	        }
	        SetPVarInt(playerid, "edit_bau", -1);
	        return 1;
	    }

		// editando camera de seguranca //
		if(EditandoCamera[playerid] != -1)
	    {
	        new i = EditandoCamera[playerid];
	        if(IsValidDynamicObject(objectid))
            {
                Camera[i][cam_X] = x;
	            Camera[i][cam_Y] = y;
	            Camera[i][cam_Z] = z;
	            Camera[i][cam_RX] = rx;
	            Camera[i][cam_RY] = ry;
	            Camera[i][cam_RZ] = rz;
                atualizar_camera(i);
                salvar_camera(i);
				ms(playerid, 1, "A posicao da Camera de Seguranca foi salva com sucesso !");
                EditandoCamera[playerid] = -1;
            }
	        return 1;
	    }

	    // editando radar de velocidade //
	    if(EditandoRadar[playerid] != -1)
	    {
	        new i = EditandoRadar[playerid];
	        if(IsValidDynamicObject(objectid))
            {
                Radar[i][radar_X] = x;
	            Radar[i][radar_Y] = y;
	            Radar[i][radar_Z] = z;
	            Radar[i][radar_RX] = rx;
	            Radar[i][radar_RY] = ry;
	            Radar[i][radar_RZ] = rz;
                atualizar_radar(i);
                salvar_radar(i);
				ms(playerid, 1, "A posicao do Radar de Velocidade foi salva com sucesso !");
                EditandoRadar[playerid] = -1;
            }
	        return 1;
	    }

	    // editando academia //
	    if(EditandoAcademia[playerid] != -1)
	    {
	        new i = EditandoAcademia[playerid];
	        if(IsValidDynamicObject(objectid))
            {
                Academia[i][aca_X] = x;
	            Academia[i][aca_Y] = y;
	            Academia[i][aca_Z] = z;
	            Academia[i][aca_RX] = rx;
	            Academia[i][aca_RY] = ry;
	            Academia[i][aca_RZ] = rz;
                atualizar_academia(i);
                salvar_academia(i);
				ms(playerid, 1, "A posicao do Aparelho de academia foi salva com sucesso !");
                EditandoAcademia[playerid] = -1;
            }
	        return 1;
	    }

	    // editando lanchonete //
	    if(EditandoLanchonete[playerid] != -1)
	    {
	        new i = EditandoLanchonete[playerid];
	        if(IsValidDynamicObject(objectid))
            {
                Lanche[i][la_X] = x;
	            Lanche[i][la_Y] = y;
	            Lanche[i][la_Z] = z;
	            Lanche[i][la_RX] = rx;
	            Lanche[i][la_RY] = ry;
	            Lanche[i][la_RZ] = rz;
                atualizar_lanchonete(i);
                salvar_lanchonete(i);
				ms(playerid, 1, "A posicao da Lanchonete foi salva com sucesso !");
                EditandoLanchonete[playerid] = -1;
            }
	        return 1;
	    }

	    // editando lixeiro //
	    if(EditandoLixeiro[playerid] != -1)
	    {
	        new i = EditandoLixeiro[playerid];
	        if(IsValidDynamicObject(objectid))
            {
                Lixeiro[i][li_X] = x;
	            Lixeiro[i][li_Y] = y;
	            Lixeiro[i][li_Z] = z;
	            Lixeiro[i][li_RX] = rx;
	            Lixeiro[i][li_RY] = ry;
	            Lixeiro[i][li_RZ] = rz;
                atualizar_lixeiro(i);
                salvar_lixeiro(i);
				ms(playerid, 1, "A posicao do Lixeiro foi salva com sucesso !");
                EditandoLixeiro[playerid] = -1;
            }
	        return 1;
	    }

	    // editando caixa eletronico //
	    if(EditandoCaixaEletronico[playerid] != -1)
	    {
	        new i = EditandoCaixaEletronico[playerid];
	        if(GetPVarInt(playerid, "caixa_camera") == 0)
	        {
		        if(IsValidDynamicObject(objectid))
	            {
	                CaixaEletronico[i][ce_X] = x;
		            CaixaEletronico[i][ce_Y] = y;
		            CaixaEletronico[i][ce_Z] = z;
		            CaixaEletronico[i][ce_RX] = rx;
		            CaixaEletronico[i][ce_RY] = ry;
		            CaixaEletronico[i][ce_RZ] = rz;
	                atualizar_caixa_eletronico(i);
	                salvar_caixa_eletronico(i);
					ms(playerid, 1, "A posicao do caixa eletronico foi salva com sucesso !");
	                EditandoCaixaEletronico[playerid] = -1;
	            }
            }

            if(GetPVarInt(playerid, "caixa_camera") == 1)
	        {
		        if(IsValidDynamicObject(objectid))
	            {
	                CaixaEletronico[i][cec_X] = x;
		            CaixaEletronico[i][cec_Y] = y;
		            CaixaEletronico[i][cec_Z] = z;
		            CaixaEletronico[i][cec_RX] = rx;
		            CaixaEletronico[i][cec_RY] = ry;
		            CaixaEletronico[i][cec_RZ] = rz;
	                atualizar_caixa_eletronico(i);
	                salvar_caixa_eletronico(i);
					ms(playerid, 1, "A posicao da camera do caixa eletronico foi salva com sucesso !");
	                EditandoCaixaEletronico[playerid] = -1;
	            }
            }
	        return 1;
	    }

	    // editando portao //
	    if(EditandoPortao[playerid] != -1)
	    {
	        new i = EditandoPortao[playerid];
	        if(IsValidDynamicObject(objectid))
            {
                if(GetPVarInt(playerid, "editando_portao") == 0)
                {
	                Portao[i][p_X1] = x;
		            Portao[i][p_Y1] = y;
		            Portao[i][p_Z1] = z;
		            Portao[i][p_RX1] = rx;
		            Portao[i][p_RY1] = ry;
		            Portao[i][p_RZ1] = rz;
	                atualizar_portao(i);
	                salvar_portao(i);
					ms(playerid, 1, "A posicao do portao FECHADO foi salva com sucesso !");
				}
				else if(GetPVarInt(playerid, "editando_portao") == 1)
                {
	                Portao[i][p_X2] = x;
		            Portao[i][p_Y2] = y;
		            Portao[i][p_Z2] = z;
		            Portao[i][p_RX2] = rx;
		            Portao[i][p_RY2] = ry;
		            Portao[i][p_RZ2] = rz;
	                atualizar_portao(i);
	                salvar_portao(i);
					ms(playerid, 1, "A posicao do portao ABERTO foi salva com sucesso !");
				}
            }
	        EditandoPortao[playerid] = -1;
	        return 1;
		}

	    // editando objeto //
	    if(EditandoObjeto[playerid] != -1)
	    {
	        new i = EditandoObjeto[playerid];
	        if(IsValidDynamicObject(objectid))
            {
                Objeto[i][o_X] = x;
	            Objeto[i][o_Y] = y;
	            Objeto[i][o_Z] = z;
	            Objeto[i][o_RX] = rx;
	            Objeto[i][o_RY] = ry;
	            Objeto[i][o_RZ] = rz;
                atualizar_objeto(i);
                salvar_objeto(i);
				ms(playerid, 1, "Posicao do objeto salva com sucesso !");
            }
	        EditandoObjeto[playerid] = -1;
	        return 1;
		}

		// editando arvore //
	    if(EditandoArvore[playerid] != -1)
	    {
	        new i = EditandoArvore[playerid];
	        if(IsValidDynamicObject(objectid))
            {
                Arvore[i][ar_X] = x;
	            Arvore[i][ar_Y] = y;
	            Arvore[i][ar_Z] = z;
	            Arvore[i][ar_A] = rz;
                AtualizarArvore(i);
                salvar_arvore(i);
				ms(playerid, 1, "A posicao da arvore foi salva com sucesso !");
            }
	        EditandoArvore[playerid] = -1;
	        return 1;
		}

		// editando pedra //
	    if(EditandoPedra[playerid] != -1)
	    {
	        new i = EditandoPedra[playerid];
	        if(IsValidDynamicObject(objectid))
            {
                Pedra[i][pe_X] = x;
	            Pedra[i][pe_Y] = y;
	            Pedra[i][pe_Z] = z;
	            Pedra[i][pe_A] = rz;
                AtualizarPedra(i);
                salvar_pedra(i);
				ms(playerid, 1, "A posicao da pedra foi salva com sucesso !");
            }
	        EditandoPedra[playerid] = -1;
	        return 1;
		}

		// editando texto criado por admin //
	    if(EditandoTexto[playerid] != -1)
		{
		    new texto = EditandoTexto[playerid];
		    if(IsValidDynamicObject(objectid))
		    {
		        Texto[texto][textoX] = x;
	        	Texto[texto][textoY] = y;
	        	Texto[texto][textoZ] = z;
	        	Texto[texto][textoRX] = rx;
	        	Texto[texto][textoRY] = ry;
	        	Texto[texto][textoRZ] = rz;
		        atualizar_texto(texto);
		        salvar_texto(texto);
		        ms(playerid, 1, "Voc? editou a posi??o desse Texto e ele foi salvo neste local");
				ms(playerid, 1, "Voc? pode ver os comandos de textos com /ajudatextos");
			}
			EditandoTexto[playerid] = -1;
			return 1;
		}


	    return 1;
	}


	if(response == 0)
	{
	    // editando movel de uma casa //
	    if(EditandoMovel[playerid] != -1)
	    {
	        new i = GetPVarInt(playerid, "casa");
	        new a = EditandoMovel[playerid];
	        ms(playerid, 1, "Edicao cancelada, a posicao nao foi alterada !");
	        atualizar_movel(i, a);
	        salvar_casa(i);
	        EditandoMovel[playerid] = -1;
            mostrar_moveis_na_casa(playerid, i, 1);
	        return 1;
	    }


	    // editando maquina de armamentos //
        if(EditandoMaquina[playerid] != -1)
	    {
	        new i = EditandoMaquina[playerid];
            atualizar_maquina(i);
            salvar_maquina(i);
			ms(playerid, 1, "Edicao cancelada, a posicao nao foi alterada !");
			EditandoMaquina[playerid] = -1;
	        return 1;
	    }

	    // editando camera de seguranca //
        if(EditandoCamera[playerid] != -1)
	    {
	        new i = EditandoCamera[playerid];
            atualizar_camera(i);
            salvar_camera(i);
			ms(playerid, 1, "Edicao cancelada, a posicao nao foi alterada !");
			EditandoCamera[playerid] = -1;
	        return 1;
	    }

	    // editando cinuca //
        if(EditandoCinuca[playerid] != -1)
	    {
	        new i = EditandoCinuca[playerid];
            atualizar_cinuca(i);
            salvar_cinuca(i);
			ms(playerid, 1, "Edicao cancelada, a posicao nao foi alterada !");
			EditandoCinuca[playerid] = -1;
	        return 1;
	    }

	    // editando radar de velocidade //
        if(EditandoRadar[playerid] != -1)
	    {
	        new i = EditandoRadar[playerid];
            atualizar_radar(i);
            salvar_radar(i);
			ms(playerid, 1, "Edicao cancelada, a posicao nao foi alterada !");
			EditandoRadar[playerid] = -1;
	        return 1;
	    }

		// editando academia //
        if(EditandoAcademia[playerid] != -1)
	    {
	        new i = EditandoAcademia[playerid];
            atualizar_academia(i);
            salvar_academia(i);
			ms(playerid, 1, "Edicao cancelada, a posicao nao foi alterada !");
			EditandoAcademia[playerid] = -1;
	        return 1;
	    }

	    // editando lanchonete //
        if(EditandoLanchonete[playerid] != -1)
	    {
	        new i = EditandoLanchonete[playerid];
            atualizar_lanchonete(i);
            salvar_lanchonete(i);
			ms(playerid, 1, "Edicao cancelada, a posicao nao foi alterada !");
			EditandoLanchonete[playerid] = -1;
	        return 1;
	    }

	    // editando lixeiro //
        if(EditandoLixeiro[playerid] != -1)
	    {
	        new i = EditandoLixeiro[playerid];
            atualizar_lixeiro(i);
            salvar_lixeiro(i);
			ms(playerid, 1, "Edicao cancelada, a posicao nao foi alterada !");
			EditandoLixeiro[playerid] = -1;
	        return 1;
	    }

	    // editando caixa eletronico //
        if(EditandoCaixaEletronico[playerid] != -1)
	    {
	        new i = EditandoCaixaEletronico[playerid];
            atualizar_caixa_eletronico(i);
            salvar_caixa_eletronico(i);
			ms(playerid, 1, "Edicao cancelada, a posicao nao foi alterada !");
			EditandoCaixaEletronico[playerid] = -1;
	        return 1;
	    }

        // editando portao //
	    if(EditandoPortao[playerid] != -1)
	    {
	        new i = EditandoPortao[playerid];
			atualizar_portao(i);
			salvar_portao(i);
			ms(playerid, 1, "Edicao cancelada, a posicao nao foi alterada !");
	        EditandoPortao[playerid] = -1;
		}

        // editando objeto //
	    if(EditandoObjeto[playerid] != -1)
	    {
	        new i = EditandoObjeto[playerid];
			atualizar_objeto(i);
			salvar_objeto(i);
			ms(playerid, 1, "Edicao cancelada, a posicao nao foi alterada !");
	        EditandoObjeto[playerid] = -1;
		}

        // editando pedra //
	    if(EditandoPedra[playerid] != -1)
	    {
			new i = EditandoPedra[playerid];
            AtualizarPedra(i);
            salvar_pedra(i);
			ms(playerid, 1, "Edicao cancelada, a posicao nao foi alterada !");
	        EditandoPedra[playerid] = -1;
	        return 1;
		}


		// editando arvore //
	    if(EditandoArvore[playerid] != -1)
	    {
			new i = EditandoArvore[playerid];
            AtualizarArvore(i);
            salvar_arvore(i);
			ms(playerid, 1, "Edicao cancelada, a posicao nao foi alterada !");
	        EditandoArvore[playerid] = -1;
	        return 1;
		}

        // editando texto criado por admin //
		if(EditandoTexto[playerid] != -1)
		{
		    new texto = EditandoTexto[playerid];
		    if(objectid != Texto[texto][textoObj])
		    {
	        	atualizar_texto(texto);
		        salvar_texto(texto);
		        ms(playerid, 2, "Voc? apertou ESC, e o Texto continua no mesmo lugar salvo da ultima vez");
				ms(playerid, 2, "Voc? pode ver os comandos de textos com /ajudatextos");
			}
			EditandoTexto[playerid] = -1;
			return 1;
		}

		return 1;
	}

	return 1;
}


stock fileLog(const file[], const string[])
{
    new data[350], File:hFile, thefile[60];
    format(data, sizeof(data), "%s\r\n",string);
    format(thefile, sizeof(thefile), "%s.txt", file);
    hFile = fopen(thefile, io_append);
    fwrite(hFile, data);
    fclose(hFile);
}


public OnPlayerEditAttachedObject(playerid, response, index, modelid, boneid, Float:fOffsetX, Float:fOffsetY, Float:fOffsetZ, Float:fRotX, Float:fRotY, Float:fRotZ, Float:fScaleX, Float:fScaleY, Float:fScaleZ)
{
    editando[playerid] = 0;
	OnPlayerEditAttachedObjectEx_x(playerid, response, index, modelid, boneid, fOffsetX, fOffsetY, fOffsetZ, fRotX, fRotY, fRotZ, fScaleX, fScaleY, fScaleZ);
	return 1;
}


stock OnPlayerEditAttachedObjectEx_x(playerid, response, index, modelid, boneid, Float:fOffsetX, Float:fOffsetY, Float:fOffsetZ, Float:fRotX, Float:fRotY, Float:fRotZ, Float:fScaleX, Float:fScaleY, Float:fScaleZ)
{
    if(logado[playerid] == 0) return 1;
    if(response == 1)
    {
        // sistema de acessorios //
		if(EditandoAcessorio[playerid] != -1)
		{
		    new w = EditandoAcessorio[playerid];
		    new c = id[playerid];
		    if(c != -1)
		    {
		        Acessorios[playerid][w][ac_X] = fOffsetX;
		        Acessorios[playerid][w][ac_Y] = fOffsetY;
		        Acessorios[playerid][w][ac_Z] = fOffsetZ;
		        Acessorios[playerid][w][ac_RX] = fRotX;
		        Acessorios[playerid][w][ac_RY] = fRotY;
		        Acessorios[playerid][w][ac_RZ] = fRotZ;
		        Acessorios[playerid][w][ac_TX] = fScaleX;
		        Acessorios[playerid][w][ac_TY] = fScaleY;
		        Acessorios[playerid][w][ac_TZ] = fScaleZ;
				ms(playerid, 1, "A posicao do acessorio foi salva com sucesso !");
				salvar_acessorios(playerid, c);
				acessorios_player(playerid);
				mostrar_opcoes_acessorio(playerid, w);
		    }
		    EditandoAcessorio[playerid] = -1;
		    return 1;
		}

        // Salva a posicao final do acessorio no slot 9.
		if(index == 9)
		{
		    new SSS[600];
			format(SSS, 600, "%d, %d, %d, %f, %f, %f, %f, %f, %f, %f, %f, %f",modelid, index, boneid, fOffsetX, fOffsetY, fOffsetZ, fRotX, fRotY, fRotZ, fScaleX, fScaleY, fScaleZ);
			fileLog("PosicaoSalva", SSS);
			return 1;
		}

		return 1;
	}


	if(response == 0)
	{
	    if(EditandoAcessorio[playerid] != -1)
		{
		    new w = EditandoAcessorio[playerid];
		    new c = id[playerid];
		    if(c != -1)
		    {
				acessorios_player(playerid);
				ms(playerid, 1, "A edicao foi cancelada, o acessorio voltou a posicao anterior !");
				salvar_acessorios(playerid, c);
				mostrar_opcoes_acessorio(playerid, w);
		    }
			EditandoAcessorio[playerid] = -1;
		    return 1;
		}



	    return 1;
	}


	return 1;
}

public OnPlayerClickMap(playerid, Float:fX, Float:fY, Float:fZ)
{
    if(logado[playerid] == 0) return 1;
	if(ModoAdmin[playerid] == 1)
	{
	    if(AdminPlayer(playerid) >= 2)
	    {
    		if(!IsPlayerInAnyVehicle(playerid))
			{
				SetPlayerPos_(playerid, fX+0.1, fY+0.1, fZ+1);
				SetPlayerInterior(playerid, 0);
				SetPlayerVirtualWorld_(playerid, 0);
			}
			else
			{
    			SetVehiclePos(GetPlayerVehicleID(playerid), fX, fY, fZ+1);
    			LinkVehicleToInterior(GetPlayerVehicleID(playerid), 0);
    			SetVehicleVirtualWorld(GetPlayerVehicleID(playerid), 0);
    		}
    	}
    }
    return 1;
}


public OnPlayerClickPlayer(playerid, clickedplayerid, source)
{
    if(logado[playerid] == 0) return 1;
	new i = clickedplayerid;
	if(!Online(i)) return ms(playerid, 0, "O jogador nao esta mais Online !");
	if(id[i] == -1) return ms(playerid, 0, "Este jogador nao esta em uma conta !");



	return 1;
}


