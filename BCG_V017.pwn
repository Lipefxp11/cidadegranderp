stock ubers()
{
	new cont;
	foreach(new i:Player)
	{
	    if(Online(i))
	    {
		    if(EmpregoPlayer(i) == 1)
		    {
		        if(Uber[i][uber_Motorista] == -1)
		        {
		            cont++;
		        }
		    }
	    }
	}
	return cont;
}

stock corrida_uber(playerid)
{
	new sss[300];
    if(Uber[playerid][uber_Destino] == -1 || Uber[playerid][uber_Cidade] == -1)
    {
     	format(str_aviso[playerid], 300, "Voce ainda nao escolheu o Destino da Corrida !");
	    SetPVarInt(playerid, "aviso", C_UBER_CLIENTE);
	    celular(playerid, C_ERRO);
    }
    else if(Uber[playerid][uber_Status] != 0)
    {
     	format(str_aviso[playerid], 300, "Voce ja tem uma corrida em andamento no momento !");
	    SetPVarInt(playerid, "aviso", C_UBER_CLIENTE);
	    celular(playerid, C_ERRO);
    }
    else if(ubers() == 0)
    {
		format(str_aviso[playerid], 300, "Nenhum motorista disponivel no momento ! Tente mais tarde.");
		SetPVarInt(playerid, "aviso", C_UBER_CLIENTE);
	    celular(playerid, C_ERRO);
    }
    else if(GranaPlayer(playerid) < Uber[playerid][uber_Valor])
    {
        format(str_aviso[playerid], 300, "Voce nao tem R$ %s para pagar a corrida de Uber !", ConvertMoney(Uber[playerid][uber_Valor]));
        SetPVarInt(playerid, "aviso", C_UBER_CLIENTE);
	    celular(playerid, C_ERRO);
    }
    else if(GetPVarInt(playerid, "flood_uber") > gettime())
    {
        format(str_aviso[playerid], 300, "Voce so pode chamar um Uber a cada 1 minuto, aguarde e tente novamente !");
        SetPVarInt(playerid, "aviso", C_UBER_CLIENTE);
	    celular(playerid, C_ERRO);
    }
    else
    {

	    Uber[playerid][uber_Status] = 1;
	    Uber[playerid][uber_Tempo] = 60;
		SetPVarInt(playerid, "flood_uber", gettime()+60);
		format(sss, 300, "O Jogador '%s' acabou de chamar um uber, Valor R$: %s. Confira o aplicativo da Uber.", Nome(playerid), ConvertMoney(Uber[playerid][uber_Valor]));

		foreach(new a:Player)
		{
		    if(a != playerid)
		    {
			    if(Online(a))
				{
				if(EmpregoPlayer(a) == 1)
				{
				    if(Uber[a][uber_Motorista] == -1)
					{
				        ms(a, 3, sss);
						}
				}
				}
			}
		}

		format(str_aviso[playerid], 300, "Voce chamou um motorista, aguarde.~n~~n~Se voce cancelar a corrida antes de 1 Minuto sera cobrada a taxa de 50%% do valor da corrida !");
	    SetPVarInt(playerid, "aviso", C_UBER_CLIENTE);
	    celular(playerid, C_INFO);
	}
}

stock cancelar_corrida(playerid, con=0, pla=-1)
{

	if(con == 2)
	{
	    format(str_aviso[playerid], 300, "Voce cancelou a corrida, e a Uber lhe cobrou a metade do valor como taxa !");
        SetPVarInt(playerid, "aviso", C_UBER);
	    celular(playerid, C_INFO);
	    DarGrana(playerid, -(Uber[pla][uber_Valor]/2));
	    cancelar_uber(playerid, 1);
	    cancelar_uber(pla, 1);
	    if(celular_aberto[pla] == C_UBER_CLIENTE) celular(pla, C_UBER_CLIENTE);
	}
	else
	{
		Uber[playerid][uber_Status] = 0;
		if(con == 1)
		{
	        if(id[playerid] != -1)
			{
				format(str_aviso[playerid], 300, "Voce cancelou a corrida antes de 1 minuto e foi cobrado a metade do valor !");
		        SetPVarInt(playerid, "aviso", C_UBER_CLIENTE);
			    celular(playerid, C_INFO);
			    DarGrana(playerid, -(Uber[playerid][uber_Valor]/2));
			    if(celular_aberto[playerid] == C_UBER_CLIENTE) celular(playerid, C_UBER_CLIENTE);
			}
		}
		else
		{
	        if(id[playerid] != -1)
			{
				if(celular_aberto[playerid] != -1)
				{
					format(str_aviso[playerid], 300, "Nenhum motorista aceitou a corrida dentro de 1 minuto, tente novamente !");
				SetPVarInt(playerid, "aviso", C_UBER_CLIENTE);
				    celular(playerid, C_INFO);
				}
				else ms(playerid, 0, "Nenhum motorista aceitou a corrida dentro de 1 minuto, tente novamente !");
			}
		}
	}
}

stock ViagemUber(playerid)
{
	new idd = id[playerid];
	if(idd != -1)
	{
		foreach(new i:Player)
		{
			if(Online(i))
			{
				if(id[i] != -1)
				{
					if(Uber[i][uber_Motorista] == playerid)
					{
					    return i;
					}
				}
			}
		}
	}
	return -1;
}

stock lista_de_clientes(playerid)
{
    format(Titulo_DC[playerid], 100, "PEDIDOS DE UBER");
    new cont;
    Lista_DC[playerid][0][cel_ID] = -1;
    foreach(new i:Player)
    {
        if(i != playerid)
        {
            if(Online(i))
            {
                if(id[i] != -1)
                {
                    if(Uber[i][uber_Status] == 1)
	    			{
	                    format(Lista_DC[playerid][cont][cel_Nome], 100, "~w~~h~%s ~g~~h~R$ %s", Nome(i), ConvertMoney(Uber[i][uber_Valor]));
	                    Lista_DC[playerid][cont][cel_ID] = i;
	                    cont ++;
					}
                }
            }
        }
    }
	if(cont == 0) Item_DC[playerid] = -1;
	else if(ID_DC[playerid] != ACEITAR_CORRIDA) Item_DC[playerid] = 0;
    MAX_DC[playerid] = cont;
    ID_DC[playerid] = ACEITAR_CORRIDA;
	Pagina_DC[playerid] = 0;
	celular(playerid, C_LISTA);
}

BCG:: TimerCelular(playerid, con)
{
    KillTimer(timer_celular[playerid]);
    celular(playerid, con);
}

stock celular(playerid, con=-1)
{

	new sss[300];
	KillTimer(timer_celular[playerid]);
	SelectTextDraw(playerid, 0xffffff50);

	//////////////////////////////////////////////////////////////////////////////////////////////
	/////////////////////////////////////// ABRIR CELULAR ////////////////////////////////////////
	//////////////////////////////////////////////////////////////////////////////////////////////

    if(con == -20)
	{
		format(sss, 300, "%02d/%02d/%04d", DIA, MES, ANO);
		PlayerTextDrawSetString(playerid, T_Celular_p[playerid][0], sss);
		format(sss, 300, "%02d:%02d", HORA, MINUTO);
		PlayerTextDrawSetString(playerid, T_Celular_p[playerid][1], sss);
	    for(new a; a<sizeof T_Celular; a++) TextDrawShowForPlayer(playerid, T_Celular[a]);
		for(new z; z<2; z++) PlayerTextDrawShow(playerid, T_Celular_p[playerid][z]);
		SelectTextDraw(playerid, 0xffffff50);
		PlayerPlaySound(playerid, 1053, 0, 0, 0);
		if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER && GetPlayerState(playerid) != PLAYER_STATE_PASSENGER){
		    if(ID_Dancando[playerid] == -1 && em_anim[playerid] == 0){
				ApplyAnimation(playerid, "CASINO", "CARDS_LOOP", 4.1, true, false, false, false, 0, 1);
			}
		}
		SetPlayerAttachedObject(playerid, 9, 18868, 5, 0.122000, 0.038999, -0.018999, -164.900283, -27.800001, -43.300010, 1.000000, 1.000000, 1.000000);
	    return 1;
	}

	if(con == -10)
	{
		format(sss, 300, "%02d/%02d/%04d", DIA, MES, ANO);
		PlayerTextDrawSetString(playerid, T_Celular_p[playerid][0], sss);
		format(sss, 300, "%02d:%02d", HORA, MINUTO);
		PlayerTextDrawSetString(playerid, T_Celular_p[playerid][1], sss);
	    for(new a; a<sizeof T_Celular; a++) TextDrawShowForPlayer(playerid, T_Celular[a]);
		for(new z; z<2; z++) PlayerTextDrawShow(playerid, T_Celular_p[playerid][z]);
		celular(playerid, C_INV);
		SelectTextDraw(playerid, 0xffffff50);
		PlayerPlaySound(playerid, 1053, 0, 0, 0);
		if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER && GetPlayerState(playerid) != PLAYER_STATE_PASSENGER){
            ApplyAnimation(playerid, "CASINO", "CARDS_LOOP", 4.1, true, false, false, false, 0, 1);
        }
		SetPlayerAttachedObject(playerid, 9, 18868, 5, 0.122000, 0.038999, -0.018999, -164.900283, -27.800001, -43.300010, 1.000000, 1.000000, 1.000000);
	    return 1;
	}


	if(con == -1)
	{
	    format(sss, 300, "%02d/%02d/%04d", DIA, MES, ANO);
		PlayerTextDrawSetString(playerid, T_Celular_p[playerid][0], sss);
		format(sss, 300, "%02d:%02d", HORA, MINUTO);
		PlayerTextDrawSetString(playerid, T_Celular_p[playerid][1], sss);
	    for(new a; a<sizeof T_Celular; a++) TextDrawShowForPlayer(playerid, T_Celular[a]);
	    TextDrawShowForPlayer(playerid, T_Celular_Barra[0]);
	    TextDrawShowForPlayer(playerid, T_Celular_Barra[1]);
	    TextDrawHideForPlayer(playerid, T_Celular_Barra[2]);
	    TextDrawHideForPlayer(playerid, T_Celular_Barra[3]);
	    TextDrawShowForPlayer(playerid, T_Celular_Barra[4]);
	    TextDrawShowForPlayer(playerid, T_Celular_Barra[5]);
	    if(pagina_barra[playerid] == 0) TextDrawShowForPlayer(playerid, T_Celular_Barra[2]);
	    if(pagina_barra[playerid] == 1) TextDrawShowForPlayer(playerid, T_Celular_Barra[3]);
		for(new z; z<2; z++) PlayerTextDrawShow(playerid, T_Celular_p[playerid][z]);
		celular(playerid, C_INICIO);
		SelectTextDraw(playerid, 0xffffff50);
		PlayerPlaySound(playerid, 1053, 0, 0, 0);
		if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER && GetPlayerState(playerid) != PLAYER_STATE_PASSENGER){
            ApplyAnimation(playerid, "CASINO", "CARDS_LOOP", 4.1, true, false, false, false, 0, 1);
        }
		SetPlayerAttachedObject(playerid, 9, 18868, 5, 0.122000, 0.038999, -0.018999, -164.900283, -27.800001, -43.300010, 1.000000, 1.000000, 1.000000);
        esconder_hud(playerid);
        esconder_logomarca(playerid);
		return 1;
	}

	if(con == -100)
	{
	    format(sss, 300, "%02d/%02d/%04d", DIA, MES, ANO);
		PlayerTextDrawSetString(playerid, T_Celular_p[playerid][0], sss);
		format(sss, 300, "%02d:%02d", HORA, MINUTO);
		PlayerTextDrawSetString(playerid, T_Celular_p[playerid][1], sss);
	    for(new a; a<sizeof T_Celular; a++) TextDrawShowForPlayer(playerid, T_Celular[a]);
	    TextDrawShowForPlayer(playerid, T_Celular_Barra[0]);
	    TextDrawShowForPlayer(playerid, T_Celular_Barra[1]);
	    TextDrawHideForPlayer(playerid, T_Celular_Barra[2]);
	    TextDrawHideForPlayer(playerid, T_Celular_Barra[3]);
	    TextDrawShowForPlayer(playerid, T_Celular_Barra[4]);
	    TextDrawShowForPlayer(playerid, T_Celular_Barra[5]);
	    if(pagina_barra[playerid] == 0) TextDrawShowForPlayer(playerid, T_Celular_Barra[2]);
	    if(pagina_barra[playerid] == 1) TextDrawShowForPlayer(playerid, T_Celular_Barra[3]);
		for(new z; z<2; z++) PlayerTextDrawShow(playerid, T_Celular_p[playerid][z]);
		SelectTextDraw(playerid, 0xffffff50);
		PlayerPlaySound(playerid, 1053, 0, 0, 0);
		if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER && GetPlayerState(playerid) != PLAYER_STATE_PASSENGER){
            ApplyAnimation(playerid, "CASINO", "CARDS_LOOP", 4.1, true, false, false, false, 0, 1);
        }
		SetPlayerAttachedObject(playerid, 9, 18868, 5, 0.122000, 0.038999, -0.018999, -164.900283, -27.800001, -43.300010, 1.000000, 1.000000, 1.000000);
        esconder_hud(playerid);
        esconder_logomarca(playerid);
		return 1;
	}

	//////////////////////////////////////////////////////////////////////////////////////////////
	//////////////////////////////// FECHAR OQUE ESTIVER ABERTO //////////////////////////////////
	//////////////////////////////////////////////////////////////////////////////////////////////


	//// FECHAR LISTA DO CELULAR ////
	if(celular_aberto[playerid] == C_LISTA)
	{
	    for(new a; a<12; a++) PlayerTextDrawHide(playerid, T_Celular_Lista_p[playerid][a]);
		TextDrawHideForPlayer(playerid, T_Celular_Lista[0]);
		TextDrawHideForPlayer(playerid, T_Celular_Lista[1]);
		TextDrawHideForPlayer(playerid, T_Celular_Lista[2]);
	}

	//// FECHAR NUMERO DO CELULAR ////
	if(celular_aberto[playerid] == C_NUMERO)
	{
	    PlayerTextDrawHide(playerid, T_Celular_Numero_p[playerid][0]);
	    PlayerTextDrawHide(playerid, T_Celular_Numero_p[playerid][1]);
		for(new aa; aa<sizeof T_Celular_Numero; aa++) TextDrawHideForPlayer(playerid, T_Celular_Numero[aa]);
	}

	//// FECHAR TELA DE ERRO ////
	if(celular_aberto[playerid] == C_ERRO)
	{
	    for(new a; a<sizeof T_Celular_Erro; a++) TextDrawHideForPlayer(playerid, T_Celular_Erro[a]);
	    PlayerTextDrawHide(playerid, T_Celular_Erro_p[playerid][0]);
	}

	//// FECHAR TELA DE INFO ////
	if(celular_aberto[playerid] == C_INFO)
	{
	    for(new a; a<sizeof T_Celular_Erro; a++) TextDrawHideForPlayer(playerid, T_Celular_Erro[a]);
	    PlayerTextDrawHide(playerid, T_Celular_Erro_p[playerid][0]);
	}

	//// FECHAR TELA COM APLICATIVOS ////
	if(celular_aberto[playerid] == C_INICIO)
    {
        for(new b; b<sizeof T_Celular_SOS; b++) TextDrawHideForPlayer(playerid, T_Celular_SOS[b]);
        for(new a; a<sizeof T_Celular_CAIXA; a++) TextDrawHideForPlayer(playerid, T_Celular_CAIXA[a]);
		for(new c; c<sizeof T_Celular_CARTEIRA; c++) TextDrawHideForPlayer(playerid, T_Celular_CARTEIRA[c]);
		for(new d; d<sizeof T_Celular_DETRAN; d++) TextDrawHideForPlayer(playerid, T_Celular_DETRAN[d]);
		for(new b; b<sizeof T_Celular_Uber; b++) TextDrawHideForPlayer(playerid, T_Celular_Uber[b]);
	    for(new c; c<sizeof T_Celular_GPS; c++) TextDrawHideForPlayer(playerid, T_Celular_GPS[c]);
	    for(new d; d<sizeof T_Celular_Itau; d++) TextDrawHideForPlayer(playerid, T_Celular_Itau[d]);
	    for(new e; e<sizeof T_Celular_Radio; e++) TextDrawHideForPlayer(playerid, T_Celular_Radio[e]);
	    for(new e; e<sizeof T_Celular_Blaze; e++) TextDrawHideForPlayer(playerid, T_Celular_Blaze[e]);
	    for(new g; g<sizeof T_Celular_Blu; g++) TextDrawHideForPlayer(playerid, T_Celular_Blu[g]);
	    for(new h; h<sizeof T_Celular_WP; h++) TextDrawHideForPlayer(playerid, T_Celular_WP[h]);
	    for(new i; i<sizeof T_Celular_OLX; i++) TextDrawHideForPlayer(playerid, T_Celular_OLX[i]);

		// pagina 3 //
		for(new z; z<sizeof T_Celular_Clima; z++) TextDrawHideForPlayer(playerid, T_Celular_Clima[z]);

		// esconder barra //
        for(new z; z<sizeof T_Celular_Barra; z++) TextDrawHideForPlayer(playerid, T_Celular_Barra[z]);
    }

    //// FECHAR APLICATIVO DA UBER ////
    if(celular_aberto[playerid] == C_UBER_ABRINDO)
    {
        for(new b; b<sizeof T_Celular_Uber_Carregando; b++) TextDrawHideForPlayer(playerid, T_Celular_Uber_Carregando[b]);
    }
    if(celular_aberto[playerid] == C_UBER)
    {
        for(new b; b<sizeof T_Celular_Uber_Opcoes; b++) TextDrawHideForPlayer(playerid, T_Celular_Uber_Opcoes[b]);
    }
    if(celular_aberto[playerid] == C_UBER_CLIENTE)
    {
        for(new b; b<sizeof T_Celular_Uber_Cliente; b++) TextDrawHideForPlayer(playerid, T_Celular_Uber_Cliente[b]);
        for(new c; c<6; c++) PlayerTextDrawHide(playerid, T_Celular_Uber_Cliente_p[playerid][c]);
    }
    if(celular_aberto[playerid] == C_UBER_MOTORISTA)
    {
        for(new b; b<sizeof T_Celular_Uber_Motorista; b++) TextDrawHideForPlayer(playerid, T_Celular_Uber_Motorista[b]);
    }
    if(celular_aberto[playerid] == C_UBER_VIAGEM)
    {
        for(new b; b<sizeof T_Celular_Uber_Viagem; b++) TextDrawHideForPlayer(playerid, T_Celular_Uber_Viagem[b]);
        for(new c; c<5; c++) PlayerTextDrawHide(playerid, T_Celular_Uber_Viagem_p[playerid][c]);
    }

    //// FECHAR APLICATIVO DO GPS ////
    if(celular_aberto[playerid] == C_GPS_ABRINDO)
    {
        for(new c; c<sizeof T_Celular_GPS_Carregando; c++) TextDrawHideForPlayer(playerid, T_Celular_GPS_Carregando[c]);
    }
    if(celular_aberto[playerid] == C_GPS)
    {
        for(new d; d<sizeof T_Celular_GPS_APK; d++) TextDrawHideForPlayer(playerid, T_Celular_GPS_APK[d]);
        for(new c; c<4; c++) PlayerTextDrawHide(playerid, T_Celular_GPS_APK_p[playerid][c]);
    }


    //// FECHAR APLICATIVO DO ITAU ////
    if(celular_aberto[playerid] == C_ITAU_ABRINDO)
    {
        for(new d; d<sizeof T_Celular_Itau_Carregando; d++) TextDrawHideForPlayer(playerid, T_Celular_Itau_Carregando[d]);
    }
    if(celular_aberto[playerid] == C_ITAU)
    {
        for(new w; w<sizeof T_Celular_Itau_APK; w++) TextDrawHideForPlayer(playerid, T_Celular_Itau_APK[w]);
        PlayerTextDrawHide(playerid, T_Celular_Itau_APK_p[playerid][0]);
        PlayerTextDrawHide(playerid, T_Celular_Itau_APK_p[playerid][1]);
    }


    //// FECHAR APLICATIVO DO SPOTFY ////
    if(celular_aberto[playerid] == C_RADIO_ABRINDO)
    {
        for(new e; e<sizeof T_Celular_Radio_Carregando; e++) TextDrawHideForPlayer(playerid, T_Celular_Radio_Carregando[e]);
    }
    if(celular_aberto[playerid] == C_RADIO)
    {
        for(new e; e<sizeof T_Celular_Radio_APK; e++) TextDrawHideForPlayer(playerid, T_Celular_Radio_APK[e]);
		for(new ee; ee<2; ee++) PlayerTextDrawHide(playerid, T_Celular_Radio_APK_p[playerid][ee]);
    }

    //// FECHAR APLICATIVO Da BLAZE ////
    if(celular_aberto[playerid] == C_BLAZE_ABRINDO)
    {
        for(new e; e<sizeof T_Celular_Blaze_Carregando; e++) TextDrawHideForPlayer(playerid, T_Celular_Blaze_Carregando[e]);
    }
    if(celular_aberto[playerid] == C_BLAZE)
    {
        for(new e; e<sizeof T_Celular_Blaze_APK; e++) TextDrawHideForPlayer(playerid, T_Celular_Blaze_APK[e]);
		PlayerTextDrawHide(playerid, T_Celular_Blaze_APK_p[playerid][0]);
		PlayerTextDrawHide(playerid, T_Celular_Blaze_APK_p[playerid][1]);
    }

    //// FECHAR APLICATIVO OLX ////
    if(celular_aberto[playerid] == C_OLX_ABRINDO)
    {
        for(new e; e<sizeof T_Celular_OLX_Carregando; e++) TextDrawHideForPlayer(playerid, T_Celular_OLX_Carregando[e]);
    }
    if(celular_aberto[playerid] == C_OLX)
    {
        for(new e; e<sizeof T_Celular_OLX_APK; e++) TextDrawHideForPlayer(playerid, T_Celular_OLX_APK[e]);
    }

    //// FECHAR APLICATIVO CAIXA ////
    if(celular_aberto[playerid] == C_CAIXA_ABRINDO)
    {
        for(new e; e<sizeof T_Celular_CAIXA_Carregando; e++) TextDrawHideForPlayer(playerid, T_Celular_CAIXA_Carregando[e]);
    }
    if(celular_aberto[playerid] == C_CAIXA)
    {
        for(new e; e<sizeof T_Celular_CAIXA_APK; e++) TextDrawHideForPlayer(playerid, T_Celular_CAIXA_APK[e]);
    }

    //// FECHAR APLICATIVO WHATSAPP ////
    if(celular_aberto[playerid] == C_WP_ABRINDO)
    {
        for(new e; e<sizeof T_Celular_WP_Carregando; e++) TextDrawHideForPlayer(playerid, T_Celular_WP_Carregando[e]);
    }
    if(celular_aberto[playerid] == C_WP_APK)
    {
        for(new e; e<sizeof T_Celular_WP_APK_Converssa; e++) TextDrawHideForPlayer(playerid, T_Celular_WP_APK_Converssa[e]);
        for(new ee; ee<12; ee++) PlayerTextDrawHide(playerid, T_Celular_WP_APK_Converssa_p[playerid][ee]);
        pagina_converssa[playerid] = 0;
        grupo_vip[playerid] = 0;
    }

    //// FECHAR APLICATIVO BLUTUF ////
    if(celular_aberto[playerid] == C_BLU_ABRINDO)
    {
        for(new e; e<sizeof T_Celular_Blu_Carregando; e++) TextDrawHideForPlayer(playerid, T_Celular_Blu_Carregando[e]);
    }
    if(celular_aberto[playerid] == C_BLU_APK)
    {
        for(new e; e<sizeof T_Celular_Blu_APK; e++) TextDrawHideForPlayer(playerid, T_Celular_Blu_APK[e]);
        PlayerTextDrawHide(playerid, T_Celular_Blu_APK_p[playerid][0]);
    }

    //// FECHAR APLICATIVO DETRAN ////
    if(celular_aberto[playerid] == C_DETRAN_ABRINDO)
    {
        for(new e; e<sizeof T_Celular_DETRAN_Carregando; e++) TextDrawHideForPlayer(playerid, T_Celular_DETRAN_Carregando[e]);
    }
    if(celular_aberto[playerid] == C_DETRAN)
    {
        for(new e; e<sizeof T_Celular_DETRAN_APK; e++) TextDrawHideForPlayer(playerid, T_Celular_DETRAN_APK[e]);
    }


    //////////////////////////////////////////////////////////////////////////////////////////////
    //////////////////////////////////////  OPCOES DO CELULAR ////////////////////////////////////
    //////////////////////////////////////////////////////////////////////////////////////////////

    // abrir inv //
	if(con == C_INV)
	{
		abrir_sos(playerid);
	    return 1;
	}

	// abrir carteira //
	if(con == C_CARTEIRA)
	{
	    carteira_player(playerid);
	    return 1;
	}

	// TELA DE ERRO //
	if(con == C_ERRO)
	{
	    celular_aberto[playerid] = C_ERRO;
	    PlayerTextDrawSetString(playerid, T_Celular_Erro_p[playerid][0], str_aviso[playerid]);
	    TextDrawShowForPlayer(playerid, T_Celular_Erro[0]);
	    TextDrawShowForPlayer(playerid, T_Celular_Erro[1]);
	    PlayerTextDrawShow(playerid, T_Celular_Erro_p[playerid][0]);
	    return 1;
	}

	// TELA DE INFO //
	if(con == C_INFO)
	{
	    celular_aberto[playerid] = C_INFO;
	    PlayerTextDrawSetString(playerid, T_Celular_Erro_p[playerid][0], str_aviso[playerid]);
	    TextDrawShowForPlayer(playerid, T_Celular_Erro[0]);
	    TextDrawShowForPlayer(playerid, T_Celular_Erro[2]);
	    PlayerTextDrawShow(playerid, T_Celular_Erro_p[playerid][0]);
	    return 1;
	}

	// LISTA //
	if(con == C_NUMERO)
	{
	    celular_aberto[playerid] = C_NUMERO;
	    for(new i; i<sizeof T_Celular_Numero; i++) TextDrawShowForPlayer(playerid, T_Celular_Numero[i]);
        PlayerTextDrawSetString(playerid, T_Celular_Numero_p[playerid][0], Titulo_DC[playerid]);
        if(Numero_MAX_DC[playerid] == 0) PlayerTextDrawSetString(playerid, T_Celular_Numero_p[playerid][1], "_");
		else
		{
    		new strnum[30];
		    for(new i; i<Numero_MAX_DC[playerid]; i++)
		    {
		        strcat(strnum, ConvertMoney(Numeros_DC[playerid][i]));
		    }
		    Numero_DC[playerid] = strval(strnum);
		    PlayerTextDrawSetString(playerid, T_Celular_Numero_p[playerid][1], strnum);
		}
        PlayerTextDrawShow(playerid, T_Celular_Numero_p[playerid][0]);
        PlayerTextDrawShow(playerid, T_Celular_Numero_p[playerid][1]);
	    return 1;
	}

	// LISTA //
	if(con == C_LISTA)
	{
	    new strcel[100];
	    celular_aberto[playerid] = C_LISTA;
	    for(new b; b<sizeof T_Celular_Lista; b++) TextDrawShowForPlayer(playerid, T_Celular_Lista[b]);
		for(new i; i<12; i++)
		{
		    // nome da lista //
		    if(i == 0)
			{
				PlayerTextDrawSetString(playerid, T_Celular_Lista_p[playerid][i], Titulo_DC[playerid]);
            	PlayerTextDrawShow(playerid, T_Celular_Lista_p[playerid][i]);
            }

		    // items da lista //
		    if(i >= 1 && i < 11)
		    {
		        new a = i-1;
				a += Pagina_DC[playerid]*10;
		        if(a < MAX_DC[playerid])
		        {
		        	if(Item_DC[playerid] != a) PlayerTextDrawBoxColor(playerid, T_Celular_Lista_p[playerid][i], -240);
		        	else PlayerTextDrawBoxColor(playerid, T_Celular_Lista_p[playerid][i], 0xffff0075);
		        	PlayerTextDrawSetString(playerid, T_Celular_Lista_p[playerid][i], Lista_DC[playerid][a][cel_Nome]);
		        	PlayerTextDrawShow(playerid, T_Celular_Lista_p[playerid][i]);
				}
				else PlayerTextDrawHide(playerid, T_Celular_Lista_p[playerid][i]);
		    }

		    // paginas //
		    if(i == 11)
		    {
		        new pags = paginas(10, MAX_DC[playerid]);
		        if(pags > 1)
		        {
					format(strcel, 100, "%d / %d", Pagina_DC[playerid]+1, pags);
					PlayerTextDrawSetString(playerid, T_Celular_Lista_p[playerid][i], strcel);
	                PlayerTextDrawShow(playerid, T_Celular_Lista_p[playerid][i]);
                }
                else
				{
					PlayerTextDrawHide(playerid, T_Celular_Lista_p[playerid][i]);
                    TextDrawHideForPlayer(playerid, T_Celular_Lista[1]);
                    TextDrawHideForPlayer(playerid, T_Celular_Lista[2]);
				}
		    }
		}

	    return 1;
	}

	// INICIO COM APLICATIVOS //
	if(con == C_INICIO)
	{
	    celular_aberto[playerid] = C_INICIO;
     	TextDrawShowForPlayer(playerid, T_Celular_Barra[0]);
