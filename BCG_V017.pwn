stock mostrar_opcoes_acessorio(playerid, w)
{
    new c = id[playerid];
	if(c != -1 && w != -1)
	{
		SetPVarInt(playerid, "id_ace", w);
		if(Acessorios[playerid][w][ac_Existe] == 1)
		{
		    SG[0] = EOS;
		    new sss[300];
		    if(Acessorios[playerid][w][ac_Usando] == 0)
	        {
	            // se nao tiver usando //
	            strcat(SG, "{ffffff}Colocar\n");
	            strcat(SG, "{ffffff}Guardar no Inventario\n");
	            if(Acessorios[playerid][w][ac_Tempo] != 0) strcat(SG, "{ffffff}Renovar +3 Dia {ffff00}R$ 9 Cash\n");
	        }
	        else
	        {
	            // se tiver usando //
	            strcat(SG, "{ffffff}Retirar\n");
	            strcat(SG, "{ffffff}Guardar no Inventario\n");
	            strcat(SG, "{ffffff}Mudar Local Do Corpo\n");
	            strcat(SG, "{ffffff}Editar Posicao\n");
	            if(Acessorios[playerid][w][ac_Tempo] != 0) strcat(SG, "{ffffff}Renovar +3 Dia {ffff00}R$ 9 Cash\n");
	        }
	        new vali[50];
	        if(Acessorios[playerid][w][ac_Tempo] == 0) format(vali, 50, "{4169E1}PERMANENTE");
		  	else format(vali, 50, "{ffff00}%s", Validade(Acessorios[playerid][w][ac_Tempo]));
	        format(sss, 300, "%s - %s", Acessorios_Info[Acessorios[playerid][w][ac_ID]][acessorio_Nome], vali);
	        ShowPlayerDialog(playerid, DIALOG_ACESSORIOS1, DIALOG_STYLE_LIST, sss, SG, "Continuar", "Voltar");
		}
	}
}

stock cont_acessorios(playerid)
{
	new cont;
	new c = id[playerid];
	if(c != -1)
	{
	    for(new w; w<MAX_ACESSORIOS; w++)
		{
		    if(Acessorios[playerid][w][ac_Existe] == 1)
		    {
		        if(Acessorios[playerid][w][ac_Usando] == 1)
		        {
		            cont ++;
		        }
			}
		}
	}
	return cont;
}

stock mostrar_acessorios(playerid)
{
    new c = id[playerid];
	if(c != -1)
	{
	    SG[0] = EOS;
	    strcat(SG, "Nome\tCorpo\tUsando\tValidade\n");
	    new cont;
	    new sss[300];
	    new vali[50];
		zerar_lista(playerid);
		for(new w; w<MAX_ACESSORIOS; w++)
		{
		    if(Acessorios[playerid][w][ac_Existe] == 1)
		    {
		        if(Acessorios[playerid][w][ac_Tempo] == 0) format(vali, 50, "PERMANENTE");
		        else format(vali, 50, "{ffff00}%s", Validade(Acessorios[playerid][w][ac_Tempo]));
                format(sss, 300, "{ffffff}%s\t{a1a1a1}%s\t%s\t{ffff00}%s\n", Acessorios_Info[Acessorios[playerid][w][ac_ID]][acessorio_Nome],
				ParteDoCorpo(Acessorios[playerid][w][ac_Local]), Acessorios[playerid][w][ac_Usando]?"{4169E1}SIM":"{ff0000}NAO", vali );
            	strcat(SG, sss);
				Lista[playerid][cont] = w;
				cont++;
			}
	    }
		ShowPlayerDialog(playerid, DIALOG_ACESSORIOS, DIALOG_STYLE_TABLIST_HEADERS, "Acessorios", SG, "Opcoes", "Fechar");
	}
}

