		Conta[i][c_LocalID] = DOF2_GetInt(file, "c_LocalID");
		Conta[i][c_UltimaPos] = DOF2_GetInt(file, "c_UltimaPos");

		new linh[600];
		format(linh, 500, "%s", DOF2_GetString(file, "c_NivelEmprego"));
		split_linha(linh, strlen(linh));
		for(new e; e<MAX_EMPREGOS; e++)
		{
			Conta[i][c_NivelEmprego][e] = strval(split[e]);
			if(Conta[i][c_NivelEmprego][e] < 0 )
			{
			    Conta[i][c_NivelEmprego][e] = 0;
			}
		}

		// meta dos empregos //
		Conta[i][c_MetaHora] = DOF2_GetInt(file, "c_MetaHora");
		if(Conta[i][c_MetaHora]+UMA_HORA < gettime())
		{
		    Conta[i][c_MetaHora] = 0;
		    for(new z; z<MAX_EMPREGOS; z++) Conta[i][c_MetaEmprego][z] = 0;
		}
		else
		{
		    format(linh, 500, "%s", DOF2_GetString(file, "c_MetaEmprego"));
		    split_linha(linh, strlen(linh));
		    for(new z; z<MAX_EMPREGOS; z++) Conta[i][c_MetaEmprego][z] = strval(split[z]);
		}

		// ultimo login //
		if(Conta[i][c_Dia2] == 0 && Conta[i][c_Mes2] == 0 && Conta[i][c_Ano2] == 0)
        {
            getdate(Conta[i][c_Ano2], Conta[i][c_Mes2], Conta[i][c_Dia2]);
            gettime(Conta[i][c_Hora2], Conta[i][c_Minuto2], Conta[i][c_Segundo2]);
        }

		new sss1[40], sss2[40];
        for(new a; a<13; a++)
        {
            format(sss1, 40, "Arma_%d", a);
            format(sss2, 40, "Municao_%d", a);
            Conta[i][c_Arma][a] = DOF2_GetInt(file, sss1);
            Conta[i][c_Municao][a] = DOF2_GetInt(file, sss2);
        }

    	if(Conta[i][c_CPF] != 0)
    	{
	    	new file2[80];
	    	format(file2, 80, "CPF/%s.txt", Conta[i][c_CPF]);
			if(!DOF2_FileExists(file))
			{
			    Conta[i][c_CPF] = 0;
				criar_cpf(c);
			}
		}

		if(Conta[i][c_RG] != 0)
    	{
	    	new file2[80];
	    	format(file2, 80, "RG/%s.txt", Conta[i][c_RG]);
			if(!DOF2_FileExists(file))
			{
				Conta[i][c_RG] = 0;
				criar_rg(c);
			}
		}

		if(Conta[i][c_H][0] != 0 || Conta[i][c_H][1] != 0 || Conta[i][c_H][2] != 0 || Conta[i][c_H][3] != 0)
        {
            new vall = Conta[i][c_HV];
            if(vall < 1000) Conta[i][c_HV] = gettime()+(30*UM_DIA);
            else if(vall < gettime())
            {
                Conta[i][c_H][0] = 0;
                Conta[i][c_H][1] = 0;
                Conta[i][c_H][2] = 0;
                Conta[i][c_H][3] = 0;
                msc(c, 5, "[AUTO ESCOLA] Voce perdeu sua Habilitacao por vencimento !");
			}
        }

        carregar_inventario(i, c);
    	carregar_deposito(i, c);
    	carregar_multas(i, c);
    	carregar_acessorios(i, c);
    	carregar_whatsapp(i, c);
    }
}

stock multas_conta(c)
{
	new cont;
	new playerid = ContaOnline(c);
	if(Online(playerid))
	{
		for(new i; i<MAX_MULTAS; i++)
	    {
	        if(Multas[playerid][i][mu_Existe] == 1)
	        {
				cont++;
	        }
		}
	}
	return cont;
}

stock salvar_multas(c)
{
	new playerid = ContaOnline(c);
	if(Online(playerid))
	{
	    new file[80];
	    new lin[50];
	    format(file, 80, "Multas/%d.txt", c);
	    if(!DOF2_FileExists(file)) DOF2_CreateFile(file);
	    for(new i; i<MAX_MULTAS; i++)
	    {
	        format(lin, 50, "mu_Existe_%d", i);
	        DOF2_SetInt(file, lin, Multas[playerid][i][mu_Existe]);
	        format(lin, 50, "mu_Valor_%d", i);
	        DOF2_SetInt(file, lin, Multas[playerid][i][mu_Valor]);
	        format(lin, 50, "mu_Motivo_%d", i);
	        DOF2_SetString(file, lin, Multas[playerid][i][mu_Motivo]);
	        format(lin, 50, "mu_Data_%d", i);
	        DOF2_SetString(file, lin, Multas[playerid][i][mu_Data]);
	        format(lin, 50, "mu_Conta_%d", i);
	        DOF2_SetInt(file, lin, Multas[playerid][i][mu_Conta]);
	        format(lin, 50, "mu_Radar_%d", i);
	        DOF2_SetInt(file, lin, Multas[playerid][i][mu_Radar]);
	    }
	    DOF2_SaveFile();
    }
}

stock carregar_multas(playerid, c)
{
    new file[80];
    new lin[50];
    format(file, 80, "Multas/%d.txt", c);
    if(DOF2_FileExists(file))
    {
	    for(new i; i<MAX_MULTAS; i++)
	    {
	        format(lin, 50, "mu_Existe_%d", i);
	        Multas[playerid][i][mu_Existe] = DOF2_GetInt(file, lin);
	        format(lin, 50, "mu_Valor_%d", i);
	        Multas[playerid][i][mu_Valor] = DOF2_GetInt(file, lin);
	        format(lin, 50, "mu_Motivo_%d", i);
	        format(Multas[playerid][i][mu_Motivo], 100, "%s", DOF2_GetString(file, lin));
	        format(lin, 50, "mu_Data_%d", i);
	        format(Multas[playerid][i][mu_Data], 50, "%s", DOF2_GetString(file, lin));
	        format(lin, 50, "mu_Conta_%d", i);
	        Multas[playerid][i][mu_Conta] = DOF2_GetInt(file, lin);
	        format(lin, 50, "mu_Radar_%d", i);
	        Multas[playerid][i][mu_Radar] = DOF2_GetInt(file, lin);
	    }
	}
	else
	{
	    for(new i; i<MAX_MULTAS; i++)
	    {
	        Multas[playerid][i][mu_Existe] = 0;
	        Multas[playerid][i][mu_Valor] = 0;
	        format(Multas[playerid][i][mu_Motivo], 100, "_");
	        format(Multas[playerid][i][mu_Data], 50,  "_");
	        Multas[playerid][i][mu_Conta] =-1;
	        Multas[playerid][i][mu_Radar] =-1;
		}
	}
}

stock skin(s, sex)
