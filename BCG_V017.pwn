{
	new sss[200];
	format(sss, 200, "\n\
	{ffffff}Grana na Org: {4169E1}R$ %s\n\
	{ffff00}[INFO] {a1a1a1}Digite o valor que deseja colocar no cofre:\n", ConvertMoney(Org[i][o_Cofre]));
