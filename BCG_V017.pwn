		if(GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld_(playerid) != 0) return ms(playerid, 0, "Voce nao pode criar uma garagem em um interior !");
		if(valor < 0 || valor > 10000) return ms(playerid, 0, "Use um valor entre 0 - 10.000 !");
		new Float:pos[3];
		GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
		new c = criar_garagem(pos[0], pos[1], pos[2], valor);
		if(c == -1) return ms(playerid, 0, "Numero maximo de Garagems do servidor atingido !");
		new sss[150];
		format(sss, 150, "Voce criou a Garagem ID: %d, Use /ajudagaragems para ver os comandos.", c);
		ms(playerid, 5, sss);
		return 1;
