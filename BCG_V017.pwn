BCG:: carregar_cadeias()
{
	new file[80];
	new cont;
	new str[600];
	new str2[80];
	for(new i; i<MAX_CADEIAS; i++)
	{
	    Cadeia[i][ca_3D] = DynamicText3D:-1;
	    format(file, 80, "Cadeias/Cadeia_%d.txt", i);
	    if(DOF2_FileExists(file))
	    {
	        Cadeia[i][ca_Existe] = 1;
	        Cadeia[i][ca_Org] = DOF2_GetInt(file, "ca_Org");
	        Cadeia[i][ca_X] = DOF2_GetFloat(file, "ca_X");
	        Cadeia[i][ca_Y] = DOF2_GetFloat(file, "ca_Y");
	        Cadeia[i][ca_Z] = DOF2_GetFloat(file, "ca_Z");
	        Cadeia[i][ca_X2] = DOF2_GetFloat(file, "ca_X2");
	        Cadeia[i][ca_Y2] = DOF2_GetFloat(file, "ca_Y2");
	        Cadeia[i][ca_Z2] = DOF2_GetFloat(file, "ca_Z2");
	        Cadeia[i][ca_Interior1] = DOF2_GetInt(file, "ca_Interior1");
	        Cadeia[i][ca_Mundo1] = DOF2_GetInt(file, "ca_Mundo1");
	        Cadeia[i][ca_Interior2] = DOF2_GetInt(file, "ca_Interior2");
	        Cadeia[i][ca_Mundo2] = DOF2_GetInt(file, "ca_Mundo2");
	        Cadeia[i][ca_Interior] = DOF2_GetInt(file, "ca_Interior");
	        Cadeia[i][ca_Mundo] = DOF2_GetInt(file, "ca_Mundo");
	        for(new a; a<5; a++)
	        {
	            format(str2, 80, "ca_Cela_%d", a);
	            format(str, 500, "%s", DOF2_GetString(file, str2));
	            split_linha(str, strlen(str));
	            Cadeia[i][ca_Cela_Existe][a] = strval(split[0]);
	            Cadeia[i][ca_Cela_X][a] = floatstr(split[1]);
	            Cadeia[i][ca_Cela_Y][a] = floatstr(split[2]);
	            Cadeia[i][ca_Cela_Z][a] = floatstr(split[3]);
	        }
	        cont++;
	        atualizar_cadeia(i);
	    }
	}
    printf("** %d Cadeias do Servidor carregadas.", cont);
}

stock salvar_cadeia(i)
{
    new file[80];
	new str[500];
	new str2[80];
    format(file, 80, "Cadeias/Cadeia_%d.txt", i);
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
	if(Cadeia[i][ca_Existe] == 1)
	{
	    DOF2_CreateFile(file);
 		DOF2_SetInt(file, "ca_Org", Cadeia[i][ca_Org]);
        DOF2_SetFloat(file, "ca_X", Cadeia[i][ca_X]);
        DOF2_SetFloat(file, "ca_Y", Cadeia[i][ca_Y]);
        DOF2_SetFloat(file, "ca_Z", Cadeia[i][ca_Z]);
        DOF2_SetFloat(file, "ca_X2", Cadeia[i][ca_X2]);
        DOF2_SetFloat(file, "ca_Y2", Cadeia[i][ca_Y2]);
        DOF2_SetFloat(file, "ca_Z2", Cadeia[i][ca_Z2]);
        DOF2_SetInt(file, "ca_Interior", Cadeia[i][ca_Interior]);
        DOF2_SetInt(file, "ca_Mundo", Cadeia[i][ca_Mundo]);
        DOF2_SetInt(file, "ca_Interior1", Cadeia[i][ca_Interior1]);
        DOF2_SetInt(file, "ca_Mundo1", Cadeia[i][ca_Mundo1]);
        DOF2_SetInt(file, "ca_Interior2", Cadeia[i][ca_Interior2]);
        DOF2_SetInt(file, "ca_Mundo2", Cadeia[i][ca_Mundo2]);
        for(new a; a<5; a++)
        {
            format(str2, 80, "ca_Cela_%d", a);
			format(str, 500, "%d|%f|%f|%f|", Cadeia[i][ca_Cela_Existe][a], Cadeia[i][ca_Cela_X][a], Cadeia[i][ca_Cela_Y][a], Cadeia[i][ca_Cela_Z][a]);
			DOF2_SetString(file, str2, str);
		}
		DOF2_SaveFile();
	}
}

stock criar_cadeia(Float:xx, Float:yy, Float:zz, inter, mund, org)
{
	for(new i; i<MAX_CADEIAS; i++)
	{
	    if(Cadeia[i][ca_Existe] == 0)
	    {
	        Cadeia[i][ca_Existe] = 1;
	        Cadeia[i][ca_Interior1] = inter;
	        Cadeia[i][ca_Mundo1] = mund;
	        Cadeia[i][ca_Interior2] = inter;
	        Cadeia[i][ca_Mundo2] = mund;
	        Cadeia[i][ca_Interior] = inter;
	        Cadeia[i][ca_Mundo] = mund;
	        Cadeia[i][ca_Org] = org;
	        Cadeia[i][ca_X] = xx;
	        Cadeia[i][ca_Y] = yy;
	        Cadeia[i][ca_Z] = zz;
	        Cadeia[i][ca_X2] = xx;
	        Cadeia[i][ca_Y2] = yy;
	        Cadeia[i][ca_Z2] = zz;
	        for(new a; a<5; a++)
	        {
	            Cadeia[i][ca_Cela_Existe][a] = 0;
	            Cadeia[i][ca_Cela_X][a] = 0;
	            Cadeia[i][ca_Cela_Y][a] = 0;
	            Cadeia[i][ca_Cela_Z][a] = 0;
	        }
	        atualizar_cadeia(i);
	        salvar_cadeia(i);
	        return i;
		}
	}
	return -1;
}

stock atualizar_cadeia(i)
{
	Iter_Remove(Iter_Cadeias, i);
	if(IsValidDynamic3DTextLabel(Cadeia[i][ca_3D])) DestroyDynamic3DTextLabel(Cadeia[i][ca_3D]);
	if(IsValidDynamicPickup(Cadeia[i][ca_Pickup])) DestroyDynamicPickup(Cadeia[i][ca_Pickup]);
	Cadeia[i][ca_3D] = DynamicText3D:-1;
	if(Cadeia[i][ca_Existe] == 1)
	{
	    Iter_Add(Iter_Cadeias, i);
	    new sss[150];
	    if(Cadeia[i][ca_Org] != -1) format(sss, 150, "{ffff00}Cadeia ID: %d\n{00ffff}%s\n\n{a1a1a1}Prenda os suspeitos\naqui", i, Org[Cadeia[i][ca_Org]][o_Nome]);
	    else format(sss, 150, "{ffff00}Cela ID: %d\n{a1a1a1}Sem Org\n\n{a1a1a1}Prenda os suspeitos\naqui", i);
	    Cadeia[i][ca_3D] = CreateDynamic3DTextLabel( sss, 0xffffff90, Cadeia[i][ca_X], Cadeia[i][ca_Y], Cadeia[i][ca_Z], 5, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, Cadeia[i][ca_Mundo1], Cadeia[i][ca_Interior1], -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0 );
	    Cadeia[i][ca_Pickup] = CreateDynamicPickup(19804, 1, Cadeia[i][ca_X], Cadeia[i][ca_Y], Cadeia[i][ca_Z], Cadeia[i][ca_Mundo1], Cadeia[i][ca_Interior1], -1, STREAMER_PICKUP_SD, -1, 0);
	}
}

stock abrir_cadeia(playerid, i)
{
	if(Cadeia[i][ca_Existe] == 1)
	{
	    if(Online(playerid))
	    {
	        new sss[100];
	        format(sss, 100, "Editando cadeia ID: %d", i);
	        SetPVarInt(playerid, "id_cadeia", i);
			ShowPlayerDialog(playerid, DIALOG_CADEIA, DIALOG_STYLE_LIST, sss, "{ffffff}\
			Posicao prender\n\
			Posicao liberar\n\
			Mundo das Celas\n\
			Interior das Celas\n\
			Organizacao da Cadeia\n\
			{ffff00}Editar Celas", "Continuar", "Cancelar");
	    }
	}
}

stock abrir_mundo_cadeia(playerid, i)
{
    new sss[150];
	format(sss, 150, "{ffffff}\n\
	{ffffff}Seu Mundo atual e: {ffff00}%d\n\
	{ffffff}Mundo das Celas atual: {00ffff}%d\n\n\
	{ffffff}Digite o Mundo que os players\nirao parar assim que forem presos:\n",
	GetPlayerVirtualWorld_(playerid), Cadeia[i][ca_Mundo]);
	ShowPlayerDialog(playerid, DIALOG_CADEIA2, DIALOG_STYLE_INPUT, "Setar Mundo das Celas", sss, "Setar", "Cancelar");
}

stock abrir_interior_cadeia(playerid, i)
{
	new sss[150];
	format(sss, 150, "{ffffff}\n\
	{ffffff}Seu Interior atual e: {ffff00}%d\n\
	{ffffff}Interior das Celas atual: {00ffff}%d\n\n\
	{ffffff}Digite o Interior que os players\nirao parar assim que forem presos:\n",
	GetPlayerInterior(playerid), Cadeia[i][ca_Interior]);
	ShowPlayerDialog(playerid, DIALOG_CADEIA3, DIALOG_STYLE_INPUT, "Setar Interior das Celas", sss, "Setar", "Cancelar");
}

