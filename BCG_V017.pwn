		format(Lista_DC[playerid][2][cel_Nome], 50, "~w~Informacoes");
		format(Lista_DC[playerid][3][cel_Nome], 50, "~w~Ligar");
	    ID_DC[playerid] = WHATSAPP_NOVO_CONTATO;
		MAX_DC[playerid] = 4;
		Pagina_DC[playerid] = 0;
		Item_DC[playerid] = 0;
		celular(playerid, C_LISTA);
	}
}



stock notificacao_cel(playerid, idd, con, const strrsa[]="_")
{
	new c = id[playerid];
	if(c != -1)
	{
		if(Conta[playerid][c_WP] == 0)
		{
			new sss[150];
			if(con == 0) format(sss, 150, "{7CFC00}[WP] Nova menssagem de '%s' no Whatsapp.", Nome(idd));
			if(con == 1) format(sss, 150, "{7CFC00}[WP] Joogador '%s' enviou sua localizacao, use /loc para encontra-lo.", Nome(idd));
			if(con == 2) format(sss, 150, "{7CFC00}[WP] O jogador que enviou a localizacao acabou saindo do servidor.");
			if(con == 3) format(sss, 150, "{BA55D3}%s", strrsa);
			ms(playerid, 0xffffffff, sss);
		}
	}
}

stock ligar_para_contato(playerid, cc)
{
    if(RecLig[playerid] != -1)return ms(playerid, 1, "Voce ja esta aguardando uma ligacao.");
    new c = id[playerid], string[550];
	if(c != -1)
	{
	    new dd = ContaOnline(cc);
		if(!Online(dd))
		{
		    format(str_aviso[playerid], 300, "Esta pessoa nao esta Online, impossivel ligar agora !.");
			SetPVarInt(playerid, "aviso", C_LISTA);
			celular(playerid, C_ERRO);
        }
		else
		{
			if(EmLigacao[dd] != -1)return SSM(playerid, -1, "{FF0000}[SERVER]: Este jogador ja esta em uma ligacao.");
            // notificar
            format(string, sizeof(string), "~w~Voce esta ligando para ~n~Nome: %s~n~Numero: %d~n~", Nome(dd), Conta[dd][c_Chip]);
            GameTextForPlayer(playerid, string, 3000, 3);

            RecLig[dd] = playerid;
            RecLig[playerid] = dd;

            SSM(dd, -1, "{FFDC33}[INFO LIGACAO]: {BEBEBE}Voce esta recebendo uma ligacao, use: /atenderl");
            GameTextForPlayer(dd, "~w~/atenderl", 4000, 0);
            ms(playerid, 1, "Tentando ligacao, aguarde...");
            fechar_celular(playerid);
		}
	}
    return 1;
}


stock loc_player(playerid, cc)
{
    new c = id[playerid];
	if(c != -1)
	{
		new dd = ContaOnline(cc);
	    if(!Online(dd))
		{
		    format(str_aviso[playerid], 300, "Esta pessoa nao esta Online, impossivel mandar sua localizacao !");
			SetPVarInt(playerid, "aviso", C_LISTA);
			celular(playerid, C_ERRO);
		}
		else if(LocWp_id[dd] < -1)
		{
		    format(str_aviso[playerid], 300, "Esta pessoa ja esta acessando a localizacao de alguem no momento !");
			SetPVarInt(playerid, "aviso", C_LISTA);
			celular(playerid, C_ERRO);
		}
		else
		{
		    LocWp_id[dd] = playerid;
			GetPlayerPos(playerid, LocWp_pos[dd][0], LocWp_pos[dd][1], LocWp_pos[dd][2]);
			LocWp_interior[dd] = GetPlayerInterior(playerid);
			LocWp_mundo[dd] = GetPlayerVirtualWorld_(playerid);
			notificacao_cel(dd, playerid, 1);
			format(str_aviso[playerid], 300, "Localizacao enviada com sucesso !");
			SetPVarInt(playerid, "aviso", C_LISTA);
			celular(playerid, C_INFO);
		}
	}
}

stock player_chip(playerid)
{
	new c = id[playerid];
	if(c == -1) return -1;
	if(Conta[playerid][c_Chip] != 0)
	{
	    return Conta[playerid][c_Chip];
	}
	return -1;
}

stock criar_chip(playerid, ope)
{
	new c = id[playerid];
	if(c != -1)
	{
		new chip = gerar_chip(ope);
		if(chip == -50)
		{
		    ms(playerid, 0, "Houve um erro ao gerar seu numero, tente novamente !");
		    return 0;
		}
		else
		{
			salvar_chip(c, chip);
			new sss[150];
			ms(playerid, 2, "Numero criado com sucesso e cadastrado com seu cpf na operadora !");
			format(sss, 150, "Seu numero de celular e: [ %d ], voce pode ve-lo pelo apk do whatsapp.", chip);
			ms(playerid, 2, sss);
			return 1;
		}
	}
	return 0;
}

stock salvar_chip(c, chip)
{
    new file[80];
    format(file, 80, "Chips/%d.txt", chip);
	if(c != -1)
	{
	    if(!ContaInvalida(c))
	    {
	        new player = ContaOnline(c);
	        if(Online(player))
	        {
		        new sss[100];
		        Conta[player][c_Chip] = chip;
		        if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
		        DOF2_CreateFile(file);
		        DOF2_SetInt(file, "c_Conta", c);
		        format(sss, 100, "%02d/%02d/%02d", DIA, MES, ANO);
		        DOF2_SetString(file, "c_Data", sss);
		        format(sss, 100, "%02d/%02d/%02d", HORA, MINUTO, SEGUNDO);
		        DOF2_SetString(file, "c_Hora", sss);
		        DOF2_SaveFile();
		        salvar_conta(c, 0, "c_Chip", sv_int(Conta[player][c_Chip]));
	        }
	    }
	}
}

stock chip_conta(chip)
{
    new file[80];
    format(file, 80, "Chips/%d.txt", chip);
    if(DOF2_FileExists(file)) return DOF2_GetInt(file, "c_Conta");
	return -1;
}

stock gerar_chip(ope)
{
	new chip;
	new file[80];
	for(new d; d<10; d++)
	{
		if(ope  < 1 || ope > 2) ope = 1;
		if(ope == 1) chip = 900000 + random(100000);
		if(ope == 2) chip = 800000 + random(100000);
		format(file, 80, "Chips/%d.txt", chip);
		if(!DOF2_FileExists(file))
		{
		    return chip;
		}
	}
	return -50;
}


stock apagar_converssa(i)
{
	new menss = i;
	new file[80];
    format(file, 80, "WP_Converssas/%d.txt", menss);
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
	WP[i][w_Existe] = 0;
	salvar_wp(i);
}

stock ver_anuncios(playerid, con=-1)
{
    new c = id[playerid];
	if(c != -1)
	{
		if(con == -1)
		{
		    Item_DC[playerid] = 0;
			format(Lista_DC[playerid][0][cel_Nome], 100, "~w~Informacoes e Cervicos");
			format(Lista_DC[playerid][1][cel_Nome], 100, "~w~Venda de Veiculos");
			format(Lista_DC[playerid][2][cel_Nome], 100, "~w~Venda de Casas ou APs");
		    format(Titulo_DC[playerid], 100, "~b~~h~TIPOS DE ANUNCIOS");
		    MAX_DC[playerid] = 3;
		    ID_DC[playerid] = OLX_ANUNCIOS_CATEGORIAS;
			Pagina_DC[playerid] = 0;
			celular(playerid, C_LISTA);
		}

		// anuncios comunicativos //
		if(con == 0)
		{
		    tipo_an[playerid] = 0;
		    new cont;
		    for(new i; i<MAX_ANUNCIOS; i++)
		    {
		        if(cont < 500)
		        {
				if(i < 500) Lista_DC[playerid][i][cel_ID] = -1;
		            if(Anuncios[i][an_Existe] == 1 && Anuncios[i][an_Tipo] == 0)
		            {
		                if(Anuncios[i][an_ID] == 0)
		                {
		                    format(Lista_DC[playerid][cont][cel_Nome], 25, "~w~%s_", Anuncios[i][an_Menssagem]);
		                    if(strlen(Anuncios[i][an_Menssagem]) > 25) strcat(Lista_DC[playerid][cont][cel_Nome], "...");
		                	Lista_DC[playerid][cont][cel_ID] = i;
		                	cont ++;
		                }
		                else
		                {
				        format(Lista_DC[playerid][cont][cel_Nome], 100, "~w~%s_", Anuncios[i][an_Titulo]);
				        Lista_DC[playerid][cont][cel_ID] = i;
				        cont ++;
						}
		            }
		        }
		    }
		    format(Titulo_DC[playerid], 100, "~b~~h~INFO OU SERVICOS [~w~%s~b~~h~]", ConvertMoney(cont));
		    MAX_DC[playerid] = cont;
		    ID_DC[playerid] = OLX_ANUNCIOS;
			Pagina_DC[playerid] = 0;
			if(cont > 0) Item_DC[playerid] = 0;
			else Item_DC[playerid] = -1;
			celular(playerid, C_LISTA);
		}

		// venda de veiculos //
		if(con == 1)
		{
		    tipo_an[playerid] = 1;
		    Item_DC[playerid] = -1;
		    new cont;
		    for(new i; i<MAX_ANUNCIOS; i++)
		    {
		        if(cont < 500)
		        {
				if(i < 500) Lista_DC[playerid][i][cel_ID] = -1;
		            if(Anuncios[i][an_Existe] == 1 && Anuncios[i][an_Tipo] == 1)
		            {
		                format(Lista_DC[playerid][cont][cel_Nome], 100, "~w~%s ~g~~h~R$ %s", NomeVeiculo(Anuncios[i][an_ID]), ConvertMoney(Anuncios[i][an_Valor]));
		                Lista_DC[playerid][cont][cel_ID] = i;
		                cont ++;
		            }
		        }
		    }
		    format(Titulo_DC[playerid], 100, "~b~~h~VENDA DE VEICULOS [~w~%s~b~~h~]", ConvertMoney(cont));
		    MAX_DC[playerid] = cont;
		    if(cont != 0) Item_DC[playerid] = 0;
		    else Item_DC[playerid] = -1;
		    ID_DC[playerid] = OLX_ANUNCIOS;
			Pagina_DC[playerid] = 0;
			celular(playerid, C_LISTA);
		}

		// venda de casa ou ap //
		if(con == 2)
		{
		    tipo_an[playerid] = 2;
		    new cont;
		    for(new i; i<MAX_ANUNCIOS; i++)
		    {
		        if(cont < 500)
		        {
				if(i < 500) Lista_DC[playerid][i][cel_ID] = -1;
		            if(Anuncios[i][an_Existe] == 1 && Anuncios[i][an_Tipo] == 2)
		            {
		                format(Lista_DC[playerid][cont][cel_Nome], 100, "~w~%s (%d) ~g~~h~R$ %s", tipo_casa(Anuncios[i][an_ID]), Anuncios[i][an_ID], ConvertMoney(Anuncios[i][an_Valor]));
		                Lista_DC[playerid][cont][cel_ID] = i;
		                cont ++;
		            }
		        }
		    }
		    format(Titulo_DC[playerid], 100, "~b~~h~VENDA DE CASA / AP [~w~%s~b~~h~]", ConvertMoney(cont));
		    MAX_DC[playerid] = cont;
		    if(cont != 0) Item_DC[playerid] = 0;
		    else Item_DC[playerid] = -1;
		    ID_DC[playerid] = OLX_ANUNCIOS;
			Pagina_DC[playerid] = 0;
			celular(playerid, C_LISTA);
		}
	}
}

stock opcoes_anuncio(playerid, i)
{
    new c = id[playerid];
	if(c != -1)
	{
		SetPVarInt(playerid, "anuncio", i);
		new cc = Anuncios[i][an_Dono];
		format(Titulo_DC[playerid], 100, "~b~~h~%s ~w~(%d)", NomeConta(cc), GetContaInt(cc, "c_Chip"));
		format(Lista_DC[playerid][0][cel_Nome], 50, "~w~~h~Mandar Menssagem");
		format(Lista_DC[playerid][1][cel_Nome], 50, "~y~Adicionar Contato");
		if(cc == c) format(Lista_DC[playerid][2][cel_Nome], 50, "~r~Apagar Anuncio");
	    ID_DC[playerid] = OLX_OPCOES;
		if(cc == c) MAX_DC[playerid] = 3;
		else MAX_DC[playerid] = 2;
		Pagina_DC[playerid] = 0;
		Item_DC[playerid] = 0;
		celular(playerid, C_LISTA);
	}
}

stock anunciar(playerid)
{
    new c = id[playerid];
	if(c != -1)
	{
		if(Conta[playerid][c_Anuncio] > gettime() && AdminPlayer(playerid) < 0)
		{
		    format(str_aviso[playerid], 300, "Voce so pode anunciar novamente em %s, aguarde e tente novamente.", Conta[playerid][c_Anuncio]-gettime());
			SetPVarInt(playerid, "aviso", C_OLX);
			celular(playerid, C_ERRO);
		}
		else
		{
			format(Titulo_DC[playerid], 100, "~y~~h~POSTAR ANUNCIO");
			format(Lista_DC[playerid][0][cel_Nome], 50, "~w~Anuncio Comunicativo");
			format(Lista_DC[playerid][1][cel_Nome], 50, "~w~Venda de Veiculo");
			format(Lista_DC[playerid][2][cel_Nome], 50, "~w~Venda de Casa ou AP");
		    ID_DC[playerid] = OLX_CRIAR_TIPO;
			MAX_DC[playerid] = 3;
			Pagina_DC[playerid] = 0;
			Item_DC[playerid] = 0;
			celular(playerid, C_LISTA);
		}
	}
}

stock escolher_veiculo(playerid)
{
    new c = id[playerid];
	if(c != -1)
	{
	    format(Titulo_DC[playerid], 100, "~y~~h~VENDER VEICULO");
	    for(new a; a<212; a++) format(Lista_DC[playerid][a][cel_Nome], 50, "~w~%s", NomeVeiculo(a+400));
	    ID_DC[playerid] = OLX_CRIAR_VEICULO;
		MAX_DC[playerid] = 212;
		Pagina_DC[playerid] = 0;
		Item_DC[playerid] = 0;
		celular(playerid, C_LISTA);
	}
}

stock escolher_servico(playerid)
{
    new c = id[playerid];
	if(c != -1)
	{
    format(Titulo_DC[playerid], 100, "~y~~h~ANUNCIO COMUNICATIVO");
    for(new a; a<sizeof tipos_anuncios; a++) format(Lista_DC[playerid][a][cel_Nome], 50, "~w~%s", tipos_anuncios[a]);
    ID_DC[playerid] = OLX_CRIAR_SERVICO;
	MAX_DC[playerid] = sizeof tipos_anuncios;
	Pagina_DC[playerid] = 0;
	Item_DC[playerid] = 0;
	celular(playerid, C_LISTA);
	}
}

stock valor_anuncio(playerid)
{
    new c = id[playerid];
	if(c != -1)
	{
	    ID_DC[playerid] = OLX_CRIAR_VALOR;
		if(player_anuncio[playerid][an_Tipo] == 1) format(Titulo_DC[playerid], 100, "~w~Digite o ~g~~h~R$ Valor ~w~da venda do Veiculo:");
		if(player_anuncio[playerid][an_Tipo] == 2) format(Titulo_DC[playerid], 100, "~w~Digite o ~g~~h~R$ Valor ~w~da venda da Casa ou Apartamento:");
		Numero_MAX_DC[playerid] = 0;
		celular(playerid, C_NUMERO);
	}
}


stock escolher_casa(playerid)
{
    new c = id[playerid];
	if(c != -1)
	{
		ID_DC[playerid] = OLX_CRIAR_CASA;
		format(Titulo_DC[playerid], 100, "~w~Digite o ~y~~h~ID ~w~da Casa ou Apartamento que deseja vender:");
		Numero_MAX_DC[playerid] = 0;
		celular(playerid, C_NUMERO);
	}
}

stock finalizar_anuncio(playerid)
{
    new c = id[playerid];
	if(c != -1)
	{
	    format(Titulo_DC[playerid], 100, "~y~~h~POSTRAR ANUNCIO");
		if(Comparar(player_anuncio[playerid][an_Menssagem], "-")) format(Lista_DC[playerid][0][cel_Nome], 50, "~w~Digitar Menssagem");
		else
		{
		    format(Lista_DC[playerid][0][cel_Nome], 25, "~w~%s _", player_anuncio[playerid][an_Menssagem]);
		    if(strlen(player_anuncio[playerid][an_Menssagem]) > 25) strcat(Lista_DC[playerid][0][cel_Nome], "...");
		}
		format(Lista_DC[playerid][1][cel_Nome], 50, "~w~Pre Vizualizar");
		format(Lista_DC[playerid][2][cel_Nome], 50, "~r~Cancelar Anuncio");
		format(Lista_DC[playerid][3][cel_Nome], 50, "~g~~h~Finalizar e Postar");
	    ID_DC[playerid] = OLX_CRIAR_TERMINAR;
		MAX_DC[playerid] = 4;
		Pagina_DC[playerid] = 0;
		Item_DC[playerid] = 0;
		celular(playerid, C_LISTA);
	}
}


stock postar_anuncio(playerid)
{
    new c = id[playerid];
	if(c != -1)
	{
		for(new a=MAX_ANUNCIOS-1; a>-1; a--)
		{
		    if(a > 0)
		    {
		    	Anuncios[a][an_Existe] = Anuncios[a-1][an_Existe];
		    	Anuncios[a][an_Dono] = Anuncios[a-1][an_Dono];
		    	Anuncios[a][an_Tipo] = Anuncios[a-1][an_Tipo];
		    	Anuncios[a][an_ID] = Anuncios[a-1][an_ID];
		    	Anuncios[a][an_Valor] = Anuncios[a-1][an_Valor];
		        format(Anuncios[a][an_Menssagem], 150, Anuncios[a-1][an_Menssagem]);
		        format(Anuncios[a][an_Data], 30, Anuncios[a-1][an_Data]);
		        format(Anuncios[a][an_Titulo], 30, Anuncios[a-1][an_Titulo]);
		    }
		}

		Anuncios[0][an_Existe] = 1;
		Anuncios[0][an_Dono] = c;
		Anuncios[0][an_Tipo] = player_anuncio[playerid][an_Tipo];
		Anuncios[0][an_ID] = player_anuncio[playerid][an_ID];
		Anuncios[0][an_Valor] = player_anuncio[playerid][an_Valor];
	    format(Anuncios[0][an_Menssagem], 150, player_anuncio[playerid][an_Menssagem]);
	    format(Anuncios[0][an_Data], 30, "%02d/%02d/%02d  %02d:%02d", DIA, MES, ANO, HORA, MINUTO);
	    format(Anuncios[0][an_Titulo], 30, player_anuncio[playerid][an_Titulo]);
	    new sss[200];
		format(sss, 200, "[OLX] Novo anuncio de '%s', categoria: %s.", Nome(playerid), categoria_anuncio(playerid));
	    foreach(new i:Player)
	    {
	        if(Online(i))
	        {
	            notificacao_cel(i, playerid, 3, sss);
	        }
	    }
	    celular(playerid, C_OLX);
	    Conta[playerid][c_Anuncio] = gettime()+(5*(60));
	}
}


stock categoria_anuncio(playerid)
{
	new cat[40];
	format(cat, 40, "Nenhuma");
	if(player_anuncio[playerid][an_Tipo] == 0) format(cat, 40, player_anuncio[playerid][an_Titulo]);
	if(player_anuncio[playerid][an_Tipo] == 1) format(cat, 40, "Venda de Veiculo");
	if(player_anuncio[playerid][an_Tipo] == 2) format(cat, 40, "Venda de Casa ou AP");
	return cat;
}

stock digitar_menssagem(playerid, con=0)
{
	if(con == 0) ShowPlayerDialog(playerid, DIALOG_ESCREVER_OLX, DIALOG_STYLE_INPUT, "{000000}_", "\n{a1a1a1}Digite sua Menssagem                                                                    .", "Enviar", "Cancelar");
	if(con == 1) ShowPlayerDialog(playerid, DIALOG_ESCREVER_OLX, DIALOG_STYLE_INPUT, "{000000}_", "\n{ff0000}Menssagem muito Curta !\n{a1a1a1}Digite sua Menssagem                                                                    .", "Enviar", "Cancelar");
	if(con == 2) ShowPlayerDialog(playerid, DIALOG_ESCREVER_OLX, DIALOG_STYLE_INPUT, "{000000}_", "\n{ff0000}Menssagem muito Grande, tente denovo !{a1a1a1}Digite sua Menssagem                                                                    .", "Enviar", "Cancelar");
	if(con == 3) ShowPlayerDialog(playerid, DIALOG_ESCREVER_OLX, DIALOG_STYLE_INPUT, "{000000}_", "\n{ff0000}Span ou Palavra muito grande indentificada !\nTente nao usar palavras muito grandes ou caracteres repetidos.\n{a1a1a1}Digite sua Menssagem                                                                    .", "Enviar", "Cancelar");
}

BCG:: abrir_agora(playerid, con)
{
	new pode;
    new c = id[playerid];
	if(c != -1)
	{
		if(player_arena[playerid] == 0)
		{
			if(player_algemado[playerid] == 0 && player_amarrado[playerid] == 0)
			{
				if(player_rendido[playerid] == 0)
				{
					if(player_arrastado[playerid] == -1 && Barra[playerid][b_Acao] == 0)
					{
					    if(segurando_player[playerid] == -1 && academia_player[playerid] == -1)
						{
							if(Conta[playerid][c_Hospital] == 0 && player_cinuca[playerid] == -1)
							{
							    if(Conta[playerid][c_Cadeia] == -1 && imobilizado[playerid] == 0)
						    	{
									if(GetPVarInt(playerid, "vdp") < gettime() && Conta[playerid][c_CA_Tempo] == 0)
									{
									    pode = 1;
									    if(con == 0) celular(playerid);
										if(con == 1) abrir_inv_novo(playerid);
										if(con == 2) mostrar_armas_novo(playerid);
										if(con == 3) mostrar_radio(playerid);
										if(con == 4) abrir_loja(playerid);
									}
								}
							}
						}
					}
				}
			}
		}
		if(pode == 0) ms(playerid, 0, "Voce nao pode fazer isso agora !");
	}
}

BCG:: carregar_garagems()
{
	new file[80];
	for(new i; i<MAX_GARAGEMS; i++)
	{
	    Garagem[i][ga_3D] = DynamicText3D:-1;
	    Garagem[i][ga_3D2] = DynamicText3D:-1;
	    format(file, 80, "Garagems/%d.txt", i);
	    if(DOF2_FileExists(file))
	    {
			Garagem[i][ga_Existe] = 1;
			Garagem[i][ga_Dono] = DOF2_GetInt(file, "ga_Dono");
			Garagem[i][ga_Org] = DOF2_GetInt(file, "ga_Org");
			Garagem[i][ga_Emprego] = DOF2_GetInt(file, "ga_Emprego");
			Garagem[i][ga_Valor] = DOF2_GetInt(file, "ga_Valor");
			Garagem[i][ga_X] = DOF2_GetFloat(file, "ga_X");
			Garagem[i][ga_Y] = DOF2_GetFloat(file, "ga_Y");
			Garagem[i][ga_Z] = DOF2_GetFloat(file, "ga_Z");
			Garagem[i][ga_X2] = DOF2_GetFloat(file, "ga_X2");
			Garagem[i][ga_Y2] = DOF2_GetFloat(file, "ga_Y2");
			Garagem[i][ga_Z2] = DOF2_GetFloat(file, "ga_Z2");
			atualizar_garagem(i);
	    }
	}
}

stock salvar_garagem(i)
{
    new file[80];
    format(file, 80, "Garagems/%d.txt", i);
    if(DOF2_FileExists(file)) DOF2_RemoveFile(file);
    if(Garagem[i][ga_Existe] == 1)
    {
        DOF2_CreateFile(file);
        DOF2_SetInt(file, "ga_Valor", Garagem[i][ga_Valor]);
        DOF2_SetInt(file, "ga_Dono", Garagem[i][ga_Dono]);
        DOF2_SetInt(file, "ga_Emprego", Garagem[i][ga_Emprego]);
        DOF2_SetInt(file, "ga_Org", Garagem[i][ga_Org]);
        DOF2_SetFloat(file, "ga_X", Garagem[i][ga_X]);
        DOF2_SetFloat(file, "ga_Y", Garagem[i][ga_Y]);
        DOF2_SetFloat(file, "ga_Z", Garagem[i][ga_Z]);
        DOF2_SetFloat(file, "ga_X2", Garagem[i][ga_X2]);
        DOF2_SetFloat(file, "ga_Y2", Garagem[i][ga_Y2]);
        DOF2_SetFloat(file, "ga_Z2", Garagem[i][ga_Z2]);
        DOF2_SaveFile();
    }
}

stock atualizar_garagem(i)
{
    if(IsValidDynamicMapIcon(Garagem[i][ga_Mapa])) DestroyDynamicMapIcon_(Garagem[i][ga_Mapa]);
	if(IsValidDynamicPickup(Garagem[i][ga_Pickup])) DestroyDynamicPickup_(Garagem[i][ga_Pickup]);
	if(IsValidDynamic3DTextLabel(Garagem[i][ga_3D])) DestroyDynamic3DTextLabel(Garagem[i][ga_3D]);
	if(IsValidDynamicPickup(Garagem[i][ga_Pickup2])) DestroyDynamicPickup_(Garagem[i][ga_Pickup2]);
	if(IsValidDynamic3DTextLabel(Garagem[i][ga_3D2])) DestroyDynamic3DTextLabel(Garagem[i][ga_3D2]);
	Garagem[i][ga_3D] = DynamicText3D:-1;
	Garagem[i][ga_3D2] = DynamicText3D:-1;
	if(Garagem[i][ga_Existe] == 1)
	{
	    new sss[200];
	    new valo[20];
	    format(valo, 20, "R$ %s", ConvertMoney(Garagem[i][ga_Valor]));

	    if(Garagem[i][ga_Dono] == -1 && Garagem[i][ga_Org] == -1 && Garagem[i][ga_Emprego] == -1)
	    {
		    format(sss, 200, "\
			{ffff00}Garagem [%d]\n\
			{4169E1}%s\n\
			\n\
			\
			{a1a1a1}aperte {ffffff}H {a1a1a1}para\n\
			pegar seu veiculo", i, (Garagem[i][ga_Valor] == 0)?"GRATIS":valo);
			Garagem[i][ga_Mapa] = CreateDynamicMapIcon(Garagem[i][ga_X], Garagem[i][ga_Y], Garagem[i][ga_Z], 11, 0xffffffff, 0, 0, -1, STREAMER_MAP_ICON_SD, MAPICON_LOCAL, -1, 0);
	    }
	    else
	    {
	        // se for de uma conta //
	        if(Garagem[i][ga_Dono] != -1)
	        {
                format(sss, 200, "\
				{ffff00}Garagem [%d]\n\
				{ffffff}Dono: {a1a1a1}%s\n\
				\n\
				\
				{a1a1a1}aperte {ffffff}H {a1a1a1}para\n\
				pegar seu veiculo", i, NomeConta(Garagem[i][ga_Dono]));
	        }

	        // se for de uma Organizacao //
	        if(Garagem[i][ga_Org] != -1)
	        {
                format(sss, 200, "\
				{ffff00}Garagem [%d]\n\
				{ffffff}Org: {a1a1a1}%s\n\
				\n\
				\
				{a1a1a1}aperte {ffffff}H {a1a1a1}para\n\
				pegar seu veiculo", i, NomeOrg(Garagem[i][ga_Org]));
	        }

	        // se for de um Emprego //
	        if(Garagem[i][ga_Emprego] != -1)
	        {
                format(sss, 200, "\
				{ffff00}Garagem [%d]\n\
				{ffffff}Emprego: {a1a1a1}%s\n\
				\n\
				\
				{a1a1a1}aperte {ffffff}H {a1a1a1}para\n\
				pegar seu veiculo", i, NomeEmprego(Garagem[i][ga_Emprego]));
	        }
	    }
        Garagem[i][ga_3D] = CreateDynamic3DTextLabel(sss, 0xffffff99, Garagem[i][ga_X], Garagem[i][ga_Y], Garagem[i][ga_Z], 15, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0, -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0);
	    Garagem[i][ga_Pickup] = CreateDynamicPickup(19132, 1, Garagem[i][ga_X], Garagem[i][ga_Y], Garagem[i][ga_Z], 0, 0, -1, STREAMER_PICKUP_SD, -1, 0);

		if(Garagem[i][ga_Dono] == -1 && Garagem[i][ga_Org] == -1 && Garagem[i][ga_Emprego] == -1)
		{
		    format(sss, 200, "\
			{ffff00}Estacionamento\n\
			\n\
			{a1a1a1}Buzine com o {ffffff}VEICULO {a1a1a1}para\n\
			guarda-lo na garagem");
		}
		else
		{
		    if(Garagem[i][ga_Dono] != -1)
		    {
		        format(sss, 200, "\
				{ffff00}Estacionamento\n\
				{ffffff}Dono: {a1a1a1}%s\n\
				\n\
				{a1a1a1}Buzine com o {ffffff}VEICULO {a1a1a1}para\n\
				guarda-lo na garagem", NomeConta(Garagem[i][ga_Dono]));
		    }

		    if(Garagem[i][ga_Org] != -1)
		    {
		        format(sss, 200, "\
				{ffff00}Estacionamento\n\
				{ffffff}Org: {a1a1a1}%s\n\
				\n\
				{a1a1a1}Buzine com o {ffffff}VEICULO {a1a1a1}para\n\
				guarda-lo na garagem", NomeOrg(Garagem[i][ga_Org]));
		    }

		    if(Garagem[i][ga_Emprego] != -1)
		    {
		        format(sss, 200, "\
				{ffff00}Estacionamento\n\
				{ffffff}Emprego: {a1a1a1}%s\n\
				\n\
				{a1a1a1}Buzine com o {ffffff}VEICULO {a1a1a1}para\n\
				guarda-lo na garagem", NomeEmprego(Garagem[i][ga_Emprego]));
		    }
		}
        Garagem[i][ga_3D2] = CreateDynamic3DTextLabel(sss, 0xffffff99, Garagem[i][ga_X2], Garagem[i][ga_Y2], Garagem[i][ga_Z2], 15, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0, -1, STREAMER_3D_TEXT_LABEL_SD, -1, 0);
	    Garagem[i][ga_Pickup2] = CreateDynamicPickup(1277, 1, Garagem[i][ga_X2], Garagem[i][ga_Y2], Garagem[i][ga_Z2], 0, 0, -1, STREAMER_PICKUP_SD, -1, 0);
     }
}


stock destruir_garagem(i)
{
    if(Garagem[i][ga_Existe] == 1)
	{
        Garagem[i][ga_Existe] = 0;
        foreach(new a:Iter_Veiculos)
		{
		    if(Veiculo[a][v_Existe] == 1)
		    {
		        if(Veiculo[a][v_Garagem_ID] == i)
		        {
					Veiculo[a][v_Garagem_ID] = -1;
					SalvarInfo(a);
				}
			}
		}
        atualizar_garagem(i);
        salvar_garagem(i);
    }
}

stock criar_garagem(Float:xx, Float:yy, Float:zz, valor)
{
	for(new i; i<MAX_GARAGEMS; i++)
	{
	    if(Garagem[i][ga_Existe] == 0)
	    {
	        Garagem[i][ga_Existe] = 1;
	        Garagem[i][ga_Dono] = -1;
	        Garagem[i][ga_Org] = -1;
	        Garagem[i][ga_Emprego] = -1;
			Garagem[i][ga_Valor] = valor;
			Garagem[i][ga_X] = xx;
			Garagem[i][ga_Y] = yy;
			Garagem[i][ga_Z] = zz;
			Garagem[i][ga_X2] = xx+2;
			Garagem[i][ga_Y2] = yy+2;
			Garagem[i][ga_Z2] = zz;
			atualizar_garagem(i);
			salvar_garagem(i);
			return i;
		}
	}
	return -1;
}

stock abrir_garagem_casa(playerid, c)
{
    new cont;
    if(Casa[c][casa_GarV] != -1)
    {
        new inf = Casa[c][casa_GarV];
        if(Veiculo[inf][v_Existe] == 1)
        {
            Menu[playerid][cont][menu_ID] = inf;
            Menu[playerid][cont][menu_Unidades] = 0;
            Menu[playerid][cont][menu_Tipo] = 777777;
            Menu[playerid][cont][menu_Valor] = 0;
            format(Menu[playerid][cont][menu_Nome], 200, "%s - %s", NomeVeiculo(Veiculo[inf][v_Modelo]), PlacaVeiculo[inf]);
            format(Menu[playerid][cont][menu_Info], 200, "~g~~h~RETIRAR DA GARAGEM");
            Menu[playerid][cont][menu_Modelo] = Veiculo[inf][v_Modelo];
            cont++;
        }
        else Casa[c][casa_GarV] = -1, salvar_casa(c);
    }
    foreach(new v:Iter_Veiculos)
    {
        if(cont >= MAX_MENU) break;
        if(Veiculo[v][v_Existe] == 1)
        {
            if(Veiculo[v][v_Dono] == id[playerid] && Veiculo[v][v_Garagem] == 0)
            {
                Menu[playerid][cont][menu_ID] = v;
                Menu[playerid][cont][menu_Unidades] = 1;
                Menu[playerid][cont][menu_Tipo] = 777777;
                Menu[playerid][cont][menu_Valor] = 0;
                format(Menu[playerid][cont][menu_Nome], 200, "%s - %s", NomeVeiculo(Veiculo[v][v_Modelo]), PlacaVeiculo[v]);
                format(Menu[playerid][cont][menu_Info], 200, "~r~~h~GUARDAR NA GARAGEM");
                Menu[playerid][cont][menu_Modelo] = Veiculo[v][v_Modelo];
                cont++;
            }
        }
    }
    if(cont == 0) return ms(playerid, 0, "Nenhum veiculo disponivel!");
    menu_id[playerid] = MENU_VEICULOS_CASA;
    format(nome_menu[playerid], 100, "Garagem da Casa");
    format(botao_menu[playerid], 100, "SELECIONAR");
    max_menu[playerid] = cont;
    escolhendo_menu[playerid] = 0;
    SetPVarInt(playerid, "casa_garagem_id", c);
    mostrar_menu(playerid, menu_id[playerid]);
    return 1;
}

stock abrir_garagem(playerid, g)
{
	new c = id[playerid];
	if(c != -1)
	{
	    new sss[200];
	    new cont;
	    if(Garagem[g][ga_Dono] != -1 && Garagem[g][ga_Dono] != c && ModoAdmin[playerid] == 0)
	    {
	        format(sss, 200, "Esta garagem pertence a '%s', apenas ele pode usar.", NomeConta(Garagem[g][ga_Dono]));
	        ms(playerid, 0, sss);
	    }
	    else if(Garagem[g][ga_Emprego] != -1 && Garagem[g][ga_Emprego] != EmpregoPlayer(playerid)  && ModoAdmin[playerid] == 0)
	    {
	        format(sss, 200, "Esta garagem pertence ao Emprego '%s', voce nao pode usar.", NomeEmprego(Garagem[g][ga_Emprego]));
	        ms(playerid, 0, sss);
	    }
		else if(Garagem[g][ga_Org] != -1 && Garagem[g][ga_Org] != OrgPlayer(playerid)  && ModoAdmin[playerid] == 0)
	    {
	        format(sss, 200, "Esta garagem pertence a Org '%s', voce nao pode usar.", NomeOrg(Garagem[g][ga_Org]));
	        ms(playerid, 0, sss);
	    }
	    else
	    {
		    // garagem sem dono nenhum //
		    if(Garagem[g][ga_Dono] == -1 && Garagem[g][ga_Org] == -1 && Garagem[g][ga_Emprego] == -1)
		    {
				foreach(new i:Iter_Veiculos)
				{
				    if(Veiculo[i][v_Existe] == 1 && Veiculo[i][v_Conce] == 0)
					{
					    if(Veiculo[i][v_Dono] == c && Veiculo[i][v_Garagem] == 1)
						{
						    Menu[playerid][cont][menu_ID] = i;
						    Menu[playerid][cont][menu_Unidades] = 0;
						    Menu[playerid][cont][menu_Tipo] = 666666;
						    Menu[playerid][cont][menu_Valor] = 0;
						    format(Menu[playerid][cont][menu_Nome], 200, "%05d - %s", i, NomeVeiculo(Veiculo[i][v_Modelo]));
							format(Menu[playerid][cont][menu_Info], 200, "\
							~w~Motor: ~y~%.0f~n~\
							~w~Bateria: ~y~%d~n~\
							~w~Gasolina: ~y~%d~n~\
							~w~Travas: %s", Veiculo[i][v_Vida]/10, Veiculo[i][v_Bateria], Veiculo[i][v_Gasolina], (Veiculo[i][v_Trancado] == 1)?"~y~~h~Trancado":"~g~~h~Aberto");
						    Menu[playerid][cont][menu_Modelo] = Veiculo[i][v_Modelo];
						    cont ++;
					    }
				    }
				}
				if(cont > 0)
				{
				    SetPVarInt(playerid, "gara", g);
					menu_id[playerid] = MENU_VEICULOS;
					format(nome_menu[playerid], 100, "Seus Veiculos nesta Garagem");
					format(botao_menu[playerid], 100, "PEGAR");
					max_menu[playerid] = cont;
					escolhendo_menu[playerid] = 0;
					mostrar_menu(playerid, menu_id[playerid]);
				}
				else ms(playerid, 0, "Voce nao tem um veiculo nesta garagem !");
			}
			else
			{
			    // se for do player //
			    if(Garagem[g][ga_Dono] != -1)
				{
				foreach(new i:Iter_Veiculos)
					{
					    if(Veiculo[i][v_Existe] == 1 && Veiculo[i][v_Conce] == 0)
						{
						    if(Veiculo[i][v_Dono] == c && Veiculo[i][v_Garagem] == 1)
							{
							if(Veiculo[i][v_Garagem_ID] == g)
							{
								    Menu[playerid][cont][menu_ID] = i;
								    Menu[playerid][cont][menu_Unidades] = 0;
								    Menu[playerid][cont][menu_Tipo] = 666666;
								    Menu[playerid][cont][menu_Valor] = 0;
								    format(Menu[playerid][cont][menu_Nome], 200, "%05d - %s", i, NomeVeiculo(Veiculo[i][v_Modelo]));
									format(Menu[playerid][cont][menu_Info], 200, "\
									~w~Motor: ~y~%.0f~n~\
									~w~Bateria: ~y~%d~n~\
									~w~Gasolina: ~y~%d~n~\
									~w~Travas: %s", Veiculo[i][v_Vida]/10, Veiculo[i][v_Bateria], Veiculo[i][v_Gasolina], (Veiculo[i][v_Trancado] == 1)?"~y~~h~Trancado":"~g~~h~Aberto");
								    Menu[playerid][cont][menu_Modelo] = Veiculo[i][v_Modelo];
								    cont ++;
								}
						    }
					    }
					}
					if(cont > 0)
					{
					    SetPVarInt(playerid, "gara", g);
						menu_id[playerid] = MENU_VEICULOS;
						format(nome_menu[playerid], 100, "Seus Veiculos nesta Garagem");
						format(botao_menu[playerid], 100, "PEGAR");
						max_menu[playerid] = cont;
						escolhendo_menu[playerid] = 0;
						mostrar_menu(playerid, menu_id[playerid]);
					}
					else ms(playerid, 0, "Voce nao tem um veiculo nesta garagem !");
			    }

			    // se for do emprego dele //
			    if(Garagem[g][ga_Emprego] != -1)
				{
				new e = Garagem[g][ga_Emprego];
				foreach(new i:Iter_Veiculos)
					{
					    if(Veiculo[i][v_Existe] == 1 && Veiculo[i][v_Conce] == 0)
						{
						    if(Veiculo[i][v_Emprego] == e && Veiculo[i][v_Garagem] == 1)
							{
							if(Veiculo[i][v_Garagem_ID] == g)
							{
								    Menu[playerid][cont][menu_ID] = i;
								    Menu[playerid][cont][menu_Unidades] = 0;
								    Menu[playerid][cont][menu_Tipo] = 666666;
								    Menu[playerid][cont][menu_Valor] = 0;
								    format(Menu[playerid][cont][menu_Nome], 200, "%05d - %s", i, NomeVeiculo(Veiculo[i][v_Modelo]));
									format(Menu[playerid][cont][menu_Info], 200, "\
									~w~Motor: ~y~%.0f~n~\
									~w~Bateria: ~y~%d~n~\
									~w~Gasolina: ~y~%d~n~\
									~w~Travas: %s", Veiculo[i][v_Vida]/10, Veiculo[i][v_Bateria], Veiculo[i][v_Gasolina], (Veiculo[i][v_Trancado] == 1)?"~y~~h~Trancado":"~g~~h~Aberto");
								    Menu[playerid][cont][menu_Modelo] = Veiculo[i][v_Modelo];
								    cont ++;
								}
						    }
					    }
					}
					if(cont > 0)
					{
					    SetPVarInt(playerid, "gara", g);
						menu_id[playerid] = MENU_VEICULOS;
						format(nome_menu[playerid], 100, "'%s'", NomeEmprego(e));
						format(botao_menu[playerid], 100, "PEGAR");
						max_menu[playerid] = cont;
						escolhendo_menu[playerid] = 0;
						mostrar_menu(playerid, menu_id[playerid]);
					}
					else ms(playerid, 0, "Nenhum veiculo do emprego nesta garagem no momento !");
			    }

			    // se for da Org dele //
			    if(Garagem[g][ga_Org] != -1)
				{
				new e = Garagem[g][ga_Org];
				foreach(new i:Iter_Veiculos)
					{
					    if(Veiculo[i][v_Existe] == 1 && Veiculo[i][v_Conce] == 0)
						{
						    if(Veiculo[i][v_Org] == e && Veiculo[i][v_Garagem] == 1)
							{
							if(Veiculo[i][v_Garagem_ID] == g)
							{
								    Menu[playerid][cont][menu_ID] = i;
								    Menu[playerid][cont][menu_Unidades] = 0;
								    Menu[playerid][cont][menu_Tipo] = 666666;
								    Menu[playerid][cont][menu_Valor] = 0;
								    format(Menu[playerid][cont][menu_Nome], 200, "%05d - %s", i, NomeVeiculo(Veiculo[i][v_Modelo]));
									format(Menu[playerid][cont][menu_Info], 200, "\
									~w~Motor: ~y~%.0f~n~\
									~w~Bateria: ~y~%d~n~\
									~w~Gasolina: ~y~%d~n~\
									~w~Travas: %s", Veiculo[i][v_Vida]/10, Veiculo[i][v_Bateria], Veiculo[i][v_Gasolina], (Veiculo[i][v_Trancado] == 1)?"~y~~h~Trancado":"~g~~h~Aberto");
								    Menu[playerid][cont][menu_Modelo] = Veiculo[i][v_Modelo];
								    cont ++;
								}
						    }
					    }
					}
					if(cont > 0)
					{
					    SetPVarInt(playerid, "gara", g);
						menu_id[playerid] = MENU_VEICULOS;
						format(nome_menu[playerid], 100, "'%s'", NomeOrg(e));
						format(botao_menu[playerid], 100, "PEGAR");
						max_menu[playerid] = cont;
						escolhendo_menu[playerid] = 0;
						mostrar_menu(playerid, menu_id[playerid]);
					}
					else ms(playerid, 0, "Nenhum veiculo da Org nesta garagem no momento !");
			    }
			}
		}
	}
}

stock pegar_garagem(playerid)
{
	for(new g; g<MAX_GARAGEMS; g++)
	{
		if(Garagem[g][ga_Org] != -1) continue;
		if(Garagem[g][ga_Emprego] != -1) continue;
	    if(IsPlayerInRangeOfPoint(playerid, 50, Garagem[g][ga_X], Garagem[g][ga_Y], Garagem[g][ga_Z]))
	    {
	        return g;
	    }
	}
	return -1;
}

BCG:: spawn_actors()
{
	for(new i; i<MAX_BOOTS; i++)
	{
		if(Actor[i][a_Existe] == 1)
		{
		    atualizar_actor(i);
		}
	}
}

