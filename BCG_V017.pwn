	        TextDrawShowForPlayer(playerid, T_Celular_Barra[2]);
            for(new b; b<sizeof T_Celular_Uber; b++) TextDrawShowForPlayer(playerid, T_Celular_Uber[b]);
		    for(new c; c<sizeof T_Celular_GPS; c++) TextDrawShowForPlayer(playerid, T_Celular_GPS[c]);
		    for(new d; d<sizeof T_Celular_Itau; d++) TextDrawShowForPlayer(playerid, T_Celular_Itau[d]);
		    for(new e; e<sizeof T_Celular_Radio; e++) TextDrawShowForPlayer(playerid, T_Celular_Radio[e]);
		    for(new a; a<sizeof T_Celular_Blaze; a++) TextDrawShowForPlayer(playerid, T_Celular_Blaze[a]);
		    for(new g; g<sizeof T_Celular_Blu; g++) TextDrawShowForPlayer(playerid, T_Celular_Blu[g]);
		    for(new h; h<sizeof T_Celular_WP; h++) TextDrawShowForPlayer(playerid, T_Celular_WP[h]);
