stock mostrar_moveis_na_casa(playerid, i, ststs)
{
    new c = id[playerid];
    if(c != -1)
	{
		if(Casa[i][casa_Existe] == 1)
		{
		    new cont;
		    new Float:dist;
		    new Float:p[3];
		    new movel;
		    new sss[200];
		    SG[0] = EOS;
		    zerar_lista(playerid);
		    GetPlayerPos(playerid, p[0], p[1], p[2]);
		    for(new a; a<MAX_MOVEIS; a++)
		    {
		        if(Casa[i][casa_m_Existe][a] == 1)
		        {
		            if(Casa[i][casa_m_Status][a] == ststs)
		            {
		                movel = Casa[i][casa_m_ID][a];
		                GetDistance(dist, p[0], p[1], p[2], Casa[i][casa_m_X][a], Casa[i][casa_m_Y][a], Casa[i][casa_m_Z][a]);
						if(ststs == 1) format(sss, 200, "{ffffff}%s\t{a1a1a1}%.0f Metros\n", moveis[movel][mov_Nome], dist);
	                	if(ststs == 0) format(sss, 200, "{ffffff}%s\n", moveis[movel][mov_Nome]);
	                	strcat(SG, sss);
	                	Lista[playerid][cont] = a;
						cont++;
		            }
		        }
		    }
		    if(ststs == 1) format(sss, 200, "{ffffff}Moveis no Lugar [{ffff00}%d{ffffff}]", cont);
			if(ststs == 0) format(sss, 200, "{ffffff}Moveis Guardados [{ffff00}%d{ffffff}]", cont);
		    if(ststs == 1) ShowPlayerDialog(playerid, DIALOG_MOVEIS_NO_LUGAR, DIALOG_STYLE_TABLIST, sss, SG, "Continuar", "Voltar");
		    if(ststs == 0) ShowPlayerDialog(playerid, DIALOG_MOVEIS_GUARDADOS, DIALOG_STYLE_LIST, sss, SG, "Continuar", "Voltar");
		}
	}
}

