	// dialog localizar portao //
	if(dialogid == DIALOG_PORTOES1)
	{
	    if(response)
    	{
    	    if(c == -1) return 1;
    	    new a = GetPVarInt(playerid, "id_portao");
    	    if(listitem == 0)
    	    {
    	        // localizar //
    	        Localizar_Player(playerid, Portao[a][p_X1], Portao[a][p_Y1], Portao[a][p_Z1], 73, a, "Portao");
				ms(playerid, 2, "Siga ate a marca vermelha de seu mapa para localizar seu Portao.");
    	    }

    	    if(listitem == 1)
    	    {
    	        // guardar //
    	        new Float:distt, Float:pos[3];
				GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
		        GetDistance(distt, Portao[a][p_X1], Portao[a][p_Y1], Portao[a][p_Z1], pos[0], pos[1], pos[2]);
    	        if(distt > 10.0)
    	        {
    	            ms(playerid, 0, "Voce precisa estar proximo ao portao para guarda - lo em seu invetario !");
    	            mostrar_opcoes_portao(playerid, a);
    	        }
    	        else
    	        {
    	            if(!add_inv(c, 88, 1, Portao[a][p_Modelo], 1, Portao[a][p_Tempo]))
    	            {
    	                ms(playerid, 0, "Seu Inventario esta lotado !");
    	                mostrar_opcoes_portao(playerid, a);
    	            }
    	            else
    	            {
    	                ms(playerid, 1, "Voce guardou o portao em seu inventario !");
    	                destruir_portao(a);
    	                mostrar_portoes(playerid);
    	            }
    	        }
    	    }

    	    if(listitem == 2)
    	    {
				// pos fechado //
				EditandoPortao[playerid] = a;
				SetPVarInt(playerid, "editando_portao", 0);
				EditDynamicObject2(playerid, Portao[a][p_Obj]);
				ms(playerid, 1, "Movimente o portao usando o editor de objeto e salve a posicao dele fechado.");
    	    }

    	    if(listitem == 3)
    	    {
				// pos aberto //
				EditandoPortao[playerid] = a;
				SetPVarInt(playerid, "editando_portao", 1);
				EditDynamicObject2(playerid, Portao[a][p_Obj]);
				ms(playerid, 1, "Movimente o portao usando o editor de objeto e salve a posicao dele aberto.");
    	    }

    	    if(listitem == 4)
    	    {
    	        // renovar //
    	        if(CashPlayer(playerid) < 6)
    	        {
					ms(playerid, 0, "Voce nao tem Cash suficiente !");
    	           	mostrar_opcoes_portao(playerid, a);
    	        }
    	        else
    	        {
    	            DarCash(playerid, -6);
    	            Portao[a][p_Tempo] += 3*UM_DIA;
    	            ms(playerid, 1, "Voce renovou 3 Dias do portao por R$ 6 Cash !");
    	            mostrar_opcoes_portao(playerid, a);
    	            salvar_portao(a);
    	        }
    	    }
	    }
	    else mostrar_portoes(playerid);
	    return 1;
	}

