		if(valor < 1 || valor > 250000) return ms(playerid, 0, "Use um valor entre R$ 1 ate R$ 250.000 !");
		format(sss, 300, "Voce nao tem R$ %s em maos !", ConvertMoney(valor));
		if(GranaPlayer(playerid) < valor) return MS(playerid, 0, sss);
		SetPVarInt(playerid, "valor", valor);
		PlayersPerto(playerid, 10, 2);
