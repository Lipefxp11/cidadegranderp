	    new o;
		if(sscanf(params, "d", o)) return ms(playerid, 2, "Use: /criargaragemcasa [ ID da Casa ]");
		if(o < 0 || o >= MAX_CASAS) return ms(playerid, 0, "ID de Casa invalido !");
		if(Casa[o][casa_Existe] == 0) return ms(playerid, 0, "Esta Casa nao existe !");
		if(Casa[o][casa_Garagem] == 1) return ms(playerid, 0, "Esta casa ja possui uma garagem !");
		GetPlayerPos(playerid, Casa[o][casa_GarX], Casa[o][casa_GarY], Casa[o][casa_GarZ]);
		Casa[o][casa_GarMundo] = GetPlayerVirtualWorld_(playerid);
		Casa[o][casa_GarInterior] = GetPlayerInterior(playerid);
		Casa[o][casa_Garagem] = 1;
		atualizar_casa(o);
		salvar_casa(o);
		ms(playerid, 1, f("Garagem criada na Casa ID: %d!", o));
		return 1;
	}

	if(!strcmp(cmd, "/tipocasa", true))
	{
	    new o, t;
		if(sscanf(params, "dd", o, t)) return ms(playerid, 2, "Use: /tipocasa [ ID da Casa ] [ 0 ou 1]"), ms(playerid, 2, "Use 0 para Casa em interior."), ms(playerid, 2, "Use 1 para Apartamento, interior aberto no mapa.");
		if(o < 0 || o >= MAX_CASAS) return ms(playerid, 0, "ID de Casa invalido !");
		if(Casa[o][casa_Existe] == 0) return ms(playerid, 0, "Esta Casa nao existe !");
		if(t != 0 && t != 1) return ms(playerid, 2, "Use 0 para Casa em interior."), ms(playerid, 2, "Use 1 para Apartamento, interior aberto no mapa.");

		if(t == 0)
		{		
			Casa[o][casa_X3] = 0.0;
			Casa[o][casa_Y3] = 0.0;
			Casa[o][casa_Z3] = 0.0;
		    Casa[o][casa_X2] = 244.411987;
			Casa[o][casa_Y2] = 305.032989;
			Casa[o][casa_Z2] = 999.148437;
		    Casa[o][casa_Interior] = 1;
		    Casa[o][casa_Mundo] = o;
		    Casa[o][casa_Tipo] = 0;
		}

		if(t == 1)
		{
		    Casa[o][casa_Interior] = 0;
		    Casa[o][casa_Mundo] = 0;
		    Casa[o][casa_Tipo] = 1;
			Casa[o][casa_X3] = 0.0;
			Casa[o][casa_Y3] = 0.0;
			Casa[o][casa_Z3] = 0.0;
		}

		new sss[150];
		format(sss, 150, "Voce setou o tipo da casa ID: %d, para '%s'.", o, tipo_casa(o));
		ms(playerid, 5, sss);
		atualizar_casa(o);
		salvar_casa(o);
		return 1;
	}

