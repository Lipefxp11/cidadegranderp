forward LimparChatTimer();
public LimparChatTimer()
{
    foreach(new i:Player) SSM(i, 0x00000000, ""); // BCG: uma unica limpeza, evita flood/RPC
    return 1;
}

BCG:: iniciar_servidor()
{
    CREDITOS();
	if(DOF2_FileExists("Server/Modo.txt")) carregamento_rapido = DOF2_GetInt("Server/Modo.txt", "Modo");
	else
	{
	    carregamento_rapido = 0;
	    DOF2_CreateFile("Server/Modo.txt");
	    DOF2_SetInt("Server/Modo.txt", "Modo", 0);
	    DOF2_SaveFile();
	}

	new file_con[80];
	for(new p; p<MAX_PLAYERS; p++) Nome_Player[p] = Create3DTextLabel(".", -1, 0.0, 0.0, 0.0, 10.0, 0, false), Localizando_3D[p] = DynamicText3D:-1;
    for(new ca; ca<MAX_CASAS; ca++) for(new a; a<MAX_COMPRAS; a++) Compras[ca][com_Movel][a] = -1;
    for(new a; a<MAX_JBL; a++) JBL[a][jbl_3D] = DynamicText3D:-1;
	for(new ex; ex<MAX_EXPLOSIVOS; ex++) Explosivo[ex][explosivo_3D] = DynamicText3D:-1;
	for(new g; g<MAX_VEHICLES; g++) Blutuf_Veiculo[g] = -1, escada_veiculo[g] = -1;
	for(new i; i<MAX_CONTAS; i++)
	{
	    conta_existe[i] = 0;
		player_conta[i] = -1;
		format(file_con, 80, "Contas/%d.txt", i);
		if(DOF2_FileExists(file_con))
		{
			conta_existe[i] = 1;
			Iter_Add(Iter_Contas, i);
		}
	}

	for(new v; v<MAX_VEHICLES; v++)
	{
		Info_Veiculo[v] = -1;
		SetVehicleMaxSpeed(v, 0);
	}
	SetTimer("mudarcorestela", 500, true); // BCG OPT: 5x/s -> 2x/s
	if(carregamento_rapido == 1){
	    carregar_servidor();
	}
	gz_policia = GZ_CriarGz(0, 0, 6000, 6000, 0, 0xff000080);
	SetTimer("Tempo", 1000, true); 
	SetTimer("AcertarPayDay", 30*60000, true);

	// logomarca
	LogoMarca[0] = TextDrawCreate(310.000000, 3.000000, "CIDADE GRANDE");
	TextDrawFont(LogoMarca[0], 3);
	TextDrawLetterSize(LogoMarca[0], 0.374998, 2.149998);
	TextDrawTextSize(LogoMarca[0], 400.000000, 17.000000);
	TextDrawSetOutline(LogoMarca[0], 0);
	TextDrawSetShadow(LogoMarca[0], 0);
	TextDrawAlignment(LogoMarca[0], 1);
	TextDrawColor(LogoMarca[0], -1);
	TextDrawBackgroundColor(LogoMarca[0], 255);
	TextDrawBoxColor(LogoMarca[0], 50);
	TextDrawUseBox(LogoMarca[0], 0);
	TextDrawSetProportional(LogoMarca[0], 1);
	TextDrawSetSelectable(LogoMarca[0], 0);

	LogoMarca[1] = TextDrawCreate(311.000000, 21.000000, "R O L E P L A Y");
	TextDrawFont(LogoMarca[1], 1);
	TextDrawLetterSize(LogoMarca[1], 0.137498, 0.600000);
	TextDrawTextSize(LogoMarca[1], 400.000000, 17.000000);
	TextDrawSetOutline(LogoMarca[1], 0);
	TextDrawSetShadow(LogoMarca[1], 0);
	TextDrawAlignment(LogoMarca[1], 1);
	TextDrawColor(LogoMarca[1], -1);
	TextDrawBackgroundColor(LogoMarca[1], 255);
	TextDrawBoxColor(LogoMarca[1], 50);
	TextDrawUseBox(LogoMarca[1], 0);
	TextDrawSetProportional(LogoMarca[1], 1);
	TextDrawSetSelectable(LogoMarca[1], 0);

	return 1;
}

stock guardar_todos_veiculos()
{
    foreach(new i:Iter_Veiculos)
    {
        if(Veiculo[i][v_Existe] == 1 && Veiculo[i][v_Garagem] == 0)
        {
            new veh = Veiculo[i][v_ID];
            if(GetVehicleModel(veh) != 0)
            {
                new ocupado;
                foreach(new p:Player)
                {
                    if(IsPlayerInVehicle(p, veh)) ocupado = 1;
                }
                if(!ocupado)
                {
                    GetVehiclePos(veh, Veiculo[i][v_X], Veiculo[i][v_Y], Veiculo[i][v_Z]);
                    GetVehicleZAngle(veh, Veiculo[i][v_A]);
                    Veiculo[i][v_Garagem] = 1;
                    if(Veiculo[i][v_PlacaLabel] != DynamicText3D:-1)
                    {
                        DestroyDynamic3DTextLabel(Veiculo[i][v_PlacaLabel]);
                        Veiculo[i][v_PlacaLabel] = DynamicText3D:-1;
                    }
                    SalvarInfo(i);
                    Info_Veiculo[veh] = -1;
                    DestroyVehicle_(veh);
                }
            }
        }
    }
}

public OnGameModeExit()
{
    guardar_todos_veiculos();
    DOF2_Exit();
    for(new i; i<10; i++) TextDrawDestroy(IFOOD_TD[i]);
	return 1;
}

BCG:: SetVehicleMaxSpeed(vehicleid, prct)
{
	if(vehicleid >= 0 && vehicleid < MAX_VEHICLES)
	{
    	VMUpgrades[vehicleid] = prct;
    }
}

public OnPlayerWeaponShot(playerid, weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ)
{
    if(logado[playerid] == 0) return 1;
	if(weaponid == 23)
	{
	    if(Taser(playerid))
	    {
	        SetPlayerAmmo(playerid, 23, 999);
			return 0;
	    }
	}
	
	if(hittype == BULLET_HIT_TYPE_VEHICLE)
	{	
		new veh = hitid;
		if(GetVehicleModel(veh) != 0)
		{
			new model = GetVehicleModel(veh);
			new i = Info_Veiculo[veh];
			if(i != -1)
			{
				new Float:d;	
				new a = model-400;	
				if(pneus_veiculos[a] > 0)
				{
					if(pneus_veiculos[a] == 2)
					{
						if(Veiculo[i][v_Pneu][1] == 0)
						{
							GetDistance(d, fX, fY, fZ, pos_pneus[a][0][0], pos_pneus[a][0][1], pos_pneus[a][0][2]);	
							if(d < 0.6) 
							{
								Veiculo[i][v_Pneu][1] = 1;
								update_danos_veiculo(veh, i);
								MS(playerid, 2, "Voce acertou um Pneu do veiculo !");
								foreach(new p:Player) if(Online(p)) if(IsPlayerInVehicle(p, veh)) GameTextForPlayer( p, "PNEU FURADO" , 5000 , 1 );
							}
						}
						
						if(Veiculo[i][v_Pneu][0] == 0)
						{
							GetDistance(d, fX, fY, fZ, pos_pneus[a][1][0], pos_pneus[a][1][1], pos_pneus[a][1][2]);	
							if(d < 0.6) 
							{
								Veiculo[i][v_Pneu][0] = 1;
								update_danos_veiculo(veh, i);
								MS(playerid, 2, "Voce acertou um Pneu do veiculo !");
								foreach(new p:Player) if(Online(p)) if(IsPlayerInVehicle(p, veh)) GameTextForPlayer( p, "PNEU FURADO" , 5000 , 1 );
							}
						}
						
					}
					else if(pneus_veiculos[a] == 4)
					{
	
						if(Veiculo[i][v_Pneu][0] == 0)
						{
							GetDistance(d, fX, fY, fZ, pos_pneus[a][2][0], pos_pneus[a][2][1], pos_pneus[a][2][2]);	
							if(d < 0.6) 
							{
								Veiculo[i][v_Pneu][0] = 1;
								update_danos_veiculo(veh, i);
								MS(playerid, 2, "Voce acertou um Pneu do veiculo !");
								foreach(new p:Player) if(Online(p)) if(IsPlayerInVehicle(p, veh)) GameTextForPlayer( p, "PNEU FURADO" , 5000 , 1 );
							}
						}
						
						if(Veiculo[i][v_Pneu][3] == 0)
						{
							GetDistance(d, fX, fY, fZ, pos_pneus[a][0][0], pos_pneus[a][0][1], pos_pneus[a][0][2]);			
							if(d < 0.6)
							{
								Veiculo[i][v_Pneu][3] = 1;
								update_danos_veiculo(veh, i);
								MS(playerid, 2, "Voce acertou um Pneu do veiculo !");
								foreach(new p:Player) if(Online(p)) if(IsPlayerInVehicle(p, veh)) GameTextForPlayer( p, "PNEU FURADO" , 5000 , 1 );
							}
						}
						
						if(Veiculo[i][v_Pneu][2] == 0)
						{
							GetDistance(d, fX, fY, fZ, pos_pneus[a][1][0], pos_pneus[a][1][1], pos_pneus[a][1][2]);			
							if(d < 0.6) 
							{
								Veiculo[i][v_Pneu][2] = 1;
								update_danos_veiculo(veh, i);
								MS(playerid, 2, "Voce acertou um Pneu do veiculo !");
								foreach(new p:Player) if(Online(p)) if(IsPlayerInVehicle(p, veh)) GameTextForPlayer( p, "PNEU FURADO" , 5000 , 1 );
							}
						}
						
						if(Veiculo[i][v_Pneu][1] == 0)
						{
							GetDistance(d, fX, fY, fZ, pos_pneus[a][3][0], pos_pneus[a][3][1], pos_pneus[a][3][2]);		
							if(d < 0.6)
							{
								Veiculo[i][v_Pneu][1] = 1;
								update_danos_veiculo(veh, i);
								MS(playerid, 2, "Voce acertou um Pneu do veiculo !");
								foreach(new p:Player) if(Online(p)) if(IsPlayerInVehicle(p, veh)) GameTextForPlayer( p, "PNEU FURADO" , 5000 , 1 );
							}
						}
					}
				}				
			}
		}
		return 1;
	}
	
	new c = id[playerid];
	if(c != -1)
	{
		new slo = slot_arma(weaponid);
		if(slo >= 2 && slo <= 6)
		{
			new mun = GetPlayerAmmo(playerid);
			if(mun == 1)
			{
				new achou;
				for(new a; a<MAX_SLOTS; a++)
				{
					if(Inventario[playerid][a][inv_ID] == 0)
					{
						Inventario[playerid][a][inv_ID] = arma_id(weaponid);
					    Inventario[playerid][a][inv_Unidades] = 1;
					    Inventario[playerid][a][inv_Tipo] = slo;
					    salvar_inventario(c, a);
						ms(playerid, 2, f("A arma '%s' ficou sem municao e foi guardada em seu inventario !", nome_arma(weaponid)));
						SetPlayerAmmo(playerid, weaponid, 0);
						salvar_armas(playerid, 1);
						achou = 1;
						break;
					}
				}
				if(!achou)
				{
					new Float:ps[3];
					GetPlayerPos(playerid, ps[0],ps[1],ps[2]);
					criar_item(arma_id(weaponid), ps[0], ps[1], ps[2], 1, GetPlayerVirtualWorld_(playerid), GetPlayerInterior(playerid), slo);
					ms(playerid, 2, f("A arma '%s' ficou sem municao e foi Dropada, inventario Lotado !", nome_arma(weaponid)));
					SetPlayerAmmo(playerid, weaponid, 0);
					salvar_armas(playerid, 1);
				}
				return 0;
			}
		}
	}

	if(perto_caixa[playerid] != -1)
	{
	    new i = perto_caixa[playerid];
	    if(IsPlayerInRangeOfPoint(playerid, 25, CaixaEletronico[i][cec_X], CaixaEletronico[i][cec_Y], CaixaEletronico[i][cec_Z]))
	    {
	        new Float:fOriginX, Float:fOriginY, Float:fOriginZ, Float:fHitPosX, Float:fHitPosY, Float:fHitPosZ;
        	GetPlayerLastShotVectors(playerid, fOriginX, fOriginY, fOriginZ, fHitPosX, fHitPosY, fHitPosZ);
            new danoo2;
		    new danoo = 30;
		    new Float:diss;
		    if(dano_arma(weaponid, danoo2)) danoo = danoo2;
            GetDistance(diss, fHitPosX, fHitPosY, fHitPosZ, CaixaEletronico[i][cec_X], CaixaEletronico[i][cec_Y], CaixaEletronico[i][cec_Z]);
            if(diss <= 0.7)
            {
                if(CaixaEletronico[i][cec_Vida] >= 0)
                {
                    CaixaEletronico[i][cec_Vida] -= danoo;
                    if(CaixaEletronico[i][cec_Vida] < 0)
                    {
                        CaixaEletronico[i][cec_Vida] = -1;
                        quebrar_camera(playerid, i, 1);
                        return 0;
                    }
                }
            }
		}
	}
	else
	{
	    if(atirou_camera[playerid] == 0)
	    {
	        atirou_camera[playerid] = 1;
	        foreach(new i:Iter_CaixasEletronicos)
	        {
	            if(IsPlayerInRangeOfPoint(playerid, 25, CaixaEletronico[i][cec_X], CaixaEletronico[i][cec_Y], CaixaEletronico[i][cec_Z]))
	            {
	                perto_caixa[playerid] = i;
	                break;
	            }
	        }
	    }
	}

	if(perto_camera[playerid] != -1)
	{
	    new a = perto_camera[playerid];
	    if(IsPlayerInRangeOfPoint(playerid, 25, Camera[a][cam_X], Camera[a][cam_Y], Camera[a][cam_Z]))
	    {
	        new Float:fOriginX, Float:fOriginY, Float:fOriginZ, Float:fHitPosX, Float:fHitPosY, Float:fHitPosZ;
        	GetPlayerLastShotVectors(playerid, fOriginX, fOriginY, fOriginZ, fHitPosX, fHitPosY, fHitPosZ);
            new danoo2;
		    new danoo = 30;
		    new Float:diss;
		    if(dano_arma(weaponid, danoo2)) danoo = danoo2;
	        GetDistance(diss, fHitPosX, fHitPosY, fHitPosZ, Camera[a][cam_X], Camera[a][cam_Y], Camera[a][cam_Z]);
			if(diss <= 0.5)
		  	{
                if(Camera[a][cam_Vida] >= 0)
                {
                    Camera[a][cam_Vida] -= danoo;
                    if(Camera[a][cam_Vida] < 0)
                   {
                        Camera[a][cam_Vida] = -1;
                        quebrar_camera(playerid, a, 0);
                        return 0;
                    }
                }
            }
		}
	}
	else
	{
	    if(atirou_camera[playerid] == 0)
	    {
	        atirou_camera[playerid] = 1;
	        foreach(new a:Iter_Cameras)
	        {
	            if(IsPlayerInRangeOfPoint(playerid, 25,  Camera[a][cam_X], Camera[a][cam_Y], Camera[a][cam_Z]))
	            {
	                perto_camera[playerid] = a;
	                break;
	            }
	        }
	    }
	}

	return 1;
}

