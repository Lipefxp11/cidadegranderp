	    {
		    if(tipo_atu[playerid] == 0) PlayerTextDrawSetString(playerid, T_MS_p[playerid][1], "LD_CHAT:thumbdn");
			if(tipo_atu[playerid] == 1) PlayerTextDrawSetString(playerid, T_MS_p[playerid][1], "LD_CHAT:thumbup");
			if(tipo_atu[playerid] == 2) PlayerTextDrawSetString(playerid, T_MS_p[playerid][1], "LD_CHAT:goodcha");
