							{
							// items de segurar //
							for(new s; s<sizeof itens_segurando; s++)
							{
							    if(itens_segurando[s][seg_Modelo] == Itens[Bau[v][i][inv_ID]][item_Modelo])
								{
							        if(Bau[v][i][inv_ID] == itens_segurando[s][seg_ID])
							        {
							            if(segurando_player[playerid] != -1)
											{
											MS(playerid, 0, "Voce ja esta com algo nas maos, largue primeiro para fazer isso !");
											return 1;
										    }
										    segurar(playerid, s, Bau[v][i][inv_Unidades], Bau[v][i][inv_Tipo], Bau[v][i][inv_Ativo], Bau[v][i][inv_Tempo]);
										    Bau[v][i][inv_ID] = 0;
							            Bau[v][i][inv_Unidades] = 0;
							            Bau[v][i][inv_Tipo] = 0;
							            Bau[v][i][inv_Ativo] = 0;
							            Bau[v][i][inv_Tempo] = 0;
							            GameTextForPlayer(playerid, "~g~~h~ITEM RECOLHIDO", 1000, 3);
							            fechar_menu(playerid);
							            foreach(new pla:Player) if(bau_player(pla) == v) abrir_bau_casa(pla, v);
											salvar_bau(v, i);
											mostrando_bau[playerid] = -1;
											return 1;
										}
									}
							}

							for(new ii; ii<MAX_SLOTS; ii++)
							{
							    if(Inventario[playerid][ii][inv_ID] == 0)
								{
					                Inventario[playerid][ii][inv_ID] = Bau[v][i][inv_ID];
					                Inventario[playerid][ii][inv_Unidades] = Bau[v][i][inv_Unidades];
					                Inventario[playerid][ii][inv_Tipo] = Bau[v][i][inv_Tipo];
					                Inventario[playerid][ii][inv_Ativo] = Bau[v][i][inv_Ativo];
					                Inventario[playerid][ii][inv_Tempo] = Bau[v][i][inv_Tempo];
					                Bau[v][i][inv_ID] = 0;
					                Bau[v][i][inv_Unidades] = 0;
					                Bau[v][i][inv_Tipo] = 0;
					                Bau[v][i][inv_Ativo] = 0;
					                Bau[v][i][inv_Tempo] = 0;
					                GameTextForPlayer(playerid, "~g~~h~ITEM RECOLHIDO", 1000, 3);
										foreach(new pla:Player) if(bau_player(pla) == v) abrir_bau_casa(pla, v);
										salvar_inventario(conta, ii);
										salvar_bau(v, i);
										return 1;
							    }
							}
						    GameTextForPlayer(playerid, "~r~~h~INVENTAR LOTADO", 1000, 3);
					    }

						}
		        		return 1;
					}
		        }
			}
	    }
	}


	//fechar_menu(playerid, 1);
	fechar_menu(playerid);
	return 1;
}

stock objetos_do_veiculo(vehicleid)
{
	// neon //
	if(IsValidDynamicObject(neon_veiculo[vehicleid])) DestroyDynamicObject_(neon_veiculo[vehicleid]);
	if(IsValidDynamicObject(xenon_veiculo[vehicleid])) DestroyDynamicObject_(xenon_veiculo[vehicleid]);

	// pedras do veiculo minerador //
	for(new a; a<10; a++) if(IsValidDynamicObject(pedras_obj[vehicleid][a])) DestroyDynamicObject_(pedras_obj[vehicleid][a]);

	// madeiras do veiculo lenhador //
	for(new a; a<10; a++) if(IsValidDynamicObject(madeiras_obj[vehicleid][a])) DestroyDynamicObject_(madeiras_obj[vehicleid][a]);

	// caminhoneiro //
	if(IsValidDynamicObject(carga_objeto[vehicleid][0])) DestroyDynamicObject_(carga_objeto[vehicleid][0]);
	if(IsValidDynamicObject(carga_objeto[vehicleid][1])) DestroyDynamicObject_(carga_objeto[vehicleid][1]);
	if(IsValidDynamicObject(carga_objeto[vehicleid][2])) DestroyDynamicObject_(carga_objeto[vehicleid][2]);

    // botijoes de gas //
	if(IsValidDynamicObject(botijao_objeto[vehicleid][0])) DestroyDynamicObject_(botijao_objeto[vehicleid][0]);
	if(IsValidDynamicObject(botijao_objeto[vehicleid][1])) DestroyDynamicObject_(botijao_objeto[vehicleid][1]);
	if(IsValidDynamicObject(botijao_objeto[vehicleid][2])) DestroyDynamicObject_(botijao_objeto[vehicleid][2]);
	if(IsValidDynamicObject(botijao_objeto[vehicleid][3])) DestroyDynamicObject_(botijao_objeto[vehicleid][3]);
	if(IsValidDynamicObject(botijao_objeto[vehicleid][4])) DestroyDynamicObject_(botijao_objeto[vehicleid][4]);
	if(IsValidDynamicObject(botijao_objeto[vehicleid][5])) DestroyDynamicObject_(botijao_objeto[vehicleid][5]);

	// objetos nome sedex //
	if(IsValidDynamicObject(sedex_objeto[vehicleid][0])) DestroyDynamicObject_(sedex_objeto[vehicleid][0]);
	if(IsValidDynamicObject(sedex_objeto[vehicleid][1])) DestroyDynamicObject_(sedex_objeto[vehicleid][1]);
	if(IsValidDynamicObject(sedex_objeto[vehicleid][2])) DestroyDynamicObject_(sedex_objeto[vehicleid][2]);

	// objetos nome uber //
	if(IsValidDynamicObject(uber_objeto[vehicleid][0])) DestroyDynamicObject_(uber_objeto[vehicleid][0]);
	if(IsValidDynamicObject(uber_objeto[vehicleid][1])) DestroyDynamicObject_(uber_objeto[vehicleid][1]);

	// objetos veiculo mecanico //
	if(IsValidDynamicObject(mecanico_objeto[vehicleid][0])) DestroyDynamicObject_(mecanico_objeto[vehicleid][0]);
	if(IsValidDynamicObject(mecanico_objeto[vehicleid][1])) DestroyDynamicObject_(mecanico_objeto[vehicleid][1]);
	if(IsValidDynamicObject(mecanico_objeto[vehicleid][2])) DestroyDynamicObject_(mecanico_objeto[vehicleid][2]);
	if(IsValidDynamicObject(mecanico_objeto[vehicleid][3])) DestroyDynamicObject_(mecanico_objeto[vehicleid][3]);

 	// escada eletricista //
	if(IsValidDynamicObject(escada_obj[vehicleid])) DestroyDynamicObject_(escada_obj[vehicleid]);

	// objetos veiculo auto escola //
	if(IsValidDynamicObject(objeto_teste[vehicleid][0])) DestroyDynamicObject_(objeto_teste[vehicleid][0]);
	if(IsValidDynamicObject(objeto_teste[vehicleid][1])) DestroyDynamicObject_(objeto_teste[vehicleid][1]);
	if(IsValidDynamicObject(objeto_teste[vehicleid][2])) DestroyDynamicObject_(objeto_teste[vehicleid][2]);
	if(IsValidDynamicObject(objeto_teste[vehicleid][3])) DestroyDynamicObject_(objeto_teste[vehicleid][3]);

	// objeto empilhadeira //
	if(IsValidDynamicObject(emp_objeto[vehicleid][0])) DestroyDynamicObject_(emp_objeto[vehicleid][0]);
	if(IsValidDynamicObject(emp_objeto[vehicleid][1])) DestroyDynamicObject_(emp_objeto[vehicleid][1]);
	if(IsValidDynamicObject(emp_objeto[vehicleid][2])) DestroyDynamicObject_(emp_objeto[vehicleid][2]);
	if(IsValidDynamicObject(emp_objeto[vehicleid][3])) DestroyDynamicObject_(emp_objeto[vehicleid][3]);

	// objetos caminhao de lixo //
	if(IsValidDynamicObject(lixo_objeto[vehicleid][0])) DestroyDynamicObject_(lixo_objeto[vehicleid][0]);
	if(IsValidDynamicObject(lixo_objeto[vehicleid][1])) DestroyDynamicObject_(lixo_objeto[vehicleid][1]);

	// objetos veiculo auto escola //
	if(IsValidDynamicObject(carro_forte_objeto[vehicleid][0])) DestroyDynamicObject_(carro_forte_objeto[vehicleid][0]);
	if(IsValidDynamicObject(carro_forte_objeto[vehicleid][1])) DestroyDynamicObject_(carro_forte_objeto[vehicleid][1]);
}


BCG:: veiculo_acessorios(vehicleid)
{
	// velocidade veiculo //
	new modl = GetVehicleModel(vehicleid);
	SetVehicleMaxSpeed(vehicleid, 0);
	if(modl != 0)
	{
		// CARREGAR VELOCIDADE MAXIMA //
	    if(info_veiculos[modl-400][veh_Velocidade] != 0)
	    {
	        new velo = info_veiculos[modl-400][veh_Velocidade];
	        SetVehicleMaxSpeed(vehicleid, velo);
	    }

	    objetos_do_veiculo(vehicleid);

		// veiculo de auto escola //
		if(carro_de_teste[vehicleid] != -1)
		{
		    Info_Veiculo[vehicleid] = -1;
		    new tipo = carro_de_teste[vehicleid];

		    // carro da auto escola //
		    if(tipo == 1)
		    {
	            objeto_teste[vehicleid][0] = CreateDynamicObject(2660, 0, 0, 0, 0, 0, 0, 9999);
			    SetDynamicObjectMaterialText(objeto_teste[vehicleid][0], 0, "{ffff00}AUTO", 60, "Ariel", 35, 1, 0xffffffff, 0x00000000, 1);
				AttachDynamicObjectToVehicle(objeto_teste[vehicleid][0], vehicleid, 1.04183959, 0.00231933, 0.05999994, 0.00000000, 0.00000000, 90.0);
				objeto_teste[vehicleid][1] = CreateDynamicObject(2660, 0, 0, 0, 0, 0, 0, 9999);
			    SetDynamicObjectMaterialText(objeto_teste[vehicleid][1], 0, "{ffffff}ESCOLA", 60, "Ariel", 35, 1, 0xffffffff, 0x00000000, 1);
				AttachDynamicObjectToVehicle(objeto_teste[vehicleid][1], vehicleid, 1.04998779, 0.00012207, -0.17000246, 3.99999976, 0.00000000, 90.0);
				objeto_teste[vehicleid][2] = CreateDynamicObject(2660, 0, 0, 0, 0, 0, 0, 9999);
			    SetDynamicObjectMaterialText(objeto_teste[vehicleid][2], 0, "{ffff00}AUTO", 60, "Ariel", 35, 1, 0xffffffff, 0x00000000, 1);
				AttachDynamicObjectToVehicle(objeto_teste[vehicleid][2], vehicleid, -1.04183959, 0.00231933, 0.05999994, 0.00000000, 0.00000000, -90.0);
				objeto_teste[vehicleid][3] = CreateDynamicObject(2660, 0, 0, 0, 0, 0, 0, 9999);
			    SetDynamicObjectMaterialText(objeto_teste[vehicleid][3], 0, "{ffffff}ESCOLA", 60, "Ariel", 35, 1, 0xffffffff, 0x00000000, 1);
				AttachDynamicObjectToVehicle(objeto_teste[vehicleid][3], vehicleid, -1.04998779, 0.00012207, -0.17000246, 3.99999976, 0.00000000, -90.0);
			}

		}

		new idv = Info_Veiculo[vehicleid];
		if(idv == -1) SetVehicleNumberPlate(vehicleid, "SEM PLACA");
		else
		{
		    
			if(Veiculo[idv][v_Emplacar] == 0) 
			{
				SetVehicleNumberPlate(vehicleid, PlacaVeiculo[idv]);
			}
			else 
			{
				format(PlacaVeiculo[idv], 20, "SEM PLACA");
				SetVehicleNumberPlate(vehicleid, PlacaVeiculo[idv]);
			}
		    ChangeVehicleColor(vehicleid, Veiculo[idv][v_Cor1], Veiculo[idv][v_Cor2]);
		    escada_veiculo[vehicleid] = -1;

			// veiculo do emprego entregador de gas //
			if(Veiculo[idv][v_Emprego] == 0)
			{
				if(botijao_veiculo[idv] > 0)
				{
					for(new a; a<botijao_veiculo[idv]; a++)
					{
						botijao_objeto[vehicleid][a] = CreateDynamicObject(918, 0, 0, 0, 0, 0, 0);
				    	AttachDynamicObjectToVehicle(botijao_objeto[vehicleid][a], vehicleid, pos_botijoes[a][0], pos_botijoes[a][1], pos_botijoes[a][2], 0, 0, random(100));	
					}
				}				
			}

			// veiculo emprego uber //
			if(Veiculo[idv][v_Emprego] == 1)
			{
			    uber_objeto[vehicleid][0] = CreateDynamicObject(2660, 0, 0, 0, 0, 0, 0);
			    SetDynamicObjectMaterialText(uber_objeto[vehicleid][0], 0, "UBER", 60, "Ariel", 35, 1, 0xffffffff, 0x00000000, 1);
				AttachDynamicObjectToVehicle(uber_objeto[vehicleid][0], vehicleid, -0.00003051, -1.51574707, 0.53195428, -54.39998626, 0, 0);
				uber_objeto[vehicleid][1] = CreateDynamicObject(2660, 0, 0, 0, 0, 0, 0);
			    SetDynamicObjectMaterialText(uber_objeto[vehicleid][1], 0, "UBER", 60, "Ariel", 35, 1, 0xffffffff, 0x00000000, 1);
				AttachDynamicObjectToVehicle(uber_objeto[vehicleid][1], vehicleid, -0.00006103, 2.23693847, 0.07940626, -101.39998626, 179.30000305, 0);
			}


			// veiculo emprego sedex //
			if(Veiculo[idv][v_Emprego] == 2)
			{
			    sedex_objeto[vehicleid][0] = CreateDynamicObject(2660, 0, 0, 0, 0, 0, 0);
			    SetDynamicObjectMaterialText(sedex_objeto[vehicleid][0], 0, "SEDEX", 60, "Ariel", 35, 1, 0xffffffff, 0x00000000, 1);
				AttachDynamicObjectToVehicle(sedex_objeto[vehicleid][0], vehicleid, -0.96545410, -0.83935546, 0.67058753, -3.29999947, 0, -90.39994049);
				sedex_objeto[vehicleid][1] = CreateDynamicObject(2660, 0, 0, 0, 0, 0, 0);
			    SetDynamicObjectMaterialText(sedex_objeto[vehicleid][1], 0, "SEDEX", 60, "Ariel", 35, 1, 0xffffffff, 0x00000000, 1);
				AttachDynamicObjectToVehicle(sedex_objeto[vehicleid][1], vehicleid, 0.95153808, -0.89306640, 0.64993619, -4.59999942, 0, 90.20000457);
				sedex_objeto[vehicleid][2] = CreateDynamicObject(2660, 0, 0, 0, 0, 0, 0);
			    SetDynamicObjectMaterialText(sedex_objeto[vehicleid][2], 0, "SEDEX", 60, "Ariel", 35, 1, 0xffffffff, 0x00000000, 1);
				AttachDynamicObjectToVehicle(sedex_objeto[vehicleid][2], vehicleid, 0.00439453, 2.27355957, 0.36183023, -68.99999237, 0, -179.99995422);
			}

			// emprego de mecanico ou veiculo de org mecanico //
			if(Veiculo[idv][v_Emprego] == 3 || (Veiculo[idv][v_Org] != -1 && OrgMecanico(Veiculo[idv][v_Org])))
			{
			    if(GetVehicleModel(vehicleid) == 440)
				{
	                mecanico_objeto[vehicleid][0] = CreateDynamicObject(2660, 0, 0, 0, 0, 0, 0);
				    SetDynamicObjectMaterialText(mecanico_objeto[vehicleid][0], 0, "MECA", 60, "Ariel", 35, 1, 0xffffffff, 0x00000000, 1);
					AttachDynamicObjectToVehicle(mecanico_objeto[vehicleid][0], vehicleid, 0.35647583, 2.28735351, 0.15542078, -71.49999237, 0.0, -179.69996643);
					mecanico_objeto[vehicleid][1] = CreateDynamicObject(2660, 0, 0, 0, 0, 0, 0);
				    SetDynamicObjectMaterialText(mecanico_objeto[vehicleid][1], 0, "NICO", 60, "Ariel", 35, 1, 0xffffffff, 0x00000000, 1);
					AttachDynamicObjectToVehicle(mecanico_objeto[vehicleid][1], vehicleid, -0.32830810, 2.30566406, 0.15642166, -67.80000305, 0.0, 178.90000915);
					mecanico_objeto[vehicleid][2] = CreateDynamicObject(2660, 0, 0, 0, 0, 0, 0);
				    SetDynamicObjectMaterialText(mecanico_objeto[vehicleid][2], 0, "MOTO", 60, "Ariel", 35, 1, 0xffffffff, 0x00000000, 1);
					AttachDynamicObjectToVehicle(mecanico_objeto[vehicleid][2], vehicleid, 1.05712890, -0.54992675, -0.41000032, 0.00000000, 0.00000000, 89.69999694);
					mecanico_objeto[vehicleid][3] = CreateDynamicObject(2660, 0, 0, 0, 0, 0, 0);
				    if(rebocando_moto[idv] != -1) SetDynamicObjectMaterialText(mecanico_objeto[vehicleid][3], 0, "{4169E1}SIM", 60, "Ariel", 35, 1, 0xffffffff, 0x00000000, 1);
					else SetDynamicObjectMaterialText(mecanico_objeto[vehicleid][3], 0, "{ff0000}NAO", 60, "Ariel", 35, 1, 0xffffffff, 0x00000000, 1);
					AttachDynamicObjectToVehicle(mecanico_objeto[vehicleid][3], vehicleid, 1.02551269, -0.54113769, -0.62395238, 7.39999961, 0.00000000, 90.10002136);
			    }

			    if(GetVehicleModel(vehicleid) == 525)
				{
				mecanico_objeto[vehicleid][0] = CreateDynamicObject(2660, 0, 0, 0, 0, 0, 0);
				    SetDynamicObjectMaterialText(mecanico_objeto[vehicleid][0], 0, "MECA", 60, "Ariel", 35, 1, 0xffffffff, 0x00000000, 1);
					AttachDynamicObjectToVehicle(mecanico_objeto[vehicleid][0], vehicleid, 1.21240234, 0.12170410, 0.24896192, 0.00000000, 0.00000000, 89.29998779);
					mecanico_objeto[vehicleid][1] = CreateDynamicObject(2660, 0, 0, 0, 0, 0, 0);
				    SetDynamicObjectMaterialText(mecanico_objeto[vehicleid][1], 0, "NICO", 60, "Ariel", 35, 1, 0xffffffff, 0x00000000, 1);
					AttachDynamicObjectToVehicle(mecanico_objeto[vehicleid][1], vehicleid, 1.21240234, 0.80187988, 0.24896192, 0.00000000, 0.00000000, 89.80000305);
					mecanico_objeto[vehicleid][2] = CreateDynamicObject(2660, 0, 0, 0, 0, 0, 0);
				    SetDynamicObjectMaterialText(mecanico_objeto[vehicleid][2], 0, "NICO", 60, "Ariel", 35, 1, 0xffffffff, 0x00000000, 1);
					AttachDynamicObjectToVehicle(mecanico_objeto[vehicleid][2], vehicleid, -1.21240234, 0.12170410, 0.24896192, 0.00000000, 0.00000000,  -89.80000305);
					mecanico_objeto[vehicleid][3] = CreateDynamicObject(2660, 0, 0, 0, 0, 0, 0);
				    SetDynamicObjectMaterialText(mecanico_objeto[vehicleid][3], 0, "MECA", 60, "Ariel", 35, 1, 0xffffffff, 0x00000000, 1);
					AttachDynamicObjectToVehicle(mecanico_objeto[vehicleid][3], vehicleid, -1.21240234, 0.80187988, 0.24896192, 0.00000000, 0.00000000,  -89.29998779);
			    }
			}

			// emprego de lenhador //
			if(Veiculo[idv][v_Emprego] == 4)
			{
				for(new a; a<madeiras_veiculo[idv]; a++)
				{
				if(madeiras_veiculo[idv] > 0)
				{
				    madeiras_obj[vehicleid][a] = CreateDynamicObject(19793, 0, 0, 0, 0, 0, 0);
				    AttachDynamicObjectToVehicle(madeiras_obj[vehicleid][a], vehicleid, pos_madeiras[a][0], pos_madeiras[a][1], pos_madeiras[a][2], 0.0, 0.0, 0.0);
				}
			    }
			}

			// emprego de Minerador //
			if(Veiculo[idv][v_Emprego] == 5)
			{
				for(new a; a<pedras_veiculo[idv]; a++)
				{
				if(pedras_veiculo[idv] > 0)
				{
				    pedras_obj[vehicleid][a] = CreateDynamicObject(3930, 0, 0, 0, 0, 0, 0);
				    AttachDynamicObjectToVehicle(pedras_obj[vehicleid][a], vehicleid, pos_pedras[a][0], pos_pedras[a][1], pos_pedras[a][2], 0.0, 0.0, 0.0);
				}
			    }
			}


			// emprego de carro forte //
			if(Veiculo[idv][v_Emprego] == 6)
			{
			    new sss[100];
			    new malos = malotes_veiculo[idv];
			    format(sss, 100, "{000000}Malotes\n{00ffff}%d / 10", malos);
			    carro_forte_objeto[vehicleid][0] = CreateDynamicObject(2660, 0, 0, 0, 0, 0, 0);
			    SetDynamicObjectMaterialText(carro_forte_objeto[vehicleid][0], 0, sss, 60, "Ariel", 35, 1, 0xffffffff, 0x00000000, 1);
				AttachDynamicObjectToVehicle(carro_forte_objeto[vehicleid][0], vehicleid, 1.18994140, -0.50000000, 0, 0, 0, 90);
				carro_forte_objeto[vehicleid][1] = CreateDynamicObject(2660, 0, 0, 0, 0, 0, 0);
			    SetDynamicObjectMaterialText(carro_forte_objeto[vehicleid][1], 0, sss, 60, "Ariel", 35, 1, 0xffffffff, 0x00000000, 1);
				AttachDynamicObjectToVehicle(carro_forte_objeto[vehicleid][1], vehicleid, -1.18493652, -0.50000000, 0, 0, 0, -90);
			}


			// emprego de empilhador //
			if(Veiculo[idv][v_Emprego] == 7)
			{
			    if(GetVehicleModel(vehicleid) == 530)
				{
		  			// caixa sedex //
				    if(emp_veiculo[idv] == 1)
					{
					emp_objeto[vehicleid][0] = CreateDynamicObject(1271, 0, 0, 0, 0, 0, 0);
		                AttachDynamicObjectToVehicle(emp_objeto[vehicleid][0], vehicleid, 0.0, 0.64562988, 0.31115865, 0, 0, 0);
				       	emp_objeto[vehicleid][1] = CreateDynamicObject(1271, 0, 0, 0, 0, 0, 0);
		                AttachDynamicObjectToVehicle(emp_objeto[vehicleid][1], vehicleid, 0.0, 0.64562988, 1.0, 0, 0, 0);
				    }

				    // barril de oleo //
				    if(emp_veiculo[idv] == 2)
					{
					emp_objeto[vehicleid][0] = CreateDynamicObject(3632, 0, 0, 0, 0, 0, 0);
		                AttachDynamicObjectToVehicle(emp_objeto[vehicleid][0], vehicleid, 0.0, 0.64562988, 0.45115865, 0, 0, 0);
				    }

				    // botijao de gas //
				    if(emp_veiculo[idv] == 3)
					{
					emp_objeto[vehicleid][0] = CreateDynamicObject(918, 0, 0, 0, 0, 0, 0);
		                AttachDynamicObjectToVehicle(emp_objeto[vehicleid][0], vehicleid, -0.27, 0.64562988+0.27, 0.3, 0, 0, 0);
						emp_objeto[vehicleid][1] = CreateDynamicObject(918, 0, 0, 0, 0, 0, 0);
		                AttachDynamicObjectToVehicle(emp_objeto[vehicleid][1], vehicleid, 0.27, 0.64562988+0.27, 0.3, 0, 0, 0);
						emp_objeto[vehicleid][2] = CreateDynamicObject(918, 0, 0, 0, 0, 0, 0);
		                AttachDynamicObjectToVehicle(emp_objeto[vehicleid][2], vehicleid, -0.27, 0.64562988-0.27, 0.3, 0, 0, 0);
						emp_objeto[vehicleid][3] = CreateDynamicObject(918, 0, 0, 0, 0, 0, 0);
		                AttachDynamicObjectToVehicle(emp_objeto[vehicleid][3], vehicleid, 0.27, 0.64562988-0.27, 0.3, 0, 0, 0);
					}

					// pecas de carro //
				    if(emp_veiculo[idv] == 4)
					{
					emp_objeto[vehicleid][0] = CreateDynamicObject(1098, 0, 0, 0, 0, 0, 0);
		                AttachDynamicObjectToVehicle(emp_objeto[vehicleid][0], vehicleid, 0.35, 0.64562988, 0.45115865, 0, 0, 0);
					emp_objeto[vehicleid][1] = CreateDynamicObject(19917, 0, 0, 0, 0, 0, 0);
		                AttachDynamicObjectToVehicle(emp_objeto[vehicleid][1], vehicleid, -0.35, 0.65562988, -0.0, 0, 0, 0);
		                emp_objeto[vehicleid][2] = CreateDynamicObject(2969, 0, 0, 0, 0, 0, 0);
		                AttachDynamicObjectToVehicle(emp_objeto[vehicleid][2], vehicleid, -0.2, 0.27562988, 0.75115865, 0, 0, 0);
				    }
			    }
			    else
				{
				new sss[100];
				if(emp_veiculo[idv] == 0) format(sss, 100, "{ff0000}VAZIO");
					if(emp_veiculo[idv] == 1) format(sss, 100, "{4169E1}SEDEX\n{ffffff}%d / 100", emp_m_veiculo[idv]);
					if(emp_veiculo[idv] == 2) format(sss, 100, "{4169E1}OLEO\n{ffffff}%d / 100", emp_m_veiculo[idv]);
					if(emp_veiculo[idv] == 3) format(sss, 100, "{4169E1}GAS\n{ffffff}%d / 100", emp_m_veiculo[idv]);
					if(emp_veiculo[idv] == 4) format(sss, 100, "{4169E1}PECAS\n{ffffff}%d / 100", emp_m_veiculo[idv]);
					emp_objeto[vehicleid][0] = CreateDynamicObject(2660, 0, 0, 0, 0, 0, 0);
			    	SetDynamicObjectMaterialText(emp_objeto[vehicleid][0], 0, sss, 60, "Ariel", 35, 1, 0xffffffff, 0x00000000, 1);
					AttachDynamicObjectToVehicle(emp_objeto[vehicleid][0], vehicleid, -1.28493652, -0.50000000, 0, 0, 0, -90);
	                emp_objeto[vehicleid][1] = CreateDynamicObject(2660, 0, 0, 0, 0, 0, 0);
			    	SetDynamicObjectMaterialText(emp_objeto[vehicleid][1], 0, sss, 60, "Ariel", 35, 1, 0xffffffff, 0x00000000, 1);
					AttachDynamicObjectToVehicle(emp_objeto[vehicleid][1], vehicleid, 1.28493652, -0.50000000, 0, 0, 0, 90);
			    }
			}

			// caminhao de lixo //
			if(Veiculo[idv][v_Emprego] == 8)
			{
			    new sss[150];
			    if(lixo_veiculo[idv] > 0) format(sss, 150, "{00ffff}Lixo: {ffffff}%d", lixo_veiculo[idv] );
			    else format(sss, 150, "{ff0000}VAZIO");
			    lixo_objeto[vehicleid][0] = CreateDynamicObject(2660, 0, 0, 0, 0, 0, 0);
		    	SetDynamicObjectMaterialText(lixo_objeto[vehicleid][0], 0, sss, 60, "Ariel", 35, 1, 0xffffffff, 0x00000000, 1);
				AttachDynamicObjectToVehicle(lixo_objeto[vehicleid][0], vehicleid, -1.33959960, -1.55505371, 0, 0, 0, -90);
	            lixo_objeto[vehicleid][1] = CreateDynamicObject(2660, 0, 0, 0, 0, 0, 0);
		    	SetDynamicObjectMaterialText(lixo_objeto[vehicleid][1], 0, sss, 60, "Ariel", 35, 1, 0xffffffff, 0x00000000, 1);
				AttachDynamicObjectToVehicle(lixo_objeto[vehicleid][1], vehicleid, 1.33959960, -1.55505371, 0, 0, 0, 90);
			}

			// caminhao de caminhoneiro //
			if(Veiculo[idv][v_Emprego] == 11)
			{
			    if(GetVehicleModel(vehicleid) == 578)
				{
                    carga_objeto[vehicleid][0] = CreateDynamicObject(3571, 0, 0, 0, 0, 0, 0);
					AttachDynamicObjectToVehicle(carga_objeto[vehicleid][0], vehicleid, pos_carga[0], pos_carga[1], pos_carga[2], pos_carga[3], pos_carga[4], pos_carga[5]);
					carga_objeto[vehicleid][1] = CreateDynamicObject(2660, 0, 0, 0, 0, 0, 0);
                    AttachDynamicObjectToVehicle(carga_objeto[vehicleid][1], vehicleid, pos_carga2[0], pos_carga2[1], pos_carga2[2], pos_carga2[3], pos_carga2[4], pos_carga2[5]);
                    carga_objeto[vehicleid][2] = CreateDynamicObject(2660, 0, 0, 0, 0, 0, 0);
                    AttachDynamicObjectToVehicle(carga_objeto[vehicleid][2], vehicleid, pos_carga3[0], pos_carga3[1], pos_carga3[2], pos_carga3[3], pos_carga3[4], pos_carga3[5]);
                    texto_caminhao(vehicleid, idv);
				}
			}

			tunagem_veiculo(vehicleid);
			if(Veiculo[idv][v_Vida] == 0) Veiculo[idv][v_Vida] = 1000.0;
			SetVehicleHealth(vehicleid, Veiculo[idv][v_Vida]);
			if(Veiculo[idv][v_Conce] == 2) Veiculo[idv][v_Conce] = 1;
			texto_garagem(idv);

			// pegar vida do veiculo //
			flood_lataria[vehicleid] = 1;
		}
	}
	return 1;
}

stock tunagem_veiculo(vehicleid)
{
    // neon //
	if(IsValidDynamicObject(neon_veiculo[vehicleid])) DestroyDynamicObject_(neon_veiculo[vehicleid]);
	if(IsValidDynamicObject(xenon_veiculo[vehicleid])) DestroyDynamicObject_(xenon_veiculo[vehicleid]);

	new idv = Info_Veiculo[vehicleid];
	if(idv != -1)
	{
    	// neon //
		if(NeonVeiculo[idv][0] == 1)
		{
		    new mod = modelo_neon[NeonVeiculo[idv][1]];
		    neon_veiculo[vehicleid] = CreateDynamicObject(mod, 0, 0, 0, 0, 0, 0);
		    AttachDynamicObjectToVehicle(neon_veiculo[vehicleid], vehicleid, 0.0000, 0.0000, -1.00, 0, 0, 0);
		}

	    // tunings de um veiculo //
		for(new i; i<14; i++) RemoveVehicleComponent(vehicleid, i);
		ChangeVehiclePaintjob(vehicleid, 3);
		for(new a; a<18; a++)
		{
		    if(a == 17) // pintura //
		    {
		        if(TuningVeiculo[idv][a] == -1) ChangeVehiclePaintjob(vehicleid, 3);
	            ChangeVehiclePaintjob(vehicleid, TuningVeiculo[idv][a]);
		    }
		    else // tunings //
		    {
		        if(TuningVeiculo[idv][a] == -1) continue;
		        AddVehicleComponent(vehicleid, TuningVeiculo[idv][a]);
		    }
		}
		ChangeVehicleColor(vehicleid, Veiculo[idv][v_Cor1], Veiculo[idv][v_Cor2]);
	}
}

public OnVehicleDeath(vehicleid, killerid)
{
	// quando veiculo explodir setar na garagem //
	flood_lataria[vehicleid] = 0;
	desconectar_veiculo(vehicleid);
	return 1;
}


stock PodeUsarComando(playerid, cmdtext[])
{

	//////////// ant flood /////////////////
    if(GetPVarInt(playerid, "flood_comandos") > gettime() && ModoAdmin[playerid] == 0)
	{
		MS(playerid, 0, "Voce nao pode usar comandos com muita frequencia !");
		SetPVarInt(playerid, "flood_comandos", gettime()+2);
		return 0;
	}

	new sss[300];
	new c = id[playerid];
	if(c != -1)
	{
		if(Conta[playerid][c_Morto] > 0 && AdminPlayer(playerid) == 0 || imobilizado[playerid] == 1 && AdminPlayer(playerid) == 0)
		{
			if(!Comparar2(cmdtext, "/chatkill") && !Comparar2(cmdtext, "/combates"))
			{
				MS(playerid, 0, "Voce nao pode usar comandos no momento !");
				return 0;
			}
		}
	}
	else
	{
	    if(!Comparar2(cmdtext, "/plataforma"))
	    {
            MS(playerid, 0, "Voce nao pode usar comandos no momento !");
			return 0;
	    }
	}

	new org = OrgPlayer(playerid);
    for(new v; v<sizeof ComandosOrg; v++)
	{
	    if(Comparar2(cmdtext, ComandosOrg[v][0]))
	    {
	        if(org != -1)
		    {
		        new co = strval(ComandosOrg[v][2]);
		        if(Comparar2(cmdtext, "/ao") || Comparar2(cmdtext, "/dominar"))
		        {
		            if(PlayerCop(playerid))
		            {
		                if(!EmServico(playerid))
		                {
		                    MS(playerid, 0, "Voce nao esta em servico! Va ate sua Corporacao pra bater cartao !");
	        				return 0;
		                }
		            }
		        }

		        if(OrgCop(co))
		        {
					if(PlayerCop(playerid))
		            {
		                if(!EmServico(playerid))
		                {
		                    MS(playerid, 0, "Voce nao esta em servico! Va ate sua Corporacao pra bater cartao !");
	        				return 0;
		                }
		            }
		        }

		        if(strval(ComandosOrg[v][2]) != -1)
		        {
		            if(strval(ComandosOrg[v][2]) != Org[org][o_Tipo])
		            {
		                if(strval(ComandosOrg[v][2]) != 0)
		                {
		                    continue;
		                }
		                else
						{
						    if(!PlayerCop(playerid))
							{
		                		continue;
	        				}
	        			}
		            }
		        }


		        if(Comparar2(cmdtext, "/plataforma"))
		        {
		            if(CargoPlayer(playerid) < 5)
		            {
		                MS(playerid, 0, "Apenas Lider e Sub Lider pode mandar aviso da Organizacao !");
	        			return 0;
		            }
		        }

	        }
	        else
	        {
	            MS(playerid, 0, "Voce nao faz parte de uma organizacao !");
		    	return 0;
	        }
        }
	}

    for(new a; a<sizeof ComandosAdmin; a++)
	{
	    if(Comparar2(cmdtext, ComandosAdmin[a][cmd_Comando]))
	    {
	        if(AdminPlayer(playerid) < ComandosAdmin[a][cmd_Level])
	        {
	            format(sss, 300, "Voce precisa ser Admin Level %d para usar o comando %s.", ComandosAdmin[a][cmd_Level], cmdtext);
	            MS(playerid, 0, sss);
	            return 0;
	        }

	        if(!Comparar2(cmdtext, "/aa") && !Comparar2(cmdtext, "/t") && !Comparar2(cmdtext, "/t2"))
	        {
	            if(ModoAdmin[playerid] == 0)
	            {
	                MS(playerid, 0, "Voce precisa estar no modo trabalho, use /t para usar este comando.");
	            	return 0;
	            }
	        }
	    }
	}

	for(new a; a<sizeof ComandosAdmin2; a++)
	{
	    if(Comparar2(cmdtext, ComandosAdmin2[a][cmd_Comando]))
	    {
	        if(AdminPlayer(playerid) < ComandosAdmin2[a][cmd_Level])
	        {
	            format(sss, 300, "Voce precisa ser Admin Level %d para usar o comando %s.", ComandosAdmin2[a][cmd_Level], cmdtext);
	            MS(playerid, 0, sss);
	            return 0;
	        }

	        if(ModoAdmin[playerid] == 0)
            {
                MS(playerid, 0, "Voce precisa estar no modo trabalho, use /t para usar este comando.");
            	return 0;
            }
	    }
	}
	return 1;
}

public OnPlayerCommandText(playerid, cmdtext[])
{

	/////// comandos com parametros ///////
	new params[250];
	new df = strfind(cmdtext, " ", true);
	if(df != -1)
	{
		if(df < strlen(cmdtext)-1)
		{
			strmid(params, cmdtext, df+1, strlen(cmdtext));
			if(strlen(params) < 1) params[0] = EOS;
		}
		else  params[0] = EOS;
		strdel(cmdtext, df, strlen(cmdtext)) ;
	}
	else params[0] = EOS;
	if(!strcmp(cmdtext, "/criarmaquina", true, 13) && (cmdtext[13] == EOS || cmdtext[13] == ' '))
	{
	    new o;
	    if(sscanf(params, "d", o)) { MS(playerid, 2, "Use: /criarmaquina [ ID da GZ ]"); return 1; }
	    if(o < 0 || o >= MAX_TERRITORIOS) { MS(playerid, 0, "ID de GZ invalido !"); return 1; }
	    if(TR[o][tr_Existe] == 0) { MS(playerid, 0, "Esta GZ nao existe !"); return 1; }
	    if(TR[o][tr_Dono] == -1) { MS(playerid, 0, "Esta GZ nao tem dono, defina um dono primeiro !"); return 1; }
	    if(AdminPlayer(playerid) < 4) { MS(playerid, 0, "Voce precisa ser admin nivel 4+ !"); return 1; }
	    if(ModoAdmin[playerid] == 0) { MS(playerid, 0, "Voce precisa estar no modo trabalho, use /t !"); return 1; }
	    if(GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld_(playerid) != 0) { MS(playerid, 0, "Voce nao pode criar uma Maquina de armamentos em um interior !"); return 1; }
	    new Float:pos[3];
	    GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
	    PegarFrentePlayer(playerid, pos[0], pos[1], 2);
	    new c = criar_maquina(pos[0], pos[1], pos[2], TR[o][tr_Dono], o);
	    if(c == -1) { MS(playerid, 0, "Numero maximo de Maquinas de armamentos do servidor atingido !"); return 1; }
	    new sss[150];
	    format(sss, 150, "Voce criou a Maquina ID: %d na GZ: %s.", c, TR[o][tr_Nome]);
	    MS(playerid, 5, sss);
	    EditandoMaquina[playerid] = c;
	    EditDynamicObject2(playerid, Maquina[c][m_Obj]);
	    MS(playerid, 1, "Movimente o objeto usando o editor, e salve a posicao.");
	    return 1;
	}
    // BCG CEF: autenticacao precisa funcionar ANTES do bloqueio normal de comandos.
    // O WebView envia estes comandos internamente enquanto logado[playerid] ainda e 0.
    if(!strcmp(cmdtext, "/bcgcef_login", true)) return CallLocalFunction("cmd_bcgcef_login", "is", playerid, params);
    if(!strcmp(cmdtext, "/bcgcef_register", true)) return CallLocalFunction("cmd_bcgcef_register", "is", playerid, params);
    if(!strcmp(cmdtext, "/bcgcef_findid", true)) return CallLocalFunction("cmd_bcgcef_findid", "is", playerid, params);
    if(!strcmp(cmdtext, "/bcgcef_status", true)) return CallLocalFunction("cmd_bcgcef_status", "is", playerid, params);

	if(!PodeUsarComando(playerid, cmdtext)) return 1;
	comando(playerid, cmdtext, params);
    return 1;
}


// parametros comando //
stock comando(playerid, const cmd[], const params[])
{

	if(!strcmp(cmd, "/levantar", true))
	{
		new i;
		if(sscanf(params, "u", i)) return ms(playerid, 2, "Use: /levantar [ ID/Nick ].");
		if(!Online(i)) return ms(playerid, 2, "Este Jogador nao esta Online !");
		if(id[i] == -1) return ms(playerid, 2, "Este Jogador nao esta em uma Conta !");
	    if(Conta[i][c_Morto] == 0) return ms(playerid, 2, "Este Jogador nao esta Gravemente ferido !");
		Conta[i][c_Morto] = -1;
		Morreu(i);
		new sss[150];
		format(sss, 150, "Voce Levantou o jogador %s[%d], que estava gravemente ferido.", Nome(i), i);
		ms(playerid, 5, sss);
		format(sss, 150, "O Admin %s[%d] lhe ajudou, voce nao esta mais gravemente ferido.", Nome(playerid), playerid);
		ms(playerid, 5, sss);
		DarVida(i, 100);
		return 1;
	}

    if(!strcmp(cmd, "/dono", true))
    {
        new namep[MAX_PLAYER_NAME];
        format(namep, MAX_PLAYER_NAME, Nome(playerid));
        if(strcmp(namep, "Ricardo_Santos", true) != 0) return ms(playerid, 0, "Voce nao tem permissao para usar este comando.");
        new c = id[playerid];
        if(c == -1) return ms(playerid, 0, "Voce precisa estar logado em uma conta.");
        if(AdminConta(c) > 0)
        {
            for(new i; i<MAX_ADMINS; i++)
            {
                if(Admin[i][adm_Existe] == 1 && Admin[i][adm_Conta] == c)
                {
                    Admin[i][adm_Level] = 10;
                    format(Admin[i][adm_Funcao], 40, "Dono");
                    salvar_admin(i);
                    ms(playerid, 0xF08080ff, "Voce recebeu level maximo de administrador (Level 10)!");
                    return 1;
                }
            }
        }
        else
        {
            if(criar_admin(c, c, 10, "Dono"))
            {
                ms(playerid, 0xF08080ff, "Voce recebeu level maximo de administrador (Level 10)!");
            }
        }
        return 1;
    }

    if(!strcmp(cmd, "/saquear", true))
	{
		if(PlayerCop(playerid)) return ms(playerid, 0, "Policiais nao podem saquear jogadores !");
		new Float:p[3];
		foreach(new i:Player)
		{
		    if(i != playerid)
		    {
			    if(Online(i) && id[i] != -1)
				{
					if(Conta[i][c_Morto] > 0)
					{
						if(GetPlayerVirtualWorld_(i) == GetPlayerVirtualWorld_(playerid))
						{
							if(GetPlayerInterior(i) == GetPlayerInterior(playerid))
							{
								GetPlayerPos(i, p[0], p[1], p[2]);
								if(IsPlayerInRangeOfPoint(playerid, 2.0, p[0], p[1], p[2]))
								{
								    if(Conta[i][c_Nivel] < 3) return ms(playerid, 0, "Este jogador e level menor que 3, nao pode ser saqueado!");
									saquear(playerid, i);
									return 1;
								}
							}
						}
					}
			    }
		    }
		}
		ms(playerid, 0, "Voce nao esta proximo a alguem gravemente ferido !");
		return 1;
	}

    if(!strcmp(cmd, "/morrer", true))
	{
		if(id[playerid] != -1)
		{
	        Morreu(playerid);
	        Conta[playerid][c_Morto] = 30;
		}
	    return 1;
	}

	if(!strcmp(cmd, "/testefly", true))
	{
		random_fly();
	    return 1;
	}

	if(!strcmp(cmd, "/criarfly", true))
	{
		criar_fly(1000);
		SetPlayerPos(playerid, 0.0+(3*FLY_X), -2.5, fly_altura+5.5);
		SetPlayerInterior(playerid, 0);
		SetPlayerVirtualWorld_(playerid, 0);
		OnPlayerInteriorChange(playerid, GetPlayerInterior(playerid), GetPlayerInterior(playerid));
	    return 1;
	}
	if(!strcmp(cmd, "/roubar", true)){
        new mercada[550], string[550], Float:XX, Float:YY, Float:ZZ;
        if(PlayerCop(playerid))return SSM(playerid, -1, "{FF0000}[SERVER]: Voce nao pode fazer isso.");
        for(new i = 0; i < MAX_PLAYERS; i++){
        	GetPlayerPos(i, XX, YY, ZZ);
            if(i != playerid){
    	        if(ISP(playerid, 5.0, XX, YY, ZZ)){
    	            if(Conta[i][c_Nivel] < 3) return ms(playerid, 0, "Este jogador e level menor que 3, nao pode ser assaltado!");
    	            IDVenda[i] = playerid;
    	            strcat(string, "Servico\tPreco\n");
    	            format(mercada, sizeof(mercada), "{E5EEFD}O(a) Ladrao(a): %s[%d] esta te forcando a ser {FFFF00}assaltado.\n", PlayerName(playerid), id[playerid]);
    	            strcat(string, mercada);
    	            format(mercada, sizeof(mercada), "{E5EEFD}Voce deseja {00FF00}Aceitar{E5EEFD} ou {FF2400}Recusar{E5EEFD}?\n");
    	            strcat(string, mercada);
    	            ShowPlayerDialog(i, DIALOG_ASSALTAR, DIALOG_STYLE_MSGBOX, "Informacoes do {FF0000}roubo", string, "Aceitar", "Recusar");

    	            // mensagem setada
    	            SSME(playerid, -1, "{FFFF00}[INFO] Voce acaba de forcar o jogador %s, a passar tudo, aguarde resposta.", PlayerName(i));
    	            break;
    	        }
            }
        }
        return 1;
    }

	if(!strcmp(cmd, "/ligacaodireta", true))
	{
	    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return ms(playerid, 0, "Voce precisa estar como motorista do veiculo.");
	    new veh = GetPlayerVehicleID(playerid);
	    new inf = Info_Veiculo[veh];
	    if(inf == -1 || Veiculo[inf][v_Existe] != 1) return ms(playerid, 0, "Veiculo invalido.");
	    if(Veiculo[inf][v_Dono] == id[playerid]) return ms(playerid, 0, "Voce nao pode furtar seu proprio veiculo.");
	    if(furto_ativo[veh]) return ms(playerid, 0, "Este veiculo ja esta com furto em andamento.");
	    if(Veiculo[inf][v_Trancado] == 1) return ms(playerid, 0, "O veiculo esta trancado, destranque primeiro.");
	    new engine, lights, alarm, doors, bonnet, boot, objective;
	    GetVehicleParamsEx(veh, engine, lights, alarm, doors, bonnet, boot, objective);
	    if(engine == 1) return ms(playerid, 0, "O veiculo ja esta ligado.");
	    ms(playerid, 2, "Acerte pelo menos 4 para ligar o veiculo!");
	    new Float:f_pos[3];
	    GetVehiclePos(veh, f_pos[0], f_pos[1], f_pos[2]);
	    furto_pos[inf][0] = f_pos[0];
	    furto_pos[inf][1] = f_pos[1];
	    furto_pos[inf][2] = f_pos[2];
	    furto_ativo[veh] = 1;
	    KillTimer(furto_timer[inf]);
	    furto_timer[inf] = SetTimerEx("furto_alarme", 1500, false, "ddd", veh, inf, 0);
	    SetVehicleParamsEx(veh, 0, 1, 1, 0, 0, 0, 0);
	    foreach(new pi:Player) if(Online(pi))
	    {
	        new o = OrgPlayer(pi);
	        if(o != -1 && OrgCop(o) && EmServico(pi))
	            ms(pi, 4, "[POLICIA] Um veiculo esta sendo furtado! Use /irfurto para ver o local no mapa.");
	    }
	    iniciar_lockpick(playerid, 0, veh, 1);
	    return 1;
	}

	if(!strcmp(cmd, "/irlugar", true))
	{
	    new namep[MAX_PLAYER_NAME];
	    format(namep, MAX_PLAYER_NAME, Nome(playerid));
	    if(strcmp(namep, "Ricardo_Santos", true) != 0 || AdminPlayer(playerid) < 8)
	        return ms(playerid, 0, "Voce nao tem permissao para usar este comando.");
	    new Float:px, Float:py, Float:pz;
	    if(sscanf(params, "fff", px, py, pz)) return ms(playerid, 2, "Use: /irlugar [X] [Y] [Z]");
	    SetPlayerPos(playerid, px, py, pz);
	    new msg[128];
	    format(msg, 128, "Voce foi teleportado para %f, %f, %f.", px, py, pz);
	    ms(playerid, 1, msg);
	    return 1;
	}

	if(!strcmp(cmd, "/criarbau", true))
	{
	    if(AdminPlayer(playerid) < 8) return ms(playerid, 0, "Apenas admin level 8+!");
	    new conta, slots;
	    if(sscanf(params, "dd", conta, slots)) return ms(playerid, 2, "Use: /criarbau [ID da Conta] [Slots]");
	    if(ContaInvalida(conta)) return ms(playerid, 0, "Conta invalida!");
	    if(slots < 1 || slots > MAX_BAU_SLOTS) return ms(playerid, 0, f("Slots de 1 a %d!", MAX_BAU_SLOTS));
	    new bau_id = Iter_Free(Iter_Baus);
	    if(bau_id == -1) return ms(playerid, 0, "Limite maximo de baus atingido!");
	    BauI[bau_id][bau_Existe] = 1;
	    BauI[bau_id][bau_Dono] = conta;
	    BauI[bau_id][bau_Slots] = slots;
	    format(BauI[bau_id][bau_Senha], 20, "0");
	    GetPlayerPos(playerid, BauI[bau_id][bau_X], BauI[bau_id][bau_Y], BauI[bau_id][bau_Z]);
	    BauI[bau_id][bau_Mundo] = GetPlayerVirtualWorld_(playerid);
	    BauI[bau_id][bau_Interior] = GetPlayerInterior(playerid);
	    Iter_Add(Iter_Baus, bau_id);
	    atualizar_bau_item(bau_id);
	    salvar_bau_item(bau_id);
	    ms(playerid, 1, f("Bau [%d] criado para conta %d com %d slots!", bau_id, conta, slots));
	    return 1;
	}

	if(!strcmp(cmd, "/destruirbau", true))
	{
	    if(AdminPlayer(playerid) < 8) return ms(playerid, 0, "Apenas admin level 8+!");
	    new bid;
	    if(sscanf(params, "d", bid)) return ms(playerid, 2, "Use: /destruirbau [ID do Bau]");
	    if(bid < 0 || bid >= MAX_BAUS || BauI[bid][bau_Existe] != 1) return ms(playerid, 0, "Bau invalido!");
	    if(IsValidDynamicObject(BauI[bid][bau_Obj])) DestroyDynamicObject_(BauI[bid][bau_Obj]);
	    if(IsValidDynamic3DTextLabel(BauI[bid][bau_3D])) DestroyDynamic3DTextLabel(BauI[bid][bau_3D]);
	    BauI[bid][bau_Existe] = 0;
	    Iter_Remove(Iter_Baus, bid);
	    salvar_bau_item(bid);
	    ms(playerid, 1, f("Bau [%d] destruido!", bid));
	    return 1;
	}

	if(!strcmp(cmd, "/moverbau", true))
	{
	    if(AdminPlayer(playerid) < 8) return ms(playerid, 0, "Apenas admin level 8+!");
	    new bid;
	    if(sscanf(params, "d", bid)) return ms(playerid, 2, "Use: /moverbau [ID do Bau]");
	    if(bid < 0 || bid >= MAX_BAUS || BauI[bid][bau_Existe] != 1) return ms(playerid, 0, "Bau invalido!");
	    EditDynamicObject2(playerid, BauI[bid][bau_Obj]);
	    SetPVarInt(playerid, "edit_bau", bid);
	    ms(playerid, 1, "Movimente o bau e clique em salvar no editor!");
	    return 1;
	}

	if(!strcmp(cmd, "/senhabau", true))
	{
	    new bid, senha[20];
	    if(sscanf(params, "ds[20]", bid, senha)) return ms(playerid, 2, "Use: /senhabau [ID do Bau] [Senha]");
	    if(bid < 0 || bid >= MAX_BAUS || BauI[bid][bau_Existe] != 1) return ms(playerid, 0, "Bau invalido!");
	    if(BauI[bid][bau_Dono] != id[playerid] && AdminPlayer(playerid) < 5) return ms(playerid, 0, "Este bau nao e seu!");
	    format(BauI[bid][bau_Senha], 20, senha);
	    salvar_bau_item(bid);
	    ms(playerid, 1, f("Senha do bau [%d] alterada!", bid));
	    return 1;
	}

	if(!strcmp(cmd, "/ajudabaus", true))
	{
	    if(AdminPlayer(playerid) < 8) return ms(playerid, 0, "Apenas admin level 8+!");
	    ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}.", "\
	    {00ffff}COMANDOS DO BAU\n\n\
	    {ffffff}/criarbau [Conta] [Slots] {a1a1a1}- Criar bau\n\
	    {ffffff}/destruirbau [ID] {a1a1a1}- Destruir bau\n\
	    {ffffff}/moverbau [ID] {a1a1a1}- Mover bau\n\
	    {ffffff}/trazerbau [ID] {a1a1a1}- Trazer bau para sua posicao\n\
	    {ffffff}/senhabau [ID] [Senha] {a1a1a1}- Definir senha\n\
	    \n{a1a1a1}Jogadores: Tecla F abre o bau\n\
	    Senha 0 = sem senha.", "Ok", "");
	    return 1;
	}

	if(!strcmp(cmd, "/trazerbau", true))
	{
	    if(AdminPlayer(playerid) < 6) return ms(playerid, 0, "Apenas admin level 6+!");
	    new bid;
	    if(sscanf(params, "d", bid)) return ms(playerid, 2, "Use: /trazerbau [ ID do Bau ]");
	    if(bid < 0 || bid >= MAX_BAUS || BauI[bid][bau_Existe] != 1) return ms(playerid, 0, "Bau invalido!");
	    GetPlayerPos(playerid, BauI[bid][bau_X], BauI[bid][bau_Y], BauI[bid][bau_Z]);
	    BauI[bid][bau_Mundo] = GetPlayerVirtualWorld_(playerid);
	    BauI[bid][bau_Interior] = GetPlayerInterior(playerid);
	    atualizar_bau_item(bid);
	    salvar_bau_item(bid);
	    ms(playerid, 1, f("Bau [%d] movido para sua posicao!", bid));
	    return 1;
	}

	if(!strcmp(cmd, "/irfurto", true))
	{
	    new found = -1;
	    foreach(new v:Vehicles)
	    {
	        if(furto_ativo[v])
	        {
	            found = v;
	            break;
	        }
	    }
	    if(found == -1) return ms(playerid, 0, "Nenhum furto de veiculo ativo no momento.");
	    new inf = Info_Veiculo[found];
	    if(inf != -1)
	    {
	        Localizar_Player(playerid, furto_pos[inf][0], furto_pos[inf][1], furto_pos[inf][2], 0, -1, "FURTO DE VEICULO");
	        ms(playerid, 1, "Siga ate a marca vermelha no seu radar para encontrar o furto.");
	    }
	    else ms(playerid, 0, "Veiculo do furto nao encontrado.");
	    return 1;
	}

	if(!strcmp(cmd, "/sus", true)){
		new string[550], strmsg[550], Float:XX, Float:YY, Float:ZZ;
		if(id[playerid] == -1) return 1;
		if(sscanf(params, "s[550]", strmsg)){
			return SSM(playerid, -1, "{FF0000}[SERVER]: Use: /sus [ mensagem ]");
		}
		GetPlayerPos(playerid, XX, YY, ZZ);
		for(new arms = 0; arms < MAX_PLAYERS; arms++){
			if(ISP(arms, 5.0, XX, YY, ZZ)){
				SSME(arms, -1, "{BEBEBE}[ BAIXINHO ]: %s(%d) diz: %s", Nome(playerid), id[playerid], strmsg);
			}
		}
		return 1;
	}

	if(!strcmp(cmd, "/g", true)){
		new string[550], strmsg[550], Float:XX, Float:YY, Float:ZZ;
		if(id[playerid] == -1) return 1;
		if(sscanf(params, "s[550]", strmsg)){
			return SSM(playerid, -1, "{FF0000}[SERVER]: Use: /g(rito) [ mensagem ]");
		}	
		GetPlayerPos(playerid, XX, YY, ZZ);
		for(new i = 0; i < MAX_PLAYERS; i++){
			if(ISP(i, 20.0, XX, YY, ZZ)){
				SSME(i, -1, "{FFFFFF}[ GRITO ]: %s(%d) grita: %s!!!!!!", Nome(playerid), id[playerid], strmsg);
			}
		}
		return 1;
	}
	if(!strcmp(cmd, "/salarios", true))
	{
		if(PlayerMedico(playerid))return SSM(playerid, -1, "Nao e acessivel");
	    mostrar_salarios(playerid);
		return 1;
	}

    if(!strcmp(cmd, "/cofre", true))
	{
	    mostrar_cofre_publico(playerid);
		return 1;
	}

    if(!strcmp(cmd, "/taxar", true))
	{
	    if(CargoPlayer(playerid) < 5) return ms(playerid, 0, "Apenas cargo 8+ pode usar este comando !");
	    new val;
	    if(sscanf(params, "d", val)) return ms(playerid, 2, "Use: /taxar [ 0 a 20 ]");
	    if(val < 0 || val > 20) return ms(playerid, 0, "A taxa deve ser de 0 a 20 por cento !");
	    gov_taxa = val;
	    salvar_definicoes("Cofre", cofre_publico);
	    mst(-1, f("{00ffff}[DECRETO] {ffffff}O governo definiu a taxa de impostos em {ffff00}%d%%{ffffff} nos combustiveis !", val));
	    return 1;
	}

    if(!strcmp(cmd, "/beneficio", true))
	{
	    if(CargoPlayer(playerid) < 5) return ms(playerid, 0, "Apenas cargo 8+ pode usar este comando !");
	    new val;
	    if(sscanf(params, "d", val)) return ms(playerid, 2, "Use: /beneficio [ valor ]");
	    if(val < 1) return ms(playerid, 0, "Valor invalido !");
	    if(cofre_publico < val) return ms(playerid, 0, f("O cofre publico nao tem R$ %s disponivel !", ConvertMoney(val)));
	    cofre_publico -= val;
	    salvar_definicoes("Cofre", cofre_publico);
	    foreach(new i:Player) if(Online(i) && id[i] != -1) DarGrana(i, val);
	    mst(-1, f("{00ffff}[DECRETO] {ffffff}O governo liberou um auxilio de {00ff00}R$ %s{ffffff} para todos os cidadaos !", ConvertMoney(val)));
	    return 1;
	}

    if(!strcmp(cmd, "/liberarpreco", true))
	{
	    if(CargoPlayer(playerid) < 5) return ms(playerid, 0, "Apenas cargo 8+ pode usar este comando !");
	    new sss[600];
	    SG[0] = EOS;
	    format(sss, 600, "{ffffff}Gasolina\t{4169E1}R$ %s\n", ConvertMoney(gov_preco_gasolina));
	    strcat(SG, sss);
	    format(sss, 600, "{ffffff}Alcool\t{4169E1}R$ %s\n", ConvertMoney(gov_preco_alcool));
	    strcat(SG, sss);
	    format(sss, 600, "{ffffff}Oleo Disel\t{4169E1}R$ %s\n", ConvertMoney(gov_preco_disel));
	    strcat(SG, sss);
	    format(sss, 600, "{ffffff}Gas\t{4169E1}R$ %s\n", ConvertMoney(gov_preco_gas));
	    strcat(SG, sss);
	    ShowPlayerDialog(playerid, DIALOG_GOVERNO_PRECO, DIALOG_STYLE_LIST, "{ffff00}Selecione o combustivel", SG, "Editar", "Cancelar");
	    return 1;
	}

    if(!strcmp(cmd, "/decreto", true))
	{
	    if(CargoPlayer(playerid) < 5) return ms(playerid, 0, "Apenas cargo 8+ pode usar este comando !");
	    if(strlen(params) < 1) return ms(playerid, 2, "Use: /decreto [ texto ]");
	    new decreto[300];
	    format(decreto, 300, "{00ffff}[DECRETO GOVERNAMENTAL] {ffffff}%s", params);
	    SendClientMessageToAll(-1, decreto);
	    return 1;
	}

    if(!strcmp(cmd, "/investigacao", true))
	{
	    if(CargoPlayer(playerid) < 5) return ms(playerid, 0, "Apenas cargo 8+ pode usar este comando !");
	    new alvo;
	    if(sscanf(params, "u", alvo)) return ms(playerid, 2, "Use: /investigacao [ ID/Nick ]");
	    if(!Online(alvo) || id[alvo] == -1) return ms(playerid, 0, "Jogador nao encontrado !");
	    new conta = id[alvo];
	    new sss[2000];
	    SG[0] = EOS;
	    format(sss, 2000, "{ffffff}Jogador: {ffff00}%s\n\n", Nome(alvo));
	    strcat(SG, sss);
	    format(sss, 2000, "{ffffff}IDF: {00ffff}%d\n", conta);
	    strcat(SG, sss);
	    format(sss, 2000, "{ffffff}Nivel: {ffff00}%d\n", Conta[alvo][c_Nivel]);
	    strcat(SG, sss);
	    format(sss, 2000, "{ffffff}Veiculos:\n");
	    strcat(SG, sss);
	    new total_veiculos;
	    foreach(new v:Iter_Veiculos)
	    {
	        if(Veiculo[v][v_Existe] == 1 && Veiculo[v][v_Dono] == conta)
	        {
	            total_veiculos++;
	            format(sss, 2000, "{a1a1a1}  %s - Placa: %s\n", NomeVeiculo(Veiculo[v][v_Modelo]), PlacaVeiculo[v]);
	            strcat(SG, sss);
	        }
	    }
	    if(total_veiculos == 0) strcat(SG, "{a1a1a1}  Nenhum veiculo registrado.\n");
	    strcat(SG, "\n");
	    new total_multas;
	    foreach(new v:Iter_Veiculos)
	    {
	        if(Veiculo[v][v_Existe] == 1 && Veiculo[v][v_Dono] == conta)
	        {
	            for(new m; m<MAX_MULTAS; m++)
	            {
	                if(Veiculo_Multa[v][m][mu_Existe] == 1)
	                {
	                    total_multas++;
	                    format(sss, 2000, "{a1a1a1}%s - {ff0000}R$ %s\n", Veiculo_Multa[v][m][mu_Motivo], ConvertMoney(Veiculo_Multa[v][m][mu_Valor]));
	                    strcat(SG, sss);
	                }
	            }
	        }
	    }
	    if(total_multas == 0) strcat(SG, "{a1a1a1}Nenhuma multa encontrada.\n");
	    else format(sss, 2000, "\n{ffffff}Total de Multas: {ffff00}%d\n", total_multas), strcat(SG, sss);
	    if(Conta[alvo][c_Cadeia] != -1) format(sss, 2000, "\n{ff0000}Status: PRESO - Tempo restante: %s\n", ConvertTime(Conta[alvo][c_TempoCadeia])), strcat(SG, sss);
	    else strcat(SG, "\n{00ff00}Status: LIVRE\n");
	    ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{ffff00}Investigacao", SG, "Ok", "Fechar");
	    return 1;
	}

    if(!strcmp(cmd, "/venderprods", true))
	{
		if(id[playerid] == -1) return 1;
		if(EmpregoPlayer(playerid) == 11)
		{
		    new car = caminhao_player[playerid];
		    if(GetVehicleModel(car) != 0)
		    {
		        new v = Info_Veiculo[car];
		        if(v != -1)
		        {
		        	new Float:pos[3];
				GetVehiclePos(car, pos[0], pos[1], pos[2]);
				if(IsPlayerInRangeOfPoint(playerid, 50, pos[0], pos[1], pos[2]))
				{
				    foreach(new a:Iter_Empresas)
					{
				        if(Empresa[a][em_Existe] == 1)
				        {
				            if(IsPlayerInRangeOfPoint(playerid, 2, Empresa[a][em_X],Empresa[a][em_Y],Empresa[a][em_Z]))
				            {
				                if(Empresa[a][em_Dono] == id[playerid])
				                {
				                    ms(playerid, 0, "Voce nao pode revender produtos para sua propria Empresa !");
				                }
				                else if(Empresa[a][em_Dono] != -1)
				                {
				                    if(Empresa[a][em_Produtos] < 500) mostrar_vender_prods(playerid, v, car, a);
				                    else ms(playerid, 0, "Esta empresa nao precisa de produtos no momento !");
				                }
				                else ms(playerid, 0, "Esta empresa nao tem um dono !");
				                return 1;
				            }
				        }
				    }
						ms(playerid, 0, "Voce nao esta proximo a entrada de uma Empresa !");
				}
				else ms(playerid, 0, "Seu caminhao precisa estar no minimo a 50 metros para voce realizar revenda de produtos !");
		        }
		        else ms(playerid, 0, "Seu caminhao precisa estar no minimo a 50 metros para voce realizar revenda de produtos !");
		    }
		    else ms(playerid, 0, "Seu caminhao precisa estar no minimo a 50 metros para voce realizar revenda de produtos !");
		}
		else ms(playerid, 0, "Voce nao pertence ao emprego caminhoneiro !");
		return 1;
	}


	if(!strcmp(cmd, "/emps", true))
	{
		mostrar_empresas(playerid);
		return 1;
	}

    if(!strcmp(cmd, "/casas", true))
	{
		mostrar_casas(playerid);
		return 1;
	}

    if(!strcmp(cmd, "/configs", true))
	{
		mostrar_config(playerid);
		return 1;
	}

    if(!strcmp(cmd, "/veiculos", true))
	{
		SetPVarInt(playerid, "voltar_lista", 1);
		mostrar_veiculos(playerid, 0);
		return 1;
	}

    if(!strcmp(cmd, "/carmenu", true))
	{
		if(id[playerid] == -1) return 1;
		if(IsPlayerInAnyVehicle(playerid))
		{
			new ve = GetPlayerVehicleID(playerid);
			new i = Info_Veiculo[ve];
		    if(i != -1)
		    {
		        if(Veiculo[i][v_Dono] == id[playerid])
		        {
		            SetPVarInt(playerid, "voltar_lista", 0);
		            mostrar_veiculos(playerid, 1, i);
		        }
		        else ms(playerid, 0, "Voce nao esta em um veiculo que seja seu !");
		    }
		    else ms(playerid, 0, "Voce nao esta em um veiculo que seja seu !");
		}
		else ms(playerid, 0, "Voce nao esta em um veiculo que seja seu !");
		return 1;
	}

    if(!strcmp(cmd, "/carregarmapa", true))
	{
		ms(playerid, 1, "Mapa recaregado com sucesso");
	    SendRconCommand("reloadfs mapas");
		return 1;
	}

	if(!strcmp(cmd, "/carregarvoip", true))
	{
		ms(playerid, 1, "VOIP recaregado com sucesso");
	    SendRconCommand("reloadfs VOIP");
		return 1;
	}

	if(!strcmp(cmd, "/sairorg", true))
	{
		new o = OrgPlayer(playerid);
		if(Conta[playerid][c_Cargo] >= 6) return ms(playerid, 0, "O lider nao pode sair da org ! Passe a lideranca primeiro.");
		new c = id[playerid];
		new a = slot_membro(playerid);
		if(a != -1)
		{
			Conta[playerid][c_Org] = -1;
			Conta[playerid][c_Cargo] = 0;
			salvar_conta(c, 0, "c_Org", sv_int(-1));
			salvar_conta(c, 0, "c_Cargo", sv_int(0));
			Org[o][o_Membros][a] = -1;
			Org[o][o_Cargos][a] = 0;
			salvar_org(o);
			remover_taser_player(playerid);
			SetPlayerSkin(playerid, 26);
			Conta[playerid][c_Skin] = 26;
			salvar_conta(c, 0, "c_Skin", sv_int(26));
			new sss[150];
		    PlayerSpawn(playerid);
		    format(sss, 150, "Voce saiu da Org '%s' por vontade propria.", NomeOrg(o));
		    ms(playerid, 1, sss);
		    format(sss, 150, "Membro '%s' deixou a Organizacao.", Nome(playerid));
		    escrever_log(f("OrgsLog/Org_%d.txt", o), sss);
		}
		else ms(playerid, 0, "Voce nao faz parte de uma Organizacao !");
		return 1;
	}



	if(!strcmp(cmd, "/contasfake", true))
	{
		new dias, nivel, horas;
		if(sscanf(params, "ddd", dias, nivel, horas)) return ms(playerid, 2, "Use: /contasfake [ Dias Off ] [ Nivel Minimo ] [ Horas Jogadas ].");
	    contas_fake(playerid, dias, nivel, horas);
		return 1;
	}

	if(!strcmp(cmd, "/chatkill", true))
	{
	    ler_logs("Server/ChatKill.txt"), ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Ultimas Mortes", SG, "Ok", "Fechar");
		return 1;
	}

	if(!strcmp(cmd, "/combates", true))
	{
	    ler_logs("Server/Combates.txt"), ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "Ultimas Mortes", SG, "Ok", "Fechar");
		return 1;
	}

	if(!strcmp(cmd, "/apreenderveiculo", true))
	{
	    new placa[20], v = -1;
	    if(sscanf(params, "s[20]", placa))
	    {
	        // sem placa - tenta pegar veiculo mais proximo
	        new Float:dist = 999.0, Float:p[3], Float:pd[3];
	        GetPlayerPos(playerid, p[0], p[1], p[2]);
	        foreach(new vv:Iter_Veiculos)
	        {
	            if(Veiculo[vv][v_Existe] != 1 || GetVehicleModel(vv) == 0) continue;
	            GetVehiclePos(vv, pd[0], pd[1], pd[2]);
	            new Float:d = GetPlayerDistanceFromPoint(playerid, pd[0], pd[1], pd[2]);
	            if(d < dist && d < 5.0 && (Veiculo[vv][v_Dono] != -1 || Veiculo[vv][v_Emprego] != -1 || Veiculo[vv][v_Org] != -1))
	            {
	                dist = d;
	                v = vv;
	            }
	        }
	        if(v == 0 || GetVehicleModel(v) == 0) return ms(playerid, 2, "Use: /apreenderveiculo [ PLACA ]\nOu fique perto de um veiculo sem placa.");
	    }
	    else
	    {
	        // busca por placa
	        foreach(new vv:Iter_Veiculos)
	        {
	            if(Veiculo[vv][v_Existe] == 1 && strcmp(PlacaVeiculo[vv], placa, true) == 0)
	            {
	                v = vv;
	                break;
	            }
	        }
	        if(v == 0 || Veiculo[v][v_Existe] != 1) return ms(playerid, 0, "Nenhum veiculo encontrado com esta placa!");
	    }
	    if(v == -1 || Veiculo[v][v_Existe] != 1) return ms(playerid, 0, "Veiculo invalido!");
	    if(Veiculo[v][v_Dono] == -1) return ms(playerid, 0, "Este veiculo nao tem dono para ser apreendido!");
	    if(Veiculo[v][v_Emprego] != -1 || Veiculo[v][v_Org] != -1) return ms(playerid, 0, "Nao e possivel apreender veiculos de empregos ou organizacoes!");
	    new cc = Veiculo[v][v_Dono];
	    new player = ContaOnline(cc);
	    if(Online(player)) ms(player, 0, "Seu veiculo foi apreendido pelo Detran e enviado ao deposito!");
	    else msc(cc, 0, "Seu veiculo foi apreendido pelo Detran e enviado ao deposito!");
	    Veiculo[v][v_Dono] = -1;
	    Veiculo[v][v_Contas] = 20000;
	    Veiculo[v][v_IPVA] = 0;
	    format(Veiculo[v][v_History], 300, "%d|%d", cc, gettime());
	    if(Veiculo[v][v_ID] != -1 && GetVehicleModel(Veiculo[v][v_ID]) != 0)
	    {
	        Info_Veiculo[Veiculo[v][v_ID]] = -1;
	        DestroyVehicle_(Veiculo[v][v_ID]);
	    }
	    Veiculo[v][v_ID] = -1;
	    Veiculo[v][v_Garagem] = 0;
	    SalvarInfo(v);
	    ms(playerid, 5, f("Veiculo apreendido e enviado ao deposito! Dívida: R$ 20.000"));
	    return 1;
	}

	if(!strcmp(cmd, "/dominar", true))
	{
		new g = PegarTerritorio(playerid);
		if(g == -1) ms(playerid, 0, "Voce nao esta em um Territorio Dominavel !");
		else ComecarGuerra(playerid, g);
		return 1;
	}

	if(!strcmp(cmd, "/logs", true))
	{
		lostrar_lista_logs(playerid);
		return 1;
	}

	if(!strcmp(cmd, "/liders", true))
	{
		new sss[300];
		new cont;
		new dataa[50];
		new o;
		new tel;
		new numerop[20];
	    SG[0] = EOS;
	    zerar_lista(playerid);
	    strcat(SG, "Org\tNome\tStatus\tTelefone\n");
	    foreach(new a:Player)
	    {
	    	if(cont >= MAX_LISTA || cont > 50) break;
			if(Online(a))
			{
			    o = OrgPlayer(a);
			    tel = player_chip(a);
			    if(id[a] != -1)
				{
				    if(o != -1)
					{
					    if(Conta[a][c_Cargo] == 6)
						{
						if(Player_AFK(a) == 0) format(dataa, 50, "{4169E1}Online");
						else format(dataa, 50, "{a1a1a1}AFK: %s", ConvertTime(Player_AFK(a)));
						if(tel == -1) format(numerop, 20, "{a1a1a1}Nenhum");
						else format(numerop, 20, "{00ffff}%d", tel);
						format(sss, 300, "{%06x}%s\t{ffffff}%s\t%s\t%s\n", CorOrg(o) >>> 8, NomeOrg(o), Nome(a), dataa, numerop);
					    strcat(SG, sss);
					    Lista[playerid][cont] = id[a];
							cont ++;
						}
					}
				}
			}
		}
		format(sss, 300, "{ffffff}Liders Online {ffff00}[{ffffff}%d{ffff00}]", cont);
	    ShowPlayerDialog(playerid, DIALOG_LIDERS, DIALOG_STYLE_TABLIST_HEADERS, sss, SG, "Opcoes", "Fechar");
		return 1;
	}


