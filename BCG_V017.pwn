	            {
	                SetPlayerInterior(playerid, 0);
	                SetPlayerVirtualWorld_(playerid, 0);
                    SetPlayerPos_(playerid, Conce[i][con_X]+0.1, Conce[i][con_Y]+0.1, Conce[i][con_Z]+0.1 );
					abrir_conce(playerid, i);
