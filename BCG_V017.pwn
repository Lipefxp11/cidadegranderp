    ShowPlayerDialog(playerid, DIALOG_SETAR_SKIN_ORG2, DIALOG_STYLE_INPUT, sss,
	"\n{ffffff}Digite o {00ffff}ID {ffffff}da {ffff00}skin {ffffff}que deseja setar para este Slot:\n{a1a1a1}( Use -1 para remover a skin )\n\n", "Continuar", "Cancelar");
}

stock setar_skins_org(playerid, i)
