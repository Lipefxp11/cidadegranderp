stock LiderOrg(i)
{
    if(Org[i][o_Existe] == 1)
	{
		for(new a; a<30; a++)
		{
			if(Org[i][o_Membros][a] != -1)
			{
			    if(Org[i][o_Cargos][a] >= 6)
				{
				return a;
			    }
			}
		}
	}
	return -1;
}

stock verificar_membro_org(c)
{
	new player = ContaOnline(c);
	if(Online(player))
	{
	    Conta[player][c_Org] = -1;
		Conta[player][c_Cargo] = 0;
		foreach(new i:Iter_Orgs)
		{
		    if(Org[i][o_Existe] == 1)
		    {
				for(new a; a<30; a++)
				{
				    if(Org[i][o_Membros][a] == c)
					{
					Conta[player][c_Org] = i;
					Conta[player][c_Cargo] = Org[i][o_Cargos][a];
					break;
				    }
				}
			}
		}
	}
}

stock abrir_membros_org(playerid, i)
{
    if(Org[i][o_Existe] == 1)
	{
	    if(Online(playerid))
	    {
	        new sss[150];
	        SG[0] = EOS;
	        strcat(SG, "Membro\tCargo\n");
	        for(new a; a<30; a++)
	        {
		        new c = Org[i][o_Membros][a];
		        new ca = Org[i][o_Cargos][a];
		        if( c == -1) format(sss, 150, "{ffffff}%s\t{ffff00}%s\n", Nome(-1), "Nenhum");
		        else format(sss, 150, "{a1a1a1}%s\t{a1a1a1}%s\n", NomeConta(c), nome_cargo(ca, i));
		        strcat(SG, sss);
	        }
	        format(sss, 150, "{ffffff}Membros [ {00ffff}%d {ffffff}]", membros(i));
	        ShowPlayerDialog(playerid, DIALOG_ORG3, DIALOG_STYLE_TABLIST_HEADERS, sss, SG, "Continuar", "Voltar");
	    }
	}
}

stock nome_cargo(a, o)
{
	new ca[20];
	format(ca, 20, "Nenhum");
	if(a > -1)
	{
		if( a < 5 ) format(ca, 20, "Cargo %d", a);
		if( a == 5 ) format(ca, 20, "Sub Lider");
		if( a == 6 ) format(ca, 20, "Lider");
	}
	if(o != -1)
	{
	    if(OrgCop(o))
	    {
	        if(a > -1 && a < 7)
	        {
	        	format(ca, 20, cargo_cop[a]);
	        }
	    }
	}
	return ca;
}

stock slot_membro(playerid)
{
    new o = OrgPlayer(playerid);
	if(o != -1)
	{
		for(new a; a<30; a++)
		{
		    if(Org[o][o_Membros][a] == id[playerid])
		    {
		        return a;
			}
		}
	}
	return -1;
}

stock opcoes_membro_org(playerid, i, a)
{
    if(Org[i][o_Existe] == 1)
	{
	    new cc = Org[i][o_Membros][a];
	    if(cc != -1)
	    {
		    if(Online(playerid))
		    {
		        if(OrgPlayer(playerid) == i)
		        {
		            SetPVarInt(playerid, "id_org", i);
		            SetPVarInt(playerid, "id_membro", a);
		            new sss[300];
		            new c = id[playerid];
		            if(c != -1)
		            {
				    strcat(sss, "Utimo Login\n");
				    if(Conta[playerid][c_Cargo] > 4 && id[playerid] != cc && Org[i][o_Cargos][a] < 6)
					{
				    	strcat(sss, "Expulsar\n");
				    	strcat(sss, "Promover\n");
				    	strcat(sss, "Setar Cargo\n");
				    }
				    ShowPlayerDialog(playerid, DIALOG_ORG4, DIALOG_STYLE_LIST, NomeConta(Org[i][o_Membros][a]), sss, "Continuar", "Voltar");
					}
				}
			}
		}
	}
}

