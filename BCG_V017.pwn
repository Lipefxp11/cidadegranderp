	        else format(SG, 500, "\n{ffffff}Digite a producao final da Caixa de '%s':\n", nome_arma(armas_org[arma][0]));
            Input(playerid, DIALOG_FABRICACAO8, sss, SG);
	    }
	    else fabricacao(playerid, 4);
	    return 1;
	}

	// setar fabricacao de colete //
