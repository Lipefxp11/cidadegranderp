stock OM_DestruirTDP(playerid)
{
    for(new i; i<5; i++) { PlayerTextDrawDestroy(playerid, OM_TDP[playerid][i]); OM_TDP[playerid][i] = PlayerText:INVALID_TEXT_DRAW; }
}

stock OM_AtualizarStatus(playerid)
{
    new str[64];
    PlayerTextDrawColor(playerid, OM_TDP[playerid][0], OM_ErroFiles[playerid] ? 0xFF0000FF : 0x00FF00FF);
    PlayerTextDrawSetString(playerid, OM_TDP[playerid][0], OM_ErroFiles[playerid] ? "FILES: ERRO!!!" : "FILES: PERFEITO!");
    PlayerTextDrawColor(playerid, OM_TDP[playerid][1], OM_ErroVelo[playerid] ? 0xFF0000FF : 0x00FF00FF);
    PlayerTextDrawSetString(playerid, OM_TDP[playerid][1], OM_ErroVelo[playerid] ? "VELOCIDADE: ERRO!!!" : "VELOCIDADE: BOM!");
    PlayerTextDrawColor(playerid, OM_TDP[playerid][2], OM_ErroIdle[playerid] ? 0xFF0000FF : 0x00FF00FF);
    PlayerTextDrawSetString(playerid, OM_TDP[playerid][2], OM_ErroIdle[playerid] ? "IDLE: ERRO!!!" : "IDLE: PERFEITO!");
    new mv = OM_ErroMaxV[playerid] ? random(30)+1 : random(71)+30;
    PlayerTextDrawColor(playerid, OM_TDP[playerid][3], OM_ErroMaxV[playerid] ? 0xFF0000FF : 0x00FF00FF);
    format(str, 64, "MAX VEL: %d", mv); PlayerTextDrawSetString(playerid, OM_TDP[playerid][3], str);
    for(new i; i<5; i++) PlayerTextDrawShow(playerid, OM_TDP[playerid][i]);
}

stock bool:OM_TudoOk(playerid)
{
    return !OM_ErroFiles[playerid] && !OM_ErroVelo[playerid] && !OM_ErroIdle[playerid] && !OM_ErroMaxV[playerid];
}

forward OM_GerarProblema(playerid);
public OM_GerarProblema(playerid)
{
    if(!OM_EmServico[playerid]) return;
    new loc = random(sizeof(OM_Locais));
    OM_ErroFiles[playerid] = random(2) == 1;
    OM_ErroVelo[playerid] = random(2) == 1;
    OM_ErroIdle[playerid] = random(2) == 1;
    OM_ErroMaxV[playerid] = random(100) < 30;
    OM_Problema[playerid] = 1;
    OM_CPX[playerid] = OM_Locais[loc][0]; OM_CPY[playerid] = OM_Locais[loc][1]; OM_CPZ[playerid] = OM_Locais[loc][2];
    SetPlayerCheckpoint(playerid, OM_CPX[playerid], OM_CPY[playerid], OM_CPZ[playerid], 5.0);
    OM_Checkpoint[playerid] = 1;
    ms(playerid, 0, "Maquina com problema! Va ate o checkpoint e use /consertarmaquina");
    KillTimer(OM_Timer[playerid]);
}

forward OM_Tick(playerid);
public OM_Tick(playerid)
{
    if(!OM_Consertando[playerid]) { KillTimer(OM_TimerP[playerid]); OM_TimerP[playerid] = 0; return; }
    OM_Progresso[playerid]--;
    new str[32];
    format(str, 32, "OPERANDO: %d...", OM_Progresso[playerid]);
    PlayerTextDrawShow(playerid, OM_TDP[playerid][4]);
    PlayerTextDrawSetString(playerid, OM_TDP[playerid][4], str);
    if(OM_Progresso[playerid] <= 0)
    {
        KillTimer(OM_TimerP[playerid]); OM_TimerP[playerid] = 0;
        switch(OM_CompAtual[playerid])
        {
            case 0: OM_ErroFiles[playerid] = 0;
            case 1: OM_ErroVelo[playerid] = 0;
            case 2: OM_ErroIdle[playerid] = 0;
            case 3: OM_ErroMaxV[playerid] = 0;
        }
        OM_AtualizarStatus(playerid);
        PlayerTextDrawSetString(playerid, OM_TDP[playerid][4], "OPERANDO: AGUARDANDO...");
        if(OM_TudoOk(playerid)) PlayerTextDrawSetString(playerid, OM_TDP[playerid][4], "TUDO OK! Clique em RESET");
        ms(playerid, 0, "Componente consertado!");
    }
}

stock bool:OM_VerificarEmprego(playerid) { return EmpregoPlayer(playerid) == OM_EMPREGO_ID; }

