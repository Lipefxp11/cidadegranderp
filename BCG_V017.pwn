	            strcat(SG, "{ffffff}/ajuda {a1a1a1}para mais informacoes sobre seu emprego.\n");
	        }
	        else if(listitem == 2 && EmpregoPlayer(playerid) != -1 || listitem == 1 && EmpregoPlayer(playerid) == -1)
	        {
	            new org = OrgPlayer(playerid);
	            if(org != -1)
	            {
	                new org_tipo = Org[org][o_Tipo];
	                strcat(SG, "{00ffff}COMANDOS DA ORGANIZACAO:{ffffff}\n\n");
	                for(new v; v<sizeof ComandosOrg; v++)
	                {
	                    new cmd_tipo = strval(ComandosOrg[v][2]);
	                    if(cmd_tipo == -1 || cmd_tipo == org_tipo || cmd_tipo == 0 && org_tipo == 0)
	                    {
	                        strcat(SG, ComandosOrg[v][0]);
	                        strcat(SG, "  ");
	                        strcat(SG, ComandosOrg[v][1]);
	                        strcat(SG, "\n");
	                    }
	                }
	            }
	        }
	        ShowPlayerDialog(playerid, DIALOG_VAZIO, DIALOG_STYLE_MSGBOX, "{000000}_", SG, "Ok", "Fechar");
	    }
	    return 1;
	}

	if(dialogid == DIALOG_PAINEL_ORG)
	{
	    if(response)
	    {
	        new org = OrgPlayer(playerid);
	    if(org == -1) return 1;
	        if(listitem == 0) comando(playerid, "/membros", "");
	        else if(listitem == 1) comando(playerid, "/convidarorg", "");
	        else if(listitem == 2) comando(playerid, "/logsorg", "");
	        else if(listitem == 3)
	        {
	            if(Conta[playerid][c_Cargo] < 1) return MS(playerid, 0, "Voce nao tem cargo para usar a skin da org !");
	            new skin_id = Org[org][o_Skins][Conta[playerid][c_Cargo]];
	            if(skin_id < 0 || skin_id > 311) skin_id = Org[org][o_Skins][6];
	            if(skin_id < 0 || skin_id > 311) return MS(playerid, 0, "Nenhuma skin definida para sua organizacao !");
	            SetPlayerSkin(playerid, skin_id);
	            Conta[playerid][c_Skin] = skin_id;
	            salvar_conta(id[playerid], 0, "c_Skin", sv_int(skin_id));
	            MS(playerid, 1, "Voce vestiu a skin da organizacao !");
	        }
	        else if(listitem == 4)
	        {
		if(Conta[playerid][c_Cargo] < 6) return MS(playerid, 0, "Apenas o lider pode definir a skin da org !");
            ShowPlayerDialog(playerid, DIALOG_SETAR_SKIN_ORG2, DIALOG_STYLE_INPUT, "{ffff00}Definir Skin da Org", "\n{ffffff}Digite o {00ffff}ID {ffffff}da {ffff00}skin {ffffff}que todos os membros usarao:\n", "Definir", "Cancelar");
            SetPVarInt(playerid, "definindo_skin_org", org);
            SetPVarInt(playerid, "id_org", -1);
	        }
	        else if(listitem == 5) comando(playerid, "/sairorg", "");
	    }
	    return 1;
	}

	if(dialogid == DIALOG_CRIAR_FACCAO)
	{
	    if(response)
	    {
	        if(strlen(inputtext) < 3) { MS(playerid, 0, "Nome muito curto !"); ShowPlayerDialog(playerid, DIALOG_CRIAR_FACCAO, DIALOG_STYLE_INPUT, "{ffff00}Criar Faccao", "{ffffff}Digite o nome da sua faccao:", "Continuar", "Cancelar"); return 1; }
	        SetPVarString(playerid, "fac_nome", inputtext);
	        ShowPlayerDialog(playerid, DIALOG_CRIAR_FACCAO_TAG, DIALOG_STYLE_INPUT, "{ffff00}Criar Faccao - Tag", "{ffffff}Digite a tag da sua faccao (ex: FCC):", "Continuar", "Cancelar");
	    }
	    return 1;
	}

	if(dialogid == DIALOG_CRIAR_FACCAO_TAG)
	{
	    if(response)
	    {
	        if(strlen(inputtext) < 2) { MS(playerid, 0, "Tag muito curta !"); ShowPlayerDialog(playerid, DIALOG_CRIAR_FACCAO, DIALOG_STYLE_INPUT, "{ffff00}Criar Faccao", "{ffffff}Digite o nome da sua faccao:", "Continuar", "Cancelar"); return 1; }
	        SetPVarString(playerid, "fac_tag", inputtext);
	        ShowPlayerDialog(playerid, DIALOG_CRIAR_FACCAO_SKIN, DIALOG_STYLE_INPUT, "{ffff00}Criar Faccao - Skin", "{ffffff}Digite o ID da skin para o lider (ex: 285):", "Criar", "Cancelar");
	    }
	    return 1;
	}

	if(dialogid == DIALOG_CRIAR_FACCAO_SKIN)
	{
	    if(response)
	    {
	        if(!IsNumeric(inputtext)) { MS(playerid, 0, "Digite apenas numeros !"); ShowPlayerDialog(playerid, DIALOG_CRIAR_FACCAO_TAG, DIALOG_STYLE_INPUT, "{ffff00}Criar Faccao - Tag", "{ffffff}Digite a tag:", "Continuar", "Cancelar"); return 1; }
	        new skin_id = strval(inputtext);
	        if(skin_id < 0 || skin_id > 311) { MS(playerid, 0, "Skin invalida (0-311) !"); ShowPlayerDialog(playerid, DIALOG_CRIAR_FACCAO_SKIN, DIALOG_STYLE_INPUT, "{ffff00}Criar Faccao - Skin", "{ffffff}Digite o ID da skin:", "Criar", "Cancelar"); return 1; }
	        SetPVarInt(playerid, "fac_skin", skin_id);
	        ShowPlayerDialog(playerid, DIALOG_CRIAR_FACCAO_COR, DIALOG_STYLE_LIST, "{ffff00}Escolha a Cor da Faccao",
	            "{FF0000}Vermelho\n{FF8800}Laranja\n{FFFF00}Amarelo\n{00FF00}Verde\n{00FFFF}Ciano\n{0000FF}Azul\n{FF00FF}Magenta\n{FF69B4}Rosa\n{FFFFFF}Branco\n{808080}Cinza\n{000000}Preto",
	            "Criar", "Cancelar");
	    }
	    return 1;
	}

	if(dialogid == DIALOG_CRIAR_FACCAO_COR)
	{
	    if(response)
	    {
	        new cor_cores[] = {18, 6, 158, 135, 133, 2, 5, 112, 1, 15, 0};
	        new cor = cor_cores[listitem];
	        new nome[60], tag[10];
	        GetPVarString(playerid, "fac_nome", nome, 60);
	        GetPVarString(playerid, "fac_tag", tag, 10);
	        new skin_id = GetPVarInt(playerid, "fac_skin");
	        new cash = GetPVarInt(playerid, "fac_cash");
	        if(cash > CashPlayer(playerid)) { MS(playerid, 0, "Cash insuficiente !"); return 1; }
	        new Float:pos[3];
	        GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
	        new o = criar_org(pos[0], pos[1], pos[2], nome, tag);
	        if(o == -1) { MS(playerid, 0, "Numero maximo de Orgs atingido !"); return 1; }
	        if(IsValidDynamicPickup(Org[o][o_Pickup])) DestroyDynamicPickup_(Org[o][o_Pickup]);
	        if(IsValidDynamic3DTextLabel(Org[o][o_3D])) DestroyDynamic3DTextLabel(Org[o][o_3D]);
	        if(IsValidDynamicMapIcon(Org[o][o_Mapa])) DestroyDynamicMapIcon_(Org[o][o_Mapa]);
	        Org[o][o_Tipo] = 5;
	        Org[o][o_Cor] = cor;
	        Org[o][o_Membros][0] = id[playerid];
	        Org[o][o_Cargos][0] = 6;
	        format(Org[o][o_Skins][6], 60, "%d", skin_id);
	        Org[o][o_MapaID] = -1;
	        salvar_org(o);
	        Conta[playerid][c_Org] = o;
	        Conta[playerid][c_Cargo] = 6;
	        salvar_conta(id[playerid], 0, "c_Org", sv_int(o));
	        salvar_conta(id[playerid], 0, "c_Cargo", sv_int(6));
	        SetPlayerSkin(playerid, skin_id);
	        DarCash(playerid, -cash);
	        fac_estoque--;
	        salvar_definicoes("Cofre", cofre_publico);
	        Iter_Add(Iter_Orgs, o);

	        new sync_file[80];
	        format(sync_file, 80, "org_sync.txt");
	        new File:fp = fopen(sync_file, io_append);
	        if(fp)
	        {
	            new sync_line[40];
	            format(sync_line, 40, "%d\r\n", id[playerid]);
	            fwrite(fp, sync_line);
	            fclose(fp);
	        }

	        mst(-1, f("{ffff00}[FACCACAO] {ffffff}A faccao '{ffff00}%s{ffffff}' foi criada por {ffff00}%s{ffffff}!", nome, Nome(playerid)));
	        MS(playerid, 1, f("Faccao '%s' [%s] criada com sucesso ! Use /painel para gerenciar.", nome, tag));
	    }
	    return 1;
	}

	// dialog limpar vaga de admin //
	if(dialogid == DIALOG_LISTA_ADMIN5)
	{
	    if(response)
	    {
	        new i = GetPVarInt(playerid, "admin");
	        new cc = Admin[i][adm_Conta];
	        format(sttr, 150, "Voce limpou a Vaga de '%s' da lista de Administradores.", NomeConta(cc));
            destruir_admin(cc);
            ms(playerid, 4, sttr);
            mostrar_admins(playerid);
	    }
	    else OnDialogResponse(playerid, DIALOG_LISTA_ADMIN2, 1, -1, "");
	    return 1;
	}

    // DIALOG SETAR ADMIN //
	if(dialogid == DIALOG_LISTA_ADMIN4)
	{
	    new i = GetPVarInt(playerid, "admin");
	    new ii = GetPVarInt(playerid, "opcao");
	    new numero = strval(inputtext);
	    if(response)
	    {
	        if(ii == 0)
	        {
	            if(!IsNumeric(inputtext))
	            {
	                OnDialogResponse(playerid, DIALOG_LISTA_ADMIN3, 1, ii, "");
	                ms(playerid, 0, "Use apenas numeros !");
	                return 1;
	            }

				if(AdminPlayer(playerid) < 7)
				{
				    if(numero < 1 || numero > 6)
		            {
		                OnDialogResponse(playerid, DIALOG_LISTA_ADMIN3, 1, ii, "");
		                ms(playerid, 0, "Use um Level de 1 a 6 !");
		                return 1;
		            }
				}

	            if(numero < 1 || numero > 10)
	            {
	                OnDialogResponse(playerid, DIALOG_LISTA_ADMIN3, 1, ii, "");
	                ms(playerid, 0, "Use um Level de 1 a 10 !");
	                return 1;
	            }

	            Admin[i][adm_Level] = numero;
	            format(sttr, 150, "Voce setou o Level Admin de '%s' para %d.", NomeConta(Admin[i][adm_Conta]), Admin[i][adm_Level]);
	            ms(playerid, 4, sttr);
	            OnDialogResponse(playerid, DIALOG_LISTA_ADMIN2, 1, -1, "");
				salvar_admin(i);
	        }

	        if(ii == 1)
	        {
	            if(strlen(inputtext) <= 2)
	            {
	                OnDialogResponse(playerid, DIALOG_LISTA_ADMIN3, 1, ii, "");
	                ms(playerid, 0, "Nome de funcao muito curto, tente novamente !");
	                return 1;
	            }

	            format(Admin[i][adm_Funcao], 40, inputtext);
	            format(sttr, 150, "Voce setou a Funcao Admin de '%s' para '%s'.", NomeConta(Admin[i][adm_Conta]), Admin[i][adm_Funcao]);
	            ms(playerid, 4, sttr);
	            OnDialogResponse(playerid, DIALOG_LISTA_ADMIN2, 1, -1, "");
				salvar_admin(i);
	        }

	        if(ii == 2)
	        {
	            if(!IsNumeric(inputtext))
	            {
	                OnDialogResponse(playerid, DIALOG_LISTA_ADMIN3, 1, ii, "");
	                ms(playerid, 0, "Use apenas numeros !");
	                return 1;
	            }

	            if(ContaInvalida(numero))
	            {
	                OnDialogResponse(playerid, DIALOG_LISTA_ADMIN3, 1, ii, "");
	                ms(playerid, 0, "Conta Invalida !");
	                return 1;
	            }

	            Admin[i][adm_Responssavel] = numero;
	            format(sttr, 150, "Voce setou '%s' como responssavel pelo Admin '%s'.", NomeConta(Admin[i][adm_Responssavel]), NomeConta(Admin[i][adm_Conta]));
	            ms(playerid, 4, sttr);
	            OnDialogResponse(playerid, DIALOG_LISTA_ADMIN2, 1, -1, "");
				salvar_admin(i);
	        }
	    }
	    else OnDialogResponse(playerid, DIALOG_LISTA_ADMIN2, 1, -1, "");
	    return 1;
	}

    // DIALOG SETAR ADMIN //
	if(dialogid == DIALOG_LISTA_ADMIN3)
	{
	    new ii = GetPVarInt(playerid, "listitem");
	    if(response)
	    {
			if(listitem == 0)
			{
			    SetPVarInt(playerid, "opcao", 0);
				ShowPlayerDialog(playerid, DIALOG_LISTA_ADMIN4, DIALOG_STYLE_INPUT, "Level do Admin", "\n\n{ffffff}Digite o novo Level de {00ffff}1 {ffffff}a {00ffff}10 {ffffff}deste {ffff00}Administrador{ffffff}:\n\n", "Setar", "Voltar");
			}

			if(listitem == 1)
			{
			    SetPVarInt(playerid, "opcao", 1);
				ShowPlayerDialog(playerid, DIALOG_LISTA_ADMIN4, DIALOG_STYLE_INPUT, "Funcao do Admin", "\n\n{ffffff}Defina a nova Funcao deste {ffff00}Administrador{ffffff}:\n\n", "Setar", "Voltar");
			}

			if(listitem == 2)
			{
			    SetPVarInt(playerid, "opcao", 2);
				ShowPlayerDialog(playerid, DIALOG_LISTA_ADMIN4, DIALOG_STYLE_INPUT, "Responssavel pelo Admin", "\n\n{ffffff}Defina o Novo Responssavel deste {ffff00}Administrador{ffffff}:\n\n", "Setar", "Voltar");
			}

			if(listitem == 3)
			{
				ShowPlayerDialog(playerid, DIALOG_LISTA_ADMIN5, DIALOG_STYLE_MSGBOX, "Limpar vaga Admin", "\n\n{ffffff}Deseja realmente {ff0000}Limpar a Vaga{ffffff} deste Administrador ?\n\n", "Limpar", "Voltar");
			}
	    }
	    else OnDialogResponse(playerid, DIALOG_LISTA_ADMIN, 1, ii, "");
	    return 1;
	}

	// dialog das infos do admin //
    if(dialogid == DIALOG_LISTA_ADMIN2)
	{
	    if(response)
		{
		    new i = GetPVarInt(playerid, "admin");
		    new ii = GetPVarInt(playerid, "listitem");
	        if(AdminPlayer(playerid) >= 8)
	        {
	            SG[0] = EOS;
	            format(sttr, 150, "{ffffff}Nivel\t{a1a1a1}%d\n", Admin[i][adm_Level]);
	            strcat(SG, sttr);
	            format(sttr, 150, "{ffffff}Funcao\t{a1a1a1}%s\n", Admin[i][adm_Funcao]);
	            strcat(SG, sttr);
	            format(sttr, 150, "{ffffff}Responssavel\t{a1a1a1}%s\n", NomeConta(Admin[i][adm_Responssavel]));
	            strcat(SG, sttr);
	            strcat(SG, "{ff0000}Limpar Vaga\t{000000}_\n");
	            ShowPlayerDialog(playerid, DIALOG_LISTA_ADMIN3, DIALOG_STYLE_TABLIST, NomeConta(Admin[i][adm_Conta]), SG, "Continuar", "Voltar");
	        }
	        else
	        {
	            ms(playerid, 0, "Voce precisa ser Admin Level 8 para usar as Opcoes de modificacao !");
	            OnDialogResponse(playerid, DIALOG_LISTA_ADMIN, 1, ii, "");
	        }
	    }
	    else mostrar_admins(playerid);
	    return 1;
	}

	// DIALOG DA LISTA ADMINS //
    if(dialogid == DIALOG_LISTA_ADMIN)
	{
	    if(response)
	    {
	        SG[0] = EOS;
	        new i = Lista[playerid][listitem];
	        SetPVarInt(playerid, "admin", i);
	        SetPVarInt(playerid, "listitem", listitem);
	        format(SG, sizeof SG,"\n\
			{ffffff}Nome: {ffff00}%s\n\
			{ffffff}Nivel: {a1a1a1}%d\n\
			{ffffff}Funcao: {00ffff}%s\n\
			{ffffff}Responssavel: {a1a1a1}%s\n\
			{ffffff}Nota: {a1a1a1}%d\n\
			{ffffff}Atendimentos: {a1a1a1}%d\n\n\
			{ffffff}Data: {a1a1a1}%02d/%02d%/%02d\n\
			{ffffff}Hora: {a1a1a1}%02d:%02d:%02d\n\n", NomeConta(Admin[i][adm_Conta]), Admin[i][adm_Level], Admin[i][adm_Funcao], NomeConta(Admin[i][adm_Responssavel]), Admin[i][adm_Nota],
			Admin[i][adm_Atendimentos], Admin[i][adm_Dia], Admin[i][adm_Mes], Admin[i][adm_Ano], Admin[i][adm_Hora], Admin[i][adm_Minuto], Admin[i][adm_Segundo]);
	        ShowPlayerDialog(playerid, DIALOG_LISTA_ADMIN2, DIALOG_STYLE_MSGBOX, "Informacoes", SG, "Continuar", "Voltar");
	    }
	    return 1;
	}

	// dialog da agencia de pegar o emprego //
	if(dialogid == DIALOG_EMPREGOS2)
	{
	    if(response)
	    {
	        new string[150];
			new i = GetPVarInt(playerid, "emprego");
			if(c != -1)
			{
			    Conta[playerid][c_Emprego] = i;
			    Conta[playerid][c_Emprego2] = gettime() + (15*60);
				format(string, 150, "Voce pegou o emprego '%s', qualquer duvida use /ajuda.", NomeEmprego(i));
				ms(playerid, 2, string);
				ms(playerid, 2, "Se quiser pegar um novo emprego voce tera que esperar 15 minutos.");
				salvar_conta(c, 0, "c_Emprego", sv_int(Conta[playerid][c_Emprego]));
				salvar_conta(c, 0, "c_Emprego2", sv_int(Conta[playerid][c_Emprego2]));
				// Marcar ponto de trabalho no GPS
				if(i == VR_EMPREGO_ID) Localizar_Player(playerid, 2111.8855, -1932.2644, 17.0425, 63, -1, "Deposito de Roupas");
				if(i == OM_EMPREGO_ID) Localizar_Player(playerid, 588.1663, 1335.7125, 10.6352, 63, -1, "Fabrica de Maquinas");
			}
	    }
	    else mostrar_empregos(playerid);
	    return 1;
	}


		// dialog selecionar cnh ou nao //
		if(dialogid == DIALOG_EMPREGOS_CNH)
		{
		    if(response)
		    {
		        SetPVarInt(playerid, "cnh_filtro", listitem); // 0=precisa CNH, 1=nao precisa
		        mostrar_empregos(playerid);
		    }
		    return 1;
		}

		// dialog da agencia de empregos //
		if(dialogid == DIALOG_EMPREGOS)
	{
	    if(response)
	    {
	        new string[300];
			new i = Lista[playerid][listitem];
			if(i == -1) mostrar_empregos(playerid);
			else
			{
				if(EmpregoPlayer(playerid) != -1)
				{
				    format(string, 150, "Voce esta atualmente no emprego '%s', precisa sair dele antes, use /largaremprego.", Emprego[EmpregoPlayer(playerid)][e_Nome]);
	                ms(playerid, 0, string);
	                mostrar_empregos(playerid);
				}
					else if(NivelPlayer(playerid) < Emprego[i][e_Nivel])
					{
					    format(string, 150, "Voce precisa ser Nivel %d+ para pegar este emprego !", Emprego[i][e_Nivel]);
		                ms(playerid, 0, string);
		                mostrar_empregos(playerid);
					}
					else if(VR_PrecisaCNH(i) && !VR_TemCNH(playerid, i))
					{
					    new cnh_tipos[4][] = {"", "Moto (Categoria A)", "Carro (Categoria B)", "Caminhao (Categoria C)"};
					    ms(playerid, 0, f("Voce precisa de CNH de %s para este emprego! Va a Auto Escola.", cnh_tipos[VR_TipoCNH(i)]));
					    mostrar_empregos(playerid);
					}
					else
				{
					SetPVarInt(playerid, "emprego", i);
					format(string, 300, "{00ffff}Pegar um Novo Emprego\n\n{FFFFFF}%s\n{a1a1a1}Salario: {4169E1}R$ %s\n{a1a1a1}Nivel necessario: {ffffff}%d\n\n\
					{ffff00}[INFO] {a1a1a1}Voce pode largar o emprego quando quiser usando {ffffff}/largaremprego{a1a1a1} a qualquer momento.", Emprego[i][e_Nome], ConvertMoney(Emprego[i][e_Salario]),  Emprego[i][e_Nivel]);
					ShowPlayerDialog(playerid, DIALOG_EMPREGOS2, DIALOG_STYLE_MSGBOX, "{000000}_", string, "Pegar", "Voltar");
				}
			}
		}
	    return 1;
	}

    // dialog de VEICULOS perto //
	if(dialogid == DIALOG_VEICULOS_PERTO)
	{
	    new v = Lista[playerid][listitem];
	    if(response)
	    {
			if(v == -1)
			{
			    VeiculosPerto(playerid, GetPVarInt(playerid, "v_range"), GetPVarInt(playerid, "v_opcao"));
		        ms(playerid, 0, "Nenhum veiculo por perto !");
			    return 1;
			}
			if(Veiculo[v][v_Existe] == 0)
		    {
		        VeiculosPerto(playerid, GetPVarInt(playerid, "v_range"), GetPVarInt(playerid, "v_opcao"));
		        ms(playerid, 0, "Este veiculo nao existe mais !");
		        return 1;
		    }
		    Veiculos_Perto(playerid, v, GetPVarInt(playerid, "v_opcao"), 1);
		}
		else
	    {
	        Veiculos_Perto(playerid, v, GetPVarInt(playerid, "v_opcao"), 0);
	    }
	    return 1;
	}


	// dialog de players perto //
	if(dialogid == DIALOG_PLAYERS_PERTO)
	{
	    new i = Lista[playerid][listitem];
	    if(!response)
	    {
	        Players_Perto(playerid, i, GetPVarInt(playerid, "p_opcao"), 0);
	        return 1;
	    }

	    if(i == -1)
	    {
	        PlayersPerto(playerid, GetPVarInt(playerid, "p_range"), GetPVarInt(playerid, "p_opcao"));
	        ms(playerid, 0, "Player Offline ou nao tem ninguem por perto !");
	        return 1;
	    }

	    if(id[i] == -1)
	    {
	    	PlayersPerto(playerid, GetPVarInt(playerid, "p_range"), GetPVarInt(playerid, "p_opcao"));
	        ms(playerid, 0, "Este Player nao esta mais Online !");
	        return 1;
	    }

	    Players_Perto(playerid, i, GetPVarInt(playerid, "p_opcao"), 1);
	    return 1;
	}


	// dialog dos caixas eletronicos //
	if(dialogid == DIALOG_LOCAIS3)
	{
	    if(response)
	    {
	        new cep = GetPVarInt(playerid, "caixa_mais_proximo");
	        new i = -1;
	        if(cep != -1)
	        {
	            if(listitem == 0)
	            {
	            	i = cep;
	            }
	            else i = lista_caixas[playerid][listitem+1];
	        }
	        else i = lista_caixas[playerid][listitem];

	        if(i != -1)
	        {
	            if(CaixaEletronico[i][ce_Existe] == 1)
	            {
	                if(GetPVarInt(playerid, "destino") == 1) // teleporte admin //
					{
	                    format(string_prox, 300, "** O Admin '%s' teleportou para o Caixa Eletronico[%d] em '%s' **", Nome(playerid), i, cidade(CaixaEletronico[i][ce_Cidade]));
						ProxDetector(10.0, playerid, string_prox, 0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA,0xBCA9F5AA);
						SetPlayerPos_(playerid, CaixaEletronico[i][ce_X]+0.1, CaixaEletronico[i][ce_Y]+0.1, CaixaEletronico[i][ce_Z]+1);
						SetPlayerVirtualWorld_(playerid, CaixaEletronico[i][ce_Mundo]);
						SetPlayerInterior(playerid, CaixaEletronico[i][ce_Interior]);
						OnPlayerInteriorChange(playerid, GetPlayerInterior(playerid), 999);
	                }

	                if(GetPVarInt(playerid, "destino") == 2) // alterar destino uber //
					{
					    SetPVarInt(playerid, "uber_gps", 1);
					    Uber[playerid][uber_Cidade] = CaixaEletronico[i][ce_Cidade];
					    Uber[playerid][uber_Destino] = i;
					    celular(playerid, celular_aberto[playerid]);
					}

					if(GetPVarInt(playerid, "destino") == 3) // alterar local gps //
					{
					    SetPVarInt(playerid, "local_gps", 1);
					    GPS[playerid][gps_Cidade] = CaixaEletronico[i][ce_Cidade];
					    GPS[playerid][gps_Destino] = i;
					    celular(playerid, celular_aberto[playerid]);
					}
	            }
	        }
	    }
	    else mostrar_cidades(playerid);
	    return 1;
	}


