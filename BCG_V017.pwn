}

stock destino(i, a)
{
    new sexx[100];
	format(sexx, 100, "NENHUM");
	if(a == 0) if(i > -1 && i < sizeof Local_LosSantos) format(sexx, 100, Local_LosSantos[i][local_Nome]);
	if(a == 1) if(i > -1 && i < sizeof Local_SanFierro) format(sexx, 100, Local_SanFierro[i][local_Nome]);
	if(a == 2) if(i > -1 && i < sizeof Local_LasVenturas) format(sexx, 100, Local_LasVenturas[i][local_Nome]);
	return sexx;
}


