stock mostrar_veiculos(playerid, con=0, tre=-1)
{
	new Float:p[6];
	GetPlayerPos(playerid, p[0],p[1],p[2]);
	new conta = id[playerid];
	new ssid[10];
	new cont;
	new sss[150];
	SG[0] = EOS;
	zerar_lista(playerid);
	if(conta != -1)
	{
		// mostrar os veiculos //
		if(con == 0)
		{
		    strcat(SG, "Nome\tPlaca\tID\n");
		    foreach(new i:Iter_Veiculos)
			{
	      		if(Veiculo[i][v_Existe] == 1)
				{
				if(Veiculo[i][v_Dono] != -1 && Veiculo[i][v_Emprego] == -1 && Veiculo[i][v_Org]  == -1)
				{
						if(Veiculo[i][v_Dono] == conta)
						{
						    format(ssid, 10, "ID: %d", Veiculo[i][v_ID]);
						    format(sss, 150, "{ffffff}%s\t{a1a1a1}%s\t{ffff00}%s\n", NomeVeiculo(Veiculo[i][v_Modelo]), PlacaVeiculo[i], (Veiculo[i][v_Garagem] == 1)?"{ff0000}Garagem":ssid);
						    strcat(SG, sss);
							Lista[playerid][cont] = i;
							cont++;
						}
					}
				}
			}

			format(sss, 150, "{ffffff}Seus veiculos[{ffff00}%d{ffffff}]", cont );
			ShowPlayerDialog(playerid, DIALOG_VEI, DIALOG_STYLE_TABLIST_HEADERS, sss, SG, "Ok", "Fechar");
		}

		// mostrar informacoes do veiculo //
		if(con == 1 && tre != -1)
		{
	        new veh = Veiculo[tre][v_ID];
	        new s_travas[30];
		    SetPVarInt(playerid, "veh", veh);
		    SetPVarInt(playerid, "info", tre);

	        if(Veiculo[tre][v_Trancado] == 0) format(s_travas, 30, "{4169E1}ABERTO");
			else format(s_travas, 30, "{ff0000}TRANCADO");

		    if(Veiculo[tre][v_Garagem] == 1 || GetVehicleModel(veh) == 0)
		    {
		        strcat(SG, "{ffffff}Localizar   {ffff00}GARAGEM\n");
		        strcat(SG, "{ffffff}Travas ");
		        strcat(SG, s_travas);
		        strcat(SG, "\n");
		        strcat(SG, "{ffff00}Chaves\n");
		        strcat(SG, "{00ffff}Historico\n");
		        strcat(SG, "{00ff00}Vender ao Servidor\n");
      		}
		    else
		    {
		        new Float:diss;
		        GetVehiclePos(veh, p[3],p[4],p[5] );
		        GetDistance(diss, p[0],p[1],p[2], p[3],p[4],p[5]);
		      	format(sss, 150, "{ffffff}Localizar   {ffff00}%.0f Metros\n", diss);
		      	strcat(SG, sss);
		        strcat(SG, "{ffffff}Travas ");
		        strcat(SG, s_travas);
		        strcat(SG, "\n");
		        strcat(SG, "{ffff00}Chaves\n");
		        strcat(SG, "{00ffff}Historico\n");
		        strcat(SG, "{00ff00}Vender ao Servidor\n");
			}

			format(ssid, 10, "%d", Veiculo[tre][v_ID]);
			format(sss, 150, "{00ffff}%s {ffff00}%s {ffffff}%s", PlacaVeiculo[tre], (Veiculo[tre][v_Garagem] == 1)?"{ff0000}Garagem":ssid,  NomeVeiculo(Veiculo[tre][v_Modelo]));
            ShowPlayerDialog(playerid, DIALOG_VEI2, DIALOG_STYLE_LIST, sss, SG, "Ok", "Fechar");
		}
	}
}


